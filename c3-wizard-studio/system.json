{
    "$schema": "https://lovable.dev/schemas/system.json",
    "version": "1.0.0",
    "name": "C3 Wizard - Social Security Contribution Management System",
    "description": "Comprehensive social security contribution management system for St. Kitts & Nevis. See knowledge/00_index.md for full documentation index.",
    "documentationIndex": "knowledge/00_index.md",
    "authentication": {
        "provider": "Supabase Auth",
        "passwordStorage": "bcrypt (Supabase managed)",
        "legacyPasswordMigration": {
            "algorithm": "AES-256-CBC",
            "keyDerivation": "PBKDF2 (1000 iterations, SHA-1)",
            "encoding": "UTF-16LE",
            "secretsRequired": ["LEGACY_ENCRYPTION_KEY", "LEGACY_ENCRYPTION_SALT"],
            "edgeFunction": "migrate-legacy-users"
        },
        "roleMapping": {
            "admin": [13, 14, 18, 19, 20, 21, 22, 24],
            "employer": [15, 16, 23],
            "self_employed": [17]
        },
        "permissionTables": {
            "rolePermissions": "c3_user_permissions",
            "granularPermissions": "c3_user_granular_permissions",
            "modules": "c3_modules"
        }
    },
    "targetArchitecture": {
        "backend": {
            "framework": "Supabase (PostgreSQL)",
            "note": "Initial implementation uses Supabase with future migration to ASP.NET Core Web API",
            "futureTarget": "ASP.NET Core Web API 8.0 with MS-SQL Server",
            "authentication": "Supabase Auth with Email/Password + OTP",
            "database": "PostgreSQL (Supabase) - Migration-ready schema for MS-SQL"
        },
        "frontend": {
            "framework": "React",
            "version": "18.3",
            "buildTool": "Vite",
            "language": "TypeScript",
            "styling": "Tailwind CSS",
            "components": "shadcn/ui",
            "theme": "Mint green primary (#10b981 family) with clean, modern aesthetics"
        }
    },
    "systemRoles": {
        "admin": {
            "name": "Administrator",
            "capabilities": [
                "System configuration and settings management",
                "User account management (employers and self-employed)",
                "Contribution rate management",
                "Payment reconciliation oversight",
                "Report generation and analytics",
                "BIMA integration management",
                "Audit trail access"
            ]
        },
        "employer": {
            "name": "Employer",
            "capabilities": [
                "Company profile management",
                "Employee management (CRUD)",
                "C3 form generation and submission",
                "Contribution calculations",
                "Payment processing (online and offline)",
                "Holiday pay and bonus management",
                "Director payroll management",
                "Transaction history",
                "Report generation"
            ]
        },
        "selfEmployed": {
            "name": "Self-Employed Individual",
            "capabilities": [
                "Personal profile management",
                "Self-contribution calculations",
                "C3 form submission",
                "Payment processing",
                "Transaction history",
                "Personal reports"
            ]
        }
    },
    "environmentVariables": {
        "required": [
            {
                "name": "VITE_SUPABASE_URL",
                "description": "Supabase project URL"
            },
            {
                "name": "VITE_SUPABASE_ANON_KEY",
                "description": "Supabase anonymous key"
            },
            {
                "name": "VITE_APP_NAME",
                "description": "Application name",
                "default": "C3 Wizard"
            },
            {
                "name": "VITE_THEME_PRIMARY_COLOR",
                "description": "Primary theme color",
                "default": "#10b981"
            },
            {
                "name": "VITE_DATE_DISPLAY_FORMAT",
                "description": "User-facing date format",
                "default": "MM/DD/YYYY"
            },
            {
                "name": "VITE_DATE_STORAGE_FORMAT",
                "description": "Database storage date format",
                "default": "YYYY-MM-DD"
            },
            {
                "name": "VITE_PHONE_MASK",
                "description": "Phone number mask for St. Kitts & Nevis",
                "default": "(###) ###-####"
            },
            {
                "name": "VITE_DEFAULT_COUNTRY_CODE",
                "description": "Default country code",
                "default": "+1-869"
            },
            {
                "name": "VITE_CURRENCY",
                "description": "Currency code",
                "default": "XCD"
            },
            {
                "name": "VITE_CURRENCY_SYMBOL",
                "description": "Currency symbol",
                "default": "EC$"
            },
            {
                "name": "VITE_PAYMENT_GATEWAY",
                "description": "Payment gateway (cybersource, paypal, offline)",
                "default": "cybersource"
            },
            {
                "name": "VITE_ENABLE_BIMA_INTEGRATION",
                "description": "Enable BIMA API integration",
                "default": "false"
            }
        ]
    },
    "database": {
        "naming": {
            "convention": "snake_case",
            "tablePrefix": "c3_",
            "note": "All tables prefixed with c3_ for namespace isolation"
        },
        "softDelete": true,
        "auditColumns": [
            "created_at",
            "updated_at",
            "created_by",
            "updated_by",
            "is_active",
            "is_deleted"
        ],
        "coreTables": [
            "c3_users",
            "c3_companies",
            "c3_employees",
            "c3_self_employed",
            "c3_contribution_headers",
            "c3_contribution_details",
            "c3_payments",
            "c3_payment_reconciliation",
            "c3_system_rates",
            "c3_audit_logs"
        ],
        "migrationReadiness": {
            "note": "Schema designed for seamless PostgreSQL → MS-SQL migration",
            "considerations": [
                "Use SERIAL/BIGSERIAL for auto-increment (maps to IDENTITY in SQL Server)",
                "Avoid PostgreSQL-specific types (use standard SQL types)",
                "Use TIMESTAMP for datetime (maps to DATETIME2)",
                "Boolean fields use BOOLEAN (maps to BIT)",
                "JSON fields use JSONB (maps to NVARCHAR(MAX) with JSON validation)"
            ]
        }
    },
    "contributionCalculations": {
        "note": "⚠️ IMPORTANT: Rates shown below are EXAMPLE VALUES ONLY for documentation. Actual rates are fetched from c3_system_rates database table and configurable by Admin users.",
        "dataSource": "c3_system_rates table (fetched at runtime, NOT hardcoded)",
        "components": [
            {
                "name": "Social Security (Employee)",
                "code": "ss_employee",
                "rateExample": "5% (fetched from db)",
                "hasMaxCap": true,
                "maxCapField": "max_ss_employee_monthly"
            },
            {
                "name": "Social Security (Employer)",
                "code": "ss_employer",
                "rateExample": "5% (fetched from db)",
                "hasMaxCap": false
            },
            {
                "name": "Employment Insurance (Employee)",
                "code": "ei_employee",
                "rateExample": "1% (fetched from db)",
                "hasMaxCap": true,
                "maxCapField": "max_ei_employee_monthly"
            },
            {
                "name": "Employment Insurance (Employer)",
                "code": "ei_employer",
                "rateExample": "1% (fetched from db)",
                "hasMaxCap": true,
                "maxCapField": "max_ei_employer_monthly"
            },
            {
                "name": "Levy (Employee)",
                "code": "levy_employee",
                "rateExample": "Progressive tiers from c3_levy_tiers table",
                "hasMaxCap": false,
                "note": "Progressive tax based on wage tiers (fetched from c3_levy_tiers)"
            },
            {
                "name": "Levy (Employer)",
                "code": "levy_employer",
                "rateExample": "3% (fetched from db)",
                "hasMaxCap": false,
                "includesBonus": true
            },
            {
                "name": "Severance Pay (Employee)",
                "code": "severance_employee",
                "rateExample": "5% (fetched from db)",
                "hasMaxCap": true,
                "maxCapField": "max_pe_employee_monthly"
            },
            {
                "name": "Severance Pay (Employer)",
                "code": "severance_employer",
                "rateExample": "5% (fetched from db)",
                "hasMaxCap": false
            }
        ],
        "specialRules": {
            "bonusExemption": "Bonuses in December may be exempt from employee levy if YTD wages < $28,000",
            "holidayPayDistribution": "Holiday pay distributed across non-working weeks for levy calculation",
            "directorWages": "Non-working directors have auto-calculated weekly wages from annual salary",
            "ageExemption": "SS contributions exempt for employees outside age range 16-62"
        },
        "penalties": {
            "lateSubmission": "Calculated based on days late and contribution amount",
            "types": [
                "ss_penalty",
                "levy_penalty",
                "pe_penalty"
            ]
        }
    },
    "uiRules": {
        "themeColors": {
            "primary": "#10b981",
            "primaryHover": "#059669",
            "secondary": "#6366f1",
            "background": "#f0fdf4",
            "cardBackground": "#ffffff",
            "textPrimary": "#1f2937",
            "textSecondary": "#6b7280",
            "border": "#d1fae5",
            "error": "#ef4444",
            "success": "#10b981",
            "warning": "#f59e0b",
            "info": "#3b82f6"
        },
        "layout": {
            "navbarStyle": "Clean horizontal navbar with logo, centered on mint green gradient background",
            "sidebarStyle": "Left sidebar for dashboard navigation with icons and labels",
            "cardStyle": "White cards with subtle shadows, rounded corners (8px)",
            "spacing": "Generous padding and margins for clean, breathable design"
        },
        "navigation": {
            "multiStepForms": true,
            "directStepNavigation": true,
            "progressIndicator": "Step-based progress bar at top",
            "breadcrumbs": true
        },
        "validation": {
            "disableBrowserValidation": true,
            "inlineErrors": true,
            "toastOnError": true,
            "toastStyle": "Modern toast notifications with icons",
            "focusFirstError": true,
            "realTimeValidation": true
        },
        "forms": {
            "phoneInput": "Split country code and number",
            "dateInput": "Date picker component with format validation",
            "currencyInput": "Formatted with currency symbol, thousand separators",
            "ssnInput": "Masked input with format validation",
            "characterCounters": true,
            "requiredFieldIndicator": "Red asterisk"
        },
        "tables": {
            "pagination": true,
            "sorting": true,
            "filtering": true,
            "search": true,
            "exportOptions": [
                "CSV",
                "Excel",
                "PDF"
            ],
            "rowsPerPageOptions": [
                10,
                25,
                50,
                100
            ]
        },
        "dashboards": {
            "analytics": "Chart.js or Recharts for data visualization",
            "kpiCards": "Summary cards with icons and trend indicators",
            "recentActivity": "Timeline-based activity feed"
        }
    },
    "apiStandards": {
        "baseUrl": "${VITE_SUPABASE_URL}",
        "authentication": "Supabase Auth with JWT tokens",
        "responseFormat": {
            "success": "{ success: true, data: {...}, message: string }",
            "error": "{ success: false, error: {...}, message: string }"
        },
        "validationErrors": {
            "format": "{ field: string, message: string }[]",
            "httpStatus": 400
        },
        "pagination": {
            "format": "{ data: [], page: number, pageSize: number, total: number, totalPages: number }"
        },
        "rls": {
            "note": "Row Level Security policies enforce data isolation by company/user",
            "userCheck": "Users can only access their own company data",
            "adminOverride": "Admins have read access across companies for reconciliation"
        }
    },
    "paymentIntegration": {
        "gateways": [
            {
                "name": "CyberSource",
                "type": "online",
                "priority": 1,
                "features": [
                    "card_payment",
                    "tokenization",
                    "recurring"
                ]
            },
            {
                "name": "PayPal",
                "type": "online",
                "priority": 2,
                "features": [
                    "paypal_account",
                    "card_payment"
                ]
            },
            {
                "name": "Offline Payment",
                "type": "offline",
                "priority": 3,
                "methods": [
                    "bank_transfer",
                    "check",
                    "cash",
                    "journal_voucher"
                ]
            }
        ],
        "reconciliation": {
            "enabled": true,
            "csvImport": true,
            "manualEntry": true,
            "bimaSync": true
        }
    },
    "thirdPartyIntegrations": {
        "bima": {
            "name": "St. Kitts & Nevis Social Security Board (BIMA)",
            "enabled": "${VITE_ENABLE_BIMA_INTEGRATION}",
            "features": [
                "employee_data_import",
                "payment_posting",
                "receipt_number_generation",
                "contribution_verification"
            ],
            "note": "Optional integration - system works standalone if disabled"
        },
        "email": {
            "provider": "Supabase Edge Functions with SendGrid/Resend",
            "templates": [
                "registration_confirmation",
                "password_reset",
                "otp_verification",
                "payment_receipt",
                "c3_submission_confirmation"
            ]
        },
        "pdf": {
            "library": "jsPDF or react-pdf",
            "templates": [
                "c3_form",
                "payment_receipt",
                "contribution_summary",
                "employee_report"
            ]
        }
    },
    "securityRules": {
        "authentication": {
            "passwordPolicy": {
                "minLength": 8,
                "requireUppercase": true,
                "requireLowercase": true,
                "requireNumbers": true,
                "requireSpecialChars": true
            },
            "mfa": {
                "enabled": true,
                "method": "email_otp",
                "otpExpiry": "10 minutes"
            },
            "sessionManagement": {
                "jwtExpiry": "24 hours",
                "refreshToken": true,
                "concurrentSessions": false
            }
        },
        "authorization": {
            "rbac": true,
            "rowLevelSecurity": true,
            "dataIsolation": "Company-scoped for employers, user-scoped for self-employed"
        },
        "dataProtection": {
            "encryptSensitiveFields": [
                "ssn",
                "payment_card_info"
            ],
            "auditLogging": true,
            "gdprCompliant": false,
            "localDataProtection": true
        }
    },
    "featureFlags": {
        "multiFactorAuth": true,
        "bimaIntegration": false,
        "offlinePayments": true,
        "paymentReconciliation": true,
        "holidayPayManagement": true,
        "bonusManagement": true,
        "directorPayroll": true,
        "bulkEmployeeImport": true,
        "advancedReporting": true,
        "emailNotifications": true
    },
    "nonGoals": [
        "Mobile native apps (web-responsive only)",
        "Multi-country support (St. Kitts & Nevis only)",
        "Multi-language support (English only)",
        "LLM/AI features",
        "Social media integration",
        "Real-time chat support"
    ],
    "migrationStrategy": {
        "phase1": "Build complete functional replica on Supabase",
        "phase2": "Test all features and business logic",
        "phase3": "Create ASP.NET Core API layer",
        "phase4": "Migrate database schema to MS-SQL",
        "phase5": "Switch frontend to call .NET API",
        "considerations": [
            "Keep business logic in frontend during Supabase phase for easy migration",
            "Use TypeScript interfaces that can be converted to C# models",
            "Document all calculation formulas for .NET implementation",
            "Maintain parallel testing environment during migration"
        ]
    }
}