@model dynamic

<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml"
      xmlns:v="urn:schemas-microsoft-com:vml"
      xmlns:o="urn:schemas-microsoft-com:office:office">
<head>

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">

  <link href="https://fonts.googleapis.com/css2?family=Yrsa:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cabin+Condensed&family=Encode+Sans+Condensed:wght@400;500;600&display=swap" rel="stylesheet">

  <title>Password Reset</title>

  <style>
    body {
      font-family: 'Roboto Condensed', sans-serif !important;
      font-weight: 400 !important;
      font-size: 17px;
      line-height: 1.4;
      color: rgba(0,0,0,.7);
    }
  </style>

</head>

<body>

  <center style="width: 100%;">
    <div style="max-width: 700px; margin: 0 auto;" class="email-container">

      <table align="center" role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
             style="margin: auto; border: 4px solid #eff3f4; margin-top: 2px;">

        <!-- Top border background -->
        <tr>
          <td style="padding: .2em 1em; background-color: #eff3f4;"></td>
        </tr>

        <!-- Body Content -->
        <tr>
          <td valign="top" style="padding: 1em 1.3em 1rem;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">

              <tr>
                <td style="text-align: center;">
                  <img src="https://design.mishainfotech.com/design/amit/c3-wizard6/assets/images/logo-w.png" style="width: 80px;">
                </td>
              </tr>

              <tr>
                <td style="color: #262626;">
                  <h2 style="color: #2a5d84; margin: 20px 0px; text-align: center;">
                    C3 Remittances — Reset Password
                  </h2>

                  <p>Hi <strong>@Model.Name</strong>,</p>

                  <p>We received a request to reset your password for your C3 Remittances account.</p>

                  <p>If you requested this change, please click the button below:</p>

                  <p style="text-align: center; margin: 25px 0;">
                    <a href="@Model.ResetPasswordUrl"
                       style="background-color: #0a58ca; padding: 10px 22px; color: #ffffff;
                                              text-decoration: none; border-radius: 4px; display: inline-block;">
                      Reset Password
                    </a>
                  </p>

                  <p><strong>Or</strong>, if the button above doesn’t work, copy and paste this link into your web browser:</p>

                  <p style="word-break: break-all;">
                    <a href="@Model.ResetPasswordUrl">@Model.ResetPasswordUrl</a>
                  </p>

                  <p>If you did not request a password reset, please ignore this email or contact our support team.</p>

                  <br />

                  If you experience any difficulties, please email us at
                  <strong>eservices@socialsecurity.kn</strong> or call <strong>(869) 465-2535</strong>.

                  <br /><br />

                  <b>Sincerely,</b><br /><br />
                  Administrator (C3 Remittances)<br />
                  St. Christopher &amp; Nevis Social Security Board
                </td>
              </tr>

            </table>
          </td>
        </tr>

        <!-- Bottom gray strip -->
        <tr>
          <td style="padding: .4rem 1em; background-color: #eff3f4;"></td>
        </tr>

      </table>

    </div>
  </center>

</body>
</html>
