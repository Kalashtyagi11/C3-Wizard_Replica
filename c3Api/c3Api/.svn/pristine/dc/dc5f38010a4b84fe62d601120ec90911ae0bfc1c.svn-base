using System;
using System.Collections.Generic;
using System.ComponentModel.Design;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace C3WizardHelper.ViewModels
{
    public class C3EmployeeVM
    {

        public C3EmployeeVM()
        {
            // Initialize with default values
            SocSecNum = 0;
            FirstName = string.Empty;
            MiddleName = string.Empty;
            LastName = string.Empty;
            BirthDate = null;
            rbmale = false;
            Address1 = string.Empty;
            Address2 = string.Empty;
            City = string.Empty;
            State = string.Empty;
            Country = string.Empty;
            Zip = string.Empty;
            Phone = string.Empty;
            Mobile = string.Empty;
            Email = string.Empty;
            IncRate = null;
            LastPayDate = null;
            Terminated = null;
            commencementDate = null;
            PayPeriod = string.Empty;
            MaritalStat = string.Empty;
            Occupation = string.Empty;
            Department = string.Empty;
            IsemployeeDirector = false;
            IsLevyExempt = false;

            // Holidaypayworkingdirector
            start_Date = null;
            end_Date = null;
            Amount = null;
            monthno = null;
            yearName = string.Empty;
            holidayPay_Date = null;

            // Wages
            Wagespaydate = null;
            wagesAmount = null;

            // Update fields
            EmployeeID = null;
            EmplCode = string.Empty;
            mode = 0;
            companyid = 0;
        }


        public int? SocSecNum { get; set; }
        public string? FirstName { get; set; }
        public string? MiddleName { get; set; }
        public string? LastName { get; set; }
        
        public DateTime? BirthDate { get; set; }
        public bool? rbmale { get; set; }
        public string? Address1 { get; set; }
        public string? Address2 { get; set; }
        public string? City { get; set; }
        public string? State { get; set; }
        public string? Country { get; set; }
        public string? Zip { get; set; }
        public string? Phone { get; set; }
        public string? Mobile { get; set; }
        public string? Email { get; set; }
        //public string? Tin { get; set; }
        public decimal? IncRate { get; set; }
        public DateTime? LastPayDate { get; set; }= DateTime.Now; 
        public DateTime? Terminated { get; set; } = new DateTime(9999, 12, 31);
        public DateTime? commencementDate { get; set; }= DateTime.Now; 
        public string? PayPeriod { get; set; }
        public string? MaritalStat { get; set; }
        public string? Occupation { get; set; }
        public string? Department { get; set; }
        public bool? IsemployeeDirector { get; set; }
        public bool? IsLevyExempt { get; set; }


       //Holidaypayworkingdirector
        public DateTime? start_Date { get; set; }
        public DateTime? end_Date { get; set; }
        public decimal? Amount { get; set; }
        public int? monthno { get; set; }
        public string? yearName { get; set; }
        public DateTime? holidayPay_Date { get; set; }
        


        public DateTime? Wagespaydate { get; set; }
        public decimal? wagesAmount { get; set; }





        //update
        public int? EmployeeID { get; set; }
        public int? holidaypayId { get; set; }
        public string? EmplCode { get; set; }
        public int? mode { get; set; }
        public int? companyid { get; set; }

     
    }
}
