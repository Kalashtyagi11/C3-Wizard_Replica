        [HttpGet("getCardHolderName")]
        public async Task<IActionResult> CardHolders()
        {
            // If you want all cardholder names for a specific user
            try
            {
                var cardHolders = await _Context.UserCardDetails
                                                    .Select(u => new { u.CardHolderName, u.UserId })
                                                    .ToListAsync();


                return Ok(new { status = true, msg = "data found", data = cardHolders });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                var data = new
                {

                    Status = false,
                    Message = "An error occurred while saving data.",
                    Statuscode = 500,
                    Data = ex.Message
                };

                return StatusCode(500, data);
            }
        }

        [HttpGet("getOfflinePaymentsDetails")]
        public async Task<IActionResult> getOfflinePaymentsDetails(string receiptId, int userId)
        {
            try
            {
                var secuser = _Context.Secusers.Where(e => e.UserId == userId).Select(e => new { e.LoginId, e.Password }).FirstOrDefault();

                string Emp_surl = _configuration["ServiceConfig:ServiceUriString"];
                string Emp_sURL = $"{Emp_surl}/api/payment/details/{receiptId}";
                HttpResponseMessage getresponse;
                using (var gethttpClient = new HttpClient() { BaseAddress = new Uri(Emp_sURL), Timeout = TimeSpan.FromMinutes(2) })
                {
                    gethttpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                    var getplainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : Encoding.UTF8.GetBytes(secuser.LoginId + ":" + secuser.Password);

                    string getval = Convert.ToBase64String(getplainTextBytes);
                    gethttpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + getval);

                    getresponse = await gethttpClient.GetAsync(Emp_sURL);
                }
                var getcustomerJsonString = await getresponse.Content.ReadAsStringAsync();
                if (getresponse.StatusCode == HttpStatusCode.OK)
                {
                    return Ok(new ResponseModel
                    {
                        Status = true,
                        Message = "payment data found",
                        Data = getcustomerJsonString,
                        Statuscode = 200
                    });
                }
                else
                {
                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                       
                        Message = getcustomerJsonString,
                        Statuscode = 400
                    });
                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                var data = new
                {

                    Status = false,
                    Message = "An error occurred while saving data.",
                    Statuscode = 500,
                    Data = ex.Message
                };

                return StatusCode(500, data);
            }


        }


    }
