        /// <summary>
        /// Updated and inserted Reconciliation data
        /// </summary>
        /// <param name="model"></param>
        /// <returns></returns>
        [HttpPost("UpdateReconciliationData")]
        public async Task<IActionResult> UpdateReconciliationData([FromBody] ReconciliationRequestModel model)
        {
            try
            {
                var response = new ResponseModel();

                if (model.id == null || model.id.Length == 0)
                {
                    response.Status = false;
                    response.Message = "No IDs provided.";
                    return BadRequest(response);
                }

                if (string.IsNullOrWhiteSpace(model.ReasonsForReconciliation))
                {
                    response.Status = false;
                    response.Message = "Reconciliation reason is required.";
                    return BadRequest(response);
                }

                var payments = _Context.OnlinePayments.Where(x => model.id.Contains(x.Id)).ToList();

                foreach (var payment in payments)
                {
                    string oldStatus = payment.IsReconciled == true ? "Reconciled" : "Unreconciled";
                    string newStatus = model.Status == null ? "Not Set" : (model.Status == true ? "Reconciled" : "Unreconciled");
                    var username = _Context.Secusers.Where(x => x.UserId == model.UserId).Select(x => x.FirstName + " " + x.LastName).FirstOrDefault();
                    string newEntry = $"{DateTime.Now:dd/MMM/yyyy}, by {username}, {oldStatus} ---> {newStatus}, {model.ReasonsForReconciliation?.Trim()}";

                    payment.IsReconciled = true;
                    payment.ReconciledBy = model.UserId;
                    //payment.Notes = newEntry;
                    payment.ReconciledOn = DateTime.Now;

                    if (string.IsNullOrEmpty(payment.Notes))
                    {
                        payment.Notes = newEntry;
                    }
                    else
                    {
                        payment.Notes += "," + newEntry;
                    }
                }

                await _Context.SaveChangesAsync();

                response.Status = true;
                response.Statuscode = 200;
                response.Message = "Updated Successfully.";
                return Ok(response);
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new
                {
                    Status = false,
                    Message = "Something went wrong.",
                    Error = ex.Message
                });
            }
        }

        [HttpPost("UpdateReconciliationNotes")]
        public async Task<IActionResult> UpdateReconciliationNotes([FromBody] ReconciliationRequestNotes requestNotes)
        {
            try
            {
                var response = new ResponseModel();

                if (requestNotes.Status == true && requestNotes.id > 0)
                {
                    var record = await _Context.OnlinePayments
                        .FirstOrDefaultAsync(x => x.Id == requestNotes.id);


                    if (record != null)
                    {
                        string oldStatus = record.IsReconciled == true ? "Reconciled" : "Unreconciled";
                        string newStatus = requestNotes.Status == null ? "Not Set" : (requestNotes.Status == true ? "Reconciled" : "Unreconciled");
                        var username = _Context.Secusers.Where(x => x.UserId == requestNotes.Userid).Select(x => x.FirstName + " " + x.LastName).FirstOrDefault();

                        //string newEntry = $"[{DateTime.Now:dd/MM/yyyy}] {requestNotes.Notes?.Trim()}";
                        string newEntry = $"{DateTime.Now:dd/MMM/yyyy}, by {username}, {oldStatus} ---> {newStatus}, {requestNotes.Notes?.Trim()}";

                        if (string.IsNullOrEmpty(record.Notes))
                        {
                            record.Notes = newEntry;
                        }
                        else
                        {
                            record.Notes += "," + newEntry;
                        }
                        record.ReconciledOn = DateTime.Now;
                        record.IsReconciled = true;
                        record.ReconciledBy = requestNotes.Userid;
                        await _Context.SaveChangesAsync();
                        response.Status = true;
                        response.Statuscode = 200;
                        response.Data = record;
                        response.Message = "Updated Successfully.";
                    }
                }
                else
                {
                    var record = await _Context.OnlinePayments
                       .FirstOrDefaultAsync(x => x.Id == requestNotes.id);

                    if (record != null)
                    {
                        string oldStatus = record.IsReconciled == true ? "Reconciled" : "Unreconciled";
                        string newStatus = requestNotes.Status == null ? "Not Set" : (requestNotes.Status == true ? "Reconciled" : "Unreconciled");
                        var username = _Context.Secusers.Where(x => x.UserId == requestNotes.Userid).Select(x => x.FirstName + " " + x.LastName).FirstOrDefault();
                        string newEntry = $"{DateTime.Now:dd/MMM/yyyy}, by {username}, {oldStatus} ---> {newStatus}, {requestNotes.Notes?.Trim()}";
                        //string newEntry = $"[{DateTime.Now:dd/MM/yyyy}] {requestNotes.Notes?.Trim()}";
                        if (string.IsNullOrEmpty(record.Notes))
                        {
                            record.Notes = newEntry;
                        }
                        else
                        {
                            record.Notes += "," + newEntry;
                        }
                        record.IsReconciled = null;
                        record.ReconciledOn = DateTime.Now;
                        record.ReconciledBy = requestNotes.Userid;
                        await _Context.SaveChangesAsync();
                        response.Status = true;
                        response.Statuscode = 200;
                        response.Data = record;
                        response.Message = "Updated Successfully.";
                    }


                }



                return Ok(response);
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new
                {
                    Status = false,
                    Message = "Something went wrong.",
                    Error = ex.Message
                });
            }
        }








        [HttpPost("GetReconcilNotes")]
        public async Task<IActionResult> GetReconcilNotes(int id)
        {
            var response = new ResponseModel();

            try
            {
                if (id > 0)
                {
                    var note = await _Context.OnlinePayments
                        .Where(x => x.Id == id)
                        .Select(x => x.Notes)
                        .FirstOrDefaultAsync();

                    if (!string.IsNullOrEmpty(note))
                    {
                        var parts = note.Split(',', StringSplitOptions.RemoveEmptyEntries);

                        var notesArray = new List<string>();
                        var currentNote = "";

                        foreach (var part in parts)
                        {
                            var trimmed = part.Trim();


                            if (DateTime.TryParseExact(trimmed, "dd/MMM/yyyy",
                                    System.Globalization.CultureInfo.InvariantCulture,
                                    System.Globalization.DateTimeStyles.None, out _))
                            {

                                if (!string.IsNullOrEmpty(currentNote))
                                {
                                    notesArray.Add(currentNote.Trim());
                                }
                                currentNote = trimmed;
                            }
                            else
                            {

                                currentNote += ", " + trimmed;
                            }
                        }


                        if (!string.IsNullOrEmpty(currentNote))
                            notesArray.Add(currentNote.Trim());

                        //Sort date-wise (desc)
                        notesArray = notesArray
                            .OrderByDescending(n =>
                            {
                                var datePart = n.Split(',')[0].Trim();
                                DateTime.TryParseExact(datePart, "dd/MMM/yyyy",
                                    System.Globalization.CultureInfo.InvariantCulture,
                                    System.Globalization.DateTimeStyles.None, out var parsedDate);
                                return parsedDate;
                            })
                            .ToList();


                        response.Status = true;
                        response.Statuscode = 200;
                        response.Data = notesArray;
                        response.Message = "Fetched successfully.";
                        return Ok(response);
                    }
                    else
                    {
                        response.Status = false;
                        response.Statuscode = 404;
                        response.Message = "No records found.";
                        return NotFound(response);
                    }
                }
                else
                {
                    response.Status = false;
                    response.Statuscode = 400;
                    response.Message = "Invalid request parameters.";
                    return BadRequest(response);

                }


            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                response.Status = false;
                response.Statuscode = 500;
                response.Message = $"An error occurred: {ex.Message}";

                return StatusCode(500, response);
            }
        }







