        [HttpGet("GetCyberSourceFields")]
        public IActionResult GetCyberSourceFields(int UserId)
        {
            var enumValues = Enum.GetValues(typeof(CyberSourceFields));
            var data = new List<CyberSourceFieldStatus>();
            var dataColumns = _Context.ReconciliationCyberSpaceColumns.Where(x => x.UserId == UserId).ToList();
            foreach (var value in enumValues)
            {
                data.Add(new CyberSourceFieldStatus
                {
                    Field = value.ToString(),
                    Status = dataColumns.Count == 0 ? true : dataColumns.FirstOrDefault(e => e.Columns == value.ToString()).IsActive ?? true
                });
            }

            return Ok(data);
        }





