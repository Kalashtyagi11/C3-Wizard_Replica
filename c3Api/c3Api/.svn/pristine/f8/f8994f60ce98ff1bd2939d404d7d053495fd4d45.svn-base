        /// <summary>
        /// Upload to csv file
        /// </summary>
        /// <param name="file"></param>
        /// <param name="UserId"></param>
        /// <returns></returns>
        [HttpPost("UploadCyberCsv")]
        public async Task<IActionResult> UploadCyberCsv([FromForm] ReconcileVm reconcile)
        {
            if (reconcile.file == null || reconcile.file.Length == 0)
            {
                return BadRequest("No file uploaded.");
            }
            try
            {
                var res = await _paymentRepo.UploadCyberCsv(reconcile);
                if ((bool)res.Status)
                {
                    return Ok(res);
                }
                else
                {
                    return BadRequest(res);
                }
            }
            catch (DbUpdateException dbEx) when (dbEx.InnerException is SqlException sqlEx)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, dbEx.Message, dbEx.StackTrace);

                if (sqlEx.Number == 2627 || sqlEx.Number == 2601)
                {

                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                        Statuscode = 409,
                        Message = "Duplicate entry: Transaction ID already exists.",
                        Data = null
                    });
                }
                return BadRequest(new ResponseModel
                {

                    Status = false,
                    Statuscode = 500,
                    Message = "SQL Error: " + sqlEx.Message,
                    Data = null
                });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return BadRequest(new ResponseModel
                {
                    Status = false,
                    Statuscode = 500,
                    Message = ex.InnerException?.Message ?? ex.Message,
                    Data = null
                });
            }

        }




