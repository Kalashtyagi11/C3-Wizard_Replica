        [HttpGet("CardDetailsByCyber")]
        public async Task<IActionResult> CardDetailsByCyber(int userId, int headerId)
        {
            try
            {
                var Data = await _paymentRepo.CardDetails(userId);
                var isSelfEmp = _Context.Secusers
                    .Where(e => e.UserId == userId)
                    .Select(e => e.IsSelfEmployee)
                    .FirstOrDefault();



                object receipt;

                if (isSelfEmp ?? false)
                {


                    var charges1 = _Context.ProcessSelfEmployedC3s
                        ?.FirstOrDefault(e => e.Sec3id == headerId);
                    receipt = new
                    {
                        cardNumber = Data?.CardNumber,
                        expirationYear = Data?.CardMonthExpiry,
                        cardHolderName = Data?.CardHolderName,
                        securityCode = Data?.CVV,
                        paymentMethod = Data?.CardType,
                        monthPeriod = charges1 == null ? "" : charges1?.PeriodYear + " - " + _paymentRepo.MonthName(charges1.PerioddMonth),

                        TotalContributions = charges1?.TotalContributions ?? 0,
                        TotalFine = charges1?.TotalFine ?? 0,

                        payAmt = (charges1?.TotalContributions ?? 0) + (charges1?.TotalFine ?? 0)
                    };
                }
                else
                {
                    var charges = _Context.ProcessC3headers
              ?.FirstOrDefault(e => e.C3headerid == headerId);
                    receipt = new
                    {
                        cardNumber = Data?.CardNumber,
                        expirationYear = Data?.CardMonthExpiry,
                        cardHolderName = Data?.CardHolderName,
                        securityCode = Data?.CVV,
                        paymentMethod = Data?.CardType,
                        monthPeriod = charges == null ? "" : charges?.PeriodYear + " - " + _paymentRepo.MonthName(charges.PerioddMonth),

                        TotalSscontributions = charges?.TotalSscontributions ?? 0,
                        sumLeavy = (charges?.TotalLevyeeemployee ?? 0) + (charges?.TotalLevyeeemployer ?? 0),
                        TotalServayance = charges?.TotalServayance ?? 0,
                        TotalPepenalty = charges?.TotalPepenalty ?? 0,
                        TotalSspenalty = charges?.TotalSspenalty ?? 0,
                        sumPenalty = (charges?.TotalPepenalty ?? 0) + (charges?.TotalSspenalty ?? 0) + (charges?.TotalLevyeepenalty ?? 0),
                        TotalLevyeepenalty = charges?.TotalLevyeepenalty ?? 0,
                        TotalLevyeeemployer = charges?.TotalLevyeeemployer ?? 0,

                        payAmt =
                            (charges?.TotalSscontributions ?? 0)
                            + (charges?.TotalLevyeeemployee ?? 0)
                            + (charges?.TotalServayance ?? 0)
                            + (charges?.TotalPepenalty ?? 0)
                            + (charges?.TotalSspenalty ?? 0)
                            + (charges?.TotalLevyeepenalty ?? 0)
                            + (charges?.TotalLevyeeemployer ?? 0)
                    };
                }

                return Ok(new { Status = true, Message = "Data found!", Data = receipt });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new { Status = false, Message = "Something went wrong!", Data = ex });
            }

        }


