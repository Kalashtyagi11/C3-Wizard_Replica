        public PaymentController(PaymentRepo paymentRepo, C3wizardContext _c3WizardContext, IConfiguration configuration)
        {
            this._paymentRepo = paymentRepo ?? throw new ArgumentNullException(nameof(paymentRepo));
            _Context = _c3WizardContext;
            _configuration = configuration;
        }

        [HttpPost("BuySubscription")]
        [AllowAnonymous]
        public async Task<IActionResult> ProcessPayment([FromBody] DTOSubscriptionPayment model)
        {
            var response = new DTOResponsemodel();
            try
            {
                var paymentResponse = await _paymentRepo.ProcessPayment(model);

                response.Status = paymentResponse.Status;
                response.Message = paymentResponse.Status
                    ? "Payment processed successfully."
                    : "Payment processing failed.";
                response.Data = paymentResponse.Data;

                return paymentResponse.Status ? Ok(response) : BadRequest(response);
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                response.Status = false;
                response.Message = "An error occurred while processing the payment.";
                response.Data = new { error = ex.Message };

                return StatusCode(StatusCodes.Status500InternalServerError, response);
            }
        }

        [HttpPost("Paymentsuccess")]
        [AllowAnonymous]
        public async Task<IActionResult> Paymentsuccess(PaymentDetails1 model)
        {
            var response = new DTOResponsemodel();

            // Validate input
            if (string.IsNullOrEmpty(model.token) || string.IsNullOrEmpty(model.PayerID))
            {
                response.Status = false;
                response.Message = "Token or PayerID is null";
                response.Data = "";
                return BadRequest(response);
            }

            try
            {
                // Process the payment
                response = await _paymentRepo.ProcessPaymentAsync(model);

                if (response.Status)
                {
                    return Ok(response);
                }
                else
                {
                    return BadRequest(response);
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new DTOResponsemodel
                {
                    Status = false,
                    Message = "An error occurred while processing the payment: " + ex.Message,
                    Data = ""
                });
            }
        }


        [HttpPost("PaymentCancel")]
        [AllowAnonymous]
        public async Task<IActionResult> PaymentCancel(string token)
        {
            var response = new DTOResponsemodel();

            // Validate input
            if (string.IsNullOrEmpty(token))
            {
                response.Status = false;
                response.Message = "Token  is null";
                response.Data = "";
                return BadRequest(response);
            }

            try
            {
                // Process the payment
                response = await _paymentRepo.ProcessPaymentCancelAsync(token);

                if (response.Status)
                {
                    return Ok(response);
                }
                else
                {
                    return BadRequest(response);
                }
            }
            catch (Exception ex)
            {

                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new DTOResponsemodel
                {
                    Status = false,
                    Message = "An error occurred while processing the payment: " + ex.Message,
                    Data = ""
                });
            }
        }


