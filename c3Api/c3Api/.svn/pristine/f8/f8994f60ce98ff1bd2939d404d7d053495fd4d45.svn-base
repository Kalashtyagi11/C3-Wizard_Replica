        [HttpPost("payNowDataCyberSource")]
        public async Task<IActionResult> ProcessPayment([FromBody] PaymentFormModelVm modal)
        {

            try
            {
                modal.isBimapost = false;
                var IsBEMA_APIs_Integration = _configuration["IsBEMA_APIs_Integration"];
                if (IsBEMA_APIs_Integration == "1")
                {
                    if (!C3WizardRepository.Repository.ConnectionInfom.APIConnection(_configuration) || !C3WizardRepository.Repository.ConnectionInfom.HasConnection())
                    {
                        return BadRequest(new ResponseModel
                        {
                            Status = false,
                            Message = "Check your internet connection or the server may not be responding. Please try again later or contact S.S.B for assistance.",
                            Statuscode = 503 // Service Unavailable
                        });
                    }
                    modal.isBimapost = true;
                }

                // var user = _Context.Secusers.FirstOrDefault(e => e.UserId == modal.UserId);

                var dt = await _paymentRepo.PayCharge(modal);

                if (dt == null)
                {
                    return BadRequest(new { status = false, msg = "Payment failed: BIMA API data could not be posted." });
                }

                var result = dt.AsEnumerable().Select(row => new TransactionReceipt
                {
                    types = row.Field<string>("PaymentStatus") == "AUTHORIZED" ? 1 : 0,
                    //receiptNumber = row.Field<int>("Id").ToString("D6"),
                    receiptNumber =string.IsNullOrEmpty(row.Field<string>("bimaReceiptNumber"))? row.Field<int>("Id").ToString("D6"): row.Field<string>("bimaReceiptNumber")?.ToString(),
                    regNo = row.Field<string>("RegNumber")?.ToString(),
                    cardHolderName = modal.cardHolderName,
                    // regNo = row.Field<string>("TransactionFor") == "Self" ? _Context.ProcessSelfEmployedC3s.FirstOrDefault(e => e.Sec3id == Convert.ToInt32(row.Field<int>("C3HeaderId"))).Ssn : _Context.ProcessC3headers.FirstOrDefault(e => e.C3headerid == Convert.ToInt32(row.Field<int>("C3HeaderId").ToString())).RegNo,
                    Id = row.Field<string>("PaymentGatewayTransactionID"),
                    Name = row.Field<string>("RefCustomerName"),
                    Email = row.Field<string>("Email")?.ToString(),
                    PaymentStatus = row.Field<string>("PaymentStatus"),
                    Amount = Math.Round(row.Field<decimal>("PaymentAmount"), 2),
                    date = row.Field<string>("CreateTime")
                });



                string isSend = await sendMail(result?.FirstOrDefault());
                if (dt.Rows[0]["PaymentStatus"].ToString() == "AUTHORIZED")
                {

                    isSend = await sendMailPaymentSSB(result?.FirstOrDefault());
                    return Ok(new { Status = true, Message = isSend == "1" ? "Your payment was successful and a confirmation email has been sent to your registered email address." : "Your payment was successful, but the confirmation email could not be sent at this time due to a technical issue.", Data = result, Msg2 = isSend });
                }
                else
                {
                    return Ok(new { Status = false, Message = "Payment Failed", Data = result, Msg2 = isSend });
                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new { Status = false, Message = "Something Went Wrong..!", Data = ex });
            }
        }

        private async Task<string> sendMailPaymentSSB(TransactionReceipt result)
        {
            try
            {
                result.types = -1;
                string bodyMessage = $@"
            <p>Dear <strong>Team</strong>,</p>
            <p>We would like to inform you that a payment has been received from the employer, and the details are as follows:</p>
       
<table style='border-collapse: collapse; width: 100%; max-width: 600px;'>
  <tr>
    <td style='padding: 8px; border: 1px solid #ddd;'><strong>Receipt #:</strong></td>
    <td style='padding: 8px; border: 1px solid #ddd;'>{result.receiptNumber}</td>
  </tr>
  <tr>
    <td style='padding: 8px; border: 1px solid #ddd;'><strong>Registration No:</strong></td>
    <td style='padding: 8px; border: 1px solid #ddd;'>{result.regNo}</td>
  </tr>
  <tr>
    <td style='padding: 8px; border: 1px solid #ddd;'><strong>Customer Name:</strong></td>
    <td style='padding: 8px; border: 1px solid #ddd;'>{result.Name}</td>
  </tr>
  <tr>
    <td style='padding: 8px; border: 1px solid #ddd;'><strong>Transaction ID:</strong></td>
    <td style='padding: 8px; border: 1px solid #ddd;'>{result.Id}</td>
  </tr>
  <tr>
    <td style='padding: 8px; border: 1px solid #ddd;'><strong>Amount Paid:</strong></td>
    <td style='padding: 8px; border: 1px solid #ddd;'>${result.Amount}</td>
  </tr>
  <tr>
    <td style='padding: 8px; border: 1px solid #ddd;'><strong>Status:</strong></td>
    <td style='padding: 8px; border: 1px solid #ddd;'>{result.PaymentStatus}</td>
  </tr>
  <tr>
    <td style='padding: 8px; border: 1px solid #ddd;'><strong>Transaction Date:</strong></td>
    <td style='padding: 8px; border: 1px solid #ddd;'>{result.date}</td>
  </tr>
</table>
<br />


<br />
Administrator (C3 Remittances)
<br />
St. Christopher & Nevis Social Security Board";

                string isTest = _configuration["IsTestMail"];
                string testMail = _configuration["TestMail"];
                string SSBMail = _configuration["SSBMail"];
                string toMail = isTest == "1" ? testMail : SSBMail;

                var projectPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot/Email");
                var engine = new RazorLightEngineBuilder()
                .UseFileSystemProject(projectPath)
                .UseMemoryCachingProvider()
                .Build();
                string htmlContent = await engine.CompileRenderAsync("payment.cshtml", result);
                byte[] pdfBytes = await GeneratePdfFromHtml(htmlContent);

                var mailMessage = new MailMessage
                {
                    From = new MailAddress(_configuration["EmailSettings:SenderEmail"]),
                    Subject = $"Transaction Alert - Payment received from {result.Name}",
                    Body = bodyMessage,
                    IsBodyHtml = true
                };
                mailMessage.To.Add(toMail);

                using var memoryStream = new MemoryStream(pdfBytes);
                mailMessage.Attachments.Add(new Attachment(memoryStream, "PaymentReceipt.pdf", "application/pdf"));
                //mailMessage.Bcc.Add(toMail);
                using var smtpClient = new SmtpClient(_configuration["EmailSettings:SmtpServer"])
                {
                    Port = int.Parse(_configuration["EmailSettings:Port"]),
                    Credentials = new NetworkCredential(
                      _configuration["EmailSettings:SenderEmail"],
                      _configuration["EmailSettings:SenderPassword"]
                  ),
                    EnableSsl = true
                };

                await smtpClient.SendMailAsync(mailMessage);
                return "1";
            }
            catch (Exception ex)
            {

                return ex.ToString();
            }
        }


        private async Task<byte[]> GeneratePdfFromHtml(string htmlContent)
        {
            using (var htmlStream = new MemoryStream(Encoding.UTF8.GetBytes(htmlContent)))
            using (var outputStream = new MemoryStream())
            {
                var converterProperties = new ConverterProperties();
                HtmlConverter.ConvertToPdf(htmlStream, outputStream, converterProperties);

                return outputStream.ToArray();
            }
        }


