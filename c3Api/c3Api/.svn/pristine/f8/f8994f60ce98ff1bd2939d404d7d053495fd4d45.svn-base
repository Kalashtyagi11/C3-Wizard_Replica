        [HttpPost("PostCyberSourceList")]
        public async Task<IActionResult> PostCyberSourceList([FromBody] List<PostCyberSourceVm> dataList)
        {
            ResponseModel response = new ResponseModel();
            if (dataList == null || !dataList.Any())
            {
                return BadRequest("No data received.");
            }
            try
            {
                List<ReconciliationCyberSpaceColumn> entities = new();


                var d = await _Context.ReconciliationCyberSpaceColumns.Where(e => e.UserId == dataList[0].UserId).ToListAsync();
                if (d != null && d.Count != 0)
                {
                    foreach (var item in d)
                    {

                        item.IsActive = dataList.FirstOrDefault(w => w.field == item.Columns).Status;

                    }
                    //_Context.ReconciliationCyberSpaceColumns.AddRange(d);
                    await _Context.SaveChangesAsync();
                    response.Status = true;
                    response.Message = "Data saved successfully.";
                    response.Data = d;
                    response.Statuscode = 200;
                }
                else
                {


                    entities = dataList.Select(item => new ReconciliationCyberSpaceColumn
                    {
                        Columns = item.field,
                        IsActive = item.Status,
                        UserId = dataList[0].UserId,
                        CreatedOn = DateTime.Now,
                        CreatedBy = dataList[0].UserId,
                    }).ToList();

                    _Context.ReconciliationCyberSpaceColumns.AddRange(entities);
                    await _Context.SaveChangesAsync();
                    response.Status = true;
                    response.Message = "Data saved successfully.";
                    response.Data = entities;
                    response.Statuscode = 200;
                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                response.Status = false;
                response.Message = "An error occurred while saving data.";
                response.Statuscode = 500;
                response.Data = ex.Message;

                return StatusCode(500, response);
            }

            return Ok(response);
        }



