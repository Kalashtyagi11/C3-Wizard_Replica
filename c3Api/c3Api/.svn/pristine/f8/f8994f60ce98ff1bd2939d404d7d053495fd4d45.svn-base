Administrator (C3 Remittances)
<br />
St. Christopher & Nevis Social Security Board";

                bodyMessage = bodyMessage + bordyCommon;

                string isTest = _configuration["IsTestMail"];
                string testMail = _configuration["TestMail"];
                string SSBMail = _configuration["SSBMail"];
                string toMail = isTest == "1" ? testMail : result.Email;

                // Step 1: Render Razor View to HTML
                var projectPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot/Email");
                var engine = new RazorLightEngineBuilder()
                .UseFileSystemProject(projectPath)
                .UseMemoryCachingProvider()
                .Build();

                engine.Options.EnableDebugMode = true;
                string htmlContentMain = await engine.CompileRenderAsync("payment.cshtml", result);

                byte[] pdfBytes = await GeneratePdfFromHtml(htmlContentMain);

                using var memoryStream = new MemoryStream(pdfBytes);
                using var message = new MailMessage
                {
                    From = new MailAddress(_configuration["EmailSettings:SenderEmail"]),
                    Subject = $"Transaction Alert {result.Name}",
                    Body = bodyMessage,
                    IsBodyHtml = true
                };

                message.To.Add(toMail);

                message.Attachments.Add(new Attachment(memoryStream, "Receipt.pdf", "application/pdf"));

                using var smtpClient = new SmtpClient(_configuration["EmailSettings:SmtpServer"])
                {
                    Port = int.Parse(_configuration["EmailSettings:Port"]),
                    Credentials = new NetworkCredential(
                        _configuration["EmailSettings:SenderEmail"],
                        _configuration["EmailSettings:SenderPassword"]
                    ),
                    EnableSsl = true
                };

                await smtpClient.SendMailAsync(message);
                return "1";
            }
            catch (Exception ex)
            {
                return ex.ToString();

            }
        }

