        [HttpGet("C3Report/DownloadDirectorPdf")]
        public async Task<IActionResult> DownloadDirectorPdf(string month, string year, int companyId, int c3HeaderId, bool ispaid, bool isDraft)
        {
            try
            {
                if (DateTime.TryParseExact(month, "MMMM", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime date))
                {
                    month = date.Month.ToString();

                }
                else
                {
                    return Ok(new
                    {
                        Status = true,
                        Message = "Invalid month Name"
                    });
                }
                DataTable dt = new DataTable();

                using (SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection)
                {
                    using (SqlCommand cmd = new SqlCommand("Generate_Director_C3_Report", staticConnection))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@Month", month);
                        cmd.Parameters.AddWithValue("@Year", year);
                        cmd.Parameters.AddWithValue("@CompanyId", companyId);
                        cmd.Parameters.AddWithValue("@C3HEADERID", c3HeaderId);

                        await staticConnection.OpenAsync();
                        SqlDataAdapter adapter = new SqlDataAdapter(cmd);
                        adapter.Fill(dt);
                        await staticConnection.CloseAsync();
                    }
                }

                if (dt.Rows.Count == 0)
                {
                    return BadRequest("No data found for Director C3 report.");
                }
                int c3count = 0;
                foreach (DataRow row in dt.Rows)
                {
                    row[0] = ++c3count;
                }

                string rdlcFile = dt.Rows.Count <= 8 ? "DirectorC3Report.rdlc" : "DirectorC3more8Report.rdlc";
                string reportPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "Report", rdlcFile);

                if (!System.IO.File.Exists(reportPath))
                {
                    return BadRequest($"RDLC file not found: {reportPath}");
                }

                LocalReport report = new LocalReport();
                report.ReportPath = reportPath;

                report.DataSources.Add(new ReportDataSource("C3Report", dt));

                report.EnableExternalImages = true;

                string imagePath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "imagepaid.png");
                string watermarkImage = "";

                if (ispaid && System.IO.File.Exists(imagePath))
                {
                    // Use file:// URI path
                    watermarkImage = "file:///" + imagePath.Replace("\\", "/");
                }
                if (isDraft)
                {
                    string imagePathd = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "imagedraft.png");
                    watermarkImage = "file:///" + imagePathd.Replace("\\", "/");
                }
                report.SetParameters(new ReportParameter("WatermarkImage", watermarkImage));

                var result = report.Render("PDF");
                return File(result, "application/pdf", $"DirectorC3Report_{month}_{year}.pdf");
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return BadRequest($"Error generating Director C3 PDF: {ex.Message}");
            }
        }

        [HttpGet("checkDirectorReports")]
        public async Task<IActionResult> checkDirectorReports(string monthId, string year, int companyId, int c3HeaderId/*, bool is_dash*/)
        {

            try
            {
                if (DateTime.TryParseExact(monthId, "MMMM", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime date))
                {
                    monthId = date.Month.ToString();

                }
                else
                {
                    return Ok(new
                    {
                        Status = true,
                        Message = "Invalid month Name"
                    });
                }

                var reportsData = await _NonDirectorRepo.check_batch_created_Director(monthId, year, companyId, c3HeaderId);
                if (reportsData != null)
                {
                    if (reportsData.dirReportsList == null)
                    {
                        var result = (from c3 in _context.ProcessC3headers
                                      join company in _context.MasterCompanies
                                        on c3.EmployerId equals company.CompanyId
                                      where c3.C3headerid == c3HeaderId
                                            && c3.isNilReturn == true
                                            && c3.EmployerId == companyId
                                      select new
                                      {
                                          isNilData = (c3.isNilReturn ?? false),
                                          month_year = _C3.MonthName(Convert.ToInt32(c3.PerioddMonth)) + " - " + c3.PeriodYear,
                                          company_name = company.CompanyName,
                                          trade_name = company.TradeName,
                                          company_address = company.Address1 +
                                                            (string.IsNullOrEmpty(company.Address2) ? "" : " " + company.Address2) +
                                                            ", " + (company.City ?? ""),
                                          company_reg_no = company.RegNumber,
                                          date = c3.IsSubmitted == true ? c3.C3SubmittedDate : (c3.IsSentForEdit == true
                                             ? c3.C3SubmittedDate
                                             : c3.InsertDatetimeinfo)
                                      }).FirstOrDefault();

                        return Ok(new ResponseModel
                        {
                            Status = true,  // Indicate success
                            Message = "NIL return  data get successfully.",
                            Data = result,
                            Statuscode = 200
                        });
                    }


                    return Ok(new ResponseModel { Status = true, Message = "Data Found..!", Data = reportsData });
                }
                else
                {

                    return Ok(new ResponseModel { Status = false, Message = "Data Not Found..!", Data = null });
                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return Ok(new ResponseModel { Status = false, Message = "Something Went Wrong", Data = ex });
            }
        }
        private string MonthName(string m_no)
        {
            string Month = "";
            switch (m_no)
            {
                //case "1" or "0":
                //    Month = "January";
                //    break;
                case "1":
                    Month = "January";
                    break;
                case "2":
                    Month = "February";
                    break;
                case "3":
                    Month = "March";
                    break;
                case "4":
                    Month = "April";
                    break;
                case "5":
                    Month = "May";
                    break;
                case "6":
                    Month = "June";
                    break;
                case "7":
                    Month = "July";
                    break;
                case "8":
                    Month = "August";
                    break;
                case "9":
                    Month = "September";
                    break;
                case "10":
                    Month = "October";
                    break;
                case "11":
                    Month = "November";
                    break;
                case "12":
                    Month = "December";
                    break;
                default:
                    Month = string.Empty;
                    break;
            }


            return Month;
        }
