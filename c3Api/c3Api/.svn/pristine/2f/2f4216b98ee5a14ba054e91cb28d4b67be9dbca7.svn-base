        [HttpPost("C3Report_Delete_Click")]
        public async Task<IActionResult> C3Report_Delete_Click(int HeaderID)
        {
            try
            {
                var isSubmitted = _context.ProcessC3headers.FirstOrDefault(p => p.C3headerid == HeaderID);
                if ((isSubmitted?.IsSubmitted ?? false) || (isSubmitted?.IsSentForEdit ?? false))
                {
                    return Ok(new ResponseModel
                    {
                        Status = true,  // Indicate success
                        Message = "Deletion is not allowed as this record has already been submitted for SSB.",
                        Data = "",
                        Statuscode = 200
                    });
                }

                var status = await _NonDirectorRepo.C3Report_Delete(HeaderID);
                if (status)
                {
                    return Ok(new ResponseModel { Status = true, Message = "Director payroll deleted successfully" });
                }
                return Ok(new ResponseModel { Status = false, Message = "Director payroll deleted Failed" });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel { Status = false, Message = "Something Went Wrong", Data = ex });
            }
        }


        [AllowAnonymous]
        [HttpGet("NWDirectorReports")]
        public async Task<IActionResult> NWDirectorReports(int? MonthF, int? MonthTO, string? Year, string? endYear, int CompanyId)
        {

            try
            {
                //int? F_month = MonthF > 0 ? MonthF : null;
                //int? T_month = MonthTO > 0 ? MonthTO : null;

                //string value = Year;
                //string S_year = Year;

                int? StartMonths = null;
                int? endMonths = null;

                // 1. FromMonth >= and ToMonth is null
                if (MonthF != null && MonthF > 0 && (MonthTO == null || MonthTO <= 0))
                {
                    StartMonths = MonthF;
                    endMonths = null; // No upper bound
                }
                // 2. FromMonth >= and ToMonth <=
                else if (MonthF != null && MonthF > 0 && MonthTO != null && MonthTO > 0)
                {
                    StartMonths = MonthF;
                    endMonths = MonthTO;
                }
                // 3. FromMonth is null and ToMonth <=
                else if ((MonthF == null || MonthF <= 0) && MonthTO != null && MonthTO > 0)
                {
                    StartMonths = null;
                    endMonths = MonthTO;
                }
                // 4. FromMonth is null and ToMonth is null
                else if ((MonthF == null || MonthF <= 0) && (MonthTO == null || MonthTO <= 0))
                {
                    StartMonths = null;
                    endMonths = null;
                }
                int? StartYear = null;
                int? EndYear = null;

                // --- Year Logic ---
                if (Year != null && Convert.ToInt32(Year) > 0 && (endYear == null || Convert.ToInt32(endYear) <= 0))
                {
                    StartYear = Convert.ToInt32(Year);
                    EndYear = null;
                }
                else if (Year != null && Convert.ToInt32(Year) > 0 && endYear != null && Convert.ToInt32(endYear) > 0)
                {
                    StartYear = Convert.ToInt32(Year);
                    EndYear = Convert.ToInt32(endYear);
                }
                else if ((Year == null || Convert.ToInt32(Year) <= 0) && endYear != null && Convert.ToInt32(endYear) > 0)
                {
                    StartYear = null;
                    EndYear = Convert.ToInt32(endYear);
                }
                else if ((Year == null || Convert.ToInt32(Year) <= 0) && (endYear == null || Convert.ToInt32(endYear) <= 0))
                {
                    StartYear = null;
                    EndYear = null;
                }

                List<C3Header> listDVOC3Header = new List<C3Header>();
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                SqlCommand cmd = new SqlCommand("Get_Director_C3_Genrated_data", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                DataTable dt = new DataTable();
                sqlAdapter.Fill(dt);
                staticConnection.Close();
                if (dt.Rows.Count > 0)
                {
                    foreach (DataRow row in dt.Rows)
                    {
                        bool issubmited = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                        bool isfinalize = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                        int C3month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? -1 : int.Parse(row["PERIODD_MONTH"].ToString());
                        int C3year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? -1 : int.Parse(row["PERIOD_YEAR"].ToString());
                        if ((issubmited == true || isfinalize == true))
                        {
                            C3Header Obj = new C3Header();
                            Obj.HeaderID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                            Obj.RegNo = Convert.IsDBNull(row["RegNo"]) ? null : row["RegNo"].ToString();
                            Obj.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : MonthName((Convert.ToInt32(row["PERIODD_MONTH"])).ToString());
                            Obj.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString();
                            Obj.p_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? -1 : int.Parse(row["PERIODD_MONTH"].ToString());
                            Obj.P_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? -1 : int.Parse(row["PERIOD_YEAR"].ToString());
                            Obj.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
                            Obj.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_SSCONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString())));
                            Obj.TOTALLEVYEEEMPLOYEE = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString())));
                            Obj.TOTALSERVAYANCE = Convert.IsDBNull(row["TOTAL_SERVAYANCE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SERVAYANCE"].ToString())));
                            Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString("dd-MM-yyyy");
                            //Obj.Insert_Datetime = Convert.IsDBNull(row["Insert_Datetime"]) ? DateTime.Parse("01/01/1900") : DateTime.Parse(row["Insert_Datetime"].ToString());
                            Obj.Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                            Obj.Is_submitted = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                            Obj.C3_IsFinalized = !Obj.C3_IsFinalized;
                            Obj.IssubmittedShow = (bool)Obj.Is_submitted ? "C3 Submitted" : "C3 not Submitted";
                            Obj.Issubmittedcolor = (bool)Obj.Is_submitted ? "Black" : "Red";
                            Obj.IssubmittedShowimg = (bool)Obj.Is_submitted ? "/img/RightSine.png" : "/img/close.png";
                            Obj.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                            Obj.TOTALLEVYEEPENALTY = Convert.IsDBNull(row["TOTAL_LEVYEEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEPENALTY"].ToString())));
                           // Obj.IsPaid = _context.OnlinePayments.Any(e => e.C3HeaderId == Obj.HeaderID && (e.PaymentStatus == "AUTHORIZED" || e.PaymentStatus == "Offline Payment"));


                            var Paymentdetails = _context.OnlinePayments.Where(e => e.C3HeaderId == Obj.HeaderID && e.IsActive && e.TransactionFor != "Self").OrderByDescending(f => f.Id).Select(r => new { r.PaymentStatus, r.PaymentGatewayTransactionID,r.mode,r.bimaReceiptNumber,r.CreateTime,r.Id });
                            Obj.IsPaid = Paymentdetails.Any(e => e.PaymentStatus == "AUTHORIZED" || e.PaymentStatus == "Offline Payment");
                            Obj.IsPaidStatus = Paymentdetails?.FirstOrDefault()?.PaymentStatus;
                            Obj.PayDetails = new List<TransactionDetails> { new TransactionDetails { receiptDate= Paymentdetails.FirstOrDefault()?.CreateTime, receiptNumber= Paymentdetails.FirstOrDefault()?.bimaReceiptNumber?? Paymentdetails.FirstOrDefault()?.Id.ToString("D6"), TransactionID = Paymentdetails.FirstOrDefault()?.PaymentGatewayTransactionID, mode = Paymentdetails.FirstOrDefault()?.mode } };


                            Obj.isNilReturn = Convert.IsDBNull(row["isNilReturn"]) ? false : bool.Parse(row["isNilReturn"].ToString());
                            Obj.Notes = Convert.IsDBNull(row["Notes"]) ? null : row["Notes"].ToString();
                            Obj.IsImportFromBEMA = bool.Parse(row["IsImportFromBEMA"].ToString());
                            listDVOC3Header.Add(Obj);
                        }
                    }
                    //listDVOC3Header = S_year != null ? listDVOC3Header.Where(x => Convert.ToInt32(x.Period_year) >= Convert.ToInt32(S_year) && Convert.ToInt32(x.Period_year) <= Convert.ToInt32(endYear)).ToList() : listDVOC3Header;
                    ////listDVOC3Header = F_month != -1 ? listDVOC3Header.Where(x => x.p_Month >= F_month).OrderBy(x => x.p_Month).ToList() : listDVOC3Header;
                    ////listDVOC3Header = T_month != -1 ? listDVOC3Header.Where(x => x.p_Month <= T_month).OrderBy(x => x.p_Month).ToList() : listDVOC3Header;
                    //listDVOC3Header = (F_month != null && F_month > 0) ? listDVOC3Header.Where(x => x.p_Month >= F_month).OrderBy(x => x.p_Month).ToList() : listDVOC3Header;
                    //listDVOC3Header = (T_month != null && T_month > 0) ? listDVOC3Header.Where(x => x.p_Month <= T_month).OrderBy(x => x.p_Month).ToList() : listDVOC3Header;


                    var repotList = listDVOC3Header.Select(e => new
                    {
                        Year = e.P_year,
                        month = e.period_Month,
                        monthno = e.p_Month,
                        totalWages = e.TOTAL_WAGES,
                        Levy = e.TOTALLEVYEEEMPLOYEE,
                        createDate = e.Insert_Datetimeinfo,
                        schedule = e.Schedule_NO,
                        color = e.Issubmittedcolor,
                        HeaderID = e.HeaderID,
                        TOTALLEVYEEPENALTY = e.TOTALLEVYEEPENALTY,
                        Is_submitted = e.Is_submitted,
                        ispaid = e.IsPaid,
                        payAmt = e.TOTALLEVYEEEMPLOYEE + e.TOTALLEVYEEPENALTY,
                        isNilReturn = e.isNilReturn,
                        e.Notes,
                        e.IsImportFromBEMA,
                        e.IsPaidStatus,
                        e.PayDetails.FirstOrDefault()?.TransactionID,
                        e.PayDetails.FirstOrDefault()?.mode
                    });

                    DateTime? startDate0 = null;
                    DateTime? endDate0 = null;

                    if (StartYear != null)
                    {
                        if (StartMonths != null)
                            startDate0 = new DateTime(StartYear.Value, StartMonths.Value, 1);
                        else
                            startDate0 = new DateTime(StartYear.Value, 1, 1); // Defaults to Jan if month missing
                    }

                    // Rule: Determine End Date (show until this point)
                    if (EndYear != null)
                    {
                        if (endMonths != null)
                            endDate0 = new DateTime(EndYear.Value, endMonths.Value, DateTime.DaysInMonth(EndYear.Value, endMonths.Value));
                        else
                            endDate0 = new DateTime(EndYear.Value, 12, 31); // Defaults to Dec if month missing
                    }

                    // --- DVOC3Header Filtering ---
                    if (repotList != null)
                    {
                        repotList = repotList.AsEnumerable();

                        if (startDate0 != null || endDate0 != null)
                        {
                            repotList = repotList.Where(p =>
                            {
                                int year = Convert.ToInt32(p.Year);
                                int month = Convert.ToInt32(p.monthno);
                                DateTime periodDate = new DateTime(year, month, 1);

                                return (!startDate0.HasValue || periodDate >= startDate0.Value) &&
           (!endDate0.HasValue || periodDate <= endDate0.Value);
                            }).ToList();
                        }
                    }

                    return Ok(new ResponseModel { Status = true, Message = "data found", Data = repotList });
                }
                else
                {

                    return Ok(new ResponseModel { Status = true, Message = "data found", Data = null });
                }
                //}
            }
            catch (Exception ex)
            {
                //Login login = new Login();
                //login.Error_Log(ex.Message);
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel { Status = false, Message = "Something Went Wrong" });
            }


        }
