        [AllowAnonymous]
        [HttpPost]
        [Route("NWSaveNContinue")]
        public async Task<IActionResult> NWSaveNContinue([FromBody] SaveNContinueRequest request)
        {
            try
            {
                int TextChanged = 0;
                bool ListHavingItems = false;
                bool w = false; bool m = false; bool b = false; bool s = false;
                bool Nw = false; bool Nm = false; bool Nb = false; bool Ns = false;
                bool W_SPP = false; bool E_2W_SPP = false; bool M_SPP = false; bool T_M_SPP = false;

                if (request.CmbPayPeriod == null)
                {
                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                        Message = "Please click on Create button to fetch the data for the selected period.",
                        Data = null,
                    });
                }

                if (request.isNilReturn==false && request.AllEmployeeList_List.Count==0)
                {
                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                        Message = "no employees list found",
                        Data = null,
                    });
                }

                foreach (var item in request.CmbPayPeriod)
                {
                    if (item.Value == "W")
                    { Nw = true; W_SPP = true; }
                    else if (item.Value == "M")
                    { Nm = true; M_SPP = true; }
                    else if (item.Value == "E2W")
                    { Nb = true; E_2W_SPP = true; }
                    else if (item.Value == "2M")
                    { Ns = true; T_M_SPP = true; }

                    if (item.Value == "W")
                    { w = true; W_SPP = true; }
                    else if (item.Value == "M")
                    { m = true; M_SPP = true; }
                    else if (item.Value == "E2W")
                    { b = true; E_2W_SPP = true; }
                    else if (item.Value == "2M")
                    { s = true; T_M_SPP = true; }
                    else if (item.Value == "All")
                    {
                        Nw = true; W_SPP = true;
                        Nm = true; M_SPP = true;
                        Nb = true; E_2W_SPP = true;
                        Ns = true; T_M_SPP = true;

                        m = true; M_SPP = true;
                        w = true; W_SPP = true;
                        b = true; E_2W_SPP = true;
                        s = true; T_M_SPP = true;
                    }
                }
                if (request.H_Id != 0)
                {
                    string Payperiodchange = "";
                    Payperiodchange += W_SPP == Nw ? "" : "Weekly";
                    Payperiodchange += M_SPP == Nm ? "" : "Monthly";
                    Payperiodchange += E_2W_SPP == Nb ? "" : "Every Two Weeks";
                    Payperiodchange += T_M_SPP == Ns ? "" : "Twice in a Month";

                    if (Payperiodchange != "")
                    {

                        return Ok(new ResponseModel
                        {
                            Status = false,
                            Message = "Please click on Create button to fetch the data for the selected period.",
                            Data = null,
                        });
                    }
                }
                else
                {
                    string Payperiodchange = "";
                    Payperiodchange += W_SPP == Nw ? "" : "Weekly";
                    Payperiodchange += M_SPP == Nm ? "" : "Monthly";
                    Payperiodchange += E_2W_SPP == Nb ? "" : "Every Two Weeks";
                    Payperiodchange += T_M_SPP == Ns ? "" : "Twice in a Month";

                    if (Payperiodchange != "")
                    {

                        return Ok(new ResponseModel
                        {
                            Status = false,
                            Message = "Please click on Create button to fetch the data for selected period.",
                            Data = null,

                        });
                    }
                }

                bool IsWeekfifth = false;
                string fyear = request.Year.ToString();
                int fmonthno = request.Monthno;
                string fMvalue = request.MonthName;
                string fmonthval = fmonthno <= 9 ? "0" + fmonthno.ToString() : fmonthno.ToString();
                DateTime? newFrom_date = DateTime.ParseExact(("01/" + fmonthval + "/" + fyear), Helper.DateFormat, CultureInfo.InvariantCulture);
                int daysfMonth = DateTime.DaysInMonth(int.Parse(fyear), fmonthno);
                DateTime? newTo_date = newFrom_date.Value.AddDays(daysfMonth - 1);
                request.schedule_no = _C3.GetMaxScheduleNo(request.Monthno, Convert.ToInt32(fyear), request.CompanyId,1);
                UserVM CompanyDetails = _C3.GetCompanyDetails(request.CompanyId);
                if (request.H_Id == 0)
                {
                    SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                    if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
