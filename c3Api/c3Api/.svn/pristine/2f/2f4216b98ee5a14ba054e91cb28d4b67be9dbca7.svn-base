        [HttpPost("NewDirectorDetailsC3")]
        public async Task<IActionResult> NewDirectorDetailsC3(int monthNo, string Year,/* string Monthtype,*/ int CompanyId, List<PayPeriod1> CmbPayPeriod, bool isNilReturn)
        {
            try
            {
                //1
                var periodList = _NonDirectorRepo.PayPeriodDropDownData(CompanyId);
                var data = isNilReturn ? new List<C3Contributions>() : await _NonDirectorRepo.LoadDirectorC3(monthNo, Year, CompanyId, CmbPayPeriod, 0);

                foreach (var item in data)
                {
                    if (item.PayPeriod == "W")
                        item.PayPeriod = "W - Weekly";
                    if (item.PayPeriod == "M")
                        item.PayPeriod = "M - Monthly";
                    if (item.PayPeriod == "E2W")
                        item.PayPeriod = "E2W - Every Two Weeks"; // retObj._payPeriodforlist = "Every Two Weeks"; Old Code             
                    if (item.PayPeriod == "2M")
                        item.PayPeriod = "2M - Twice Monthly"; //retObj._payPeriodforlist = "Twice Monthly";
                }

                if (data != null && data.Count!=0)
                {
                    var isC3Created = _context.ProcessC3headers.Where(e => e.PerioddMonth == monthNo.ToString() && e.PeriodYear == Year && e.EmployerId == CompanyId && e.ForDirector == true)?.OrderByDescending(e => e.ScheduleNo)?.FirstOrDefault();
                    string msg = isC3Created != null && (isC3Created.IsSubmitted ?? false) ? "C3 has already been submitted for this month.Do you want to create a new C3 with another schedule " + (isC3Created.ScheduleNo + 1) : "";


                    return Ok(new { Status = true, Message = "data found..!", Msg = msg, Data = new { isNilReturn, data, periodList } });
                }
                return BadRequest(new { Status = false, Message = "data Not found..!", Data = "" });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel { Status = false, Message = "Something Went Wrong..!", Data = null });
            }
        }

        [HttpGet("NewDirectorMainDetails")]
        public async Task<IActionResult> NewDirectorMainDetails(int CompanyId)
        {
            try
            {
                var data = await _NonDirectorRepo.load_defaults(CompanyId);
                var periodList = _NonDirectorRepo.PayPeriodDropDownData(CompanyId);
                var data1 = data.Select(e => new C3HeaderVM
                {
                    HeaderID = e.HeaderID,
                    RegNo = e.RegNo,
                    period_Month = e.period_Month,
                    Period_year = e.Period_year,
                    TOTAL_WAGES = e.TOTAL_WAGES,
                    TOTALSSCONTRIBUTIONS = e.TOTALSSCONTRIBUTIONS,
                    TOTALLEVYEEPENALTY = e.TOTALLEVYEEPENALTY,
                    TOTALLEVYEEEMPLOYEE = e.TOTALLEVYEEEMPLOYEE,
                    Insert_Datetimeinfo = e.Insert_Datetimeinfo,
                    Is_Fianalize = e.Is_Fianalize,
                    Is_submitted = e.Is_submitted,
                    Schedule_NO = e.Schedule_NO,
                    isNilReturn = e.isNilReturn
                }).ToList();
                if (data != null)
                {
                    return Ok(new ResponseModel { Status = true, Message = "data found..!", Data = new { data1, periodList } });
                }
                return Ok(new ResponseModel { Status = false, Message = "data Not found..!", Data = null });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel { Status = false, Message = "Something Went Wrong..!", Data = null });
            }
        }



        [HttpPost("SaveNewDirector")]
        public async Task<IActionResult> SaveNewDirector([FromBody] saveDirPayrolVM obj)//(string MonthName, int monthNum, int CompanyId, int year, List<PayPeriod1> CmbPayPeriod, List<string> ssnList, bool directorExistContinue, int UserID, string MachineInfo, string User_Name, int H_Id, bool ispayperiodchange = false)
        {
            try
            {
                bool isSave = false;
                string PatPmessage = "";

                if (obj.MonthNum == 0)
                {
                    PatPmessage += "pay period Month \n";
                }
                if (obj.Year == 0)
                {
                    PatPmessage += "pay period Year \n";
                }
                if (obj.CmbPayPeriod != null)
                {
                    if (obj.CmbPayPeriod.Count <= 0)
                    {
                        PatPmessage += "pay period \n";
                    }
                }
                if (obj.SelectList != null)
                {
                    if (obj.SelectList.Count <= 0)
                    {
                        PatPmessage += "Select List Fill \n";
                    }
                }
                else
                {
                    PatPmessage += "pay period \n";
                }
                if (PatPmessage != "")
                {
                    return Ok(new ResponseModel { Status = false, Message = "C3 Wizard Please select" + PatPmessage });

                }
                if (obj.IsPayPeriodChange != true)
                {

                    isSave = true;
                    var msg = await _NonDirectorRepo.SaveNContinue(null, isSave, obj.DirectorExistContinue, obj.UserID, obj.MachineInfo, obj.User_Name, obj.Year, /*MonthName,*/ obj.MonthNum, obj.CompanyId, obj.CmbPayPeriod, obj.SelectList, obj.H_Id, false, false, false, false/*, false, false, false, false*/, 1);



                    return Ok(new ResponseModel { Status = true, Message = msg, Data = null });
                }
                else
                {
                    return Ok(new ResponseModel { Status = false, Message = "Please click on Create button to fetch the data for this month !" });
                }



            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel { Status = false, Message = "Something Went Wrong..!", Data = ex });
            }
        }

        [HttpPost("EditDirectorPayrollView")]
        public async Task<IActionResult> EditDirectorPayrollView(editDirC3Vm obj) //(int HeaderId, int CompanyId, int monthno, int Year,bool isPopup = false)
        {
            try
            {

                // var periodList = _NonDirectorRepo.PayPeriodDropDownData(CompanyId);
                var Alldata = await _NonDirectorRepo.NonDirectorRepoEdit(obj.HeaderId, obj.CompanyId, obj.monthno, obj.Year);

                //string Mvalue = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(obj.monthno);
                int daysin_month = DateTime.DaysInMonth(obj.Year, obj.monthno);
                string monthval = obj.monthno <= 9 ? "0" + obj.monthno.ToString() : obj.monthno.ToString();
                DateTime Today_date = DateTime.ParseExact(("01/" + monthval + "/" + obj.Year), Helper.DateFormat, CultureInfo.InvariantCulture);
                DateTime? Todaydate = DateTime.ParseExact(("01/" + monthval + "/" + obj.Year), Helper.DateFormat, CultureInfo.InvariantCulture);

                DateTime? end_date = Todaydate != null ? (DateTime?)((DateTime)Todaydate).AddDays(daysin_month - 1) : null;
                Alldata = Alldata.DistinctBy(e => (e.C3HEADERID, e.SSN)).Where(x => (x.Date_terminated == null || Convert.ToDateTime(x.Date_terminated) >= Todaydate) && (x.Date_Joining == null || Convert.ToDateTime(x.Date_Joining) <= end_date)).ToList();

                var dataEdit = Alldata.DistinctBy(e => (e.C3HEADERID, e.SSN)).Where(e => e.C3HEADERID != 0).ToList();

                ProcessC3header C3headers = _context.ProcessC3headers.Where(p => p.C3headerid == obj.HeaderId && p.EmployerId == obj.CompanyId)?.FirstOrDefault();


                var header = new
                {
                    headerID = dataEdit?.FirstOrDefault()?.C3HEADERID ?? C3headers?.C3headerid,
                    period_year = dataEdit?.FirstOrDefault()?.Period_year ?? C3headers?.PeriodYear,
                    period_Month = dataEdit?.FirstOrDefault()?.period_Month ?? C3headers?.PerioddMonth,
                    isNilReturn = obj.isNilReturn == null ? C3headers.isNilReturn : obj.isNilReturn
                };


                if (C3headers != null)
                {
                    if (C3headers.OrderName == "employeeName")
                    {
                        var data = dataEdit.GroupBy(x => x.PayFreq)
                                  .Select(group => new
                                  {
                                      PayPeriod = group.Key,
                                      Employees = C3headers?.OrderKey == "asc" ? group.OrderBy(x => x.PayFreq).ThenBy(x => x.EmployeeName).ToList()
                                          : group.OrderBy(x => x.PayFreq).OrderByDescending(x => x.EmployeeName).ToList()
                                  }).OrderBy(x => x.PayPeriod).ToList();

                        dataEdit = data.SelectMany(g => g.Employees).ToList();
                    }
                    if (C3headers.OrderName == "ssn")
                    {
                        var data = dataEdit.GroupBy(x => x.PayFreq)
                                  .Select(group => new
                                  {
                                      PayPeriod = group.Key,
                                      Employees = C3headers?.OrderKey == "asc" ? group.OrderBy(x => x.PayFreq).ThenBy(x => x.SocialSecurity).ToList()
                                          : group.OrderByDescending(x => x.SocialSecurity).ToList()
                                  }).OrderBy(x => x.PayPeriod).ToList();

                        dataEdit = data.SelectMany(g => g.Employees).ToList();
                    }
                }

                foreach (var item in dataEdit)
                {
                    if (item.PayPeriod == "W")
                        item.PayPeriod = "W - Weekly";
                    if (item.PayPeriod == "M")
                        item.PayPeriod = "M - Monthly";
                    if (item.PayPeriod == "E2W")
                        item.PayPeriod = "E2W - Every Two Weeks";
                    if (item.PayPeriod == "2M")
                        item.PayPeriod = "2M - Twice Monthly";
                }
                List<C3Contributions> zeroC3HEADERID = null;

                if (obj.isNilReturn == null && !(C3headers?.isNilReturn ?? false))
                {
                    if (obj.popUpList == null)
                    {
                        zeroC3HEADERID = new List<C3Contributions>();

                        zeroC3HEADERID = Alldata.DistinctBy(e => (e.C3HEADERID, e.SSN)).Where(x => x.C3HEADERID == 0).ToList();

                    }
                    else
                    {

                        Alldata.RemoveAll(e => e.C3HEADERID == 0 && obj.popUpList.Contains(e.SSN));
                        //allEmployeeList.ForEach(r => r.emp_add_remove = true);
                        dataEdit = Alldata;
                        //dataEdit.Where(d=>d.emp_add_remove==false).ForEach(r => r.emp_add_remove = true);


                        foreach (var item in dataEdit.Where(d => !d.emp_add_remove))
                        {
                            item.emp_add_remove = true;
                            if (item.PayPeriod == "W")
                                item.PayPeriod = "W - Weekly";
                            if (item.PayPeriod == "M")
                                item.PayPeriod = "M - Monthly";
                            if (item.PayPeriod == "E2W")
                                item.PayPeriod = "E2W - Every Two Weeks";
                            if (item.PayPeriod == "2M")
                                item.PayPeriod = "2M - Twice Monthly";
                        }
                    }
                }
                else if (obj.isNilReturn == null && (C3headers?.isNilReturn ?? true))
                {
                    dataEdit = new List<C3Contributions>();
                }
                else
                {
                    if (obj.isNilReturn == true)
                    {
                        zeroC3HEADERID = null;
                        dataEdit = new List<C3Contributions>();
                    }
                    else if (obj.isNilReturn == false)
                    {
                        List<PayPeriod1> payperiodList = JsonConvert.DeserializeObject<List<PayPeriod1>>("[{ \"Key\":\"W - Weekly\",\"Value\":\"W\"}, { \"Key\":\"M - Monthly\",\"Value\":\"M\"}, { \"Key\":\"E2W - Every Two Weeks\",\"Value\":\"E2W\"}, { \"Key\":\"2M - Twice Monthly\",\"Value\":\"2M\"}]");
                        var employee = await _NonDirectorRepo.LoadDirectorC3(obj.monthno, obj.Year.ToString(), obj.CompanyId, payperiodList, 0);

                        foreach (var item in employee)
                        {
                            if (item.PayPeriod == "W")
                                item.PayPeriod = "W - Weekly";
                            if (item.PayPeriod == "M")
                                item.PayPeriod = "M - Monthly";
                            if (item.PayPeriod == "E2W")
                                item.PayPeriod = "E2W - Every Two Weeks";
                            if (item.PayPeriod == "2M")
                                item.PayPeriod = "2M - Twice Monthly";
                        }

                        zeroC3HEADERID = dataEdit.Count == 0 ? employee : dataEdit.Where(e => e.C3HEADERID == 0).ToList();
                        dataEdit = dataEdit.Count == 0 ? employee : dataEdit;
                        if (dataEdit.Count == zeroC3HEADERID.Count)
                        {
                            zeroC3HEADERID = null;
                        }
                        else
                        {
                            dataEdit.RemoveAll(e => e.C3HEADERID == 0);
                        }

                    }
                }

                return Ok(new ResponseModel { Status = true, Message = "data found", Data = new { dataEdit, header, popUpList = zeroC3HEADERID } });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel { Status = false, Message = "Something Went Wrong..!", Data = ex });
            }
        }

