                                    obj.TotalWadeges = obj.WAGES1 + obj.WAGES2 + obj.WAGES3 + obj.WAGES4 + obj.WAGES5;
                                    decimal? Total_weekly = obj.WAGES1 + obj.WAGES2 + obj.WAGES3 + obj.WAGES4 + obj.WAGES5;
                                    decimal? w1_amt = obj.WAGES1, w2_amt = obj.WAGES2, w3_amt = obj.WAGES3, w4_amt = obj.WAGES4, w5_amt = obj.WAGES5;


                                    var W1_WDTDL = WeelelyDeductionsTaxDetailslist.Where(x => x.OverAmt < w1_amt).ToList();
                                    decimal? W1_LEVYEE = _NonDirectorRepo.Levy_amount(W1_WDTDL, w1_amt);

                                    var W2_WDTDL = WeelelyDeductionsTaxDetailslist.Where(x => x.OverAmt < w2_amt).ToList();
                                    decimal? W2_LEVYEE = _NonDirectorRepo.Levy_amount(W2_WDTDL, w2_amt);

                                    var W3_WDTDL = WeelelyDeductionsTaxDetailslist.Where(x => x.OverAmt < w3_amt).ToList();
                                    decimal? W3_LEVYEE = _NonDirectorRepo.Levy_amount(W3_WDTDL, w3_amt);

                                    var W4_WDTDL = WeelelyDeductionsTaxDetailslist.Where(x => x.OverAmt < w4_amt).ToList();
                                    decimal? W4_LEVYEE = _NonDirectorRepo.Levy_amount(W4_WDTDL, w4_amt);

                                    var W5_WDTDL = WeelelyDeductionsTaxDetailslist.Where(x => x.OverAmt < w5_amt).ToList();
                                    decimal? W5_LEVYEE = _NonDirectorRepo.Levy_amount(W5_WDTDL, w5_amt);

                                    decimal? amount_WDTDL = obj.WAGES1 + obj.WAGES2 + obj.WAGES3 + obj.WAGES4 + obj.WAGES5;
                                    var Total_WDTDL = WeelelyDeductionsTaxDetailslist.Where(x => x.OverAmt < amount_WDTDL).ToList();
                                    decimal? totalmonthwageslevy = _NonDirectorRepo.Levy_amount(Total_WDTDL, amount_WDTDL);
                                    decimal? totallevy = W1_LEVYEE + W2_LEVYEE + W3_LEVYEE + W4_LEVYEE + W5_LEVYEE;
                                    obj.LEVYEE = (amount_WDTDL >= 6500 ? totalmonthwageslevy : totallevy) + (obj.BONUS > 1500 ? ((obj.BONUS * 8) / 100) : 0);
                                    amount = obj.WAGES1 + obj.WAGES2 + obj.WAGES3 + obj.WAGES4 + obj.WAGES5;

                                    obj.Levy_Penalty = Latemonths >= 2 ? (obj.LEVYEE * (8 + Latemonths)) / 100 : 0;

                                    obj.Remarks = i.Remarks.ToString();
                                    obj.IsemployeeDirector = false;
                                    obj.BirthDate = i.BirthDate;
                                    obj.emp_add_remove = i.emp_add_remove;
                                    obj_list.Add(obj);
                                }
                                else if ((!ear || !w) && PayFreq == "W")
                                {
                                    C3Contributions Not_obj = new C3Contributions();
                                    Not_obj.SSN = i.SSN.ToString();
                                    Not_obj.SSND = i.SSND.ToString();
                                    Not_obj.EmployeeName = i.EmployeeName.ToString();
                                    Not_obj.WEEK1 = (bool)i.WEEK1;
                                    Not_obj.WEEK2 = (bool)i.WEEK2;
                                    Not_obj.WEEK3 = (bool)i.WEEK3;
                                    Not_obj.WEEK4 = (bool)i.WEEK4;
                                    Not_obj.WEEK5 = (bool)i.WEEK5;
                                    Not_obj.WAGES1 = (decimal)i.WAGES1;
                                    Not_obj.WAGES2 = (decimal)i.WAGES2;
                                    Not_obj.WAGES3 = (decimal)i.WAGES3;
                                    Not_obj.WAGES4 = (decimal)i.WAGES4;
                                    Not_obj.WAGES5 = (decimal)i.WAGES5;
                                    Not_obj.HPAY = (decimal)i.HPAY;
                                    Not_obj.BONUS = (decimal)i.BONUS;
                                    Not_obj.Date_Joining = i.Date_Joining;
                                    Not_obj.Date_terminated = i.Date_terminated;
                                    Not_obj.PayFreq = "W";
                                    Not_obj.BirthDate = i.BirthDate;
                                    Not_obj.emp_add_remove = i.emp_add_remove;
                                    Not_Selected_list.Add(Not_obj);
                                }
                            }
                        }

                    }
                    else
                    {
                        return BadRequest(new ResponseModel
                        {
                            Status = false,
                            Message = "Data not found for weekly levy deductions  details for this year",
                            Data = null,
                            Statuscode = 200
                        });
                    }

                    if (!request.IsSave && request.Is_Preview)
                    {
                        bool Isneedtosave = request.IsRecordEdit ? true : false;
                        var Result = _NonDirectorRepo.NWDIRECTORC3(obj_list, Not_Selected_list, request.Monthno, Convert.ToInt32(request.Year), request.H_Id, request.schedule_no, Isneedtosave, request.IsRecordEdit, request.Is_Preview, TextChanged, request.CompanyId, request.UserID, request.User_Name);
                        Result.MonthName = MonthName((request.Monthno).ToString());
                        Result.Year = request.Year;
                        Result.OrderKey = request.OrderKey;
                        Result.OrderName = request.OrderName;
                        Result.company_reg_no = CompanyDetails.company_reg_no;
                        Result.company_name = CompanyDetails.company_name;
                        Result.company_address = CompanyDetails.company_address;
                        Result.trade_name = CompanyDetails.trade_name;
                        Result.isNilReturn = request.isNilReturn;

                        if (request.footerCalcuations != null)
                        {
                            var Differences = new List<object>();
                            if (Convert.ToDecimal(Result?.TextTotalWages ?? "0") != Convert.ToDecimal(request.footerCalcuations?.totalWages ?? "0"))
                            {

                                Differences.Add(new { field = "Total Wages", fileCal = request.footerCalcuations.totalWages, actual = Result.TextTotalWages });

                            }
                            if (Convert.ToDecimal(Result.TextSSContribution ?? "0") != Convert.ToDecimal(request.footerCalcuations.totalSscontributions ?? "0"))
                            {

                                Differences.Add(new { field = "Social Security Contribution Due for the Month", fileCal = request.footerCalcuations.totalSscontributions, actual = Result.TextSSContribution });

                            }

                            var sumlevy = (Convert.ToDecimal(Result.TextEmployerLevy) + Convert.ToDecimal(Result.TextTotalWagesNLevy));

                            if (sumlevy != Convert.ToDecimal(request.footerCalcuations.sumLevyemployeeAndemployer ?? "0"))
                            {

                                Differences.Add(new { field = "Employee's Levy and Employer's 3% of Wages for Levy Contribution", fileCal = request.footerCalcuations.sumLevyemployeeAndemployer, actual = sumlevy.ToString() });

                            }
                            if (Convert.ToDecimal(Result.TextServayance ?? "0") != Convert.ToDecimal(request.footerCalcuations.totalServayance ?? "0"))
                            {

                                Differences.Add(new { field = "Employer's 1% of Wages for Severance Payment Contribution", fileCal = request.footerCalcuations.totalServayance, actual = Result.TextServayance });

                            }

                            return Ok(new
                            {
                                Status = true,
                                Message = "Result.",
                                Data = Result,
                                calculationsValidation = Differences,
                                Statuscode = 200
                            });
                        }

                        return Ok(new ResponseModel
                        {
                            Status = true,
                            Message = "Result.",
                            Data = Result,
                            Statuscode = 200
                        });
                    }
                    else
                    {
                        int result = _NonDirectorRepo.NwSaveC3Record(obj_list, Not_Selected_list, request.Monthno, Convert.ToInt32(request.Year), request.H_Id, request.schedule_no, request.IsSave, request.IsRecordEdit, Convert.ToInt32(request.Year), TextChanged, request.CompanyId, request.UserID, request.User_Name, request.OrderKey, request.OrderName, CompanyDetails.company_reg_no, request.isNilReturn);
                        if (result > 0)
                        {

                            if (request.Is_SendBima)
                            {
                                var response = await _NonDirectorRepo.SubmitDirectorC3_ClickBulk(result, request.CompanyId, request.UserID);
                                if (response.Status == true)
                                {
                                    return Ok(response);
                                }
                                return BadRequest(response);
                            }
                            else
                            {

                                if (!string.IsNullOrEmpty(request.c3FilePath))
                                {
                                    int hId = Convert.ToInt32(result);
                                    var header = _context.ProcessC3headers.FirstOrDefault(e => e.C3headerid == hId);

                                    header.isImportC3file = true;
                                    header.ImportC3Filepath = request.c3FilePath;
                                    _context.SaveChanges();
                                }

                                return Ok(new ResponseModel
                                {
                                    Status = true,
                                    Message = "C3 Wizard saved successfully",
                                    Data = result,
                                    Statuscode = 200
                                });
                            }
                        }
                    }
                    return NotFound(new ResponseModel
                    {
                        Status = false,
                        Message = "Data not found the this employee",
                        Data = null,

                    });
                }
                else
                {
                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                        Message = "Levy deductions details no data found for this year",
                        Data = null,
                        Statuscode = 200
                    });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel
                {
                    Status = false,
                    Message = ex.Message,
                    Data = null,
                    Statuscode = ex.GetHashCode()
                });
            }
        }

        [HttpPost]
        [Route("NWButton_Finalize_Click")]
        public async Task<IActionResult> NWButton_Finalize_Click(SaveNContinueRequest request)
        {
            try
            {
                string fyear = request.Year.ToString();
                //int fmonthno = request.Monthno;
                int fmonthno = _C3.MonthNumber(request.MonthName);
                request.Monthno = fmonthno;
                string fmonthval = fmonthno <= 9 ? "0" + fmonthno.ToString() : fmonthno.ToString();
                DateTime? newFrom_date = DateTime.ParseExact(("01/" + fmonthval + "/" + fyear), Helper.DateFormat, CultureInfo.InvariantCulture);
                int daysfMonth = DateTime.DaysInMonth(int.Parse(fyear), fmonthno);
                DateTime? newTo_date = newFrom_date.Value.AddDays(daysfMonth - 1);
                ViewModelMaster_Setting_Rates_Rates Master_Setting_Rates_Rates = _C3.Get_Master_Setting_Rates_Rates(newFrom_date, newTo_date);
                int C3H_Id = 0;
                if (C3WizardRepository.Repository.ConnectionInfom.HasConnection() && C3WizardRepository.Repository.ConnectionInfom.APIConnection(_configuration))
                {
                    //int savestatus = request.H_Id > 0 ? 1 : 0;
                    //if (request.Is_Preview)
                    //{
                    C3H_Id = await Task.Run(() => _NonDirectorRepo.NWSave_button_Click(request, Master_Setting_Rates_Rates));
                    request.H_Id = C3H_Id;
                    //}
                    if (C3H_Id != 0)
                    {
                        SqlConnection staticConnectioncheck = C3WizardLayerConn_BaseData.StaticSqlConnection;
                        staticConnectioncheck.Open();
                        SqlCommand cmdDelete = new SqlCommand("C3Header_Finalize", staticConnectioncheck);
                        cmdDelete.CommandType = CommandType.StoredProcedure;
                        cmdDelete.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)request.H_Id ?? (object)DBNull.Value));
                        SqlDataAdapter sqlAdapterdelete = new SqlDataAdapter(cmdDelete);
                        DataTable dtcheck = new DataTable();
                        sqlAdapterdelete.Fill(dtcheck);
                        DataTable dt = new DataTable();
                        sqlAdapterdelete.Fill(dt);
                        staticConnectioncheck.Close();
                        if (dt.Rows.Count > 0)
                        {
                            var response = await _NonDirectorRepo.SubmitDirectorC3_ClickBulk(request.H_Id, request.CompanyId, request.UserID);
                            return Ok(response);

                        }
                    }
                }

                C3H_Id = await Task.Run(() => _NonDirectorRepo.NWSave_button_Click(request, Master_Setting_Rates_Rates));
                if (C3H_Id != 0)
                {
                    return Ok(new ResponseModel
                    {
                        Status = true,
                        Message = "Director payroll Saved successfully",
                        Statuscode = 200,
                        Data = C3H_Id
                    });
                }

                return BadRequest(new ResponseModel
                {
                    Status = false,
                    Message = "Failed to save C3",
                    Statuscode = 400
                });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = "An error occurred while processing your request.",
                    Statuscode = 500
                });
            }

        }
        [HttpPost("NWSubmitC3Bulk")]
        public async Task<IActionResult> NWSubmitC3Bulk(int headerId, int CompanyId, int UserID)
        {
            ResponseModel response = new ResponseModel();
            try
            {
                var IsBEMA_APIs_Integration = _configuration["IsBEMA_APIs_Integration"];
                if (IsBEMA_APIs_Integration == "1")
                {
                    response = await _NonDirectorRepo.SubmitDirectorC3_ClickBulk(headerId, CompanyId, UserID);
                    if (response.Status == true)
                    {
                        return Ok(response);
                    }
                    return BadRequest(response);
                }
                else
                {

                    bool isc3submitted = _context.ProcessC3headers.Any(x => x.C3headerid == headerId && (bool)x.IsSubmitted == true);
                    if (!isc3submitted)
                    {
                        SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                        string updateHeaderQuery = $"UPDATE PROCESS_C3Header SET Is_submitted=1, C3_SubmittedDate='{DateTime.Now.ToString(Helper.SQLDateFormat)}', C3_SubmittedBy={UserID} WHERE C3HEADERID={headerId}";
                        SqlCommand updateC3Header = new SqlCommand(updateHeaderQuery, staticConnection);
                        if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                        int uprow = updateC3Header.ExecuteNonQuery();
                        staticConnection.Close();

                        string updateContributionQuery = $"UPDATE Process_Contributions SET Is_submitted=1, C3_SubmittedDate='{DateTime.Now.ToString(Helper.SQLDateFormat)}', C3_SubmittedBy={UserID} WHERE C3HEADERID={headerId}";
                        SqlCommand updateContributions = new SqlCommand(updateContributionQuery, staticConnection);
                        if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                        int urow2 = updateContributions.ExecuteNonQuery();
                        staticConnection.Close();
                        response.Status = true;
                        response.Statuscode = 200;
                        response.Message = "C3 submitted successfully.";
                        return Ok(response);
                    }
                    else
                    {
                        response.Status = false;
                        response.Statuscode = 400;
                        response.Message = "C3 already submitted in SSB.";
                        return BadRequest(response);
                    }
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel
                {
                    Status = false,  // Indicate success
                    Message = ex.Message,
                    Statuscode = 400
                });
            }
        }

        // ===================================nondirectorreport==============
        [HttpGet("btn_Search_Click")]
        public ResponseModel btn_Search_Click(int FromMonth, int ToMonth, string Year, int CompanyId)
        {
            //if (ValidateDetails())
            //{
            ResponseModel response = new ResponseModel();
            try
            {
                //if (CmbFromMonth.SelectedIndex != -1 && CmbToMonth.SelectedIndex != -1 && CmbYear.SelectedIndex != -1)
                //{
                int F_month = FromMonth;
                int T_month = ToMonth;
                //int S_year = int.Parse(CmbYear.Text);
                //ComboBoxItem year = (ComboBoxItem)CmbYear.SelectedItem;
                string value = Year != null ? Year : null;
                string S_year = Year != "" ? value : null;

                List<C3Header> listDVOC3Header = new List<C3Header>();
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                SqlCommand cmd = new SqlCommand("Get_Director_C3_Genrated_data", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                DataTable dt = new DataTable();
                sqlAdapter.Fill(dt);
                if (dt.Rows.Count > 0)
                {
                    foreach (DataRow row in dt.Rows)
                    {
                        bool issubmited = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                        bool isfinalize = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                        int C3month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? -1 : int.Parse(row["PERIODD_MONTH"].ToString());
                        int C3year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? -1 : int.Parse(row["PERIOD_YEAR"].ToString());
                        if ((issubmited == true || isfinalize == true))
                        {
                            C3Header Obj = new C3Header();
                            Obj.HeaderID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                            Obj.RegNo = Convert.IsDBNull(row["RegNo"]) ? null : row["RegNo"].ToString();
                            Obj.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : MonthName(row["PERIODD_MONTH"].ToString());
                            Obj.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString();
                            Obj.p_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? -1 : int.Parse(row["PERIODD_MONTH"].ToString());
                            Obj.P_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? -1 : int.Parse(row["PERIOD_YEAR"].ToString());
                            Obj.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
                            Obj.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_SSCONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString())));
                            Obj.TOTALLEVYEEEMPLOYEE = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString())));
                            Obj.TOTALSERVAYANCE = Convert.IsDBNull(row["TOTAL_SERVAYANCE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SERVAYANCE"].ToString())));
                            Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString(Helper.DisplayDateFormat);
                            //Obj.Insert_Datetime = Convert.IsDBNull(row["Insert_Datetime"]) ? DateTime.Parse("01/01/1900") : DateTime.Parse(row["Insert_Datetime"].ToString());
                            Obj.Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                            Obj.Is_submitted = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                            Obj.C3_IsFinalized = !Obj.C3_IsFinalized;
                            Obj.IssubmittedShow = (bool)Obj.Is_submitted ? "C3 Submitted" : "C3 not Submitted";
                            Obj.Issubmittedcolor = (bool)Obj.Is_submitted ? "Black" : "Red";
                            Obj.IssubmittedShowimg = (bool)Obj.Is_submitted ? "/img/RightSine.png" : "/img/close.png";
                            Obj.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                            listDVOC3Header.Add(Obj);
                        }
                    }
                    listDVOC3Header = S_year != null ? listDVOC3Header.Where(x => x.Period_year == S_year).ToList() : listDVOC3Header;
                    listDVOC3Header = F_month != -1 ? listDVOC3Header.Where(x => x.p_Month >= F_month).OrderBy(x => x.p_Month).ToList() : listDVOC3Header;
                    listDVOC3Header = T_month != -1 ? listDVOC3Header.Where(x => x.p_Month <= T_month).OrderBy(x => x.p_Month).ToList() : listDVOC3Header;

                    if (listDVOC3Header.Count > 0)
                    {
                        var c3HeaderList = listDVOC3Header.Select(row => new C3HeaderViewModel
                        {
                            HeaderID = row.HeaderID,
                            RegNo = row.RegNo,
                            PeriodMonth = row.period_Month,
                            PeriodYear = row.Period_year,
                            PMonth = row.p_Month,
                            PYear = row.P_year,
                            TotalWages = row.TOTAL_WAGES,
                            TotalSSContributions = row.TOTALSSCONTRIBUTIONS,
                            TotalLevyEmployee = row.TOTALLEVYEEEMPLOYEE,
                            TotalServayance = row.TOTALSERVAYANCE,
                            InsertDatetimeInfo = row.Insert_Datetimeinfo,
                            IsFinalized = row.Is_Fianalize,
                            IsSubmitted = row.Is_submitted,
                            C3IsFinalized = row.C3_IsFinalized,
                            IssubmittedShow = row.IssubmittedShow,
                            IssubmittedColor = row.Issubmittedcolor,
                            IssubmittedShowImg = row.IssubmittedShowimg,
                            ScheduleNo = row.Schedule_NO
                        }).ToList();

                        response.Data = c3HeaderList;
                        response.Status = true;
                        response.Statuscode = 200;
                        response.Message = "Data Get Successfully!";

                    }
                    else
                    {
                        response.Data = null;
                        response.Status = false;
                        response.Statuscode = 404;
                        response.Message = "Data Not Found!";

                    }

                }
                else
                {
                    response.Data = null;
                    response.Status = false;
                    response.Statuscode = 404;
                    response.Message = "Data Not Found!";
                }
                //}
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                response.Status = false;
                response.Statuscode = 500;
                response.Message = ex.Message;
            }

            return response;
            //}
        }

        private string MonthName1(string m_no)
        {
            string Month = "";
            switch (m_no)
            {
                case "1": Month = "January"; break;
                case "2": Month = "February"; break;
                case "3": Month = "March"; break;
                case "4": Month = "April"; break;
                case "5": Month = "May"; break;
                case "6": Month = "June"; break;
                case "7": Month = "July"; break;
                case "8": Month = "August"; break;
                case "9": Month = "September"; break;
                case "10": Month = "October"; break;
                case "11": Month = "November"; break;
                case "12": Month = "December"; break;
                default: Month = string.Empty; break;
            }
            return Month;
        }
        [HttpGet]
        [Route("NwCheckC3Created")]
        public async Task<IActionResult> NwCheckC3Created(int Year, int Month, int CompanyId)
        {
            try
            {
                using (SqlConnection staticConnectionsave = C3WizardLayerConn_BaseData.StaticSqlConnection)
                using (SqlCommand cmdsave = new SqlCommand("check_Director_C3Created", staticConnectionsave))
                {
                    cmdsave.CommandType = CommandType.StoredProcedure;
                    cmdsave.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50) { Value = (object)Month ?? DBNull.Value });
                    cmdsave.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50) { Value = (object)Year ?? DBNull.Value });
                    cmdsave.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50) { Value = (object)CompanyId ?? DBNull.Value });

                    using (SqlDataAdapter sqlAdaptersave = new SqlDataAdapter(cmdsave))
                    {
                        DataTable dtsave = new DataTable();
                        sqlAdaptersave.Fill(dtsave);

                        if (dtsave.Rows.Count > 0)
                        {
                            int c3Hid = (int)dtsave.Rows[0]["C3HEADERID"];

                            return Ok(new ResponseModel
                            {
                                Status = true,
                                Data = c3Hid,
                                Message = $"A C3 for the month {MonthName1(Month.ToString())} {Year} has already been created. Overwriting it will replace the existing C3. Would you like to proceed?",
                                Statuscode = 200
                            });
                        }
                        else
                        {
                            return Ok(new ResponseModel
                            {
                                Status = false,
                                Message = "No C3 record found for the given month and year.",
                                Statuscode = 200
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return BadRequest(new ResponseModel
                {
                    Status = false,
                    Message = ex.Message,
                    Statuscode = 400
                });
            }
        }





        [HttpPost("UploadC3FileDir")]
        public async Task<IActionResult> FileUploadC3([FromForm] C3FileDataUpload obj)
        {
            try
            {


                if (obj.file == null || obj.file.Length == 0)
                    return BadRequest("No file uploaded");

                var extension = Path.GetExtension(obj.file.FileName);
                if (!string.Equals(extension, ".c3", StringComparison.OrdinalIgnoreCase))
                    return BadRequest("Only .c3 files are allowed.");

                string reportPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "ImportC3File", obj.file.FileName);

                using (var stream = new FileStream(reportPath, FileMode.Create))
                    await obj.file.CopyToAsync(stream);


                var lines = System.IO.File.ReadAllLines(reportPath);
                var c3Data = new C3FileData();

                int lineNumber = 0;


                foreach (var line in lines)
                {
                    lineNumber++;

                    if (string.IsNullOrWhiteSpace(line))
                        return BadRequest(new { status = true, msg = $"Line {lineNumber} is blank." });

                    var parts = line.Split(',').Select(p => p.Trim()).ToArray();

                    if (parts[0] == "HDR")
                    {
                        if (parts.Length < 5)
                            return BadRequest(new { status = true, msg = $"HDR line missing required fields at Line {lineNumber}" });

                        if (parts[1].Length != 6)
                            return BadRequest(new { status = true, msg = $"HDR line missing RegNumber length {lineNumber}" });

                        string regNo = parts[1];
                        string periodDate = parts[2];
                        string version = parts[3];
                        string companyName = parts[4];

                        // Validate Company RegNo
                        var companydata = _context.MasterCompanies.FirstOrDefault(e => e.CompanyId == obj.companyId);
                        if (companydata == null)
                            return BadRequest(new { status = true, msg = "Company not found in database." });

                        if (companydata.RegNumber != regNo)
                        {
                            return BadRequest(new
                            {
                                status = false,
                                msg = $"Registration Number mismatch at Line {lineNumber}"
                            });
                        }

                        // Validate company name
                        string dbCompany = companydata.CompanyName?.ToLower().Trim().Replace("\u00A0", "").Replace("\u200B", "").Replace(" ", "");
                        string fileCompany = companyName.ToLower().Trim().Replace("\u00A0", "").Replace("\u200B", "").Replace(" ", "");
                        if (dbCompany != fileCompany)
                        {
                            return BadRequest(new
                            {
                                status = false,
                                msg = $"Company name mismatch in HDR at Line {lineNumber}"
                            });
                        }

                        // Validate date
                        DateTime formattedDate;
                        if (!DateTime.TryParseExact(periodDate, new[] { "d/M/yyyy", "dd/MM/yyyy" }, CultureInfo.InvariantCulture,
                            DateTimeStyles.None, out formattedDate))
                        {
                            return BadRequest(new { status = true, msg = $"Invalid date format in HDR at Line {lineNumber}. Required format: dd/MM/yyyy" });
                        }

                        c3Data.Header = new ProcessC3header
                        {
                            RegNo = regNo,
                            PerioddMonth = formattedDate.Month.ToString(),
                            PeriodYear = formattedDate.Year.ToString(),
                            // VERSION = version,
                            // COMPANY = companyName
                        };
                    }
                    else if (parts[0] == "FTR")
                    {

                        if (parts.Length < 8)
                            return BadRequest(new { status = true, msg = $"FTR missing required fields at Line {lineNumber}" });

                        if (parts[1].Length != 6)
                            return BadRequest(new { status = true, msg = $"HDR line missing RegNumber length {lineNumber}" });

                        // Field-3 → Date must be dd/MM/yyyy
                        DateTime ftrDate;
                        if (!DateTime.TryParseExact(parts[2], new[] { "d/M/yyyy", "dd/MM/yyyy" }, CultureInfo.InvariantCulture,
                            DateTimeStyles.None, out ftrDate)
                            && !DateTime.TryParseExact(parts[2], "dd/MM/yyyy", CultureInfo.InvariantCulture,
                            DateTimeStyles.None, out ftrDate))
                        {
                            return BadRequest(new { status = true, msg = $"Invalid date format in FTR at Line {lineNumber}. Required format dd/MM/yyyy" });
                        }

                        for (int i = 3; i <= 7; i++)
                        {
                            if (string.IsNullOrWhiteSpace(parts[i]))
                                return BadRequest(new { status = true, msg = $"FTR column {i + 1} cannot be empty at Line {lineNumber}" });

                            decimal value;
                            if (!decimal.TryParse(parts[i], out value))
                                return BadRequest(new { status = true, msg = $"Invalid numeric value in FTR column {i + 1} at Line {lineNumber}" });
                        }

                    }
                    else
                    {
                        if (parts.Length < 24)
                            return BadRequest(new { status = true, msg = $"FTR missing required fields at Line {lineNumber}" });


                        for (int i = 7; i < parts.Length; i++)
                        {
                            if (i <= 12)
                            {
                                if (string.IsNullOrWhiteSpace(parts[i]))
                                    return BadRequest(new { status = true, msg = $"Missing integer value in Column {i + 1} at Line {lineNumber}" });

                                int temp;
                                if (!int.TryParse(parts[i], out temp))
                                    return BadRequest(new { status = true, msg = $"Invalid integer value in Column {i + 1} at Line {lineNumber}" });
                            }
                            else
                            {



                                if (string.IsNullOrWhiteSpace(parts[i]))
                                    return BadRequest(new { status = true, msg = $"Missing decimal value in Column {i + 1} at Line {lineNumber}" });

                                decimal value;
                                if (!decimal.TryParse(parts[i], out value))
                                    return BadRequest(new { status = true, msg = $"Invalid decimal value in Column {i + 1} at Line {lineNumber}" });
                            }
                        }
                    }
                }




                var parsedData = await _NonDirectorRepo.ParseC3File(reportPath, obj.companyId, obj.userId);
                if (parsedData.Status == true)
                {

                    return Ok(new { status = true, message = "C3 file processed successfully", data = parsedData.Data });
                    
                }
                else
                {

                    return BadRequest(new { status = false, message = parsedData.Message, data = parsedData.Data });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new { Status = false, Message = "Something Went Wrong..!", Data = ex });
            }


        }

        [HttpPost("validateC3FileEmpDir")]
        public async Task<IActionResult> validateC3FileEmp(List<C3Contributions> data, int userid, int companyId)
        {
            try
            {
                var AllpayPeriod = JsonConvert.DeserializeObject<List<PayPeriods>>("[{ \"Key\":\"W - Weekly\",\"Value\":\"W\"}, { \"Key\":\"M - Monthly\",\"Value\":\"M\"}, { \"Key\":\"E2W - Every Two Weeks\",\"Value\":\"E2W\"}, { \"Key\":\"2M - Twice Monthly\",\"Value\":\"2M\"}]");

                var userpass = _context.Secusers.FirstOrDefault(e => e.UserId == userid);

                var chklocalemp = data.Where(e => !_context.MasterEmployees.Any(m => m.SocSecNum == e.SSND && m.IsdirectorOnly == true && m.CompanyId == companyId)).ToList();
                //await _C3.empAddthroughFile(chklocalemp, userid, companyId, userpass);
                var chklocalempAfterApicall = _context.MasterEmployees.Where(e => e.CompanyId == companyId && e.IsdirectorOnly == true && data.Select(m => m.SSND).ToList().Contains(e.SocSecNum)).ToList();
                var validationList = new List<EmployeeValidationError>();
                foreach (var item in data)
                {
                    string[] formats = { "dd/M/yyyy", "dd/MM/yyyy" };
                    int daysin_month = DateTime.DaysInMonth(int.Parse(item.Period_year), int.Parse(item.period_Month));
                    DateTime? Todaydate = DateTime.ParseExact(("01/" + item.period_Month + "/" + item.Period_year), formats, CultureInfo.InvariantCulture);
                    DateTime? end_date = Todaydate != null ? (DateTime?)((DateTime)Todaydate).AddDays(daysin_month - 1) : null;

                    var errors = new List<string>();
                    var fillmissingdata = chklocalempAfterApicall.FirstOrDefault(e => e.SocSecNum == item.SSND);
                    if (fillmissingdata != null)
                    {
                        if (string.IsNullOrEmpty(fillmissingdata.PayPeriod))
                        {
                            //var payperiod = item.PayFreq == "1" ? "W" : item.PayFreq == "2" ? "E2W" : item.PayFreq == "3" ? "M" : item.PayFreq == "4" ? "2M" : "";
                            //item.PayFreq = AllpayPeriod.FirstOrDefault(x => x.Value == payperiod)?.Value;
                            //item.PayPeriod = AllpayPeriod.FirstOrDefault(x => x.Value == payperiod)?.Key;
                            fillmissingdata.PayPeriod = item.PayFreq;
                            _context.SaveChanges();
                        }

                        item.BirthDate = fillmissingdata.BirthDate?.ToString("yyyy-MM-dd");
                        item.EmployeeId = fillmissingdata.EmployeeId;
                        //item.PayFreq = fillmissingdata.PayPeriod;
                        //item.PayPeriod = AllpayPeriod.FirstOrDefault(x => x.Value == fillmissingdata.PayPeriod)?.Key;
                        item.EmpSalary = _context.MasterEmployeeIncomes.FirstOrDefault(e => e.EmployeeId == fillmissingdata.EmployeeId).IncRate;
                        item.SSN = fillmissingdata.EmployeeId.ToString();
                        var parts = (item.EmployeeName ?? "").TrimStart().TrimEnd().Split(' ', 2);
                        // 1. FIRST NAME
                        if (!string.Equals(parts[0]?.ToLower()?.Trim(), fillmissingdata.FirstName?.Trim(), StringComparison.OrdinalIgnoreCase))
                        {
                            errors.Add($"First Name mismatch: C3file='{parts[0]?.ToLower()?.Trim()}' localSystem='{fillmissingdata.FirstName}'");
                        }

                        if (!string.Equals(parts[1]?.ToLower()?.Trim(), fillmissingdata.LastName?.Trim(), StringComparison.OrdinalIgnoreCase))
                        {
                            errors.Add($"Last Name mismatch: file='{parts[1]?.ToLower()?.Trim()}' localSystem='{fillmissingdata.LastName}'");
                        }
                        if (!string.IsNullOrEmpty(item.Date_Joining) && (item.Date_Joining == null || Convert.ToDateTime(item.Date_Joining) >= end_date))
                        {
                            errors.Add($"date Joining is Greater than c3 Geneate date");
                        }
                        if (!string.IsNullOrEmpty(item.Date_terminated) && (item.Date_terminated == null || Convert.ToDateTime(item.Date_terminated) <= Todaydate))
                        {
                            errors.Add($"date terminated is smaller than c3 Geneate date");
                        }

                        if (!string.Equals(item.PayFreq?.Trim(), fillmissingdata.PayPeriod?.Trim(), StringComparison.OrdinalIgnoreCase))
                        {
                            errors.Add($"PayPeriod mismatch: file='{item.PayFreq}' localSystem='{fillmissingdata.PayPeriod}'");
                        }
                        if (string.IsNullOrEmpty(item.PayPeriod?.Trim()))
                        {
                            errors.Add($"PayPeriod mismatch: file='{item.PayFreq}' localSystem='{AllpayPeriod.FirstOrDefault(x => x.Value == fillmissingdata.PayPeriod)?.Key}'");
                        }
                        if (errors.Any())
                        {
                            validationList.Add(new EmployeeValidationError
                            {
                                SSN = item.SSND,
                                Errors = errors
                            });
                            item.ValidateMsg = string.Join(" , ", validationList.SelectMany(x => x.Errors));
                            return BadRequest(new { status = false, message = "validate Failed", data = new { data, validationList } });
                        }

                        return Ok(new { status = true, message = "validate success", data = data });
                    }
                    else
                    {
                        item.ValidateMsg = "Invalid employee name or SSN";
                        return BadRequest(new { status = false, message = "Invalid employee name or SSN", data = data });
                    }
                }

                return BadRequest(new { status = false, message = "data not found", data = "" });
            }
            catch (Exception ex)
            {

                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new { Status = false, Message = "Something Went Wrong..!", Data = ex });
            }
        }
    }
}
