        public void saveSelfEmployedWages(int SEid, decimal wi, decimal wc, string cat, int CategoryID)
        {
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            SqlCommand cmddates = new SqlCommand("Self_Employed_Settings_Wages_Insert", staticConnection);
            cmddates.CommandType = CommandType.StoredProcedure;
            cmddates.Parameters.Add(new SqlParameter("@SESId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)SEid ?? (object)DBNull.Value));
            cmddates.Parameters.Add(new SqlParameter("@WeeklyIncome", SqlDbType.Decimal, 9, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(Math.Round((wi), 2)) ?? (object)DBNull.Value));
            cmddates.Parameters.Add(new SqlParameter("@WeeklyContribution", SqlDbType.Decimal, 9, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(Math.Round((wc), 2)) ?? (object)DBNull.Value));
            cmddates.Parameters.Add(new SqlParameter("@Category", SqlDbType.NVarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)cat ?? (object)DBNull.Value));
            cmddates.Parameters.Add(new SqlParameter("@catId", SqlDbType.NVarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CategoryID ?? (object)DBNull.Value));

            SqlDataAdapter sqlAdapterDates = new SqlDataAdapter(cmddates);
            DataTable dtdates = new DataTable();
            sqlAdapterDates.Fill(dtdates);
        }


