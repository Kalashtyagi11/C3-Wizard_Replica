        public bool isC3Finilize(DateTime? sdate, DateTime? edate)
        {
            string CreatedC3For = null;
            bool ret_uren = true;
            int Start_y, end_y, start_m, end_m;
            //string DateFormat = "dd-MM-yyyy HH:mm:ss";
            try
            {
                Start_y = DateTime.ParseExact(((DateTime)sdate).ToString(Helper.DisplayDateFormat), Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Year;
                end_y = edate == null ? 0 : DateTime.ParseExact(((DateTime)edate).ToString(Helper.DisplayDateFormat), Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Year;
                start_m = DateTime.ParseExact(((DateTime)sdate).ToString(Helper.DisplayDateFormat), Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Month;
                end_m = edate == null ? 0 : DateTime.ParseExact(((DateTime)edate).ToString(Helper.DisplayDateFormat), Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Month;
                //Start_y = DateTime.ParseExact(sdate, "dd-MM-yyyy HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture).Year;
                //Start_y = DateTime.ParseExact(edate, "dd-MM-yyyy HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture).Year;
                //start_m = DateTime.ParseExact(edate, Helper.SQLDateFormat, System.Globalization.CultureInfo.InvariantCulture).Month;
                //end_m = DateTime.ParseExact(edate, Helper.SQLDateFormat, System.Globalization.CultureInfo.InvariantCulture).Month;

                // end_m = string.IsNullOrEmpty(edate) ? 0 : DateTime.ParseExact(edate, dateFormat, System.Globalization.CultureInfo.InvariantCulture).Month;

                List<C3Header> listDVOC3Header = new List<C3Header>();
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                SqlCommand cmd = new SqlCommand("get_SelfGenrated_dataSettings", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                DataTable dt = new DataTable();
                sqlAdapter.Fill(dt);
                if (dt.Rows.Count > 0)
                {
                    foreach (DataRow row in dt.Rows)
                    {
                        C3Header Obj = new C3Header();
                        Obj.HeaderID = Convert.IsDBNull(row["SEC3ID"]) ? 0 : int.Parse(row["SEC3ID"].ToString());
                        Obj.p_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? -1 : int.Parse(row["PERIODD_MONTH"].ToString()) + 1;
                        Obj.P_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? -1 : int.Parse(row["PERIOD_YEAR"].ToString());
                        Obj.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                        listDVOC3Header.Add(Obj);
                    }
                    bool exists = listDVOC3Header.Any(x => x.P_year >= Start_y && x.p_Month >= start_m);
                    if (exists)
                    {
                        ret_uren = false;
                        //C3WizardMessageBox.Show("C3 Wizard", "Self Employed Settings already used \n You can not delete this self employed settings");  DOUBT SECTION THIS LINES
                    }
                }
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                throw ex;

            }
            return ret_uren;
        }

        public string MonthName(string m_no)
        {
            string Month = "";
            switch (m_no)
            {
                //case "1" or "0":
                //    Month = "January";
                //    break;
                case "1":
                    Month = "January";
                    break;
                case "2":
                    Month = "February";
                    break;
                case "3":
                    Month = "March";
                    break;
                case "4":
                    Month = "April";
                    break;
                case "5":
                    Month = "May";
                    break;
                case "6":
                    Month = "June";
                    break;
                case "7":
                    Month = "July";
                    break;
                case "8":
                    Month = "August";
                    break;
                case "9":
                    Month = "September";
                    break;
                case "10":
                    Month = "October";
                    break;
                case "11":
                    Month = "November";
                    break;
                case "12":
                    Month = "December";
                    break;
                default:
                    Month = string.Empty;
                    break;
            }


            return Month;
        }

