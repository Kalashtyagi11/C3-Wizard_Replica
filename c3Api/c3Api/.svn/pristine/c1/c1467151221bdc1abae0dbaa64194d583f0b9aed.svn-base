            //}

            isC3recordEdit = result.IsRecordEdit;
            string value = year.ToString();
            C3Header obj = new C3Header();
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            SqlCommand cmd = C3H_Id > 0 ? new SqlCommand("C3Header_Update", staticConnection) : new SqlCommand("Director_C3Header_Insert_One", staticConnection);
            cmd.CommandType = CommandType.StoredProcedure;
            if (C3H_Id > 0)
            {
                cmd.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)C3H_Id ?? (object)DBNull.Value));
            }
            cmd.Parameters.Add(new SqlParameter("@RegNo", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(string)result.company_reg_no ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@PERIODD_MONTH", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)result.Monthno.ToString() ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@PERIOD_YEAR", SqlDbType.VarChar, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)value ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@TOTAL_WAGES", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(Twadges + Bonus) ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@TOTAL_SSCONTRIBUTIONS", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(decimal.Parse("0.00")) ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@TOTAL_LEVYEEEMPLOYEE", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)TLevy ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@TOTAL_LEVYEEEMPLOYER", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(decimal.Parse("0.00")) ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@TOTAL_SERVAYANCE", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(decimal.Parse("0.00")) ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@TOTAL_LEVYEEPENALTY", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)TLevyP ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@TOTAL_PEPENALTY", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(decimal.Parse("0.00")) ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@TOTAL_SSPENALTY", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(decimal.Parse("0.00")) ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@EmployerID", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(int)result.CompanyId ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Insert_Datetimeinfo", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Schedule_NO", SqlDbType.Int, 10, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)result.schedule_no ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Is_Fianalize", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)false ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Is_submitted", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)false ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Inserted_By", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(int)result.UserID ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Modified_By", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(int)result.UserID ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Print_By", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(int)result.UserID ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Export_By", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(int)result.UserID ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Modified_On", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Export_On", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Modified_Machineinfo", SqlDbType.NVarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(string)Helper.MachineInfo ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@UserName", SqlDbType.NVarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(string)result.User_Name ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@IsImportFromBEMA", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)false ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@OrderName", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)result.OrderName ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@OrderKey", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)result.OrderKey ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@IsNilReturn", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)result.isNilReturn ?? (object)DBNull.Value));

            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
            DataTable dt = new DataTable();
            sqlAdapter.Fill(dt);

            if (dt.Rows.Count > 0)
            {
                int C3HEADERID = (int)dt.Rows[0].ItemArray[0];
                C3H_Id = C3HEADERID;
                foreach (var emp in result.AllEmployeeList_List)
                {
                    decimal? levy_er = 0;

                    decimal? servayance_er = 0;
                    SqlCommand cmdemp = new SqlCommand("Process_Contributions_Insert_One", staticConnection);
                    cmdemp.CommandType = CommandType.StoredProcedure;
                    cmdemp.Parameters.Add(new SqlParameter("@C3HEADERID", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)C3H_Id ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@SSN", SqlDbType.VarChar, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.SSN ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@PERIODD_MONTH", SqlDbType.VarChar, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)result.Monthno.ToString() ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@PERIOD_YEAR", SqlDbType.VarChar, 9, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)value ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@PayFreq", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.PayFreq ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WAGES1", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WAGES1 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WAGES2", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WAGES2 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WAGES3", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WAGES3 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WAGES4", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WAGES4 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WAGES5", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WAGES5 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@HPay", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.HPAY ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@BONUS", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.BONUS ?? (object)DBNull.Value));
