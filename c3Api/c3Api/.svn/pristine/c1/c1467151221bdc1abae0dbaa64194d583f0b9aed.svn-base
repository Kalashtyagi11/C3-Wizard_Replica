                                    obj.ISSelectedWEEK2 = obj.WEEK2 == true ? "\u221A" : "X";
                                    obj.ISSelectedWEEK3 = obj.WEEK3 == true ? "\u221A" : "X";
                                    obj.ISSelectedWEEK4 = obj.WEEK4 == true ? "\u221A" : "X";
                                    obj.ISSelectedWEEK5 = obj.WEEK5 == true ? "\u221A" : "X";
                                    obj.TotalWadeges = obj.WAGES1 + obj.WAGES2 + obj.WAGES3 + obj.WAGES4 + obj.WAGES5;
                                    amount = obj.WAGES1 + obj.WAGES2 + obj.WAGES3 + obj.WAGES4 + obj.WAGES5;

                                    decimal? Total_weekly = obj.WAGES1 + obj.WAGES2 + obj.WAGES3 + obj.WAGES4 + obj.WAGES5;
                                    decimal? w1_amt = obj.WAGES1, w2_amt = obj.WAGES2, w3_amt = obj.WAGES3, w4_amt = obj.WAGES4, w5_amt = obj.WAGES5;

                                    var W1_TMDTDL = Twoice_In_MonthDeductionsTaxDetailslist.Where(x => x.OverAmt < w1_amt).ToList();
                                    decimal? W1_LEVYEE = Levy_amount(W1_TMDTDL, w1_amt);
                                    var W2_TMDTDL = Twoice_In_MonthDeductionsTaxDetailslist.Where(x => x.OverAmt < w2_amt).ToList();
                                    decimal? W2_LEVYEE = Levy_amount(W2_TMDTDL, w2_amt);
                                    var W3_TMDTDL = Twoice_In_MonthDeductionsTaxDetailslist.Where(x => x.OverAmt < w3_amt).ToList();
                                    decimal? W3_LEVYEE = Levy_amount(W3_TMDTDL, w3_amt);
                                    var W4_TMDTDL = Twoice_In_MonthDeductionsTaxDetailslist.Where(x => x.OverAmt < w4_amt).ToList();
                                    decimal? W4_LEVYEE = Levy_amount(W4_TMDTDL, w4_amt);
                                    var W5_TMDTDL = Twoice_In_MonthDeductionsTaxDetailslist.Where(x => x.OverAmt < w5_amt).ToList();
                                    decimal? W5_LEVYEE = Levy_amount(W5_TMDTDL, w5_amt);

                                    decimal? amount_TMDTDL = obj.WAGES1 + obj.WAGES2 + obj.WAGES3 + obj.WAGES4 + obj.WAGES5;
                                    var Total_TMDTDL = Twoice_In_MonthDeductionsTaxDetailslist.Where(x => x.OverAmt < amount).ToList();
                                    decimal? totalmonthwageslevy = Levy_amount(Total_TMDTDL, amount_TMDTDL);
                                    decimal? totallevy = W1_LEVYEE + W2_LEVYEE + W3_LEVYEE + W4_LEVYEE + W5_LEVYEE;

                                    obj.LEVYEE = (amount_TMDTDL >= 6500 ? totalmonthwageslevy : totallevy) + (obj.BONUS > 1500 ? ((obj.BONUS * 8) / 100) : 0);
                                    amount = obj.WAGES1 + obj.WAGES2 + obj.WAGES3 + obj.WAGES4 + obj.WAGES5;

                                    bool Is_Emp_D = AllEmployeeList_List[i].IsemployeeDirector;


                                    decimal? Total_w_amt = obj.WAGES1 + +obj.WAGES2 + obj.WAGES3 + obj.WAGES4 + obj.WAGES5;
                                    decimal? weeekly_amount = IsWeekfifth ? Total_w_amt / 5 : Total_w_amt / 4;


                                    obj.Levy_Penalty = Latemonths >= 2 ? ((obj.LEVYEE) * (8 + Latemonths)) / 100 : 0;
                                    obj.Remarks = AllEmployeeList_List[i].Remarks.ToString();
                                    obj.IsemployeeDirector = false;
                                    obj.BirthDate = AllEmployeeList_List[i].BirthDate;
                                    obj.emp_add_remove = AllEmployeeList_List[i].emp_add_remove;
                                    obj_list.Add(obj);
                                }
                                else if ((!ear || !w) && PayFreq == "2M")
                                {
                                    C3Contributions Not_obj = new C3Contributions();
                                    Not_obj.SSN = AllEmployeeList_List[i].SSN.ToString();
                                    Not_obj.SSND = AllEmployeeList_List[i].SSND.ToString();
