            //          string ssnid = Convert.IsDBNull(row[0]) ? null : row[0].ToString();
            //          string name = Convert.IsDBNull(row[1]) ? null : row[1].ToString();
            //          string ssn = Convert.IsDBNull(row[2]) ? null : row[2].ToString();
            //          bool ssnexists = SSnList.Any(x => x.SSN == ssnid);
            //          if (ssnexists)
            //          {
