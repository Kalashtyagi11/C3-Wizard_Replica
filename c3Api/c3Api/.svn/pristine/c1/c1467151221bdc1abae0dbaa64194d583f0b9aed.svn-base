        public int SaveC3Record(List<C3Contributions> obj_list, List<C3Contributions> Not_Selected_list, int month, int year, int H_Id, int schedule_no, bool issave, bool isrecordEdit, int CompanyId, bool directorExistContinue, int UserID, string MachineInfo, string User_Name)
