        public async Task<List<nonWorkingDirectorWagesstring>> nwdssnlist(string payerId, string month, string year, int sequenceNo, string ParentUserLoginID, string ParentUser_Password)
        {
            List<nonWorkingDirectorWagesstring> ssnlist = new List<nonWorkingDirectorWagesstring>();
            if (C3WizardRepository.Repository.ConnectionInfom.APIConnection(_configuration) || C3WizardRepository.Repository.ConnectionInfom.HasConnection())
            {
                try
                {
                    SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                    String Emp_surl = _configuration["ServiceConfig:ServiceUriString"];
                    string Emp_sURL = Emp_surl + "/C3/" + payerId + "/C3Submitted/" + month + "," + year + "," + sequenceNo + ",ER,NW";
                    HttpMessageHandler handler = new HttpClientHandler()
                    {
                    };

                    var httpClient = new HttpClient(handler)
                    {
                        BaseAddress = new Uri(Emp_sURL),
                        Timeout = new TimeSpan(0, 2, 0)
                    };
                    httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                    //This is the key section you were missing    
                     var plainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : System.Text.Encoding.UTF8.GetBytes(ParentUserLoginID + ":" + ParentUser_Password);
                   
                    string val = System.Convert.ToBase64String(plainTextBytes);
                    httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + val);
                    HttpResponseMessage response = httpClient.GetAsync(Emp_sURL).Result;
                    if (response.StatusCode == HttpStatusCode.OK)
                    {
                        var customerJsonString = await response.Content.ReadAsStringAsync();
                        var Emp_model = JsonConvert.DeserializeObject<GetEmployerDeailsModule>(customerJsonString);
                    }
                    else
                    {
                        var customerJsonString = await response.Content.ReadAsStringAsync();
                        var submitC3_model = JsonConvert.DeserializeObject<submitC3string>(customerJsonString);
                        if (submitC3_model != null)
                        {
                            submitC3string subc3 = new submitC3string();
                            subc3.c3Header = submitC3_model.c3Header;
                            if (subc3.c3Header != null)
                            {
                                subc3.nonWorkingDirectorWages = submitC3_model.nonWorkingDirectorWages;
                                if (subc3.nonWorkingDirectorWages != null)
                                {
                                    ssnlist = subc3.nonWorkingDirectorWages;
                                }
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    string controller = "UnknownController";
                    string action = "UnknownAction";
                    var context = ExceptionMiddleware1.GetActionInfo();
                    controller = context.Controller;
                    action = context.Action;
                    LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                    return ssnlist;
                }

            }
            return ssnlist;
        }

        public UserVM GetUserDetails(int companyId, int userId)
        {
            UserVM user = new UserVM();
            string connectionString = C3WizardLayerConn_BaseData.StaticConnectionString; // Ensure you use a proper connection string

            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                string query = @"SELECT U.FirstName, U.LastName, U.EmailId,U.Password, U.parentuserid ,U.LoginId
                         FROM SECUsers U 
                         WHERE U.IsActive = 1 AND U.UserId = @UserId";

                using (SqlCommand command = new SqlCommand(query, connection))
                {
                    command.Parameters.AddWithValue("@UserId", userId);

                    connection.Open();
                    using (SqlDataReader dr = command.ExecuteReader())
                    {
                        if (dr.Read())
                        {
                            string firstName = dr["FirstName"].ToString();
                            string lastName = dr["LastName"].ToString();
                            user.LoginUserEmail = dr["EmailId"].ToString();
                            user.LoginUserName = $"{firstName} {lastName}";
                            user.User_Name = $"{firstName} {lastName}";
                            user.ParentUser_Password = dr["Password"].ToString();
                            //user.ParentUserLoginID = dr["parentuserid"].ToString();
                            user.ParentUserLoginID = dr["LoginId"].ToString();
                        }
                    }
                }
            }
            return user;
        }
        private string regno(int CompanyId)
        {
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            SqlCommand CurrentCompany = new SqlCommand("SELECT mc.Company_Id, mc.REG_NUMBER, mc.Address1, mc.Address2, mc.City, mc.State, mc.ZIP, mc.CompanyLogo, mc.IsLevyExempt, C.Name FROM MasterCompany mc, Country c WHERE mc.Isactive = 1 And mc.Company_Id = " + CompanyId + " And mc.Country=c.ConId", staticConnection);
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            //  string value = CurrentCompanyId.ExecuteScalar().ToString();
            SqlDataReader dr = CurrentCompany.ExecuteReader();
            string companyid = "", RegNo = "", Address = "", CompanyLogo = "";
            while (dr.Read())
            {
                companyid = dr["Company_Id"].ToString();
                RegNo = dr["REG_NUMBER"].ToString();
                Address = dr["Address1"].ToString() + " " + dr["City"].ToString() + " " + dr["State"].ToString() + " " + dr["Name"].ToString() + " " + dr["ZIP"].ToString();
                CompanyLogo = dr["CompanyLogo"].ToString();
                //bool ise = Helper.IsLevyExempt;
            }
            staticConnection.Close();

            return RegNo;
        }
    }
