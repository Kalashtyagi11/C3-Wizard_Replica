                blemp.PayFreq = empl.PayPeriod == "E2W" ? "E2W" : empl.PayPeriod == "2M" ? "2M" : empl.PayPeriod;
                blemp.CONTID = count;
                W_employee_list.Add(blemp);
                AllEmployee_List.Add(blemp);
            }
            //AllEmployeeList_List.ItemsSource = W_employee_list;
            //AllEmployeeList_List.SelectedIndex = -1;
            return AllEmployee_List.OrderBy(x => x.Department).OrderBy(x => x.EmployeeName).ToList();



        }





        //bool IsWeekfifth = false;
        public async Task<List<C3Contributions>> NonDirectorRepoEdit(int HeaderId, int CompanyId, int monthno, int Year)
        {
            int mondays = 0;
            mondays = MondaysInMonth(monthno, Year);
            bool IsWeekfifth = mondays == 5 ? true : false;
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            SqlCommand cmdemp = new SqlCommand("get_C3Genrated_Director_data", staticConnection);
            cmdemp.CommandType = CommandType.StoredProcedure;
            cmdemp.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)HeaderId ?? (object)DBNull.Value));
            cmdemp.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
            SqlDataAdapter sqlAdapteremp = new SqlDataAdapter(cmdemp);
            List<C3Contributions> W_employee_list = new List<C3Contributions>();
            List<C3Contributions> M_employee_list = new List<C3Contributions>();
            List<C3Contributions> E_2_W_employee_list = new List<C3Contributions>();
            List<C3Contributions> Tw_Memployee_list = new List<C3Contributions>();

            List<C3Contributions> All_employee_list = new List<C3Contributions>();
            DataTable dtemp = new DataTable();
            sqlAdapteremp.Fill(dtemp);
            if (dtemp.Rows.Count > 0)
            {
                foreach (DataRow row in dtemp.Rows)
                {
                    C3Contributions obj = new C3Contributions();
                    obj.C3HEADERID = int.Parse(row["C3HEADERID"].ToString());
                    obj.SSN = row["SSN"].ToString();
                    obj.EmployeeId = Convert.ToInt32(row["SSN"]);
                    obj.period_Month = row["PERIODD_MONTH"].ToString();
                    obj.Period_year = row["PERIOD_YEAR"].ToString();
                    obj.SSND = row["Soc_Sec_Num"].ToString();
                    obj.EmployeeName = row["Emp_Name"].ToString();
                    obj.WEEK1 = (bool)row["WEEK1"];
                    obj.WEEK2 = (bool)row["WEEK2"];
                    obj.WEEK3 = (bool)row["WEEK3"];
                    obj.WEEK4 = (bool)row["WEEK4"];
                    obj.WEEK5 = IsWeekfifth ? (bool)row["WEEK5"] : false;
                    obj.WAGES1 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES1"].ToString())));
                    obj.WAGES2 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES2"].ToString())));
                    obj.WAGES3 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES3"].ToString())));
                    obj.WAGES4 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES4"].ToString())));
                    obj.WAGES5 = IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES5"].ToString()))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    obj.HPAY = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["HPAY"].ToString())));
                    obj.BONUS = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["BONUS"].ToString())));
                    obj.Date_Joining = row["Date_Joining"].ToString() != "" ? ((DateTime)row["Date_Joining"]).ToString(Helper.SQLDateFormat) : null;
                    obj.Date_terminated = row["Date_terminated"].ToString() != "" ? ((DateTime)row["Date_terminated"]).ToString(Helper.SQLDateFormat) : null;
                    obj.T_C_Date = obj.Date_terminated != null ? "T" : obj.Date_Joining != null ? "C" : null;
                    obj.PayFreq = row["PayFreq"].ToString();
                    obj.ISSelectedWEEK1 = obj.WEEK1 == true ? "\u221A" : "X";
                    obj.ISSelectedWEEK2 = obj.WEEK2 == true ? "\u221A" : "X";
                    obj.ISSelectedWEEK3 = obj.WEEK3 == true ? "\u221A" : "X";
                    obj.ISSelectedWEEK4 = obj.WEEK4 == true ? "\u221A" : "X";
                    obj.ISSelectedWEEK5 = obj.WEEK5 == true ? "\u221A" : "X";
                    obj.TotalWadeges = obj.WAGES1 + obj.WAGES2 + obj.WAGES3 + obj.WAGES4 + obj.WAGES5 + obj.BONUS;
                    obj.Remarks = row["Remarks"].ToString();
                    obj.IsWeekfifth = IsWeekfifth;
                    obj.IsemployeeDirector = (bool)row["IsemployeeDirector"];
                    obj.emp_add_remove = (bool)row["emp_add_remove"];
                    obj.BirthDate = ((DateTime)row["BirthDate"]).ToString(Helper.SQLDateFormat);
                    obj.Department = row["department"].ToString();
                    obj.PayPeriod = row["PayFreq"].ToString();
                    switch (obj.PayFreq)
                    {
                        case "W":
                            if (obj.C3HEADERID == 0)
                            {
                                obj.emp_add_remove = false;
                            }
                            W_employee_list.Add(obj);
                            if (obj.C3HEADERID != 0)
                                All_employee_list.Add(obj);
                            break;
                        case "E2W":
                            if (obj.C3HEADERID == 0)
                            {
                                obj.WAGES1 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES2"].ToString())));
                                obj.WAGES2 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                obj.WAGES3 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES3"].ToString())));
                                obj.WAGES4 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                obj.WAGES5 = IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES5"].ToString()))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                            }

                            E_2_W_employee_list.Add(obj);
                            if (obj.C3HEADERID != 0)
                                All_employee_list.Add(obj);
                            break;
                        case "B":
                            if (obj.C3HEADERID == 0)
                            {
                                obj.emp_add_remove = false;
                                obj.WAGES1 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES2"].ToString())));
                                obj.WAGES2 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                obj.WAGES3 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES3"].ToString())));
                                obj.WAGES4 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                obj.WAGES5 = IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES5"].ToString()))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                            }
                            E_2_W_employee_list.Add(obj);
                            if (obj.C3HEADERID != 0)
                                All_employee_list.Add(obj);
                            break;
                        case "M":
                            if (obj.C3HEADERID == 0)
                            {
                                obj.emp_add_remove = false;
                                obj.WAGES1 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                obj.WAGES2 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                obj.WAGES3 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                obj.WAGES4 = IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES4"].ToString())));
                                obj.WAGES5 = IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES5"].ToString()))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                            }
                            M_employee_list.Add(obj);
                            if (obj.C3HEADERID != 0)
                                All_employee_list.Add(obj);
                            break;
                        case "2M":
                            if (obj.C3HEADERID == 0)
                            {
                                obj.emp_add_remove = false;
                                obj.WAGES1 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                obj.WAGES2 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES2"].ToString())));
                                obj.WAGES3 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                obj.WAGES4 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES4"].ToString())));
                                obj.WAGES5 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                            }
                            Tw_Memployee_list.Add(obj);
                            if (obj.C3HEADERID != 0)
                                All_employee_list.Add(obj);
                            break;
                        case "S":
                            if (obj.C3HEADERID == 0)
                            {
                                obj.emp_add_remove = false;
                                obj.WAGES1 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                obj.WAGES2 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES2"].ToString())));
                                obj.WAGES3 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                obj.WAGES4 = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES4"].ToString())));
                                obj.WAGES5 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                            }
                            Tw_Memployee_list.Add(obj);
                            if (obj.C3HEADERID != 0)
                                All_employee_list.Add(obj);
                            break;
                    }
                    C3_Created_SSN_list.Add(obj);


                }
            }


            return C3_Created_SSN_list;
        }

        public async Task<List<C3Wizard.COMMONPROP.C3Header>> load_defaults(int CompanyId)
        {
            listDVOC3Header = new List<C3Header>();
            ObjC3Header = new C3Header();
            listC3Header = new List<C3Header>();
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            SqlCommand cmd = new SqlCommand("Get_Director_C3_Genrated_data", staticConnection);
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
            DataTable dt = new DataTable();
            sqlAdapter.Fill(dt);
            if (dt.Rows.Count > 0)
            {
                foreach (DataRow row in dt.Rows)
                {
                    C3Header Obj = new C3Header();
                    Obj.HeaderID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                    Obj.RegNo = Convert.IsDBNull(row["RegNo"]) ? null : row["RegNo"].ToString();
                    Obj.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == string.Empty ? null : MonthName((Convert.ToInt32(row["PERIODD_MONTH"]) - 1).ToString());
                    Obj.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == string.Empty ? null : row["PERIOD_YEAR"].ToString();
                    Obj.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
                    Obj.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_SSCONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString())));
                    Obj.TOTALSSPENALTY = Convert.IsDBNull(row["TOTAL_SSPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["TOTAL_SSPENALTY"].ToString());
                    //Obj.TOTALLEVYEEEMPLOYEE = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString()))) + (Convert.IsDBNull(row["TOTAL_LEVYEEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEPENALTY"].ToString()))));
                    Obj.TOTALLEVYEEEMPLOYEE = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString())));
                    Obj.TOTALLEVYEEEMPLOYER = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYER"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYER"].ToString())));
                    Obj.TOTALLEVYEEPENALTY = Convert.IsDBNull(row["TOTAL_LEVYEEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEPENALTY"].ToString())));
                    Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString("dd-MM-yyyy");
                    Obj.Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                    Obj.Is_submitted = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                    Obj.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                    Obj.isNilReturn = Convert.IsDBNull(row["isNilReturn"]) ? false : bool.Parse(row["isNilReturn"].ToString());
                    listDVOC3Header.Add(Obj);
                    //}
                }
                foreach (var row in listDVOC3Header)
                {
                    bool is_f = listDVOC3Header.Any(X => X.Is_Fianalize != true && X.period_Month == row.period_Month && X.Period_year == row.Period_year);
                    bool issubmited = row.Is_submitted;
                    bool isfinalize = row.Is_Fianalize;
                    if (issubmited == false)
                    {
                        C3Header Obj = new C3Header();
                        Obj.HeaderID = row.HeaderID;
                        Obj.RegNo = row.RegNo;
                        Obj.period_Month = row.period_Month;
                        Obj.Period_year = row.Period_year;
                        Obj.TOTAL_WAGES = row.TOTAL_WAGES;
                        Obj.TOTALSSCONTRIBUTIONS = row.TOTALSSCONTRIBUTIONS;
                        Obj.TOTALLEVYEEPENALTY = row.TOTALLEVYEEPENALTY;
                        Obj.TOTALLEVYEEEMPLOYEE = row.TOTALLEVYEEEMPLOYEE;
                        Obj.Insert_Datetimeinfo = row.Insert_Datetimeinfo;
                        Obj.Is_Fianalize = is_f ? false : true;
                        Obj.Is_submitted = issubmited;
                        Obj.Schedule_NO = row.Schedule_NO;
                        Obj.isNilReturn = row.isNilReturn;
                        listC3Header.Add(Obj);
                    }
                }
            }

            return listC3Header;

        }

        public string MonthName(string m_no)
        {

            string Month = "";
            switch (m_no)
            {
                case "0":
                    Month = "January";
                    break;
                case "1":
                    Month = "February";
                    break;
                case "2":
                    Month = "March";
                    break;
                case "3":
                    Month = "April";
                    break;
                case "4":
                    Month = "May";
                    break;
                case "5":
                    Month = "June";
                    break;
                case "6":
                    Month = "July";
                    break;
                case "7":
                    Month = "August";
                    break;
                case "8":
                    Month = "September";
                    break;
                case "9":
                    Month = "October";
                    break;
                case "10":
                    Month = "November";
                    break;
                case "11":
                    Month = "December";
                    break;
                default:
                    Month = string.Empty;
                    break;
            }


            return Month;
        }

