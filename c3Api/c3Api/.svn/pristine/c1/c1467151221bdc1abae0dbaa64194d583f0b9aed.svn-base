                // View_Preview_Repory.Visibility = Visibility.Visible;
                int TEmp = 0;
                List<C3Contributions> emplist = new List<C3Contributions>();
                if (obj_list.Count > 0)
                {
                    TEmp = obj_list.Count;
                    foreach (var empl in obj_list)
                    {
                        C3Contributions obj = new C3Contributions();
                        obj.SSN = empl.SSN;
                        obj.SSND = empl.SSND;
                        obj.C3HEADERID = empl.C3HEADERID;
                        obj.EmployeeName = empl.EmployeeName;
                        obj.WEEK1 = empl.WEEK1;
                        obj.WEEK2 = empl.WEEK2;
                        obj.WEEK3 = empl.WEEK3;
                        obj.WEEK4 = empl.WEEK4;
                        obj.WEEK5 = empl.WEEK5;
                        obj.ISSelectedWEEK1 = obj.WEEK1 == true ? "\u221A" : null;
                        obj.ISSelectedWEEK2 = obj.WEEK2 == true ? "\u221A" : null;
                        obj.ISSelectedWEEK3 = obj.WEEK3 == true ? "\u221A" : null;
                        obj.ISSelectedWEEK4 = obj.WEEK4 == true ? "\u221A" : null;
                        obj.ISSelectedWEEK5 = obj.WEEK5 == true ? "\u221A" : null;
                        obj.WAGES1 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES1, 2)));
                        obj.WAGES2 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES2, 2)));
                        obj.WAGES3 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES3, 2)));
                        obj.WAGES4 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES4, 2)));
                        obj.WAGES5 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES5, 2)));
                        obj.HPAY = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.HPAY, 2)));
                        obj.BONUS = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.BONUS, 2)));
                        obj.PayFreq = empl.PayFreq;
                        //obj.ISSelectedWEEK1 = obj.WEEK1 == true ? "\u221A" : "X";
                        //obj.ISSelectedWEEK2 = obj.WEEK2 == true ? "\u221A" : "X";
                        //obj.ISSelectedWEEK3 = obj.WEEK3 == true ? "\u221A" : "X";
                        //obj.ISSelectedWEEK4 = obj.WEEK4 == true ? "\u221A" : "X";
                        //obj.ISSelectedWEEK5 = obj.WEEK5 == true ? "\u221A" : "X";
                        obj.TotalWadeges = Math.Round((decimal)empl.TotalWadeges, 2) + obj.BONUS;
                        obj.LEVYEE = decimal.Parse(String.Format("{0:0.00}", empl.LEVYEE));
                        obj.Levy_Penalty = decimal.Parse(String.Format("{0:0.00}", empl.Levy_Penalty));
                        obj.T_C_Date = empl.T_C_Date;
                        obj.Date_Joining = empl.T_C_Date == "T" ? empl.Date_terminated : empl.T_C_Date == "C" ? empl.Date_Joining : null;
                        obj.Remarks = empl.Remarks;
                        obj.IsemployeeDirector = empl.IsemployeeDirector;
                        obj.BirthDate = empl.BirthDate;
                        emplist.Add(obj);
                        TLevy = TLevy + empl.LEVYEE;
                        TLevyP = TLevyP + empl.Levy_Penalty;
                        Twadges = Twadges + empl.TotalWadeges;
                        Bonus = Bonus + empl.BONUS;
                    }
                }
                //AddC3RecordWages = emplist;
                //AddC3RecordWages.SelectedIndex = -1;
                //LabelEmployeeCountValue.Content = TEmp;
                //LabelScheduleCountValue.Content = schedule_no;
                //TextTotalWages.Text = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(Twadges + Bonus), 2).ToString()))).ToString();
