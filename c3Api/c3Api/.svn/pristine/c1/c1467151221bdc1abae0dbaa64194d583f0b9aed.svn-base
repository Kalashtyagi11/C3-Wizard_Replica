        int savestatus = 0;

        public string Save_IN_Continue(int year,/* string monthname,*/ int monthno, int CompanyId, List<C3Contributions> emplist, bool directorExistContinue, int UserID, string MachineInfo, string User_Name)
        {
            List<C3Contributions> Emp_Cheader_Id_list = new List<C3Contributions>();


            string valuesave = year.ToString();
            // ComboBoxItem Monthtype = (ComboBoxItem)CmbMonth.SelectedItem;
            string Mvalue = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(monthno);
            if (C3H_Id == 0)
            {

                SqlConnection staticConnectionsave = C3WizardLayerConn_BaseData.StaticSqlConnection;
                SqlCommand cmdsave = new SqlCommand("check_Director_C3Created", staticConnectionsave);
                cmdsave.CommandType = CommandType.StoredProcedure;
                cmdsave.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)monthno ?? (object)DBNull.Value));
                cmdsave.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)valuesave ?? (object)DBNull.Value));
                cmdsave.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                SqlDataAdapter sqlAdaptersave = new SqlDataAdapter(cmdsave);
                DataTable dtsave = new DataTable();
                sqlAdaptersave.Fill(dtsave);
                if (dtsave.Rows.Count > 0)
                {
                    //***************Ask User handle****************************//Atul
                    // Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                    ////**confirmation msg param 
                    ///if (C3WizardMessageBox.Show("C3 Wizard", "A director payroll for the month " + Mvalue + " " + valuesave + " already exists, would \n you like to create a new director payroll schedule?", MessageBoxButton.YesNo, MessageBoxImage.Warning) == MessageBoxResult.No)
                    if (directorExistContinue)
                    {
                        isC3recordEdit = true;
                        savestatus = 0;
                        return "";
                    }
                    else
                    {
                        List<C3Contributions> SSnList = new List<C3Contributions>();
                        for (int i = 0; i < emplist.Count; i++)
                        {
                            bool ear = emplist[i].emp_add_remove;
                            if (ear)
                            {
                                C3Contributions objSave = new C3Contributions();
                                objSave.SSN = emplist[i].SSN.ToString();
                                SSnList.Add(objSave);
                            }
                        }

                        SqlCommand cmdSSN = new SqlCommand("Get_Director_Created_SSN", staticConnectionsave);
                        cmdSSN.CommandType = CommandType.StoredProcedure;
                        cmdSSN.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)monthno ?? (object)DBNull.Value));
                        cmdSSN.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)valuesave ?? (object)DBNull.Value));
                        cmdSSN.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                        SqlDataAdapter sqlAdapterSSN = new SqlDataAdapter(cmdSSN);
                        DataTable dtSSN = new DataTable();
                        sqlAdapterSSN.Fill(dtSSN);
                        if (dtSSN.Rows.Count > 0)
                        {
                            string Msg = "";
                            int SSNcount = 0;
                            foreach (DataRow row in dtSSN.Rows)
                            {
                                string ssnid = Convert.IsDBNull(row[0]) ? null : row[0].ToString();
                                string name = Convert.IsDBNull(row[1]) ? null : row[1].ToString();
                                string ssn = Convert.IsDBNull(row[2]) ? null : row[2].ToString();
                                bool ssnexists = SSnList.Any(x => x.SSN == ssnid);
                                if (ssnexists)
                                {
                                    SSNcount++;
                                    Msg = Msg + getemployeename(ssn, CompanyId) + ", ";
                                    if (SSNcount >= 3)
                                    {
                                        Msg = Msg + "\n";
                                        SSNcount = 0;
                                    }
                                }
                            }
                            if (Msg != "")
                            {
                                isC3recordEdit = true;
                                // Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                                savestatus = 0;
                                return "C3 Director payroll has been already created for the mentioned Name " + Msg;


                            }
                        }
                    }
                }
            }
            else
            {
                List<C3Contributions> SSnList = new List<C3Contributions>();
                for (int i = 0; i < emplist.Count; i++)
                {
                    bool ear = emplist[i].emp_add_remove;
                    if (ear)
                    {
                        C3Contributions objSave = new C3Contributions();
                        objSave.SSN = emplist[i].SSN.ToString();
                        objSave.C3HEADERID = emplist[i].C3HEADERID;
                        SSnList.Add(objSave);
                    }
                }
                int SSNcount = 0;
