                                    Not_obj.emp_add_remove = AllEmployeeList_List[i].emp_add_remove;
                                    Not_Selected_list.Add(Not_obj);
                                }
                            }
                        }
                    }
                    else
                    {

                        return "Data not found for twoice in a month levy deductions details for this year";

                    }
                    if (ListHavingItems)
                    {
                        if (!isSave)
                        {
