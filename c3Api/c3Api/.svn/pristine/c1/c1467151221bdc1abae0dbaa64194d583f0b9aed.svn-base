                //  Payperiodchange += M_SPP == Nm ? "" : "Monthly";
                //  Payperiodchange += E_2W_SPP == Nb ? "" : "Every Two Weeks";
                //  Payperiodchange += T_M_SPP == Ns ? "" : "Twice in a Month";

                //  if (Payperiodchange != "")
                //  {
                //    //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                //    return "C3 Wizard Please click on Create button to fetch the data for selected period";

                //  }

                //}
                string value = year.ToString();
                //ComboBoxItem Monthtype = (ComboBoxItem)CmbMonth.SelectedItem;
                string Mvalue = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(monthNum);




                var AllEmployeeList_List = await LoadDirectorC3(monthNum, value,/* MonthName,*/ CompanyId, CmbPayPeriod, H_Id);
                if (SelectList != null && SelectList.Count != 0)
                {
                    AllEmployeeList_List = AllEmployeeList_List.Where(w => SelectList.Contains(w.SSN)).ToList();
                }
                else if (H_Id != 0 && SelectList == null)//update 
                {
                    AllEmployeeList_List = AllEmployeeList_List.Where(w => w.C3HEADERID == H_Id).ToList();
                    AllEmployeeList_List.FirstOrDefault().WEEK1 = editdata.weeK1;
                    AllEmployeeList_List.FirstOrDefault().WEEK2 = editdata.weeK2;
                    AllEmployeeList_List.FirstOrDefault().WEEK3 = editdata.weeK3;
                    AllEmployeeList_List.FirstOrDefault().WEEK4 = editdata.weeK4;
                    AllEmployeeList_List.FirstOrDefault().WEEK5 = editdata.weeK5;
                    AllEmployeeList_List.FirstOrDefault().WAGES1 = editdata.WAGES1;
                    AllEmployeeList_List.FirstOrDefault().WAGES2 = editdata.WAGES2;
                    AllEmployeeList_List.FirstOrDefault().WAGES3 = editdata.WAGES3;
                    AllEmployeeList_List.FirstOrDefault().WAGES4 = editdata.WAGES4;
                    AllEmployeeList_List.FirstOrDefault().WAGES5 = editdata.WAGES5;
