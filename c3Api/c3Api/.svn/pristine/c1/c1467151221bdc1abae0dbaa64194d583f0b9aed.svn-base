                    cmdemp.Parameters.Add(new SqlParameter("@HPay_Week1", SqlDbType.Bit, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)0 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@HPay_Week2", SqlDbType.Bit, 9, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)0 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@HPay_Week3", SqlDbType.Bit, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)0 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@HPay_Week4", SqlDbType.Bit, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)0 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@HPay_Week5", SqlDbType.Bit, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)0 ?? (object)DBNull.Value));

                    SqlDataAdapter sqlAdapterEmp = new SqlDataAdapter(cmdemp);
                    DataTable dtemp = new DataTable();
                    sqlAdapterEmp.Fill(dtemp);
                }
                foreach (var row in Emp__list)
                {
                    row.C3HEADERID = C3HEADERID;
                    Emp_Cheader_Id_list.Add(row);
                }
                Emp__list = Emp_Cheader_Id_list;
                Emp_Cheader_Id_list = null;
                Finalize_C3();
                savestatus = 1;
                // C3WizardMessageBox.Show("C3 Wizard", "Saved Successfully");
            }
            return C3H_Id;
        }


