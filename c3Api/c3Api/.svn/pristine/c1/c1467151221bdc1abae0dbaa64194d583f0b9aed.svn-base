        public List<Holiday_Pay_Dates> holiday_pay_dates(DateTime Today_date, int daysThisMonth)
        {
            List<Holiday_Pay_Dates> days_list = new List<Holiday_Pay_Dates>();
            for (DateTime date = Today_date; date <= Today_date.AddDays(daysThisMonth); date = date.AddDays(1))
            {
                if (date.DayOfWeek == DayOfWeek.Monday)
                {
                    Holiday_Pay_Dates HPD = new Holiday_Pay_Dates();
                    //Sno++;
                    //HPD.S_No = Sno;

                    HPD.holidayPay_Date = date;
                    days_list.Add(HPD);
                }
            }
            return days_list;
        }
        public int MondaysInMonth(int CmbMonth, int CmbYear)
        {
            int weeks = 0;
            int daysThisMonth = DateTime.DaysInMonth(CmbYear, CmbMonth);
            DateTime beginingOfThisMonth = new DateTime(CmbYear, CmbMonth, 1);
            for (int i = 0; i < daysThisMonth; i++)
                if (beginingOfThisMonth.AddDays(i).DayOfWeek == DayOfWeek.Monday)
                    weeks++;
            return weeks;
        }
