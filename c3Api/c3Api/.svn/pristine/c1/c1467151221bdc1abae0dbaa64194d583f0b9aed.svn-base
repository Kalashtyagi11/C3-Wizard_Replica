        public async Task<ResponseModel> SubmitDirectorC3_ClickBulk(int H_Id, int CompanyId, int UserID)
        {
            try
            {
                UserVM user = GetUserDetails(CompanyId, UserID);
                if (user == null)
                {
                    return new ResponseModel
                    {
                        Status = false,
                        Message = "User details not found",
                        Statuscode = 404 // Not Found
                    };
                }

                // Check API Connection
                if (!C3WizardRepository.Repository.ConnectionInfom.APIConnection(_configuration) || !C3WizardRepository.Repository.ConnectionInfom.HasConnection())
                {
                    return new ResponseModel
                    {
                        Status = false,
                        Message = "Check your internet connection or the server may not be responding. Please try again later or contact S.S.B for assistance.",
                        Statuscode = 503 // Service Unavailable
                    };
                }
                List<BLMasterEmployee> employeelist = new List<BLMasterEmployee>();
                employeelist = BLMasterEmployee.MasterNWDirectorCollection_grid(CompanyId).ToList();
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                SqlCommand cmd = new SqlCommand("Get_Director_C3_Genrated_data", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                c3Headerbulk Obj = new c3Headerbulk();
                DataTable dt = new DataTable();
                sqlAdapter.Fill(dt);

                List<nonWorkingDirectorWagesbulk> objlist = new List<nonWorkingDirectorWagesbulk>();
                // SqlCommand cmdemp = new SqlCommand("get_C3Genrated_Employee_Detains_submit", staticConnection);
                SqlCommand cmdemp = new SqlCommand("Get_C3Genrated_Director_data", staticConnection);
                cmdemp.CommandType = CommandType.StoredProcedure;
                cmdemp.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)H_Id ?? (object)DBNull.Value));
                cmdemp.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                SqlDataAdapter sqlAdapteremp = new SqlDataAdapter(cmdemp);
                DataTable dtemp = new DataTable();
                sqlAdapteremp.Fill(dtemp);
                string month = "0", year = "0", payerId = "", period = "";
                int sequenceNo = 0;
                int C3HEADERID = 0;
                if (dt.Rows.Count > 0)
                {

                    foreach (DataRow row in dt.Rows)
                    {
                        int headid = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                        if (headid == H_Id)
                        {
                            Obj.nilReturn = Convert.IsDBNull(row["isNilReturn"]) ? 0 : bool.Parse(row["isNilReturn"].ToString()) == true ? 1 : 0;
                            C3HEADERID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                            Obj.c3Status = "PEN";
                            sequenceNo = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                            payerId = regno(CompanyId);
                            month = (Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : "" + (int.Parse(row["PERIODD_MONTH"].ToString()))); //A//+ 1));
                            year = (Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString());
                            if (dtemp.Rows.Count > 0)
                            {
                                foreach (DataRow conrow in dtemp.Rows)
                                {
                                    if (C3HEADERID == int.Parse(conrow["C3HEADERID"].ToString()))
                                    {
                                        Obj.numberEmployed += 1;
                                    }
                                }
                            }
                            Obj.submittedByEmail = user.LoginUserEmail;
                            Obj.submittedByName = user.LoginUserName;
                            Obj.calcEmpSsAmt = Convert.IsDBNull(row["TOTAL_SSCONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString())));
                            Obj.calcEmpLevyAmt = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString())));
                            Obj.calcEmpPeAmt = Convert.IsDBNull(row["TOTAL_PEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_PEPENALTY"].ToString())));
                            Obj.totalEmpLevyPenalty = Convert.IsDBNull(row["TOTAL_LEVYEEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEPENALTY"].ToString())));
                            Obj.totalEmpPePenalty = Convert.IsDBNull(row["TOTAL_PEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_PEPENALTY"].ToString())));
