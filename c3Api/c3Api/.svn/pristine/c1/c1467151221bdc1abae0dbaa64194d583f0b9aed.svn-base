        bool is_preview = false;
        public async Task<string> Button_Finalize_Click(bool confirm, List<C3Contributions> list, int Year, string MonthName, int monthIndex, int CompanyId, List<PayPeriod1> CmbPayPeriod, bool directorExistContinue, string User_Name, int UserID, string MachineInfo)
        {
            isC3recordEdit = true;
            is_preview = true;
            string msg = "";
            if (confirm) //(ConnectionInfo.HasConnection() && ConnectionInfo.APIConnection())
            {
                if (confirm)//(C3WizardMessageBox.Show("C3 Wizard", "Do you want to Submit this C3 ?", MessageBoxButton.YesNo, MessageBoxImage.Warning) == MessageBoxResult.Yes)
                {
                    savestatus = C3H_Id > 0 ? 1 : 0;
                    if (isC3recordEdit && is_preview)
                    {
                        msg = await Save_button_Click(list, Year, MonthName, monthIndex, CompanyId, CmbPayPeriod, directorExistContinue, User_Name, UserID, MachineInfo);
                    }
                    if (savestatus == 1)
                    {
                        //ButtonPrint.IsEnabled = true;
                        //ButtonExport.IsEnabled = true;
                        //Mouse.OverrideCursor = System.Windows.Input.Cursors.Wait;
                        SqlConnection staticConnectioncheck = C3WizardLayerConn_BaseData.StaticSqlConnection;
                        SqlCommand cmdDelete = new SqlCommand("C3Header_Finalize", staticConnectioncheck);
                        cmdDelete.CommandType = CommandType.StoredProcedure;
                        cmdDelete.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)C3H_Id ?? (object)DBNull.Value));

                        SqlDataAdapter sqlAdapterdelete = new SqlDataAdapter(cmdDelete);
                        DataTable dtcheck = new DataTable();
                        sqlAdapterdelete.Fill(dtcheck);
                        DataTable dt = new DataTable();
                        sqlAdapterdelete.Fill(dt);
                        if (dt.Rows.Count > 0)
                        {
                            //ButtonPrint.IsEnabled = true;
                            //ButtonExport.IsEnabled = true;
                            //
                            //SubmitDirectorC3_ClickBulk((int)C3H_Id);
                            //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                            //C3WizardMessageBox.Show("C3 Wizard", "Director payroll finalized successfully");
                            return "Director payroll finalized successfully";
                        }
                    }
                }
                else
                {
                    return "";
                }
            }
            else
            {
                savestatus = C3H_Id > 0 ? 1 : 0;
                if (isC3recordEdit && is_preview)
                {
                    Save_button_Click(list, Year, MonthName, monthIndex, CompanyId, CmbPayPeriod, directorExistContinue, User_Name, UserID, MachineInfo);
                }
                if (savestatus == 1)
                {
                    //ButtonPrint.IsEnabled = true;

                    //ButtonExport.IsEnabled = true;
                    //Mouse.OverrideCursor = System.Windows.Input.Cursors.Wait;
                    SqlConnection staticConnectioncheck = C3WizardLayerConn_BaseData.StaticSqlConnection;
                    SqlCommand cmdDelete = new SqlCommand("C3Header_Finalize", staticConnectioncheck);
                    cmdDelete.CommandType = CommandType.StoredProcedure;
                    cmdDelete.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)C3H_Id ?? (object)DBNull.Value));

                    SqlDataAdapter sqlAdapterdelete = new SqlDataAdapter(cmdDelete);
                    DataTable dtcheck = new DataTable();
                    sqlAdapterdelete.Fill(dtcheck);
                    DataTable dt = new DataTable();
                    sqlAdapterdelete.Fill(dt);
                    if (dt.Rows.Count > 0)
                    {
                        //ButtonPrint.IsEnabled = true;
                        //ButtonExport.IsEnabled = true;
                        //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                        //C3WizardMessageBox.Show("C3 Wizard", "Director payroll finalized successfully");
                        return "Director payroll finalized successfully";
                    }
                    //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                    //C3WizardMessageBox.Show("C3 Wizard", "Check your internet connection OR May server not responding.\nplease try after sometime or contact S.S.B for any assistance.\nC3 Saved  successfully at local");
                    return "Check your internet connection OR May server not responding. please try after sometime or contact S.S.B for any assistance.\nC3 Saved  successfully at local";
                }



            }
            return msg;
        }





        public async Task<string> Save_button_Click(List<C3Contributions> list, int Year, string MonthName, int monthIndex, int CompanyId, List<PayPeriod1> CmbPayPeriod, bool directorExistContinue, string User_Name, int UserID, string MachineInfo)
        {
            //Mouse.OverrideCursor = System.Windows.Input.Cursors.Wait;
            List<C3Contributions> Emp_Cheader_Id_list = new List<C3Contributions>();

            string valuesave = Year.ToString();// CmbYear.SelectedItem.ToString();
                                               //ComboBoxItem Monthtype = (ComboBoxItem)CmbMonth.SelectedItem;
            string Mvalue = MonthName;//Monthtype.Content.ToString();
                                      //var AllEmployeeList_List = await LoadDirectorC3(monthIndex, Year.ToString(), MonthName, CompanyId, CmbPayPeriod);
            if (C3H_Id == 0)
            {

                SqlConnection staticConnectionsave = C3WizardLayerConn_BaseData.StaticSqlConnection;
                SqlCommand cmdsave = new SqlCommand("check_Director_C3Created", staticConnectionsave);
                cmdsave.CommandType = CommandType.StoredProcedure;
                cmdsave.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)monthIndex ?? (object)DBNull.Value));
                cmdsave.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)valuesave ?? (object)DBNull.Value));
                cmdsave.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                SqlDataAdapter sqlAdaptersave = new SqlDataAdapter(cmdsave);
                DataTable dtsave = new DataTable();
                sqlAdaptersave.Fill(dtsave);
                if (dtsave.Rows.Count > 0)
                {
                    //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                    if (!directorExistContinue) //(C3WizardMessageBox.Show("C3 Wizard", "A director payroll for the month " + Mvalue + " " + valuesave + " already exists, would \n you like to create a new director payroll schedule?", MessageBoxButton.YesNo, MessageBoxImage.Warning) == MessageBoxResult.No)
                    {
                        isC3recordEdit = true;
                        savestatus = 0;
                        return "";
                    }
                    else
                    {
                        List<C3Contributions> SSnList = new List<C3Contributions>();
                        for (int i = 0; i < list.Count; i++)
                        {
                            bool ear = list[i].emp_add_remove;
                            if (ear)
                            {
                                C3Contributions objSave = new C3Contributions();
                                objSave.SSN = list[i].SSN.ToString();
                                SSnList.Add(objSave);
                            }
                        }

                        SqlCommand cmdSSN = new SqlCommand("Get_Director_Created_SSN", staticConnectionsave);
                        cmdSSN.CommandType = CommandType.StoredProcedure;
                        cmdSSN.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)monthIndex ?? (object)DBNull.Value));
                        cmdSSN.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)valuesave ?? (object)DBNull.Value));
                        cmdSSN.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                        SqlDataAdapter sqlAdapterSSN = new SqlDataAdapter(cmdSSN);
                        DataTable dtSSN = new DataTable();
                        sqlAdapterSSN.Fill(dtSSN);
                        if (dtSSN.Rows.Count > 0)
                        {
                            string Msg = "";
                            int SSNcount = 0;
                            foreach (DataRow row in dtSSN.Rows)
                            {
                                string ssnid = Convert.IsDBNull(row[0]) ? null : row[0].ToString();
                                string name = Convert.IsDBNull(row[1]) ? null : row[1].ToString();
                                string ssn = Convert.IsDBNull(row[2]) ? null : row[2].ToString();
                                bool ssnexists = SSnList.Any(x => x.SSN == ssnid);
                                if (ssnexists)
                                {
                                    SSNcount++;
                                    Msg = Msg + getemployeename(ssn, CompanyId) + ", ";
                                    if (SSNcount >= 3)
                                    {
                                        Msg = Msg + "\n";
                                        SSNcount = 0;
                                    }
                                }
                            }
                            if (Msg != "")
                            {
                                isC3recordEdit = true;
                                //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                                //C3WizardMessageBox.Show("C3 Wizard", "Director payroll has been already created for the mentioned Name " + "\n" + "\n" + Msg);
                                savestatus = 0;
                                return "Director payroll has been already created for the mentioned Name " + Msg;
                            }
                        }
                    }
                }
