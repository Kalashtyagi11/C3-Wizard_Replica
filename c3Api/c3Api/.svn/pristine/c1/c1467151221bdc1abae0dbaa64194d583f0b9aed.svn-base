        public async Task<bool> C3Report_Delete(int HeaderID)
        {
            SqlConnection staticConnectioncheck = C3WizardLayerConn_BaseData.StaticSqlConnection;
            SqlCommand cmdDelete = new SqlCommand("C3Header_Delete", staticConnectioncheck);
            cmdDelete.CommandType = CommandType.StoredProcedure;
            cmdDelete.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)HeaderID ?? (object)DBNull.Value));

            SqlDataAdapter sqlAdapterdelete = new SqlDataAdapter(cmdDelete);
            DataTable dtcheck = new DataTable();
            sqlAdapterdelete.Fill(dtcheck);
            DataTable dt = new DataTable();
            sqlAdapterdelete.Fill(dt);
            if (dt.Rows.Count == 0)
            {
                return true;

            }
            return false;
        }


        public async Task<dirDataReportsVm> check_batch_created_Director(string Month, string year, int companyId, int C3HEADERID)
        {
            DataTable dt = new DataTable();
            //is_dashboard = is_dash;
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            SqlCommand cmd = new SqlCommand("Generate_Director_C3_Report", staticConnection);
            cmd.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)Month ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)year ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)companyId ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@C3HEADERID", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)C3HEADERID ?? (object)DBNull.Value));
            cmd.CommandType = CommandType.StoredProcedure;
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
            sqlAdapter.Fill(dt);
            int c3count = 0;
            foreach (DataRow row in dt.Rows)
            {
                row[0] = c3count + 1;
                c3count++;
            }
            var obj = new dirDataReportsVm();

            if (dt.Rows.Count != 0)
            {
                obj.nameOfEmployer = dt.Rows[0]["company_name"].ToString();
                obj.address = dt.Rows[0]["company_address"].ToString();
                obj.tradeName = dt.Rows[0]["trade_name"].ToString();
                obj.empRegNo = dt.Rows[0]["company_reg_no"].ToString();
                obj.month = dt.Rows[0]["current_month"].ToString();
                obj.AccountantGenreal = "0.00";//dt.Rows[0]["deduct_leavy_wages"].ToString(),
                obj.dirReportsList = new List<dirReportsListVm>(); // Initialize the list
                obj.totalFeesDir = "0.00";//dt.Rows[0]["total_wages"].ToString(),
                obj.leavyPanelty = dt.Rows[0]["TOTAL_LEVYEEPENALTY"].ToString();
                obj.noOfDir = dt.Rows.Count; // Number of directors
                obj.OrderName = dt.Rows[0]["OrderName"]?.ToString();
                obj.OrderKey = dt.Rows[0]["OrderKey"]?.ToString();
            }

            decimal total = 0;
            decimal totaldeductlavy = 0;
            // Loop through all rows in dt and add multiple items to dirReportsList
            foreach (DataRow row in dt.Rows)
            {
                var dirReport = new dirReportsListVm
                {
                    socialSecNum = row["social_security_no"].ToString(),
                    nameOfDir = row["emp_name"].ToString(), // Ensure correct field mapping
                    WAGES1 = Convert.ToDecimal(row["first_week_of_salary"]?.ToString() ?? "0"),
                    WAGES2 = Convert.ToDecimal(row["second_week_of_salary"]?.ToString() ?? "0"),
                    WAGES3 = Convert.ToDecimal(row["third_week_of_salary"]?.ToString() ?? "0"),
                    WAGES4 = Convert.ToDecimal(row["four_week_of_salary"]?.ToString() ?? "0"),
                    WAGES5 = Convert.ToDecimal(row["five_week_of_salary"]?.ToString() ?? "0"),

                    Remarks = row["Remarks"]?.ToString(),
                    deduct_leavy_wages = Convert.ToDecimal(row["deduct_leavy_wages"]),
                    total_wages = Convert.ToDecimal(row["total_wages"]),
                    pay_period = row["pay_period"].ToString(),
                };
                total += Convert.ToDecimal(row["total_wages"]);
                totaldeductlavy += Convert.ToDecimal(row["deduct_leavy_wages"]);
                obj.dirReportsList.Add(dirReport);
            }
            obj.totalFeesDir = total.ToString();
            obj.TotalLevy = totaldeductlavy.ToString();
            obj.AccountantGenreal = (totaldeductlavy + Convert.ToDecimal(obj.leavyPanelty)).ToString();

            if (obj.dirReportsList != null && obj.dirReportsList.Count > 0)
            {
                //var data = ResultReportJson.Listc3ReportViewModel.GroupBy(x => x.PayPeriod);
                if (obj.OrderName == "employeeName")
                {
                    var data = obj.dirReportsList.GroupBy(x => x.pay_period)
                              .Select(group => new
                              {
                                  PayPeriod = group.Key,
                                  Employees = obj?.OrderKey == "asc" ? group.OrderBy(x => x.pay_period).ThenBy(x => x.nameOfDir).ToList()
                                      : group.OrderBy(x => x.pay_period).OrderByDescending(x => x.nameOfDir).ToList()
                              }).OrderBy(x => x.PayPeriod).ToList();

                    obj.dirReportsList = data.SelectMany(g => g.Employees).ToList();
                }
                if (obj.OrderName == "ssn")
                {
                    var data = obj.dirReportsList.GroupBy(x => x.pay_period)
                              .Select(group => new
                              {
                                  PayPeriod = group.Key,
                                  Employees = obj?.OrderKey == "asc" ? group.OrderBy(x => x.pay_period).ThenBy(x => x.socialSecNum).ToList()
                                      : group.OrderByDescending(x => x.socialSecNum).ToList()
                              }).OrderBy(x => x.PayPeriod).ToList();

                    obj.dirReportsList = data.SelectMany(g => g.Employees).ToList();
                }
            }


            return obj;



        }
        public async Task<List<string>> PayPeriodDropDownData(int CompanyId)
        {
            DateTime dt = DateTime.Now;
            string Year = dt.Year.ToString();
            int monthno = dt.Month - 1;
            int daysin_month = DateTime.DaysInMonth(int.Parse(Year), monthno);
            string monthval = monthno <= 9 ? "0" + monthno.ToString() : monthno.ToString();
            DateTime Today_date = DateTime.ParseExact(("01/" + monthval + "/" + Year), Helper.DateFormat, CultureInfo.InvariantCulture);
            DateTime? Todaydate = DateTime.ParseExact(("01/" + monthval + "/" + Year), Helper.DateFormat, CultureInfo.InvariantCulture);
            List<BLMasterEmployee> emplist = BLMasterEmployee.MasterNWDirectorCollection_grid(CompanyId).ToList();
            DateTime? end_date = Todaydate != null ? (DateTime?)((DateTime)Todaydate).AddDays(daysin_month - 1) : null;
            emplist = emplist.Where(x => (x.Terminated == null || x.Terminated >= Todaydate)).ToList();// && (x.AppintDate == null || x.AppintDate <= end_date)).ToList();
            var payp = emplist.Select(x => x.PayPeriod).Distinct().ToList();
            return payp;
        }

        public SaveNContinueRequest NWDIRECTORC3(List<C3Contributions> obj_list, List<C3Contributions> Not_Selected_list, int month, int year, int? H_Id, int schedule_no, bool issave, bool isrecordEdit, bool ispreview, int TextChanged, int CompanyId, int UserID, string User_Name)
        {
            SaveNContinueRequest result = new SaveNContinueRequest();
            isC3recordEdit = isrecordEdit;
            is_preview = ispreview;
            Emp__list = obj_list;
            Not_Selected_Emp__list = Not_Selected_list;
            y = year;
            m = month;
            C3H_Id = Convert.ToInt32(H_Id);
            s_count = schedule_no;
            int TEmp = 0;
            List<C3Contributions> emplist = new List<C3Contributions>();
            if (obj_list.Count > 0)
            {
                TEmp = obj_list.Count;
                foreach (var empl in obj_list)
                {
                    C3Contributions obj = new C3Contributions();
                    obj.SSN = empl.SSN;
                    obj.SSND = empl.SSND;
                    obj.C3HEADERID = empl.C3HEADERID;
                    obj.EmployeeName = empl.EmployeeName;
                    obj.WEEK1 = empl.WEEK1;
                    obj.WEEK2 = empl.WEEK2;
                    obj.WEEK3 = empl.WEEK3;
                    obj.WEEK4 = empl.WEEK4;
                    obj.WEEK5 = empl.WEEK5;
                    obj.ISSelectedWEEK1 = obj.WEEK1 == true ? "\u221A" : null;
                    obj.ISSelectedWEEK2 = obj.WEEK2 == true ? "\u221A" : null;
                    obj.ISSelectedWEEK3 = obj.WEEK3 == true ? "\u221A" : null;
                    obj.ISSelectedWEEK4 = obj.WEEK4 == true ? "\u221A" : null;
                    obj.ISSelectedWEEK5 = obj.WEEK5 == true ? "\u221A" : null;
                    obj.Department = empl.Department;
                    obj.WAGES1 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES1, 2)));
                    obj.WAGES2 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES2, 2)));
                    obj.WAGES3 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES3, 2)));
                    obj.WAGES4 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES4, 2)));
                    obj.WAGES5 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES5, 2)));
                    obj.HPAY = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.HPAY, 2)));
                    obj.BONUS = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.BONUS, 2)));
                    obj.PayFreq = empl.PayFreq;
                    //obj.ISSelectedWEEK1 = obj.WEEK1 == true ? "\u221A" : "X";
                    //obj.ISSelectedWEEK2 = obj.WEEK2 == true ? "\u221A" : "X";
                    //obj.ISSelectedWEEK3 = obj.WEEK3 == true ? "\u221A" : "X";
                    //obj.ISSelectedWEEK4 = obj.WEEK4 == true ? "\u221A" : "X";
                    //obj.ISSelectedWEEK5 = obj.WEEK5 == true ? "\u221A" : "X";
                    obj.TotalWadeges = Math.Round((decimal)empl.TotalWadeges, 2) + obj.BONUS;
                    obj.LEVYEE = decimal.Parse(String.Format("{0:0.00}", empl.LEVYEE));
                    obj.Levy_Penalty = decimal.Parse(String.Format("{0:0.00}", empl.Levy_Penalty));
                    obj.T_C_Date = empl.T_C_Date;
                    obj.Date_Joining = empl.T_C_Date == "T" ? empl.Date_terminated : empl.T_C_Date == "C" ? empl.Date_Joining : null;
                    obj.Date_terminated = empl.Date_terminated;
                    obj.IsemployeeDirector = empl.IsemployeeDirector;
                    obj.BirthDate = empl.BirthDate;
                    obj.Remarks = empl.Remarks;
                    emplist.Add(obj);
                    TLevy = TLevy + empl.LEVYEE;
                    TLevyP = TLevyP + empl.Levy_Penalty;
                    Twadges = Twadges + empl.TotalWadeges;
                    Bonus = Bonus + empl.BONUS;
                }
            }

            result.H_Id = C3H_Id;
            result.CompanyId = CompanyId;
            result.schedule_no = schedule_no;
            result.TextTotalWages = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(Twadges + Bonus), 2).ToString()))).ToString();
            result.TextTotalWagesNLevy = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevy), 2).ToString()))).ToString();
            result.TextLevyPenalty = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevyP), 2).ToString()))).ToString();
            result.TextTotalAccountantGeneral = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)((TLevy + TLevyP)), 2).ToString()))).ToString();
            result.TextAccountantGeneral = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevy + TLevyP), 2)).ToString())).ToString();
            result.AllEmployeeList_List = emplist;

            //ButtonPrint.IsEnabled = H_Id > 0 ? false : false;
            //ButtonExport.IsEnabled = H_Id > 0 ? false : false;
            //if (issave)
            //{
            //  if (!is_preview)
            //  {
            //    Save_IN_Continue();
            //  }

            //  ButtonFinalize.Visibility = Visibility.Visible;
            //  ButtonSave.Visibility = Visibility.Hidden;
            //  ButtonPrint.IsEnabled = C3H_Id > 0 ? true : is_preview ? false : true;
            //  ButtonExport.IsEnabled = C3H_Id > 0 ? true : is_preview ? false : true;
            //}
            //else
            //{
            //  ButtonFinalize.Visibility = isrecordEdit ? Visibility.Hidden : Visibility.Visible;
            //  ButtonSave.Visibility = isrecordEdit ? Visibility.Visible : Visibility.Hidden;
            //  ButtonPrint.IsEnabled = C3H_Id > 0 ? true : is_preview ? false : true;
            //  ButtonExport.IsEnabled = C3H_Id > 0 ? true : is_preview ? false : true;
            //}
            return result;
        }
        public int NwSaveC3Record(List<C3Contributions> obj_list, List<C3Contributions> Not_Selected_list, int month, int year, int? H_Id, int schedule_no, bool issave, bool isrecordEdit, int yearlist, int TextChanged, int CompanyId, int UserID, string User_Name, string OrderKey, string OrderName, string companyReg, bool isNilReturn)
        {
            try
            {
                isC3recordEdit = isrecordEdit;
                Emp__list = obj_list;
                y = year;
                m = month;
                C3H_Id = Convert.ToInt32(H_Id);
                s_count = schedule_no;
                int TEmp = 0;

                List<C3Contributions> emplist = new List<C3Contributions>();
                SaveNContinueRequest result = new SaveNContinueRequest();
                if (obj_list.Count > 0)
                {
                    TEmp = obj_list.Count;
                    foreach (var empl in obj_list)
                    {
                        C3Contributions obj = new C3Contributions();
                        obj.SSN = empl.SSN;
                        // obj.SSN = empl.SSND;
                        obj.SSND = empl.SSND;
                        obj.C3HEADERID = empl.C3HEADERID;
                        obj.EmployeeName = empl.EmployeeName;
                        obj.WEEK1 = empl.WEEK1;
                        obj.WEEK2 = empl.WEEK2;
                        obj.WEEK3 = empl.WEEK3;
                        obj.WEEK4 = empl.WEEK4;
                        obj.WEEK5 = empl.WEEK5;
                        obj.ISSelectedWEEK1 = obj.WEEK1 == true ? "\u221A" : null;
                        obj.ISSelectedWEEK2 = obj.WEEK2 == true ? "\u221A" : null;
                        obj.ISSelectedWEEK3 = obj.WEEK3 == true ? "\u221A" : null;
                        obj.ISSelectedWEEK4 = obj.WEEK4 == true ? "\u221A" : null;
                        obj.ISSelectedWEEK5 = obj.WEEK5 == true ? "\u221A" : null;
                        obj.WAGES1 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES1, 2)));
                        obj.WAGES2 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES2, 2)));
                        obj.WAGES3 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES3, 2)));
                        obj.WAGES4 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES4, 2)));
                        obj.WAGES5 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES5, 2)));
                        obj.HPAY = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.HPAY, 2)));
                        obj.BONUS = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.BONUS, 2)));
                        obj.PayFreq = empl.PayFreq;
                        obj.TotalWadeges = Math.Round((decimal)empl.TotalWadeges, 2) + obj.BONUS;
                        obj.LEVYEE = decimal.Parse(String.Format("{0:0.00}", empl.LEVYEE));
                        obj.Levy_Penalty = decimal.Parse(String.Format("{0:0.00}", empl.Levy_Penalty));
                        obj.T_C_Date = empl.T_C_Date;
                        obj.Date_Joining = empl.T_C_Date == "T" ? empl.Date_terminated : empl.T_C_Date == "C" ? empl.Date_Joining : null;
                        obj.Remarks = empl.Remarks;
                        obj.IsemployeeDirector = empl.IsemployeeDirector;
                        obj.BirthDate = empl.BirthDate;
                        emplist.Add(obj);
                        TLevy = TLevy + empl.LEVYEE;
                        TLevyP = TLevyP + empl.Levy_Penalty;
                        Twadges = Twadges + empl.TotalWadeges;
                        Bonus = Bonus + empl.BONUS;
                    }
                }
                result.AllEmployeeList_List = emplist;
                result.schedule_no = schedule_no;
                result.TextTotalWages = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(Twadges + Bonus), 2).ToString()))).ToString();
                result.TextTotalWagesNLevy = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevy), 2).ToString()))).ToString();
                result.TextLevyPenalty = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevyP), 2).ToString()))).ToString();
                result.TextTotalAccountantGeneral = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)((TLevy + TLevyP)), 2).ToString()))).ToString();
                result.TextAccountantGeneral = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevy + TLevyP), 2)).ToString())).ToString();
                result.Monthno = month;
                result.CompanyId = CompanyId;
                result.User_Name = User_Name;
                result.UserID = UserID;
                result.OrderKey = OrderKey;
                result.OrderName = OrderName;
                result.company_reg_no = companyReg;
                result.isNilReturn = isNilReturn;
                if (issave)
                {
                    C3H_Id = NWSave_IN_Continue(result, year);
                    if (C3H_Id > 0)
                    {
                        Finalize_C3();
                    }
                    //Edit_C3();          
                    return C3H_Id;

                }
                else
                {
                    return 0;
                }
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return 0;
            }
        }
