        public static int yearindex(int[] yearlisy, int selectedyear)
        {
            int ycount = yearlisy.ToList().Count;
            int yindex = -1;
            for (int i = 0; i < ycount; i++)
            {
                if (selectedyear == yearlisy[i])
                    yindex = i;
            }

            return yindex; ;
        }
