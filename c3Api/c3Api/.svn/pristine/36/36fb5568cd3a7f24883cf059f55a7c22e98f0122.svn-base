                                                emp.WAGES1 = false ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES1))) : decimal.Parse(String.Format("{0:0.00}", (emp.WAGES1 + w1_hpay + w2_hpay)));
                                                emp.WAGES2 = decimal.Parse(String.Format("{0:0.00}", (emp.WAGES2)));
                                                emp.WAGES3 = false ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES3))) : isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES3 + w3_hpay + w4_hpay))) : decimal.Parse(String.Format("{0:0.00}", (emp.WAGES3 + w3_hpay + w4_hpay + w5_hpay)));
                                                emp.WAGES4 = decimal.Parse(String.Format("{0:0.00}", (emp.WAGES4)));
                                                emp.WAGES5 = false && isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES5))) : isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES5 + w5_hpay))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
