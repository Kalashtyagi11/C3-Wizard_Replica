                                                    emp.WAGES2 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                                    emp.WAGES3 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                                    emp.WAGES4 = /*IsWithleaveHpay*/false && isWeekfifth == false ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES4"].ToString()))) : isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES4"].ToString()) + w1_hpay + w2_hpay + w3_hpay + w4_hpay + w5_hpay));
                                                    emp.WAGES5 = /*IsWithleaveHpay*/false && isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES5"].ToString()))) : isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES5"].ToString()) + w1_hpay + w2_hpay + w3_hpay + w4_hpay + w5_hpay)) : decimal.Parse(String.Format("{0:0.00}", 0.00));
