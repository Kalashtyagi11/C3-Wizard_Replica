                            try
                            {

                                int result = _C3.SaveC3Record(obj_list, Not_Selected_list, request.Monthno, request.MonthName, request.Year, request.H_Id, request.schedule_no, request.IsSave, request.IsRecordEdit, Master_Setting_Rates_Rates.Employer_Levy_Rate, (decimal)Master_Setting_Rates_Rates.SeveranceRate, (decimal)Master_Setting_Rates_Rates.EIB_Pay_Limit, (decimal)Master_Setting_Rates_Rates.Soc_EE_Pay_Limit, (decimal)Master_Setting_Rates_Rates.Soc_ER_Pay_Limit, ylist, request.TextChanged, request.CompanyId, ListHavingItems, request.User_Name, request.UserID, bonusSetting, request.IsLevyExempt, request.OrderName, request.OrderKey, request.isNilReturn);
                                if (result != 0)
                                {
                                    if (!string.IsNullOrEmpty(request.c3FilePath))
                                    {
                                        int hId = Convert.ToInt32(result);
                                        var header = _context.ProcessC3headers.FirstOrDefault(e => e.C3headerid == hId);

                                        header.isImportC3file = true;
                                        header.ImportC3Filepath = request.c3FilePath;
                                        _context.SaveChanges();
                                    }


                                    return Ok(new ResponseModel
                                    {
                                        Status = true,
                                        Message = "C3 saved successfully.",
                                        Data = result,//Not_Selected_list,
                                        Statuscode = 200
                                    });
                                }
                                else
                                {
                                    return Ok(new ResponseModel
                                    {
                                        Status = true,
                                        Message = "C3 is not saved",
                                        Data = Not_Selected_list,
                                        Statuscode = 200
                                    });
                                }
                            }
                            catch (Exception ex)
                            {
                                return Ok(new ResponseModel
                                {
                                    Status = false,
                                    Message = ex.Message,
                                    Statuscode = 404,
                                });
                            }
                        }
                    }
                    else
                    {
                        return Ok(new ResponseModel
                        {
                            Status = false,
                            Message = "Please select atleast one employee.",
                            Data = null,
                            Statuscode = 200
                        });
                    }
                }
                else
                {
                    return Ok(new ResponseModel
                    {
                        Status = false,
                        Message = "Levy deductions rates settings not exists into system  for this year.Please contect with social security board..",
                        Data = null,
                        Statuscode = 200
                    });
                }
                //}
                //else
                //{
                //  Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                //  C3WizardMessageBox.Show("C3 Wizard", "You can create C3 for 6 month future date only!");
                //}
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = $"Internal server error: {ex.Message}",
                    Data = null,
                    Statuscode = 500
                });
                //Login login = new Login();
                //login.Error_Log(ex.Message);
            }

        }

        [HttpPost("SaveBonus")]
        public async Task<IActionResult> SaveBonus([FromBody] BonusVM request)
        {

            if (!ModelState.IsValid)
            {
                return BadRequest(ModelState);
            }
            int c3hid = 0, C3month = -1, C3year = -1;
            string fromScreen = null;
            string errormessage = "";
            if (request.EMPLOYEESSN == "" || request.EMPLOYEESSN == null)
            { errormessage = errormessage + " Please enter required field  Employee SSN Number"; }
            if (request.PayDate == null)
            { errormessage = errormessage + "\n Please enter required field   Pay Date"; }

            if (request.Amount == 0.00M)
            { errormessage = errormessage + "\n Please enter required field  Amount" + "\n"; }

            if (errormessage != "" && errormessage != null)
            {
                return Ok(new ResponseModel
                {
                    Status = true,
                    Message = errormessage,
                    Data = 0,
                    Statuscode = 200
                });
            }


            try
            {
                string emp = request.EMPLOYEESSN;
                int employeeid = int.Parse(emp.Substring(0, 6));
                // string ssno = employeeid.ToString();
                string ssno = emp.Substring(0, 6);
                int HPid;
                List<BLMasterEmployee> emplist = BLMasterEmployee.MasterEmployeeCollection_grid(request.CompanyId).ToList();
                if (emplist.Count() == 0)
                {
                    return Ok(new ResponseModel
                    {
                        Status = false,
                        Message = "Record is not found",
                        Data = emplist,
                        Statuscode = 401
                    });
                }

                List<BLMasterEmployee> emplistinfo = emplist.Where(x => x.SocSecNum == ssno).ToList();
                int monthno = ((DateTime)request.PayDate).Month;
                string value = ((DateTime)request.PayDate).Year.ToString();
                int daysin_month = DateTime.DaysInMonth(int.Parse(value), monthno);
                string monthval = monthno <= 9 ? "0" + monthno.ToString() : monthno.ToString();
                DateTime Today_date = DateTime.ParseExact(("01/" + monthval + "/" + value), Helper.DateFormat, CultureInfo.InvariantCulture);
                DateTime? Todaydate = DateTime.ParseExact(("01/" + monthval + "/" + value), Helper.DateFormat, CultureInfo.InvariantCulture);
                emplist = emplist.Where(x => x.SocSecNum == ssno && (x.Terminated == null || x.Terminated >= Todaydate) && (x.AppintDate == null || x.AppintDate <= Todaydate)).ToList();
                if (emplist.Count > 0)
                {

                    bool isfinilaze = true;//isC3Finilize((DateTime)Todaydate, ((DateTime)Todaydate).AddDays(daysin_month - 1), ssno);
                    if (true)//isfinilaze)
                    {
                        //Application.Current.Properties["TextChanged"] = 0;
                        List<Holiday_Pay_Dates1> days_list = new List<Holiday_Pay_Dates1>();
                        Holiday_Pay_Dates1 HPD = new Holiday_Pay_Dates1();
                        HPD.S_No = 1;
                        HPD.holidayPay_Date = ((DateTime)request.PayDate);
                        HPD.hodayPay_Date = ((DateTime)request.PayDate).ToString(Helper.DisplayDateFormat);
                        HPD.Amount = request.Amount;
                        days_list.Add(HPD);
                        SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                        if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                        SqlCommand cmd = new SqlCommand("Bonus_Pay_Insert_One", staticConnection);
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.Add(new SqlParameter("@From_Date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(DateTime)Todaydate ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@To_Date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)((DateTime)Todaydate).AddDays(daysin_month - 1) ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@Amount", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)request.Amount ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@EmployeeId", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)employeeid ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)request.CompanyId ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@PayNoOfTimes", SqlDbType.Int, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)days_list.Count ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@EmployeeDetails", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)request.EMPLOYEESSN ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@insertedon", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@updateon", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@PERIODD_MONTH", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)monthno ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@PERIOD_YEAR", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)value ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@Wages_Bouns_PayDate", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)request.PayDate ?? (object)DBNull.Value));
                        SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                        DataTable dt = new DataTable();
                        sqlAdapter.Fill(dt);
                        staticConnection.Close();
                        if (dt.Rows.Count > 0)
                        {

                            if (fromScreen == null)
                            {
                                return Ok(new ResponseModel
                                {
                                    Status = true,
                                    Message = "Bonus Save successfully.",
                                    Data = null,
                                    Statuscode = 200
                                });
                            }

                        }
                        else
                        {
                            return Ok(new ResponseModel
                            {
                                Status = false,
                                Message = "Record already exist for this month!",
                                Data = null,
                                Statuscode = 401
                            });
                        }
                    }
                }
                else
                {
                    bool tdate = emplistinfo.FirstOrDefault().Terminated != null ? true : false;
                    if (tdate)
                    {
                        if (emplistinfo.FirstOrDefault().Terminated <= Today_date)
                        {
                            return Ok(new ResponseModel
                            {
                                Status = false,
                                Message = "You can't pay bonus to this employee because this employee is terminated on dated " + ((DateTime)emplistinfo.FirstOrDefault().Terminated).ToString(Helper.DisplayDateFormat) + " !",
                                Data = null,
                                Statuscode = 200
                            });
                        }
                    }
                    bool cdate = emplistinfo.FirstOrDefault().AppintDate != null ? true : false;
                    if (cdate)
                    {
                        if (emplistinfo.FirstOrDefault().AppintDate >= Today_date)
                        {

                            return Ok(new ResponseModel
                            {
                                Status = false,
                                Message = "You can't pay Bonus to this employee because this employee is appointed on dated " + ((DateTime)emplistinfo.FirstOrDefault().AppintDate).ToString(Helper.DisplayDateFormat) + " !",
                                Data = null,
                                Statuscode = 400
                            });
                        }
                    }
                    return Ok(new ResponseModel
                    {
                        Status = false,
                        Message = "You can't pay Bonus to this employee because this employee is appointed on dated " + ((DateTime)emplistinfo.FirstOrDefault().AppintDate).ToString(Helper.DisplayDateFormat) + " !",
                        Data = null,
                        Statuscode = 400
                    });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = $"Internal server error: {ex.Message}",
                    Data = null,
                    Statuscode = 500
                });
            }
            return NotFound(new ResponseModel
            {
                Status = false,
                Message = "Internal server error",
                Data = null,
                Statuscode = 404
            });
        }



