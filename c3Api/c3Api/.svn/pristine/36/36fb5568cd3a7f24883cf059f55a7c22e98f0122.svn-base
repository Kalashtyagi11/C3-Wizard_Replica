                                            EmpSalary = decimal.Parse(string.Format("{0:0.00}", decimal.Parse(row["EmpSalary"].ToString()))),
                                            // Calculate wage and holiday amounts using helper methods:
                                            wage_Amt = decimal.Parse(string.Format("{0:0.00}", _C3.LoadWages(todayDate, row["SSN"].ToString(), yearValue, monthIndex, obj.CompanyId))),
                                            WAGES1 = decimal.Parse(string.Format("{0:0.00}", decimal.Parse(row["WAGES1"].ToString()))),
                                            WAGES2 = decimal.Parse(string.Format("{0:0.00}", decimal.Parse(row["WAGES2"].ToString()))),
                                            WAGES3 = decimal.Parse(string.Format("{0:0.00}", decimal.Parse(row["WAGES3"].ToString()))),
                                            WAGES4 = decimal.Parse(string.Format("{0:0.00}", decimal.Parse(row["WAGES4"].ToString()))),
                                            WAGES5 = isWeekfifth ? decimal.Parse(string.Format("{0:0.00}", decimal.Parse(row["WAGES5"].ToString()))) : 0,
                                            // Holiday pay values (if needed)
                                            HPay_Week1 = decimal.TryParse(row["HPay_Week1"].ToString(), out decimal hPay1) ? decimal.Parse(string.Format("{0:0.00}", hPay1)) : 0,
                                            HPay_Week2 = decimal.TryParse(row["HPay_Week2"].ToString(), out decimal hPay2) ? decimal.Parse(string.Format("{0:0.00}", hPay2)) : 0,
                                            HPay_Week3 = decimal.TryParse(row["HPay_Week3"].ToString(), out decimal hPay3) ? decimal.Parse(string.Format("{0:0.00}", hPay3)) : 0,
                                            HPay_Week4 = decimal.TryParse(row["HPay_Week4"].ToString(), out decimal hPay4) ? decimal.Parse(string.Format("{0:0.00}", hPay4)) : 0,
                                            HPay_Week5 = decimal.TryParse(row["HPay_Week5"].ToString(), out decimal hPay5) ? decimal.Parse(string.Format("{0:0.00}", hPay5)) : 0,
                                            BONUS = decimal.Parse(string.Format("{0:0.00}", _C3.LoadBonus(todayDate, row["SSN"].ToString(), yearValue, monthIndex, obj.CompanyId))),
                                            Date_Joining = row["Date_Joining"] != DBNull.Value ? ((DateTime)row["Date_Joining"]).ToString(Helper.SQLDateFormat) : null,
                                            Date_terminated = row["Date_terminated"] != DBNull.Value ? ((DateTime)row["Date_terminated"]).ToString(Helper.SQLDateFormat) : null,
                                            T_C_Date = row["Date_terminated"] != DBNull.Value ? "T" : row["Date_Joining"] != DBNull.Value ? "C" : null,
                                            PayFreq = row["PayFreq"].ToString(),
                                            Department = row["department"].ToString(),
                                            //PayPeriod = row["Pay_Period"].ToString(),
                                            BirthDate = ((DateTime)row["BirthDate"]).ToString(Helper.SQLDateFormat)
                                        };

                                        //=====================atul cmt
                                        // For holiday pay we calculate the amounts for each week:
                                        //decimal w1_hpay = _C3.LoadHpay(todayDate, emp.SSN, yearValue, monthIndex, obj.CompanyId);
                                        //decimal w2_hpay = _C3.LoadHpay(holidayPayDates[0].holidayPay_Date, emp.SSN, yearValue, monthIndex, obj.CompanyId);
                                        //decimal w3_hpay = _C3.LoadHpay(holidayPayDates[1].holidayPay_Date, emp.SSN, yearValue, monthIndex, obj.CompanyId);
