                                        emp.tempWAGES3 = emp.WAGES3;
                                        emp.tempWAGES4 = emp.WAGES4;
                                        emp.tempWAGES5 = emp.WAGES5;
                                        // Depending on the PayFreq the wages might be adjusted.
                                        // (Below is a simplified example; you can mirror the switch-case logic from your original code.)
