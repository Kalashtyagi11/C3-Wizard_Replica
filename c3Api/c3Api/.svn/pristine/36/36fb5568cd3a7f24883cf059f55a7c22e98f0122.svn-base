        /// <summary>
        /// Deletec3ssb
        /// </summary>
        /// <param name="headerId"></param>
        /// <param name="CompanyId"></param>
        /// <param name="UserID"></param>
        /// <returns></returns>
        [HttpPost("DeleteC3SSBAndLocal")]
        public async Task<IActionResult> DeleteC3SSBAndLocal(int headerId)
        {
            ResponseModel response = new ResponseModel();
            try
            {
                var result = await _context.ProcessC3headers.Where(x => x.C3headerid == headerId).Select(x => new
                {
                    CompanyId = (int?)x.EmployerId,
                    InsertBy = x.InsertedBy
                })
                                                            .FirstOrDefaultAsync();


                int CompanyId = Convert.ToInt32(result.CompanyId);
                int UserID = Convert.ToInt32(result.InsertBy);

                UserVM user = _C3.GetUserDetails(CompanyId, UserID);
                var IsBEMA_APIs_Integration = _configuration["IsBEMA_APIs_Integration"];
                if (IsBEMA_APIs_Integration == "1")
                {
                    response = await _C3.DeleteC3SSBAndLocal(headerId, Convert.ToInt32(CompanyId), UserID, user);
                    if ((bool)!response.Status)
                    {
                        return Ok(response);
                    }
                    using (SqlConnection connection = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString))
                    {
                        await connection.OpenAsync();

                        using (SqlCommand cmdDelete = new SqlCommand("C3Header_Delete", connection))
                        {
                            cmdDelete.CommandType = CommandType.StoredProcedure;
                            cmdDelete.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int) { Value = headerId });

                            int rowsAffected = await cmdDelete.ExecuteNonQueryAsync();

                            if (rowsAffected > 0)
                            {
                                return Ok(new ResponseModel
                                {
                                    Status = true,
                                    Message = "C3 deleted successfully.",
                                    Data = "",
                                    Statuscode = 200
                                });
                            }
                            else
                            {
                                return Ok(new ResponseModel
                                {
                                    Status = false,
                                    Message = "Deletion failed. No rows affected.",
                                    Data = "",
                                    Statuscode = 500
                                });
                            }
                        }
                    }




                    return Ok(response);
                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel
                {
                    Status = false,  // Indicate success
                    Message = ex.Message,
                    Statuscode = 400
                });
            }
            return Ok(response);
        }
        [HttpPost("SubmitC3Bulk")]
        public async Task<IActionResult> SubmitC3Bulk(int headerId, int CompanyId, int UserID)
        {
            ResponseModel response = new ResponseModel();
            try
            {
                UserVM user = _C3.GetUserDetails(CompanyId, UserID);
                var IsBEMA_APIs_Integration = _configuration["IsBEMA_APIs_Integration"];
                if (IsBEMA_APIs_Integration == "1")
                {
                    response = await _C3.SSBsubmitC3bulk(headerId, CompanyId, UserID, user);
                    return Ok(response);
                }
                else
                {
                    bool isc3submitted = _context.ProcessC3headers.Any(x => x.C3headerid == headerId && (bool)x.IsSubmitted == true);
                    if (!isc3submitted)
                    {
                        SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                        string updateHeaderQuery = $"UPDATE PROCESS_C3Header SET Is_submitted=1, C3_SubmittedDate='{DateTime.Now.ToString(Helper.SQLDateFormat)}', C3_SubmittedBy={UserID} WHERE C3HEADERID={headerId}";
                        SqlCommand updateC3Header = new SqlCommand(updateHeaderQuery, staticConnection);
                        if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                        int uprow = updateC3Header.ExecuteNonQuery();
                        staticConnection.Close();

                        string updateContributionQuery = $"UPDATE Process_Contributions SET Is_submitted=1, C3_SubmittedDate='{DateTime.Now.ToString(Helper.SQLDateFormat)}', C3_SubmittedBy={UserID} WHERE C3HEADERID={headerId}";
                        SqlCommand updateContributions = new SqlCommand(updateContributionQuery, staticConnection);
                        if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                        int urow2 = updateContributions.ExecuteNonQuery();
                        staticConnection.Close();
                        response.Status = true;
                        response.Statuscode = 200;
                        response.Message = "C3 submitted successfully.";
                        return Ok(response);
                    }
                    else
                    {
                        response.Status = false;
                        response.Statuscode = 400;
                        response.Message = "C3 already submitted in SSB.";
                        return BadRequest(response);
                    }
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel
                {
                    Status = false,  // Indicate success
                    Message = ex.Message,
                    Statuscode = 400
                });
            }
            return Ok(response);
        }

        [HttpPost("SubmitC3Bulk_NW")]
        public async Task<IActionResult> SubmitC3Bulk_NW(int headerId, int CompanyId, int UserID)
        {
            try
            {
                UserVM user = _C3.GetUserDetails(CompanyId, UserID);
                if (user == null)
                {
                    return Ok(new ResponseModel
                    {
                        Status = false,  // Indicate success
                        Message = "User details Not found",
                        Statuscode = 200
                    });
                }

                // Check connection status
                if (C3WizardRepository.Repository.ConnectionInfom.HasConnection() && C3WizardRepository.Repository.ConnectionInfom.APIConnection(_configuration))
                {
                    return Ok(new ResponseModel
                    {
                        Status = false,  // Indicate success
                        Message = "Check your internet connection or the server may not be responding. Please try again later or contact S.S.B for assistance",
                        Statuscode = 200
                    });

                    //return BadRequest("Check your internet connection or the server may not be responding. Please try again later or contact S.S.B for assistance.");
                }

                // Retrieve employee list
                List<BLMasterEmployee> employeelist = BLMasterEmployee.MasterEmployeeCollection_grid(CompanyId).ToList();

                // Create SQL connection and command for header data
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                SqlCommand cmd = new SqlCommand("get_C3Genrated_data", staticConnection)
                {
                    CommandType = CommandType.StoredProcedure
                };
                cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? DBNull.Value));
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                c3Headerbulk Objbulk = new c3Headerbulk();
                DataTable dt = new DataTable();
                sqlAdapter.Fill(dt);
                staticConnection.Close();
                // Create SQL command for employee data
                SqlCommand cmdemp = new SqlCommand("get_C3Genrated_Employee_Data", staticConnection)
                {
                    CommandType = CommandType.StoredProcedure
                };
                cmdemp.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)headerId ?? DBNull.Value));
                cmdemp.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? DBNull.Value));
                SqlDataAdapter sqlAdapteremp = new SqlDataAdapter(cmdemp);
                DataTable dtemp = new DataTable();
                sqlAdapteremp.Fill(dtemp);

                // Initialize local variables
                string month = "0", year = "0", payerId = "";
                int sequenceNo = 0, scheduleno = 0, C3HEADERID = 0;

                // Process header data
                if (dt.Rows.Count > 0)
                {
                    foreach (DataRow row in dt.Rows)
                    {
                        int headid = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                        if (headid == headerId)
                        {
                            C3HEADERID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                            Objbulk.c3Status = "PEN";

                            // Count number of employees from the detail table
                            if (dtemp.Rows.Count > 0)
                            {
                                foreach (DataRow conrow in dtemp.Rows)
                                {
                                    if (C3HEADERID == int.Parse(conrow["C3HEADERID"].ToString()))
                                    {
                                        Objbulk.numberEmployed += 1;
                                    }
                                }
                            }
                            sequenceNo = 1;
                            scheduleno = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                            payerId = _C3.regno(CompanyId); // Assume regno() is implemented elsewhere
                            Objbulk.submittedByEmail = user.LoginUserEmail;
                            Objbulk.submittedByName = user.LoginUserName;
                            month = (Convert.IsDBNull(row["PERIODD_MONTH"]) || string.IsNullOrEmpty(row["PERIODD_MONTH"].ToString()))
                                    ? null
                                    : (int.Parse(row["PERIODD_MONTH"].ToString()) + 1).ToString();
                            year = (Convert.IsDBNull(row["PERIOD_YEAR"]) || string.IsNullOrEmpty(row["PERIOD_YEAR"].ToString()))
                                    ? null
                                    : row["PERIOD_YEAR"].ToString();
                            Objbulk.calcEmpSsAmt = Convert.IsDBNull(row["TOTAL_SSCONTRIBUTIONS"]) ? 0.00m
                                : decimal.Parse(decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString()).ToString("0.00"));
                            Objbulk.calcEmpLevyAmt = (Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? 0.00m
                                : decimal.Parse(decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString()).ToString("0.00")))
                                + (Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYER"]) ? 0.00m
                                : decimal.Parse(decimal.Parse(row["TOTAL_LEVYEEEMPLOYER"].ToString()).ToString("0.00")));
                            Objbulk.calcEmpPeAmt = Convert.IsDBNull(row["TOTAL_SERVAYANCE"]) ? 0.00m
                                : decimal.Parse(decimal.Parse(row["TOTAL_SERVAYANCE"].ToString()).ToString("0.00"));
                            Objbulk.totalEmpLevyPenalty = Convert.IsDBNull(row["TOTAL_LEVYEEPENALTY"]) ? 0.00m
                                : decimal.Parse(decimal.Parse(row["TOTAL_LEVYEEPENALTY"].ToString()).ToString("0.00"));
                            Objbulk.totalEmpPePenalty = Convert.IsDBNull(row["TOTAL_PEPENALTY"]) ? 0.00m
                                : decimal.Parse(decimal.Parse(row["TOTAL_PEPENALTY"].ToString()).ToString("0.00"));
                            Objbulk.totalEmpSsFines = Convert.IsDBNull(row["TOTAL_SSPENALTY"]) ? 0.00m
                                : decimal.Parse(decimal.Parse(row["TOTAL_SSPENALTY"].ToString()).ToString("0.00"));
                            Objbulk.dateReceived = DateTime.Now.ToString(Helper.DateFormat, CultureInfo.InvariantCulture);
                            Objbulk.receivedBy = user.User_Name;
                        }
                    }
                }

                // Process employee (detail) data
                List<ipWagesbulk> objlistbulk = new List<ipWagesbulk>();
                if (dtemp.Rows.Count > 0)
                {
                    foreach (DataRow row in dtemp.Rows)
                    {
                        if (C3HEADERID == int.Parse(row["C3HEADERID"].ToString()))
                        {
                            ipWagesbulk ipobjbulk = new ipWagesbulk();
                            ipobjbulk.ssn = row["SSN"].ToString();

                            // Try to look up employee details
                            try
                            {
                                var emp = employeelist.FirstOrDefault(x => x.SocSecNum == ipobjbulk.ssn);
                                if (emp != null)
                                {
                                    ipobjbulk.birthDate = ((DateTime)emp.BirthDate).ToString(Helper.DateFormat, CultureInfo.InvariantCulture);
                                    ipobjbulk.firstName = emp.FirstName;
                                    ipobjbulk.surName = emp.LastName;
                                    ipobjbulk.firstName = ipobjbulk.firstName.Replace(ipobjbulk.surName, "").Trim();
                                }
                            }
                            catch (Exception ex)
                            {
                                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                                // Log exception if needed
                            }

                            // Calculate wages adjustments based on pay frequency
                            decimal HPay_Week1 = string.IsNullOrEmpty(row["HPay_Week1"].ToString()) ? 0.00m : decimal.Parse(decimal.Parse(row["HPay_Week1"].ToString()).ToString("0.00"));
                            decimal HPay_Week2 = string.IsNullOrEmpty(row["HPay_Week2"].ToString()) ? 0.00m : decimal.Parse(decimal.Parse(row["HPay_Week2"].ToString()).ToString("0.00"));
                            decimal HPay_Week3 = string.IsNullOrEmpty(row["HPay_Week3"].ToString()) ? 0.00m : decimal.Parse(decimal.Parse(row["HPay_Week3"].ToString()).ToString("0.00"));
                            decimal HPay_Week4 = string.IsNullOrEmpty(row["HPay_Week4"].ToString()) ? 0.00m : decimal.Parse(decimal.Parse(row["HPay_Week4"].ToString()).ToString("0.00"));
                            decimal HPay_Week5 = string.IsNullOrEmpty(row["HPay_Week5"].ToString()) ? 0.00m : decimal.Parse(decimal.Parse(row["HPay_Week5"].ToString()).ToString("0.00"));

                            string PayPeriod = row["PayFreq"].ToString();
                            bool IsWeekFifth = (bool)row["WEEK5"];

                            decimal Wages1 = decimal.Parse(decimal.Parse(row["WAGES1"].ToString()).ToString("0.00"));
                            decimal Wages2 = decimal.Parse(decimal.Parse(row["WAGES2"].ToString()).ToString("0.00"));
                            decimal Wages3 = decimal.Parse(decimal.Parse(row["WAGES3"].ToString()).ToString("0.00"));
                            decimal Wages4 = decimal.Parse(decimal.Parse(row["WAGES4"].ToString()).ToString("0.00"));
                            decimal Wages5 = decimal.Parse(decimal.Parse(row["WAGES5"].ToString()).ToString("0.00"));

                            if (PayPeriod == "W") // Weekly
                            {
                                row["WAGES1"] = Wages1 + HPay_Week1;
                                row["WAGES2"] = Wages2 + HPay_Week2;
                                row["WAGES3"] = Wages3 + HPay_Week3;
                                row["WAGES4"] = IsWeekFifth ? Wages4 + HPay_Week4 : Wages4 + HPay_Week4 + HPay_Week5;
                                if (IsWeekFifth)
                                {
                                    row["WAGES5"] = Wages5 + HPay_Week5;
                                }
                            }
                            else if (PayPeriod == "E2W") // Every two weeks
                            {
                                row["WAGES1"] = Wages1 + HPay_Week1 + HPay_Week2;
                                row["WAGES3"] = IsWeekFifth ? Wages3 + HPay_Week3 + HPay_Week4 : Wages3 + HPay_Week3 + HPay_Week4 + HPay_Week5;
                                if (IsWeekFifth)
                                {
                                    row["WAGES5"] = Wages5 + HPay_Week5;
                                }
                            }
                            else if (PayPeriod == "M") // Monthly
                            {
                                if (!IsWeekFifth)
                                {
                                    row["WAGES4"] = Wages4 + HPay_Week1 + HPay_Week2 + HPay_Week3 + HPay_Week4 + HPay_Week5;
                                    row["WAGES5"] = Wages5 + HPay_Week1 + HPay_Week2 + HPay_Week3 + HPay_Week4 + HPay_Week5;
                                }
                            }
                            else if (PayPeriod == "2M")
                            {
                                row["WAGES2"] = Wages2 + HPay_Week1 + HPay_Week2;
                                row["WAGES4"] = IsWeekFifth ? Wages4 + HPay_Week3 + HPay_Week4 : Wages4 + HPay_Week3 + HPay_Week4 + HPay_Week5;
                                if (IsWeekFifth)
                                {
                                    row["WAGES5"] = Wages5 + HPay_Week5;
                                }
                            }

                            ipobjbulk.erEiAmt = decimal.Parse(decimal.Parse(row["SERVAYANCE_EE"].ToString()).ToString("0.00"));
                            ipobjbulk.erLevyAmt = decimal.Parse(decimal.Parse(row["LEVY_ER"].ToString()).ToString("0.00"));
                            ipobjbulk.erSsAmt = decimal.Parse((decimal.Parse(row["SocialSecurity_ER"].ToString()) - decimal.Parse(row["SERVAYANCE_EE"].ToString())).ToString("0.00"));
                            ipobjbulk.ipLevyAmt = decimal.Parse(decimal.Parse(row["Levyee"].ToString()).ToString("0.00"));
                            ipobjbulk.ipPeAmt = decimal.Parse(decimal.Parse(row["SERVAYANCE_ER"].ToString()).ToString("0.00"));
                            ipobjbulk.ipSsAmt = decimal.Parse(decimal.Parse(row["SocialSecurity_EE"].ToString()).ToString("0.00"));
                            ipobjbulk.payPeriod = PayPeriod == "W" ? "1" :
                                                  PayPeriod == "E2W" ? "2" :
                                                  PayPeriod == "M" ? "3" :
                                                  PayPeriod == "2M" ? "4" : "1";
                            ipobjbulk.paidCode1 = ((bool)row["WEEK1"]) ? "1" : "0";
                            ipobjbulk.paidCode2 = ((bool)row["WEEK2"]) ? "1" : "0";
                            ipobjbulk.paidCode3 = ((bool)row["WEEK3"]) ? "1" : "0";
                            ipobjbulk.paidCode4 = ((bool)row["WEEK4"]) ? "1" : "0";
                            ipobjbulk.paidCode5 = ((bool)row["WEEK5"]) ? "1" : "0";
                            ipobjbulk.paidCode6 = (decimal.Parse(decimal.Parse(row["HPay"].ToString()).ToString("0.00")) > 0) ? "1" : "0";
                            ipobjbulk.paidCode7 = (decimal.Parse(decimal.Parse(row["BONUS"].ToString()).ToString("0.00")) > 0) ? "1" : "0";
                            ipobjbulk.wagesPaid1 = decimal.Parse(decimal.Parse(row["WAGES1"].ToString()).ToString("0.00"));
                            ipobjbulk.wagesPaid2 = decimal.Parse(decimal.Parse(row["WAGES2"].ToString()).ToString("0.00"));
                            ipobjbulk.wagesPaid3 = decimal.Parse(decimal.Parse(row["WAGES3"].ToString()).ToString("0.00"));
                            ipobjbulk.wagesPaid4 = decimal.Parse(decimal.Parse(row["WAGES4"].ToString()).ToString("0.00"));
                            ipobjbulk.wagesPaid5 = decimal.Parse(decimal.Parse(row["WAGES5"].ToString()).ToString("0.00"));
                            ipobjbulk.wagesPaid6 = 0.00m;
                            ipobjbulk.wagesPaid7 = decimal.Parse(decimal.Parse(row["BONUS"].ToString()).ToString("0.00"));
                            ipobjbulk.startDate = !string.IsNullOrEmpty(row["Date_Joining"].ToString())
                                ? ((DateTime)row["Date_Joining"]).ToString(Helper.DateFormat, CultureInfo.InvariantCulture)
                                : null;
                            ipobjbulk.endDate = !string.IsNullOrEmpty(row["Date_terminated"].ToString())
                                ? ((DateTime)row["Date_terminated"]).ToString(Helper.DateFormat, CultureInfo.InvariantCulture)
                                : null;
                            ipobjbulk.wageType = null;
                            objlistbulk.Add(ipobjbulk);
                        }
                    }
                }

                // Prepare the submission model
                submitC3bulk submitC3 = new submitC3bulk
                {
                    c3Header = Objbulk,
                    ipWages = objlistbulk
                };
                Objbulk.numberEmployed = objlistbulk.Count;

                // Get SSN list (assuming ssnlist is implemented)
                List<ipWagesstring> emplist = await _C3.ssnlist(payerId, month, year, scheduleno);
                List<ipWagesbulk> Deleteipobjbulk = new List<ipWagesbulk>();
                foreach (var deletssn in emplist)
                {
                    if (!objlistbulk.Any(x => x.ssn == deletssn.ssn))
                    {
                        Deleteipobjbulk.Add(new ipWagesbulk { ssn = deletssn.ssn });
                    }
                }

                // If there are extra records, call the delete endpoint
                if (emplist != null && emplist.Count > 0 && Deleteipobjbulk.Count > 0)
                {
                    string delsurl = _configuration["ServiceConfig:ServiceUriString"];
                    string delsURL = $"{delsurl}/C3/deleteC3/{payerId}/C3Submitted/{month},{year},{scheduleno},ER,EE";
                    submitC3bulk DeletesubmitC3 = new submitC3bulk
                    {
                        c3Header = new c3Headerbulk { numberEmployed = Deleteipobjbulk.Count },
                        ipWages = Deleteipobjbulk
                    };
                    string deljson = JsonConvert.SerializeObject(DeletesubmitC3);
                    var delbyteContent = new ByteArrayContent(Encoding.UTF8.GetBytes(deljson));
                    delbyteContent.Headers.ContentType = new MediaTypeHeaderValue("application/json");

                    using (var delhttpClient = new HttpClient() { BaseAddress = new Uri(delsURL), Timeout = TimeSpan.FromMinutes(2) })
                    {
                        delhttpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                        var delplainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : Encoding.UTF8.GetBytes(user.ParentUserLoginID + ":" + user.ParentUser_Password);
                        string delval = Convert.ToBase64String(delplainTextBytes);
                        delhttpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + delval);

                        HttpResponseMessage delresponse = await delhttpClient.SendAsync(
                            new HttpRequestMessage(HttpMethod.Delete, delsURL)
                            {
                                Content = new StringContent(deljson, Encoding.UTF8, "application/json")
                            });

                        // Optionally, handle the delete response
                        if (delresponse.StatusCode != HttpStatusCode.OK)
                        {
                            // Log or process the error if needed
                        }
                    }
                }

                // Call the submission API
                string Newsurl = _configuration["ServiceConfig:ServiceUriString"];
                string NewsURL = $"{Newsurl}/C3/c3BulkSubmit/{payerId}/C3Submitted/{month},{year},{scheduleno},ER,EE";
                var myContent = JsonConvert.SerializeObject(submitC3);
                var byteContent = new ByteArrayContent(Encoding.UTF8.GetBytes(myContent));
                byteContent.Headers.ContentType = new MediaTypeHeaderValue("application/json");

                HttpResponseMessage response;
                using (var httpClient = new HttpClient() { BaseAddress = new Uri(NewsURL), Timeout = TimeSpan.FromMinutes(2) })
                {
                    httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                    var plainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : Encoding.UTF8.GetBytes(user.ParentUserLoginID + ":" + user.ParentUser_Password);
                    string val = Convert.ToBase64String(plainTextBytes);
                    httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + val);

                    response = await httpClient.PostAsync(NewsURL, byteContent);
                }

                if (response.StatusCode == HttpStatusCode.OK)
                {
                    var customerJsonString = await response.Content.ReadAsStringAsync();

                    // Call GET endpoint to retrieve the submission results
                    string Emp_surl = _configuration["ServiceConfig:ServiceUriString"];
                    string Emp_sURL = $"{Emp_surl}/C3/{payerId}/C3Submitted/{month},{year},{scheduleno},ER,EE";
                    HttpResponseMessage getresponse;
                    using (var gethttpClient = new HttpClient() { BaseAddress = new Uri(Emp_sURL), Timeout = TimeSpan.FromMinutes(2) })
                    {
                        gethttpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                        var getplainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : Encoding.UTF8.GetBytes(user.ParentUserLoginID + ":" + user.ParentUser_Password);
                        string getval = Convert.ToBase64String(getplainTextBytes);
                        gethttpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + getval);

                        getresponse = await gethttpClient.GetAsync(Emp_sURL);
                    }

                    if (getresponse.StatusCode == HttpStatusCode.OK)
                    {
                        var getcustomerJsonString = await getresponse.Content.ReadAsStringAsync();
                        var submitC3_model = JsonConvert.DeserializeObject<submitC3string>(getcustomerJsonString);
                        if (submitC3_model != null && submitC3_model.c3Header != null)
                        {
                            // Update local database to mark header as submitted
                            if (staticConnection.State == ConnectionState.Open)
                            {
                                staticConnection.Close();
                            }
                            string updateHeaderQuery = $"UPDATE PROCESS_C3Header SET Is_submitted=1, C3_SubmittedDate='{DateTime.Now.ToString(Helper.SQLDateFormat)}', C3_SubmittedBy={UserID} WHERE C3HEADERID={headerId} AND PERIODD_MONTH={int.Parse(month) - 1} AND PERIOD_YEAR='{year}'";
                            SqlCommand updateC3Header = new SqlCommand(updateHeaderQuery, staticConnection);
                            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                            int uprow = updateC3Header.ExecuteNonQuery();
                            staticConnection.Close();

                            if (submitC3_model.ipWages != null)
                            {
                                string ssnlist = string.Join(",", submitC3_model.ipWages.Select(ipw => $"'{ipw.ssn}'"));
                                string updateContributionQuery = $"UPDATE Process_Contributions SET Is_submitted=1, C3_SubmittedDate='{DateTime.Now.ToString(Helper.SQLDateFormat)}', C3_SubmittedBy={UserID} WHERE C3HEADERID={headerId} AND SSN IN({ssnlist})";
                                SqlCommand updateContributions = new SqlCommand(updateContributionQuery, staticConnection);
                                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                                int urow2 = updateContributions.ExecuteNonQuery();
                                staticConnection.Close();
                            }
                        }
                        return Ok(new ResponseModel
                        {
                            Status = true,
                            Message = "C3 submitted successfully.",
                            Statuscode = 200
                        });
                    }
                    return Ok(new ResponseModel
                    {
                        Status = true,
                        Message = customerJsonString,
                        Statuscode = 200
                    });
                }
                else
                {
                    var customerJsonString = await response.Content.ReadAsStringAsync();
                    var Emp_model = JsonConvert.DeserializeObject<Apistatus>(customerJsonString);
                    return Ok(new ResponseModel
                    {
                        Status = false,  // Indicate success
                        Message = Emp_model.message,
                        Statuscode = 400
                    });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel
                {
                    Status = false,  // Indicate success
                    Message = ex.Message,
                    Statuscode = 400
                });
            }
        }

        [HttpGet]
        [Route("LoadHolidayPayEmployee")]
        public async Task<IActionResult> LoadHolidayPayEmployee(string emplSsn, int? emplid, int monthIndex, int year, int CompanyId)
        {
            try
            {
                HolypayList Result = new HolypayList();

                // Adjust the month (if you are using a 0-based index, add 1)
                int monthno = monthIndex;
                int CmbMonthSelectedIndex = monthIndex - 1;
                // Format month value as two digits
                string monthval = monthno <= 9 ? "0" + monthno.ToString() : monthno.ToString();
                // Build a date from the given month and year (assuming your Helper.DateFormat is "dd/MM/yyyy")
                DateTime firstOfMonth = DateTime.ParseExact("01/" + monthval + "/" + year, Helper.DateFormat, CultureInfo.InvariantCulture);

                // Retrieve holiday pay details from the database
                List<Holiday_Pay_Details> userlist = new List<Holiday_Pay_Details>();
                string connectionString = C3WizardLayerConn_BaseData.StaticConnectionString; // Adjust as needed

                using (SqlConnection connection = new SqlConnection(connectionString))
                {
                    connection.Open();
                    using (SqlCommand cmd = new SqlCommand("Holiday_Pay_Employee_Select_All", connection))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int))
                           .Value = (object)CompanyId ?? DBNull.Value;

                        SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                        DataTable dt = new DataTable();
                        sqlAdapter.Fill(dt);
                        connection.Close();
                        if (dt.Rows.Count > 0)
                        {
                            foreach (DataRow row in dt.Rows)
                            {
                                Holiday_Pay_Details hpd = new Holiday_Pay_Details
                                {
                                    holidayPayId = Convert.ToInt32(row[0]),
                                    employeeID = Convert.ToInt32(row[1]),
                                    company_ID = Convert.ToInt32(row[2]),
                                    Amount = Math.Round(Convert.ToDecimal(row[3]), 2),
                                    st_Date = row[4]?.ToString(),
                                    en_Date = row[5]?.ToString(),
                                    PayNoOfTimes = Convert.ToInt32(row[6]),
                                    PayStatus = row[7] != DBNull.Value,
                                    employeename = row[8]?.ToString(),
                                    IsWithoutLeave = row[10]?.ToString() == "True" ? "Holiday Pay With Leave" : row[11]?.ToString(),
                                    isHpay = row[10] != DBNull.Value && Convert.ToBoolean(row[10])
                                };
                                if (row[4] != DBNull.Value && !string.IsNullOrWhiteSpace(row[4].ToString()))
                                {
                                    DateTime startDate;
                                    if (DateTime.TryParseExact(row[4].ToString(), "dd-MM-yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out startDate))
                                    {
                                        hpd.start_Date = startDate;
                                    }
                                    else
                                    {
                                        hpd.start_Date = null;
                                    }
                                }
                                if (row[5] != DBNull.Value && !string.IsNullOrWhiteSpace(row[5].ToString()))
                                {
                                    DateTime endDate;
                                    if (DateTime.TryParseExact(row[5].ToString(), "dd-MM-yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out endDate))
                                    {
                                        hpd.end_Date = endDate;
                                    }
                                    else
                                    {
                                        hpd.end_Date = null;
                                    }
                                }
                                userlist.Add(hpd);
                            }
                        }
                    }
                }

                // Filter details for the provided employee id
                userlist = userlist.Where(x => x.employeeID == emplid).ToList();

                // Prepare lists for the API output
                List<Employee_holidpd_list1> employeeHolidayPayList = new List<Employee_holidpd_list1>();
                List<Employee_holidpd_list1> employeeHolidayPayDatesList = new List<Employee_holidpd_list1>();
                List<Holiday_Pay_Dates1> holidpd = new List<Holiday_Pay_Dates1>();
                int yvalue = year;

                // Filter and transform the holiday pay details based on the month and year
                foreach (var InfoHpd in userlist)
                {
                    int smonthno = int.Parse(InfoHpd.st_Date.Substring(3, 2));
                    int emonthno = int.Parse(InfoHpd.en_Date.Substring(3, 2));
                    int syearno = int.Parse(InfoHpd.en_Date.Substring(6, 4));

                    if (smonthno - 1 <= CmbMonthSelectedIndex && emonthno - 1 >= CmbMonthSelectedIndex && syearno == yvalue)
                    {
                        // Add the filtered record to the list
                        Employee_holidpd_list1 hpdContri = new Employee_holidpd_list1
                        {
                            holidayPayId = InfoHpd.holidayPayId,
                            employeeID = InfoHpd.employeeID,
                            company_ID = InfoHpd.company_ID,
                            Amount = InfoHpd.Amount,
                            start_Date = InfoHpd.start_Date,
                            end_Date = InfoHpd.end_Date,
                            st_Date = InfoHpd.st_Date,
                            en_Date = InfoHpd.en_Date,
                            PayNoOfTimes = InfoHpd.PayNoOfTimes,
                            PayStatus = InfoHpd.PayStatus,
                            employeename = InfoHpd.employeename,
                            IsWithoutLeave = InfoHpd.IsWithoutLeave,
                            isHpay = InfoHpd.isHpay
                        };
                        employeeHolidayPayList.Add(hpdContri);
                    }
                }

                // Process holiday pay dates for each holiday pay record

                foreach (var InfoHpd in employeeHolidayPayList)
                {
                    // Assuming _C3.GetHpayDates returns a list of Holiday_Pay_Dates1 for the given employee SSN and CompanyId
                    holidpd = _C3.GetHpayDates(emplSsn, CompanyId);
                    holidpd = holidpd.Where(x => x.HolidayPayId == InfoHpd.holidayPayId).ToList();

                    List<Employee_holidpd_list1> hpContdates = new List<Employee_holidpd_list1>();

                    foreach (var hdates in holidpd)
                    {
                        int tmonthno = hdates.holidayPay_Date.Month;
                        int yearno = hdates.holidayPay_Date.Year;
                        string month_val = tmonthno <= 9 ? "0" + tmonthno.ToString() : tmonthno.ToString();
                        DateTime firstdate_date = DateTime.ParseExact("01/" + month_val + "/" + yearno, Helper.DateFormat, CultureInfo.InvariantCulture);
                        int daysThisMonth = DateTime.DaysInMonth(yearno, tmonthno);
                        // Assuming _C3.Holiday_Pay_Dates1(...) is a method that returns a list of Holiday_Pay_Dates1 for the month
                        List<Holiday_Pay_Dates1> holidaypadates = _C3.Holiday_Pay_Dates1(firstdate_date, daysThisMonth);
                        Employee_holidpd_list1 hpCont = new Employee_holidpd_list1();

                        hpCont.Month = _C3.MonthName(tmonthno); // Assuming MonthName returns the name of the month

                        hpCont.WAGES1 = firstdate_date <= hdates.holidayPay_Date && firstdate_date.AddDays(6) >= hdates.holidayPay_Date ? hdates.Amount : decimal.Parse(String.Format("{0:0.00}", 0.00));
                        hpCont.WAGES2 = holidaypadates[1].holidayPay_Date <= hdates.holidayPay_Date && holidaypadates[1].holidayPay_Date.AddDays(6) >= hdates.holidayPay_Date ? hdates.Amount : decimal.Parse(String.Format("{0:0.00}", 0.00));
                        hpCont.WAGES3 = holidaypadates[2].holidayPay_Date <= hdates.holidayPay_Date && holidaypadates[2].holidayPay_Date.AddDays(6) >= hdates.holidayPay_Date ? hdates.Amount : decimal.Parse(String.Format("{0:0.00}", 0.00));
                        hpCont.WAGES4 = holidaypadates[3].holidayPay_Date <= hdates.holidayPay_Date && holidaypadates[3].holidayPay_Date.AddDays(6) >= hdates.holidayPay_Date ? hdates.Amount : decimal.Parse(String.Format("{0:0.00}", 0.00));
                        hpCont.WAGES5 = holidaypadates.Count == 5 ? holidaypadates[4].holidayPay_Date <= hdates.holidayPay_Date && holidaypadates[4].holidayPay_Date.AddDays(6) >= hdates.holidayPay_Date ? hdates.Amount : decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", 0.00));

                        hpContdates.Add(hpCont);
                    }

                    if (hpContdates.Count > 0)
                    {
                        Employee_holidpd_list1 hpayt = new Employee_holidpd_list1();
                        string m_name = null;
                        hpayt.Month = null;
                        hpayt.WAGES1 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                        hpayt.WAGES2 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                        hpayt.WAGES3 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                        hpayt.WAGES4 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                        hpayt.WAGES5 = decimal.Parse(String.Format("{0:0.00}", 0.00));

                        for (int i = 0; i < hpContdates.Count; i++)
                        {
                            m_name = m_name == null ? hpContdates[i].Month : m_name;
                            if (m_name == hpContdates[i].Month)
                            {
                                hpayt.Month = hpContdates[i].Month;
                                hpayt.WAGES1 = hpayt.WAGES1 == 0 ? Math.Round((decimal)(hpContdates[i].WAGES1), 2) : hpayt.WAGES1;
                                hpayt.WAGES2 = hpayt.WAGES2 == 0 ? Math.Round((decimal)(hpContdates[i].WAGES2), 2) : hpayt.WAGES2;
                                hpayt.WAGES3 = hpayt.WAGES3 == 0 ? Math.Round((decimal)(hpContdates[i].WAGES3), 2) : hpayt.WAGES3;
                                hpayt.WAGES4 = hpayt.WAGES4 == 0 ? Math.Round((decimal)(hpContdates[i].WAGES4), 2) : hpayt.WAGES4;
                                hpayt.WAGES5 = hpayt.WAGES5 == 0 ? Math.Round((decimal)(hpContdates[i].WAGES5), 2) : hpayt.WAGES5;
                                hpayt.visabile = InfoHpd.isHpay ? "Visible" : "Hidden";
                                hpayt.isHpay = InfoHpd.isHpay;
                            }
                            else
                            {
                                employeeHolidayPayDatesList.Add(hpayt);
                                hpayt = new Employee_holidpd_list1();
                                hpayt.WAGES1 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                hpayt.WAGES2 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                hpayt.WAGES3 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                hpayt.WAGES4 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                hpayt.WAGES5 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                m_name = hpContdates[i].Month;
                                hpayt.Month = hpContdates[i].Month;
                                hpayt.WAGES1 = hpayt.WAGES1 == 0 ? Math.Round((decimal)(hpContdates[i].WAGES1), 2) : hpayt.WAGES1;
                                hpayt.WAGES2 = hpayt.WAGES2 == 0 ? Math.Round((decimal)(hpContdates[i].WAGES2), 2) : hpayt.WAGES2;
                                hpayt.WAGES3 = hpayt.WAGES3 == 0 ? Math.Round((decimal)(hpContdates[i].WAGES3), 2) : hpayt.WAGES3;
                                hpayt.WAGES4 = hpayt.WAGES4 == 0 ? Math.Round((decimal)(hpContdates[i].WAGES4), 2) : hpayt.WAGES4;
                                hpayt.WAGES5 = hpayt.WAGES5 == 0 ? Math.Round((decimal)(hpContdates[i].WAGES5), 2) : hpayt.WAGES5;
                                hpayt.isHpay = InfoHpd.isHpay;
                                hpayt.visabile = InfoHpd.isHpay ? "Visible" : "Hidden";
                            }
                            if (hpContdates.Count == i + 1)
                            {
                                employeeHolidayPayDatesList.Add(hpayt);
                            }

                        }



                    }
                }
                Result.employeeHolidayPayDatesList = employeeHolidayPayDatesList;
                Result.employeeHolidayPayList = employeeHolidayPayList;

                if (employeeHolidayPayList.Any())
                {
                    return Ok(new ResponseModel
                    {
                        Status = true,
                        Message = "Data fatch Successfully.",
                        Statuscode = 200,
                        Data = Result
                    });
                }
                else
                {
                    return Ok(new ResponseModel
                    {
                        Status = false,
                        Message = "No holiday pay details found.",
                        Statuscode = 404
                    });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return BadRequest(new ResponseModel
                {
                    Status = false,
                    Message = ex.Message,
                    Statuscode = 400
                });
            }
        }


        [HttpGet]
        [Route("check_C3Created")]
        public async Task<IActionResult> CheckC3Created(int Year, int Month, int CompanyId)
        {
            try
            {
                using (SqlConnection staticConnectionsave = C3WizardLayerConn_BaseData.StaticSqlConnection)
                using (SqlCommand cmdsave = new SqlCommand("check_C3Created", staticConnectionsave))
                {
                    cmdsave.CommandType = CommandType.StoredProcedure;
                    cmdsave.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50) { Value = (object)Month ?? DBNull.Value });
                    cmdsave.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50) { Value = (object)Year ?? DBNull.Value });
                    cmdsave.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50) { Value = (object)CompanyId ?? DBNull.Value });

                    using (SqlDataAdapter sqlAdaptersave = new SqlDataAdapter(cmdsave))
                    {
                        DataTable dtsave = new DataTable();
                        sqlAdaptersave.Fill(dtsave);

                        if (dtsave.Rows.Count > 0)
                        {
                            int c3Hid = (int)dtsave.Rows[0]["C3HEADERID"];

                            return Ok(new ResponseModel
                            {
                                Status = true,
                                Data = c3Hid,
                                Message = $"A C3 for the month {_C3.MonthName(Month)} {Year} has already been created. Overwriting it will replace the existing C3. Would you like to proceed?",
                                Statuscode = 200
                            });
                        }
                        else
                        {
                            return Ok(new ResponseModel
                            {
                                Status = false,
                                Message = "No C3 record found for the given month and year.",
                                Statuscode = 200
                            });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return BadRequest(new ResponseModel
                {
                    Status = false,
                    Message = ex.Message,
                    Statuscode = 400
                });
            }
        }
