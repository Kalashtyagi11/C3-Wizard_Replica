        private ResponseModel Save_Wages(C3EmployeeVM c3EmployeeVM)
        {

            ResponseModel response = new ResponseModel();
            string emp = c3EmployeeVM.SocSecNum + "(" + c3EmployeeVM.LastName + " " + c3EmployeeVM.FirstName + ")";
            int employeeid = int.Parse(emp.Substring(0, 6));

            string ssno = emp.Substring(0, 6);
            int HPid;

            int monthno = ((DateTime)(c3EmployeeVM.Wagespaydate)).Month;
            string value = ((DateTime)(c3EmployeeVM.Wagespaydate)).Year.ToString();
            string OtHpayTvalue = "Director Wages";
            string Mvalue = ((DateTime)(c3EmployeeVM.Wagespaydate)).Month.ToString();
            int daysin_month = DateTime.DaysInMonth(int.Parse(value), monthno);
            string monthval = monthno <= 9 ? "0" + monthno.ToString() : monthno.ToString();
            DateTime Today_date = DateTime.ParseExact(("01/" + monthval + "/" + value), Helper.DateFormat, CultureInfo.InvariantCulture);
            DateTime? Todaydate = DateTime.ParseExact(("01/" + monthval + "/" + value), Helper.DateFormat, CultureInfo.InvariantCulture);


            List<Holiday_Pay_Dates> days_list = new List<Holiday_Pay_Dates>();
            Holiday_Pay_Dates HPD = new Holiday_Pay_Dates();
            HPD.S_No = 1;
            HPD.holidayPay_Date = ((DateTime)c3EmployeeVM.Wagespaydate);
            HPD.hodayPay_Date = ((DateTime)c3EmployeeVM.Wagespaydate).ToString(Helper.DisplayDateFormat);
            HPD.Amount = Math.Round(Convert.ToDecimal(c3EmployeeVM.wagesAmount), 2);
            days_list.Add(HPD);
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            SqlCommand cmd = new SqlCommand("Holiday_Pay_Insert_One", staticConnection);
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add(new SqlParameter("@From_Date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(DateTime)Todaydate ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@To_Date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)((DateTime)Todaydate).AddDays(daysin_month - 1) ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@Amount", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(Math.Round((Convert.ToDecimal(c3EmployeeVM.wagesAmount)

                ), 2)) ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@EmployeeId", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)employeeid ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)c3EmployeeVM.companyid ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@PayNoOfTimes", SqlDbType.Int, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)days_list.Count ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@EmployeeDetails", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@insertedon", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@updateon", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@IsWithoutLeave", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)false ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@PERIODD_MONTH", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)monthno ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@PERIOD_YEAR", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)value ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@otherHpaydes", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)OtHpayTvalue ?? (object)DBNull.Value));
            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
            DataTable dt = new DataTable();
            sqlAdapter.Fill(dt);
            staticConnection.Close();
            if (dt.Rows.Count > 0)
            {
                HPid = (int)dt.Rows[0].ItemArray[0];
                for (int i = 0; i < days_list.Count; i++)
                {
                    SqlCommand cmddates = new SqlCommand("Holiday_Pay_Dates_Insert_One", staticConnection);
                    cmddates.CommandType = CommandType.StoredProcedure;
                    cmddates.Parameters.Add(new SqlParameter("@HolidayPayId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)HPid ?? (object)DBNull.Value));
                    cmddates.Parameters.Add(new SqlParameter("@EmployeeId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)employeeid ?? (object)DBNull.Value));
                    cmddates.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)c3EmployeeVM.companyid ?? (object)DBNull.Value));
                    cmddates.Parameters.Add(new SqlParameter("@Amount", SqlDbType.Decimal, 9, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(Math.Round((days_list[i].Amount), 2)) ?? (object)DBNull.Value));
                    cmddates.Parameters.Add(new SqlParameter("@HolidayPayDate", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(DateTime)days_list[i].holidayPay_Date ?? (object)DBNull.Value));
                    SqlDataAdapter sqlAdapterDates = new SqlDataAdapter(cmddates);
                    DataTable dtdates = new DataTable();
                    sqlAdapterDates.Fill(dtdates);
                }

                //return;
            }
            else
            {
                response.Message = "Record already exist for these dates!";
                response.Statuscode = 409;
                response.Status = false;
                return response;
            }
            return response;
        }

        /// <summary>
        /// This method retrieves all employee.
        /// </summary>
        /// <returns>A list of employer .</returns>
        /// 
        [AllowAnonymous]
        [HttpGet("GetAllEmployee")]
        public async Task<ResponseModel> GetAllEmployee(int CompanyId)
        {
            ResponseModel response = new ResponseModel();
            try
            {
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                SqlCommand cmd = new SqlCommand("Holiday_Pay_Employee_Select_All", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                DataTable dthpy = new DataTable();
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                sqlAdapter.Fill(dthpy);

                DataTable dtcecontribution = new DataTable();
                DataSet dataSetC3C = new DataSet();
                DataTable dtC3C = new DataTable();
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                SqlCommand cmdC3C = new SqlCommand("select Distinct PC.SSN from Process_Contributions PC inner join PROCESS_C3Header Ph on PC.C3HEADERID=Ph.C3HEADERID where Ph.ForDirector!=1 AND ph.EmployerID =" + CompanyId, staticConnection);
                cmdC3C.CommandType = CommandType.Text;
                SqlDataAdapter adapterHPD = new SqlDataAdapter();
                adapterHPD.SelectCommand = cmdC3C;
                adapterHPD.Fill(dataSetC3C);
                dtC3C = dataSetC3C.Tables[0];
                staticConnection.Close();

                SqlCommand cmdBonus = new SqlCommand("Wages_Bonus_PayDetail_Employee_Select_All", staticConnection);
                cmdBonus.CommandType = CommandType.StoredProcedure;
                cmdBonus.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                DataTable dtBonus = new DataTable();
                SqlDataAdapter sqlAdapterBonus = new SqlDataAdapter(cmdBonus);
                sqlAdapter.Fill(dtBonus);

                List<BLMasterEmployee> employeelist = new List<BLMasterEmployee>();
                List<BLMasterEmployee> Viewemployeelist = new List<BLMasterEmployee>();
                employeelist = BLMasterEmployee.MasterEmployeeCollection_grid(CompanyId).ToList();
                foreach (var emp in employeelist)
                {
                    emp.Candelete = true;
                    if (dthpy.Rows.Count > 0)
                    {
                        DataRow[] DRHay = dthpy.Select("employeeID = " + emp.EmployeeID);
                        if (DRHay.Length > 0)
                        {
                            emp.Candelete = false;
                            emp.IsHpayAdded = true;
                        }
                    }
                    if (dtC3C.Rows.Count > 0)
                    {
                        DataRow[] DRC3C = dtC3C.Select("SSN = " + emp.SocSecNum);
                        if (DRC3C.Length > 0)
                        {
                            emp.IsC3Created = true;
                            emp.Candelete = false;
                        }
                        else
                        {
                            emp.IsC3Created = false;
                        }
                    }
                    else
                    {
                        emp.IsC3Created = false;
                    }
                    if (dtBonus.Rows.Count > 0)
                    {
                        DataRow[] DRdtBonus = dtBonus.Select("employeeID = " + emp.EmployeeID);
                        if (DRdtBonus.Length > 0)
                        {
                            emp.IsbonusAdded = true;
                            emp.Candelete = false;
                        }
                    }
                }
                var empllist = employeelist;
                if (empllist.Count > 0)
                {
                    response.Message = "Employee data retrieved successfully.";
                    response.Status = true;
                    response.Data = empllist;
                    response.Statuscode = 200;
                }
                else
                {
                    //dynamic[] emptyArray = new dynamic[0];
                    response.Message = "Employee data not found.";
                    response.Status = false;
                    response.Data = new dynamic[0];
                    response.Statuscode = 404;

                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                throw;
            }
            return response;
        }
        [AllowAnonymous]
        [HttpGet("GetAllEmployeePgn")]
        public async Task<ResponseModel> GetAllEmployeePgn(int CompanyId, int pageNumber, int pageSize)
        {
            if (pageNumber < 0) pageNumber = 0;
            if (pageSize < 1) pageSize = 10;

            ResponseModel response = new ResponseModel();
            try
            {
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                SqlCommand cmd = new SqlCommand("Holiday_Pay_Employee_Select_All", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                DataTable dthpy = new DataTable();
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                sqlAdapter.Fill(dthpy);

                DataTable dtcecontribution = new DataTable();
                DataSet dataSetC3C = new DataSet();
                DataTable dtC3C = new DataTable();
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                SqlCommand cmdC3C = new SqlCommand("select Distinct PC.SSN from Process_Contributions PC inner join PROCESS_C3Header Ph on PC.C3HEADERID=Ph.C3HEADERID where Ph.ForDirector!=1 AND ph.EmployerID =" + CompanyId, staticConnection);
                cmdC3C.CommandType = CommandType.Text;
                SqlDataAdapter adapterHPD = new SqlDataAdapter();
                adapterHPD.SelectCommand = cmdC3C;
                adapterHPD.Fill(dataSetC3C);
                dtC3C = dataSetC3C.Tables[0];
                staticConnection.Close();

                SqlCommand cmdBonus = new SqlCommand("Wages_Bonus_PayDetail_Employee_Select_All", staticConnection);
                cmdBonus.CommandType = CommandType.StoredProcedure;
                cmdBonus.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                DataTable dtBonus = new DataTable();
                SqlDataAdapter sqlAdapterBonus = new SqlDataAdapter(cmdBonus);
                sqlAdapter.Fill(dtBonus);

                List<BLMasterEmployee> employeelist = new List<BLMasterEmployee>();
                List<BLMasterEmployee> Viewemployeelist = new List<BLMasterEmployee>();
                employeelist = BLMasterEmployee.MasterEmployeeCollection_grid(CompanyId).ToList();
                foreach (var emp in employeelist)
                {
                    emp.Candelete = true;
                    if (dthpy.Rows.Count > 0)
                    {
                        DataRow[] DRHay = dthpy.Select("employeeID = " + emp.EmployeeID);
                        if (DRHay.Length > 0)
                        {
                            emp.Candelete = false;
                            emp.IsHpayAdded = true;
                        }
                    }
                    if (dtC3C.Rows.Count > 0)
                    {
                        DataRow[] DRC3C = dtC3C.Select("SSN = " + emp.SocSecNum);
                        if (DRC3C.Length > 0)
                        {
                            emp.IsC3Created = true;
                            emp.Candelete = false;
                        }
                        else
                        {
                            emp.IsC3Created = false;
                        }
                    }
                    else
                    {
                        emp.IsC3Created = false;
                    }
                    if (dtBonus.Rows.Count > 0)
                    {
                        DataRow[] DRdtBonus = dtBonus.Select("employeeID = " + emp.EmployeeID);
                        if (DRdtBonus.Length > 0)
                        {
                            emp.IsbonusAdded = true;
                            emp.Candelete = false;
                        }
                    }
                }
                var empllist = employeelist;

                int totalRecords = empllist.Count;
                int totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

                var pagedCompanies = empllist
               .Skip(pageNumber * pageSize)
               .Take(pageSize)
               .ToList();


                if (pagedCompanies.Any())
                {
                    response.Message = "Data retrieved successfully!";
                    response.Statuscode = 200;
                    response.Status = true;
                    response.Data = new
                    {
                        TotalRecords = totalRecords,
                        PageNumber = pageNumber,
                        PageSize = pageSize,
                        TotalPages = totalPages,
                        Records = pagedCompanies
                    };
                }
                else
                {
                    //dynamic[] emptyArray = new dynamic[0];
                    response.Message = "Employee data not found.";
                    response.Status = false;
                    response.Data = new dynamic[0];
                    response.Statuscode = 404;

                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                throw;
            }
            return response;
        }

        /// <summary>
        /// This method retrieves all employee.
        /// </summary>
        /// <returns>A list of employee .</returns>
        [HttpGet("GetEmployeeByid")]
        public async Task<ResponseModel> GetEmployeeByid(int Employeeid)
        {
            ResponseModel response = new ResponseModel();
            EmployeeEditVM c3Employee = new EmployeeEditVM();

            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            List<BLMasterEmployee> blempList = new List<BLMasterEmployee>();

            var blempList_ALL = BLMasterEmployee.MasterEmployeeCollection().ToList();

            blempList = blempList_ALL.Where(t => t.EmployeeID == Employeeid).ToList();
            Emplcode = blempList.ElementAt(0).EmplCode;
            if (blempList.Count == 1)
            {
                c3Employee.SocSecNum = Emplcode;
                c3Employee.SocSecNum = string.IsNullOrEmpty(blempList.ElementAt(0).SocSecNum) ? "" : blempList.ElementAt(0).SocSecNum.ToString();
                string ssn = string.IsNullOrEmpty(blempList.ElementAt(0).SocSecNum) ? "" : blempList.ElementAt(0).SocSecNum.ToString();

                c3Employee.LastName = string.IsNullOrEmpty(blempList.ElementAt(0).LastName) ? "" : blempList.ElementAt(0).LastName.ToString();
                c3Employee.FirstName = string.IsNullOrEmpty(blempList.ElementAt(0).FirstName) ? "" : blempList.ElementAt(0).FirstName.ToString();
                c3Employee.MiddleName = string.IsNullOrEmpty(blempList.ElementAt(0).MiddleName) ? "" : blempList.ElementAt(0).MiddleName.ToString();

                c3Employee.Address1 = string.IsNullOrEmpty(blempList.ElementAt(0).Address1) ? "" : blempList.ElementAt(0).Address1.ToString();
                c3Employee.Address2 = string.IsNullOrEmpty(blempList.ElementAt(0).Address2) ? "" : blempList.ElementAt(0).Address2.ToString();
                c3Employee.City = string.IsNullOrEmpty(blempList.ElementAt(0).City) ? "" : blempList.ElementAt(0).City.ToString();
                c3Employee.Zip = string.IsNullOrEmpty(blempList.ElementAt(0).Zip) ? "" : blempList.ElementAt(0).Zip.ToString();
                try
                {
                    c3Employee.Country = string.IsNullOrEmpty(blempList.ElementAt(0).Country) ? "" : blempList.ElementAt(0).Country.ToString();

                }
                catch (Exception ex)
                {
                    var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                    LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                    throw ex;
                }
                c3Employee.Email = string.IsNullOrEmpty(blempList.ElementAt(0).Email) ? "" : blempList.ElementAt(0).Email.ToString();
                c3Employee.Phone = string.IsNullOrEmpty(blempList.ElementAt(0).Phone) ? "" : blempList.ElementAt(0).Phone.ToString();
                c3Employee.Mobile = string.IsNullOrEmpty(blempList.ElementAt(0).Mobile) ? "" : blempList.ElementAt(0).Mobile.ToString();

                try
                {
                    c3Employee.BirthDate = blempList.ElementAt(0).BirthDate;
                    c3Employee.Terminated = blempList.ElementAt(0).Terminated;

                    c3Employee.Terminatedchecked = blempList.ElementAt(0).Terminated != null ? true : false;
                    //c3Employee.IsDirectorchecked = blempList.ElementAt(0).IsemployeeDirector;
                    c3Employee.isemployeeDirector = blempList.ElementAt(0).IsemployeeDirector;
                    c3Employee.amount = blempList.ElementAt(0).wage_Amt;
                    c3Employee.IsLevyExempt = blempList.ElementAt(0).IsLevyExempt;

                }
                catch (Exception ex)
                {
                    var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                    LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                    throw ex;
                }

                try
                {
                    string gender = string.IsNullOrEmpty(blempList.ElementAt(0).Gender) ? "" : blempList.ElementAt(0).Gender;
                    if (gender == "M") { c3Employee.rbmale = true; }
                    if (gender == "F") { c3Employee.rbmale = false; }
                }
                catch (Exception ex)
                {
                    var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                    LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                    throw ex;
                }

                try
                {
                    c3Employee.MaritalStat = string.IsNullOrEmpty(blempList.ElementAt(0).MaritalStat) ? "" : blempList.ElementAt(0).MaritalStat.ToString() == "S" ? "Single" : (blempList.ElementAt(0).MaritalStat.ToString() == "M" ? "Married" : "");
                }
                catch (Exception ex)
                {
                    var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                    LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                    throw ex;
                }
                try
                {
                    if (blempList.ElementAt(0).PayPeriod != null)
                    {
                        if (blempList.ElementAt(0).PayPeriod.ToString() == "W")
                            c3Employee.payPeriod = "Weekly";
                        if (blempList.ElementAt(0).PayPeriod.ToString() == "M")
                            c3Employee.payPeriod = "Monthly";
                        if (blempList.ElementAt(0).PayPeriod.ToString() == "E2W")
                            c3Employee.payPeriod = "Every Two Weeks";
                        if (blempList.ElementAt(0).PayPeriod.ToString() == "2M")
                            c3Employee.payPeriod = "Twice Monthly";
                        // cmbPayFreq.IsEnabled = false;l
                    }

                }
                catch (Exception ex)
                {
                    var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                    LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                    throw ex;
                }
                c3Employee.lastPayDate = blempList.ElementAt(0).LastIncDate;
                c3Employee.commencementDate = blempList.ElementAt(0).AppintDate;

                c3Employee.commencementDatechecked = blempList.ElementAt(0).AppintDate != null ? true : false;
                c3Employee.Occupation = blempList.ElementAt(0).occupation;
                c3Employee.Department = blempList.ElementAt(0).Department;
                List<BLMasterEmployeeIncomes> blempIncList = new List<BLMasterEmployeeIncomes>();
                var blempIncList_ALL = BLMasterEmployeeIncomes.MasterEmployeeIncomesCollection().ToList();
                blempIncList = blempIncList_ALL.Where(t => t.EmployeeID == Employeeid).ToList();

                if (blempIncList.Count == 1)
                {
                    //EmpIncomeID = Int32.Parse(blempIncList.ElementAt(0).EmpIncomeID.ToString());
                    c3Employee.incRate = (Math.Round((decimal)blempIncList.ElementAt(0).IncRate, 2)).ToString();

                }
                staticConnection.Close();
                var data = _context.HolidayPayDates.Where(x => x.EmployeeId == Convert.ToInt32(ssn)).FirstOrDefault();
                if (data != null)
                {
                    c3Employee.wagesAmount = data.Amount;
                    c3Employee.holidayPay_Date = data.HolidayPayDate1;
                    c3Employee.HolidayPayId = data.HolidayPayId;

                }
                if (c3Employee != null)
                {
                    c3Employee.EmployeeID = Employeeid;
                    response.Message = "Employee  retrieved successfully.";
                    response.Status = true;
                    response.Data = c3Employee;
                    response.Statuscode = 200;
                }
                else
                {
                    response.Message = "Data Not Found.";
                    response.Status = false;
                    response.Data = null;
                    response.Statuscode = 404;

                }
            }
            return response;

        }

        /// <summary>
        /// This method is used to Delete Employee data
        /// </summary>
        /// <param name="DeleteEmployee"></param>
        /// <returns></returns>
        //[HttpDelete("DeleteEmployee")]
        [HttpGet("DeleteEmployee")]
        public async Task<IActionResult> DeleteEmployee(int EmployeeId, bool? isc3created)
        {

            ResponseModel response = new ResponseModel();
            try
            {
                if (isc3created == true)
                {
                    response.Status = false;
                    response.Message = "You can not delete this employee as C3  exists for this employee!";
                    response.Statuscode = 409;
                    return Conflict(response);
                }
                //else
                //{
                BLMasterEmployee Employee_row = new BLMasterEmployee();
                Employee_row.EmployeeID = EmployeeId;
                Employee_row.Delete();

                response.Status = true;
                response.Message = "Employee deleted successfully.";
                response.Statuscode = 200;
                response.Data = Employee_row;
                //}

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                response.Message = ex.Message;
                response.Statuscode = 404;
            }
            return Ok(response);
        }


        /// <summary>
        /// This method is used SaveEmployeeHoliday
        /// </summary>
        /// <param name="c3EmployeeVM"></param>
        /// <returns></returns>
        [HttpPost("SaveEmployeeHoliday")]
        public async Task<ResponseModel> SaveEmployeeHoliday([FromBody] HolidayPayDatesVm holidayPay)
        {
            int CompanyId = Convert.ToInt32(holidayPay.CompanyId);
            int employeinmode = Convert.ToInt32(holidayPay.employeinmode);

            ResponseModel response = new ResponseModel();
            try
            {
                string emp = holidayPay.Emp_Name;
                int employeeid = int.Parse(emp.Substring(0, 6));

                string ssno = emp.Substring(0, 6);
                int HPid;
                List<BLMasterEmployee> emplist = BLMasterEmployee.MasterEmployeeCollection_grid(CompanyId).ToList();
                List<BLMasterEmployee> emplistinfo = emplist.Where(x => x.SocSecNum == ssno).ToList();
                if (holidayPay.HolidayPayWithLeave == true)
                {
                    emplist = emplist.Where(x => x.SocSecNum == ssno && (x.Terminated == null || x.Terminated >= holidayPay.from_date) && (x.AppintDate == null || x.AppintDate <= holidayPay.from_date)).ToList();
                    if (emplist.Count > 0)
                    {
                        bool isfinilaze = true;

                        List<Holiday_Pay_Dates> days_list = new List<Holiday_Pay_Dates>();
                        int Sno = 0;

                        DateTime sdate = (DateTime)holidayPay.from_date;
                        DateTime edate = ((DateTime)holidayPay.to_date);
                        TimeSpan ts = edate - sdate;
                        int count = (int)Math.Floor(ts.TotalDays / 7);
                        int remainder = (int)(ts.TotalDays % 7);
                        int sinceLastDay = (int)(((DateTime)sdate).DayOfWeek - 1);

                        for (DateTime date = sdate; date <= (DateTime)holidayPay.to_date; date = date.AddDays(1))
                        {
                            if (date.DayOfWeek == DayOfWeek.Monday)
                            {
                                Holiday_Pay_Dates HPD = new Holiday_Pay_Dates();
                                Sno++;
                                HPD.S_No = Sno;

                                HPD.holidayPay_Date = date;
                                HPD.hodayPay_Date = HPD.holidayPay_Date.ToString(Helper.DisplayDateFormat);
                                days_list.Add(HPD);
                            }
                        }
                        decimal totalweekamt = 0;
                        int rcount = 0;
                        if (days_list.Count > 0)
                        {
                            foreach (var row in days_list)
                            {
                                row.Amount = decimal.Parse(String.Format("{0:0.00}", Math.Truncate(100 * (Convert.ToDecimal(holidayPay.Amount) / days_list.Count)) / 100));
                                totalweekamt = totalweekamt + row.Amount;
                                rcount++;
                                if (rcount == days_list.Count)
                                {
                                    row.Amount = row.Amount + (Convert.ToDecimal(holidayPay.Amount) - totalweekamt);
                                }
                            }
                        }
                        else
                        {
                            Holiday_Pay_Dates HPD = new Holiday_Pay_Dates();
                            Sno++;
                            HPD.S_No = Sno;
                            HPD.Amount = Math.Round(Convert.ToDecimal(holidayPay.Amount), 2);
                            HPD.holidayPay_Date = sdate;
                            HPD.hodayPay_Date = HPD.holidayPay_Date.ToString(Helper.DisplayDateFormat);
                            days_list.Add(HPD);
                        }
                        SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                        if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                        SqlCommand cmd = new SqlCommand("Holiday_Pay_Insert_One", staticConnection);
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.Add(new SqlParameter("@From_Date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(DateTime)holidayPay.from_date ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@To_Date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(DateTime)holidayPay.to_date ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@Amount", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(Math.Round((Convert.ToDecimal(holidayPay.Amount)), 2)) ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@EmployeeId", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)employeeid ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@PayNoOfTimes", SqlDbType.Int, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)days_list.Count ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@EmployeeDetails", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)holidayPay.Emp_Name ?? (object)DBNull.Value));
                        cmd.Parameters.Add(new SqlParameter("@insertedon", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
