                                                //emp.WAGES1 += w1_hpay;
                                                //emp.WAGES2 += w2_hpay;
                                                //emp.WAGES3 += w3_hpay;
                                                //emp.WAGES4 += isWeekfifth ? w4_hpay : (w4_hpay + w5_hpay);
                                                //emp.WAGES5 += isWeekfifth ? w5_hpay : 0;
                                                emp.WAGES1 = decimal.Parse(String.Format("{0:0.00}", (emp.WAGES1)));
                                                emp.WAGES2 = false ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES2))) : decimal.Parse(String.Format("{0:0.00}", (emp.WAGES2 + w1_hpay + w2_hpay)));
                                                emp.WAGES3 = decimal.Parse(String.Format("{0:0.00}", (emp.WAGES3)));
                                                emp.WAGES4 = false ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES4))) : isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES4 + w3_hpay + w4_hpay + w5_hpay))) : decimal.Parse(String.Format("{0:0.00}", (emp.WAGES4 + w3_hpay + w4_hpay)));
                                                emp.WAGES5 = isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES5))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                                                if (emp.C3HEADERID == 0)
                                                {
                                                    emp.emp_add_remove = false;

                                                    emp.WAGES1 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                                    emp.WAGES2 = /*IsWithleaveHpay*/false ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES2"].ToString()))) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES2"].ToString()) + w1_hpay + w2_hpay));
                                                    emp.WAGES3 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                                    emp.WAGES4 = /*IsWithleaveHpay*/false ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES4"].ToString()))) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES4"].ToString()) + w3_hpay + w4_hpay + w5_hpay));
                                                    emp.WAGES5 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                                }
                                                emp.HPay_Week1 = w1_hpay;
                                                emp.HPay_Week2 = w2_hpay;
                                                emp.HPay_Week3 = w3_hpay;
                                                emp.HPay_Week4 = w4_hpay;
                                                emp.HPay_Week5 = w5_hpay;
                                                emp.PayPeriod = "2M - Twice Monthly";
                                                break;
                                            case "S":
                                                //emp.WAGES1 += w1_hpay;
                                                //emp.WAGES2 += w2_hpay;
                                                //emp.WAGES3 += w3_hpay;
                                                //emp.WAGES4 += isWeekfifth ? w4_hpay : (w4_hpay + w5_hpay);
                                                //emp.WAGES5 += isWeekfifth ? w5_hpay : 0;
                                                emp.WAGES1 = decimal.Parse(String.Format("{0:0.00}", (emp.WAGES1)));
                                                emp.WAGES2 = false ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES2))) : decimal.Parse(String.Format("{0:0.00}", (emp.WAGES2 + w1_hpay + w2_hpay)));
                                                emp.WAGES3 = decimal.Parse(String.Format("{0:0.00}", (emp.WAGES3)));
                                                emp.WAGES4 = false ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES4))) : isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES4 + w3_hpay + w4_hpay + w5_hpay))) : decimal.Parse(String.Format("{0:0.00}", (emp.WAGES4 + w3_hpay + w4_hpay)));
                                                emp.WAGES5 = isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES5))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                                                if (emp.C3HEADERID == 0)
                                                {
                                                    emp.emp_add_remove = false;

                                                    emp.WAGES1 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                                    emp.WAGES2 = /*IsWithleaveHpay*/false ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES2"].ToString()))) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES2"].ToString()) + w1_hpay + w2_hpay));
                                                    emp.WAGES3 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                                    emp.WAGES4 = /*IsWithleaveHpay*/false ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES4"].ToString()))) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES4"].ToString()) + w3_hpay + w4_hpay + w5_hpay));
                                                    emp.WAGES5 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                                }

                                                emp.HPay_Week1 = w1_hpay;
                                                emp.HPay_Week2 = w2_hpay;
                                                emp.HPay_Week3 = w3_hpay;
                                                emp.HPay_Week4 = w4_hpay;
                                                emp.HPay_Week5 = w5_hpay;
                                                break;
                                                // Add other cases ("E2W", "B", "M", "2M", "S") as needed...
                                        }
                                        // (You may also compute remarks and additional fields here.)                 
                                        // decimal total_OtherDirWagespay = total_hpay > 0 ? OtherDirWagespay(todayDate, emp.SSN, yearValue, monthIndex, CompanyId) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                                        string OtHpayType = total_hpay > 0 ? _C3.OtherHpayType(todayDate, emp.SSN, yearValue, monthIndex, obj.CompanyId) : string.Empty;
                                        decimal total_Otherpay = total_hpay > 0 ? _C3.Otherpay(todayDate, emp.SSN, yearValue, monthIndex, obj.CompanyId) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                                        decimal total_OtherDirWagespay = total_hpay > 0 ? _C3.OtherDirWagespay(todayDate, emp.SSN, yearValue, monthIndex, obj.CompanyId) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                                        emp.BONUS = decimal.Parse(String.Format("{0:0.00}", _C3.LoadBonus(todayDate, emp.SSN, yearValue, monthIndex, obj.CompanyId)));

                                        //emp.Remarks = total_hpay > 0
                                        //              ? $"h/p {total_hpay} ({todayDate.ToString(Helper.DateFormat)}-{holidayPayDates.Last().holidayPay_Date.ToString(Helper.DateFormat)})"
                                        //              : string.Empty;

                                        //A/ string hpremarks = total_hpay - (total_Otherpay + total_OtherDirWagespay) > 0 ? "h/p " + (total_hpay - (total_Otherpay + total_OtherDirWagespay)) + " (" + ((DateTime)todayDate).ToString(Helper.DateFormat) + "-" + (holidayPayDates.Last().holidayPay_Date).ToString(Helper.DateFormat) + ") " : string.Empty;
                                        string hpremarks = total_hpay - (total_Otherpay + total_OtherDirWagespay) > 0 ? "h/p " + (total_hpay - (total_Otherpay + total_OtherDirWagespay)) + " " + string.Join(" - ", holidayPaydateNew.GroupBy(h => h.HolidayPayId).Select(g => "(" + g.Min(x => x.StartDate)?.ToString(Helper.DateFormat) + "-" + g.Max(x => x.EndDate)?.ToString(Helper.DateFormat) + ")")) : string.Empty;

                                        string otherremark = (total_Otherpay + total_OtherDirWagespay) > 0 ? "Other " + OtHpayType : string.Empty;
                                        emp.Remarks = total_hpay > 0 ? (total_hpay - (total_Otherpay + total_OtherDirWagespay)) > 0 ? hpremarks + " " + otherremark : otherremark : string.Empty;
                                        emp.DirectorWagesPAY = decimal.Parse(String.Format("{0:0.00}", total_OtherDirWagespay));
                                        emp.IsHPAY = emp.Remarks.Contains("h/p") ? "#FF288B01" : "#D3D3D3";
                                        emp.Remarks += emp.wage_Amt > 0 ? "Dir Wages  " + emp.wage_Amt : string.Empty;
                                        emp.Remarks += emp.BONUS > 0 ? " Bonus  " + emp.BONUS : string.Empty;
                                        emp.IsRemarkDisable = emp.Remarks == string.Empty ? true : false;
                                        // obj.Remarks = obj.Remarks == string.Empty ? row["Remarks"].ToString() : obj.Remarks;
                                        emp.DirRemarks = emp.wage_Amt > 0 ? "Dir Wages  " + emp.wage_Amt : string.Empty;
                                        emp.IsWeekfifth = isWeekfifth;
                                        emp.IsemployeeDirector = (bool)row["IsemployeeDirector"];
                                        emp.IsLevyExempt = (bool)row["IsLevyExempt"];// == null ? false : (bool)row["IsLevyExempt"];
                                        emp.emp_add_remove = true;//A/(bool)row["emp_add_remove"];
                                        emp.BirthDate = ((DateTime)row["BirthDate"]).ToString(Helper.SQLDateFormat);
                                        emp.Department = row["department"].ToString();
                                        allEmployeeList.Add(emp);
                                    }

                                }
                            }
                        }
                    }
                    await staticConnection.CloseAsync();
                }

                allEmployeeList = allEmployeeList.Where(x => (x.Date_terminated == null || Convert.ToDateTime(x.Date_terminated) >= todayDate) && (x.Date_Joining == null || Convert.ToDateTime(x.Date_Joining) <= end_date)).ToList();


                List<C3Contributions> zeroC3HEADERID = null;

                if (obj.isNilReturn == null && !headerDetails.isNilReturn)
                {
                    if (obj.popUpList == null)
                    {
                        zeroC3HEADERID = new List<C3Contributions>();
                        zeroC3HEADERID = allEmployeeList.Where(e => e.C3HEADERID == 0).ToList();

                        allEmployeeList.RemoveAll(e => e.C3HEADERID == 0);
                    }
                    else
                    {
                        allEmployeeList.RemoveAll(e => obj?.popUpList?.Contains(e.SSN) ?? true);
                        //allEmployeeList.ForEach(r => r.emp_add_remove = true);
                        // allEmployeeList.Where(d => d.C3HEADERID==0).ToList().ForEach(r => r.C3HEADERID = obj.headerId);
                    }
                }
                else if (obj.isNilReturn == null && headerDetails.isNilReturn)
                {
                    allEmployeeList = new List<C3Contributions>();
                }
                else
                {
                    if (obj.isNilReturn == true)
                    {
                        zeroC3HEADERID = null;
                        allEmployeeList = new List<C3Contributions>();
                    }
                    else if (obj.isNilReturn == false)
                    {
                        //zeroC3HEADERID = new List<C3Contributions>();
                        zeroC3HEADERID = allEmployeeList.Where(e => e.C3HEADERID == 0).ToList();
                        if (allEmployeeList.Count == zeroC3HEADERID.Count)
                        {

                        }
                        else
                        {
                            allEmployeeList.RemoveAll(e => e.C3HEADERID == 0);
                        }

                    }
                }



                // Optionally, you could group or sort the employees as in the UI code.
                if (allEmployeeList.Count > 0)
                {
                    //var data = ResultReportJson.Listc3ReportViewModel.GroupBy(x => x.PayPeriod);
                    if (headerDetails.OrderName == "employeeName")
                    {
                        var data = allEmployeeList.GroupBy(x => x.PayPeriod)
                                  .Select(group => new
                                  {
                                      PayPeriod = group.Key,
                                      Employees = headerDetails.OrderKey == "asc" ? group.OrderBy(x => x.PayPeriod).ThenBy(x => x.EmployeeName).ToList()
                                          : group.OrderBy(x => x.PayPeriod).OrderByDescending(x => x.EmployeeName).ToList()
                                  }).OrderBy(x => x.PayPeriod).ToList();

                        allEmployeeList = data.SelectMany(g => g.Employees).ToList();
                    }
                    if (headerDetails.OrderName == "ssn")
                    {
                        var data = allEmployeeList.GroupBy(x => x.PayPeriod)
                                  .Select(group => new
                                  {
                                      PayPeriod = group.Key,
                                      Employees = headerDetails.OrderKey == "asc" ? group.OrderBy(x => x.PayPeriod).ThenBy(x => x.SSN).ToList()
                                          : group.OrderByDescending(x => x.SSN).ToList()
                                  }).OrderBy(x => x.PayPeriod).ToList();

                        allEmployeeList = data.SelectMany(g => g.Employees).ToList();
                    }
                }
                if (allEmployeeList.Count > 0 && string.IsNullOrWhiteSpace(headerDetails.OrderName))
                {
                    var data = allEmployeeList.GroupBy(x => x.PayPeriod)
                              .OrderBy(g => g.Key)
                              .Select(group => new
                              {
                                  PayPeriod = group.Key,
                                  Employees = group.ToList()
                              })
                              .ToList();

                    allEmployeeList = data.SelectMany(g => g.Employees).ToList();
                }
                var responseData = new
                {
                    Header = headerDetails,
                    isNilReturn = obj.isNilReturn == null ? headerDetails.isNilReturn : obj.isNilReturn,
                    Employees = allEmployeeList,
                    popUpList = zeroC3HEADERID
                };


                return Ok(new ResponseModel
                {
                    Status = true,
                    Message = "Data fetched successfully.",
                    Data = responseData,
                    Statuscode = 200
                });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = "An error occurred: " + ex.Message,
                    Data = null,
                    Statuscode = 500
                });
            }
        }


        [HttpPost("DeleteC3LocalAndSSB")]
        public async Task<IActionResult> DeleteC3LocalAndSSB([FromBody] submitC3bulk deletec3, int headerid, int payerId, int year, int month, int scheduleno, int userId, int companyId)
        {
            try
            {

                ResponseModel response = await _C3.DeleteC3LocalAndSSB(deletec3, headerid, payerId, year, month, scheduleno, userId, companyId);

                if ((bool)!response.Status)
                {
                    return Ok(response);
                }


                using (SqlConnection connection = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString))
                {
                    await connection.OpenAsync();

                    using (SqlCommand cmdDelete = new SqlCommand("C3Header_Delete", connection))
                    {
                        cmdDelete.CommandType = CommandType.StoredProcedure;
                        cmdDelete.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int) { Value = deletec3.c3Header });

                        int rowsAffected = await cmdDelete.ExecuteNonQueryAsync();

                        if (rowsAffected > 0)
                        {
                            return Ok(new ResponseModel
                            {
                                Status = true,
                                Message = "C3 deleted successfully.",
                                Data = "",
                                Statuscode = 200
                            });
                        }
                        else
                        {
                            return Ok(new ResponseModel
                            {
                                Status = false,
                                Message = "Deletion failed. No rows affected.",
                                Data = "",
                                Statuscode = 500
                            });
                        }
                    }
                }
            }
            catch (SqlException ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = "A database error occurred.",
                    Data = ex.Message,
                    Statuscode = 500
                });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = "An unexpected error occurred.",
                    Data = ex.Message,
                    Statuscode = 500
                });
            }
        }



        [HttpGet("DeleteC3")]
        public async Task<IActionResult> DeleteC3(int headerId)
        {
            try
            {
                var isSubmitted = _context.ProcessC3headers.FirstOrDefault(p => p.C3headerid == headerId);
                if ((isSubmitted?.IsSubmitted ?? false) || (isSubmitted?.IsSentForEdit ?? false))
                {
                    return Ok(new ResponseModel
                    {
                        Status = true,  // Indicate success
                        Message = "Deletion is not allowed as this record has already been submitted for SSB.",
                        Data = "",
                        Statuscode = 200
                    });
                }
                using (SqlConnection connection = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString))
                {
                    await connection.OpenAsync();

                    using (SqlCommand cmdDelete = new SqlCommand("C3Header_Delete", connection))
                    {
                        cmdDelete.CommandType = CommandType.StoredProcedure;
                        cmdDelete.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int) { Value = headerId });
                        int rowsAffected = await cmdDelete.ExecuteNonQueryAsync();
                        await connection.CloseAsync();
                        if (rowsAffected > 0)
                        {
                            return Ok(new ResponseModel
                            {
                                Status = true,  // Indicate success
                                Message = "C3 deleted successfully",
                                Data = "",
                                Statuscode = 200
                            });
                        }
                        else
                        {
                            return Ok(new ResponseModel
                            {
                                Status = false,  // Indicate success
                                Message = "Deletion failed; no rows affected.",
                                Data = "",
                                Statuscode = 500
                            });

                        }
                    }
                }
            }
            catch (SqlException ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel
                {
                    Status = false,  // Indicate success
                    Message = ex.Message,
                    Data = "A database connection error occurred. Please check the server configuration and try again.",
                    Statuscode = 500
                });
            }
            catch (Exception ex)
            {
                return Ok(new ResponseModel
                {
                    Status = false,  // Indicate success
                    Message = ex.Message,
                    Data = "An unexpected error occurred.",
                    Statuscode = 500
                });
            }
        }
        [HttpGet("C3Report/DownloadPdf")]
        public async Task<IActionResult> DownloadC3Pdf(string monthName, string year, int companyId, int c3HeaderId, bool ispaid, bool isDraft)
        {
            try
            {

                // Step 1: Get report data (same logic as your current GetC3Report)
                var reportItems = new List<C3ReportsViewModel>();
                using (SqlConnection con = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString))
                {
                    using (SqlCommand cmd = new SqlCommand("Generate_C3_Report", con))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@Month", _C3.MonthNumber(monthName));
                        cmd.Parameters.AddWithValue("@Year", year);
                        cmd.Parameters.AddWithValue("@CompanyId", companyId);
                        cmd.Parameters.AddWithValue("@C3HEADERID", c3HeaderId);

                        await con.OpenAsync();
                        using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                        {
                            int rowNumber = 1;
                            while (await reader.ReadAsync())
                            {

                                var reportItem = new C3ReportsViewModel
                                {
                                    //row_no = reader["row_no"] != DBNull.Value ? Convert.ToInt32(reader["row_no"]) : 0,
                                    row_no = rowNumber,
                                    company_name = reader["company_name"]?.ToString(),
                                    trade_name = reader["trade_name"]?.ToString(),
                                    company_address = reader["company_address"]?.ToString(),
                                    OrderName = reader["OrderName"]?.ToString(),
                                    OrderKey = reader["OrderKey"]?.ToString(),
                                    company_reg_no = reader["company_reg_no"]?.ToString(),
                                    no_of_employee = reader["no_of_employee"] != DBNull.Value ? Convert.ToInt32(reader["no_of_employee"]) : 0,
                                    current_month = reader["current_month"]?.ToString(),
                                    social_security_no = reader["social_security_no"]?.ToString(),
                                    emp_name = reader["emp_name"]?.ToString(),
                                    Appint_Date = reader["Appint_Date"]?.ToString(),
                                    Column4 = reader["Column4"]?.ToString(),
                                    pay_period = reader["pay_period"]?.ToString(),
                                    first_week_of_month = reader["first_week_of_month"]?.ToString(),
                                    second_week_of_month = reader["second_week_of_month"]?.ToString(),
                                    third_week_of_month = reader["third_week_of_month"]?.ToString(),
                                    four_week_of_month = reader["four_week_of_month"]?.ToString(),
                                    five_week_of_month = reader["five_week_of_month"]?.ToString(),
                                    first_week_of_salary = reader["first_week_of_salary"] != DBNull.Value ? Convert.ToDecimal(reader["first_week_of_salary"]) : (decimal?)null,
                                    second_week_of_salary = reader["second_week_of_salary"] != DBNull.Value ? Convert.ToDecimal(reader["second_week_of_salary"]) : (decimal?)null,
                                    third_week_of_salary = reader["third_week_of_salary"] != DBNull.Value ? Convert.ToDecimal(reader["third_week_of_salary"]) : (decimal?)null,
                                    four_week_of_salary = reader["four_week_of_salary"] != DBNull.Value ? Convert.ToDecimal(reader["four_week_of_salary"]) : (decimal?)null,
                                    five_week_of_salary = reader["five_week_of_salary"] != DBNull.Value ? Convert.ToDecimal(reader["five_week_of_salary"]) : (decimal?)null,
                                    Column2 = reader["Column2"] != DBNull.Value ? Convert.ToDecimal(reader["Column2"]) : 0,
                                    Column1 = reader["Column1"] != DBNull.Value ? Convert.ToDecimal(reader["Column1"]) : 0,
                                    total_wages = reader["total_wages"] != DBNull.Value ? Convert.ToDecimal(reader["total_wages"]) : 0,
                                    deduct_leavy_wages = reader["deduct_leavy_wages"] != DBNull.Value ? Convert.ToDecimal(reader["deduct_leavy_wages"]) : 0,
                                    total_soc_sec = reader["total_soc_sec"] != DBNull.Value ? Convert.ToDecimal(reader["total_soc_sec"]) : 0,
                                    SERVAYANCE = reader["SERVAYANCE"] != DBNull.Value ? Convert.ToDecimal(reader["SERVAYANCE"]) : 0,
                                    SERVAYANCE_PEPENALTY = reader["SERVAYANCE_PEPENALTY"] != DBNull.Value ? Convert.ToDecimal(reader["SERVAYANCE_PEPENALTY"]) : 0,
                                    TOTAL_LEVYEEPENALTY = reader["TOTAL_LEVYEEPENALTY"] != DBNull.Value ? Convert.ToDecimal(reader["TOTAL_LEVYEEPENALTY"]) : 0,
                                    TOTAL_SSPENALTY = reader["TOTAL_SSPENALTY"] != DBNull.Value ? Convert.ToDecimal(reader["TOTAL_SSPENALTY"]) : 0,
                                    remarks = reader["remarks"]?.ToString(),
                                    Column3 = reader["Column3"] != DBNull.Value ? Convert.ToDecimal(reader["Column3"]) : 0,
                                    HPay_Week1 = reader["HPay_Week1"] != DBNull.Value ? Convert.ToDecimal(reader["HPay_Week1"]) : 0,
                                    HPay_Week2 = reader["HPay_Week2"] != DBNull.Value ? Convert.ToDecimal(reader["HPay_Week2"]) : 0,
                                    HPay_Week3 = reader["HPay_Week3"] != DBNull.Value ? Convert.ToDecimal(reader["HPay_Week3"]) : 0,
                                    HPay_Week4 = reader["HPay_Week4"] != DBNull.Value ? Convert.ToDecimal(reader["HPay_Week4"]) : 0,
                                    HPay_Week5 = reader["HPay_Week5"] != DBNull.Value ? Convert.ToDecimal(reader["HPay_Week5"]) : 0,
                                };
                                rowNumber++;
                                reportItems.Add(reportItem);
                            }
                        }
                        await con.CloseAsync();
                    }
                }

                // Step 2: Convert list to DataTable
                DataTable dt = new DataTable();
                var props = typeof(C3ReportsViewModel).GetProperties();
                foreach (var prop in props)
                {
                    dt.Columns.Add(prop.Name, Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType);
                }
                foreach (var item in reportItems)
                {
                    var row = dt.NewRow();
                    foreach (var prop in props)
                    {
                        row[prop.Name] = prop.GetValue(item) ?? DBNull.Value;
                    }
                    dt.Rows.Add(row);
                }


                string rdlcFile = reportItems.Count <= 5 ? "EmployeeC3Report.rdlc" : "EmployeeC3more5Report.rdlc";
                // string rdlcFile = reportItems.Count <= 5 ? "EmployeeC3Report.rdlc" : "EmployeeC3Report.rdlc";
                string reportPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "Report", rdlcFile);

                if (!System.IO.File.Exists(reportPath))
                {
                    return BadRequest($"RDLC file not found at path: {reportPath}");
                }

                LocalReport report = new LocalReport();
                report.ReportPath = reportPath;
                report.DisplayName = "CustomerReport";
                report.DataSources.Add(new ReportDataSource("C3Report", dt));

                report.EnableExternalImages = true;

                string imagePath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "imagepaid.png");
                string watermarkImage = "";

                if (ispaid && System.IO.File.Exists(imagePath))
                {
                    // Use file:// URI path
                    watermarkImage = "file:///" + imagePath.Replace("\\", "/");
                }
                if (isDraft)
                {
                    string imagePathd = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "imagedraft.png");
                    watermarkImage = "file:///" + imagePathd.Replace("\\", "/");
                }
                report.SetParameters(new ReportParameter("WatermarkImage", watermarkImage));

                return File(report.Render("PDF"), "application/pdf", $"C3Report_{monthName}_{year}.pdf");

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return BadRequest($"Error generating PDF: {ex.Message}");
            }
        }


        [HttpGet("C3Report")]
        public async Task<IActionResult> GetC3Report(string monthName, string year, int companyId, int c3HeaderId)
        {

            try
            {
                C3ResponseViewModel ResultReportJson = new C3ResponseViewModel();
                List<C3ReportViewModel> reportItems = new List<C3ReportViewModel>();
                using (SqlConnection con = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString))
                {

                    using (SqlCommand cmd = new SqlCommand("Generate_C3_Report", con))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;

                        // Add parameters (adjust data types if needed)
                        cmd.Parameters.AddWithValue("@Month", _C3.MonthNumber(monthName));
                        cmd.Parameters.AddWithValue("@Year", year);
                        cmd.Parameters.AddWithValue("@CompanyId", companyId);
                        cmd.Parameters.AddWithValue("@C3HEADERID", c3HeaderId);

                        await con.OpenAsync();
                        using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                        {
                            while (await reader.ReadAsync())
                            {
                                var reportItem = new C3ReportViewModel
                                {
                                    RowNo = reader["row_no"] != DBNull.Value ? Convert.ToInt32(reader["row_no"]) : 0,
                                    CompanyName = reader["company_name"]?.ToString(),
                                    TradeName = reader["trade_name"]?.ToString(),
                                    CompanyAddress = reader["company_address"]?.ToString(),

                                    OrderName = reader["OrderName"]?.ToString(),
                                    OrderKey = reader["OrderKey"]?.ToString(),
                                    date = reader["Reportdate"]?.ToString(),

                                    CompanyRegNo = reader["company_reg_no"]?.ToString(),
                                    NoOfEmployee = reader["no_of_employee"] != DBNull.Value ? Convert.ToInt32(reader["no_of_employee"]) : 0,
                                    CurrentMonth = reader["current_month"]?.ToString(),
                                    SocialSecurityNo = reader["social_security_no"]?.ToString(),
                                    EmpName = reader["emp_name"]?.ToString(),
                                    AppintDate = reader["Appint_Date"]?.ToString(),
                                    EmployeeStatus = reader["Column4"]?.ToString(), // first Column4
                                    PayPeriod = reader["pay_period"]?.ToString(),
                                    FirstWeekOfMonth = reader["first_week_of_month"]?.ToString(),
                                    SecondWeekOfMonth = reader["second_week_of_month"]?.ToString(),
                                    ThirdWeekOfMonth = reader["third_week_of_month"]?.ToString(),
                                    FourWeekOfMonth = reader["four_week_of_month"]?.ToString(),
                                    FiveWeekOfMonth = reader["five_week_of_month"]?.ToString(),
                                    FirstWeekOfSalary = reader["first_week_of_salary"] != DBNull.Value ? Convert.ToDecimal(reader["first_week_of_salary"]) : (decimal?)0,
                                    SecondWeekOfSalary = reader["second_week_of_salary"] != DBNull.Value ? Convert.ToDecimal(reader["second_week_of_salary"]) : (decimal?)0,
                                    ThirdWeekOfSalary = reader["third_week_of_salary"] != DBNull.Value ? Convert.ToDecimal(reader["third_week_of_salary"]) : (decimal?)0,
                                    FourWeekOfSalary = reader["four_week_of_salary"] != DBNull.Value ? Convert.ToDecimal(reader["four_week_of_salary"]) : (decimal?)0,
                                    FiveWeekOfSalary = reader["five_week_of_salary"] != DBNull.Value ? Convert.ToDecimal(reader["five_week_of_salary"]) : (decimal?)0,
                                    Column2 = reader["Column2"] != DBNull.Value ? Convert.ToDecimal(reader["Column2"]) : 0,
                                    Column1 = reader["Column1"] != DBNull.Value ? Convert.ToDecimal(reader["Column1"]) : 0,
                                    TotalWages = reader["total_wages"] != DBNull.Value ? Convert.ToDecimal(reader["total_wages"]) : 0,
                                    DeductLeavyWages = reader["deduct_leavy_wages"] != DBNull.Value ? Convert.ToDecimal(reader["deduct_leavy_wages"]) : 0,
                                    TotalSocSec = reader["total_soc_sec"] != DBNull.Value ? Convert.ToDecimal(reader["total_soc_sec"]) : 0,
                                    Servayance = reader["SERVAYANCE"] != DBNull.Value ? Convert.ToDecimal(reader["SERVAYANCE"]) : 0,
                                    ServayancePePenalty = reader["SERVAYANCE_PEPENALTY"] != DBNull.Value ? Convert.ToDecimal(reader["SERVAYANCE_PEPENALTY"]) : 0,
                                    TotalLevyEEPenalty = reader["TOTAL_LEVYEEPENALTY"] != DBNull.Value ? Convert.ToDecimal(reader["TOTAL_LEVYEEPENALTY"]) : 0,
                                    TotalSSPenalty = reader["TOTAL_SSPENALTY"] != DBNull.Value ? Convert.ToDecimal(reader["TOTAL_SSPENALTY"]) : 0,
                                    Remarks = reader["remarks"]?.ToString(),
                                    Column3 = reader["Column3"] != DBNull.Value ? Convert.ToDecimal(reader["Column3"]) : 0,
                                    HPay_Week1 = reader["HPay_Week1"] != DBNull.Value ? Convert.ToDecimal(reader["HPay_Week1"]) : 0,
                                    HPay_Week2 = reader["HPay_Week2"] != DBNull.Value ? Convert.ToDecimal(reader["HPay_Week2"]) : 0,
                                    HPay_Week3 = reader["HPay_Week3"] != DBNull.Value ? Convert.ToDecimal(reader["HPay_Week3"]) : 0,
                                    HPay_Week4 = reader["HPay_Week4"] != DBNull.Value ? Convert.ToDecimal(reader["HPay_Week4"]) : 0,
                                    HPay_Week5 = reader["HPay_Week5"] != DBNull.Value ? Convert.ToDecimal(reader["HPay_Week5"]) : 0,
                                };

                                reportItems.Add(reportItem);
                            }

                        }
                        await con.CloseAsync();
                    }
                }



                if (reportItems.Count == 0)
                {
                    var result = (from c3 in _context.ProcessC3headers
                                  join company in _context.MasterCompanies
                                    on c3.EmployerId equals company.CompanyId
                                  where c3.C3headerid == c3HeaderId
                                        && c3.isNilReturn == true
                                        && c3.EmployerId == companyId
                                  select new
                                  {
                                      isNilData = (c3.isNilReturn ?? false),
                                      month_year = _C3.MonthName(Convert.ToInt32(c3.PerioddMonth)) + " - " + c3.PeriodYear,
                                      company_name = company.CompanyName,
                                      trade_name = company.TradeName,
                                      company_address = company.Address1 +
                                                        (string.IsNullOrEmpty(company.Address2) ? "" : " " + company.Address2) +
                                                        ", " + (company.City ?? ""),
                                      company_reg_no = company.RegNumber,
                                      date = (c3.IsSubmitted == true ? c3.C3SubmittedDate.Value : (c3.IsSentForEdit == true
                                             ? c3.C3SubmittedDate.Value
                                             : c3.InsertDatetimeinfo.Value)).ToString("dd-MM-yyyy HH:mm:ss")
                                  }).FirstOrDefault();

                    return Ok(new ResponseModel
                    {
                        Status = true,  // Indicate success
                        Message = "NIL return  data get successfully.",
                        Data = result,
                        Statuscode = 200
                    });
                }



                Decimal TotalDeductionLevy = reportItems.Sum(p => p.DeductLeavyWages);
                Decimal servlance = reportItems.Select(p => p.Servayance).FirstOrDefault();
                Decimal EmpLevyContribution = reportItems.Select(p => p.Column3).FirstOrDefault();
                Decimal totalSocialSecurity = reportItems.Sum(p => p.TotalSocSec);

                decimal ServayancePePenalty = reportItems.Select(p => p.ServayancePePenalty).FirstOrDefault(); // servelanse penalty   
                decimal TotalLevyEEPenalty = reportItems.Select(p => p.TotalLevyEEPenalty).FirstOrDefault(); // servelanse penalty   

                ResultReportJson.Listc3ReportViewModel = reportItems;
                ResultReportJson.CompanyName = reportItems.Select(p => p.CompanyName).FirstOrDefault();
                ResultReportJson.date = reportItems.Select(p => p.date).FirstOrDefault();
                ResultReportJson.TradeName = reportItems.Select(p => p.TradeName).FirstOrDefault();
                ResultReportJson.CompanyRegNo = reportItems.Select(p => p.CompanyRegNo).FirstOrDefault();
                ResultReportJson.CompanyAddress = reportItems.Select(p => p.CompanyAddress).FirstOrDefault();
                ResultReportJson.CurrentMonth = reportItems.Select(p => p.CurrentMonth).FirstOrDefault();
                ResultReportJson.TotalWages = reportItems.Sum(p => p.TotalWages);
                ResultReportJson.WagesLevyContribution = EmpLevyContribution;
                ResultReportJson.Servayance = reportItems.Select(p => p.Servayance).FirstOrDefault();
                ResultReportJson.TotalDeductLeavy = TotalDeductionLevy;
                ResultReportJson.finedueMonth = reportItems.Select(p => p.TotalSSPenalty).FirstOrDefault();//Account General 
                ResultReportJson.TotalSocSec = reportItems.Sum(p => p.TotalSocSec); // Total Social Secuirty board   + social Security Contribution
                                                                                    //ResultReportJson.TotalLevyEEPenalty = reportItems.Sum(p => p.TotalLevyEEPenalty); // penalty for the month
                ResultReportJson.TotalLevyEEPenalty = reportItems.Select(p => p.TotalLevyEEPenalty).FirstOrDefault(); // penalty for the month
                ResultReportJson.ServayancePePenalty = reportItems.Select(p => p.ServayancePePenalty).FirstOrDefault(); // servelanse penalty   
                ResultReportJson.AccountGeneralTotal = TotalDeductionLevy + servlance + EmpLevyContribution + ServayancePePenalty + TotalLevyEEPenalty;

                ResultReportJson.RemitedDueMonth = totalSocialSecurity + ResultReportJson.finedueMonth;  //Account General 
                ResultReportJson.Total = ResultReportJson.RemitedDueMonth + ResultReportJson.AccountGeneralTotal;  // Total
                ResultReportJson.AppintDate = reportItems.Select(p => p.AppintDate).FirstOrDefault();

                if (ResultReportJson.Listc3ReportViewModel.Count > 0)
                {
                    //var data = ResultReportJson.Listc3ReportViewModel.GroupBy(x => x.PayPeriod);
                    if (reportItems.FirstOrDefault().OrderName == "employeeName")
                    {
                        var data = ResultReportJson.Listc3ReportViewModel.GroupBy(x => x.PayPeriod)
                                  .Select(group => new
                                  {
                                      PayPeriod = group.Key,
                                      Employees = reportItems.FirstOrDefault()?.OrderKey == "asc" ? group.OrderBy(x => x.PayPeriod).ThenBy(x => x.EmpName).ToList()
                                          : group.OrderBy(x => x.PayPeriod).OrderByDescending(x => x.EmpName).ToList()
                                  }).OrderBy(x => x.PayPeriod).ToList();

                        ResultReportJson.Listc3ReportViewModel = data.SelectMany(g => g.Employees).ToList();
                    }
                    if (reportItems.FirstOrDefault().OrderName == "ssn")
                    {
                        var data = ResultReportJson.Listc3ReportViewModel.GroupBy(x => x.PayPeriod)
                                  .Select(group => new
                                  {
                                      PayPeriod = group.Key,
                                      Employees = reportItems.FirstOrDefault()?.OrderKey == "asc" ? group.OrderBy(x => x.PayPeriod).ThenBy(x => x.SocialSecurityNo).ToList()
                                          : group.OrderByDescending(x => x.SocialSecurityNo).ToList()
                                  }).OrderBy(x => x.PayPeriod).ToList();

                        ResultReportJson.Listc3ReportViewModel = data.SelectMany(g => g.Employees).ToList();
                    }

                    if (string.IsNullOrWhiteSpace(reportItems.FirstOrDefault().OrderName))
                    {
                        var data = ResultReportJson.Listc3ReportViewModel.GroupBy(x => x.PayPeriod)
                                  .OrderBy(g => g.Key)
                                  .Select(group => new
                                  {
                                      PayPeriod = group.Key,
                                      Employees = group.ToList()
                                  })
                                  .ToList();
                        ResultReportJson.Listc3ReportViewModel = data.SelectMany(g => g.Employees).ToList();
                    }
                }

                return Ok(new ResponseModel
                {
                    Status = true,  // Indicate success
                    Message = "Data fetched successfully.",
                    Data = ResultReportJson,
                    Statuscode = 200
                });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return Ok(new ResponseModel
                {
                    Status = false,
                    Message = ex.Message,
                    Data = "",
                    Statuscode = 400
                });
            }
        }


