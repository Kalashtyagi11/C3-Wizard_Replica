        [HttpPost("DeleteBonus")]

        public async Task<IActionResult> DeleteBonus(int BonusPayID, string PayDate, int EmployeeId, int CompanyId)
        {

            if (!ModelState.IsValid)
            {
                return BadRequest(ModelState);
            }


            ResponseModel res = isC3Finilize(PayDate, PayDate, EmployeeId.ToString(), CompanyId);
            if (res.Status == true)
            {

                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                SqlCommand cmd = new SqlCommand("delete from BonusPayDetails where BonusPayId=" + BonusPayID, staticConnection);
                cmd.ExecuteNonQuery();

                //C3WizardMessageBox.Show("C3Wizard", "Deleted Successfully");
                staticConnection.Close();
                // Load_Wages_Bonus_PayEmployee();
                return Ok(new ResponseModel
                {
                    Status = true,
                    Message = "Deleted Successfully",
                    Data = null,
                    Statuscode = 200
                });

            }
            else
            {
                return Conflict(res);
            }



        }


        [HttpGet("Load_Wages_Bonus_PayEmployee")]

        public async Task<IActionResult> Load_Wages_Bonus_PayEmployee(int CompanyId)
        {

            try
            {
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                List<Wages_Pay_Details> Wageslist = new List<Wages_Pay_Details>();
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                SqlCommand cmd = new SqlCommand("Wages_Bonus_PayDetail_Employee_Select_All", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                DataTable dt = new DataTable();
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                sqlAdapter.Fill(dt);
                staticConnection.Close();
                if (dt.Rows.Count > 0)
                {
                    for (int i = 0; i < dt.Rows.Count; i++)
                    {
                        if ((string)dt.Rows[i].ItemArray[10] == "Bonus")
                        {
                            Wages_Pay_Details hpd = new Wages_Pay_Details();
                            hpd.Wages_Bonus_PayId = (int)dt.Rows[i].ItemArray[0];
                            hpd.employeeID = (int)dt.Rows[i].ItemArray[1];
                            hpd.company_ID = (int)dt.Rows[i].ItemArray[2];
                            hpd.Amount = Math.Round((decimal)dt.Rows[i].ItemArray[3], 2);
                            hpd.st_Date = (string)dt.Rows[i].ItemArray[4];
                            hpd.en_Date = (string)dt.Rows[i].ItemArray[5];
                            hpd.PayNoOfTimes = (int)dt.Rows[i].ItemArray[6];
                            hpd.PayStatus = dt.Rows[i].ItemArray[7] != null ? true : false;
                            hpd.employeename = (string)dt.Rows[i].ItemArray[8];
                            hpd.Wages_bonus_PayDate = (DateTime)dt.Rows[i].ItemArray[9];
                            hpd.pay_Date = ((DateTime)hpd.Wages_bonus_PayDate).ToString(Helper.DisplayDateFormat);
                            hpd.Wage_Bonus_Des = (string)dt.Rows[i].ItemArray[10];
                            hpd.yearName = (hpd.st_Date).Substring(6, 4);
                            Wageslist.Add(hpd);
                        }
                    }
                }
                var result = Wageslist.OrderByDescending(x => x.updateon).ToList();
                if (result.Count > 0)
                {
                    return Ok(new ResponseModel
                    {
                        Status = false,
                        Message = "Get Data successfully.",
                        Data = result,
                        Statuscode = 200
                    });
                }
                else
                {
                    return NotFound(new ResponseModel
                    {
                        Status = false,
                        Message = "No data found.",
                        Data = null,
                        Statuscode = 200
                    });

                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = $"Internal server error: {ex.Message}",
                    Data = null,
                    Statuscode = 500
                });
            }
        }





        private ResponseModel isC3Finilize(string sdate, string edate, string ssn, int CompanyId)
        {
            ResponseModel res = new ResponseModel();
            string CreatedC3For = null;
            bool ret_uren = true;
            int Start_y, end_y, start_m, end_m;
            Start_y = DateTime.ParseExact(sdate, Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Year;
            end_y = DateTime.ParseExact(edate, Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Year;
            start_m = DateTime.ParseExact(sdate, Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Month;
            end_m = DateTime.ParseExact(edate, Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Month;
            try
            {
                List<C3Header> listDVOC3Header = new List<C3Header>();
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                SqlCommand cmd = new SqlCommand("get_C3Genrated_data", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                DataTable dt = new DataTable();
                sqlAdapter.Fill(dt);
                staticConnection.Close();
                if (dt.Rows.Count > 0)
                {
                    foreach (DataRow row in dt.Rows)
                    {

                        C3Header Obj = new C3Header();
                        Obj.HeaderID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                        //A/ Obj.p_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? -1 : int.Parse(row["PERIODD_MONTH"].ToString()) + 1;
                        Obj.p_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? -1 : int.Parse(row["PERIODD_MONTH"].ToString());
                        Obj.P_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? -1 : int.Parse(row["PERIOD_YEAR"].ToString());
                        Obj.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                        listDVOC3Header.Add(Obj);

                    }
                    bool exists = listDVOC3Header.Any(x => x.P_year >= Start_y && x.P_year <= end_y && x.p_Month >= start_m && x.p_Month <= end_m);
                    if (exists)
                    {
                        listDVOC3Header = listDVOC3Header.Where(x => x.P_year >= Start_y && x.P_year <= end_y && x.p_Month >= start_m && x.p_Month <= end_m).ToList();
                        if (listDVOC3Header.Count > 0)
                        {
                            List<C3Contributions> employee_list = new List<C3Contributions>();
                            foreach (var Erow in listDVOC3Header)
                            {
                                SqlCommand cmdemp = new SqlCommand("get_C3Genrated_Employee_data", staticConnection);
                                cmdemp.CommandType = CommandType.StoredProcedure;
                                cmdemp.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)Erow.HeaderID ?? (object)DBNull.Value));
                                cmdemp.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                                SqlDataAdapter sqlAdapteremp = new SqlDataAdapter(cmdemp);
                                DataTable dtemp = new DataTable();
                                sqlAdapteremp.Fill(dtemp);
                                if (dtemp.Rows.Count > 0)
                                {
                                    foreach (DataRow row in dtemp.Rows)
                                    {
                                        if (row["SSN"].ToString() == ssn && int.Parse(row["C3HEADERID"].ToString()) != 0)
                                        {
                                            C3Contributions obj = new C3Contributions();
                                            obj.C3HEADERID = int.Parse(row["C3HEADERID"].ToString());
                                            obj.SSN = row["SSN"].ToString();
                                            obj.EmployeeId = int.Parse(row["EmployeeID"].ToString());
                                            obj.EmployeeName = row["Emp_Name"].ToString();
                                            employee_list.Add(obj);
                                            CreatedC3For += "\n" + _C3.MonthName(Erow.p_Month) + " " + Erow.P_year + " Schedule " + Erow.Schedule_NO;
                                        }
                                    }
                                }
                            }
                            if (employee_list.Count > 0)
                            {
                                res.Message = "C3 has been Created for " + CreatedC3For + "\n So you can not delete the bonus details";
                                res.Status = false;
                                res.Statuscode = 409;
                                return (res);

                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                res.Status = false;
                res.Message = $"Internal server error: {ex.Message}";
                res.Data = null;
                res.Statuscode = 500;
                return res;
            }
            res.Status = ret_uren;
            return res;
        }
        [HttpGet("GetEmployee_List")]
        public async Task<IActionResult> GetEmployee_List(int companyId)
        {
            try
            {
                if (companyId < 0)
                {
                    return Ok(new ResponseModel
                    {
                        Status = true,  // Indicate success
                        Message = "Company is not Found",
                        Data = 0,
                        Statuscode = 200
                    });
                }
                List<Employee_Name_SSN> data = await Task.Run(() => _C3.Employeelist(companyId));
                return Ok(new ResponseModel
                {
                    Status = true,  // Indicate success
                    Message = "Data fetched successfully.",
                    Data = data,
                    Statuscode = 200
                });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                // Log the exception
                // Example: _logger.LogError(ex, "Error fetching employee list");
                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = "An error occurred while fetching data.",
                    Data = null,
                    Statuscode = 500
                });
            }
        }

        [HttpPost("EditC3EmployeeListing")]
        public async Task<IActionResult> GetC3EmployeeListing(editC3Vm obj)
        {
            try
            {
                string connectionString = C3WizardLayerConn_BaseData.StaticConnectionString;
                var checkResult = await _C3.AllEmployeeExistsAsync(obj.headerId, submit: false, companyId: obj.CompanyId);
                if (!checkResult.IsSuccess)
                {
                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                        Message = checkResult.ErrorMessage,
                        Data = null,
                        Statuscode = 400
                    });
                }

                // 1. Retrieve header data via stored procedure "get_C3Genrated_data"
                List<C3HeaderVM> headerList = new List<C3HeaderVM>();
                using (SqlConnection staticConnection = new SqlConnection(connectionString))
                {
                    await staticConnection.OpenAsync();
                    using (SqlCommand cmd = new SqlCommand("get_C3Genrated_data", staticConnection))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int)
                        {
                            Value = obj.CompanyId
                        });

                        using (SqlDataAdapter adapter = new SqlDataAdapter(cmd))
                        {
                            DataTable dt = new DataTable();
                            adapter.Fill(dt);
                            foreach (DataRow row in dt.Rows)
                            {
                                var header = new C3HeaderVM
                                {
                                    HeaderID = row["C3HEADERID"] != DBNull.Value ? Convert.ToInt32(row["C3HEADERID"]) : 0,
                                    RegNo = row["RegNo"] != DBNull.Value ? row["RegNo"].ToString() : null,
                                    period_Month = (row["PERIODD_MONTH"] != DBNull.Value && !string.IsNullOrEmpty(row["PERIODD_MONTH"].ToString()))
                                                    ? row["PERIODD_MONTH"].ToString() : null,
                                    Period_year = (row["PERIOD_YEAR"] != DBNull.Value && !string.IsNullOrEmpty(row["PERIOD_YEAR"].ToString()))
                                                    ? row["PERIOD_YEAR"].ToString() : null,
                                    TOTAL_WAGES = row["TOTAL_WAGES"] != DBNull.Value
                                                    ? decimal.Parse(string.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString()))) : 0,
                                    TOTALSSCONTRIBUTIONS = row["TOTAL_SSCONTRIBUTIONS"] != DBNull.Value
                                                    ? decimal.Parse(string.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString()))) : 0,
                                    TOTALLEVYEEEMPLOYEE = row["TOTAL_LEVYEEEMPLOYEE"] != DBNull.Value
                                                    ? decimal.Parse(string.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString()))) : 0,
                                    Insert_Datetimeinfo = row["Insert_Datetimeinfo"] != DBNull.Value ? row["Insert_Datetimeinfo"].ToString() : null,
                                    Is_Fianalize = row["Is_Fianalize"] != DBNull.Value ? bool.Parse(row["Is_Fianalize"].ToString()) : false,
                                    Is_submitted = row["Is_submitted"] != DBNull.Value ? bool.Parse(row["Is_submitted"].ToString()) : false,
                                    Schedule_NO = row["Schedule_NO"] != DBNull.Value ? Convert.ToInt32(row["Schedule_NO"]) : 0,
                                    OrderName = (row["OrderName"] != DBNull.Value && !string.IsNullOrEmpty(row["OrderName"].ToString())) ? row["OrderName"].ToString() : null,
                                    OrderKey = (row["OrderKey"] != DBNull.Value && !string.IsNullOrEmpty(row["OrderKey"].ToString())) ? row["OrderKey"].ToString() : null,
                                    isNilReturn = Convert.IsDBNull(row["isNilReturn"]) ? false : bool.Parse(row["isNilReturn"].ToString()),
                                };
                                headerList.Add(header);
                            }
                        }
                    }
                    await staticConnection.CloseAsync();
                }

                // 2. Look up the requested header details
                var headerDetails = headerList.FirstOrDefault(x => x.HeaderID == obj.headerId);
                if (headerDetails == null)
                {
                    return NotFound(new ResponseModel
                    {
                        Status = false,
                        Message = "Header not found.",
                        Data = null,
                        Statuscode = 404
                    });
                }

                // 3. Calculate date values based on header info (as in the original code)
                int monthIndex = int.Parse(headerDetails.period_Month);
                int yearValue = int.Parse(headerDetails.Period_year);
                int mondays = _C3.MondaysInMonth(monthIndex, yearValue); // your helper method
                bool isWeekfifth = (mondays == 5);
                string monthVal = monthIndex <= 9 ? "0" + monthIndex.ToString() : monthIndex.ToString();
                DateTime todayDate = DateTime.ParseExact("01/" + monthVal + "/" + yearValue.ToString(), Helper.DateFormat, CultureInfo.InvariantCulture);
                int daysThisMonth = DateTime.DaysInMonth(yearValue, monthIndex);
                List<Holiday_Pay_Dates1> holidayPayDates = _C3.Holiday_Pay_Dates1(todayDate, daysThisMonth); // your helper method

                DateTime? end_date = todayDate != null ? (DateTime?)((DateTime)todayDate).AddDays(daysThisMonth - 1) : null;



                // 4. Retrieve employee data via stored procedure "get_C3Genrated_Employee_data"
                List<C3Contributions> allEmployeeList = new List<C3Contributions>();
                using (SqlConnection staticConnection = new SqlConnection(connectionString))
                {
                    await staticConnection.OpenAsync();
                    using (SqlCommand cmdEmp = new SqlCommand("get_C3Genrated_Employee_data", staticConnection))
                    {
                        cmdEmp.CommandType = CommandType.StoredProcedure;
                        cmdEmp.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int) { Value = obj.headerId });
                        cmdEmp.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int)
                        {
                            Value = obj.CompanyId
                        });

                        using (SqlDataAdapter adapterEmp = new SqlDataAdapter(cmdEmp))
                        {
                            DataTable dtEmp = new DataTable();
                            adapterEmp.Fill(dtEmp);
                            if (dtEmp.Rows.Count > 0)
                            {
                                foreach (DataRow row in dtEmp.Rows)
                                {
                                    var H_Id = Convert.ToInt32(row["C3HEADERID"]);
                                    if (true) //A/ (H_Id != 0)
                                    {
                                        var emp = new C3Contributions
                                        {

                                            C3HEADERID = obj.popUpList != null ? obj.headerId : Convert.ToInt32(row["C3HEADERID"]),
                                            SSN = row["SSN"].ToString(),
                                            EmployeeId = Convert.ToInt32(row["EmployeeID"]),
                                            EmployeeName = row["Emp_Name"].ToString(),
                                            WEEK1 = (bool)row["WEEK1"],
                                            WEEK2 = (bool)row["WEEK2"],
                                            WEEK3 = (bool)row["WEEK3"],
                                            WEEK4 = (bool)row["WEEK4"],
