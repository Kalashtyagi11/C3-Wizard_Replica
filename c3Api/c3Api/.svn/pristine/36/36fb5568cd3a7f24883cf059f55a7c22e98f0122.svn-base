                                                    emp.emp_add_remove = false;

                                                    emp.WAGES1 = /*IsWithleaveHpay*/false ? decimal.Parse(String.Format("{0:0.00}", (emp.EmpSalary))) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES1"].ToString()) + w1_hpay + w2_hpay));
                                                    emp.WAGES2 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                                                    emp.WAGES3 = /*IsWithleaveHpay*/false ? decimal.Parse(String.Format("{0:0.00}", (emp.EmpSalary))) : isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES3"].ToString()) + w3_hpay + w4_hpay)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["WAGES3"].ToString()) + w3_hpay + w4_hpay + w5_hpay));
