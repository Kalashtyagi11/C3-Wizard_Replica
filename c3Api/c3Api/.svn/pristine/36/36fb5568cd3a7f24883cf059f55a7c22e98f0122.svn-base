                    cmd.Parameters.Add(new SqlParameter("@PayNoOfTimes", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)days_list.Count ?? (object)DBNull.Value));
                    cmd.Parameters.Add(new SqlParameter("@EmployeeDetails", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)holidayPay.Emp_Name ?? (object)DBNull.Value));
                    cmd.Parameters.Add(new SqlParameter("@holidayPayId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)holidayPay.holidaypayId ?? (object)DBNull.Value));
                    cmd.Parameters.Add(new SqlParameter("@updateon", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
                    cmd.Parameters.Add(new SqlParameter("@IsWithoutLeave", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)false ?? (object)DBNull.Value));
                    cmd.Parameters.Add(new SqlParameter("@PERIODD_MONTH", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)monthno ?? (object)DBNull.Value));
                    cmd.Parameters.Add(new SqlParameter("@PERIOD_YEAR", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)value ?? (object)DBNull.Value));
                    cmd.Parameters.Add(new SqlParameter("@otherHpaydes", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)OtHpayTvalue ?? (object)DBNull.Value));
                    SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                    DataTable dt = new DataTable();
                    sqlAdapter.Fill(dt);
                    if (dt.Rows.Count > 0)
                    {
                        HPid = holidayPay.holidaypayId;
                        for (int i = 0; i < days_list.Count; i++)
                        {
                            SqlCommand cmddates = new SqlCommand("Holiday_Pay_Dates_Insert_One", staticConnection);
                            cmddates.CommandType = CommandType.StoredProcedure;
                            cmddates.Parameters.Add(new SqlParameter("@HolidayPayId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)HPid ?? (object)DBNull.Value));
                            cmddates.Parameters.Add(new SqlParameter("@EmployeeId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)employeeid ?? (object)DBNull.Value));
                            cmddates.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                            cmddates.Parameters.Add(new SqlParameter("@Amount", SqlDbType.Decimal, 9, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(Math.Round((Convert.ToDecimal(holidayPay.Amount)), 2)) ?? (object)DBNull.Value));
                            cmddates.Parameters.Add(new SqlParameter("@HolidayPayDate", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(DateTime)days_list[i].holidayPay_Date ?? (object)DBNull.Value));
                            SqlDataAdapter sqlAdapterDates = new SqlDataAdapter(cmddates);
                            DataTable dtdates = new DataTable();
                            sqlAdapterDates.Fill(dtdates);
                        }
                        staticConnection.Close();
                        response.Message = "Record Updated Successfully!";
                        response.Status = true;
                        response.Statuscode = 200;
                        return response;


                    }
                    else
                    {
                        response.Message = "Record already exist for these dates!";
                        response.Status = true;
                        response.Statuscode = 200;
                        return response;

                    }

                }
                else
                {
                    if (emplistinfo.Count > 0)
                    {

                        bool tdate = emplistinfo.FirstOrDefault().Terminated != null ? true : false;
                        if (tdate)
                        {
                            if (emplistinfo.FirstOrDefault().Terminated <= holidayPay.from_date)
                            {
                                response.Message = "You can't Pay Holiday/Other pay to this employee because this employee is terminated on dated";
                                response.Status = true;
                                response.Statuscode = 200;
                                return response;
                            }
                        }
                        bool cdate = emplistinfo.FirstOrDefault().AppintDate != null ? true : false;
                        if (cdate)
                        {
                            if (emplistinfo.FirstOrDefault().AppintDate >= holidayPay.from_date)
                            {
                                response.Message = "You can't Pay Holiday/Other pay to this employee because this employee is appointed on dated ";
                                response.Status = true;
                                response.Statuscode = 200;
                                return response;
                            }

                        }
                    }
                    response.Message = "Employee from_date not found. Unable to process Holiday/Other pay.";
                    response.Status = true;
                    response.Statuscode = 200;
                    return response;

                }
            }

            return response;
        }

        /// <summary>
        /// This method is used SaveEmployeeHoliday
        /// </summary>
        /// <param name="c3EmployeeVM"></param>
        /// <returns></returns>
        [HttpPost("GetAllHolidayPay")]
        public async Task<ResponseModel> GetAllHolidayPay(int CompanyId)
        {
            ResponseModel response = new ResponseModel();
            // int CompanyId = 1;
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            List<Holiday_Pay_Details> userlist = new List<Holiday_Pay_Details>();
            SqlCommand cmd = new SqlCommand("Holiday_Pay_Employee_Select_All", staticConnection);
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
            DataTable dt = new DataTable();
            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
            sqlAdapter.Fill(dt);
            staticConnection.Close();
            if (dt.Rows.Count > 0)
            {
                for (int i = 0; i < dt.Rows.Count; i++)
                {
                    Holiday_Pay_Details hpd = new Holiday_Pay_Details();
                    hpd.holidayPayId = (int)dt.Rows[i].ItemArray[0];
                    hpd.employeeID = (int)dt.Rows[i].ItemArray[1];
                    hpd.company_ID = (int)dt.Rows[i].ItemArray[2];
                    hpd.Amount = dt.Rows[i].ItemArray[3] != DBNull.Value ? Math.Round((decimal)dt.Rows[i].ItemArray[3], 2) : 0.00m;

                    hpd.st_Date = dt.Rows[i].ItemArray[4] != DBNull.Value ? (string)dt.Rows[i].ItemArray[4] : string.Empty;
                    hpd.en_Date = dt.Rows[i].ItemArray[5] != DBNull.Value ? (string)dt.Rows[i].ItemArray[5] : string.Empty;
                    hpd.PayNoOfTimes = (int)dt.Rows[i].ItemArray[6];
                    hpd.PayStatus = dt.Rows[i].ItemArray[7] != null ? true : false;
                    hpd.employeename = (string)dt.Rows[i].ItemArray[8];
                    hpd.emptype = dt.Rows[i].ItemArray[9].ToString();
                    hpd.IsWithoutLeave = dt.Rows[i].ItemArray[10].ToString() == "True" ? "Holiday Pay With Leave" : dt.Rows[i].ItemArray[11].ToString();
                    hpd.otherHpaydes = dt.Rows[i].ItemArray[11].ToString();
                    hpd.IsempDirector = hpd.emptype == "True" ? "/img/RightSine.png" : "/img/close.png";

                    hpd.yearName = hpd.st_Date == "" ? "" : (hpd.st_Date.Substring(6, 4));

                    userlist.Add(hpd);
                }
            }

            if (userlist.Count > 0)
            {
                response.Message = "Data retrieved successfully!";
                response.Statuscode = 200;
                response.Status = true;
                response.Data = userlist;
            }
            else
            {
                response.Message = "Data Not Founds!";
                response.Statuscode = 404;
                response.Status = false;
                response.Data = Array.Empty<object>();
            }

            return response;

        }





        /// <summary>
        /// This method is used deleteholiday
        /// </summary>
        /// <param name="c3EmployeeVM"></param>
        /// <returns></returns>
        [HttpGet("HolidaypayDelete")]
        public async Task<ResponseModel> HolidaypayDelete(int holidayPayId)
        {
            ResponseModel response = new ResponseModel();

            var holidaymaster = _context.MasterHolidayPayDetails.FirstOrDefault(e => e.HolidayPayId == holidayPayId);

            var fromMonth = holidaymaster?.StartDate?.Month;
            var fromYear = holidaymaster?.StartDate?.Year;
            var toMonth = holidaymaster?.EndDate?.Month;
            var toYear = holidaymaster?.EndDate?.Year;

            var checkC3Submitted = _context.ProcessContributions
                ?.Where(e =>
                    (e.Ssn == holidaymaster.EmployeeId.ToString() || e.Ssnd == holidaymaster.EmployeeId.ToString()) && e.IsSubmitted == true &&
                    (
                        (fromMonth.HasValue && fromYear.HasValue &&
                         Convert.ToInt32(e.PerioddMonth) == fromMonth.Value &&
                         Convert.ToInt32(e.PeriodYear) == fromYear.Value) ||

                        (toMonth.HasValue && toYear.HasValue &&
                         Convert.ToInt32(e.PerioddMonth) == toMonth.Value &&
                         Convert.ToInt32(e.PeriodYear) == toYear.Value)
                    )
                ).ToList();

            if (checkC3Submitted?.Count()!=0 && checkC3Submitted.All(r => r.IsSubmitted == true))
            {
                response.Message = "You can't update Holiday/Other pay to this employee because this employee submitted record In Bima";
                response.Status = false;
                response.Statuscode = 400;
                return response;
            }



            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            SqlCommand cmd = new SqlCommand("delete from MasterHolidayPayDetails where holidayPayId=" + holidayPayId, staticConnection);
            cmd.ExecuteNonQuery();
            cmd = new SqlCommand("delete from HolidayPayDates where holidayPayId=" + holidayPayId, staticConnection);
            cmd.ExecuteNonQuery();
            staticConnection.Close();

            response.Message = "Record Deleted Successfully!";
            response.Statuscode = 200;
            response.Status = true;
            return response;

        }

