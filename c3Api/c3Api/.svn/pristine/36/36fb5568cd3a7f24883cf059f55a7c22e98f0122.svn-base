        [HttpPost("Export_C3_Data")]
        public async Task<IActionResult> Export_C3_Data(int Schedule_No, int month, string Period_year, int CompanyId)
        {
            ResponseModel response = new ResponseModel();
            int? s_count = Schedule_No;
            // string monthname = period_Month;
            //int month = MonthNumber(monthname);
            string year = Period_year;
            var exportmodel = await Export_C3_Employee(year, month, Schedule_No, CompanyId);

            return File(exportmodel.bytnew, "application/octet-stream", exportmodel.filsename);

        }


        private async Task<exportmodel> Export_C3_Employee(string Year, int month, int s_count, int CompanyId)
        {
            exportmodel exportmodel = new exportmodel();

            decimal Tot_SS_Contribution = 0, Tot_SS_Fines = 0, Tot_Levy_Employee = 0, Tot_Levy_Employer = 0, Tot_Levy_Penalty = 0, Tot_Severance = 0, Tot_PE_Penalty = 0, total_wages = 0;
            DataTable dtExport = new DataTable();
            SqlConnection staticConnectionExport = C3WizardLayerConn_BaseData.StaticSqlConnection;
            SqlCommand cmdExport = new SqlCommand("Export_C3_Report", staticConnectionExport);
            cmdExport.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)month ?? (object)DBNull.Value));
            cmdExport.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)Year ?? (object)DBNull.Value));
            cmdExport.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
            cmdExport.Parameters.Add(new SqlParameter("@Schedule_No", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)s_count ?? (object)DBNull.Value));
            cmdExport.CommandType = CommandType.StoredProcedure;
            SqlDataAdapter sqlAdapterExport = new SqlDataAdapter(cmdExport);
            sqlAdapterExport.Fill(dtExport);
            string str = string.Empty;
            string C_info = "", f_name = "";
            foreach (DataRow Row in dtExport.Rows)
            {
                String m_no = month < 10 ? "0" + month : month.ToString();
                f_name = Row["company_reg_no"].ToString() + m_no + Year; //+ (DateTime.Parse(Row["Insert_Datetimeinfo"].ToString())).ToShortDateString();
                C_info = Row["company_reg_no"].ToString() + ", 01/" + m_no + "/" + Year;//Row["Insert_Datetimeinfo"].ToString();
                str = "HDR" + ", " + Row["company_reg_no"].ToString() + ", 01/" + m_no + "/" + Year + ", 1.0.0, " + Row["company_name"].ToString();
            }
            // Insert a new line.
            str += "\r\n";
            int c3count = 0;
            foreach (DataRow Drow in dtExport.Rows)
            {
                // Insert the Data rows.
                str += (c3count + 1).ToString() + ", " + Drow["social_security_no"].ToString() + ", " +
                    Drow["Last_Name"].ToString() + ", " + Drow["First_Name"].ToString() + ", " + Drow["Middle_Name"].ToString() + ", " +
                    Drow["Appint_Date"].ToString() + ", " + Drow["Terminated"].ToString() + ", " + _C3.Pay_Period(Drow["Pay_Period"].ToString()) + ", " +
                 (bool.Parse(Drow["first_week_of_month"].ToString()) ? "1" : "0") + ", " + (bool.Parse(Drow["second_week_of_month"].ToString()) ? "1" : "0") + ", " +
                    (bool.Parse(Drow["third_week_of_month"].ToString()) ? "1" : "0") + ", " + (bool.Parse(Drow["four_week_of_month"].ToString()) ? "1" : "0") + ", " +
                    (bool.Parse(Drow["five_week_of_month"].ToString()) ? "1" : "0") + ", " + (decimal.Parse(Drow["HPay"].ToString()) > 0 ? "1" : "0") + ", " + (decimal.Parse(Drow["BONUS"].ToString()) > 0 ? "1" : "0") + ", " +
                     Drow["first_week_of_salary"].ToString() + ", " + Drow["second_week_of_salary"].ToString() + ", " + Drow["third_week_of_salary"].ToString() + ", " + Drow["four_week_of_salary"].ToString() + ", " + Drow["five_week_of_salary"].ToString() + ", "
                     + Drow["HPay"].ToString() + ", " + Drow["BONUS"].ToString() + ", " + Drow["Levye_of_emp"].ToString() + ", " + Drow["SS_of_emp"].ToString() + "\r\n";
                c3count++;
            }
            foreach (DataRow Drow in dtExport.Rows)
            {
                // Insert the Data rows.
                total_wages = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(Drow["total_wages"].ToString())));
                Tot_SS_Contribution = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(Drow["total_soc_sec"].ToString())));
                Tot_SS_Fines = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(Drow["TOTAL_SSPENALTY"].ToString())));
                Tot_Levy_Employee = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(Drow["TOTAL_LEVYEEEMPLOYEE"].ToString())));
                Tot_Levy_Employer = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(Drow["TOTAL_LEVYEEEMPLOYER"].ToString())));
                Tot_Levy_Penalty = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(Drow["TOTAL_LEVYEEPENALTY"].ToString())));
                Tot_Severance = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(Drow["TOTAL_SERVAYANCE"].ToString())));
                Tot_PE_Penalty = decimal.Parse(String.Format("{0:0.00}", decimal.Parse(Drow["TOTAL_SERVAYANCE_PENALTY"].ToString())));
            }
            str += "FTR" + ", " + C_info + ", " + total_wages + ", " + (Tot_SS_Contribution).ToString() + ", "
                + (Tot_Levy_Employee + Tot_Levy_Employer + Tot_Levy_Penalty).ToString() + ", " + (Tot_Severance + Tot_PE_Penalty).ToString() + ", " + dtExport.Rows.Count;
            //SaveFileDialog saveFileDialog1 = new SaveFileDialog();
            //saveFileDialog1.Filter = "Electronic C3 File (*.c3)|*.c3";
            //saveFileDialog1.FileName = f_name;// f_name.Replace(@"/", string.Empty); ;
            //saveFileDialog1.Title = "Save C3 File";

            //var result = saveFileDialog1.ShowDialog();
            string monthna = _C3.MonthName(month);
            //if ((bool)result && saveFileDialog1.FileName != "")
            //{
            try
            {
                //System.IO.FileStream fs = (System.IO.FileStream)saveFileDialog1.OpenFile();
                //StreamWriter m_streamWriter = new StreamWriter(fs);
                //m_streamWriter.BaseStream.Seek(0, SeekOrigin.End);
                ////m_streamWriter.Write("C3 File  ");
                ////m_streamWriter.WriteLine(DateTime.Now.ToLongTimeString(), DateTime.Now.ToLongDateString());
                //m_streamWriter.WriteLine(str);
                //m_streamWriter.Flush();
                //fs.Close();
                //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                //C3WizardMessageBox.Show("Export C3 File", "The C3 File (" + saveFileDialog1.FileName + ") is exported successfully!");
                //bool exists = System.IO.Directory.Exists(Helper.ParentApplicationPath(""));
                //if (!exists)
                //{
                //    System.IO.Directory.CreateDirectory(Helper.ParentApplicationPath(""));
                //}
                //exists = System.IO.Directory.Exists(Helper.ParentApplicationPath("C3 Submission  Files"));
                //if (!exists)
                //{
                //    System.IO.Directory.CreateDirectory(Helper.ParentApplicationPath("C3 Submission  Files"));
                //}
                //exists = System.IO.Directory.Exists(Helper.ParentApplicationPath("C3 Submission  Files\\" + Year));
                //if (!exists)
                //{
                //    System.IO.Directory.CreateDirectory(Helper.ParentApplicationPath("C3 Submission  Files\\" + Year));
                //}
                //exists = System.IO.Directory.Exists(Helper.ParentApplicationPath("C3 Submission  Files\\" + Year + "\\" + monthna));
                //if (!exists)
                //{
                //    System.IO.Directory.CreateDirectory(Helper.ParentApplicationPath("C3 Submission  Files\\" + Year + "\\" + monthna));
                //}
                //exists = System.IO.Directory.Exists(Helper.ParentApplicationPath("C3 Submission  Files\\" + Year + "\\" + monthna + "\\Schedule " + s_count));
                //if (!exists)
                //{
                //    System.IO.Directory.CreateDirectory(Helper.ParentApplicationPath("C3 Submission  Files\\" + Year + "\\" + monthna + "\\Schedule " + s_count));
                //}
                //if (!File.Exists("C:\\SocialSecurityDB\\Social_Security_Database.mdf"))
                //{


                //}
                //saveFileDialog1.FileName = Helper.ParentApplicationPath("C3 Submission  Files\\" + Year + "\\" + monthna + "\\Schedule " + s_count + "\\" + f_name);
                //if (saveFileDialog1.FileName != "")
                //{

                //    System.IO.FileStream fsd = (System.IO.FileStream)saveFileDialog1.OpenFile();
                //    StreamWriter m_streamWriterd = new StreamWriter(fsd);
                //    m_streamWriterd.BaseStream.Seek(0, SeekOrigin.End);
                //    //m_streamWriter.Write("C3 File  ");
                //    //m_streamWriter.WriteLine(DateTime.Now.ToLongTimeString(), DateTime.Now.ToLongDateString());
                //    m_streamWriterd.WriteLine(str);
                //    m_streamWriterd.Flush();
                //    fsd.Close();
                //}
                //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                byte[] fileBytes;
                using (var memoryStream = new MemoryStream())
                {
                    // Write the content to the memory stream (this simulates creating the file)
                    using (var writer = new StreamWriter(memoryStream, Encoding.UTF8))
                    {
                        writer.WriteLine(str); // Write the provided string to the file
                        writer.Flush();
                    }

                    // Set the position of the memory stream to the beginning
                    fileBytes = memoryStream.ToArray();
                    exportmodel.bytnew = fileBytes;
                    exportmodel.filsename = f_name;
                }

                return exportmodel;
            }
            catch (Exception ex)
            {
                throw ex;
            }
            //}



        }



        [HttpPost("UploadC3File")]
        public async Task<IActionResult> FileUploadC3([FromForm] C3FileDataUpload obj)
        {
            try
            {


                if (obj.file == null || obj.file.Length == 0)
                    return BadRequest("No file uploaded");

                var extension = Path.GetExtension(obj.file.FileName);
                if (!string.Equals(extension, ".c3", StringComparison.OrdinalIgnoreCase))
                    return BadRequest("Only .c3 files are allowed.");

                string reportPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "ImportC3File", obj.file.FileName);

                using (var stream = new FileStream(reportPath, FileMode.Create))
                    await obj.file.CopyToAsync(stream);


                var lines = System.IO.File.ReadAllLines(reportPath);
                var c3Data = new C3FileData();


                int lineNumber = 0;

                foreach (var line in lines)
                {
                    lineNumber++;

                    if (string.IsNullOrWhiteSpace(line))
                        return BadRequest(new { status = true, msg = $"Line {lineNumber} is blank." });

                    var parts = line.Split(',').Select(p => p.Trim()).ToArray();

                    if (parts[0] == "HDR")
                    {
                        if (parts.Length !=5)
                            return BadRequest(new { status = true, msg = $"HDR line missing required fields at Line {lineNumber}" });

                        if (parts[1].Length!=6)
                            return BadRequest(new { status = true, msg = $"HDR line missing RegNumber length {lineNumber}" });

                        string regNo = parts[1];
                        string periodDate = parts[2];
                        string version = parts[3];
                        string companyName = parts[4];

                        // Validate Company RegNo
                        var companydata = _context.MasterCompanies.FirstOrDefault(e => e.CompanyId == obj.companyId);
                        if (companydata == null)
                            return BadRequest(new { status = true, msg = "Company not found in database." });

                        if (companydata.RegNumber != regNo)
                        {
                            return BadRequest(new
                            {
                                status = false,
                                msg = $"Registration Number mismatch at Line {lineNumber}"
                            });
                        }

                        // Validate company name
                        string dbCompany = companydata.CompanyName?.ToLower().Trim().Replace("\u00A0", "").Replace("\u200B", "").Replace(" ", "");
                        string fileCompany = companyName.ToLower().Trim().Replace("\u00A0", "").Replace("\u200B", "").Replace(" ", "");
                       if (dbCompany != fileCompany)
                        {
                            return BadRequest(new
                            {
                                status = false,
                                msg = $"Company name mismatch in HDR at Line {lineNumber}"
                            });
                        }

                        // Validate date
                        DateTime formattedDate;
                        if (!DateTime.TryParseExact(periodDate, new[] { "d/M/yyyy", "dd/MM/yyyy" }, CultureInfo.InvariantCulture,
                            DateTimeStyles.None, out formattedDate))
                        {
                            return BadRequest(new { status = true, msg = $"Invalid date format in HDR at Line {lineNumber}. Required format: dd/MM/yyyy" });
                        }

                        c3Data.Header = new ProcessC3header
                        {
                            RegNo = regNo,
                            PerioddMonth = formattedDate.Month.ToString(),
                            PeriodYear = formattedDate.Year.ToString(),
                            // VERSION = version,
                            // COMPANY = companyName
                        };
                    }
                    else if (parts[0] == "FTR")
                    {

                        if (parts.Length != 8)
                            return BadRequest(new { status = true, msg = $"FTR missing required fields at Line {lineNumber}" });

                        if (parts[1].Length != 6)
                            return BadRequest(new { status = true, msg = $"FTR line missing RegNumber invailed {lineNumber}" });

                        // Field-3 → Date must be dd/MM/yyyy
                        DateTime ftrDate;
                        if (!DateTime.TryParseExact(parts[2], new[] { "d/M/yyyy", "dd/MM/yyyy" }, CultureInfo.InvariantCulture,
                            DateTimeStyles.None, out ftrDate)
                            && !DateTime.TryParseExact(parts[2], "dd/MM/yyyy", CultureInfo.InvariantCulture,
                            DateTimeStyles.None, out ftrDate))
                        {
                            return BadRequest(new { status = true, msg = $"Invalid date format in FTR at Line {lineNumber}. Required format dd/MM/yyyy" });
                        }

                        for (int i = 3; i <= 7; i++)
                        {
                            if (string.IsNullOrWhiteSpace(parts[i]))
                                return BadRequest(new { status = true, msg = $"FTR column {i + 1} cannot be empty at Line {lineNumber}" });

                            decimal value;
                            if (!decimal.TryParse(parts[i], out value))
                                return BadRequest(new { status = true, msg = $"Invalid numeric value in FTR column {i + 1} at Line {lineNumber}" });
                        }

                    }
                    else
                    {
                        if (parts.Length != 24)
                            return BadRequest(new { status = true, msg = $"C3 file   required fields at Line {lineNumber}" });

                        if (parts[1].Length != 6)
                            return BadRequest(new { status = true, msg = $"ssn not found this line number   {lineNumber}" });


                        DateTime ftrDate;
                        if (!string.IsNullOrEmpty(parts[5]))
                        {
                            if (!DateTime.TryParseExact(parts[5], new[] { "d/M/yyyy", "dd/MM/yyyy" }, CultureInfo.InvariantCulture,
                                              DateTimeStyles.None, out ftrDate)
                                              && !DateTime.TryParseExact(parts[5], "dd/MM/yyyy", CultureInfo.InvariantCulture,
                                              DateTimeStyles.None, out ftrDate))
                            {
                                return BadRequest(new { status = true, msg = $"Invalid date format in FTR at Line {lineNumber}. Required format dd/MM/yyyy" });
                            } 
                        }
                        if (!string.IsNullOrEmpty(parts[6]))
                        {

                            if (!DateTime.TryParseExact(parts[6], new[] { "d/M/yyyy", "dd/MM/yyyy" }, CultureInfo.InvariantCulture,
                               DateTimeStyles.None, out ftrDate)
                               && !DateTime.TryParseExact(parts[6], "dd/MM/yyyy", CultureInfo.InvariantCulture,
                               DateTimeStyles.None, out ftrDate))
                            {
                                return BadRequest(new { status = true, msg = $"Invalid date format in FTR at Line {lineNumber}. Required format dd/MM/yyyy" });
                            } 
                        }

                        for (int i = 7; i < parts.Length; i++)
                        {



                            if (i <= 12)
                            {
                                if (string.IsNullOrWhiteSpace(parts[i]))
                                    return BadRequest(new { status = true, msg = $"Missing integer value in Column {i + 1} at Line {lineNumber}" });

                                int temp;
                                if (!int.TryParse(parts[i], out temp))
                                    return BadRequest(new { status = true, msg = $"Invalid integer value in Column {i + 1} at Line {lineNumber}" });
                            }
                            else
                            {



                                if (string.IsNullOrWhiteSpace(parts[i]))
                                    return BadRequest(new { status = true, msg = $"Missing decimal value in Column {i + 1} at Line {lineNumber}" });

                                decimal value;
                                if (!decimal.TryParse(parts[i], out value))
                                    return BadRequest(new { status = true, msg = $"Invalid decimal value in Column {i + 1} at Line {lineNumber}" });
                            }
                        }
                    }
                }

                //foreach (var line in lines)
                //{
                //    var parts = line.Split(',').Select(p => p.Trim()).ToArray();

                //    if (parts[0] == "HDR")
                //    {
                //        parts = line.Split(new[] { ',' }, 5).Select(p => p.Trim()).ToArray();

                //        //parts[4] = parts.Length == 6 ? parts[4] + ","+parts[5] : parts[4];
                //        //if (parts.Length!=10)
                //        //{
                //        //    return new ResponseModel { Status = false, Message = "HDR Length not Matched" };
                //        //}
                //        var companydata = _context.MasterCompanies.FirstOrDefault(e => e.CompanyId == obj.companyId);
                //        if (companydata == null || companydata.RegNumber != parts[1])
                //        {
                //            return BadRequest(new { status = false, msg = "The employer name or registration number in this media file does not correspond to the details of the logged-in user.\r\n " });
                //        }
                //        if (companydata.CompanyName?.ToLower()?.Trim().Replace("\u00A0", "").Replace("\u200B", "").Replace(" ", "") != parts[4].ToLower()?.Trim().Replace("\u00A0", "").Replace("\u200B", "").Replace(" ", ""))
                //        {
                //            return BadRequest(new { status = false, msg = "company name not matched this registration number" });
                //        }
                //        var date = DateTime.ParseExact(parts[2], new[] { "d/M/yyyy", "dd/MM/yyyy" }, CultureInfo.InvariantCulture, DateTimeStyles.None);

                //        c3Data.Header = new ProcessC3header
                //        {
                //            RegNo = parts[1],
                //            PerioddMonth = date.Month.ToString(),
                //            PeriodYear = date.Year.ToString(),
                //            //VERSION = parts[3],
                //            //COMPANY = parts[4]
                //        };
                //    }
                //}

                //if (obj.val1 == null)
                //{
                //    var checkOverwrite = await CheckC3Created(Convert.ToInt32(c3Data.Header.PeriodYear), Convert.ToInt32(c3Data.Header.PerioddMonth), obj.companyId);
                //    if (checkOverwrite is OkObjectResult okResult)
                //    {
                //        var data = okResult.Value as ResponseModel;
                //        if (data.Data != null)
                //        {
                //            return Ok(new { status = data.Status, msg = data.Message, data = data.Data });
                //        }

                //    }
                //}
                //if (obj.val2 == null)
                //{

                //    var isC3Created = _context.ProcessC3headers.Where(e => e.PerioddMonth == c3Data.Header.PerioddMonth && e.PeriodYear == c3Data.Header.PeriodYear && e.EmployerId == obj.companyId && e.ForDirector == false)?.OrderByDescending(e => e.ScheduleNo)?.FirstOrDefault();
                //    string msg = isC3Created != null && (isC3Created.IsSubmitted ?? false) ? "C3 has already been submitted for this month.Do you want to create a new C3 with another schedule " + (isC3Created.ScheduleNo + 1) : "";
                //    if (msg != "")
                //    {
                //        return Ok(new
                //        {
                //            Status = true,
                //            // Message = "Data Get successfully.",
                //            Msg = msg,
                //            Statuscode = 200
                //        });
                //    }
                //}


                var parsedData = await _C3.ParseC3File(reportPath, obj.companyId, obj.userId);
                    if (parsedData.Status == true)
                {
                    //var resposnse = await SaveNContinue(parsedData.Data);
                    //var h = JsonConvert.SerializeObject(parsedData.Data);
                    //var c3reponse = resposnse.Value as ResponseModel;
                    //if (c3reponse.Status == true)
                    //{
                    //    int hId = Convert.ToInt32(c3reponse.Data);
                    //    var header = _context.ProcessC3he/aders.FirstOrDefault(e => e.C3headerid == hId);

                    //    header.isImportC3file = true;
                    //    header.ImportC3Filepath = reportPath;
                    //    _context.SaveChanges();

                    return Ok(new { status = true, message = "C3 file processed successfully", data = parsedData.Data });
                    // }
                    //return BadRequest(new { status = true, message = "File Not generate c3" });
                }
                else
                {

                    return BadRequest(new { status = false, message = parsedData.Message, data = parsedData.Data });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new { Status = false, Message = "Something Went Wrong..!", Data = ex });
            }


        }


        [HttpPost("validateC3FileEmp")]
        public async Task<IActionResult> validateC3FileEmp(List<C3Contributions> data, int userid, int companyId)
        {
            try
            {
                var AllpayPeriod = JsonConvert.DeserializeObject<List<PayPeriods>>("[{ \"Key\":\"W - Weekly\",\"Value\":\"W\"}, { \"Key\":\"M - Monthly\",\"Value\":\"M\"}, { \"Key\":\"E2W - Every Two Weeks\",\"Value\":\"E2W\"}, { \"Key\":\"2M - Twice Monthly\",\"Value\":\"2M\"}]");

                var userpass = _context.Secusers.FirstOrDefault(e => e.UserId == userid);

                var chklocalemp = data.Where(e => !_context.MasterEmployees.Any(m => m.SocSecNum == e.SSN && m.IsdirectorOnly == false && m.CompanyId == companyId)).ToList();
                await _C3.empAddthroughFile(chklocalemp, userid, companyId, userpass);
                var chklocalempAfterApicall = _context.MasterEmployees.Where(e => e.CompanyId == companyId && e.IsdirectorOnly == false && data.Select(m => m.SSN).ToList().Contains(e.SocSecNum)).ToList();
                var validationList = new List<EmployeeValidationError>();
                foreach (var item in data)
                {
                    string[] formats = { "dd/M/yyyy", "dd/MM/yyyy" };
                    int daysin_month = DateTime.DaysInMonth(int.Parse(item.Period_year), int.Parse(item.period_Month));
                    DateTime? Todaydate = DateTime.ParseExact(("01/" + item.period_Month + "/" + item.Period_year), formats, CultureInfo.InvariantCulture);
                    DateTime? end_date = Todaydate != null ? (DateTime?)((DateTime)Todaydate).AddDays(daysin_month - 1) : null;
                    var errors = new List<string>();
                    var fillmissingdata = chklocalempAfterApicall.FirstOrDefault(e => e.SocSecNum == item.SSN);
                    if (fillmissingdata != null)
                    {
                        if (string.IsNullOrEmpty(fillmissingdata.PayPeriod))
                        {
                            //var payperiod = item.PayFreq == "1" ? "W" : item.PayFreq == "2" ? "E2W" : item.PayFreq == "3" ? "M" : item.PayFreq == "4" ? "2M" : "";
                            //item.PayFreq = AllpayPeriod.FirstOrDefault(x => x.Value == payperiod)?.Value;
                            //item.PayPeriod = AllpayPeriod.FirstOrDefault(x => x.Value == payperiod)?.Key;
                            fillmissingdata.PayPeriod = item.PayFreq;
                            _context.SaveChanges();
                        }

                        item.BirthDate = fillmissingdata.BirthDate?.ToString("yyyy-MM-dd");
                        item.EmployeeId = fillmissingdata.EmployeeId;
                        //item.PayFreq = fillmissingdata.PayPeriod;
                        //item.PayPeriod = AllpayPeriod.FirstOrDefault(x => x.Value == fillmissingdata.PayPeriod)?.Key;
                        item.EmpSalary = _context.MasterEmployeeIncomes.FirstOrDefault(e => e.EmployeeId == fillmissingdata.EmployeeId).IncRate;

                    

                        var parts = (item.EmployeeName ?? "").TrimStart().TrimEnd().Split(' ', 2);
                        // 1. FIRST NAME
                        if (!string.Equals(parts[0]?.ToLower()?.Trim(), fillmissingdata.FirstName?.Trim(), StringComparison.OrdinalIgnoreCase))
                        {
                            errors.Add($"First Name mismatch: C3file='{parts[0]?.ToLower()?.Trim()}' localSystem='{fillmissingdata.FirstName}'");
                        }

                        if (item.BONUS.HasValue && item.BONUS.Value != 0 && errors.Count == 0)
                        {

                            var msg = await _C3.SaveBonus(item, new BonusVM { Amount = item.BONUS ?? 0, CompanyId = companyId, PayDate = new DateTime(int.Parse(item.Period_year), int.Parse(item.period_Month), 1), EMPLOYEESSN = item.SSN + "(" + item.EmployeeName + ")" });
                            if (msg.Statuscode != 200)
                            {
                                if (msg.Statuscode == 409)
                                {
                                    var bonusid = _context.BonusPayDetails.Where(e => e.PerioddMonth == item.period_Month && e.PeriodYear == item.Period_year && e.EmployeeId == Convert.ToInt32(item.SSN)).Select(r => r.BonusPayId).FirstOrDefault();
                                    msg = await _C3.UpdateBonus(new BonusVM { PayId = bonusid, Amount = item.BONUS ?? 0, CompanyId = companyId, PayDate = DateTime.Now.Date, EMPLOYEESSN = item.SSN + "(" + item.EmployeeName + ")" });
                                    if (msg.Statuscode != 200)
                                    {
                                        errors.Add(msg.Message);
                                    }

                                }
                                else
                                {

                                    errors.Add(msg.Message);
                                }
                            }


                        }

                        if (item.HPAY.HasValue && item.HPAY.Value != 0 && errors.Count == 0)
                        {
                            var model = new HolidayPayDatesVm
                            {
                                IsWorkingDirector = false,
                                from_date = Todaydate,
                                to_date = end_date,
                                employeinmode = 0,
                                Amount = item.BONUS ?? 0,
                                CompanyId = companyId,
                                PayDate = null,
                                Emp_Name = item.SSN + "(" + item.EmployeeName + ")",
                                HolidayPayLeaveOther = false,
                                HolidayPayWithLeave = true,
                            };

                            var msg = await SaveEmployeeHoliday(model);
                            if (msg.Statuscode != 200)
                            {
                                if (msg.Statuscode == 409)
                                {

                                    var result = _context.MasterHolidayPayDetails
        .Where(x => x.CompanyId == 177 && x.EmployeeId == 220258 && x.IsWithoutLeave == true &&
                 (
                     (Todaydate >= x.StartDate && Todaydate <= x.EndDate) ||
                     (end_date >= x.StartDate && end_date <= x.EndDate) ||
                     (x.StartDate >= Todaydate && x.StartDate <= end_date) ||
                     (x.EndDate >= Todaydate && x.EndDate <= end_date)
                 )).Select(x => x.HolidayPayId).ToList();

                                    model.holidaypayId = result.FirstOrDefault();

                                    var bonusid = _context.BonusPayDetails.Where(e => e.PerioddMonth == item.period_Month && e.PeriodYear == item.Period_year && e.EmployeeId == Convert.ToInt32(item.SSN)).Select(r => r.BonusPayId).FirstOrDefault();
                                    msg = await UpdateEmployeeHoliday(model);
                                    if (msg.Statuscode != 200)
                                    {
                                        errors.Add(msg.Message);
                                    }
                                }
                                else
                                {

                                    errors.Add(msg.Message);
                                }
                            }
                        }


                        // 2. LAST NAME
                        if (!string.Equals(parts.Length == 1?"": parts[1]?.ToLower()?.Trim(), fillmissingdata.LastName?.Trim(), StringComparison.OrdinalIgnoreCase))
                        {
                            errors.Add($"Last Name mismatch: file='{(parts.Length == 1 ? "": parts[1]?.ToLower()?.Trim())}' localSystem='{fillmissingdata.LastName}'");
                        }



                        if (!string.IsNullOrEmpty(item.Date_Joining) && (item.Date_Joining == null || Convert.ToDateTime(item.Date_Joining) >= end_date))
                        {
                            errors.Add($"date Joining is Greater than c3 Geneate date");
                        }
                        if (!string.IsNullOrEmpty(item.Date_terminated) && (item.Date_terminated == null || Convert.ToDateTime(item.Date_terminated) <= Todaydate))
                        {
                            errors.Add($"date terminated is smaller than c3 Geneate date");
                        }

                        // 3. PAY PERIOD
                        // item.PayPeriod = API Key, fillmissingdata.PayPeriod = DB value
                        //if (!string.Equals(item.PayFreq?.Trim(), fillmissingdata.PayPeriod?.Trim(), StringComparison.OrdinalIgnoreCase))
                        //{
                        //    errors.Add($"PayPeriod mismatch: file='{item.PayFreq}' localSystem='{fillmissingdata.PayPeriod}'");
                        //}
                        if (string.IsNullOrEmpty(item.PayPeriod?.Trim()))
                        {
                            errors.Add($"PayPeriod mismatch: file='{item.PayFreq}' localSystem='{AllpayPeriod.FirstOrDefault(x => x.Value == fillmissingdata.PayPeriod)?.Key}'");
                        }
                        if (errors.Any())
                        {
                            validationList.Add(new EmployeeValidationError
                            {
                                SSN = item.SSN,
                                Errors = errors
                            });
                            item.ValidateMsg = string.Join(" , ", validationList.SelectMany(x => x.Errors));
                            return BadRequest(new { status = false, message = "validate Failed", data = new { data, validationList } });
                        }
                        else
                        {
                            fillmissingdata.AppintDate = DateTime.ParseExact(item.Date_Joining, Helper.SQLDateFormat, CultureInfo.InvariantCulture);
                            fillmissingdata.Terminated = DateTime.ParseExact(item.Date_terminated, Helper.SQLDateFormat, CultureInfo.InvariantCulture);
                            fillmissingdata.PayPeriod = item.PayFreq;
                            _context.SaveChanges();
                        }

                            return Ok(new { status = true, message = "validate success", data = data });
                    }
                    else
                    {
                        item.ValidateMsg = "Invalid employee name or SSN";
                        return BadRequest(new { status = false, message = "Invalid employee name or SSN", data = data });
                    }
                }

                return BadRequest(new { status = false, message = "data not found", data = "" });
            }
            catch (Exception ex)
            {

                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new { Status = false, Message = "Something Went Wrong..!", Data = ex });
            }
        }

        [HttpPost("DeleteC3data")]
        public async Task<IActionResult> DeleteC3data(int c3headerid, int userid, string type)
        {
            try
            {
                if (c3headerid <= 0 || userid <= 0 || string.IsNullOrEmpty(type))
                {
                    return BadRequest(new { status = false, message = "please fill required filed", data = "" });
                }

                var data = await _C3.deleteC3(c3headerid, userid, type);
                return data.Status == true ? Ok(data) : BadRequest(data);
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new { Status = false, Message = "Something Went Wrong..!", Data = ex });
            }

        }


    }
}