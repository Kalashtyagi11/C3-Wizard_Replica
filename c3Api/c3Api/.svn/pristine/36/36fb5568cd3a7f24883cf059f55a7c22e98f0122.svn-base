        [HttpGet("btnImportEmp_Click")]
        public async Task<IActionResult> ImportVerifiedDatainSSB(int CompanyId, int UserID)
        {
            if (!C3WizardRepository.Repository.ConnectionInfom.HasConnection() || !C3WizardRepository.Repository.ConnectionInfom.APIConnection(_configuration))
            {
                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = "Check your internet connection OR server may not be responding. Try again later or contact S.S.B for assistance.",
                    Statuscode = 500
                });
            }
            try
            {
                var user = _C3.GetUserDetails(CompanyId, UserID);
                var Emp_surl = _configuration["ServiceConfig:ServiceUriString"];
                string Emp_sURL = $"{Emp_surl}/Employee/employeesByLastC3/{_C3.regno(CompanyId)}";

                using var httpClient = new HttpClient
                {
                    BaseAddress = new Uri(Emp_sURL),
                    Timeout = TimeSpan.FromMinutes(2)
                };

                httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                string credentials = Convert.ToBase64String(_configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : Encoding.UTF8.GetBytes($"{user.ParentUserLoginID}:{user.ParentUser_Password}"));
                httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + credentials);


                var response = await httpClient.GetAsync(Emp_sURL);
                if (response.StatusCode != HttpStatusCode.OK)
                {
                    var apiStatus = JsonConvert.DeserializeObject<Apistatus>(await response.Content.ReadAsStringAsync());
                    return Ok(new ResponseModel { Status = true, Message = apiStatus?.message, Statuscode = 200 });
                }

                var employeeJson = await response.Content.ReadAsStringAsync();
                var employees = JsonConvert.DeserializeObject<List<Employeedetails>>(employeeJson);

                if (employees == null) return Ok(new ResponseModel { Status = false, Message = "No employees found.", Statuscode = 404 });


                int totalEmployees = employees.Count;
                int matchingCount = employees.Count(emp => _C3.ssnisexist(emp.socSecNum.Trim(), CompanyId));

                bool allExist = totalEmployees > 0 && matchingCount == totalEmployees;

                if (allExist)
                {
                    return Conflict(new ResponseModel
                    {
                        Status = false,
                        Message = "All employees already exist in the system.",
                        Statuscode = 409
                    });
                }
                var tasks = employees.Where(emp => !_C3.ssnisexist(emp.socSecNum.Trim(), CompanyId)).Select(emp => Task.Run(() => _C3.ProcessEmployee(emp, CompanyId)));


                await Task.WhenAll(tasks);

                return Ok(new ResponseModel
                {
                    Status = true,
                    Message = "Employees imported successfully from Last Submitted C3.",
                    Statuscode = 200
                });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new ResponseModel { Status = false, Message = ex.Message, Statuscode = 500 });
            }
        }

        [HttpGet("btn_DownloadSubmittedC3_Click")]
