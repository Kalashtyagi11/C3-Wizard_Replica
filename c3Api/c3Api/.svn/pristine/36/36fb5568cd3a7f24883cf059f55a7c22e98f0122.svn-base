                                        //decimal w5_hpay = isWeekfifth ? _C3.LoadHpay(holidayPayDates[3].holidayPay_Date, emp.SSN, yearValue, monthIndex, obj.CompanyId) : 0;
                                        //=======================================================

                                        //========================atul work=============
                                        decimal w1_hpay = _C3.LoadHpay(holidayPayDates[0].holidayPay_Date, emp.SSN, yearValue, monthIndex, obj.CompanyId);
                                        decimal w2_hpay = _C3.LoadHpay(holidayPayDates[1].holidayPay_Date, emp.SSN, yearValue, monthIndex, obj.CompanyId);
