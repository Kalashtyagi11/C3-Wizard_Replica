        bool isWorkingDirector = false;
        /// <summary>
        /// This method is used SaveEmployeeHoliday
        /// </summary>
        /// <param name="c3EmployeeVM"></param>
        /// <returns></returns>
        [HttpGet("GetAllHolidayPayById")]
        public async Task<ResponseModel> GetAllHolidayPayByIdNew(int holidayPayId, int CompanyId, bool holidayPayView = false)
        {
            ResponseModel response = new ResponseModel();
            HolidayPayDatesEdit holidayPay = new HolidayPayDatesEdit();

            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            SqlCommand cmd = new SqlCommand("Holiday_Pay_Select_One", staticConnection);
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add(new SqlParameter("@HolidayPayId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)holidayPayId ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
            DataTable dt = new DataTable();
            sqlAdapter.Fill(dt);
            staticConnection.Close();
            if (dt.Rows.Count > 0)
            {
                isWorkingDirector = (bool)(BLMasterEmployee.MasterEmployeeCollection().ToList()).Where(t => t.SocSecNum == ((string)dt.Rows[0].ItemArray[0]).Substring(0, 6)).ToList().FirstOrDefault().IsemployeeDirector;
                if (isWorkingDirector)
                {
                    //WokingEmployeelist();
                    holidayPay.IsWorkingDirector = true;
                    holidayPay.holidayPayWithLeave = false;
                }
                else
                {
                    //Employeelist();
                    holidayPay.IsWorkingDirector = false;
                }
                holidayPay.Emp_Name = (string)dt.Rows[0].ItemArray[0];
                holidayPay.Amount = dt.Rows[0].ItemArray[3] != DBNull.Value ? Math.Round((decimal)dt.Rows[0].ItemArray[3], 2).ToString() : "0.00";

                holidayPay.HolidayPayId = (int)dt.Rows[0].ItemArray[4];
                try
                {

                    if ((bool)dt.Rows[0].ItemArray[5])
                    {

                        holidayPay.from_date = (DateTime)dt.Rows[0].ItemArray[1];
                        holidayPay.to_date = (DateTime)dt.Rows[0].ItemArray[2];
                        holidayPay.holidayPayWithLeave = true;


                    }
                    else
                    {
                        if (isWorkingDirector)
                        {
                            holidayPay.LeaveType = dt.Rows[0].ItemArray[8].ToString() != "Leave Without Pay" && dt.Rows[0].ItemArray[8].ToString() != "Service Charge" && dt.Rows[0].ItemArray[8].ToString() != "Commission" && dt.Rows[0].ItemArray[8].ToString() != "Director Wages" ? "Other" : dt.Rows[0].ItemArray[8].ToString();
                            if (holidayPay.LeaveType == "Other")
                            {

                                holidayPay.descother = dt.Rows[0].ItemArray[8].ToString();
                            }
                        }
                        else
                        {
                            holidayPay.LeaveType = dt.Rows[0].ItemArray[8].ToString() != "Leave Without Pay" && dt.Rows[0].ItemArray[8].ToString() != "Service Charge" && dt.Rows[0].ItemArray[8].ToString() != "Commission" ? "Other" : dt.Rows[0].ItemArray[8].ToString();
                            if (holidayPay.LeaveType == "Other")
                            {

                                holidayPay.descother = dt.Rows[0].ItemArray[8].ToString();
                            }
                        }

                        holidayPay.HolidayPayLeaveOther = true;

                    }

                }
                catch (Exception ex)
                {
                    var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                    LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                    throw ex;
                }
            }



            if (!holidayPayView)
            {

                var fromMonth = holidayPay?.from_date?.Month;
                var fromYear = holidayPay?.from_date?.Year;
                var toMonth = holidayPay?.to_date?.Month;
                var toYear = holidayPay?.to_date?.Year;

                var checkC3Submitted = _context.ProcessContributions
                    ?.Where(e =>
                        (e.Ssn == holidayPay.Emp_Name.Substring(0, 6) || e.Ssnd == holidayPay.Emp_Name.Substring(0, 6)) && e.IsSubmitted == true &&
                        (
                            (fromMonth.HasValue && fromYear.HasValue &&
                             Convert.ToInt32(e.PerioddMonth) == fromMonth.Value &&
                             Convert.ToInt32(e.PeriodYear) == fromYear.Value) ||

                            (toMonth.HasValue && toYear.HasValue &&
                             Convert.ToInt32(e.PerioddMonth) == toMonth.Value &&
                             Convert.ToInt32(e.PeriodYear) == toYear.Value)
                        )
                    ).ToList();

                if (checkC3Submitted?.Count()!=0 && checkC3Submitted.All(r => r.IsSubmitted == true))
                {
                    response.Message = "You can't update Holiday/Other pay to this employee because this employee submitted record In Bima";
                    response.Status = false;
                    response.Statuscode = 400;
                    return response;
                }

            }



            List<Holiday_Pay_Dates> days_list = new List<Holiday_Pay_Dates>();
            int Sno = 0;
            DataSet dataSetHPD = new DataSet();
            DataTable dtHPD = new DataTable();
            SqlConnection staticConnectionHPD = C3WizardLayerConn_BaseData.StaticSqlConnection;
            staticConnectionHPD.Open();
            SqlCommand cmdHPD = new SqlCommand("select *  from HolidayPayDates where HolidayPayDates.company_ID =" + CompanyId +
                                                " and HolidayPayDates.holidayPayId =" + holidayPayId + " ", staticConnectionHPD);
            cmdHPD.CommandType = CommandType.Text;
            SqlDataAdapter adapterHPD = new SqlDataAdapter();
            adapterHPD.SelectCommand = cmdHPD;
            adapterHPD.Fill(dataSetHPD);
            dtHPD = dataSetHPD.Tables[0];
            staticConnectionHPD.Close();
            if (dtHPD.Rows.Count > 0)
            {
                foreach (DataRow rowHPD in dtHPD.Rows)
                {
                    Holiday_Pay_Dates HPD = new Holiday_Pay_Dates();
                    Sno++;
                    HPD.S_No = Sno;
                    //HPD.Amount = Math.Round((decimal)rowHPD["amount"], 2);
                    HPD.Amount = rowHPD["amount"] != DBNull.Value ? Math.Round((decimal)rowHPD["amount"], 2) : 0.00m; // or any default value you prefer, e.g., 0.00m for decimal

                    //HPD.hodayPay_Date = ((DateTime)rowHPD["holidayPay_Date"]).ToString(Helper.DisplayDateFormat);
                    HPD.hodayPay_Date = rowHPD["holidayPay_Date"] == DBNull.Value ? string.Empty : ((DateTime)rowHPD["holidayPay_Date"]).ToString(Helper.DisplayDateFormat);

                    days_list.Add(HPD);
                    //if ((bool)dt.Rows[0].ItemArray[5] == false)
                    //{
                    //  //holidayPay.PayDate = (DateTime)rowHPD["holidayPay_Date"];
                    //  holidayPay.PayDate = rowHPD["holidayPay_Date"] == DBNull.Value? (DateTime?)null: (DateTime)rowHPD["holidayPay_Date"];

                    //}

                    if (dt.Rows.Count > 0 && dt.Rows[0].ItemArray.Length > 5)
                    {
                        object value = dt.Rows[0].ItemArray[5];
                        if (value != DBNull.Value && Convert.ToBoolean(value) == false)
                        {
                            holidayPay.PayDate = rowHPD["holidayPay_Date"] == DBNull.Value ? (DateTime?)null : (DateTime)rowHPD["holidayPay_Date"];
                        }
                    }

                    staticConnectionHPD.Close();
                }
            }
            holidayPay.Holiday_Pay_Date = days_list;
            response.Message = "Data Retrived Successfully!";
            response.Status = true;
            response.Statuscode = 200;
            response.Data = holidayPay;
            return response;


        }














