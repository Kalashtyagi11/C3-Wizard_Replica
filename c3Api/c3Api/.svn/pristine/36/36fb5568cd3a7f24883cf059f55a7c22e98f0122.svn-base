                                                emp.WAGES4 = false ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES4))) : isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES4 + w4_hpay))) : decimal.Parse(String.Format("{0:0.00}", (emp.WAGES4 + w4_hpay + w5_hpay)));
                                                emp.WAGES5 = false && isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES5))) : isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES5 + w5_hpay))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
