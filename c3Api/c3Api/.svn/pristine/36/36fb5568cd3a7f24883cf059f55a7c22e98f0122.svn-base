        [HttpPost]
        [Route("SaveNContinue")]
        ///public async Task<IActionResult> SaveNContinue(List<PayPeriod> CmbPayPeriod, int CompanyId, int monthno, string Month, string Year, bool isSave, bool is_preview, bool IsLevyExempt, bool isrecordEdit, string TextChanged, bool ListHavingItems, string User_Name, int UserID)
        public async Task<IActionResult> SaveNContinue([FromBody] SaveNContinueRequest request)
        {
            ListHavingItems = request.isNilReturn || request.AllEmployeeList_List.Count != 0;
            request.MonthName = _C3.MonthName2(request.MonthName);
            bool isclearprass = false;
            bool W_SPP = false; bool E_2W_SPP = false; bool M_SPP = false; bool T_M_SPP = false;
            string errormessage = "";
            if (request.Year != "0" && request.Year != null)
            {
                errormessage = "Please select your  Year ";
            }
            if (request.MonthName != null)
            {
                errormessage = "\n Please select your  Month ";
            }

            if (errormessage == null || errormessage == "")
            {
                return Ok(new ResponseModel
                {
                    Status = false,
                    Message = errormessage,
                    Data = null,
                    Statuscode = 200
                });
            }
            int mondays = 0;
            mondays = _C3.MondaysInMonth(request.Monthno, int.Parse(request.Year));
            IsWeekfifth = mondays == 5 ? true : false;

            string fyear = request.Year.ToString();
            int fmonthno = request.Monthno;
            //string fMvalue = request.MonthName;
            string fmonthval = fmonthno <= 9 ? "0" + fmonthno.ToString() : fmonthno.ToString();
            DateTime? newFrom_date = DateTime.ParseExact(("01/" + fmonthval + "/" + fyear), Helper.DateFormat, CultureInfo.InvariantCulture);
            int daysfMonth = DateTime.DaysInMonth(int.Parse(fyear), fmonthno);
            DateTime? newTo_date = newFrom_date.Value.AddDays(daysfMonth - 1);
            ViewModelMaster_Setting_Rates_Rates Master_Setting_Rates_Rates = _C3.Get_Master_Setting_Rates_Rates(newFrom_date, newTo_date);
            DecemberBonusSetting bonusSetting = _C3.DecemberBonusSetting(fyear, request.Monthno);
            UserVM CompanyDetails = _C3.GetCompanyDetails(request.CompanyId);

            List<C3Contributions> Not_Selected_list = new List<C3Contributions>();
            //List<C3Contributions> request.AllEmployeeList_List = _C3.LoadEmployee(request.CompanyId, request.Monthno, request.Year, request.CmbPayPeriod);
            try
            {
                #region Paytype 
                bool w = false; bool m = false; bool b = false; bool s = false;
                bool Nw = false; bool Nm = false; bool Nb = false; bool Ns = false;


                foreach (var item in request.CmbPayPeriod)
                {
                    if (item.Value == "W")
                    { Nw = true; W_SPP = true; }
                    else if (item.Value == "M")
                    { Nm = true; M_SPP = true; }
                    // else if (item.Value == "B") Old
                    else if (item.Value == "E2W")
                    { Nb = true; E_2W_SPP = true; }
                    //else if (item.Value == "S") Old
                    else if (item.Value == "2M")
                    { Ns = true; T_M_SPP = true; }

                    if (item.Value == "W")
                    { w = true; W_SPP = true; }
                    else if (item.Value == "M")
                    { m = true; M_SPP = true; }
                    //else if (item.Value == "B")
                    else if (item.Value == "E2W")
                    { b = true; E_2W_SPP = true; }
                    //else if (item.Value == "S") old
                    else if (item.Value == "2M")
                    { s = true; T_M_SPP = true; }
                    else if (item.Value == "All")
                    {
                        Nw = true; W_SPP = true;
                        Nm = true; M_SPP = true;
                        Nb = true; E_2W_SPP = true;
                        Ns = true; T_M_SPP = true;

                        w = true; W_SPP = true;
                        m = true; M_SPP = true;
                        b = true; E_2W_SPP = true;
                        s = true; T_M_SPP = true;
                    }
                }
                if (request.H_Id != 0)
                {
                    string Payperiodchange = "";
                    Payperiodchange += W_SPP == Nw ? "" : "Weekly";
                    Payperiodchange += M_SPP == Nm ? "" : "Monthly";
                    Payperiodchange += E_2W_SPP == Nb ? "" : "Every Two Weeks";
                    Payperiodchange += T_M_SPP == Ns ? "" : "Twice in a Month";

                    if (Payperiodchange != "")
                    {
                        return BadRequest(new
                        {
                            Message = "Please click on Create button to fetch the data for the selected period."
                        });
                    }
                }
                else
                {
                    string Payperiodchange = "";
                    Payperiodchange += W_SPP == Nw ? "" : "Weekly";
                    Payperiodchange += M_SPP == Nm ? "" : "Monthly";
                    Payperiodchange += E_2W_SPP == Nb ? "" : "Every Two Weeks";
                    Payperiodchange += T_M_SPP == Ns ? "" : "Twice in a Month";

                    if (Payperiodchange != "")
                    {
                        return BadRequest(new
                        {
                            Message = "Please click on Create button to fetch the data for selected period."
                        });
                    }
                }
                #endregion
                //ComboBoxItem typeItem = (ComboBoxItem)CmbYear.SelectedItem;
                //string value = typeItem.Content.ToString();
                string value = request.Year;
                request.schedule_no = _C3.GetMaxScheduleNo(request.Monthno, Convert.ToInt32(value), request.CompanyId,0);
                if (request.H_Id == 0)
                {
                    #region CheckC3Createdofselectedmonth
                    SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                    if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                    SqlCommand cmd = new SqlCommand("check_C3Created", staticConnection);
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)request.Monthno ?? (object)DBNull.Value));
                    cmd.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)value ?? (object)DBNull.Value));
                    cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)request.CompanyId ?? (object)DBNull.Value));
                    SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                    DataTable dt = new DataTable();
                    sqlAdapter.Fill(dt);
                    staticConnection.Close();
                    if (dt.Rows.Count > 0)
                    {
                        if (request.IsSave)
                        {
                            DataRow row = dt.Rows[0];
                            //return Ok(new ResponseModel
                            //{
                            //  Status = false,
                            //  Message = "A C3 for this month  already exists .",
                            //  Data = null,
                            //  Statuscode = 200
                            //});
                            request.H_Id = Convert.ToInt32(row["C3HEADERID"]);
                            request.schedule_no = Convert.ToInt32(row["Schedule_NO"]);


                            //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                            //if (C3WizardMessageBox.Show("C3 Wizard", "A C3 for the month " + Mvalue + " " + value + " already exists, would \n you like to create a new C3 schedule?", MessageBoxButton.YesNo, MessageBoxImage.Warning) == MessageBoxResult.No)
                            //{
                            //  return;

                            //}
                        }
