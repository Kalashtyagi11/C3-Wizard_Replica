                                                emp.WAGES5 = false && isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES5))) : isWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (emp.WAGES5 + w1_hpay + w2_hpay + w3_hpay + w4_hpay + w5_hpay))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
