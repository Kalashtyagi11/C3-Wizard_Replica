        [HttpPost]
        [Route("AddDirectorWagesHolidayPay")]
        public async Task<IActionResult> AddDirectorWagesHolidayPay([FromBody] HolidayPayRequest request)
        {
            try
            {
                if (request == null || string.IsNullOrWhiteSpace(request.EmployeeSSN))
                {

                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                        Message = $"Invalid request data",
                        Statuscode = 400
                    });
                }

                string ssno = request.EmployeeSSN.Substring(0, 6);
                int employeeId = int.Parse(ssno);

                var employees = BLMasterEmployee.MasterEmployeeCollection_grid(request.CompanyId)
                                                 .Where(x => x.SocSecNum == ssno)
                                                 .ToList();

                if (!employees.Any())
                {
                    return NotFound(new ResponseModel
                    {
                        Status = false,
                        Message = $"Employee Not Found!",
                        Statuscode = 404,
                        Data = employees
                    });
                }

                // Check employment conditions
                var employee = employees.FirstOrDefault();
                if (employee.Terminated.HasValue && employee.Terminated <= request.Pay_date)
                {
                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                        Message = $"Cannot pay holiday pay. Employee was terminated on {employee.Terminated.Value:dd/MM/yyyy}",
                        Statuscode = 400
                    });
                }
                if (employee.AppintDate.HasValue && employee.AppintDate >= request.Pay_date)
                {
                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                        Message = $"Cannot pay holiday pay. Employee was appointed on {employee.AppintDate.Value:dd/MM/yyyy}",
                        Statuscode = 400
                    });
                }

                // Calculate Holiday Pay details
                int monthNo = request.Pay_date.Month;
                int year = request.Pay_date.Year;
                int daysInMonth = DateTime.DaysInMonth(year, monthNo);
                DateTime startDate = new DateTime(year, monthNo, 1);
                DateTime endDate = startDate.AddDays(daysInMonth - 1);

                string holidayPayType = request.IsWorkingDirector ? request.WHpayType : request.HpayType;
                string otherPayType = holidayPayType == "Other" ? request.Txt_Other : holidayPayType;

                // Prepare database connection
                using (SqlConnection connection = new SqlConnection(_configuration.GetConnectionString("DefaultConnection")))
                {
                    await connection.OpenAsync();

                    // Insert Holiday Pay Record
                    using (SqlCommand cmd = new SqlCommand("Holiday_Pay_Insert_One", connection))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@From_Date", startDate);
                        cmd.Parameters.AddWithValue("@To_Date", endDate);
                        cmd.Parameters.AddWithValue("@Amount", request.Amount);
                        cmd.Parameters.AddWithValue("@EmployeeId", employeeId);
                        cmd.Parameters.AddWithValue("@CompanyId", request.CompanyId);
                        cmd.Parameters.AddWithValue("@PayNoOfTimes", 1);
                        cmd.Parameters.AddWithValue("@EmployeeDetails", request.EmployeeSSN);
                        cmd.Parameters.AddWithValue("@insertedon", DateTime.Now);
                        cmd.Parameters.AddWithValue("@updateon", DateTime.Now);
                        cmd.Parameters.AddWithValue("@IsWithoutLeave", false);
                        cmd.Parameters.AddWithValue("@PERIODD_MONTH", monthNo);
                        cmd.Parameters.AddWithValue("@PERIOD_YEAR", year);
                        cmd.Parameters.AddWithValue("@otherHpaydes", otherPayType);

                        int holidayPayId = Convert.ToInt32(await cmd.ExecuteScalarAsync());

                        using (SqlCommand cmddates = new SqlCommand("Holiday_Pay_Dates_Insert_One", connection))
                        {
                            cmddates.CommandType = CommandType.StoredProcedure;
                            cmddates.Parameters.AddWithValue("@HolidayPayId", holidayPayId);
                            cmddates.Parameters.AddWithValue("@EmployeeId", employeeId);
                            cmddates.Parameters.AddWithValue("@CompanyId", request.CompanyId);
                            cmddates.Parameters.AddWithValue("@Amount", request.Amount);
                            cmddates.Parameters.AddWithValue("@HolidayPayDate", request.Pay_date);
                            await cmddates.ExecuteNonQueryAsync();
                        }
                    }
                    await connection.CloseAsync();
                }

                return Ok(new ResponseModel
                {
                    Status = true,
                    Message = "Holiday Pay successfully saved.",
                    Statuscode = 200
                });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new ResponseModel { Status = false, Message = "Internal Server Error: " + ex.Message, Statuscode = 500 });
            }
        }
        [HttpGet("GetHolidayPayByEmployee")]
        public async Task<IActionResult> GetHolidayPayByEmployee(string employee, int? CompanyId)
        {
            try
            {
                string connectionString = _configuration.GetConnectionString("DefaultConnection");
                int employeeid = int.Parse(employee.Substring(0, 6));
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                List<Holiday_Pay_Details> userlist = new List<Holiday_Pay_Details>();
                SqlCommand cmd = new SqlCommand("Holiday_Pay_Employee_Select_All", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                DataTable dt = new DataTable();
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                sqlAdapter.Fill(dt);
                staticConnection.Close();
                if (dt.Rows.Count > 0)
                {
                    for (int i = 0; i < dt.Rows.Count; i++)
                    {
                        if (employeeid == (int)dt.Rows[i].ItemArray[1])
                        {
                            Holiday_Pay_Details hpd = new Holiday_Pay_Details();
                            hpd.holidayPayId = (int)dt.Rows[i].ItemArray[0];
                            hpd.employeeID = (int)dt.Rows[i].ItemArray[1];
                            hpd.company_ID = (int)dt.Rows[i].ItemArray[2];
                            hpd.Amount = Math.Round((decimal)dt.Rows[i].ItemArray[3], 2);
                            hpd.st_Date = (string)dt.Rows[i].ItemArray[4];
                            hpd.en_Date = (string)dt.Rows[i].ItemArray[5];
                            hpd.PayNoOfTimes = (int)dt.Rows[i].ItemArray[6];
                            hpd.PayStatus = dt.Rows[i].ItemArray[7] != null ? true : false;
                            hpd.employeename = (string)dt.Rows[i].ItemArray[8];
                            hpd.emptype = dt.Rows[i].ItemArray[9].ToString();
                            hpd.IsWithoutLeave = dt.Rows[i].ItemArray[10].ToString() == "True" ? "Holiday Pay With Leave" : dt.Rows[i].ItemArray[11].ToString();
                            // hpd.Year =YearName(int.Parse((hpd.st_Date).Substring(6, 4)));
                            hpd.yearName = (hpd.st_Date).Substring(6, 4);
                            //hpd.updateon = dt.Rows[i].ItemArray[10]!= null ? (DateTime?)dt.Rows[i].ItemArray[10]:null;
                            userlist.Add(hpd);
                        }
                    }
                }

                return Ok(new ResponseModel
                {
                    Status = false,
                    Message = "Data fatch Successfully",
                    Statuscode = 500,
                    Data = userlist.OrderByDescending(x => x.updateon)
                });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return Ok(new ResponseModel
                {
                    Status = false,
                    Message = ex.Message,
                    Statuscode = 500
                });

            }
        }
