        [HttpGet]
        [Route("GetC3Reports/{companyId}")]
        public async Task<IActionResult> GetC3Reports(int companyId)
        {
            try
            {
                var users = await _C3.GetC3ReportsAlldata(companyId);

                if (users != null && users.Any()) // Check if data exists
                {
                    return Ok(new ResponseModel
                    {
                        Status = true,
                        Message = "Data Get successfully.",
                        Data = users,
                        Statuscode = 200
                    });
                }
                else
                {
                    return NotFound(new ResponseModel
                    {
                        Status = false,
                        Message = "No data found.",
                        Data = null,
                        Statuscode = 200
                    });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = $"Internal server error: {ex.Message}",
                    Data = null,
                    Statuscode = 500
                });
            }
        }
