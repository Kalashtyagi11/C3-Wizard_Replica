        public async Task<string?> getNotesC3(int headerid, string type)
        {
            if (type == "comp")
            {
                return await _DbContext.ProcessC3headers.Where(x => x.C3headerid == headerid)
                               .Select(x => x.Notes).FirstOrDefaultAsync();
            }
            else
            {
                return await _DbContext.ProcessSelfEmployedC3s.Where(x => x.Sec3id == headerid)
                             .Select(x => x.Notes).FirstOrDefaultAsync();
            }
        }


        public async Task<string?> statusChkBimaIsVerified(string payerId, string month, string year, int scheduleno, Secuser user, bool forDir)
        {

            string Emp_surl = _configuration["ServiceConfig:ServiceUriString"];
            string Emp_sURL = string.Empty;
            if (user.IsSelfEmployee == true)
            {
                Emp_sURL = $"{Emp_surl}/C3/{payerId}/C3Submitted/{month},{year},{scheduleno},ER,{(forDir ? "NW" : "EE")}";
            }
            else
            {
                Emp_sURL = $"{Emp_surl}/C3/{payerId}/C3Submitted/{month},{year},{scheduleno},SE,EE";
            }

            // string Emp_sURL = $"{Emp_surl}/C3/{payerId}/C3Submitted/{month},{year},{scheduleno},ER,EE";
            HttpResponseMessage getresponse;
            using (var gethttpClient = new HttpClient() { BaseAddress = new Uri(Emp_sURL), Timeout = TimeSpan.FromMinutes(2) })
            {
                gethttpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                var getplainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : Encoding.UTF8.GetBytes(user.LoginId + ":" + user.Password);

                string getval = Convert.ToBase64String(getplainTextBytes);
                gethttpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + getval);

                getresponse = await gethttpClient.GetAsync(Emp_sURL);
            }

            if (getresponse.StatusCode == HttpStatusCode.OK)
            {
                var getcustomerJsonString = await getresponse.Content.ReadAsStringAsync();
                var submitC3_model = JsonConvert.DeserializeObject<submitC3string>(getcustomerJsonString);
                return submitC3_model?.c3Header.c3Status == "VAC" ? null : "true";
            }

            var getJsonString = await getresponse.Content.ReadAsStringAsync();
            ApiErrorResponse response = JsonConvert.DeserializeObject<ApiErrorResponse>(getJsonString);
            response.message = response.message?.Replace("\r", "")?.Replace("\n", "")?.Replace("Code       :", "")
             ?.Replace("Message    :", "")
             ?.Replace("Resolution :", "")
             ?.Trim();

            if (response.message.Contains("C3 Not Found"))
            {
                response.message = "true";
            }
            return response.message;


        }

        public class ApiErrorResponse
        {
            public string httpStatus { get; set; }
            public string message { get; set; }
            public string timeStamp { get; set; }
            public string path { get; set; }
            public string error { get; set; }
            public int status { get; set; }
        }
        public async Task<Tuple<bool?, string>> statusChangeMainC3Table(int headerid, int companyid, string notes, int userId, string type)
        {
            var paymentchk = _DbContext.OnlinePayments?.Where(e => e.C3HeaderId == headerid).ToList();
            if (paymentchk!.All(e => e.PaymentStatus != "AUTHORIZED"))
            {
                if (type == "comp")
                {
                    var header = _DbContext.ProcessC3headers?.FirstOrDefault(e => e.C3headerid == headerid && e.EmployerId == companyid);
                    var userdata = _DbContext.Secusers?.Where(x => x.UserId == userId);
                    var isAllow = header == null ? "false" : await statusChkBimaIsVerified(header.RegNo, header.PerioddMonth, header.PeriodYear, header.ScheduleNo ?? 0, userdata?.FirstOrDefault(), header.ForDirector ?? false);

                    if (isAllow == null)
                    {
                        return null;
                    }
                    if (isAllow != "true" && isAllow != "false")
                    {
                        return new Tuple<bool?, string>(false, isAllow);
                    }

                    if (header != null && isAllow == "true")
                    {
                        var username = userdata?.Select(x => x.FirstName + " " + x.LastName)?.FirstOrDefault();
                        string newEntry = $"{DateTime.Now.ToString("dd/MMM/yyyy", System.Globalization.CultureInfo.InvariantCulture).ToLower()}, by {username}, {header.IsSubmitted} ---> {false}, {notes?.Trim()}";
                        if (string.IsNullOrEmpty(header.Notes))
                        {
                            header.Notes = newEntry;
                        }
                        else
                        {
                            header.Notes += "," + newEntry;
                        }

                        header.IsSubmitted = false;
                        header.EditPermittedBy = userId;
                        header.IsSentForEdit = true;
                        header.SentOnForEdit = DateTime.Now;

                        var details = _DbContext.ProcessContributions.Where(e => e.C3headerid == header.C3headerid).ToList();

                        if (details != null && details.Any())
                        {
                            foreach (var item in details)
                            {
                                item.IsSubmitted = false;

                            }
                        }

                        _DbContext.SaveChanges();
                        return new Tuple<bool?, string>(true, "");
                    }
                }
                if (type == "self")
                {
                    var header = _DbContext.ProcessSelfEmployedC3s?.FirstOrDefault(e => e.Sec3id == headerid);

                    if (header != null)
                    {
                        var userdata = _DbContext.Secusers?.Where(x => x.UserId == userId);
                        var isAllow  =await statusChkBimaIsVerified(header.Ssn, header.PerioddMonth, header.PeriodYear, header.ScheduleNo ?? 0, userdata?.FirstOrDefault(), false);

                        if (isAllow == null)
                        {
                            return null;
                        }

                        if (isAllow != "true" && isAllow != "false")
                        {
                            return new Tuple<bool?, string>(false, isAllow);
                        }

                        if (isAllow=="true")
                        {
                            var username = userdata?.Select(x => x.FirstName + " " + x.LastName)?.FirstOrDefault();
                            string newEntry = $"{DateTime.Now.ToString("dd/MMM/yyyy", System.Globalization.CultureInfo.InvariantCulture).ToLower()}, by {username}, {header.IsSubmitted} ---> {false}, {notes?.Trim()}";
                            if (string.IsNullOrEmpty(header.Notes))
                            {
                                header.Notes = newEntry;
                            }
                            else
                            {
                                header.Notes += "," + newEntry;
                            }

                            header.IsSubmitted = false;
                            header.EditPermittedBy = userId;
                            header.IsSentForEdit = true;
                            header.SentOnForEdit = DateTime.Now;

                            _DbContext.SaveChanges(); 
                        }
                        return new Tuple<bool?, string>(true, "");
                    }
                }
            }

            return new Tuple<bool?, string>(true, "");
        }


        public string MonthName(string m_no)
        {
            string Month = "";
            switch (m_no)
            {
                //case "1" or "0":
                //    Month = "January";
                //    break;
                case "1":
                    Month = "January";
                    break;
                case "2":
                    Month = "February";
                    break;
                case "3":
                    Month = "March";
                    break;
                case "4":
                    Month = "April";
                    break;
                case "5":
                    Month = "May";
                    break;
                case "6":
                    Month = "June";
                    break;
                case "7":
                    Month = "July";
                    break;
                case "8":
                    Month = "August";
                    break;
                case "9":
                    Month = "September";
                    break;
                case "10":
                    Month = "October";
                    break;
                case "11":
                    Month = "November";
                    break;
                case "12":
                    Month = "December";
                    break;
                default:
                    Month = string.Empty;
                    break;
            }


            return Month;
        }

