    public class DashBoardRepo
    {
        private readonly IHttpContextAccessor _httpContextAccessor;
        private readonly C3wizardContext _DbContext;
        private readonly IConfiguration _configuration;
        public DashBoardRepo(IHttpContextAccessor httpContextAccessor, C3wizardContext c3WizardContext, IConfiguration configuration)
        {
            _httpContextAccessor = httpContextAccessor;
            _DbContext = c3WizardContext;
            _configuration = configuration;

        }
        decimal total_con = 0;
        decimal unPaid = 0;
        decimal Director_total_con = 0;
        decimal unPaidDir = 0;
        bool employeec = true, directorc = true;
        string smonth = null, syear = null, dsmonth = null, dsyear = null;
        string pendingempc3 = "";
        string pendingdirc3 = "";
        public async Task<List<PayPeriod1>> load_dashboard(int CompanyId, int? StartMonths, int? endMonths, int? StartYear, int? EndYear, string ResultArea)
        {

            var returnData = new List<PayPeriod1>();
            DateTime Nowdate = DateTime.Now;
            int curmonth = Nowdate.AddMonths(-1).Month;
            int curyear = Nowdate.AddMonths(-1).Year;
            DateTime startDate = new DateTime(curyear, curmonth, 1);
            DateTime endDate = startDate.AddMonths(2).AddDays(-6);
            bool IsLastmonthEMPC3Submitted = false;
            bool IsLastmonthDirC3Submitted = false;
            List<C3Header> listDVOC3Header = new List<C3Header>();
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            SqlCommand cmd = new SqlCommand("get_C3Genrated_data", staticConnection);
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
            DataTable dt = new DataTable();
            sqlAdapter.Fill(dt);
            if (dt.Rows.Count > 0)
            {
                int c3count = 0;
                int Pendingc3count = 0;
                foreach (DataRow row in dt.Rows)
                {

                    c3count++;
                    bool issubmited = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                    string period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : MonthName(row["PERIODD_MONTH"].ToString());
                    string Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString();
                    if (!issubmited)
                    {
                        Pendingc3count++;
                        pendingempc3 = pendingempc3 + " " + period_Month + " " + Period_year + ",";
                    }



                    if (issubmited && period_Month == MonthName((startDate.Month).ToString()) && Period_year == startDate.Year.ToString())
                    {
                        IsLastmonthEMPC3Submitted = true;
                    }
                    //if (c3count <= 12)
                    // {
                    var m = startDate.Month;


                    bool isfinalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                    if (true)//isfinalize == true)
                    {
                        var Obj = new C3Header();

                        Obj.HeaderID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                        Obj.RegNo = Convert.IsDBNull(row["RegNo"]) ? null : row["RegNo"].ToString();
                        Obj.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : MonthName(row["PERIODD_MONTH"].ToString());
                        Obj.p_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? 0 : Convert.ToInt32(row["PERIODD_MONTH"]);
                        Obj.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString();
                        Obj.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
                        Obj.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_SSCONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString())));
                        Obj.TOTALLEVYEEEMPLOYEE = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString())));
                        Obj.TOTALSERVAYANCE = Convert.IsDBNull(row["TOTAL_SERVAYANCE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SERVAYANCE"].ToString())));
                        Obj.TOTALLEVYEEEMPLOYER = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYER"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYER"].ToString())));
                        Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString(Helper.DisplayDateFormat);
                        Obj.Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                        Obj.Is_submitted = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                        Obj.C3_IsFinalized = Convert.IsDBNull(row["C3_IsFinalized"]) ? false : bool.Parse(row["C3_IsFinalized"].ToString());
                        Obj.IsUnLocked = Convert.IsDBNull(row["IsUnLocked"]) ? false : bool.Parse(row["IsUnLocked"].ToString());
                        Obj.IsUnLocked = !Obj.IsUnLocked;
                        Obj.IssubmittedShow = (bool)Obj.Is_submitted ? "C3 Submitted" : "C3 Not Submitted";
                        Obj.Issubmittedcolor = (bool)Obj.Is_submitted ? "Black" : "Red";

                        Obj.IssubmittedShowimg = (bool)Obj.Is_submitted ? "/img/RightSine.png" : "/img/close.png";
                        Obj.C3submittedShow = (bool)Obj.Is_submitted ? "Resubmit C3" : "Submit C3";
                        Obj.C3submittedShowimg = (bool)Obj.Is_submitted ? "/Images/restore.png" : "/Images/finalyze20x20.png";
                        Obj.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                        Obj.TOTALPEPENALTY = Convert.IsDBNull(row["TOTAL_PEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_PEPENALTY"].ToString())));
                        Obj.TOTALSSPENALTY = Convert.IsDBNull(row["TOTAL_SSPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSPENALTY"].ToString())));
                        Obj.TOTALLEVYEEPENALTY = Convert.IsDBNull(row["TOTAL_LEVYEEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEPENALTY"].ToString())));
                        //Obj.IsPaid = _DbContext.OnlinePayments.Any(e => e.C3HeaderId == Obj.HeaderID && e.PaymentStatus == "AUTHORIZED");
                        var Paymentdetails = _DbContext.OnlinePayments.Where(e => e.C3HeaderId == Obj.HeaderID && e.IsActive && e.TransactionFor != "Self").OrderByDescending(f => f.Id).Select(r => new { r.PaymentStatus });
                        Obj.IsPaid = Paymentdetails.Any(e => e.PaymentStatus == "AUTHORIZED" || e.PaymentStatus == "Offline Payment");
                        Obj.IsPaidStatus = Paymentdetails?.FirstOrDefault()?.PaymentStatus;
                        Obj.isNilReturn = Convert.IsDBNull(row["isNilReturn"]) ? false : bool.Parse(row["isNilReturn"].ToString());
                        Obj.IsImportFromBEMA = bool.Parse(row["IsImportFromBEMA"].ToString());
                        Obj.Notes = Convert.IsDBNull(row["Notes"]) ? null : row["Notes"].ToString();
                        listDVOC3Header.Add(Obj);
                        //A/ if (employeec || (smonth == Obj.period_Month && syear == Obj.Period_year))
                        if (Obj.IsPaid && Obj.IsImportFromBEMA == false && Obj.Period_year == DateTime.Now.Year.ToString()/*&& Obj.Is_submitted*/)
                        {
                            var EmployeesContribution = "C3 Contribution - " + MonthName(row["PERIODD_MONTH"].ToString());
                            // if (Obj.IsImportFromBEMA)
                            //total_con += Obj.TOTALSSCONTRIBUTIONS + Obj.TOTALLEVYEEEMPLOYEE + Obj.TOTALSERVAYANCE + Obj.TOTALPEPENALTY + Obj.TOTALSSPENALTY + Obj.TOTALLEVYEEPENALTY;// + Obj.TOTALLEVYEEEMPLOYER;
                            //else
                            total_con += Obj.TOTALSSCONTRIBUTIONS + Obj.TOTALLEVYEEEMPLOYEE + Obj.TOTALSERVAYANCE + Obj.TOTALPEPENALTY + Obj.TOTALSSPENALTY + Obj.TOTALLEVYEEPENALTY + Obj.TOTALLEVYEEEMPLOYER;
                            employeec = false;
                            smonth = smonth == null ? Obj.period_Month : smonth;
                            syear = syear == null ? Obj.Period_year : syear;

                            returnData.Add(new PayPeriod1 { Key = "EmployeesContribution", Value = EmployeesContribution });
                        }

                        else if (Obj.Period_year == DateTime.Now.Year.ToString() /*&& Obj.Is_submitted */&& Obj.IsImportFromBEMA == false)
                        {
                            unPaid += Obj.TOTALSSCONTRIBUTIONS + Obj.TOTALLEVYEEEMPLOYEE + Obj.TOTALSERVAYANCE + Obj.TOTALPEPENALTY + Obj.TOTALSSPENALTY + Obj.TOTALLEVYEEPENALTY + Obj.TOTALLEVYEEEMPLOYER;

                        }
                        else
                        {

                        }
                    }
                }
                //}
                //total.Text = "$" + total_con;
                //Pendingc3.Text = Pendingc3count + " Regular employees Remittance(s) not submitted to SSB";

                returnData.Add(new PayPeriod1 { Key = "total", Value = "$" + total_con.ToString("F2") });
                returnData.Add(new PayPeriod1 { Key = "paidMonths", Value = string.Join(" ,", listDVOC3Header.Where(e => e.IsPaid && e.IsImportFromBEMA == false).Select(e => e.period_Month).Distinct()) });

                returnData.Add(new PayPeriod1 { Key = "unPaid", Value = "$" + unPaid.ToString("F2") });
                returnData.Add(new PayPeriod1 { Key = "unPaidMonths", Value = string.Join(" ,", listDVOC3Header.Where(e => !e.IsPaid && e.IsImportFromBEMA == false).Select(e => e.period_Month).Distinct()) });

                returnData.Add(new PayPeriod1 { Key = "Pendingc3", Value = Pendingc3count + " Regular employees Remittance(s) not submitted to SSB" });

                if (Pendingc3count > 0)
                {
                    // Pendingc3.Foreground = Brushes.Red;
                    returnData.Add(new PayPeriod1 { Key = "Pendingc3Foreground", Value = "Red" });
                }
                else
                {
                    // Pendingc3.Foreground = Brushes.Black;
                    returnData.Add(new PayPeriod1 { Key = "Pendingc3Foreground", Value = "black" });
                }



                var DVOC3Header = listDVOC3Header.Select(obj => new
                {
                    HeaderID = obj.HeaderID,
                    RegNo = obj.RegNo,
                    period_Month = obj.period_Month,
                    Period_year = obj.Period_year,
                    TOTAL_WAGES = obj.TOTAL_WAGES,
                    TOTALSSCONTRIBUTIONS = obj.TOTALSSCONTRIBUTIONS,
                    TOTALLEVYEEEMPLOYEE = obj.TOTALLEVYEEEMPLOYEE,
                    TOTALSERVAYANCE = obj.TOTALSERVAYANCE,
                    TOTALLEVYEEEMPLOYER = obj.TOTALLEVYEEEMPLOYER,
                    Insert_Datetimeinfo = obj.Insert_Datetimeinfo,
                    Is_Fianalize = obj.Is_Fianalize,
                    Is_submitted = obj.Is_submitted,
                    C3_IsFinalized = obj.C3_IsFinalized,
                    IsUnLocked = obj.IsUnLocked,
                    IssubmittedShow = obj.IssubmittedShow,
                    Issubmittedcolor = obj.Issubmittedcolor,
                    IssubmittedShowimg = obj.IssubmittedShowimg,
                    C3submittedShow = obj.C3submittedShow,
                    C3submittedShowimg = obj.C3submittedShowimg,
                    Schedule_NO = obj.Schedule_NO,
                    p_Month = obj.p_Month,
                    TOTALPEPENALTY = obj.TOTALPEPENALTY,
                    TOTALSSPENALTY = obj.TOTALSSPENALTY,
                    TOTALLEVYEEPENALTY = obj.TOTALLEVYEEPENALTY,
                    TotalSSBpenanlity = obj.TOTALPEPENALTY + obj.TOTALSSPENALTY + obj.TOTALLEVYEEPENALTY,
                    ispaid = obj.IsPaid,
                    IsImportFromBEMA = obj.IsImportFromBEMA,
                    payAmt = obj.TOTALSSCONTRIBUTIONS + obj.TOTALPEPENALTY + obj.TOTALSSPENALTY + obj.TOTALLEVYEEPENALTY + obj.TOTALLEVYEEEMPLOYEE + obj.TOTALSERVAYANCE
                    + (obj.IsImportFromBEMA ? 0 : obj.TOTALLEVYEEEMPLOYER),
                    IsPaidStatus = obj.IsPaidStatus,
                    obj.isNilReturn,
                    obj.Notes
                });


                var TOTALSSCONTRIBUTIONS = listDVOC3Header[0].TOTALSSCONTRIBUTIONS;
                var TOTALPEPENALTY = listDVOC3Header[0].TOTALPEPENALTY;
                var TOTALSSPENALTY = listDVOC3Header[0].TOTALSSPENALTY;
                var TOTALLEVYEEPENALTY = listDVOC3Header[0].TOTALLEVYEEPENALTY;
                var TOTALLEVYEEEMPLOYEE = listDVOC3Header[0].TOTALLEVYEEEMPLOYEE;


                // if (ResultArea == "R")
                // {
                //   DVOC3Header = DVOC3Header.AsEnumerable();

                //   if (Year != null && Year > 0 && StartMonths != null && StartMonths > 0 &&
                //endYear != null && endYear > 0 && endMonths != null && endMonths > 0)
                //   {
                //     DateTime startDate0 = new DateTime(Year.Value, StartMonths.Value, 1);
                //     DateTime endDate0 = new DateTime(endYear.Value, endMonths.Value, DateTime.DaysInMonth(endYear.Value, endMonths.Value));

                //     DVOC3Header = DVOC3Header.Where(p =>
                //     {
                //       int year = Convert.ToInt32(p.Period_year);
                //       int month = Convert.ToInt32(p.p_Month);
                //       DateTime periodDate = new DateTime(year, month, 1);

                //       return periodDate >= startDate0 && periodDate <= endDate0;
                //     });
                //   }
                // }
                if (ResultArea == "R")
                {
                    DateTime? startDate0 = null;
                    DateTime? endDate0 = null;

                    //if (StartYear != null && StartMonths != null)
                    //{
                    //    startDate0 = new DateTime(StartYear.Value, StartMonths.Value, 1);
                    //}
                    //else if (StartYear != null)
                    //{
                    //    startDate0 = new DateTime(StartYear.Value, 1, 1);
                    //}

                    //if (EndYear != null && endMonths != null)
                    //{
                    //    endDate0 = new DateTime(EndYear.Value, endMonths.Value, DateTime.DaysInMonth(EndYear.Value, endMonths.Value));
                    //}
                    //else if (EndYear != null)
                    //{
                    //    endDate0 = new DateTime(EndYear.Value, 12, 31);
                    //}

                    if (StartYear != null)
                    {
                        if (StartMonths != null)
                            startDate0 = new DateTime(StartYear.Value, StartMonths.Value, 1);
                        else
                            startDate0 = new DateTime(StartYear.Value, 1, 1); // Defaults to Jan if month missing
                    }

                    // Rule: Determine End Date (show until this point)
                    if (EndYear != null)
                    {
                        if (endMonths != null)
                            endDate0 = new DateTime(EndYear.Value, endMonths.Value, DateTime.DaysInMonth(EndYear.Value, endMonths.Value));
                        else
                            endDate0 = new DateTime(EndYear.Value, 12, 31); // Defaults to Dec if month missing
                    }

                    // --- DVOC3Header Filtering ---
                    if (DVOC3Header != null)
                    {
                        DVOC3Header = DVOC3Header.AsEnumerable();

                        if (startDate0 != null || endDate0 != null)
                        {
                            DVOC3Header = DVOC3Header.Where(p =>
                            {
                                int year = Convert.ToInt32(p.Period_year);
                                int month = Convert.ToInt32(p.p_Month);
                                DateTime periodDate = new DateTime(year, month, 1);

                                return (!startDate0.HasValue || periodDate >= startDate0.Value) &&
           (!endDate0.HasValue || periodDate <= endDate0.Value);
                            }).ToList();
                        }
                    }
                }

                returnData.Add(new PayPeriod1 { Key = "dashboard_list", Value = JsonConvert.SerializeObject(DVOC3Header) });
                //dashboard_list.ItemsSource = listDVOC3Header;
                //dashboard_list.SelectedIndex = -1;
                //CollectionView view = (CollectionView)CollectionViewSource.GetDefaultView(dashboard_list.ItemsSource);
                // PropertyGroupDescription groupDescription = new PropertyGroupDescription("Period_year");
                //view.GroupDescriptions.Add(groupDescription);
            }
            else
            {

                //dashboard_list.ItemsSource = null;
                //total.Text = "$" + 0;
                //Pendingc3.Text = 0 + " Regular employees Remittance(s) not submitted to SSB";
                //Pendingc3.Foreground = Brushes.Black;
                returnData.Add(new PayPeriod1 { Key = "dashboard_list", Value = null });
                returnData.Add(new PayPeriod1 { Key = "total", Value = "$" + 0 });
                returnData.Add(new PayPeriod1 { Key = "Pendingc3", Value = 0 + " Regular employees Remittance(s) not submitted to SSB" });
                returnData.Add(new PayPeriod1 { Key = "Pendingc3Foreground", Value = "Black" });
            }

            List<C3Header> Director_listDVOC3Header = new List<C3Header>();
            SqlConnection Director_staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection;
            SqlCommand Director_cmd = new SqlCommand("Get_Director_C3_Genrated_data", staticConnection);
            Director_cmd.CommandType = CommandType.StoredProcedure;
            Director_cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
            SqlDataAdapter Director_sqlAdapter = new SqlDataAdapter(Director_cmd);
            DataTable Director_dt = new DataTable();
            Director_sqlAdapter.Fill(Director_dt);
            if (Director_dt.Rows.Count > 0)
            {
                int D3count = 0;
                int Pendingc3count = 0;
                foreach (DataRow row in Director_dt.Rows)
                {
                    D3count++;
                    bool issubmited = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                    string period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : MonthName(row["PERIODD_MONTH"].ToString());
                    string Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString();
                    if (!issubmited)
                    {
                        Pendingc3count++;
                        pendingdirc3 = pendingdirc3 + " " + period_Month + " " + Period_year + ",";
                    }

                    if (issubmited && period_Month == MonthName((startDate.Month).ToString()) && Period_year == startDate.Year.ToString())
                    {
                        IsLastmonthDirC3Submitted = true;
                    }
                    if (D3count <= 12)
                    {
                        bool isfinalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                        if (true)//isfinalize == true)
                        {
                            C3Header Director_Obj = new C3Header();
                            Director_Obj.HeaderID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                            Director_Obj.RegNo = Convert.IsDBNull(row["RegNo"]) ? null : row["RegNo"].ToString();
                            Director_Obj.p_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? 0 : Convert.ToInt32(row["PERIODD_MONTH"]);
                            Director_Obj.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : MonthName(row["PERIODD_MONTH"].ToString());
                            Director_Obj.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString();
                            Director_Obj.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
                            Director_Obj.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_SSCONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString())));
                            Director_Obj.TOTALLEVYEEEMPLOYEE = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString())));
                            Director_Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString(Helper.DisplayDateFormat);
                            Director_Obj.Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                            Director_Obj.Is_submitted = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                            Director_Obj.C3_IsFinalized = Convert.IsDBNull(row["C3_IsFinalized"]) ? false : bool.Parse(row["C3_IsFinalized"].ToString());
                            Director_Obj.IsUnLocked = Convert.IsDBNull(row["IsUnLocked"]) ? false : bool.Parse(row["IsUnLocked"].ToString());
                            Director_Obj.IsUnLocked = !Director_Obj.IsUnLocked;
                            Director_Obj.IssubmittedShow = (bool)Director_Obj.Is_submitted ? "C3 Submitted" : "C3 not Submitted";
                            Director_Obj.Issubmittedcolor = (bool)Director_Obj.Is_submitted ? "Black" : "Red";
                            Director_Obj.IssubmittedShowimg = (bool)Director_Obj.Is_submitted ? "/img/RightSine.png" : "/img/close.png";
                            Director_Obj.C3submittedShow = (bool)Director_Obj.Is_submitted ? "Resubmit C3" : "Submit C3";
                            Director_Obj.C3submittedShowimg = (bool)Director_Obj.Is_submitted ? "/Images/restore.png" : "/Images/finalyze20x20.png";
                            Director_Obj.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                            Director_Obj.TOTALPEPENALTY = Convert.IsDBNull(row["TOTAL_PEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_PEPENALTY"].ToString())));
                            Director_Obj.TOTALSSPENALTY = Convert.IsDBNull(row["TOTAL_SSPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSPENALTY"].ToString())));
                            Director_Obj.TOTALLEVYEEPENALTY = Convert.IsDBNull(row["TOTAL_LEVYEEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEPENALTY"].ToString())));
                            Director_Obj.IsPaid = _DbContext.OnlinePayments.Any(e => e.C3HeaderId == Director_Obj.HeaderID && (e.PaymentStatus == "AUTHORIZED" || e.PaymentStatus == "Offline Payment"));
                            Director_Obj.isNilReturn = Convert.IsDBNull(row["isNilReturn"]) ? false : bool.Parse(row["isNilReturn"].ToString());
                            var Paymentdetails = _DbContext.OnlinePayments.Where(e => e.C3HeaderId == Director_Obj.HeaderID && e.IsActive && e.TransactionFor != "Self").OrderByDescending(f => f.Id).Select(r => new { r.PaymentStatus });
                            Director_Obj.IsPaid = Paymentdetails.Any(e => e.PaymentStatus == "AUTHORIZED" || e.PaymentStatus == "Offline Payment");
                            Director_Obj.IsPaidStatus = Paymentdetails?.FirstOrDefault()?.PaymentStatus;
                            Director_Obj.Notes = Convert.IsDBNull(row["Notes"]) ? null : row["Notes"].ToString();
                            Director_Obj.IsImportFromBEMA = bool.Parse(row["IsImportFromBEMA"].ToString());
                            Director_listDVOC3Header.Add(Director_Obj);
                            //if (directorc || (dsmonth == Director_Obj.period_Month && dsyear == Director_Obj.Period_year))
                            if (Director_Obj.IsPaid && Director_Obj.Period_year == DateTime.Now.Year.ToString() && Director_Obj.IsImportFromBEMA == false)
                            {
                                var DirectorsContribution = "NW Director Contribution - " + MonthName(row["PERIODD_MONTH"].ToString());
                                Director_total_con += Director_Obj.TOTALSSCONTRIBUTIONS + Director_Obj.TOTALLEVYEEEMPLOYEE + Director_Obj.TOTALLEVYEEPENALTY;
                                directorc = false;
                                dsmonth = dsmonth == null ? Director_Obj.period_Month : dsmonth;
                                dsyear = dsyear == null ? Director_Obj.Period_year : dsyear;

                                returnData.Add(new PayPeriod1 { Key = "DirectorsContribution", Value = DirectorsContribution });

                            }

                            else if (Director_Obj.Period_year == DateTime.Now.Year.ToString() /*&& Obj.Is_submitted */&& Director_Obj.IsImportFromBEMA == false)
                            {
                                unPaidDir += Director_Obj.TOTALSSCONTRIBUTIONS + Director_Obj.TOTALLEVYEEEMPLOYEE + Director_Obj.TOTALLEVYEEPENALTY;
                            }
                            else
                            {

                            }
                        }
                    }
                }
                //Director_total.Text = "$" + Director_total_con;
                //DirectorsPendingC3.Text = Pendingc3count + " Non-Working Director Remittance(s) not submitted to SSB";

                returnData.Add(new PayPeriod1 { Key = "Director_total", Value = "$" + Director_total_con.ToString("F2") });
