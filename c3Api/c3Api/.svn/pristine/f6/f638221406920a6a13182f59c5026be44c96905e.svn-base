        public async Task<AdminDashboardResponse> AdminDashBoard()
        {

            var paidUnpaidList = new List<DashboardSummary>();
            var selfpaidUnpaidList = new List<CompanyPaymentStatus>();
            var companyStatusList = new List<CompanyPaymentStatus>();
            using (var connection = C3WizardLayerConn_BaseData.StaticSqlConnection)
            {
                await connection.OpenAsync();

                using (var command = new SqlCommand("Get_AdminDashBoardNew", connection))
                {
                    command.CommandType = CommandType.StoredProcedure;

                    using (var reader = await command.ExecuteReaderAsync())
                    {
                        // Read first result set (Total Paid & Unpaid by Month)

                        while (await reader.ReadAsync())
                        {
                            paidUnpaidList.Add(new DashboardSummary
                            {
                                PeriodMonth = MonthName(reader["PERIODD_MONTH"]?.ToString()),
                                TotalPaid = Convert.ToDecimal(reader["totalPaid"] ?? 0),
                                TotalUnpaid = Convert.ToDecimal(reader["totalUnpaid"] ?? 0),
                                Types = reader["Types"]?.ToString(),
                                year = reader["PERIOD_YEAR"]?.ToString(),
                                paidEmployer = Convert.ToInt32(reader["PaidEmployer"] ?? 0),
                                unPaidEmployer = Convert.ToInt32(reader["UnpaidEmployer"] ?? 0),

                            });
                        }
                        //var paidAmountC = paidUnpaidList?.FirstOrDefault(e => e.PeriodMonth == DateTime.Now.ToString("MMMM"))?.TotalPaid;
                        //var paidAmountP = paidUnpaidList?.FirstOrDefault(e => e.PeriodMonth == DateTime.Now.AddMonths(-1).ToString("MMMM"))?.TotalPaid;

                        //var unpaidAmountC = paidUnpaidList?.FirstOrDefault(e => e.PeriodMonth == DateTime.Now.ToString("MMMM"))?.TotalUnpaid;
                        //var unpaidAmountP = paidUnpaidList?.FirstOrDefault(e => e.PeriodMonth == DateTime.Now.AddMonths(-1).ToString("MMMM"))?.TotalUnpaid;


                        //if (paidAmountP != 0 && paidAmountP != null)
                        //{
                        //  var paidPercentage = Math.Round(((paidAmountC ?? 0) - (paidAmountP ?? 0)) * 100 / (paidAmountP ?? 0), 2);
                        //  paidUnpaidList!.FirstOrDefault()!.paidPercentage = paidPercentage;
                        //}
                        //if (unpaidAmountP != 0 && unpaidAmountP != null)
                        //{
                        //  var unpaidPercentage = Math.Round((unpaidAmountC ?? 0 - unpaidAmountP ?? 0) * 100 / unpaidAmountP ?? 0, 2);
                        //  paidUnpaidList!.FirstOrDefault()!.unpaidPercentage = unpaidPercentage;
                        //}







                        // Move to the second result set (Company Payment Status)
                        await reader.NextResultAsync();
                        var request = _httpContextAccessor.HttpContext.Request;
                        string baseUrl = $"{request.Scheme}://{request.Host}/CompanyLogo/";
                        while (await reader.ReadAsync())
                        {
                            companyStatusList.Add(new CompanyPaymentStatus
                            {
                                Types = reader["Types"]?.ToString(),
                                Paid = Convert.ToDecimal(reader["totalPaid"] ?? 0),
                                Unpaid = Convert.ToDecimal(reader["totalUnpaid"] ?? 0),
                                totalNoEmp = Convert.ToInt32(reader["empCount"] ?? 0),
                                schduleNo = Convert.ToInt32(reader["Schedule_NO"] ?? 0),
                                PeriodMonth = MonthName(reader["PERIODD_MONTH"]?.ToString()),
                                year = reader["PERIOD_YEAR"]?.ToString(),
                                CompanyName = reader["Company_Name"] is DBNull ? "" : reader["Company_Name"]?.ToString(),
                                PaymentStatus = reader["Payment_Status"] is DBNull ? "" : reader["Payment_Status"]?.ToString(),
                                CompanyLogo = (reader["CompanyLogo"] is DBNull || string.IsNullOrEmpty(reader["CompanyLogo"]?.ToString())) ? "" : $"{baseUrl}{reader["CompanyLogo"]?.ToString()}"

                            });
                        }

                        await reader.NextResultAsync();

                        while (await reader.ReadAsync())
                        {
                            //selfpaidUnpaidList.Add(new DashboardSummary
                            //{
                            //  PeriodMonth = MonthNameZeroindex(reader["PERIODD_MONTH"]?.ToString()),
                            //  TotalPaid = Convert.ToDecimal(reader["totalPaid"] ?? 0),
                            //  TotalUnpaid = Convert.ToDecimal(reader["totalUnpaid"] ?? 0)

                            //});

                            selfpaidUnpaidList.Add(new CompanyPaymentStatus
                            {
                                //Types = reader["Types"]?.ToString(),
                                Paid = Convert.ToDecimal(reader["totalPaid"] ?? 0),
                                Unpaid = Convert.ToDecimal(reader["totalUnpaid"] ?? 0),
                                //totalNoEmp = Convert.ToInt32(reader["empCount"] ?? 0),
                                schduleNo = Convert.ToInt32(reader["Schedule_NO"] ?? 0),
                                PeriodMonth = MonthName(reader["PERIODD_MONTH"]?.ToString()),
                                year = reader["PERIOD_YEAR"]?.ToString(),
                                CompanyName = reader["fullName"] is DBNull ? "" : reader["fullName"]?.ToString(),
                                PaymentStatus = reader["Payment_Status"] is DBNull ? "" : reader["Payment_Status"]?.ToString(),
                                paidEmployer = Convert.ToInt32(reader["PaidEmployer"] ?? 0),
                                unPaidEmployer = Convert.ToInt32(reader["UnpaidEmployer"] ?? 0),
                                //CompanyLogo = (reader["CompanyLogo"] is DBNull || string.IsNullOrEmpty(reader["CompanyLogo"]?.ToString())) ? "" : $"{baseUrl}{reader["CompanyLogo"]?.ToString()}"

                            });
                        }
                        //var selfpaidAmountC = selfpaidUnpaidList?.FirstOrDefault(e => e.PeriodMonth == DateTime.Now.ToString("MMMM"))?.Paid;
                        //var selfpaidAmountP = selfpaidUnpaidList?.FirstOrDefault(e => e.PeriodMonth == DateTime.Now.AddMonths(-1).ToString("MMMM"))?.Paid;
                        //
                        //var selfunpaidAmountC = selfpaidUnpaidList?.FirstOrDefault(e => e.PeriodMonth == DateTime.Now.ToString("MMMM"))?.Unpaid;
                        //var selfunpaidAmountP = selfpaidUnpaidList?.FirstOrDefault(e => e.PeriodMonth == DateTime.Now.AddMonths(-1).ToString("MMMM"))?.Unpaid;


                        //if (selfpaidAmountP != 0 && selfpaidAmountP != null)
                        //{
                        //  var selfpaidPercentage = Math.Round(((selfpaidAmountC ?? 0) - (selfpaidAmountP ?? 0)) * 100 / (selfpaidAmountP ?? 0), 2);
                        //  selfpaidUnpaidList!.FirstOrDefault()!.paidPercentage = selfpaidPercentage;
                        //}
                        //if (selfunpaidAmountP != 0 && selfunpaidAmountP != null)
                        //{
                        //  var selfunpaidPercentage = Math.Round((selfunpaidAmountC ?? 0 - selfunpaidAmountP ?? 0) * 100 / selfunpaidAmountP ?? 0, 2);
                        //  selfpaidUnpaidList!.FirstOrDefault()!.unpaidPercentage = selfunpaidPercentage;
                        //}



                    }
                }
                await connection.CloseAsync();
            }

            var response = new AdminDashboardResponse
            {
                Summary = paidUnpaidList,
                CompanyPaymentStatus = companyStatusList,
                selfSummary = selfpaidUnpaidList
            };

            return response;


        }

        public string MonthNameZeroindex(string m_no)
        {
            string Month = "";
            switch (m_no)
            {
                case "0":
                    Month = "January";
                    break;
                case "1":
                    Month = "February";
                    break;
                case "2":
                    Month = "March";
                    break;
                case "3":
                    Month = "April";
                    break;
                case "4":
                    Month = "May";
                    break;
                case "5":
                    Month = "June";
                    break;
                case "6":
                    Month = "July";
                    break;
                case "7":
                    Month = "August";
                    break;
                case "8":
                    Month = "September";
                    break;
                case "9":
                    Month = "October";
                    break;
                case "10":
                    Month = "November";
                    break;
                case "11":
                    Month = "December";
                    break;
                default:
                    Month = string.Empty;
                    break;
            }


            return Month;
        }

    }
}
