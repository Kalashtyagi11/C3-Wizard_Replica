                ModuleTypeId = 2;
            }

            var Model = (from c in _DbContext.Secmodules.Where(x => x.IsActive == true && x.ModuleTypeId == ModuleTypeId)
                         join p in _DbContext.SecuserModules.Where(x => x.RoleId == roleId && x.IsActive) on c.ModuleId equals p.ModuleId into ps
                         from p in ps.DefaultIfEmpty()
                         select new MenuItem
