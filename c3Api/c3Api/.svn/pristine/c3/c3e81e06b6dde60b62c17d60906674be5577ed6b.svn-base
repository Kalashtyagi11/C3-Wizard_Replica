            retObj._updatedMachineInfo = Convert.IsDBNull(row["UpdatedMachineInfo"]) ? null : (string)row["UpdatedMachineInfo"];
            retObj._isActive = Convert.IsDBNull(row["IsActive"]) ? (bool?)null : (bool?)row["IsActive"];
            retObj._occupation = Convert.IsDBNull(row["occupation"]) ? null : (string)row["occupation"];
            retObj._companyid = Convert.IsDBNull(row["CompanyId"]) ? (Int32?)null : (Int32?)row["CompanyId"];
            retObj._wadeg = Convert.IsDBNull(row["Wadeg"]) ? (decimal?)null : decimal.Parse(String.Format("{0:0.00}", (decimal?)row["Wadeg"]));
            retObj._wage_Amt = Convert.IsDBNull(row["WageAmt"]) ? (decimal?)null : decimal.Parse(String.Format("{0:0.00}", (decimal?)row["WageAmt"]));
            retObj._IsemployeeDirector = Convert.IsDBNull(row["IsemployeeDirector"]) ? (bool?)null : (bool?)row["IsemployeeDirector"];
            retObj._IsdirectorOnly = Convert.IsDBNull(row["IsdirectorOnly"]) ? (bool?)null : (bool?)row["IsdirectorOnly"];
            retObj._isLevyExempt = Convert.IsDBNull(row["IsLevyExempt"]) ? (bool?)null : (bool?)row["IsLevyExempt"];
            retObj._IsdirectorOnly = Convert.IsDBNull(row["IsdirectorOnly"]) ? (bool?)null : (bool?)row["IsdirectorOnly"];
            retObj._IsempDirector = (bool)retObj._IsemployeeDirector ? "Visible" : "Hidden";
            retObj._IsempDirectorimg = (bool)retObj._IsemployeeDirector ? "/img/RightSine.png" : "/img/close.png";
            retObj._emptype = (bool)retObj._IsemployeeDirector ? "Employee Directors" : "Employees";
            retObj._department = Convert.IsDBNull(row["Department"]) ? null : (string)row["Department"];
            retObj._emp_S_no = count + 1;
            count++;
            objList.Add(retObj);
          }
        }
        return objList;
      }
