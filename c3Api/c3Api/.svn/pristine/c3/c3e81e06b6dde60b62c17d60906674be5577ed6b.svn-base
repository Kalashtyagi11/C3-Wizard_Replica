            retObj._wagespayDate = Convert.IsDBNull(row["Wages_Pay_Date"]) ? (DateTime?)null : (DateTime?)row["Wages_Pay_Date"];
            retObj._ApDate = Convert.IsDBNull(row["Appint_Date"]) ? null : ((DateTime)row["Appint_Date"]).ToString("dd-MM-yyyy");
            retObj._TrDate = Convert.IsDBNull(row["Terminated"]) ? null : ((DateTime)row["Terminated"]).ToString("dd-MM-yyyy");
            retObj._emplStatus = Convert.IsDBNull(row["Empl_Status"]) ? null : (string)row["Empl_Status"];
            retObj._payPeriod = Convert.IsDBNull(row["Pay_Period"]) ? null : (string)row["Pay_Period"];
           
            if (retObj._payPeriod != null)
            {
              if (retObj._payPeriod == "W")
                retObj._payPeriodforlist = "W - Weekly";
              if (retObj._payPeriod == "M")
                retObj._payPeriodforlist = "M - Monthly";
              if (retObj._payPeriod == "E2W")
                retObj._payPeriodforlist = "E2W - Every Two Weeks"; // retObj._payPeriodforlist = "Every Two Weeks"; Old Code             
              if (retObj._payPeriod == "2M")
                retObj._payPeriodforlist = "2M - Twice Monthly"; //retObj._payPeriodforlist = "Twice Monthly";
            }


