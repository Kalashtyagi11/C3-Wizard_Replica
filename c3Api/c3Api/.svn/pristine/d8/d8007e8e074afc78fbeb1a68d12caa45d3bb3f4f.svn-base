        public async Task<ResponseModel> UploadExcel(IFormFile file)
        {
            var response = new ResponseModel();

            if (file == null || file.Length == 0 || !file.FileName.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                response.Status = false;
                response.Message = "Invalid file. Please upload a valid Excel (.xlsx) file.";
                return response;
            }

            ExcelPackage.License.SetNonCommercialPersonal("Your Name");

            using var stream = new MemoryStream();
            await file.CopyToAsync(stream);
            using var package = new ExcelPackage(stream);

            var worksheet = package.Workbook.Worksheets.FirstOrDefault();
            if (worksheet == null || worksheet.Dimension == null)
            {
                response.Status = false;
                response.Message = "Excel sheet is empty or not found.";
                return response;
            }

            int rowCount = worksheet.Dimension.End.Row;
            int colCount = worksheet.Dimension.End.Column;

            var expectedHeaders = new List<string>
    {
        "TransactionId", "InvoiceNumber", "CardNumber", "TransactionDate", "Amount", "PaymentStatus"
    };

            var actualHeaders = new List<string>();
            for (int col = 1; col <= expectedHeaders.Count; col++)
            {
                var header = worksheet.Cells[1, col].Text?.Trim();
                actualHeaders.Add(header);
            }

            bool isStructureValid = expectedHeaders.SequenceEqual(actualHeaders, StringComparer.OrdinalIgnoreCase);
            if (!isStructureValid)
            {
                response.Status = false;
                response.Message = "Invalid Excel format. Columns must be: " + string.Join(", ", expectedHeaders);
                return response;
            }
            //var response = new ResponseModel();
            ExcelPackage.License.SetNonCommercialPersonal("Your Name");

            //using var stream = new MemoryStream();
            //await file.CopyToAsync(stream);
            //using var package = new ExcelPackage(stream);
            //var worksheet = package.Workbook.Worksheets[0];
            //int rowCount = worksheet.Dimension.End.Row;

            var importList = new List<ReconciliationPaymentVm>();

            var bankPayments = new BankPaymentsMain
            {
                CreatedBy = 1,
                CreatedOn = DateTime.Now,
                ModifiedBy = 1,
                ModifiedOn = DateTime.Now,
                FilePath = file.FileName,
                IsActive = true
            };

            _Context.BankPayments.Add(bankPayments);
            await _Context.SaveChangesAsync();

            for (int row = 2; row <= rowCount; row++)
            {
                string txnId = worksheet.Cells[row, 1].Value?.ToString();
                if (string.IsNullOrWhiteSpace(txnId))
                    continue;

                int.TryParse(worksheet.Cells[row, 2].Text, out var invNo);
                string cardValue = worksheet.Cells[row, 3].Value?.ToString();
                bool cardParsed = long.TryParse(cardValue, out var cardNo);
                DateTime.TryParse(worksheet.Cells[row, 4].Text, out var txnDate);
                decimal.TryParse(worksheet.Cells[row, 5].Text, out var amt);

                var vm = new ReconciliationPaymentVm
                {
                    MainId = bankPayments.MainId,
                    TransactionId = txnId,
                    InvoiceNumber = invNo,
                    CardNumber = cardParsed ? cardNo : null,
                    TransactionDate = string.IsNullOrWhiteSpace(worksheet.Cells[row, 4].Text) ? (DateTime?)null : txnDate,
                    Amount = string.IsNullOrWhiteSpace(worksheet.Cells[row, 5].Text) ? (decimal?)null : amt,
                    PaymentStatus = string.IsNullOrWhiteSpace(worksheet.Cells[row, 6].Text) ? null : worksheet.Cells[row, 6].Text.Trim()
                };

                importList.Add(vm);
            }

            var entities = importList.Select(vm => new ReconciliationPayment_Details
            {
                MainId = vm.MainId,
                TransactionId = vm.TransactionId,
                InvoiceNumber = vm.InvoiceNumber,
                CardNumber = vm.CardNumber,
                TransactionDate = vm.TransactionDate,
                Amount = vm.Amount,
                PaymentStatus = vm.PaymentStatus
            }).ToList();


            var existingTxnIds = _Context.ReconciliationPayments
                .Select(x => x.TransactionId)
                .ToHashSet();

            var newEntities = entities
                .Where(e => !existingTxnIds.Contains(e.TransactionId))
                .ToList();

            if (newEntities.Any())
            {
                await _Context.ReconciliationPayments.AddRangeAsync(newEntities);
                await _Context.SaveChangesAsync();


                var reconciledData = (from excelData in _Context.ReconciliationPayments
                                      where !string.IsNullOrEmpty(excelData.TransactionId)
                                      join onlineData in _Context.OnlinePayments
                                          .Where(x => x.IsActive && !string.IsNullOrEmpty(x.PaymentGatewayTransactionID))
                                      on excelData.TransactionId equals onlineData.PaymentGatewayTransactionID
                                      select new
                                      {
                                          ExcelTxnId = excelData.TransactionId
                                      }).ToList();

                if (reconciledData.Any())
                {
                    foreach (var item in reconciledData)
                    {
                        var onlinePayment = _Context.OnlinePayments
                            .FirstOrDefault(x => x.PaymentGatewayTransactionID == item.ExcelTxnId);

                        if (onlinePayment != null)
                        {
                            onlinePayment.IsReconciled = true;
                            onlinePayment.ReconciledBy = 1;
                            onlinePayment.ReconciledOn = DateTime.Now;
                        }
                    }

                    await _Context.SaveChangesAsync();
                }

                response.Status = true;
                //response.Message = $"Successfully saved {newEntities.Count} new records. Skipped {entities.Count - newEntities.Count} duplicate(s).";
                response.Message = "Successfully saved";
                response.Data = newEntities;
            }
            else
            {
                response.Status = false;
                //response.Message = "No new data found in the Excel file.";
                //response.Message = "Data not found";
                response.Message = "No new data found in the Excel file.";
                //response.Message = "Data not found";
                response.Data = null;
            }

            return response;
        }


        string TryParseScientific(string input)
        {
            if (string.IsNullOrWhiteSpace(input))
                return string.Empty;

            // Try parsing scientific notation
            if (double.TryParse(input, System.Globalization.NumberStyles.Float,
                                System.Globalization.CultureInfo.InvariantCulture, out var num))
            {
                return num.ToString("F0");
            }

            return input;
        }

        public async Task<ResponseModel> UploadCyberCsv(ReconcileVm reconcile)
        {
            var expectedHeaders = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
             {
                 "CyberSource Merchant ID", "Date and Time", "Request ID", "Merchant Reference Number",
                 "Retrieval Reference Number", "Instalment Identifier", "Last Name", "First Name", "Email",
                 "Amount", "Currency", "Account Prefix", "Account Suffix", "Applications", "Payment Method",
                 "Payment Solution", "Transaction Reference Number", "Authorisation Indicator",
                 "Partner Original Transaction ID", "Partner Solution ID", "Device ID", "Terminal Serial Number",
                 "Processor", "Token ID", "Business Application ID", "Terminal ID", "PA Transaction ID", "XID",
                 "MerchantDefinedData1", "MerchantDefinedData2", "MerchantDefinedData3", "MerchantDefinedData4",
                 "Client User", "Sales Slip Number", "Authorisation Code", "Acquirer Account ID", "JCCA Terminal ID",
                 "Billing Address1", "Billing City", "Billing County/Region", "Billing Postal Code",
                 "Billing Phone Number", "IP Address", "Billing Country", "Shipping First Name", "Shipping Last Name",
                 "Shipping Address1", "Shipping City", "Shipping County/Region", "Shipping Country",
                 "Shipping Postal Code", "Shipping Phone Number", "Customer ID", "Client Application",
                 "Device Fingerprint", "ICS Rflag", "ICS Rcode", "Reason Code", "Commerce Indicator",
                 "Provider Transaction Id",
             };

            var expectedHeadersLive = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
             {
                "CyberSource Merchant ID","Date and Time","Request ID","Merchant Reference Number","Retrieval Reference Number",
     "Installment Identifier","Last Name","First Name","Email","Amount","Currency","Account Prefix","Account Suffix","Applications",
     "Payment Method","Payment Solution","Transaction Reference Number","Authorization Indicator","Partner Original Transaction ID",
     "Partner Solution Id","Device ID","Terminal Serial Number","Processor","Token ID","Business Application ID","Terminal ID",
     "PA Transaction ID","XID","MerchantDefinedData1","MerchantDefinedData2","MerchantDefinedData3","MerchantDefinedData4","Client User",
     "Sales Slip Number","Authorization Code","Acquirer Account ID","JCCA Terminal ID","Billing Address1","Billing City","Billing State",
     "Billing Postal Code","Billing Phone Number","Ip Address","Billing Country","Shipping First Name","Shipping Last Name","Shipping Address1",
     "Shipping City","Shipping State","Shipping Country","Shipping Postal Code","Shipping Phone Number","Customer Id","Client Application",
     "Device Fingerprint","ICS Rflag","ICS Rcode","Reason Code","Commerce Indicator","Provider Transaction Id"

             };

            var response = new ResponseModel();
            var importList = new List<ReconciliationCyberVm>();
            using var stream = reconcile.file.OpenReadStream();
            using var reader = new StreamReader(stream);
            using var parser = new TextFieldParser(reader)
            {
                HasFieldsEnclosedInQuotes = true,
                Delimiters = new[] { "," }
            };
            string Truncate(string value, int maxLength)
            {
                return string.IsNullOrEmpty(value) ? value : value.Length <= maxLength ? value : value.Substring(0, maxLength);
            }
            // Read header
            string[] headers = parser.ReadFields();
            var fileHeaders = headers.Select(h => h.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var invalidHeaders = fileHeaders.Except(expectedHeaders).ToList();



            var fileHeadersL = headers.Select(h => h.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var invalidHeadersL = fileHeadersL.Except(expectedHeadersLive).ToList();



            if (invalidHeaders.Any() && invalidHeadersL.Any())
            {
                response.Status = false;
                response.Message = "Invalid CSV columns.";
                response.Data = new
                {
                    InvalidColumns = invalidHeaders,
                };
                return response;
            }

            while (!parser.EndOfData)
            {
                string[] row = parser.ReadFields();
                var dict = headers.Zip(row, (header, value) => new { header, value })
                                 .ToDictionary(x => x.header.Trim(), x => x.value?.Trim());

                if (!invalidHeaders.Any())
                {
                    var vm = new ReconciliationCyberVm
                    {
                        CyberSourceMerchantID = Truncate(dict.GetValueOrDefault("CyberSource Merchant ID"), 100),
                        DateandTime = dict.GetValueOrDefault("Date and Time"),
                        RequestID = dict.GetValueOrDefault("Request ID"),
                        MerchantReferenceNumber = Truncate(dict.GetValueOrDefault("Merchant Reference Number"), 100),
                        RetrievalReferenceNumber = Truncate(dict.GetValueOrDefault("Retrieval Reference Number"), 100),
                        InstalmentIdentifier = Truncate(dict.GetValueOrDefault("Instalment Identifier"), 100),
                        LastName = Truncate(dict.GetValueOrDefault("Last Name"), 50),
                        FirstName = Truncate(dict.GetValueOrDefault("First Name"), 50),
                        Email = Truncate(dict.GetValueOrDefault("Email"), 50),
                        Amount = decimal.TryParse(dict.GetValueOrDefault("Amount"), out var amt) ? amt : null,
                        Currency = Truncate(dict.GetValueOrDefault("Currency"), 50),
                        AccountPrefix = Truncate(dict.GetValueOrDefault("Account Prefix"), 50),
                        AccountSuffix = Truncate(dict.GetValueOrDefault("Account Suffix"), 50),
                        Applications = Truncate(dict.GetValueOrDefault("Applications"), 50),
                        PaymentMethod = Truncate(dict.GetValueOrDefault("Payment Method"), 50),
                        PaymentSolution = Truncate(dict.GetValueOrDefault("Payment Solution"), 50),
                        TransactionReferenceNumber = TryParseScientific(dict.GetValueOrDefault("Transaction Reference Number")),
                        AuthorisationIndicator = Truncate(dict.GetValueOrDefault("Authorisation Indicator"), 50),
                        PartnerOriginalTransactionID = Truncate(dict.GetValueOrDefault("Partner Original Transaction ID"), 50),
                        PartnerSolutionID = Truncate(dict.GetValueOrDefault("Partner Solution ID"), 50),
                        DeviceID = Truncate(dict.GetValueOrDefault("Device ID"), 50),
                        TerminalSerialNumber = Truncate(dict.GetValueOrDefault("Terminal Serial Number"), 50),
                        Processor = Truncate(dict.GetValueOrDefault("Processor"), 50),
                        TokenID = Truncate(dict.GetValueOrDefault("Token ID"), 50),
                        BusinessApplicationID = Truncate(dict.GetValueOrDefault("Business Application ID"), 50),
                        TerminalID = Truncate(dict.GetValueOrDefault("Terminal ID"), 50),
                        PATransactionID = Truncate(dict.GetValueOrDefault("PA Transaction ID"), 50),
                        XID = Truncate(dict.GetValueOrDefault("XID"), 50),
                        MerchantDefinedData1 = Truncate(dict.GetValueOrDefault("MerchantDefinedData1"), 50),
                        MerchantDefinedData2 = Truncate(dict.GetValueOrDefault("MerchantDefinedData2"), 50),
                        MerchantDefinedData3 = Truncate(dict.GetValueOrDefault("MerchantDefinedData3"), 50),
                        MerchantDefinedData4 = Truncate(dict.GetValueOrDefault("MerchantDefinedData4"), 50),
                        ClientUser = Truncate(dict.GetValueOrDefault("Client User"), 50),
                        SalesSlipNumber = Truncate(dict.GetValueOrDefault("Sales Slip Number"), 50),
                        AuthorisationCode = Truncate(dict.GetValueOrDefault("Authorisation Code"), 50),
                        AcquirerAccountID = Truncate(dict.GetValueOrDefault("Acquirer Account ID"), 50),
                        JCCATerminalID = Truncate(dict.GetValueOrDefault("JCCA Terminal ID"), 50),
                        BillingAddress1 = Truncate(dict.GetValueOrDefault("Billing Address1"), 50),
                        BillingCity = Truncate(dict.GetValueOrDefault("Billing City"), 50),
                        BillingCountyRegion = Truncate(dict.GetValueOrDefault("Billing County/Region"), 50),
                        BillingPostalCode = Truncate(dict.GetValueOrDefault("Billing Postal Code"), 50),
                        BillingPhoneNumber = Truncate(dict.GetValueOrDefault("Billing Phone Number"), 50),
                        IPAddress = Truncate(dict.GetValueOrDefault("IP Address"), 50),
                        BillingCountry = Truncate(dict.GetValueOrDefault("Billing Country"), 50),
                        ShippingFirstName = Truncate(dict.GetValueOrDefault("Shipping First Name"), 50),
                        ShippingLastName = Truncate(dict.GetValueOrDefault("Shipping Last Name"), 50),
                        ShippingAddress1 = Truncate(dict.GetValueOrDefault("Shipping Address1"), 50),
                        ShippingCity = Truncate(dict.GetValueOrDefault("Shipping City"), 50),
                        ShippingCountyRegion = Truncate(dict.GetValueOrDefault("Shipping County/Region"), 50),
                        ShippingCountry = Truncate(dict.GetValueOrDefault("Shipping Country"), 50),
                        ShippingPostalCode = Truncate(dict.GetValueOrDefault("Shipping Postal Code"), 50),
                        ShippingPhoneNumber = Truncate(dict.GetValueOrDefault("Shipping Phone Number"), 50),
                        CustomerID = Truncate(dict.GetValueOrDefault("Customer ID"), 50),
                        ClientApplication = Truncate(dict.GetValueOrDefault("Client Application"), 50),
                        DeviceFingerprint = Truncate(dict.GetValueOrDefault("Device Fingerprint"), 50),
                        ICSRflag = Truncate(dict.GetValueOrDefault("ICS Rflag"), 100),
                        ICSRcode = dict.GetValueOrDefault("ICS Rcode"),
                        ReasonCode = Truncate(dict.GetValueOrDefault("Reason Code"), 100),
                        CommerceIndicator = Truncate(dict.GetValueOrDefault("Commerce Indicator"), 100),
                        ProviderTransactionId = dict.GetValueOrDefault("Provider Transaction Id")
                    };
                    importList.Add(vm);
                }
                else
                {


                    var vm = new ReconciliationCyberVm
                    {
                        CyberSourceMerchantID = Truncate(dict.GetValueOrDefault("CyberSource Merchant ID"), 100),
                        DateandTime = dict.GetValueOrDefault("Date and Time"),
                        RequestID = dict.GetValueOrDefault("Request ID"),
                        MerchantReferenceNumber = Truncate(dict.GetValueOrDefault("Merchant Reference Number"), 100),
                        RetrievalReferenceNumber = Truncate(dict.GetValueOrDefault("Retrieval Reference Number"), 100),
                        InstalmentIdentifier = Truncate(dict.GetValueOrDefault("Installment Identifier"), 100),
                        LastName = Truncate(dict.GetValueOrDefault("Last Name"), 50),
                        FirstName = Truncate(dict.GetValueOrDefault("First Name"), 50),
                        Email = Truncate(dict.GetValueOrDefault("Email"), 50),
                        Amount = decimal.TryParse(dict.GetValueOrDefault("Amount"), out var amt) ? amt : null,
                        Currency = Truncate(dict.GetValueOrDefault("Currency"), 50),
                        AccountPrefix = Truncate(dict.GetValueOrDefault("Account Prefix"), 50),
                        AccountSuffix = Truncate(dict.GetValueOrDefault("Account Suffix"), 50),
                        Applications = Truncate(dict.GetValueOrDefault("Applications"), 50),
                        PaymentMethod = Truncate(dict.GetValueOrDefault("Payment Method"), 50),
                        PaymentSolution = Truncate(dict.GetValueOrDefault("Payment Solution"), 50),
                        TransactionReferenceNumber = TryParseScientific(dict.GetValueOrDefault("Transaction Reference Number")),
                        AuthorisationIndicator = Truncate(dict.GetValueOrDefault("Authorization Indicator"), 50),
                        PartnerOriginalTransactionID = Truncate(dict.GetValueOrDefault("Partner Original Transaction ID"), 50),
                        PartnerSolutionID = Truncate(dict.GetValueOrDefault("Partner Solution Id"), 50),
                        DeviceID = Truncate(dict.GetValueOrDefault("Device ID"), 50),
                        TerminalSerialNumber = Truncate(dict.GetValueOrDefault("Terminal Serial Number"), 50),
                        Processor = Truncate(dict.GetValueOrDefault("Processor"), 50),
                        TokenID = Truncate(dict.GetValueOrDefault("Token ID"), 50),
                        BusinessApplicationID = Truncate(dict.GetValueOrDefault("Business Application ID"), 50),
                        TerminalID = Truncate(dict.GetValueOrDefault("Terminal ID"), 50),
                        PATransactionID = Truncate(dict.GetValueOrDefault("PA Transaction ID"), 50),
                        XID = Truncate(dict.GetValueOrDefault("XID"), 50),
                        MerchantDefinedData1 = Truncate(dict.GetValueOrDefault("MerchantDefinedData1"), 50),
                        MerchantDefinedData2 = Truncate(dict.GetValueOrDefault("MerchantDefinedData2"), 50),
                        MerchantDefinedData3 = Truncate(dict.GetValueOrDefault("MerchantDefinedData3"), 50),
                        MerchantDefinedData4 = Truncate(dict.GetValueOrDefault("MerchantDefinedData4"), 50),
                        ClientUser = Truncate(dict.GetValueOrDefault("Client User"), 50),
                        SalesSlipNumber = Truncate(dict.GetValueOrDefault("Sales Slip Number"), 50),
                        AuthorisationCode = Truncate(dict.GetValueOrDefault("Authorization Code"), 50),
                        AcquirerAccountID = Truncate(dict.GetValueOrDefault("Acquirer Account ID"), 50),
                        JCCATerminalID = Truncate(dict.GetValueOrDefault("JCCA Terminal ID"), 50),
                        BillingAddress1 = Truncate(dict.GetValueOrDefault("Billing Address1"), 50),
                        BillingCity = Truncate(dict.GetValueOrDefault("Billing City"), 50),
                        BillingCountyRegion = Truncate(dict.GetValueOrDefault("Billing State"), 50),
                        BillingPostalCode = Truncate(dict.GetValueOrDefault("Billing Postal Code"), 50),
                        BillingPhoneNumber = Truncate(dict.GetValueOrDefault("Billing Phone Number"), 50),
                        IPAddress = Truncate(dict.GetValueOrDefault("Ip Address"), 50),
                        BillingCountry = Truncate(dict.GetValueOrDefault("Billing Country"), 50),
                        ShippingFirstName = Truncate(dict.GetValueOrDefault("Shipping First Name"), 50),
                        ShippingLastName = Truncate(dict.GetValueOrDefault("Shipping Last Name"), 50),
                        ShippingAddress1 = Truncate(dict.GetValueOrDefault("Shipping Address1"), 50),
                        ShippingCity = Truncate(dict.GetValueOrDefault("Shipping City"), 50),
                        ShippingCountyRegion = Truncate(dict.GetValueOrDefault("Shipping State"), 50),
                        ShippingCountry = Truncate(dict.GetValueOrDefault("Shipping Country"), 50),
                        ShippingPostalCode = Truncate(dict.GetValueOrDefault("Shipping Postal Code"), 50),
                        ShippingPhoneNumber = Truncate(dict.GetValueOrDefault("Shipping Phone Number"), 50),
                        CustomerID = Truncate(dict.GetValueOrDefault("Customer Id"), 50),
                        ClientApplication = Truncate(dict.GetValueOrDefault("Client Application"), 50),
                        DeviceFingerprint = Truncate(dict.GetValueOrDefault("Device Fingerprint"), 50),
                        ICSRflag = Truncate(dict.GetValueOrDefault("ICS Rflag"), 100),
                        ICSRcode = dict.GetValueOrDefault("ICS Rcode"),
                        ReasonCode = Truncate(dict.GetValueOrDefault("Reason Code"), 100),
                        CommerceIndicator = Truncate(dict.GetValueOrDefault("Commerce Indicator"), 100),
                        ProviderTransactionId = dict.GetValueOrDefault("Provider Transaction Id")
                    };
                    importList.Add(vm);
                }


            }
            var entities = importList.Select(vm => new ReconciliationCyberSpace
            {
                // Id = vm.ID,
                CyberSourceMerchantId = vm.CyberSourceMerchantID,
                DateAndTime = vm.DateandTime,
                RequestId = vm.RequestID,
                MerchantReferenceNumber = vm.MerchantReferenceNumber,
                RetrievalReferenceNumber = vm.RetrievalReferenceNumber,
                InstalmentIdentifier = vm.InstalmentIdentifier,
                LastName = vm.LastName,
                FirstName = vm.FirstName,
                Email = vm.Email,
                Amount = vm.Amount.ToString(),
                Currency = vm.Currency,
                AccountPrefix = vm.AccountPrefix,
                AccountSuffix = vm.AccountSuffix,
                Applications = vm.Applications,
                PaymentMethod = vm.PaymentMethod,
                PaymentSolution = vm.PaymentSolution,
                TransactionReferenceNumber = vm.TransactionReferenceNumber,
                AuthorisationIndicator = vm.AuthorisationIndicator,
                PartnerOriginalTransactionId = vm.PartnerOriginalTransactionID,
                PartnerSolutionId = vm.PartnerSolutionID,
                DeviceId = vm.DeviceID,
                TerminalSerialNumber = vm.TerminalSerialNumber,
                Processor = vm.Processor,
                TokenId = vm.TokenID,
                BusinessApplicationId = vm.BusinessApplicationID,
                TerminalId = vm.TerminalID,
                PaTransactionId = vm.PATransactionID,
                Xid = vm.XID,
                MerchantDefinedData1 = vm.MerchantDefinedData1,
                MerchantDefinedData2 = vm.MerchantDefinedData2,
                MerchantDefinedData3 = vm.MerchantDefinedData3,
                MerchantDefinedData4 = vm.MerchantDefinedData4,
                ClientUser = vm.ClientUser,
                SalesSlipNumber = vm.SalesSlipNumber,
                AuthorisationCode = vm.AuthorisationCode,
                AcquirerAccountId = vm.AcquirerAccountID,
                JccaTerminalId = vm.JCCATerminalID,
                BillingAddress1 = vm.BillingAddress1,
                BillingCity = vm.BillingCity,
                BillingCountyRegion = vm.BillingCountyRegion,
                BillingPostalCode = vm.BillingPostalCode,
                BillingPhoneNumber = vm.BillingPhoneNumber,
                IpAddress = vm.IPAddress,
                BillingCountry = vm.BillingCountry,
                ShippingFirstName = vm.ShippingFirstName,
                ShippingLastName = vm.ShippingLastName,
                ShippingAddress1 = vm.ShippingAddress1,
                ShippingCity = vm.ShippingCity,
                ShippingCountyRegion = vm.ShippingCountyRegion,
                ShippingCountry = vm.ShippingCountry,
                ShippingPostalCode = vm.ShippingPostalCode,
                ShippingPhoneNumber = vm.ShippingPhoneNumber,
                CustomerId = vm.CustomerID,
                ClientApplication = vm.ClientApplication,
                DeviceFingerprint = vm.DeviceFingerprint,
                IcsRflag = vm.ICSRflag,
                IcsRcode = int.TryParse(vm.ICSRcode, out var rcode) ? rcode : (int?)null,
                ReasonCode = vm.ReasonCode,
                CommerceIndicator = vm.CommerceIndicator,
                ProviderTransactionId = int.TryParse(vm.ProviderTransactionId, out var ptid) ? ptid : (int?)null
            }).ToList();

            var existingTxnIds = _Context.ReconciliationCyberSpaces
         .Select(x => x.RequestId)
         .ToHashSet();

            var newEntities = entities
                .Where(e => !existingTxnIds.Contains(e.RequestId))
                .ToList();

            if (newEntities.Any())
            {
                await _Context.ReconciliationCyberSpaces.AddRangeAsync(newEntities);
                await _Context.SaveChangesAsync();

                var reconciledData = (from excelData in _Context.ReconciliationCyberSpaces
                                      where !string.IsNullOrEmpty(excelData.RequestId)
                                      join onlineData in _Context.OnlinePayments
                                          .Where(x => x.IsActive && !string.IsNullOrEmpty(x.PaymentGatewayTransactionID))
                                      on excelData.RequestId equals onlineData.PaymentGatewayTransactionID
                                      select new
                                      {
                                          ExcelTxnId = excelData.RequestId
                                      }).ToList();


                if (reconciledData.Any())
                {
                    foreach (var item in reconciledData)
                    {
                        var onlinePayment = _Context.OnlinePayments
                            .FirstOrDefault(x => x.PaymentGatewayTransactionID == item.ExcelTxnId);

                        if (onlinePayment != null)
                        {
                            onlinePayment.IsReconciled = true;
                            onlinePayment.ReconciledBy = reconcile.UserId;
                            onlinePayment.ReconciledOn = DateTime.Now;
                        }
                    }

                    await _Context.SaveChangesAsync();
                }

                response.Status = true;
                response.Message = "Successfully Saved.";
                response.Data = newEntities;
            }
            else
            {
                response.Status = false;
                response.Message = "No new records found (possibly all duplicates).";
            }

            return response;
        }

