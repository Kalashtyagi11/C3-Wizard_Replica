        public async Task<List<SiteSettings>> saveAndGetConfigData(SiteSettingsVm obj)
        {
            if (String.IsNullOrEmpty(obj.merchantId) && String.IsNullOrEmpty(obj.secretKey) && String.IsNullOrEmpty(obj.keyId))
            {
                var data = _Context.SiteSetting.Select(e => new SiteSettings { SiteSettings_Id = e.SiteSettings_Id, Environment = e.Environment, MerchantId = e.MerchantId, KeyId = e.KeyId, SecretKey = e.SecretKey, BaseUrl = e.BaseUrl, IsActive = e.IsActive }).ToList();
                return data;
            }
            else
            {
                var data1 = _Context.SiteSetting.ToList();
                foreach (var item in data1)
                {
                    if (item.SiteSettings_Id == obj.SiteSettings_Id)
                    {
                        item.MerchantId = obj.merchantId;
                        item.KeyId = obj.keyId;
                        item.SecretKey = obj.secretKey;
                        item.IsActive = true;
                    }
                    else
                    {
                        item.IsActive = false;
                    }
                }

                _Context.SaveChanges();
                return new List<SiteSettings>() { new SiteSettings { IsActive = true } };
            }

        }


        public async Task<int> StatusChangeConfigData(SiteSettingsVm obj)
        {


            var _encryptDecryptPassword = new PasswordAlgorithns();

            int count = _Context.Secusers.Count(e => e.LoginId == obj.loginId && e.Password == _encryptDecryptPassword.Encrypt(obj.password));
            if (0 < count)
            {


                var data1 = _Context.SiteSetting.ToList();
                foreach (var item in data1)
                {
                    if (item.SiteSettings_Id == obj.SiteSettings_Id)
                    {
                        //item.MerchantId = obj.merchantId;
                        //item.KeyId = obj.keyId;
                        //item.SecretKey = obj.secretKey;
                        //item.BaseUrl = obj.BaseUrl;
                        item.IsActive = item.IsActive ? false : true;
                    }
                    else
                    {
                        item.IsActive = item.IsActive ? false : true;
                    }
                    _Context.SaveChanges();
                }
                return 1;
            }
            return 0;
        }
        public async Task<TestOnlinePayments> PayChargeTestAndLive(PaymentFormModelVm modal)
        {

            var siteSetting = _Context.SiteSetting.FirstOrDefault(e => e.IsActive);

            var merchantId = siteSetting.MerchantId;
            var keyId = siteSetting.KeyId;
            var secretKey = siteSetting.SecretKey;
            var resource = "/pts/v2/payments";
            var baseUrl = siteSetting.BaseUrl;
            var host = new Uri(siteSetting.BaseUrl).Host;

            var result = (from user in _Context.Secusers

                          join company in _Context.MasterCompanies
                              on user.REG_NUMBER equals company.RegNumber into companyGroup
                          from company in companyGroup.DefaultIfEmpty()

                          join selfEmployee in _Context.SelfEmployees
                              on user.REG_NUMBER equals selfEmployee.SocSecNum into selfEmployeeGroup
                          from selfEmployee in selfEmployeeGroup.DefaultIfEmpty()

                          where user.UserId == modal.UserId

                          select new
                          {
                              user,
                              company,
                              selfEmployee
                          }).FirstOrDefault();


            string _expirationMonth = "";
            string _expirationYear = "";
            bool isSelfEmployee = result?.user?.IsSelfEmployee ?? false;

            if (!string.IsNullOrEmpty(modal.ExpirationYear) && modal.ExpirationYear.Contains("/"))
            {
                var parts = modal.ExpirationYear.Split('/');
                if (parts.Length == 2)
                {
                    _expirationMonth = parts[0].Trim();
                    _expirationYear = parts[1].Trim();
                }
            }



            string codeId = GenerateTransactionId();
            var body = new
            {
                clientReferenceInformation = new { code = codeId },
                buyerInformation = new
                {
                    //customerId = result?.user.LoginId,
                    merchantCustomerId = isSelfEmployee ? result?.selfEmployee?.SocSecNum : result?.company?.RegNumber,
                    email = result?.user.EmailId,
                    mobilePhoneNumber = isSelfEmployee ? result?.selfEmployee?.Mobile : result?.company?.Mobile,
                    //dateOfBirth = isSelfEmployee ? result?.selfEmployee?.BirthDate : null,// result?.company?.BirthDate.ToString("yyyy-MM-dd"),
                },
                deviceInformation = new
                {
                    fingerprintSessionId = modal.UserId // <-- This should be passed from frontend
                },
                processingInformation = new
                {
                    capture = true,
                    commerceIndicator = "internet"
                },
                paymentInformation = new
                {
                    card = new
                    {
                        number = modal.CardNumber,
                        expirationMonth = _expirationMonth,
                        expirationYear = _expirationYear,
                        securityCode = modal.SecurityCode,
                        fullName = modal.cardHolderName
                    }
                },
                orderInformation = new
                {
                    amountDetails = new
                    {
                        totalAmount = modal?.TotalAmount,//"123.06",
                        currency = "XCD"
                    },
                    billTo = new
                    {
                        firstName = isSelfEmployee ? result?.selfEmployee?.FirstName : result?.company?.CompanyName,
                        lastName = isSelfEmployee ? result?.selfEmployee?.LastName : result?.company?.TradeName,//"Doe",
                        address1 = isSelfEmployee ? result?.selfEmployee?.Address1 : result?.company?.Address1,// "1 market st",
                        locality = isSelfEmployee ? result?.selfEmployee?.Address2 : result?.company?.Address2,// "san francisco",
                        administrativearea = isSelfEmployee ? result?.selfEmployee?.City : result?.company?.City,//"ca",
                        postalcode = "00000",//"94105",
                        country = "KN",//"us",
                        email = isSelfEmployee ? result?.selfEmployee?.Email : result?.company?.Email,//userData.EmailId,//"test@example.com",
                        phoneNumber = isSelfEmployee ? result?.selfEmployee?.Phone : result?.company?.Landline,//"4158880000"
                    },
                    shippingInformation = new
                    {
                        firstName = isSelfEmployee ? result?.selfEmployee?.FirstName : result?.company?.CompanyName,
                        lastName = isSelfEmployee ? result?.selfEmployee?.LastName : result?.company?.TradeName,//"Doe",
                        address1 = isSelfEmployee ? result?.selfEmployee?.Address1 : result?.company?.Address1,// "1 market st",
                        locality = isSelfEmployee ? result?.selfEmployee?.Address2 : result?.company?.Address2,// "san francisco",
                        administrativearea = isSelfEmployee ? result?.selfEmployee?.City : result?.company?.City,//"ca",
                        postalcode = "00000",//"94105",
                        country = "KN",//"us",
                        email = isSelfEmployee ? result?.selfEmployee?.Email : result?.company?.Email,//userData.EmailId,//"test@example.com",
                        phoneNumber = isSelfEmployee ? result?.selfEmployee?.Phone : result?.company?.Landline,//"4158880000"
                    },

                }
            };

            var jsonPayload = JsonConvert.SerializeObject(body);
            var headers = GenerateHeaders(jsonPayload, resource, merchantId, keyId, secretKey, host);

            var request = new HttpRequestMessage(HttpMethod.Post, $"{baseUrl}{resource}")
            {
                Content = new StringContent(jsonPayload, Encoding.UTF8, "application/json")
            };

            foreach (var header in headers)
            {
                request.Headers.TryAddWithoutValidation(header.Key, header.Value);
            }
            var client = new System.Net.Http.HttpClient();
            var response = await client.SendAsync(request);
            var responseContent = await response.Content.ReadAsStringAsync();


            dynamic dataApi = JsonConvert.DeserializeObject<dynamic>(responseContent);

            string status = dataApi.status.ToString();
            string clientReferenceInformation = dataApi.id.ToString();
            string totalAmount = "";
            string transactionId = "";
            string submitTimeUtc = "";
            if (status is "DECLINED")
            {
                totalAmount = modal.TotalAmount.ToString();
                submitTimeUtc = DateTime.Now.Date.ToString();
                transactionId = dataApi.processorInformation.transactionId.ToString();
            }
            else if (status is "AUTHORIZED")
            {
                submitTimeUtc = dataApi.submitTimeUtc.ToString();
                totalAmount = dataApi.orderInformation.amountDetails.totalAmount.ToString();
                transactionId = dataApi.processorInformation.transactionId.ToString();
            }
            else
            {
                totalAmount = modal.TotalAmount.ToString();
                submitTimeUtc = DateTime.Now.Date.ToString();
                transactionId = dataApi.processorInformation.transactionId.ToString();
            }




            var PaymentData = new TestOnlinePayments
            {
                UserId = 0,
                RefCustomerName = isSelfEmployee ? (result?.selfEmployee?.FirstName + " " + result?.user?.LastName + " " + result?.user?.REG_NUMBER) : result?.company?.CompanyName + " " + result?.user?.REG_NUMBER,
                C3HeaderId = 0,
                CreateTime = submitTimeUtc,
                PaymentAmount = Convert.ToDecimal(totalAmount),
                PaymentId = transactionId,
                PaymentGatewayTransactionID = clientReferenceInformation,
                TransactionTypeId = 1,
                PaymentStatus = status,
                Currency = "XCD",
                CreatedBy = 1,
                CreatedOn = DateTime.Now,
                IsActive = true,
                TransactionFor = siteSetting.Environment,
                cardHolderName = modal.cardHolderName,
                CardMonthExpiry = modal.ExpirationYear,
                CardNumber = modal.CardNumber,
                //CVV = modal.SecurityCode,
                apiResponse = responseContent,
                cardType = modal.paymentMethod,
                IscardView = modal.saveCard,
                PaymentPayerId = codeId
            };
            _Context.TestOnlinePayments.Add(PaymentData);
            _Context.SaveChanges();


            return PaymentData;
        }
