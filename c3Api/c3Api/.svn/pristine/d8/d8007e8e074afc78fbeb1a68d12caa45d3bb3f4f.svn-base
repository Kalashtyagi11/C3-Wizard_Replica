            List<C3HeaderVM> selfList = new List<C3HeaderVM>();
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            SqlCommand cmd = new SqlCommand("Get_TransactionHistory", staticConnection);
            cmd.CommandType = CommandType.StoredProcedure;
            //cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
            cmd.Parameters.AddWithValue("@PaymentStatus", string.IsNullOrEmpty(PaymentStatus) ? (object)DBNull.Value : PaymentStatus);
            cmd.Parameters.AddWithValue("@FromDate", FromDate.HasValue ? (object)FromDate : DBNull.Value);
            cmd.Parameters.AddWithValue("@ToDate", ToDate.HasValue ? (object)ToDate.Value : DBNull.Value);
            cmd.Parameters.AddWithValue("@CompanyId", CompanyId.HasValue ? (object)CompanyId.Value : DBNull.Value);
            cmd.Parameters.AddWithValue("@UserId", UserId.HasValue ? (object)UserId.Value : DBNull.Value);
            cmd.Parameters.AddWithValue("@types", string.IsNullOrEmpty(types) ? (object)DBNull.Value : types);
            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
            //DataTable dt = new DataTable();
            //sqlAdapter.Fill(dt);
            DataSet ds = new DataSet();
            sqlAdapter.Fill(ds);
            if (ds.Tables.Count > 0)
            {

                for (int i = 0; i < ds.Tables.Count; i++)
                {
                    DataTable dt = ds.Tables[i];
                    foreach (DataRow row in dt.Rows)
                    {


