        public async Task<DTOResponsemodel> ProcessPayment(DTOSubscriptionPayment model)
        {
            var response = new DTOResponsemodel();
            var Retrnurl = _configuration["PaymentUrl:ReturnUrl"];//_configuration["PaymentUrl:ReturnUrl"];
            var CancelUrl = _configuration["PaymentUrl:CancelUrl"];//_configuration["PaymentUrl:CancelUrl"];


            decimal Subs_Amount = 0;

            try
            {


                var order = new OrderRequest()
                {
                    CheckoutPaymentIntent = "CAPTURE",
                    PurchaseUnits = new List<PurchaseUnitRequest>
                    {
                        new PurchaseUnitRequest
                        {
                            AmountWithBreakdown = new AmountWithBreakdown
                            {
                                CurrencyCode = "USD",
                                Value = model.Amount.ToString("F2")
                            },
                            Description = $"payment for c3"
                        }
                    },
                    ApplicationContext = new ApplicationContext
                    {
                        ReturnUrl = Retrnurl,
                        CancelUrl = CancelUrl,
                        UserAction = "PAY_NOW", // Ensures the user sees "Pay Now" instead of "Continue"
                        ShippingPreference = "NO_SHIPPING", // Hides the shipping address section
                        LandingPage = "BILLING" // Directs user to the card details page
                    }
                };


                var request = new OrdersCreateRequest();
                request.Prefer("return=representation");  // Optional: to return the full response representation
                request.RequestBody(order);

                // Step 3: Execute the request
                var paymentResponse = await _client.Execute(request);

                if (paymentResponse.StatusCode == HttpStatusCode.Created)
                {
                    var result = paymentResponse.Result<PayPalCheckoutSdk.Orders.Order>();
                    if (result != null)
                    {
                        DateTime startDate = DateTime.UtcNow;
                        string Tran_Id = GenerateTransactionId();

                        var PaymentData = new OnlinePayments
                        {
                            UserId = model.userId,
                            C3HeaderId = model.c3HeaderId,
                            CreateTime = result.CreateTime,
                            PaymentAmount = model.Amount,
                            PaymentId = Tran_Id,
                            PaymentGatewayTransactionID = result.Id,
                            TransactionTypeId = 1,
                            PaymentStatus = result.Status,
                            CreatedBy = 1,
                            CreatedOn = DateTime.Now,
                            IsActive = true,
                            TransactionFor = model.TransactionFor
                        };
                        await SaveGetUpdatePaymentDetails(PaymentData);
                    }


                    var approvalUrl = result.Links.FirstOrDefault(link => link.Rel == "approve")?.Href;

                    if (approvalUrl != null)
                    {
                        response.Status = true;
                        response.Message = "Payment initiated successfully.";
                        response.Data = new { ApprovalUrl = approvalUrl };  // Send the approval URL for redirection
                    }
                    else
                    {
                        response.Status = false;
                        response.Message = "No approval URL found. Payment creation failed.";
                        response.Data = null;
                    }
                }
                else
                {
                    response.Status = false;
                    response.Message = "Payment creation failed.";
                    response.Data = null;
                }
                //}
                //else
                //{
                //    response.Status = false;
                //    response.Message = "Amount Not Match.";
                //    response.Data = null;
                //}



            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                response.Status = false;
                response.Message = "An error occurred while processing the payment.";
                response.Data = ex.Message; // Optional: Include exception details for debugging
            }

            return response;
        }

        public async Task<DTOResponsemodel> ProcessPaymentAsync(PaymentDetails1 model)
        {
            var response = new DTOResponsemodel();
            var Monthly = _configuration["SubscriptionType:Monthly"];
            var Quarterly = _configuration["SubscriptionType:quarterly"];
            var Yearly = _configuration["SubscriptionType:Yearly"];

            try
            {
                // Validate input parameters
                if (string.IsNullOrEmpty(model.token))
                {
                    response.Status = false;
                    response.Message = "Invalid token. Please provide a valid token.";
                    return response;
                }

                if (string.IsNullOrEmpty(model.PayerID))
                {
                    response.Status = false;
                    response.Message = "Invalid PayerID. Please provide a valid PayerID.";
                    return response;
                }


                var request = new OrdersGetRequest(model.token);
                var payPalResponse = await _client.Execute(request);

                if (payPalResponse == null || payPalResponse.StatusCode != HttpStatusCode.OK)
                {
                    response.Status = false;
                    response.Message = "Failed to retrieve payment details from PayPal.";
                    return response;
                }

                var orderDetails = payPalResponse.Result<PayPalCheckoutSdk.Orders.Order>();
                if (orderDetails == null)
                {
                    response.Status = false;
                    response.Message = "PayPal order details are null.";
                    return response;
                }


                var paymentDetail = await SaveGetUpdatePaymentDetails(new OnlinePayments { PaymentGatewayTransactionID = model.token });

                if (paymentDetail == null)
                {
                    response.Status = false;
                    response.Message = "No payment details found for the provided token.";
                    return response;
                }



                // Step 3: Extract payment details
                var paymentDetails = new OnlinePayments
                {
                    //C3HeaderId = Convert.ToInt32(paymentDetail.Rows[0]["C3HeaderId"] ?? 0) ,
                    //PaymentTransactionId = orderDetails.Id ?? "Unknown",
                    PaymentStatus = orderDetails.Status ?? "Unknown",
                    //PaymentCreatedDate = orderDetails.CreateTime?.ToString() ?? DateTime.UtcNow.ToString(),
                    PaymentGatewayTransactionID = orderDetails.Id ?? "Unknown",
                    PaymentAmount = decimal.TryParse(orderDetails.PurchaseUnits?.FirstOrDefault()?.AmountWithBreakdown?.Value, out var amount) ? amount : 0,
                    Currency = orderDetails.PurchaseUnits?.FirstOrDefault()?.AmountWithBreakdown?.CurrencyCode ?? "Unknown",
                    RefCustomerName = orderDetails.Payer?.Name?.GivenName ?? "Unknown",
                    //Email = orderDetails.Payer?.Email ?? "Unknown",
                    //Phone = "Unknown",
                    //Address = orderDetails.Payer?.AddressPortable?.AddressLine1 ?? "Unknown",
                    //Address1 = orderDetails.Payer?.AddressPortable?.AddressLine2 ?? "Unknown",
                    //Pincode = orderDetails.Payer?.AddressPortable?.PostalCode ?? "Unknown",
                    PaymentPayerId = orderDetails.Payer?.PayerId ?? "Unknown",
                    //StartDate = paymentDetail.SubStartDate.ToString(),
                    //EndDate = paymentDetail.SubEndDate.ToString(),

                };



                var data = await SaveGetUpdatePaymentDetails(paymentDetails);
                if (data == null)
                {
                    response.Status = false;
                    response.Message = "Failed to save payment and reminder details to the database.";
                    return response;
                }

                // Step 6: Return success response
                response.Status = true;
                response.Message = "200";
                response.Data = paymentDetails;
            }
            catch (HttpRequestException httpEx)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, httpEx.Message, httpEx.StackTrace);
                response.Status = false;
                response.Message = "HTTP request error: " + httpEx.Message;
            }
            catch (NullReferenceException nullEx)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, nullEx.Message, nullEx.StackTrace);
                response.Status = false;
                response.Message = "A null reference occurred: " + nullEx.Message;
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                response.Status = false;
                response.Message = "An unexpected error occurred while processing payment.";
                response.Data = ex.Message; // Optional for debugging in non-production environments
            }

            return response;
        }

        public async Task<DTOResponsemodel> ProcessPaymentCancelAsync(string token)
        {
            var response = new DTOResponsemodel();
            try
            {
                // Validate input parameters
                if (string.IsNullOrEmpty(token))
                {
                    response.Status = false;
                    response.Message = "Invalid token. Please provide a valid token.";
                    return response;
                }


                var request = new OrdersGetRequest(token);
                var payPalResponse = await _client.Execute(request);

                if (payPalResponse == null || payPalResponse.StatusCode != HttpStatusCode.OK)
                {
                    response.Status = false;
                    response.Message = "Failed to retrieve payment details from PayPal.";
                    return response;
                }

                var orderDetails = payPalResponse.Result<PayPalCheckoutSdk.Orders.Order>();
                if (orderDetails == null)
                {
                    response.Status = false;
                    response.Message = "PayPal order details are null.";
                    return response;
                }


                var paymentDetail = await SaveGetUpdatePaymentDetails(new OnlinePayments { PaymentGatewayTransactionID = token });

                if (paymentDetail == null)
                {
                    response.Status = false;
                    response.Message = "No payment details found for the provided token.";
                    return response;
                }

                if (orderDetails.Status == "CREATED")
                {
                    orderDetails.Status = "CANCEL";
                }


                // Step 3: Extract payment details
                var paymentDetails = new OnlinePayments
                {
                    //C3HeaderId = Convert.ToInt32(paymentDetail.Rows[0]["C3HeaderId"] ?? 0) ,
                    //PaymentTransactionId = orderDetails.Id ?? "Unknown",
                    PaymentStatus = orderDetails.Status ?? "Unknown",
                    //PaymentCreatedDate = orderDetails.CreateTime?.ToString() ?? DateTime.UtcNow.ToString(),
                    PaymentGatewayTransactionID = orderDetails.Id ?? "Unknown",
                    PaymentAmount = decimal.TryParse(orderDetails.PurchaseUnits?.FirstOrDefault()?.AmountWithBreakdown?.Value, out var amount) ? amount : 0,
                    Currency = orderDetails.PurchaseUnits?.FirstOrDefault()?.AmountWithBreakdown?.CurrencyCode ?? "Unknown",
                    RefCustomerName = orderDetails.Payer?.Name?.GivenName ?? _Context.Secusers.FirstOrDefault(c => c.UserId == Convert.ToInt32(paymentDetail.Rows[0]["UserId"]))?.FirstName ?? "Unknown",
                    //Email = orderDetails.Payer?.Email ?? "Unknown",
                    //Phone = "Unknown",
                    //Address = orderDetails.Payer?.AddressPortable?.AddressLine1 ?? "Unknown",
                    //Address1 = orderDetails.Payer?.AddressPortable?.AddressLine2 ?? "Unknown",
                    //Pincode = orderDetails.Payer?.AddressPortable?.PostalCode ?? "Unknown",
                    PaymentPayerId = orderDetails.Payer?.PayerId ?? "Unknown",
                    //StartDate = paymentDetail.SubStartDate.ToString(),
                    //EndDate = paymentDetail.SubEndDate.ToString(),

                };



                var data = await SaveGetUpdatePaymentDetails(paymentDetails);
                if (data == null)
                {
                    response.Status = false;
                    response.Message = "Failed to save payment and reminder details to the database.";
                    return response;
                }

                // Step 6: Return success response
                response.Status = true;
                response.Message = "200";
                response.Data = paymentDetails;
            }
            catch (HttpRequestException httpEx)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, httpEx.Message, httpEx.StackTrace);
                response.Status = false;
                response.Message = "HTTP request error: " + httpEx.Message;
            }
            catch (NullReferenceException nullEx)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, nullEx.Message, nullEx.StackTrace);
                response.Status = false;
                response.Message = "A null reference occurred: " + nullEx.Message;
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                response.Status = false;
                response.Message = "An unexpected error occurred while processing payment.";
                response.Data = ex.Message; // Optional for debugging in non-production environments
            }

            return response;
        }
        public string GenerateTransactionId()
        {
            // Create a GUID and extract numeric characters
            string guidPart = Guid.NewGuid().ToString("N").Substring(0, 10);

            return guidPart;
        }


        public async Task<DataTable> SaveGetUpdatePaymentDetails(OnlinePayments model)
        {
            DataTable resultTable = new DataTable();
            using (SqlConnection conn = C3WizardLayerConn_BaseData.StaticSqlConnection)
            {
                using (SqlCommand cmd = new SqlCommand("InsertOrGetOnlinePayment", conn))
                {
                    cmd.CommandType = CommandType.StoredProcedure;

                    // Add parameters
                    cmd.Parameters.AddWithValue("@C3HeaderId", model.C3HeaderId);
                    cmd.Parameters.AddWithValue("@cardType", model.cardType);
                    cmd.Parameters.AddWithValue("@IscardView", model.IscardView);
                    cmd.Parameters.AddWithValue("@CardNumber", model.CardNumber);
                    cmd.Parameters.AddWithValue("@CardMonthExpiry", model.CardMonthExpiry);
                    cmd.Parameters.AddWithValue("@cardHolderName", model.cardHolderName);
                    cmd.Parameters.AddWithValue("@CVV", model.CVV);
                    cmd.Parameters.AddWithValue("@apiResponse", model.apiResponse);
                    cmd.Parameters.AddWithValue("@userId", model.UserId);
                    cmd.Parameters.AddWithValue("@payerId", model.PaymentPayerId);
                    cmd.Parameters.AddWithValue("@CreateTime", model.CreateTime);
                    cmd.Parameters.AddWithValue("@Currency", model.Currency);
                    cmd.Parameters.AddWithValue("@PaymentAmount", model.PaymentAmount);
                    cmd.Parameters.AddWithValue("@TransactionFor", model.TransactionFor);
                    cmd.Parameters.AddWithValue("@CustomerName", model.RefCustomerName);
                    cmd.Parameters.AddWithValue("@PaymentId", model.PaymentId);
                    cmd.Parameters.AddWithValue("@PaymentGatewayTransactionID", model.PaymentGatewayTransactionID);
                    cmd.Parameters.AddWithValue("@TransactionTypeId", model.TransactionTypeId);
                    cmd.Parameters.AddWithValue("@PaymentStatus", model.PaymentStatus);
                    cmd.Parameters.AddWithValue("@CreatedBy", model.CreatedBy);
                    cmd.Parameters.AddWithValue("@CreatedOn", DBNull.Value);
                    cmd.Parameters.AddWithValue("@IsActive", model.IsActive);

                    cmd.Parameters.AddWithValue("@totalLeavy", model.totalLeavy);
                    cmd.Parameters.AddWithValue("@totalLevyeepenalty", model.totalLevyeepenalty);
                    cmd.Parameters.AddWithValue("@totalServayance", model.totalServayance);
                    cmd.Parameters.AddWithValue("@totalPepenalty", model.totalPepenalty);
                    cmd.Parameters.AddWithValue("@totalSscontributions", model.totalSscontributions);
                    cmd.Parameters.AddWithValue("@totalSspenalty", model.totalSspenalty);
                    cmd.Parameters.AddWithValue("@bimaReceiptNumber", model.bimaReceiptNumber);
                    cmd.Parameters.AddWithValue("@bimaPaymentResponse", model.bimaPaymentResponse);

                    cmd.Parameters.AddWithValue("@UpdateExisting", string.IsNullOrEmpty(model.PaymentPayerId) ? 0 : 1);

                    conn.Open();
                    using (SqlDataAdapter adapter = new SqlDataAdapter(cmd))
                    {
                        adapter.Fill(resultTable);
                    }
                }
            }

            return resultTable;

        }

