        public bool CaptureTrueForProcessPayment { get; set; } = false;

        public PtsV2PaymentsPost201Response Runbb()
        {

            string clientReferenceInformationCode = "INDIA_TXN_001";// TC50171_3";
            Ptsv2paymentsClientReferenceInformation clientReferenceInformation = new Ptsv2paymentsClientReferenceInformation(
                Code: clientReferenceInformationCode
           );

            bool processingInformationCapture = false;
            if (CaptureTrueForProcessPayment)
            {
                processingInformationCapture = true;
            }

            Ptsv2paymentsProcessingInformation processingInformation = new Ptsv2paymentsProcessingInformation(
                Capture: processingInformationCapture
           );

            string paymentInformationCardNumber = "4111111111111111";
            string paymentInformationCardExpirationMonth = "12";
            string paymentInformationCardExpirationYear = "2031";
            Ptsv2paymentsPaymentInformationCard paymentInformationCard = new Ptsv2paymentsPaymentInformationCard(
                Number: paymentInformationCardNumber,
                ExpirationMonth: paymentInformationCardExpirationMonth,
                ExpirationYear: paymentInformationCardExpirationYear,
                SecurityCode: "123"

           );

            Ptsv2paymentsPaymentInformation paymentInformation = new Ptsv2paymentsPaymentInformation(
                Card: paymentInformationCard
           );

            string orderInformationAmountDetailsTotalAmount = "102.21";
            string orderInformationAmountDetailsCurrency = "XCD";
            Ptsv2paymentsOrderInformationAmountDetails orderInformationAmountDetails = new Ptsv2paymentsOrderInformationAmountDetails(
                TotalAmount: orderInformationAmountDetailsTotalAmount,
                Currency: orderInformationAmountDetailsCurrency
           );

            string orderInformationBillToFirstName = "John";
            string orderInformationBillToLastName = "Doe";
            string orderInformationBillToAddress1 = "1 Market St";
            string orderInformationBillToLocality = "Mumbai";
            string orderInformationBillToAdministrativeArea = "MH";
            string orderInformationBillToPostalCode = "400001";
            string orderInformationBillToCountry = "IN";
            string orderInformationBillToEmail = "test@cybs.com";
            string orderInformationBillToPhoneNumber = "9871275884";
            Ptsv2paymentsOrderInformationBillTo orderInformationBillTo = new Ptsv2paymentsOrderInformationBillTo(
                FirstName: orderInformationBillToFirstName,
                LastName: orderInformationBillToLastName,
                Address1: orderInformationBillToAddress1,
                Locality: orderInformationBillToLocality,
                AdministrativeArea: orderInformationBillToAdministrativeArea,
                PostalCode: orderInformationBillToPostalCode,
                Country: orderInformationBillToCountry,
                Email: orderInformationBillToEmail,
                PhoneNumber: orderInformationBillToPhoneNumber

           );

            Ptsv2paymentsOrderInformation orderInformation = new Ptsv2paymentsOrderInformation(
                AmountDetails: orderInformationAmountDetails,
                BillTo: orderInformationBillTo
           );

            var requestObj = new CreatePaymentRequest(
                ClientReferenceInformation: clientReferenceInformation,
                ProcessingInformation: processingInformation,
                PaymentInformation: paymentInformation,
                OrderInformation: orderInformation
           );

            try
            {
                var configDictionary = CyberSourceConfig.GetConfig();
                var clientConfig = new CyberSource.Client.Configuration(merchConfigDictObj: configDictionary);


                var apiInstance = new PaymentsApi(clientConfig);
                PtsV2PaymentsPost201Response result = apiInstance.CreatePayment(requestObj);
                Console.WriteLine(result);

                return result;
            }
            catch (ApiException e)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, e.Message, e.StackTrace);
                Console.WriteLine("Error Code: " + e.ErrorCode);
                Console.WriteLine("Error Message: " + e.Message);
                Console.WriteLine("Exception on calling the API : " + e.Message);

                return null;
            }
        }


        public DateTime? GetValidDate(string date)
        {
            if (string.IsNullOrWhiteSpace(date))
                return null;

            string[] formats = {
        "yyyy-MM-dd",
        "yyyy-MM-ddTHH:mm:ss",
        "dd/MM/yyyy",
        "dd-MM-yyyy",
        "MM/dd/yyyy",
        "M/d/yyyy",
        "d/M/yyyy"
    };

            DateTime dt;

            // Try exact formats first
            if (DateTime.TryParseExact(date, formats,
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out dt))
            {
                return dt;
            }

            if (DateTime.TryParse(date, out dt))
                return dt;


            return null; // invalid date
        }

        public async Task<DataTable> PayCharge(PaymentFormModelVm modal)
        {

            var resposedata = new BimaPaymentResponse();
            //var result = (from user in _Context.Secusers

            //              join company in _Context.MasterCompanies
            //                  on user.REG_NUMBER equals company.RegNumber into companyGroup
            //              from company in companyGroup.DefaultIfEmpty()

            //              join selfEmployee in _Context.SelfEmployees
            //                  on user.REG_NUMBER equals selfEmployee.SocSecNum into selfEmployeeGroup
            //              from selfEmployee in selfEmployeeGroup.DefaultIfEmpty()

            //              where user.UserId == modal.UserId

            //              select new
            //              {
            //                  user,
            //                  company,
            //                  selfEmployee
            //              }).FirstOrDefault();
            var result = (from user in _Context.SECUsersProfiles

                          join company in _Context.MasterCompanies
                              on user.REG_NUMBER equals company.RegNumber into companyGroup
                          from company in companyGroup.DefaultIfEmpty()

                          join selfEmployee in _Context.SelfEmployees
                              on user.REG_NUMBER equals selfEmployee.SocSecNum into selfEmployeeGroup
                          from selfEmployee in selfEmployeeGroup.DefaultIfEmpty()

                          where user.UserId == modal.UserId && user.EmpId == modal.companyId

                          select new
                          {
                              user,
                              company,
                              selfEmployee
                          }).FirstOrDefault();

            decimal TotalLevyeeemployer = 0;
            decimal TotalLevyeepenalty = 0;
            decimal TotalServayance = 0;
            decimal TotalPepenalty = 0;
            decimal TotalSscontributions = 0;
            decimal TotalSspenalty = 0;


            if (result.user.ISSelfEmployee)
            {
                if (await validateRegNumber(result.user.REG_NUMBER, "self") != "1")
                {
                    return null;
                }

                var charges = _Context.ProcessSelfEmployedC3s?.FirstOrDefault(e => e.Sec3id == modal.C3HeaderId);
                TotalLevyeeemployer = 0;
                TotalLevyeepenalty = 0;
                TotalServayance = 0;
                TotalPepenalty = 0;
                TotalSscontributions = Convert.ToDecimal(charges?.TotalContributions ?? 0);
                TotalSspenalty = Convert.ToDecimal(charges.TotalFine ?? 0);
            }
            else
            {

                if (await validateRegNumber(result.company.RegNumber, "comp") != "1")
                {
                    return null;
                }

                var charges = _Context.ProcessC3headers?.FirstOrDefault(e => e.C3headerid == modal.C3HeaderId);

                TotalLevyeeemployer = Convert.ToDecimal((charges.TotalLevyeeemployee ?? 0) + (charges?.TotalLevyeeemployer ?? 0));
                TotalLevyeepenalty = Convert.ToDecimal(charges.TotalLevyeepenalty ?? 0);
                TotalServayance = Convert.ToDecimal(charges.TotalServayance ?? 0);
                TotalPepenalty = Convert.ToDecimal(charges.TotalPepenalty ?? 0);
                TotalSscontributions = Convert.ToDecimal(charges.TotalSscontributions ?? 0);
                TotalSspenalty = Convert.ToDecimal(charges.TotalSspenalty ?? 0);
            }

            var siteSetting = _Context.SiteSetting.FirstOrDefault(e => e.IsActive);
            var merchantId = siteSetting.MerchantId;
            var keyId = siteSetting.KeyId;
            var secretKey = siteSetting.SecretKey;
            var resource = "/pts/v2/payments";
            var baseUrl = siteSetting.BaseUrl;
            var host = new Uri(siteSetting.BaseUrl).Host;




            string _expirationMonth = "";
            string _expirationYear = "";
            bool isSelfEmployee = result?.user?.ISSelfEmployee ?? false;

            if (!string.IsNullOrEmpty(modal.ExpirationYear) && modal.ExpirationYear.Contains("/"))
            {
                var parts = modal.ExpirationYear.Split('/');
                if (parts.Length == 2)
                {
                    _expirationMonth = parts[0].Trim();
                    _expirationYear = parts[1].Trim();
                }
            }
            string codeId = GenerateTransactionId();


            var body = new
            {
                clientReferenceInformation = new { code = codeId },
                buyerInformation = new
                {
                    //customerId = result?.user.LoginId,
                    merchantCustomerId = isSelfEmployee ? result?.selfEmployee?.SocSecNum : result?.company?.RegNumber,
                    email = isSelfEmployee ? result?.selfEmployee.Email : result?.company.Email,
                    mobilePhoneNumber = isSelfEmployee ? result?.selfEmployee?.Mobile : result?.company?.Mobile,
                    //dateOfBirth = isSelfEmployee ? result?.selfEmployee?.BirthDate : null,// result?.company?.BirthDate.ToString("yyyy-MM-dd"),
                },
                deviceInformation = new
                {
                    fingerprintSessionId = modal.UserId // <-- This should be passed from frontend
                },
                processingInformation = new
                {
                    capture = true,
                    commerceIndicator = "internet"
                },
                paymentInformation = new
                {
                    card = new
                    {
                        number = modal.CardNumber,
                        expirationMonth = _expirationMonth,
                        expirationYear = _expirationYear,
                        securityCode = modal.SecurityCode,
                        fullName = modal.cardHolderName
                    }
                },
                orderInformation = new
                {
                    amountDetails = new
                    {
                        totalAmount = modal?.TotalAmount,//"123.06",
                        currency = "XCD"
                    },
                    billTo = new
                    {
                        firstName = isSelfEmployee ? result?.selfEmployee?.FirstName : result?.company?.CompanyName,
                        lastName = isSelfEmployee ? result?.selfEmployee?.LastName : result?.company?.TradeName,//"Doe",
                        address1 = isSelfEmployee ? result?.selfEmployee?.Address1 : result?.company?.Address1,// "1 market st",
                        locality = isSelfEmployee ? result?.selfEmployee?.Address2 : result?.company?.Address2,// "san francisco",
                        administrativearea = isSelfEmployee ? result?.selfEmployee?.City : result?.company?.City,//"ca",
                        postalcode = "00000",//"94105",
                        country = "KN",//"us",
                        email = isSelfEmployee ? result?.selfEmployee?.Email : result?.company?.Email,//userData.EmailId,//"test@example.com",
                        phoneNumber = isSelfEmployee ? result?.selfEmployee?.Phone : result?.company?.Landline,//"4158880000"
                    },
                    shippingInformation = new
                    {
                        firstName = isSelfEmployee ? result?.selfEmployee?.FirstName : result?.company?.CompanyName,
                        lastName = isSelfEmployee ? result?.selfEmployee?.LastName : result?.company?.TradeName,//"Doe",
                        address1 = isSelfEmployee ? result?.selfEmployee?.Address1 : result?.company?.Address1,// "1 market st",
                        locality = isSelfEmployee ? result?.selfEmployee?.Address2 : result?.company?.Address2,// "san francisco",
                        administrativearea = isSelfEmployee ? result?.selfEmployee?.City : result?.company?.City,//"ca",
                        postalcode = "00000",//"94105",
                        country = "KN",//"us",
                        email = isSelfEmployee ? result?.selfEmployee?.Email : result?.company?.Email,//userData.EmailId,//"test@example.com",
                        phoneNumber = isSelfEmployee ? result?.selfEmployee?.Phone : result?.company?.Landline,//"4158880000"
                    },

                }
            };


            var jsonPayload = JsonConvert.SerializeObject(body);
            var headers = GenerateHeaders(jsonPayload, resource, merchantId, keyId, secretKey, host);

            var request = new HttpRequestMessage(HttpMethod.Post, $"{baseUrl}{resource}")
            {
                Content = new StringContent(jsonPayload, Encoding.UTF8, "application/json")
            };

            foreach (var header in headers)
            {
                request.Headers.TryAddWithoutValidation(header.Key, header.Value);
            }
            var client = new System.Net.Http.HttpClient();
            var responseCyber = await client.SendAsync(request);
            var responseContent = await responseCyber.Content.ReadAsStringAsync();
            var payload = new BimaPaymentRequestVM();

            var dataApi = JsonConvert.DeserializeObject<PaymentAuthorizedResponse>(responseContent);

            string status = dataApi.status.ToString();
            string clientReferenceInformation = dataApi.id.ToString();
            string totalAmount = "";
            string transactionId = "";
            string submitTimeUtc = "";
            if (status is "DECLINED")
            {
                totalAmount = modal.TotalAmount.ToString();
                submitTimeUtc = GetValidDate(DateTime.Now.Date.ToString())?.ToString("yyyy-MM-dd");
                transactionId = dataApi?.processorInformation?.transactionId?.ToString();
            }
            else if (status is "AUTHORIZED")
            {
                submitTimeUtc = GetValidDate(dataApi.submitTimeUtc.ToString())?.ToString("yyyy-MM-dd");
                totalAmount = dataApi.orderInformation.amountDetails.totalAmount.ToString();
                transactionId = dataApi.processorInformation.transactionId.ToString();


                payload.paymentHeaders = result.user.ISSelfEmployee ?
                       [
                        new PaymentHeaderVm { fundCode= "SS", paymentCode= "SSC", paymentAmount = TotalSscontributions },
                    new PaymentHeaderVm { fundCode="SS",paymentCode= "SSF", paymentAmount = TotalSspenalty },
                        ]
                       :
                   [
                       new PaymentHeaderVm { fundCode= "LV", paymentCode= "LVC", paymentAmount=TotalLevyeeemployer },
                    new PaymentHeaderVm { fundCode="LV",paymentCode="LVF",paymentAmount = TotalLevyeepenalty  },
                    new PaymentHeaderVm { fundCode= "SS", paymentCode= "SSC", paymentAmount = TotalSscontributions },
                    new PaymentHeaderVm { fundCode="SS",paymentCode= "SSF", paymentAmount = TotalSspenalty },
                    new PaymentHeaderVm { fundCode= "PE", paymentCode= "PEC", paymentAmount = TotalServayance  },
                    new PaymentHeaderVm { fundCode="PE",paymentCode= "PEF", paymentAmount =TotalPepenalty  },
               ];

                if (modal.isBimapost == true)
                {


                    //payload.BankCode = null;
                    //payload.CreditCardCode = null;
                    payload.mopCode = "ONL";
                   

                    string Newsurl = _configuration["ServiceConfig:ServiceUriString"];
                    string type = result?.user?.ISSelfEmployee == true ? "SE" : "ER";
                    string payerid = result?.user?.ISSelfEmployee == true ? result?.user?.REG_NUMBER : result?.company.RegNumber;
                    string NewsURL = Newsurl + "/api/payment/save/" + payerid + "/" + type;
                    var myContent = JsonConvert.SerializeObject(payload);
                    var buffer = System.Text.Encoding.UTF8.GetBytes(myContent);
                    var byteContent = new ByteArrayContent(buffer);
                    byteContent.Headers.ContentType = new MediaTypeHeaderValue("application/json");


                    HttpMessageHandler handler = new HttpClientHandler()
                    {
                    };

                    var httpClient = new System.Net.Http.HttpClient(handler)
                    {
                        BaseAddress = new Uri(NewsURL),
                        Timeout = new TimeSpan(0, 2, 0)
                    };
                    httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                    //This is the key section you were missing    
                    // var plainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : System.Text.Encoding.UTF8.GetBytes(result.user.LoginId + ":" + result.user.Password);
                    var plainTextBytes = System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]);

                    string val = System.Convert.ToBase64String(plainTextBytes);
                    httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + val);

                    HttpResponseMessage response = httpClient.PostAsync(NewsURL, byteContent).Result;
                    if (response.StatusCode == HttpStatusCode.OK)
                    {
                        var customerJsonString = await response.Content.ReadAsStringAsync();
                       
                        resposedata = JsonConvert.DeserializeObject<BimaPaymentResponse>(customerJsonString);
                      
     
                    }
                    else
                    {
                        modal.isBimapost = false;
                        resposedata.message = await response.Content.ReadAsStringAsync();
                    }

                }

            }
            else
            {
                totalAmount = modal.TotalAmount.ToString();
                submitTimeUtc = GetValidDate(DateTime.Now.Date.ToString())?.ToString("yyyy-MM-dd"); 
                transactionId = dataApi?.processorInformation?.transactionId?.ToString();
            }


            var PaymentData = new OnlinePayments();

            // Assign all properties one by one
            PaymentData.UserId = modal.UserId;
            PaymentData.RefCustomerName = isSelfEmployee
                ? (result?.selfEmployee?.FirstName + " " + result?.selfEmployee?.LastName + " (" + result?.user?.REG_NUMBER) + ") "
