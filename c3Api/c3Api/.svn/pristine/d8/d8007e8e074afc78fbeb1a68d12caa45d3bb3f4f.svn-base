        public PaymentRepo(IConfiguration configuration, C3wizardContext context)
        {


            _configuration = configuration;
            this._Context = context;
            // Replace with your actual credentials
            var environment = new SandboxEnvironment(_configuration["PaymentUrl:ClientID"], _configuration["PaymentUrl:ClientSecret"]);
            //var clientid = _configuration["PaymentUrl:ClientID"];
            //var clientsecret =_configuration["PaymentUrl:ClientSecret"];


            //var environment = new LiveEnvironment("YourClientID", "YourSecret");

            _client = new PayPalHttpClient(environment);

