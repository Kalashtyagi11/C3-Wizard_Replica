        public async Task<int> CardDetailUpdate(CarddetailsModelVm obj)
        {
            var cardData = _Context.UserCardDetails?.OrderByDescending(r => r.Id)?.FirstOrDefault(e => e.UserId == obj.UserId && (e.IsActive ?? true));
            if (cardData != null && obj.mode == 1)
            {

                cardData.CardHolderName = obj.cardHolderName;
                cardData.CardNumber = obj.CardNumber;
                cardData.CardMonthExpiry = obj.ExpirationYear;
                cardData.CVV = obj.SecurityCode;
                cardData.CardType = obj.cardtype;

            }
            else if (cardData != null && obj.mode == 0)
            {
                _Context.UserCardDetails.Remove(cardData);
            }
            else
            {
                return 0;
            }

            _Context.SaveChanges();
            return 1;
        }
        public async Task<OnlinePayments> transacion(int userId, int C3HeaderId, string? transactionId)
        {
            var cardData = _Context.OnlinePayments.FirstOrDefault(e =>  e.C3HeaderId == C3HeaderId && e.IsActive && (string.IsNullOrEmpty(transactionId) ? e.PaymentStatus == "AUTHORIZED" && e.UserId == userId  : e.PaymentGatewayTransactionID == transactionId));
            return cardData;

        }

        public async Task<List<TestOnlinePayments>> TestPaymentTransaction()
        {
            var data = _Context.TestOnlinePayments.Select(e => new TestOnlinePayments { TransactionFor = e.TransactionFor, PaymentGatewayTransactionID = e.PaymentGatewayTransactionID, PaymentStatus = e.PaymentStatus, CreateTime = e.CreateTime, PaymentAmount = e.PaymentAmount, }).ToList();
            return data;
        }

        public async Task<ResponseModel> GetOfflinePaymentDirector(int HeaderId)
        {
            ResponseModel response = new ResponseModel();

            var result = await _Context.ProcessC3headers
                .Where(p => p.C3headerid == HeaderId && p.ForDirector == true)
                .ToListAsync();

            var data = result
                .Select(p => new GetOfflinePaymentDataVm
                {
                    Period = MonthName(p.PerioddMonth.ToString()) + " " + p.PeriodYear,
                    CreationDate = p.InsertDatetimeinfo,
                    Schedule = p.ScheduleNo,
                    //TotalWages = p.TotalWages,
                    SocialSecurity = p.TotalSscontributions,
                    Levy = p.TotalLevyeeemployee,
                    Penalty = p.TotalPepenalty,
                    Severance = p.TotalServayance,
                    TotalLevyeepenalty = p.TotalLevyeepenalty,
                    TotalSspenalty = p.TotalSspenalty,
                    Total = p.TotalSscontributions + p.TotalLevyeeemployee + p.TotalServayance + p.TotalLevyeepenalty + p.TotalPepenalty + p.TotalSspenalty
                })
                .ToList();

            if (data.Any())
            {
                response.Status = true;
                response.Message = "Data retrieved successfully";
                response.Statuscode = 200;
                response.Data = data;
            }
            else
            {
                response.Status = false;
                response.Message = "No data found";
                response.Statuscode = 404;
                response.Data = null;
            }

            return response;
        }

        public async Task<ResponseModel> GetOfflinePaymentDirectorSelf(int SelfHeaderId)
        {
            ResponseModel response = new ResponseModel();

            var result = await _Context.ProcessSelfEmployedC3s
                .Where(p => p.Sec3id == SelfHeaderId)
                .ToListAsync();

            var data = result
                .Select(p => new GetOfflinePaymentDataVm
                {
                    Period = MonthName(p.PerioddMonth.ToString()) + " " + p.PeriodYear,
                    CreationDate = p.InsertDatetimeinfo,
                    Schedule = p.ScheduleNo,
                    //TotalWages = p.TotalWages,
                    SocialSecurity = p.TotalContributions,
                    //Levy = p.TotalLevyeeemployee,
                    Penalty = p.TotalFine,
                    //Severance = p.TotalServayance,
                    Total = p.TotalContributions + p.TotalFine
                })
                .ToList();

            if (data.Any())
            {
                response.Status = true;
                response.Message = "Data retrieved successfully";
                response.Statuscode = 200;
                response.Data = data;
            }
            else
            {
                response.Status = false;
                response.Message = "No data found";
                response.Statuscode = 404;
                response.Data = null;
            }

            return response;
        }




