        public async Task<ResponseModel> GetReconciliationDataAsync()
        {
            ResponseModel response = new ResponseModel();
            DataTable dt = new DataTable();

            string connectionString = _configuration.GetConnectionString("DefaultConnection");

            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                using (SqlCommand cmd = new SqlCommand("GetdataReconciliationPayment", conn))
                {
                    cmd.CommandType = CommandType.StoredProcedure;
                    await conn.OpenAsync();

                    using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                    {
                        dt.Load(reader);
                    }
                }
            }

            if (dt.Rows.Count > 0)
            {
                var result = dt.AsEnumerable().Select(row => new
                {
                    PaymentGatewayTransactionID = row["PaymentGatewayTransactionID"].ToString(),
                    PaymentAmount = "$" + Convert.ToDecimal(row["PaymentAmount"]).ToString("N2"),
                    PaymentStatus = row["PaymentStatus"].ToString(),
                    InvoiceNumber = row["InvoiceNumber"].ToString(),
                    CardNumber = row["CardNumber"].ToString(),
                    TransactionDate = row["TransactionDate"] == DBNull.Value ? (DateTime?)null : Convert.ToDateTime(row["TransactionDate"]),
                    ReconciliationStatus = row["ReconciliationStatus"].ToString()
                }).ToList();

                response.Status = true;
                response.Message = "Data retrieved successfully";
                response.Statuscode = 200;
                response.Data = result;
            }
            else
            {
                response.Status = false;
                response.Message = "No data found";
                response.Statuscode = 404;
                response.Data = null;
            }

            return response;
        }
        public async Task<ResponseModel> GetReconciliationCyberSourceAsync()
        {
            ResponseModel response = new ResponseModel();
            DataTable dt = new DataTable();

            string connectionString = _configuration.GetConnectionString("DefaultConnection");

            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                using (SqlCommand cmd = new SqlCommand("GetdataReconciliationPaymentCyberSource", conn))
                {
                    cmd.CommandType = CommandType.StoredProcedure;
                    await conn.OpenAsync();

                    using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                    {
                        dt.Load(reader);
                    }
                }
            }

            if (dt.Rows.Count > 0)
            {


                var result = dt.AsEnumerable()
             .Select(row => dt.Columns
                .Cast<DataColumn>()
                .ToDictionary(col => col.ColumnName, col => row[col]))
            .ToList();

                response.Data = result;


                response.Status = true;
                response.Message = "Data retrieved successfully";
                response.Statuscode = 200;
                //response.Data = result;
            }
            else
            {
                response.Status = false;
                response.Message = "No data found";
                response.Statuscode = 404;
                response.Data = null;
            }

            return response;
        }
        public async Task<ResponseModel> GetReconciliationCyberSourceAsync(int pageNumber, int pageSize, DateTime? fromDate, DateTime? toDate, string status, string cardHolderName)
        {
            ResponseModel response = new ResponseModel();
            DataTable dt = new DataTable();

            string connectionString = _configuration.GetConnectionString("DefaultConnection");

            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                using (SqlCommand cmd = new SqlCommand("GetdataReconciliationPaymentCyberSource", conn))
                {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.Parameters.AddWithValue("@FromDate", (object?)fromDate ?? DBNull.Value);
                    cmd.Parameters.AddWithValue("@ToDate", (object?)toDate ?? DBNull.Value);
                    cmd.Parameters.AddWithValue("@Status", (object?)status ?? DBNull.Value);
                    cmd.Parameters.AddWithValue("@CardHolderName", (object?)cardHolderName ?? DBNull.Value);



                    await conn.OpenAsync();

                    using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                    {
                        dt.Load(reader);
                    }
                }
            }

            if (dt.Rows.Count > 0)
            {


                var result = dt.AsEnumerable()
             .Select(row => dt.Columns
                .Cast<DataColumn>()
                .ToDictionary(col => col.ColumnName, col => row[col]))
            .ToList();

                int totalRecords = result.Count;
                int totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

                // Apply pagination
                //var pagedCompanies = result
                //    .Skip((pageNumber - 1) * pageSize)
                //    .Take(pageSize)
                //    .ToList();
                var pagedCompanies = result
                      .Skip(pageNumber * pageSize)
                      .Take(pageSize)
                      .ToList();

                if (pagedCompanies.Any())
                {
                    response.Message = "Data retrieved successfully!";
                    response.Statuscode = 200;
                    response.Status = true;
                    response.Data = new
                    {
                        TotalRecords = totalRecords,
                        PageNumber = pageNumber,
                        PageSize = pageSize,
                        TotalPages = totalPages,
                        Records = pagedCompanies
                    };
                }
                else
                {
                    response.Message = "No data found.";
                    response.Statuscode = 404;
                    response.Status = false;
                }
            }

            return response;
        }


        public async Task<Stream> ExportToExcel(List<PayPalTransactionExcelList> transactions)
        {
            using (var package = new ExcelPackage())
            {
                var sheet = package.Workbook.Worksheets.Add("PayPal Transactions");
                sheet.Cells[1, 1].Value = "Transaction ID";
                sheet.Cells[1, 2].Value = "Status";
                sheet.Cells[1, 3].Value = "Amount";
                sheet.Cells[1, 4].Value = "Currency";
                sheet.Cells[1, 5].Value = "Payer Email";

                for (int i = 0; i < transactions.Count; i++)
                {
                    var t = transactions[i];
                    sheet.Cells[i + 2, 1].Value = t.Id;
                    sheet.Cells[i + 2, 2].Value = t.Status;
                    sheet.Cells[i + 2, 3].Value = t.Amount;
                    sheet.Cells[i + 2, 4].Value = t.Currency;
                    sheet.Cells[i + 2, 5].Value = t.PayerEmail;
                }

                //package.SaveAs(new FileInfo(filePath));
                var stream = new MemoryStream();
                package.SaveAs(stream);
                stream.Position = 0;
                return stream;
            }
        }

        public async Task<Paymentdata> getAllCompanyTrans(string? PaymentStatus, DateTime? FromDate, DateTime? ToDate, int? CompanyId, int? UserId, string types)
        {
            var returnData = new List<PayPeriod1>();
            List<C3HeaderVM> Director_listDVOC3Header = new List<C3HeaderVM>();
            List<C3HeaderVM> listDVOC3Header = new List<C3HeaderVM>();
            List<C3HeaderVM> selfList = new List<C3HeaderVM>();
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            SqlCommand cmd = new SqlCommand("Get_TransactionHistory", staticConnection);
            cmd.CommandType = CommandType.StoredProcedure;
            //cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
            cmd.Parameters.AddWithValue("@PaymentStatus", string.IsNullOrEmpty(PaymentStatus) ? (object)DBNull.Value : PaymentStatus);
            cmd.Parameters.AddWithValue("@FromDate", FromDate.HasValue ? (object)FromDate : DBNull.Value);
            cmd.Parameters.AddWithValue("@ToDate", ToDate.HasValue ? (object)ToDate.Value : DBNull.Value);
            cmd.Parameters.AddWithValue("@CompanyId", CompanyId.HasValue ? (object)CompanyId.Value : DBNull.Value);
            cmd.Parameters.AddWithValue("@UserId", UserId.HasValue ? (object)UserId.Value : DBNull.Value);
            cmd.Parameters.AddWithValue("@types", string.IsNullOrEmpty(types) ? (object)DBNull.Value : types);
            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
            //DataTable dt = new DataTable();
            //sqlAdapter.Fill(dt);
            DataSet ds = new DataSet();
            sqlAdapter.Fill(ds);
            if (ds.Tables.Count > 0)
            {
                for (int i = 0; i < ds.Tables.Count; i++)
                {
                    DataTable dt = ds.Tables[i];
                    foreach (DataRow row in dt.Rows)
                    {
                        if ((types == roleCategory.SSB.ToString() && i == 0) || types == roleCategory.Company.ToString())
                        {
                            if (row["Types"].ToString() == "company")
                            {
                                bool issubmited = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                                string period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : MonthName(row["PERIODD_MONTH"].ToString());
                                string Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString();

                                var Obj = new C3HeaderVM();

                                Obj.HeaderID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                                Obj.userId = Convert.IsDBNull(row["UserId"]) ? 0 : int.Parse(row["UserId"].ToString());
                                Obj.RegNo = Convert.IsDBNull(row["RegNo"]) ? null : row["RegNo"].ToString();
                                Obj.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : MonthName(row["PERIODD_MONTH"].ToString());
                                Obj.PMonth = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? 0 : Convert.ToInt32(row["PERIODD_MONTH"]);
                                Obj.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString();
                                Obj.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
                                Obj.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_SSCONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString())));
                                Obj.TOTALLEVYEEEMPLOYEE = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString())));
                                Obj.TOTALSERVAYANCE = Convert.IsDBNull(row["TOTAL_SERVAYANCE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SERVAYANCE"].ToString())));
                                Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString(Helper.DisplayDateFormat);
                                Obj.Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                                Obj.Is_submitted = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                                Obj.C3_IsFinalized = Convert.IsDBNull(row["C3_IsFinalized"]) ? false : bool.Parse(row["C3_IsFinalized"].ToString());
                                //Obj.IsUnLocked = Convert.IsDBNull(row["IsUnLocked"]) ? false : bool.Parse(row["IsUnLocked"].ToString());
                                //Obj.IsUnLocked = !Obj.IsUnLocked;
                                //Obj.IssubmittedShow = (bool)Obj.Is_submitted ? "C3 Submitted" : "C3 Not Submitted";
                                //Obj.Issubmittedcolor = (bool)Obj.Is_submitted ? "Black" : "Red";

                                //Obj.IssubmittedShowimg = (bool)Obj.Is_submitted ? "/img/RightSine.png" : "/img/close.png";
                                // Obj.C3submittedShow = (bool)Obj.Is_submitted ? "Resubmit C3" : "Submit C3";
                                //Obj.C3submittedShowimg = (bool)Obj.Is_submitted ? "/Images/restore.png" : "/Images/finalyze20x20.png";
                                Obj.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                                Obj.TOTALPEPENALTY = Convert.IsDBNull(row["TOTAL_PEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_PEPENALTY"].ToString())));
                                Obj.TOTALSSPENALTY = Convert.IsDBNull(row["TOTAL_SSPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSPENALTY"].ToString())));
