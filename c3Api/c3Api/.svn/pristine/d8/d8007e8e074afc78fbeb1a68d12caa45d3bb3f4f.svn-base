        public async Task<byte[]> GeneratePdfUsingWkhtmltopdf(string htmlContent)
        {

            string directoryPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "lib");
            if (!Directory.Exists(directoryPath))
            {
                Directory.CreateDirectory(directoryPath);
            }
            var wkhtmlPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "lib", "bin", "wkhtmltopdf.exe");
            var projectPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot/lib/bin/wkhtmltopdf.exe");

            var psi = new ProcessStartInfo
            {
                FileName = wkhtmlPath,
                Arguments = "--quiet - -",
                RedirectStandardInput = true,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };

            using var process = new Process { StartInfo = psi };
            process.Start();

            // Write HTML content to stdin
            await process.StandardInput.WriteAsync(htmlContent);
            process.StandardInput.Close();

            // Read the generated PDF from stdout
            using var ms = new MemoryStream();
            await process.StandardOutput.BaseStream.CopyToAsync(ms);

            string errors = await process.StandardError.ReadToEndAsync();
            process.WaitForExit();

            if (process.ExitCode != 0)
            {
                throw new Exception("wkhtmltopdf failed: " + errors);
            }

            return ms.ToArray();
        }

    }

}

