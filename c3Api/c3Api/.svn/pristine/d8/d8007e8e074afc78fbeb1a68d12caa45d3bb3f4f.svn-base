            //    RefCustomerName = isSelfEmployee ? (result?.selfEmployee?.FirstName + " " + result?.selfEmployee?.LastName + " " + result?.user?.REG_NUMBER) : result?.company?.CompanyName + " " + result?.user?.REG_NUMBER,
