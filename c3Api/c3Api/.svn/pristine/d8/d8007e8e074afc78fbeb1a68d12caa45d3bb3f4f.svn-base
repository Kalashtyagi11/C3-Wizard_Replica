            //    bimaReceiptNumber = null,//resposedata?.receiptId?.ToString(),
            //    bimaPaymentResponse = resposedata

            //};
            var Paymentdata = await SaveGetUpdatePaymentDetails(PaymentData);

            if (modal.saveCard)
