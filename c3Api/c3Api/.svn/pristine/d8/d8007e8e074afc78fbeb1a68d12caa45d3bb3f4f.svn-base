        public string GenerateDigest(string payload)
        {
            var hash = SHA256.Create().ComputeHash(Encoding.UTF8.GetBytes(payload));
            return "SHA-256=" + Convert.ToBase64String(hash);
        }

        public string GenerateSignature(string method, string resource, string digest, string merchantId, string keyId, string secretKey, string host)
        {
            string date = DateTime.UtcNow.ToString("r"); // RFC1123

            var signatureString = $"host: {host}\n" +
                                  $"date: {date}\n" +
                                  $"(request-target): {method.ToLower()} {resource}\n" +
                                  $"digest: {digest}\n" +
                                  $"v-c-merchant-id: {merchantId}";

            byte[] secretKeyBytes = Convert.FromBase64String(secretKey);
            using var encoder = new HMACSHA256(secretKeyBytes);
            byte[] signatureBytes = encoder.ComputeHash(Encoding.UTF8.GetBytes(signatureString));
            string signatureBase64 = Convert.ToBase64String(signatureBytes);

            string header = $"keyid=\"{keyId}\", algorithm=\"HmacSHA256\", headers=\"host date (request-target) digest v-c-merchant-id\", signature=\"{signatureBase64}\"";
            return header;
        }

        public Dictionary<string, string> GenerateHeaders(string payload, string resource, string merchantId, string keyId, string secretKey, string host)
        {
            string digest = GenerateDigest(payload);
            string date = DateTime.UtcNow.ToString("r");

            return new Dictionary<string, string>
        {
            { "v-c-merchant-id", merchantId },
            { "Date", date },
            { "Host", host },
            { "Digest", digest },
            { "Signature", GenerateSignature("POST", resource, digest, merchantId, keyId, secretKey,host) },
            { "Content-Type", "application/json" }
        };
        }


        public async Task<UserCardDetail?> CardDetails(int userId)
        {
