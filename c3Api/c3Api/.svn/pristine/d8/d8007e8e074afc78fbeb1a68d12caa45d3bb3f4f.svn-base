                                //Director_Obj.company = Convert.IsDBNull(row["CompanyNames"]) ? null : JsonConvert.DeserializeObject<List<userAndCompny>>(row["CompanyNames"].ToString());

                                Director_listDVOC3Header.Add(Director_Obj);
                            }
                        }
                        else if (types == roleCategory.SelfEmployee.ToString() || types == roleCategory.SSB.ToString())
                        {
                            C3HeaderVM self = new C3HeaderVM();
                            self.HeaderID = Convert.IsDBNull(row["SEC3ID"]) ? 0 : int.Parse(row["SEC3ID"].ToString());
                            //self.RegNo = Convert.IsDBNull(row["SSN"]) ? null : row["SSN"].ToString();
                            self.userId = Convert.IsDBNull(row["UserId"]) ? 0 : int.Parse(row["UserId"].ToString());
                            self.PMonth = Convert.ToInt32(row["PERIODD_MONTH"].ToString());
                            self.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == string.Empty ? null : MonthName(row["PERIODD_MONTH"].ToString());
                            self.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == string.Empty ? null : row["PERIOD_YEAR"].ToString();
                            self.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
                            self.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_CONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_CONTRIBUTIONS"].ToString())));
                            self.TOTALSSPENALTY = Convert.IsDBNull(row["TOTAL_Fine"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["TOTAL_Fine"].ToString());
                            self.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString(Helper.DisplayDateFormat);
                            ////self.Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                            // self.Is_submitted = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                            //self.C3_IsFinalized = Convert.IsDBNull(row["C3_IsFinalized"]) ? false : bool.Parse(row["C3_IsFinalized"].ToString());
                            //self.C3_IsFinalized = !self.C3_IsFinalized;
                            //self.IssubmittedShow = (bool)Director_Obj.Is_submitted ? "C3 Submitted" : "C3 Not Submitted";
                            //self.Issubmittedcolor = (bool)Director_Obj.Is_submitted ? "Black" : "Red";
                            //self.IssubmittedShowimg = (bool)Director_Obj.Is_submitted ? "/img/RightSine.png" : "/img/close.png";
                            //self.C3submittedShow = (bool)Director_Obj.Is_submitted ? "Resubmit C3" : "Submit C3";
                            // self.C3submittedShowimg = (bool)Director_Obj.Is_submitted ? "/Images/restore.png" : "/Images/finalyze20x20.png";
                            self.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                            self.PayDetails = Convert.IsDBNull(row["PaymentHistory"]) ? null : JsonConvert.DeserializeObject<List<TransactionDetails>>(row["PaymentHistory"].ToString());
                            //self.users = Convert.IsDBNull(row["Users"]) ? null : JsonConvert.DeserializeObject<List<userAndCompny>>(row["Users"].ToString());
                            // selfList.company = Convert.IsDBNull(row["CompanyNames"]) ? null : JsonConvert.DeserializeObject<List<userAndCompny>>(row["CompanyNames"].ToString());
                            selfList.Add(self);
                        }


                    }
                }



                var DVOC3Header = listDVOC3Header.Select(obj => new C3HeaderVM
                {
                    HeaderID = obj.HeaderID,
                    RegNo = obj.RegNo,
                    period_Month = obj.period_Month,
                    Period_year = obj.Period_year,
                    TOTAL_WAGES = obj.TOTAL_WAGES,
                    TOTALSSCONTRIBUTIONS = obj.TOTALSSCONTRIBUTIONS,
                    TOTALLEVYEEEMPLOYEE = obj.TOTALLEVYEEEMPLOYEE,
                    TOTALSERVAYANCE = obj.TOTALSERVAYANCE,
                    Insert_Datetimeinfo = obj.Insert_Datetimeinfo,
                    Is_Fianalize = obj.Is_Fianalize,
                    Is_submitted = obj.Is_submitted,
                    //C3_IsFinalized = obj.C3_IsFinalized,
                    //IsUnLocked = obj.IsUnLocked,
                    //IssubmittedShow = obj.IssubmittedShow,
                    //Issubmittedcolor = obj.Issubmittedcolor,
                    //IssubmittedShowimg = obj.IssubmittedShowimg,
                    // C3submittedShow = obj.C3submittedShow,
                    // C3submittedShowimg = obj.C3submittedShowimg,
                    Schedule_NO = obj.Schedule_NO,
                    PMonth = obj.PMonth,
                    TOTALPEPENALTY = obj.TOTALPEPENALTY,
                    TOTALSSPENALTY = obj.TOTALSSPENALTY,
                    TOTALLEVYEEPENALTY = obj.TOTALLEVYEEPENALTY,
                    TotalSSBpenanlity = obj.TOTALPEPENALTY + obj.TOTALSSPENALTY + obj.TOTALLEVYEEPENALTY,
                    PayDetails = obj.PayDetails,
                    //users = obj.users,
                    //company = obj.company
                    userId = obj.userId
                }).ToList();

                var Director = Director_listDVOC3Header.Select(obj => new C3HeaderVM
                {
                    HeaderID = obj.HeaderID,
                    RegNo = obj.RegNo,
                    period_Month = obj.period_Month,
                    Period_year = obj.Period_year,
                    TOTAL_WAGES = obj.TOTAL_WAGES,
                    TOTALSSCONTRIBUTIONS = obj.TOTALSSCONTRIBUTIONS,
                    TOTALLEVYEEEMPLOYEE = obj.TOTALLEVYEEEMPLOYEE,
                    TOTALSERVAYANCE = obj.TOTALSERVAYANCE,
                    Insert_Datetimeinfo = obj.Insert_Datetimeinfo,
                    Is_Fianalize = obj.Is_Fianalize,
                    Is_submitted = obj.Is_submitted,
                    //C3_IsFinalized = obj.C3_IsFinalized,
                    // IsUnLocked = obj.IsUnLocked,
                    // IssubmittedShow = obj.IssubmittedShow,
                    //Issubmittedcolor = obj.Issubmittedcolor,
                    //IssubmittedShowimg = obj.IssubmittedShowimg,
                    //C3submittedShow = obj.C3submittedShow,
                    //C3submittedShowimg = obj.C3submittedShowimg,
                    Schedule_NO = obj.Schedule_NO,
                    TOTALPEPENALTY = obj.TOTALPEPENALTY,
                    TOTALSSPENALTY = obj.TOTALSSPENALTY,
                    TOTALLEVYEEPENALTY = obj.TOTALLEVYEEPENALTY,
                    TotalSSBpenanlity = obj.TOTALLEVYEEPENALTY,
                    PayDetails = obj.PayDetails,
                    //users = obj.users,
                    //company = obj.company
                    userId = obj.userId
                }).ToList();

                var Selfdata = selfList.Select(e => new C3HeaderVM
                {
                    Period_year = e.Period_year,
                    period_Month = e.period_Month,
                    PMonth = e.PMonth,
                    TOTAL_WAGES = e.TOTAL_WAGES,
                    TOTALSSCONTRIBUTIONS = e.TOTALSSCONTRIBUTIONS,
                    Insert_Datetimeinfo = e.Insert_Datetimeinfo,
                    HeaderID = e.HeaderID,
                    RegNo = e.RegNo,
                    TOTALSSPENALTY = e.TOTALSSPENALTY,
                    Schedule_NO = e.Schedule_NO,
                    PayDetails = e.PayDetails,
                    //users = e.users
                    userId = e.userId
                }).ToList();

                DVOC3Header.AddRange(Director);
                DVOC3Header.AddRange(selfList);

                int totalRecordsDir = DVOC3Header.Count;
                int totalPagesDir = (int)Math.Ceiling((double)totalRecordsDir / pageSize);
                var pagedDir = DVOC3Header
                    .Skip(pageNumber * pageSize)
                    .Take(pageSize)
                    .ToList();

                //int totalRecordsComp = DVOC3Header.Count;
                //int totalPagesComp = (int)Math.Ceiling((double)totalRecordsComp / pageSize);
                //var pagedCompany = DVOC3Header
                //    .Skip(pageNumber * pageSize)
                //    .Take(pageSize)
                //    .ToList();

                //int totalRecordsSelf = Selfdata.Count;
                //int totalPagesSelf = (int)Math.Ceiling((double)totalRecordsSelf / pageSize);
                //var pagedSelf = Selfdata
                //    .Skip(pageNumber * pageSize)
                //    .Take(pageSize)
                //    .ToList();
                if (pagedDir.Any())
                {
                    response.Message = "Data retrieved successfully!";
                    response.Statuscode = 200;
                    response.Status = true;
                    response.Data = new
                    {
                        TransactionList = new
                        {
                            TotalRecords = totalRecordsDir,
                            PageNumber = pageNumber,
                            PageSize = pageSize,
                            TotalPages = totalPagesDir,
                            Records = pagedDir
                        },

                    };
                }
                else
                {
                    response.Message = "No data found.";
                    response.Statuscode = 404;
                    response.Status = false;
                }
                return response;

            }

            return response;
        }

        public string MonthNameZeroindex(string m_no)
        {
            string Month = "";
            switch (m_no)
            {
                case "0":
                    Month = "January";
                    break;
                case "1":
                    Month = "February";
                    break;
                case "2":
                    Month = "March";
                    break;
                case "3":
                    Month = "April";
                    break;
                case "4":
                    Month = "May";
                    break;
                case "5":
                    Month = "June";
                    break;
                case "6":
                    Month = "July";
                    break;
                case "7":
                    Month = "August";
                    break;
                case "8":
                    Month = "September";
                    break;
                case "9":
                    Month = "October";
                    break;
                case "10":
                    Month = "November";
                    break;
                case "11":
                    Month = "December";
                    break;
                default:
                    Month = string.Empty;
                    break;
            }


            return Month;
        }


