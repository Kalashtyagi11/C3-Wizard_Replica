          TextTotalWagesNLevy = blemp.LEVYEE.ToString();
          TextLevyPenalty = Latemonths >= 2 ? decimal.Parse(String.Format("{0:0.00}", (blemp.LEVYEE * ((Latemonths - 1) * 5) / 100))).ToString() : "0.00";
          TextTotalAccountantGeneral = (decimal.Parse(String.Format("{0:0.00}", decimal.Parse(TextLevyPenalty) + blemp.LEVYEE))).ToString();



        }
        string ManthName = MonthName(monthNum.ToString());
        var obj = new selfEmpVm
        {
          textTotalWages = TextTotalWages,
          textTotalWagesNLevy = TextTotalWagesNLevy,
          textLevyPenalty = TextLevyPenalty,
