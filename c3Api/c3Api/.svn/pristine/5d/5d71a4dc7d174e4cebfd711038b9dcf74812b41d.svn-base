    public async Task<List<C3HeaderVM>> load_defaults(string ssN)
    {
      var listDVOC3Header = new List<C3HeaderVM>();
      var ObjC3Header = new C3HeaderVM();
      var listC3Header = new List<C3HeaderVM>();
      SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
      SqlCommand cmd = new SqlCommand("Get_PROCESS_Self_Employed_C3_Genrated_data", staticConnection);
      cmd.CommandType = CommandType.StoredProcedure;
      cmd.Parameters.Add(new SqlParameter("@SSN", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)ssN ?? (object)DBNull.Value));
      SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
      DataTable dt = new DataTable();
      sqlAdapter.Fill(dt);
      if (dt.Rows.Count > 0)
      {
        foreach (DataRow row in dt.Rows)
        {
          C3HeaderVM Obj = new C3HeaderVM();
          Obj.HeaderID = Convert.IsDBNull(row["SEC3ID"]) ? 0 : int.Parse(row["SEC3ID"].ToString());
          Obj.RegNo = Convert.IsDBNull(row["SSN"]) ? null : row["SSN"].ToString();
          Obj.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == string.Empty ? null : MonthName(row["PERIODD_MONTH"].ToString());
          Obj.PMonth = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? 0 : Convert.ToInt32(row["PERIODD_MONTH"]);
          Obj.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == string.Empty ? null : row["PERIOD_YEAR"].ToString();
          Obj.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
          Obj.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_CONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_CONTRIBUTIONS"].ToString())));
          Obj.TOTALSSPENALTY = Convert.IsDBNull(row["TOTAL_Fine"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["TOTAL_Fine"].ToString());
          Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString(Helper.DisplayDateFormat);
          Obj.Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
          Obj.Is_submitted = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());

          listDVOC3Header.Add(Obj);
          //}
        }
        foreach (var row in listDVOC3Header)
        {
          bool is_f = listDVOC3Header.Any(X => X.Is_Fianalize != true && X.period_Month == row.period_Month && X.Period_year == row.Period_year);
          bool issubmited = row.Is_submitted;
          bool isfinalize = row.Is_Fianalize;
          if (issubmited == false)
          {
            C3HeaderVM Obj = new C3HeaderVM();
            Obj.HeaderID = row.HeaderID;
            Obj.RegNo = row.RegNo;
            Obj.PMonth = row.PMonth;
            Obj.period_Month = row.period_Month;
            Obj.Period_year = row.Period_year;
            Obj.TOTAL_WAGES = row.TOTAL_WAGES;
            Obj.TOTALSSCONTRIBUTIONS = row.TOTALSSCONTRIBUTIONS + row.TOTALSSPENALTY;
            Obj.payAmt = Obj.TOTALSSCONTRIBUTIONS;
            Obj.TOTALSSPENALTY = row.TOTALSSPENALTY;
            Obj.Insert_Datetimeinfo = row.Insert_Datetimeinfo;
            Obj.Is_Fianalize = is_f ? false : true;
            Obj.Is_submitted = row.Is_Fianalize;
            listC3Header.Add(Obj);
          }
        }
      }
      return listC3Header;
      //C3ReportsList.ItemsSource = listC3Header;
      //C3ReportsList.SelectedIndex = -1;
      //CollectionView view = (CollectionView)CollectionViewSource.GetDefaultView(C3ReportsList.ItemsSource);
      // PropertyGroupDescription groupDescription = new PropertyGroupDescription("Period_year");
      //view.GroupDescriptions.Add(groupDescription);
    }



    public async Task<List<SelfEmployedC3ReportVM>> check_batch_created(int Month, string year, int SEC3ID)
    {
      //close_button.Visibility = Visibility.Visible;
      //ReportDataSource reportDataSource = new ReportDataSource();
      //Month = Month - 1;
      var reports = new List<SelfEmployedC3ReportVM>();
      DataTable dt = new DataTable();
      //is_dashboard = is_dash;
      SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
      SqlCommand cmd = new SqlCommand("Generate_Self_Employed_C3_Report", staticConnection);
      cmd.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)Month.ToString() ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)year ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@SEC3ID", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)SEC3ID ?? (object)DBNull.Value));
      cmd.CommandType = CommandType.StoredProcedure;
      //SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
      //sqlAdapter.Fill(dt);
      if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
      using (SqlDataReader reader = cmd.ExecuteReader())
      {
        while (reader.Read())
        {
          reports.Add(new SelfEmployedC3ReportVM
          {
            EmpName = reader["emp_name"].ToString(),
            SocialSecurityNo = reader["social_security_no"].ToString(),
            CompanyAddress = reader["company_address"].ToString(),
            CurrentMonth = reader["current_month"].ToString(),
            FirstWeekOfMonth = reader["first_week_of_month"].ToString(),
            SecondWeekOfMonth = reader["second_week_of_month"].ToString(),
            date = reader["Reportdate"].ToString(),
            ThirdWeekOfMonth = reader["third_week_of_month"].ToString(),
            FourthWeekOfMonth = reader["four_week_of_month"].ToString(),
            FifthWeekOfMonth = reader["five_week_of_month"].ToString(),
            DeductLeavyWages = Convert.ToDecimal(reader["deduct_leavy_wages"]),
            TotalWages = Convert.ToDecimal(reader["total_wages"]),
            fine = Convert.ToDecimal(reader["TOTAL_LEVYEEPENALTY"]),
            Remarks = reader["remarks"].ToString(),
            grandTotal = Convert.ToDecimal(reader["deduct_leavy_wages"]) + Convert.ToDecimal(reader["TOTAL_LEVYEEPENALTY"]),
            Category_Type = reader["Category_Type"].ToString(),
            // Map additional fields here
          });
        }
      }
      staticConnection.Close();
      return reports;

      // ReportDataSource rprtDTSource = new ReportDataSource("C3Report", dt);
      // reportDataSource.Name = "CustomerReport"; // Name of the DataSet we set in .rdlc
      // reportViewer.LocalReport.ReportPath = Helper.ApplicationPath("SelfEmployedC3Report.rdlc");  // Path of the rdlc file
      // reportViewer.LocalReport.DataSources.Add(rprtDTSource);
      // reportViewer.SetDisplayMode(Microsoft.Reporting.WinForms.DisplayMode.PrintLayout);
      // reportViewer.ZoomMode = ZoomMode.Percent;
      // reportViewer.ZoomPercent = 100;
      // reportViewer.RefreshReport();
    }


    public async Task<List<dashboarddata>> btn_Search_ReprtsSelfEmp(int F_month, int T_month, string year, int CompanyId)
    {

      try
      {
        //int F_month = CmbFromMonth.SelectedIndex;
        //int T_month = CmbToMonth.SelectedIndex;

        List<BLSelfEmployed> emplist = BLSelfEmployed.SelfEmployedCollection().ToList();
        emplist = emplist.Where(x => x.EmployeeID == CompanyId).ToList();
        var SSNofEmp = emplist.Count > 0 ? emplist.FirstOrDefault().SocSecNum : null;

        //ComboBoxItem year = (ComboBoxItem)CmbYear.SelectedItem;
        string value = year;//CmbYear.SelectedItem != null ? CmbYear.SelectedItem.ToString() : null;
        string S_year = year;// CmbYear.Text != "" ? value : null;
        List<C3Header> listDVOC3Header = new List<C3Header>();
        SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
        SqlCommand cmd = new SqlCommand("Get_PROCESS_Self_Employed_C3_Genrated_data", staticConnection);
        cmd.CommandType = CommandType.StoredProcedure;
        cmd.Parameters.Add(new SqlParameter("@SSN", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)SSNofEmp ?? (object)DBNull.Value));
        SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
        DataTable dt = new DataTable();
        sqlAdapter.Fill(dt);
        if (dt.Rows.Count > 0)
        {
          foreach (DataRow row in dt.Rows)
          {
            bool issubmited = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
            bool isfinalize = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
            int C3month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? -1 : int.Parse(row["PERIODD_MONTH"].ToString());
            int C3year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? -1 : int.Parse(row["PERIOD_YEAR"].ToString());
            if (true)//(issubmited == true || isfinalize == true))
            {
              C3Header Obj = new C3Header();
              Obj.HeaderID = Convert.IsDBNull(row["SEC3ID"]) ? 0 : int.Parse(row["SEC3ID"].ToString());
              Obj.RegNo = Convert.IsDBNull(row["SSN"]) ? null : row["SSN"].ToString();
              Obj.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == string.Empty ? null : MonthName(row["PERIODD_MONTH"].ToString());
              Obj.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == string.Empty ? null : row["PERIOD_YEAR"].ToString();
              Obj.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
              Obj.p_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? -1 : int.Parse(row["PERIODD_MONTH"].ToString());
              Obj.P_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? -1 : int.Parse(row["PERIOD_YEAR"].ToString());
              Obj.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_CONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_CONTRIBUTIONS"].ToString())));
              Obj.TOTALSSPENALTY = Convert.IsDBNull(row["TOTAL_Fine"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["TOTAL_Fine"].ToString());
              Obj.TOTALSSCONTRIBUTIONS = Obj.TOTALSSCONTRIBUTIONS + Obj.TOTALSSPENALTY;
              Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString(Helper.DisplayDateFormat);
              Obj.Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
              Obj.Is_submitted = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_submitted"].ToString());
              Obj.C3_IsFinalized = !Obj.C3_IsFinalized;
              Obj.IssubmittedShow = (bool)Obj.Is_submitted ? "C3 Submitted" : "C3 Not Submitted";
              Obj.Issubmittedcolor = (bool)Obj.Is_submitted ? "Black" : "Red";
              Obj.IssubmittedShowimg = (bool)Obj.Is_submitted ? "/img/RightSine.png" : "/img/close.png";
              listDVOC3Header.Add(Obj);
            }
          }
          listDVOC3Header = S_year != null ? listDVOC3Header.Where(x => x.Period_year == S_year).ToList() : listDVOC3Header;
          listDVOC3Header = F_month != -1 ? listDVOC3Header.Where(x => x.p_Month >= F_month).OrderBy(x => x.p_Month).ToList() : listDVOC3Header;
          listDVOC3Header = T_month != -1 ? listDVOC3Header.Where(x => x.p_Month <= T_month).OrderBy(x => x.p_Month).ToList() : listDVOC3Header;
          //dashboard_list.ItemsSource = listDVOC3Header;
          //dashboard_list.SelectedIndex = -1;

          var data = listDVOC3Header.Select(e => new dashboarddata
          {
            year = e.Period_year,
            month = e.period_Month,
            monthNo = e.p_Month,
            TotalWages = e.TOTAL_WAGES,
            Countribution = e.TOTALSSCONTRIBUTIONS,
            CreationDate = e.Insert_Datetimeinfo,
            HeaderId = e.HeaderID
          }).ToList();

          return data;
        }
        else
        {
          //dashboard_list.ItemsSource = null;
          return new List<dashboarddata>();
        }
        //}
      }
      catch (Exception ex)
      {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                //Login login = new Login();
                //login.Error_Log(ex.Message);
                return new List<dashboarddata>();
      }




    }



    public async Task<selfEmpVm> Editload_defaults(int? HeaderId, int CompanyId)
    {
      //var listDVOC3Header = new List<C3Header>();
      //var ObjC3Header = new C3Header();
      SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
      if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
      List<BLSelfEmployed> emplist = BLSelfEmployed.SelfEmployedCollection().ToList();
      emplist = emplist.Where(x => x.EmployeeID == CompanyId).ToList();
      var SSNofEmp = emplist.Count > 0 ? emplist.FirstOrDefault().SocSecNum : null;
      List<WageList> IncomCategory = new List<WageList>();



      staticConnection.Close();
      if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
      SqlCommand cmd = new SqlCommand("Get_PROCESS_Self_Employed_C3_Genrated_data", staticConnection);
      cmd.CommandType = CommandType.StoredProcedure;
      cmd.Parameters.Add(new SqlParameter("@SSN", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)SSNofEmp ?? (object)DBNull.Value));
      SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
      DataTable dt = new DataTable();
      sqlAdapter.Fill(dt);
      if (dt.Rows.Count > 0)
      {
        int monthIndex = -1;
        string userName = "";
        string year = "";
        var TextTotalWages = "";
        var TextTotalWagesNLevy = "";
        var TextLevyPenalty = "";
        var TextTotalAccountantGeneral = "";
        decimal? wcontribution = 0m;
        decimal? wincome = 0m;
        string? Category = "";
        var listSEC3Header = new List<C3ContributionVm>();
        foreach (DataRow row in dt.Rows)
        {
          C3ContributionVm blemp = new C3ContributionVm();
          int sc3H_Id = Convert.IsDBNull(row["SEC3ID"]) ? 0 : int.Parse(row["SEC3ID"].ToString());
          if (sc3H_Id == HeaderId)
          {
            //H_Id = HeaderId;
            monthIndex = Convert.IsDBNull(row["PERIODD_MONTH"]) ? -1 : int.Parse(row["PERIODD_MONTH"].ToString());
            //CmbYear.Text = Convert.IsDBNull(row["PERIOD_YEAR"]) ? null : row["PERIOD_YEAR"].ToString();
            year = Convert.IsDBNull(row["PERIOD_YEAR"]) ? null : row["PERIOD_YEAR"].ToString();
            //CmbYear.SelectedIndex = Helper.yearindex(ylist, int.Parse(year));
            // CmbYear.SelectedIndex = Helper.yearindex(ylist, int.Parse(year)) > -1 ? Helper.yearindex(ylist, int.Parse(year)) : Addyearindex(int.Parse(year));

            //string value = CmbYear.SelectedItem.ToString();
           // mondays = MondaysInMonth(monthIndex + 1, int.Parse(year));
            mondays = MondaysInMonth(monthIndex , int.Parse(year));
            IsWeekfifth = mondays == 5 ? true : false;
            blemp.SSN = Convert.IsDBNull(row["SSN"]) ? null : row["SSN"].ToString();
            blemp.PayFreq = Convert.IsDBNull(row["Category_Type"]) ? null : row["Category_Type"].ToString();
            blemp.EmployeeName = emplist.Count > 0 ? emplist.FirstOrDefault().LastName + " " + emplist.FirstOrDefault().FirstName : null;
            userName = blemp.EmployeeName;
            blemp.IsWeekfifth = IsWeekfifth;
            blemp.WEEK1 = Convert.IsDBNull(row["WEEK1"]) ? false : bool.Parse(row["WEEK1"].ToString());
            blemp.WEEK2 = Convert.IsDBNull(row["WEEK2"]) ? false : bool.Parse(row["WEEK2"].ToString());
            blemp.WEEK3 = Convert.IsDBNull(row["WEEK3"]) ? false : bool.Parse(row["WEEK3"].ToString());
            blemp.WEEK4 = Convert.IsDBNull(row["WEEK4"]) ? false : bool.Parse(row["WEEK4"].ToString());
            blemp.WEEK5 = Convert.IsDBNull(row["WEEK5"]) ? false : bool.Parse(row["WEEK5"].ToString());
            blemp.SelectedTypeWEEK1 = Convert.IsDBNull(row["SelectedTypeWEEK1"]) ? -1 : int.Parse(row["SelectedTypeWEEK1"].ToString());
            blemp.SelectedTypeWEEK2 = Convert.IsDBNull(row["SelectedTypeWEEK2"]) ? -1 : int.Parse(row["SelectedTypeWEEK2"].ToString());
            blemp.SelectedTypeWEEK3 = Convert.IsDBNull(row["SelectedTypeWEEK3"]) ? -1 : int.Parse(row["SelectedTypeWEEK3"].ToString());
            blemp.SelectedTypeWEEK4 = Convert.IsDBNull(row["SelectedTypeWEEK4"]) ? -1 : int.Parse(row["SelectedTypeWEEK4"].ToString());
            blemp.SelectedTypeWEEK5 = Convert.IsDBNull(row["SelectedTypeWEEK5"]) ? -1 : int.Parse(row["SelectedTypeWEEK5"].ToString());
            blemp.WAGES1 = Convert.IsDBNull(row["WAGES1"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES1"].ToString());
            blemp.WAGES2 = Convert.IsDBNull(row["WAGES2"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES2"].ToString());
            blemp.WAGES3 = Convert.IsDBNull(row["WAGES3"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES3"].ToString());
            blemp.WAGES4 = Convert.IsDBNull(row["WAGES4"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES4"].ToString());
            blemp.WAGES5 = Convert.IsDBNull(row["WAGES5"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES5"].ToString());
            blemp.tempWAGES1 = Convert.IsDBNull(row["WAGES1"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES1"].ToString());
            blemp.tempWAGES2 = Convert.IsDBNull(row["WAGES2"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES2"].ToString());
            blemp.tempWAGES3 = Convert.IsDBNull(row["WAGES3"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES3"].ToString());
            blemp.tempWAGES4 = Convert.IsDBNull(row["WAGES4"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES4"].ToString());
            blemp.tempWAGES5 = Convert.IsDBNull(row["WAGES5"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES5"].ToString());
            blemp.TotalWadeges = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
            blemp.LEVYEE = Convert.IsDBNull(row["TOTAL_CONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_CONTRIBUTIONS"].ToString())));
            blemp.Remarks = Convert.IsDBNull(row["Remarks"]) ? null : row["Remarks"].ToString();
            listSEC3Header.Add(blemp);
            TextTotalWages = blemp.TotalWadeges.ToString();
            TextTotalWagesNLevy = blemp.LEVYEE.ToString();
            TextLevyPenalty = Convert.IsDBNull(row["TOTAL_Fine"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)).ToString() : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_Fine"].ToString()))).ToString();
            TextTotalAccountantGeneral = (decimal.Parse(TextLevyPenalty) + decimal.Parse(TextTotalWagesNLevy)).ToString();


            if (ValidateC3settingExists(monthIndex, Convert.ToInt32(year)))
            {
              IncomCategory = WageCategory(S_E_S_id);
              foreach (var empl in emplist)
              {
                wincome = IncomCategory.Any(x => x.CategoryId == empl.Category_Type) ? IncomCategory.FirstOrDefault(x => x.CategoryId == empl.Category_Type).WeeklyIncome : decimal.Parse(String.Format("{0:0.00}", 0.00));
                wcontribution = IncomCategory.Any(x => x.CategoryId == empl.Category_Type) ? IncomCategory.FirstOrDefault(x => x.CategoryId == empl.Category_Type).WeeklyContribution : decimal.Parse(String.Format("{0:0.00}", 0.00));
                                Category = IncomCategory.Any(x => x.CategoryId == empl.Category_Type) ? IncomCategory.FirstOrDefault(x => x.CategoryId == empl.Category_Type).Category : "";
                            }
            }
          }
        }
        //AddC3RecordWages.ItemsSource = listSEC3Header;
        //AddC3RecordWages.SelectedIndex = -1;
        //wage1dbinded = true;
        //wage2dbinded = true;
        //wage3dbinded = true;
        //wage4dbinded = true;
        //wage5dbinded = true;

        var obj = new selfEmpVm
        {
          textTotalWages = TextTotalWages,
          textTotalWagesNLevy = TextTotalWagesNLevy,
          textLevyPenalty = TextLevyPenalty,
          textTotalAccountantGeneral = TextTotalAccountantGeneral,
          obj_list = listSEC3Header,
          wcontribution = wcontribution,
          wincome = wincome,
            category_Type = Category + " (Weekly Income :" + wincome + ", Weekly Contribution :" + wcontribution + ")",
            month = monthIndex,
          year = year,
          ssNofEmp = SSNofEmp,
          userName = userName
        };

        return obj;
      }
      //}
      else
      {
        //    C3WizardMessageBox.Show("C3 Wizard", "Self Employed Settings not exists for this month please add.");
        return new selfEmpVm();
      }


    }
  }
