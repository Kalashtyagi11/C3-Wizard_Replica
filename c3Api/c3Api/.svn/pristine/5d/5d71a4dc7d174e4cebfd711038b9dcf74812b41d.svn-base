          wcontribution = IncomCategory.Any(x => x.CategoryId == empl.Category_Type) ? IncomCategory.FirstOrDefault(x => x.CategoryId == empl.Category_Type).WeeklyContribution : decimal.Parse(String.Format("{0:0.00}", 0.00));
          Category= IncomCategory.Any(x => x.CategoryId == empl.Category_Type) ? IncomCategory.FirstOrDefault(x => x.CategoryId == empl.Category_Type).Category : "";
          blemp.SSN = empl.SocSecNum;
          blemp.C3HEADERID = 0;
          blemp.PayFreq = (empl.Category_Type).ToString();
          blemp.EmployeeId = empl.EmployeeID;
          blemp.EmployeeName = empl.LastName + " " + empl.FirstName;
          blemp.IsWeekfifth = IsWeekfifth;
          blemp.WEEK1 = true;
          blemp.WEEK2 = true;
          blemp.WEEK3 = true;
          blemp.WEEK4 = true;
          blemp.WEEK5 = IsWeekfifth;
          blemp.SelectedTypeWEEK1 = 0;
          blemp.SelectedTypeWEEK2 = 0;
          blemp.SelectedTypeWEEK3 = 0;
          blemp.SelectedTypeWEEK4 = 0;
          blemp.SelectedTypeWEEK5 = IsWeekfifth ? 0 : -1;
          blemp.WAGES1 = decimal.Parse(String.Format("{0:0.00}", (wincome)));
          blemp.WAGES2 = decimal.Parse(String.Format("{0:0.00}", (wincome)));
          blemp.WAGES3 = decimal.Parse(String.Format("{0:0.00}", (wincome)));
          blemp.WAGES4 = IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (wincome))) : decimal.Parse(String.Format("{0:0.00}", (wincome)));
          blemp.WAGES5 = IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (wincome))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
          address = string.Concat(empl.Address1, !string.IsNullOrEmpty(empl.Address2) ? " " + empl.Address2 : "");
          blemp.tempWAGES1 = decimal.Parse(String.Format("{0:0.00}", (wincome)));
          blemp.tempWAGES2 = decimal.Parse(String.Format("{0:0.00}", (wincome)));
          blemp.tempWAGES3 = decimal.Parse(String.Format("{0:0.00}", (wincome)));
          blemp.tempWAGES4 = IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (wincome))) : decimal.Parse(String.Format("{0:0.00}", (wincome)));
          blemp.tempWAGES5 = IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (wincome))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
          blemp.TotalWadeges = blemp.WAGES1 + blemp.WAGES2 + blemp.WAGES3 + blemp.WAGES4 + blemp.WAGES5;
          blemp.LEVYEE = IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", wcontribution * 5)) : decimal.Parse(String.Format("{0:0.00}", wcontribution * 4));
          blemp.BirthDate = ((DateTime)empl.BirthDate).ToString(Helper.SQLDateFormat);
          listforview.Add(blemp);
          //TextTotalWages.Text = blemp.TotalWadeges.ToString();
          //TextTotalWagesNLevy.Text = blemp.LEVYEE.ToString();
          //TextLevyPenalty.Text = Latemonths >= 2 ? decimal.Parse(String.Format("{0:0.00}", (blemp.LEVYEE * ((Latemonths - 1) * 5) / 100))).ToString() : "0.00";
          //TextTotalAccountantGeneral.Text = (decimal.Parse(String.Format("{0:0.00}", decimal.Parse(TextLevyPenalty.Text) + blemp.LEVYEE))).ToString();
          //wage1dbinded = true;
          //wage2dbinded = true;
          //wage3dbinded = true;
          //wage4dbinded = true;
          //wage5dbinded = true;
          //AddC3RecordWages.ItemsSource = listforview;
