    public async Task<string> btn_SearchSelfEmpContribution(int monthIndex, int Year, int CompanyId, int? SEC3ID)
    {


      string PatPmessage = "";
      if (monthIndex == -1)
      {
        PatPmessage += "pay period Month \n";
      }
      if (Year == -1)
      {
        PatPmessage += "pay period Year \n";
      }

      if (PatPmessage != "")
      {
        //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
        //C3WizardMessageBox.Show("C3 Wizard", "Please select \n \n" + PatPmessage);
        return "Please select" + PatPmessage;
      }
      ispayperiodchange = false;
      //searchclicked = true;
      //Monthselectedindex = CmbMonth.SelectedIndex;
      //yearselectedindex = CmbYear.SelectedIndex;
      if (monthIndex != -1 && Year != -1 /*&& (H_Id == 0)*/)
      {
        List<BLSelfEmployed> emplist = BLSelfEmployed.SelfEmployedCollection().ToList();
        emplist = emplist.Where(x => x.EmployeeID == CompanyId).ToList();
        string SSNofEmp = emplist.Count > 0 ? emplist.FirstOrDefault().SocSecNum : null;

        //Mouse.OverrideCursor = System.Windows.Input.Cursors.Wait;
        SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
        SqlCommand cmd = new SqlCommand("Check_SelfEmployed_C3Created", staticConnection);
        cmd.CommandType = CommandType.StoredProcedure;
        cmd.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)monthIndex ?? (object)DBNull.Value));
        cmd.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)Year ?? (object)DBNull.Value));
        cmd.Parameters.Add(new SqlParameter("@SSN", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)SSNofEmp ?? (object)DBNull.Value));
        cmd.Parameters.Add(new SqlParameter("@SEC3ID", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)SEC3ID ?? (object)DBNull.Value));

        SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
        DataTable dt = new DataTable();
        sqlAdapter.Fill(dt);
        if (dt.Rows.Count > 0)
        {
          //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
          //C3WizardMessageBox.Show("C3 Wizard", "Self employed C3 already exists");
          //return "Already-" + int.Parse(dt.Rows[0].ItemArray[0].ToString()); 
        }


        // mondays = MondaysInMonth(monthIndex + 1, Year);// Changes.....
        mondays = MondaysInMonth(monthIndex, Year);
        IsWeekfifth = mondays == 5 ? true : false;
        return await LoadEmployee(monthIndex, Year, emplist, SSNofEmp);

        //ButtonSave.IsEnabled = true;
        //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
      }
      return "please fill all required field..";
    }
