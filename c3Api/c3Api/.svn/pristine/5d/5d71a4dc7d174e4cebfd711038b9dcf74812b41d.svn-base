          currentMonth = ManthName + " " + year
        };

        return JsonConvert.SerializeObject(obj);
      }
      else
      {
        return "Self employed settings not exists for this month please add.";
      }


    }

    public string MonthName2(string m_no)
    {
      string Month = "";
      switch (m_no)
      {
        case "0":
          Month = "January";
          break;
        case "1":
          Month = "February";
          break;
        case "2":
          Month = "March";
          break;
        case "3":
          Month = "April";
          break;
        case "4":
          Month = "May";
          break;
        case "5":
          Month = "June";
          break;
        case "6":
          Month = "July";
          break;
        case "7":
          Month = "August";
          break;
        case "8":
          Month = "September";
          break;
        case "9":
          Month = "October";
          break;
        case "10":
          Month = "November";
          break;
        case "11":
          Month = "December";
          break;
        default:
          Month = string.Empty;
          break;
      }
      return Month;
    }
    public static int MondaysInMonth(int CmbMonth, int CmbYear)
    {
      int weeks = 0;
      int daysThisMonth = DateTime.DaysInMonth(CmbYear, CmbMonth);
      DateTime beginingOfThisMonth = new DateTime(CmbYear, CmbMonth, 1);
      for (int i = 0; i < daysThisMonth; i++)
        if (beginingOfThisMonth.AddDays(i).DayOfWeek == DayOfWeek.Monday)
          weeks++;
      return weeks;
    }

    int S_E_S_id = 0;
    public bool ValidateC3settingExists(int monthNum, int year)
    {

      string fyear = year.ToString();
      //old narender//int fmonthno = monthNum + 1;
      int fmonthno = monthNum;

      string fMvalue = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(fmonthno); ;
      string fmonthval = fmonthno <= 9 ? "0" + fmonthno.ToString() : fmonthno.ToString();
      DateTime? newFrom_date = DateTime.ParseExact(("01/" + fmonthval + "/" + fyear), Helper.DateFormat, CultureInfo.InvariantCulture);
      int daysfMonth = DateTime.DaysInMonth(int.Parse(fyear), fmonthno);
      DateTime? newTo_date = newFrom_date.Value.AddDays(daysfMonth - 1);

      SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);

      SqlCommand cmd = new SqlCommand("SelfEmployedSettingExists", staticConnection);
      cmd.CommandType = CommandType.StoredProcedure;
      cmd.Parameters.Add(new SqlParameter("@From_date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)newFrom_date ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@To_date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)newTo_date ?? (object)DBNull.Value));

      SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
      DataTable dt = new DataTable();
      sqlAdapter.Fill(dt);
      if (dt.Rows.Count > 0)
      {
        foreach (DataRow row in dt.Rows)
        {
          S_E_S_id = Convert.IsDBNull(row["SESId"]) ? 0 : int.Parse(row["SESId"].ToString());
          return true;
        }
      }
      return false;
    }

    private List<WageList> WageCategory(int? S_E_S_id)
    {
      List<WageList> wlist = new List<WageList>();
      DataSet CdataSet = new DataSet();
      try
      {

        //string SqlQuerystring = ConfigurationSettings.AppSettings.Get("AppConnection");

        SqlConnection con = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString);
        con.Open();
        SqlCommand cmd = new SqlCommand("SELECT CategoryID, Category, cast(WeeklyIncome as numeric(18,2)) as WeeklyIncome, cast(WeeklyContribution as numeric(18,2)) as WeeklyContribution FROM WageCategories where SESId=" + S_E_S_id, con);
        cmd.CommandType = CommandType.Text;
        SqlDataAdapter adapter = new SqlDataAdapter();
        adapter.SelectCommand = cmd;
        adapter.Fill(CdataSet);
        for (int i = 0; CdataSet.Tables[0].Rows.Count > i; i++)
        {
          WageList wcat = new WageList();
          wcat.CategoryId = Convert.IsDBNull(CdataSet.Tables[0].Rows[i][0]) ? (Int32?)null : (Int32?)CdataSet.Tables[0].Rows[i][0];
          wcat.Category = Convert.IsDBNull(CdataSet.Tables[0].Rows[i][1]) ? null : CdataSet.Tables[0].Rows[i][1].ToString();
          wcat.WeeklyIncome = Convert.IsDBNull(CdataSet.Tables[0].Rows[i][2]) ? (decimal?)null : (decimal?)CdataSet.Tables[0].Rows[i][2];
          wcat.WeeklyContribution = Convert.IsDBNull(CdataSet.Tables[0].Rows[i][3]) ? (decimal?)null : (decimal?)CdataSet.Tables[0].Rows[i][3];
          wlist.Add(wcat);
        }

        return wlist;

      }
      catch (Exception ex)
      {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                //Login login = new Login();
                //login.Error_Log(ex.Message);
                return wlist;
      }

    }


    public async Task<ContributionOnChange> BindCountribution(decimal wincome, decimal wcontribution, decimal wage_amt, decimal stw, decimal totalWadeg, decimal TextLevyPenalty, decimal TextTotalWagesNLevy, decimal Levyee, int monthNo, int year)
    {

      //decimal tempw1 = (decimal)((C3Contributions)(AddC3RecordWages.Items.GetItemAt(0))).tempWAGES1;
      //int monthno = monthNo + 1;//old zero index
            int monthno = monthNo;


         string value = year.ToString() != null ? year.ToString() : DateTime.Now.Year.ToString();

      //string Mvalue = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(monthNo);
      int daysin_month = DateTime.DaysInMonth(int.Parse(value), monthno);
      string monthval = monthno <= 9 ? "0" + monthno.ToString() : monthno.ToString();
      int Latemonths = (DateTime.Now.Year - int.Parse(value)) * 12 + DateTime.Now.Month - monthno;
      Latemonths = Latemonths <= 0 ? 0 : Latemonths;
      decimal T_levy = Levyee;
      //------
      var TotalWadeges = stw == 0 ? wage_amt == 0 ? decimal.Parse(String.Format("{0:0.00}", totalWadeg + wincome)) : decimal.Parse(String.Format("{0:0.00}", totalWadeg)) : wage_amt == 0 ? decimal.Parse(String.Format("{0:0.00}", totalWadeg)) : decimal.Parse(String.Format("{0:0.00}", totalWadeg - wincome));
      var LEVYEE = stw == 0 ? wage_amt == 0 ? decimal.Parse(String.Format("{0:0.00}", T_levy + wcontribution)) : decimal.Parse(String.Format("{0:0.00}", T_levy)) : wage_amt == 0 ? decimal.Parse(String.Format("{0:0.00}", T_levy)) : decimal.Parse(String.Format("{0:0.00}", T_levy - wcontribution));
      var TextTotalWages = stw == 0 ? wage_amt == 0 ? (totalWadeg + wincome).ToString() : totalWadeg.ToString() : wage_amt == 0 ? (decimal.Parse(String.Format("{0:0.00}", totalWadeg))).ToString() : (decimal.Parse(String.Format("{0:0.00}", totalWadeg - wincome))).ToString();
      TextTotalWagesNLevy = stw == 0 ? wage_amt == 0 ? (T_levy + wcontribution) : (T_levy) : wage_amt == 0 ? (decimal.Parse(String.Format("{0:0.00}", T_levy))) : (decimal.Parse(String.Format("{0:0.00}", (T_levy - wcontribution))));
      TextLevyPenalty = stw == 0 ? wage_amt == 0 ? Latemonths >= 2 ? TextTotalWagesNLevy * ((Latemonths - 1) * 5) / 100 : decimal.Parse("0.00") : TextLevyPenalty : wage_amt == 0 ? TextLevyPenalty : Latemonths >= 2 ? TextTotalWagesNLevy * ((Latemonths - 1) * 5) / 100 : decimal.Parse("0.00");
      var TextTotalAccountantGeneral = (TextLevyPenalty + TextTotalWagesNLevy);
      //if (H_Id > 0 && isEdit)
      //{
      //  ButtonSave.Visibility = Visibility.Visible;
      //  ButtonFinalize.Visibility = Visibility.Hidden;
      //}
      var obj = new ContributionOnChange
      {
        //TotalWadeges = TotalWadeges,
        //LEVYEE = LEVYEE,
        TextTotalWages = TextTotalWages,
        TextTotalWagesNLevy = TextTotalWagesNLevy,
        TextLevyPenalty = TextLevyPenalty,
        TextTotalAccountantGeneral = TextTotalAccountantGeneral,
        gridAmount = stw == 0 ? wincome : decimal.Parse(String.Format("{0:0.00}", 0.00))
      };
      return obj;
    }


    public async Task<string> Save_button_Click(int monthIndex, int Year, int H_Id, int SSNofEmp, string UserName, int UserID, List<C3ContributionVm> list, string TextLevyPenalty, int SEC3ID = 0)
    {




      string value = Year.ToString();

      //string Mvalue = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(monthIndex + 1);//old
      string Mvalue = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(monthIndex);//changes

      if (H_Id == 0)
      {

        string valuesave = value;
        SqlConnection staticConnectionsave = C3WizardLayerConn_BaseData.StaticSqlConnection;
        SqlCommand cmdsave = new SqlCommand("Check_SelfEmployed_C3Created", staticConnectionsave);
        cmdsave.CommandType = CommandType.StoredProcedure;
        cmdsave.Parameters.Add(new SqlParameter("@Month", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)monthIndex ?? (object)DBNull.Value));
        cmdsave.Parameters.Add(new SqlParameter("@Year", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)valuesave ?? (object)DBNull.Value));
        cmdsave.Parameters.Add(new SqlParameter("@SSN", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)SSNofEmp ?? (object)DBNull.Value));
        cmdsave.Parameters.Add(new SqlParameter("@SEC3ID", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)SEC3ID ?? (object)DBNull.Value));
        SqlDataAdapter sqlAdaptersave = new SqlDataAdapter(cmdsave);
        DataTable dtsave = new DataTable();
        sqlAdaptersave.Fill(dtsave);
        if (dtsave.Rows.Count > 0)
        {
          DataRow row = dtsave.Rows[0];
          bool isSubmitted = row["Is_submitted"] != DBNull.Value && Convert.ToBoolean(row["Is_submitted"]);
          if (isSubmitted)
          {
            return "C3 has already been submitted for this month," + dtsave?.Rows[0]?.ItemArray[0]?.ToString();
          }
          else
          {
            return "openPopUp," + dtsave?.Rows[0]?.ItemArray[0]?.ToString();
          }
          //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
          //C3WizardMessageBox.Show("C3 Wizard", "Self emoloyed C3 already created for " + Mvalue + " " + value);
          // return "Self emoloyed C3 already created for" + Mvalue + " " + value+","+ dtsave?.Rows[0]?.ItemArray[0]?.ToString();


        }
      }

      //Mouse.OverrideCursor = System.Windows.Input.Cursors.Wait;
      C3Contributions blemp = new C3Contributions();
      for (int i = 0; i < list.Count; i++)
      {

        blemp.SSN = list[i].SSN.ToString();
        blemp.EmployeeName = list[i].EmployeeName.ToString();
        blemp.C3HEADERID = list[i].C3HEADERID;
        blemp.WEEK1 = (bool)list[i].WEEK1;
        blemp.WEEK2 = (bool)list[i].WEEK2;
        blemp.WEEK3 = (bool)list[i].WEEK3;
        blemp.WEEK4 = (bool)list[i].WEEK4;
        blemp.WEEK5 = (bool)list[i].WEEK5;
        blemp.SelectedTypeWEEK1 = (int)list[i].SelectedTypeWEEK1;
        blemp.SelectedTypeWEEK2 = (int)list[i].SelectedTypeWEEK2;
        blemp.SelectedTypeWEEK3 = (int)list[i].SelectedTypeWEEK3;
        blemp.SelectedTypeWEEK4 = (int)list[i].SelectedTypeWEEK4;
        blemp.SelectedTypeWEEK5 = (int)list[i].SelectedTypeWEEK5;
        blemp.WAGES1 = (decimal)list[i].WAGES1;
        blemp.WAGES2 = (decimal)list[i].WAGES2;
        blemp.WAGES3 = (decimal)list[i].WAGES3;
        blemp.WAGES4 = (decimal)list[i].WAGES4;
        blemp.WAGES5 = (decimal)list[i].WAGES5;
        blemp.tempWAGES1 = (decimal)list[i].WAGES1;
        blemp.tempWAGES2 = (decimal)list[i].WAGES2;
        blemp.tempWAGES3 = (decimal)list[i].WAGES3;
        blemp.tempWAGES4 = (decimal)list[i].WAGES4;
        blemp.tempWAGES5 = (decimal)list[i].WAGES5;
        blemp.IsWeekfifth = list[i].IsWeekfifth;
        blemp.PayFreq = list[i].PayFreq.ToString();
        blemp.ISSelectedWEEK1 = blemp.WEEK1 == true ? "\u221A" : "X";
        blemp.ISSelectedWEEK2 = blemp.WEEK2 == true ? "\u221A" : "X";
        blemp.ISSelectedWEEK3 = blemp.WEEK3 == true ? "\u221A" : "X";
        blemp.ISSelectedWEEK4 = blemp.WEEK4 == true ? "\u221A" : "X";
        blemp.ISSelectedWEEK5 = blemp.WEEK5 == true ? "\u221A" : "X";
        blemp.TotalWadeges = blemp.WAGES1 + blemp.WAGES2 + blemp.WAGES3 + blemp.WAGES4 + blemp.WAGES5;
        blemp.LEVYEE = (decimal)list[i].LEVYEE;
        blemp.Remarks = list[i].Remarks?.ToString();
        blemp.BirthDate = list[i].BirthDate;

      }
      C3Header obj = new C3Header();
      SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
      if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
      SqlCommand cmd = H_Id > 0 ? new SqlCommand("PROCESS_Self_EmployedC3_Update", staticConnection) : new SqlCommand("PROCESS_Self_EmployedC3_Insert_One", staticConnection);
      cmd.CommandType = CommandType.StoredProcedure;
      if (H_Id > 0)
      {
        cmd.Parameters.Add(new SqlParameter("@SEC3ID", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)H_Id ?? (object)DBNull.Value));
      }
      cmd.Parameters.Add(new SqlParameter("@SSN", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(string)blemp.SSN ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@PERIODD_MONTH", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)monthIndex ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@PERIOD_YEAR", SqlDbType.VarChar, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)value ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@TOTAL_WAGES", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.TotalWadeges ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@TOTAL_CONTRIBUTIONS", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.LEVYEE ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@TOTAL_Fine", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(decimal.Parse(TextLevyPenalty)) ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Category_Type", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.PayFreq ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@WAGES1", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.WAGES1 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@WAGES2", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.WAGES2 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@WAGES3", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.WAGES3 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@WAGES4", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.WAGES4 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@WAGES5", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.WAGES5 ?? (object)DBNull.Value));

      cmd.Parameters.Add(new SqlParameter("@SelectedTypeWEEK1", SqlDbType.Int, 10, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.SelectedTypeWEEK1 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@SelectedTypeWEEK2", SqlDbType.Int, 10, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.SelectedTypeWEEK2 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@SelectedTypeWEEK3", SqlDbType.Int, 10, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.SelectedTypeWEEK3 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@SelectedTypeWEEK4", SqlDbType.Int, 10, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.SelectedTypeWEEK4 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@SelectedTypeWEEK5", SqlDbType.Int, 10, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.SelectedTypeWEEK5 ?? (object)DBNull.Value));

      cmd.Parameters.Add(new SqlParameter("@WEEK1", SqlDbType.Bit, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.WEEK1 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@WEEK2", SqlDbType.Bit, 9, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.WEEK2 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@WEEK3", SqlDbType.Bit, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.WEEK3 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@WEEK4", SqlDbType.Bit, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.WEEK4 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@WEEK5", SqlDbType.Bit, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.WEEK5 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Remarks", SqlDbType.VarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)blemp.Remarks ?? (object)DBNull.Value));

      cmd.Parameters.Add(new SqlParameter("@Insert_Datetimeinfo", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Schedule_NO", SqlDbType.Int, 10, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)0 ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Is_Fianalize", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)false ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Is_submitted", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)false ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Inserted_By", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(int)UserID ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Modified_By", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(int)UserID ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Print_By", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(int)UserID ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Export_By", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(int)UserID ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Modified_On", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Export_On", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@Modified_Machineinfo", SqlDbType.NVarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(string)Helper.MachineInfo ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@UserName", SqlDbType.NVarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(string)UserName ?? (object)DBNull.Value));
      cmd.Parameters.Add(new SqlParameter("@IsImportFromBEMA", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)false ?? (object)DBNull.Value));
      SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
      DataTable dt = new DataTable();
      sqlAdapter.Fill(dt);

      if (dt.Rows.Count > 0)
      {
        H_Id = int.Parse(dt.Rows[0].ItemArray[0].ToString());

        //CmbMonth.IsEnabled = false;
        //CmbYear.IsEnabled = false;
        //AddC3RecordWages.IsEnabled = false;
        //ButtonSave.Visibility = Visibility.Hidden;
        //ButtonFinalize.Visibility = Visibility.Visible;
        // ButtonEdit.IsEnabled = true;
        //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
        var msg = Finalize_C3(H_Id);
        //C3WizardMessageBox.Show("C3 Wizard", "Saved successfully");
        //Application.Current.Properties["TextChanged"] = 0;
        return msg + "," + H_Id;
      }
      return "false";
    }


