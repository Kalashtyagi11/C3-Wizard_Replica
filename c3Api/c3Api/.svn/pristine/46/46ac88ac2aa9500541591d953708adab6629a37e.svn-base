            LastName = string.Empty;
            BirthDate = null;
            rbmale = false;
            Address1 = string.Empty;
            Address2 = string.Empty;
            City = string.Empty;
            State = string.Empty;
            Country = string.Empty;
            Zip = string.Empty;
            Phone = string.Empty;
            Mobile = string.Empty;
            Email = string.Empty;
            wadeg = null;
            LastPayDate = null;
            Terminated = null;
            commencementDate = null;
            PayPeriod = string.Empty;
            MaritalStat = string.Empty;
