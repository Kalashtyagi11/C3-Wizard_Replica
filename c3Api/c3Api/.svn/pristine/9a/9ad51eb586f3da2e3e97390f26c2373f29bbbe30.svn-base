                                    if (C3Header_model.Count == count)
                                    {
                                        ResponseModel.Message = "Data for this month and year already exists.";
                                        ResponseModel.Status = false;
                                        ResponseModel.Statuscode = 400;
                                        return StatusCode(400, ResponseModel);
