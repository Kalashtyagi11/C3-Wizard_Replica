        [HttpGet("TextChangeSsnSelfRegister")]
        [AllowAnonymous]
        public async Task<IActionResult> TextChangeSsnSelfRegister(string ssN, string email)
        {
            ResponseModel response = new ResponseModel();
            try
            {
                bool twiceTest = false;
                var data = _DbContext.MasterCompanies.Where(x => x.RegNumber == ssN).FirstOrDefault();
                if (data != null)
                {
                    response.Status = false;
                    response.Statuscode = 409;
                    response.Message = "This Self Employed Already Registered!";
                    return Conflict(response);
                }
                if (string.IsNullOrEmpty(ssN))
                {
                    response.Status = false;
                    response.Statuscode = 409;
                    return Conflict("Please enter Social Security Number.");
                }
                else if (ssN.Trim().Length != 6)
                {
                    response.Status = false;
                    response.Statuscode = 409;
                    return Conflict("Social Security Number should be 6 digits.");

                }
                else
                {
                    int ssn = int.Parse(ssN);
                    DataSet dataSet = new DataSet();

                    SqlConnection con = C3WizardLayerConn_BaseData.StaticSqlConnection;
                    con.Open();
                    SqlCommand cmd = new SqlCommand("SELECT * FROM SelfEmployee WHERE Isactive=1 And Soc_Sec_Num=" + ssn, con);
                    cmd.CommandType = CommandType.Text;
                    SqlDataAdapter adapter = new SqlDataAdapter();
                    adapter.SelectCommand = cmd;
                    adapter.Fill(dataSet);
                    con.Close();
                    if (dataSet.Tables[0].Rows.Count > 0)
                    {
                        //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                        //C3WizardMessageBox.Show("C3 Wizard", "This Self Employed Already Registered");
                        response.Status = false;
                        response.Message =  "This Self Employed Already Registered";
                        //response.Message = email != dataSet.Tables[0].Rows[0]["Email"].ToString() ? "Email ID and Social Security Number do not match." : "This Self Employed Already Registered";
                        //return Conflict(response);
                        twiceTest = true;
                    }
                    if (ConnectionInfom.HasConnection() && ConnectionInfom.APIConnection(_configuration))
                    {

                        var chkBima = await repoRegister.GetSelfEmployedDetails(ssN);

                        if (chkBima.email != email)
                        {
                            response.Status = false;
                            response.Statuscode = 400;

                            response.Message = "User email InValid";
                            return Conflict(response);
                        }
                        if (string.IsNullOrEmpty(chkBima.ValidationMsg))
                        {
                            response.Status = true;
                            response.Statuscode = 200;
                            response.Data = chkBima;
                            response.Message = "success";
                            return Ok(response);
                        }

                        response.Status = false;
                        response.Statuscode = 400;
                        //response.Message = chkBima.ValidationMsg;
                        response.Message = "Please enter valid social security number";
                        return Conflict(response);

                        //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                    }
                    //return Conflict("SSb Connection not Running");
                    response.Status = true;
                    response.Statuscode = 200;
                    return Ok("SSb Connection not Running");

                }


            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500);
            }

        }




