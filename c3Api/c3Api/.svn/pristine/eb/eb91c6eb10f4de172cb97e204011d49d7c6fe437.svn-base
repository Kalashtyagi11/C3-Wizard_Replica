                                    parentloginuserpassword = Convert.ToString(dataSetPCopany.Tables[0].Rows[0]["Password"]);
                                }
                            }
                        }
                        DataRow row = dataSet.Tables[0].Rows[0];
                        int roleId = Convert.ToInt32(row["RoleId"]);

                        bool isApiConnect = ConnectionInfom.APIConnection(_configuration);

