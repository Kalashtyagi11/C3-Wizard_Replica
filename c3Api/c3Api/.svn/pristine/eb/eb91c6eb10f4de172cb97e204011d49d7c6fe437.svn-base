                                //secuser.MenuDetails = Menu;
                                secuser.RoleId = Convert.ToInt32(dataSet.Tables[0].Rows[0]["RoleId"]);
                                secuser.RoleName = Convert.ToString(dataSet.Tables[0].Rows[0]["Role"]);
                                secuser.REG_NUMBER = Convert.ToString(dataSet.Tables[0].Rows[0]["REG_NUMBER1"]);
                                secuser.LoginUserID = Convert.ToInt32(dataSet.Tables[0].Rows[0]["UserId"]);
                                secuser.profileImage = $"{Request.Scheme}://{Request.Host}/UserImage/{(dataSet.Tables[0].Rows[0]["UserImage"].ToString())}";
                                secuser.companyLogo = $"{Request.Scheme}://{Request.Host}/CompanyLogo/{(dataSet.Tables[0].Rows[0]["CompanyLogo"].ToString())}";
                                secuser.User_Name = Convert.ToString(dataSet.Tables[0].Rows[0]["FirstName"]);
                                secuser.LoginUserEmail = Convert.ToString(dataSet.Tables[0].Rows[0]["EmailId"]);
                                string UserEmail = Convert.ToString(dataSet.Tables[0].Rows[0]["EmailId"]);
                                secuser.LoginUserName = Convert.ToString(dataSet.Tables[0].Rows[0]["FirstName"]) + " " + Convert.ToString(dataSet.Tables[0].Rows[0]["LastName"]);
                                bool IsSelf_emp = dataSet.Tables[0].Rows[0]["IsSelfEmployee"] != null || dataSet.Tables[0].Rows[0]["IsSelfEmployee"] != "" ? Convert.ToBoolean(dataSet.Tables[0].Rows[0]["IsSelfEmployee"]) : false;
                                secuser.IsSelfEmployed = IsSelf_emp;
                                secuser.CompanyId = IsSelf_emp ? Convert.ToInt32(dataSet.Tables[0].Rows[0]["SelfEmpID"]) : Convert.ToInt32(dataSet.Tables[0].Rows[0]["EmpId"]);
                                secuser.ParentId = IsSelf_emp ? Convert.ToInt32(dataSet.Tables[0].Rows[0]["SelfEmpID"]) : Convert.ToInt32(dataSet.Tables[0].Rows[0]["EmpId"]);
                                string? LoginId = Convert.ToString(dataSet.Tables[0].Rows[0]["LoginId"]);
                                var token = _tokenHelper.GenerateToken(userId.ToString(), roleName.ToString(), UserEmail.ToString(), secuser.REG_NUMBER);
                                secuser.DeviceToken = token;
                                response.Data = secuser;
                                Login_Log(secuser.UserId, secuser.CompanyId, secuser.IsSelfEmployed, LoginId);
                                secuser.LogId = _DbContext.LoginLogs.Where(e => e.UserId == secuser.UserId).OrderByDescending(e => e.LogId).Select(e => e.LogId).FirstOrDefault();
                                if (!IsSelf_emp)
                                {
                                    response.Message = "Login success.";
                                    response.Status = true;
                                    response.Statuscode = 200;
                                    return Ok(response);
                                }
                                else
                                {
                                    response.Message = "Login success.";
                                    response.Status = true;
                                    response.Statuscode = 200;
                                    return Ok(response);

                                }
                            }
                        }
                        else
                        {
                            response.Message = "Check your internet connection OR May server not responding.\nplease try after sometime or contact S.S.B for any assistance.";
                            return BadRequest(response);
                        }
                    }
                    else
                    {
                        return BadRequest(response);
                    }
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new { success = false, message = ex.Message });
            }
            return BadRequest(response);
        }
        private void Login_Log(int? UserID, int? CompanyId, bool? IsSelfEmployed, string? LoginId)
        {
            try
            {
                //if (IsRememberMe.IsChecked == true)
                //{
                //    Properties.Settings.Default.UserName = Helper.LoginId;
                //    Properties.Settings.Default.Save();
                //}
                //else
                //{
                //    Properties.Settings.Default.UserName = "";
                //    Properties.Settings.Default.Save();
                //}
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                SqlCommand commd = new SqlCommand("Insert_LoginLog", staticConnection);
                commd.CommandType = CommandType.StoredProcedure;
                commd.Parameters.Add(new SqlParameter("@UserId", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)UserID ?? (object)DBNull.Value));
                commd.Parameters.Add(new SqlParameter("@LoginId", SqlDbType.VarChar, 2000, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)LoginId ?? (object)DBNull.Value));
                commd.Parameters.Add(new SqlParameter("@LoginTime", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)System.DateTime.Now ?? (object)DBNull.Value));
                commd.Parameters.Add(new SqlParameter("@CreatedMachineIp", SqlDbType.VarChar, 400, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)Helper.MachineInfo ?? (object)DBNull.Value));
                commd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 18, ParameterDirection.Input, false, 18, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                commd.Parameters.Add(new SqlParameter("@IsSelfEmployed", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)IsSelfEmployed ?? (object)DBNull.Value));
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(commd);
                DataTable dt = new DataTable();
                sqlAdapter.Fill(dt);
                staticConnection.Close();
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
            }
        }
