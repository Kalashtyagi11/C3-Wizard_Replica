            return responseModel;
        }

        private async Task<bool> VerifyEmployerDetails(string regno)
        {
            try
            {

                String surl = _configuration["ServiceConfig:ServiceUriString"];
                string sURL = surl + "/Employer/getERMasterDetails/" + regno;
                HttpMessageHandler handler = new HttpClientHandler()
                {
                };

                var httpClient = new HttpClient(handler)
                {
                    BaseAddress = new Uri(sURL),
                    Timeout = new TimeSpan(0, 2, 0)
                };
                httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");

                var plainTextBytes = System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]);
                string val = System.Convert.ToBase64String(plainTextBytes);
                httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + val);
                HttpResponseMessage response = httpClient.GetAsync(sURL).Result;
                if (response.StatusCode == HttpStatusCode.OK)
                {
                    var customerJsonString = await response.Content.ReadAsStringAsync();
                    var Emp_model = JsonConvert.DeserializeObject<GetEmployerDeailsModule>(customerJsonString);

                    if (Emp_model == null)
                    {
                        return false;
                    }
                    else
                    {
                        if (Emp_model.c3RegnStatusCode == "D")
                        {
                            return true;
                        }
                    }

                }

                return false;
            }
            catch (Exception ex)
            {
                //Login login = new Login();
                //login.Error_Log(ex.Message);
                //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                //return false;
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                throw ex;

            }
        }
        /// <summary>
        /// This method retrieves all employers.
        /// </summary>
        /// <returns>A list of employer .</returns>
        [HttpGet("GetAllEmployers")]
        public async Task<IActionResult> GetAllEmployers(int CompanyId, int roleid)
        {

            try
            {
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                List<BLMasterCompany> employeerlist = new List<BLMasterCompany>();

                BLMasterEmployee blemp = new BLMasterEmployee();
                var allUsers = BLSECUsers.SECUsersCollection().ToList();
                employeerlist = BLMasterCompany.MasterCompanyCollection().ToList();
                var employeerlistm = (roleid == 1 || roleid == 2) ? employeerlist : employeerlist.Where(x => x.CompanyId == CompanyId || x.Parent_Id == CompanyId);
                //var employeerlistm=employeerlist.Where(e=>e.CompanyId==CompanyId).ToList();
                foreach (var item in employeerlistm)
                {
                    
                    item.UserCount = allUsers.Where(e => (e.EmpId != "0" || e.SelfEmpID != "0") && (e.EmpId == item.CompanyId.ToString() || e.SelfEmpID == item.CompanyId.ToString())).Count();
                }
                staticConnection.Close();
                if (employeerlistm != null)
                {
                    response.Message = "Data retrieved successfully!";
                    response.Statuscode = 200;
                    response.Status = true;
                    response.Data = employeerlistm;
                }

                return Ok(response);
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                response.Message = $"An error occurred: {ex.Message}";
                response.Statuscode = 500;
                response.Status = false;
                return BadRequest(response);
            }
        }


