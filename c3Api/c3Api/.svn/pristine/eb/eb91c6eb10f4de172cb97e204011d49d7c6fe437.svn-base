                        data1.LastName = employeerVm.LastName;
                        _DbContext.SaveChanges();
                    }


                    var data = _DbContext.SecurityQuestionAnswers.Where(x => x.CompanyId == employeerVm.CompanyId && x.UserId == employeerVm.userId).FirstOrDefault();
                    if (data != null)
                    {
                        data.Question1 = employeerVm.Question1;
                        data.Question2 = employeerVm.Question2;
                        data.Answer1 = employeerVm.Answer1;
                        data.Answer2 = employeerVm.Answer2;
                        _DbContext.SaveChanges();
                    }

                    string regNumber = employeerVm.RegNumber;

                    // Initialize DataSet
                    DataSet dataSet = new DataSet();

                    // Open connection
                    SqlConnection con = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString);
                    con.Open();

                    // Use parameterized query to avoid SQL injection and type mismatches
                    SqlCommand cmdcompany = new SqlCommand("SELECT * FROM MasterCompany WHERE Isactive = 1 AND REG_NUMBER = @RegNumber AND Company_Id != @CompanyId", con);
                    cmdcompany.CommandType = CommandType.Text;

                    // Add parameters to the query
                    cmdcompany.Parameters.AddWithValue("@RegNumber", regNumber);  // Add RegNumber as string
                    cmdcompany.Parameters.AddWithValue("@CompanyId", employeerVm.CompanyId);  // Add CompanyId

                    // Execute the query and fill the DataSet
                    SqlDataAdapter adapter = new SqlDataAdapter();
                    adapter.SelectCommand = cmdcompany;
                    adapter.Fill(dataSet);
                    con.Close();
                    // Check if any records are found
                    if (dataSet.Tables[0].Rows.Count > 0)
                    {
                        response.Message = "Employer already registered";
                        response.Status = true;
                        response.Statuscode = 403;
                    }
                }
                catch (Exception ex)
                {
                    var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                    LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                    // Handle the exception
                    response.Message = ex.Message;
                    response.Status = false;
                    response.Statuscode = 500;
                }


                try
                {
                    //blemployer.CompanyId = empid;
                    blemployer.CompanyId = employeerVm.CompanyId;
                    //blemployer.UpdatedBy = Helper.UserID;
                    blemployer.UpdatedBy = employeerVm.userId;
                    blemployer.UpdatedOn = DateTime.Now;
                    //blemployer.UpdatedMachineInfo = Helper.MachineInfo;

                    if (ConnectionInfom.HasConnection() && _configuration["IsBEMARegistrationEnabled"] == "1" && ConnectionInfom.APIConnection(_configuration))
                    {
                        bool iscompanyregistered = false;
                        if (companyparentid > 0)
                        {
                            iscompanyregistered = await VerifyEmployerDetails(employeerVm.RegNumber.ToString());
                        }
                        if (iscompanyregistered)
                        {

                            ResponseModel res = await Reg_save_at_saever(0, employeerVm);
                            if ((bool)res.Status)
                            {
                                blemployer.IsVerified = false;
                                blemployer.Tokan = "";
                                blemployer.Update();
                                var empid = (int)blemployer.CompanyId;

                            }
                            else
                            {
                                return (IActionResult)res;

                            }
                        }
                        else
                        {
                            int? companyid = employeerVm.CompanyId;
                            ResponseModel res = await Reg_save_at_saever(companyid, employeerVm);//employeerVm.CompanyId
                            if ((bool)res.Status)
                            {
                                blemployer.Update();
                                return Ok(res);

                            }
                            else
                            {
                                return BadRequest(res);

                            }
                        }

                    }
                    else
                    {

                        string uploadsFolderlogo = Path.Combine(_environment.WebRootPath, "CompanyLogo");

                        if (!string.IsNullOrEmpty(employeerVm.CompanyLogo) && employeerVm.CompanyLogo != "string")
                        {
                            var imagNamelogo = employeerVm.RegNumber + "_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ".png";
                            SaveBase64Image(employeerVm.CompanyLogo, uploadsFolderlogo, imagNamelogo);
                            blemployer.CompanyLogo = imagNamelogo;
                        }
                        else
                        {
                            //blemployer.CompanyLogo = null; 
                            var blempList_ALLnew = BLMasterCompany.MasterCompanyCollection().ToList();
                            var selectedCompanynew = blempList_ALLnew.FirstOrDefault(t => t.CompanyId == employeerVm.CompanyId);
                            blemployer.CompanyLogo = selectedCompanynew.CompanyLogo ?? null;
                        }

                        //--------------A
                        //var selfuser = await _DbContext.Secusers.FirstOrDefaultAsync(x => x.UserId == employeerVm.userId);
                        //var selfuser1 = await _DbContext.MasterCompanies.FirstOrDefaultAsync(x => x.CompanyId == employeerVm.CompanyId);
                        //if (selfuser != null && selfuser1 != null)
                        //{
                        //    if (selfuser.EmailId != employeerVm.Email && selfuser1.Email != employeerVm.Email)
                        //    {
                        //        var emaildata = _DbContext.Secusers.Where(x => x.EmailId == employeerVm.Email).FirstOrDefault();
                        //        var emaildata1 = _DbContext.MasterCompanies.Where(x => x.Email == employeerVm.Email).FirstOrDefault();
                        //        if (emaildata != null && emaildata1 != null)
                        //        {
                        //            return Conflict(new
                        //            {
                        //                message = "User email already exists"
                        //            });

                        //        }
                        //        blemployer.Update();
                        //    }
                        //    blemployer.Update();
                        //}
                        //else
                        //{
                        //    return Conflict(new
                        //    {
                        //        message = "User data not exists"
                        //    });

                        //}


                        blemployer.Update();

                        var blempList_ALL = BLMasterCompany.MasterCompanyCollection().ToList();
                        var selectedCompany = blempList_ALL.FirstOrDefault(t => t.CompanyId == employeerVm.CompanyId);
                        blemployer.CompanyLogo = $"{Request.Scheme}://{Request.Host}/CompanyLogo/{selectedCompany.CompanyLogo}";

                        BLUserSecurityQuestionAnswer secqa = new BLUserSecurityQuestionAnswer();
                        secqa.UserId = employeerVm?.userId ?? 0;
                        secqa.CompanyId = employeerVm?.CompanyId ?? 0;
                        secqa.UserName = employeerVm.LoginId;
                        secqa.RegistrationNo = Convert.ToInt32(employeerVm.RegNumber);
                        secqa.CompanyName = employeerVm.CompanyName;
                        secqa.Question1 = employeerVm.Question1;
                        secqa.Question2 = employeerVm.Question2;
                        secqa.Answer1 = employeerVm.Answer1;
                        secqa.Answer2 = employeerVm.Answer2;
                        //secqa.InsertedBy = 1;
                        //secqa.InsertedOn = DateTime.Now;
                        secqa.UpdatedBy = employeerVm?.userId ?? 0; ;
                        secqa.UpdatedOn = DateTime.Now;
                        secqa.IsActive = true;
                        secqa.Update();




                        response.Message = "Employer Updated Successfully";
                        response.Status = true;
                        response.Statuscode = 200;
                        response.Data = blemployer;

                    }

                }
                catch (Exception ex)
                {
                    var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                    LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                    response.Message = $"An error occurred: {ex.Message}";
                    response.Statuscode = 500;
                    response.Status = false;
                    return BadRequest(response);

                }

            }
            return Ok(response);

        }
        private bool SaveBase64Image(string base64String, string folderPath, string fileName)
        {
            // Ensure the folder exists
            try
            {
                if (!Directory.Exists(folderPath))
                {
                    Directory.CreateDirectory(folderPath);
                }

                var base64Data = base64String.Split(',')[1];

                base64Data = base64Data.Replace("\n", "").Replace("\r", "").Trim();

                int padding = base64Data.Length % 4;
                if (padding > 0)
                {
                    base64Data = base64Data.PadRight(base64Data.Length + (4 - padding), '=');
                }

                // Convert the Base64 string to a byte array
                byte[] imageBytes = Convert.FromBase64String(base64Data);

                // Define the full file path (including the folder and file name)
                string filePath = Path.Combine(folderPath, fileName);

                // Write the byte array to the file
                System.IO.File.WriteAllBytes(filePath, imageBytes);
                return true;
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return false;
            }


        }
