                            string SSBMail = _configuration["SSBMail"];
                            string toMail = isTest == "1" ? testMail : SSBMail;

                            string htmlContent = await engine.CompileRenderAsync("Welcome.cshtml", registerCompanyVm);
                            var mailMessage = new MailMessage
                            {
                                From = new MailAddress(_configuration["EmailSettings:SenderEmail"]),
                                Subject = "New C3 Wizard Portal Registration Request " + registerCompanyVm.RegNumber + " " + registerCompanyVm.CompanyName,
                                Body = htmlContent,
                                IsBodyHtml = true
                            };
                            mailMessage.To.Add(toMail);
                            //mailMessage.Bcc.Add(toMail);

                            //await smtpClient.SendMailAsync(mailMessage);
                        }
                        catch (Exception ex)
                        {
                            var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                            LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                            return StatusCode(405, ex.Message);
                        }



                    }
                    else
                    {

                        return StatusCode(401, response);
                    }

                    #endregion
                    //}
                    //else
                    //{
                    //  return Conflict(new
                    //  {
                    //    message = "Email already exists"
                    //  });
                    //}

                }
                else
                {
                    response.Data = res;
                    response.Status = false;
                    response.Message = "User Already Exist";
                    return BadRequest(response);
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                throw;
            }
            return response.Status ?? false ? Ok(response) : NotFound(response);
        }



        private async Task<string> sendMailVerificationLocally(string regno, string email, string Name)
        {
            try
            {
                var obj = new
                {
                    ActivationLink = "",
                    ActivationCode = Guid.NewGuid().ToString("N").Substring(0, 8),
                    Name = Name
                };
                var data = await _DbContext.Secusers?.FirstOrDefaultAsync(e => e.REG_NUMBER == regno);
                if (data == null)
                {
                    return "";
                }
                data.userstts = null;
                data.token = obj.ActivationCode;
                await _DbContext.SaveChangesAsync();

                string isTest = _configuration["IsTestMail"];
                string testMail = _configuration["TestMail"];

                string toMail = isTest == "1" ? testMail : email;

                var projectPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot/Email");
                var engine = new RazorLight.RazorLightEngineBuilder()
                .UseFileSystemProject(projectPath)
                .UseMemoryCachingProvider()
                .Build();
                string htmlContent = await engine.CompileRenderAsync("verifictionTemplate.cshtml", obj);
                //byte[] pdfBytes = await GeneratePdfFromHtml(htmlContent);

                var mailMessage = new MailMessage
                {
                    From = new MailAddress(_configuration["EmailSettings:SenderEmail"]),
                    Subject = "Activate your C3 Remittances Account",
                    Body = htmlContent,
                    IsBodyHtml = true
                };
                mailMessage.To.Add(toMail);

                //using var memoryStream = new MemoryStream(pdfBytes);
                //mailMessage.Attachments.Add(new Attachment(memoryStream, "PaymentReceipt.pdf", "application/pdf"));
                //mailMessage.Bcc.Add(toMail);
                using var smtpClient = new SmtpClient(_configuration["EmailSettings:SmtpServer"])
                {
                    Port = int.Parse(_configuration["EmailSettings:Port"]),
                    Credentials = new NetworkCredential(
                      _configuration["EmailSettings:SenderEmail"],
                      _configuration["EmailSettings:SenderPassword"]
                  ),
                    EnableSsl = true
                };

                await smtpClient.SendMailAsync(mailMessage);
                return "1";
            }
            catch (Exception ex)
            {

                return ex.ToString();
            }
        }

        private async Task<string> ssbEmailChk(string regNo)
        {
            string serviceUri = _configuration["ServiceConfig:ServiceUriString"];
            string apiUrl = $"{serviceUri}/Employer/getERMasterDetails/{regNo}";

            using (HttpClient httpClient = new HttpClient())
            {
                httpClient.BaseAddress = new Uri(apiUrl);
                httpClient.Timeout = TimeSpan.FromMinutes(2);
                httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");

                string authUser = _configuration["ServiceConfig:AuthUser"];
                string authPass = _configuration["ServiceConfig:AuthPass"];
                string authToken = Convert.ToBase64String(Encoding.UTF8.GetBytes($"{authUser}:{authPass}"));

                httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + authToken);

                HttpResponseMessage response = await httpClient.GetAsync(apiUrl);
                if (response.StatusCode == HttpStatusCode.OK)
                {
                    string jsonResult = await response.Content.ReadAsStringAsync();
                    var employerDetails = JsonConvert.DeserializeObject<GetEmployerDeailsModule>(jsonResult);
                    return employerDetails.email;
                }
                return "false";
            }
        }

        [HttpPost("TextChangeUserEmail")]
        [AllowAnonymous]
        public async Task<IActionResult> TextChangeUserEmail(string EmailId, string regNo)
        {
            ResponseModel response = new ResponseModel();
            try
            {
                var msg = _DbContext.Secusers.Where(x => x.EmailId == EmailId).FirstOrDefault();
                if (msg != null)
                {
                    var TwicwValidate = await ssbEmailChk(regNo);

                    if (TwicwValidate == EmailId)
                    {
                        response.Status = false;
                        response.Statuscode = 400;
                        response.Message = "User email already exists";
                        return BadRequest(response);
                    }
                }
                response.Status = true;
                response.Statuscode = 200;
                response.Message = "Success";
                return Ok(response);
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500);
            }

        }
