        [HttpGet("varificatiion_code")]
        [AllowAnonymous]
        public async Task<IActionResult> varificatiion_code(string code, string UserName)
        {
            ResponseModel res = new ResponseModel();
            try
            {

                var UserDetauls = _DbContext.Secusers.Where(p => p.LoginId == UserName).FirstOrDefault();
                if (UserDetauls != null)
                {
                    if (C3WizardRepository.Repository.ConnectionInfom.HasConnection() && _configuration["IsBEMARegistrationEnabled"] == "1" && C3WizardRepository.Repository.ConnectionInfom.APIConnection(_configuration))
                    {
                        int SelfCompid = Convert.ToInt32(UserDetauls.SelfEmpId);
                        int compid = Convert.ToInt32(UserDetauls.EmpId);
                        int UserID = UserDetauls.UserId;
                        string ParentUser_Password = UserDetauls.Password;
                        //UserVM user = _C3.GetUserDetails(compid, UserID);
                        res = await repoRegister.varify_varificatiion_code(code.Trim(), UserName, ParentUser_Password);

                        if ((bool)res?.Status)
                        {
                            if (compid > 0)
                            {
                                repoRegister.updateemployer(code, compid);
                                if (res.Message == "Code       : EUS1094\r\nMessage    : Already Activated.\r\nResolution : Please use your credential to login and contact Social Security to if you need any assistance")
                                {
                                    res.Message = "Already Activated...";
                                }
                                else if (res.Message == "Code       : IUC1003\r\nMessage    : Successfully activated")
                                {
                                    res.Message = "Successfully activated...";
                                }
                                else
                                {
                                    //res.Message = "Do you want to import your list of employees based on your last C3 Submission from Social Security System?  ";
                                    res.Message = "Verified Successfully...";
                                }
                                res.Status = true;
                                return Ok(res);
                            }
                            if (SelfCompid > 0)
                            {
                                res.Message = "Successfully activated...";
                                res.Status = true;
                                return Ok(res);
                            }

                        }
                    }
                    else
                    {

                        if (_configuration["IsBEMARegistrationEnabled"] == "0" && UserDetauls.userstts == null)
                        {
                            if (code == UserDetauls.token)
                            {
                                UserDetauls.userstts = "A";
                                _DbContext.SaveChanges();
                                res.Message = "Successfully activated...";
                                res.Status = true;
                                return Ok(res);
                            }
                            else
                            {
                                res.Status = false;
                                res.Message = "inVailed code";
                                return BadRequest(res);
                            }


                        }

                        res.Status = false;
                        res.Message = "Check your internet connection OR May server not responding.\nplease try after sometime or contact S.S.B for any assistance";
                        return BadRequest(res);
                    }
                    return BadRequest(res);
                }
                else
                {
                    res.Status = false;
                    res.Message = "User Details Not Found .";
                    return BadRequest(res);
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                res.Status = false;
                res.Message = ex.Message;
                return BadRequest(res);
            }
        }


        [HttpGet("ImportVerifiedDatainSSB")]
        [AllowAnonymous]
        //public async Task<IActionResult> ImportVerifiedDatainSSB(string UserName, string Password, int compid, int SelfCompid, string SSN, int UserID ,bool questionRes,string regno)
        public async Task<IActionResult> ImportVerifiedDatainSSB(string UserName, string? SSN, string? regno)
        {
            ResponseModel res = new ResponseModel();
            try
            {

                bool questionRes = false;
                var UserDetauls = _DbContext.Secusers.Where(p => p.LoginId == UserName).FirstOrDefault();
                int SelfCompid = _DbContext.SECUsersProfiles?.FirstOrDefault(e =>e.ISSelfEmployee && e.REG_NUMBER == SSN)?.EmpId ?? 0;
                int compid = _DbContext.SECUsersProfiles?.FirstOrDefault(e => e.REG_NUMBER == SSN)?.EmpId??0;
                //int compid = Convert.ToInt32(UserDetauls.EmpId);
                int UserID = UserDetauls.UserId;
                int RoleId = UserDetauls.RoleId;
                string ParentUser_Password = UserDetauls.Password;
                string ParentUserLoginID = UserDetauls.LoginId;


                if (UserDetauls != null)
                {
                    if (compid > 0 && (RoleId == 3 || RoleId == 4))
                    {
                        if (questionRes)
                        {
                            string Emp_surl = _configuration["ServiceConfig:ServiceUriString"];
                            string Emp_sURL = Emp_surl + "/Employee/employees/" + regno.Trim();
                            HttpMessageHandler emphandler = new HttpClientHandler()
                            {
                            };

                            var emphttpClient = new HttpClient(emphandler)
                            {
                                BaseAddress = new Uri(Emp_sURL),
                                Timeout = new TimeSpan(0, 2, 0)
                            };
                            emphttpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                            //This is the key section you were missing    
                            var empplainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : System.Text.Encoding.UTF8.GetBytes(ParentUserLoginID + ":" + ParentUser_Password.Trim());
                            string empval = System.Convert.ToBase64String(empplainTextBytes);
                            emphttpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + empval);
                            HttpResponseMessage empresponse = emphttpClient.GetAsync(Emp_sURL).Result;
                            if (empresponse.StatusCode == HttpStatusCode.OK)
                            {
                                var customerJsonString = await empresponse.Content.ReadAsStringAsync();
                                var Emp_model = JsonConvert.DeserializeObject<List<Employeedetails>>(customerJsonString);
                                if (Emp_model != null)
                                {
                                    foreach (Employeedetails emp in Emp_model)
                                    {

                                        try
                                        {
                                            BLMasterEmployee blemployee = new BLMasterEmployee();
                                            blemployee.CompanyId = compid;
                                            blemployee.SocSecNum = emp.socSecNum.Trim();
                                            blemployee.TypeCode = "1";
                                            blemployee.FirstName = emp.firstName.Trim();
                                            // blemployee.MiddleName = emp.middleName.Trim();
                                            blemployee.LastName = emp.surName.Trim();
                                            blemployee.IsActive = true;
                                            blemployee.IsdirectorOnly = emp.isdirectorOnly != null ? emp.isdirectorOnly == "true" ? true : false : false;
                                            blemployee.IsemployeeDirector = emp.isemployeeDirector != null ? emp.isemployeeDirector == "true" ? true : false : false;
                                            blemployee.BirthDate = emp.birthDate != "" && emp.birthDate != null ? DateTime.ParseExact(emp.birthDate.ToString(), Helper.DateFormat, CultureInfo.InvariantCulture) : DateTime.Parse("01/01/1900");
                                            blemployee.Gender = emp.gender;
                                            blemployee.MaritalStat = emp.maritalStatus;
                                            blemployee.Address1 = emp.streetAddress;
                                            blemployee.Address2 = emp.streetName;
                                            blemployee.City = emp.cityTownName;
                                            blemployee.Country = string.IsNullOrEmpty(emp.countryCode) ? null : emp.countryCode.Contains("Saint Kitts") ? "1" : emp.countryCode.Contains("Nevis") ? "2" : emp.countryCode;
                                            blemployee.State = emp.stateRegion;

                                            blemployee.Mobile = emp.mobile;
                                            blemployee.Phone = emp.phone;
                                            blemployee.IsLevyExempt = false;

                                            blemployee.PayPeriod = (emp.payPeriod != null && emp.payPeriod != "") ? (emp.payPeriod.Trim() == "1" ? "W" : emp.payPeriod.Trim() == "2" ? "E2W" : emp.payPeriod.Trim() == "3" ? "M" : emp.payPeriod.Trim() == "4" ? "2M" : null) : "";
                                            //blemployee.CompanyId = int.Parse(mastercompany.CompanyId.ToString());
                                            blemployee.InsertedBy = compid;
                                            blemployee.InsertedOn = DateTime.Now;
                                            blemployee.InsertedMachineInfo = Helper.MachineInfo;
                                            blemployee.SaveNew();
                                            //decimal salary = emp.salary != "" && emp.salary != null ? decimal.Parse(emp.salary) : 0;
                                            decimal monthlysalary = Helper.Findsalary(emp);//emp.payPeriod.Trim() == "3" ? Helper.Findsalary(emp) : 0.00M;
                                            repoRegister.save_MasterEmployeeIncomes(blemployee, monthlysalary);

                                        }
                                        catch (Exception ex)
                                        {
                                            res.Status = false;
                                            res.Message = ex.Message;
                                            return BadRequest(res);
                                        }
                                    }

                                }
                            }
                        }
                        else
                        {
                            if (!questionRes)
                            {

                                string Emp_surl = _configuration["ServiceConfig:ServiceUriString"];
                                string Emp_sURL = Emp_surl + "/Employee/employeesByLastC3/" + regno.Trim();
                                HttpMessageHandler emphandler = new HttpClientHandler()
                                {
                                };

                                var emphttpClient = new HttpClient(emphandler)
                                {
                                    BaseAddress = new Uri(Emp_sURL),
                                    Timeout = new TimeSpan(0, 2, 0)
                                };
                                emphttpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                                //This is the key section you were missing    
                                var empplainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : System.Text.Encoding.UTF8.GetBytes(ParentUserLoginID.Trim() + ":" + ParentUser_Password);
                                string empval = System.Convert.ToBase64String(empplainTextBytes);
                                emphttpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + empval);
                                HttpResponseMessage empresponse = emphttpClient.GetAsync(Emp_sURL).Result;
                                if (empresponse.StatusCode == HttpStatusCode.OK)
                                {
                                    var customerJsonString = await empresponse.Content.ReadAsStringAsync();
                                    var Emp_model = JsonConvert.DeserializeObject<List<Employeedetails>>(customerJsonString);
                                    if (Emp_model != null)
                                    {


                                        foreach (Employeedetails emp in Emp_model)
                                        {

                                            bool alreadyExists = _C3.ssnisexist(emp.socSecNum.Trim(), compid);
                                            // bool alreadyexitsdata = emp.Any(emp => _C3.ssnisexist(emp.socSecNum.Trim(), CompanyId));
                                            if (alreadyExists)
                                            {
                                                return Conflict(new ResponseModel
                                                {
                                                    Status = false,
                                                    Message = "Employees already exists.",
                                                    Statuscode = 409
                                                });

                                            }
                                            try
                                            {
                                                BLMasterEmployee blemployee = new BLMasterEmployee();
                                                blemployee.CompanyId = compid;
                                                blemployee.SocSecNum = emp.socSecNum.Trim();
                                                blemployee.TypeCode = "1";
                                                blemployee.FirstName = emp.firstName.Trim();
                                                // blemployee.MiddleName = emp.middleName.Trim();
                                                blemployee.LastName = emp.surName.Trim();
                                                blemployee.IsActive = true;
                                                blemployee.IsdirectorOnly = false;
                                                blemployee.IsemployeeDirector = emp.isemployeeDirector != null ? emp.isemployeeDirector == "true" ? true : false : false;
                                                blemployee.BirthDate = emp.birthDate != "" && emp.birthDate != null ? DateTime.ParseExact(emp.birthDate.ToString(), Helper.DateFormat, CultureInfo.InvariantCulture) : DateTime.Parse("01/01/1900");
                                                blemployee.Gender = emp.gender;
                                                blemployee.MaritalStat = emp.maritalStatus;

                                                blemployee.Address1 = emp.streetAddress;
                                                blemployee.Address2 = emp.streetName;
                                                blemployee.City = emp.cityTownName;
                                                //blemployee.Country = emp.countryCode;
                                                blemployee.Country = string.IsNullOrEmpty(emp.countryCode) ? null : emp.countryCode.Contains("Saint Kitts") ? "1" : emp.countryCode.Contains("Nevis") ? "2" : emp.countryCode;

                                                blemployee.State = emp.stateRegion;
                                                // blemployee.occupation = emp.occupation;
                                                blemployee.Mobile = emp.mobile;
                                                blemployee.Phone = emp.phone;
                                                blemployee.IsLevyExempt = false;
                                                // blemployee.Terminated = emp.endDate != "" && emp.endDate != null ? (DateTime?)DateTime.ParseExact(emp.endDate.ToString(), Helper.DateFormat, CultureInfo.InvariantCulture) : null;
                                                // blemployee.AppintDate = emp.startDate != "" && emp.startDate != null ? (DateTime?)DateTime.ParseExact(emp.startDate.ToString(), Helper.DateFormat, CultureInfo.InvariantCulture) : null;
                                                blemployee.PayPeriod = (emp.payPeriod != null && emp.payPeriod != "") ? (emp.payPeriod.Trim() == "1" ? "W" : emp.payPeriod.Trim() == "2" ? "E2W" : emp.payPeriod.Trim() == "3" ? "M" : emp.payPeriod.Trim() == "4" ? "2M" : null) : "";
                                                //blemployee.CompanyId = int.Parse(mastercompany.CompanyId.ToString());
                                                blemployee.InsertedBy = compid;
                                                blemployee.InsertedOn = DateTime.Now;
                                                blemployee.InsertedMachineInfo = Helper.MachineInfo;
                                                blemployee.SaveNew();
                                                //decimal salary = emp.salary != "" && emp.salary != null ? decimal.Parse(emp.salary) : 0;
                                                decimal monthlysalary = Helper.Findsalary(emp);// emp.payPeriod.Trim() == "3" ? Helper.Findsalary(emp) : 0.00M;
                                                repoRegister.save_MasterEmployeeIncomes(blemployee, monthlysalary);

                                            }
                                            catch (Exception ex)
                                            {
                                                res.Status = false;
                                                res.Message = ex.Message;
                                                return BadRequest(res);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        string NWDEmp_surl = _configuration["ServiceConfig:ServiceUriString"];
                        string NWDEmp_sURL = NWDEmp_surl + "/Employee/nwdirectorsByLastC3/" + regno.Trim();
                        HttpMessageHandler nwdhandler = new HttpClientHandler()
                        {
                        };

                        var nwdhttpClient = new HttpClient(nwdhandler)
                        {
                            BaseAddress = new Uri(NWDEmp_sURL),
                            Timeout = new TimeSpan(0, 2, 0)
                        };
                        nwdhttpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                        //This is the key section you were missing    
                        var nwdplainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : System.Text.Encoding.UTF8.GetBytes(ParentUserLoginID + ":" + ParentUser_Password);
                        string nwdval = System.Convert.ToBase64String(nwdplainTextBytes);
                        nwdhttpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + nwdval);
                        HttpResponseMessage nwdresponse = nwdhttpClient.GetAsync(NWDEmp_sURL).Result;
                        if (nwdresponse.StatusCode == HttpStatusCode.OK)
                        {
                            var customerJsonString = await nwdresponse.Content.ReadAsStringAsync();
                            var NWDEmp_model = JsonConvert.DeserializeObject<List<Employeedetails>>(customerJsonString);
                            if (NWDEmp_model != null)
                            {
                                var dirExistNotInsert1 = _DbContext.MasterEmployees.Where(e => e.IsActive && e.IsdirectorOnly == true && e.CompanyId == compid).Select(d => d.SocSecNum).ToList();
                                foreach (Employeedetails emp in NWDEmp_model.Where(emp => !dirExistNotInsert1.Contains(emp.socSecNum)))
                                {
                                    try
                                    {
                                        BLMasterEmployee blemployee = new BLMasterEmployee();
                                        blemployee.CompanyId = compid;
                                        blemployee.SocSecNum = emp.socSecNum.Trim();
                                        blemployee.TypeCode = "1";
                                        blemployee.FirstName = emp.firstName.Trim();
                                        // blemployee.MiddleName = emp.middleName.Trim();
                                        blemployee.LastName = emp.surName.Trim();
                                        blemployee.IsActive = true;
                                        blemployee.IsdirectorOnly = true;
                                        blemployee.IsemployeeDirector = false;
                                        blemployee.BirthDate = emp.birthDate != "" && emp.birthDate != null ? DateTime.ParseExact(emp.birthDate.ToString(), Helper.DateFormat, CultureInfo.InvariantCulture) : DateTime.Parse("01/01/1900");
                                        blemployee.Gender = emp.gender;

                                        blemployee.MaritalStat = emp.maritalStatus;

                                        blemployee.Address1 = emp.streetAddress;
                                        blemployee.Address2 = emp.streetName;
                                        blemployee.City = emp.cityTownName;
                                        //blemployee.Country = emp.countryCode;
                                        blemployee.Country = string.IsNullOrEmpty(emp.countryCode) ? null : emp.countryCode.Contains("Saint Kitts") ? "1" : emp.countryCode.Contains("Nevis") ? "2" : emp.countryCode;

                                        blemployee.State = emp.stateRegion;
                                        // blemployee.occupation = emp.occupation;
                                        blemployee.Mobile = emp.mobile;
                                        blemployee.Phone = emp.phone;
                                        blemployee.IsLevyExempt = false;
                                        //blemployee.Terminated = emp.endDate != "" && emp.endDate != null ? (DateTime?)DateTime.ParseExact(emp.endDate.ToString(), Helper.DateFormat, CultureInfo.InvariantCulture) : null;
                                        //blemployee.AppintDate = emp.startDate != "" && emp.startDate != null ? (DateTime?)DateTime.ParseExact(emp.startDate.ToString(), Helper.DateFormat, CultureInfo.InvariantCulture) : null;
                                        blemployee.PayPeriod = (emp.payPeriod != null && emp.payPeriod != "") ? (emp.payPeriod.Trim() == "1" ? "W" : emp.payPeriod.Trim() == "2" ? "E2W" : emp.payPeriod.Trim() == "3" ? "M" : emp.payPeriod.Trim() == "4" ? "2M" : "M") : "M";
                                        //blemployee.CompanyId = int.Parse(mastercompany.CompanyId.ToString());
                                        blemployee.InsertedBy = compid;
                                        blemployee.InsertedOn = DateTime.Now;
                                        blemployee.InsertedMachineInfo = Helper.MachineInfo;
                                        blemployee.SaveNew();
                                        // decimal monthlysalary = emp.payPeriod.Trim() == "3" ? Helper.Findsalary(emp) : 0.00M;
                                        decimal monthlysalary = emp.salary != "" && emp.salary != null ? decimal.Parse(emp.salary) : 0.00M;//emp.payPeriod.Trim() == "3" ? emp.salary != "" && emp.salary != null ? decimal.Parse(emp.salary) : 0.00M : 0.00M;
                                        repoRegister.save_MasterEmployeeIncomes(blemployee, monthlysalary);

                                    }
                                    catch (Exception ex)
                                    {
                                        res.Status = false;
                                        res.Message = ex.Message;
                                        return BadRequest(res);
                                    }
                                }

                            }
                        }

                        repoRegister.DownloadSubmittedC3_Click(regno, compid, ParentUserLoginID, ParentUser_Password, UserID);
                        repoRegister.DownloadNWSSubmittedC3_Click(regno, compid, ParentUserLoginID, ParentUser_Password, UserID);
                    }
                    if (SelfCompid > 0 && (RoleId == 5 || RoleId == 6))
                    {
                        repoRegister.DownloadSelfEmpSubmittedC3_Click(SSN?.Trim(), SelfCompid, ParentUserLoginID, ParentUser_Password, UserID);
                    }
                    res.Status = true;
                    //res.Message = "Successfully registered, please login with your credentials";
                    res.Message = "Employee Imported Successfully";
                    return Ok(res);
                }
                else
                {
                    res.Status = false;
                    res.Message = "User Details Not Found.";
                    return BadRequest(res);
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                res.Status = false;
                res.Message = ex.Message;
                return BadRequest(res);
            }
        }
        [HttpGet]
        [Route("ReSendvarifycode")]
        [AllowAnonymous]
        public async Task<IActionResult> ReSendvarifycode(string UserName, string Password)
        {
            ResponseModel responseModel = new ResponseModel();
            try
            {
                //Login logpage = new Login();
                //Mouse.OverrideCursor = System.Windows.Input.Cursors.Wait;
                var data = _DbContext.Secusers.Where(e => e.LoginId == UserName).FirstOrDefault();
                var log = new ResendDeails();
                log.regNo = payerId(UserName, data.Password);
                log.userName = UserName.Trim();
                log.userPass = data.Password;
                string surl = _configuration["ServiceConfig:ServiceUriString"];
                string sURL = surl + "/User/reactivate";

                var myContent = JsonConvert.SerializeObject(log);
                var buffer = System.Text.Encoding.UTF8.GetBytes(myContent);
                var byteContent = new ByteArrayContent(buffer);
                byteContent.Headers.ContentType = new MediaTypeHeaderValue("application/json");

                HttpMessageHandler handler = new HttpClientHandler()
                {
                };

                var httpClient = new HttpClient(handler)
                {
                    BaseAddress = new Uri(sURL),
                    Timeout = new TimeSpan(0, 2, 0)
                };
                httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                //This is the key section you were missing    
                var plainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : System.Text.Encoding.UTF8.GetBytes(log.userName + ":" + log.userPass);
                string val = System.Convert.ToBase64String(plainTextBytes);
                httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + val);

                HttpResponseMessage response = httpClient.PostAsync(sURL, byteContent).Result;
                //if (response.StatusCode == HttpStatusCode.OK)
                //{
                //    Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                //    return true;
                //}
                //else
                //{
                //    var customerJsonString = await response.Content.ReadAsStringAsync();
                //    var Emp_model = JsonConvert.DeserializeObject<Apistatus>(customerJsonString);
                //    Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                //    C3WizardMessageBox.Show("C3 Wizard", Emp_model.message);
                //    return false;
                //}
                if (response.StatusCode == HttpStatusCode.OK)
                {
                    responseModel.Status = true;
                    responseModel.Message = "Successfully";
                    responseModel.Statuscode = 200;
                    return Ok(responseModel);
                }
                else
                {
                    var customerJsonString = await response.Content.ReadAsStringAsync();
                    var Emp_model = JsonConvert.DeserializeObject<Apistatus>(customerJsonString);
                    //if (Emp_model.message.Contains("User account is not active"))
                    //{
                    //    return true;
                    //}
                    //else
                    //{

                    //    return false;
                    //}
                    responseModel.Status = false;
                    responseModel.Message = Emp_model.message;
                    responseModel.Statuscode = 400;
                    return BadRequest(responseModel);
                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return BadRequest(ex.Message);
            }
            return Ok(responseModel);
        }
        [HttpGet]
        [Route("UserDecryptPassword")]
        [AllowAnonymous]
        public IActionResult UserDecryptPassword(string Password)
        {
            var decrypted = EncryptDecryptPassword.Decrypt(Password.Trim());
            return Ok(decrypted);
        }
    }
