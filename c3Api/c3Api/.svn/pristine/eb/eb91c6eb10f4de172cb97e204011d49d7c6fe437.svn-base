        [HttpGet("GetAllEmployersSelfData")]
        public async Task<IActionResult> GetAllEmployersSelfData(int roleid, int userid)
        {

            try
            {
                List<BLSelfEmployed> emplist = BLSelfEmployed.SelfEmployedCollectionnew(userid).ToList();
                var employeerlistm = (roleid == 1 && userid == 0) ? emplist : (roleid == 5 && userid != 0) ? emplist : new List<BLSelfEmployed>();

                if (employeerlistm != null)
                {
                    response.Message = "Data retrieved successfully!";
                    response.Statuscode = 200;
                    response.Status = true;
                    response.Data = employeerlistm;
                }

                return Ok(response);
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                response.Message = $"An error occurred: {ex.Message}";
                response.Statuscode = 500;
                response.Status = false;
                return BadRequest(response);
            }
        }
        [HttpGet("GetAllEmployersSelf")]
        public async Task<IActionResult> GetAllEmployersSelf(int roleid, int userid, int pageNumber, int pageSize, string? empName)
        {

            try
            {
                //if (pageNumber < 1) pageNumber = 1;
                //if (pageSize < 1) pageSize = 10;
                if (pageNumber < 0) pageNumber = 0;
                if (pageSize < 1) pageSize = 10;

                List<BLSelfEmployed> emplist = BLSelfEmployed.SelfEmployedCollectionnew(userid).ToList();
                var employeerlistm = (roleid == 1 && userid == 0) ? emplist : (roleid == 5 && userid != 0) ? emplist : new List<BLSelfEmployed>();


                if (!string.IsNullOrEmpty(empName))
                {
                    employeerlistm = employeerlistm.Where(e => e.FirstName.ToLower() == empName.ToLower() || e.SocSecNum == empName).ToList();
                }

                int totalRecords = employeerlistm.Count;
                int totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

                // Apply pagination
                //var pagedCompanies = employeerlistm
                //    .Skip((pageNumber - 1) * pageSize)
                //    .Take(pageSize)
                //    .ToList();
                var pagedCompanies = employeerlistm
                        .Skip(pageNumber * pageSize)
                        .Take(pageSize)
                        .ToList();

                if (pagedCompanies.Any())
                {
                    response.Message = "Data retrieved successfully!";
                    response.Statuscode = 200;
                    response.Status = true;
                    response.Data = new
                    {
                        TotalRecords = totalRecords,
                        PageNumber = pageNumber,
                        PageSize = pageSize,
                        TotalPages = totalPages,
                        Records = pagedCompanies
                    };
                }
                else
                {
                    response.Message = "No data found.";
                    response.Statuscode = 404;
                    response.Status = false;
                }

                return Ok(response);
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                response.Message = $"An error occurred: {ex.Message}";
                response.Statuscode = 500;
                response.Status = false;
                return BadRequest(response);
            }
        }

        /// <summary>
        /// This method retrieves all Countries.
        /// </summary>
        /// <returns>A list of Country.</returns>
        [HttpGet("GetAllCountry")]
        [AllowAnonymous]
        public async Task<IActionResult> GetAllCountry()
        {
            var response = new ResponseModel();

            try
            {
                var countries = await _DbContext.Countries.Where(x => x.IsActive == true).ToListAsync();


                if (countries.Any())
                {
                    response.Message = "Data retrieved successfully!";
                    response.Statuscode = 200;
                    response.Status = true;
                    response.Data = countries;
                    return Ok(response);
                }
                else
                {
                    response.Message = "No active countries found.";
                    response.Statuscode = 404;
                    response.Status = false;
                    return BadRequest(response);
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                response.Message = $"An error occurred: {ex.Message}";
                response.Statuscode = 500;
                response.Status = false;
                return BadRequest(response);
            }

            return Ok(response);
        }



        /// <summary>
        /// This method retrieves all EmployeeAndWokingEmployeelist.
        /// </summary>
        /// <returns>A list of EmployeeAndWokingEmployeelist.</returns>
        [HttpGet("WokingEmployeelist")]
        public async Task<ResponseModel> WokingEmployeelist(int CompanyId)
        {
            List<Employee_Name_SSN> Empllist = new List<Employee_Name_SSN>();
            try
            {
                DataTable dt = new DataTable();
                DataSet dataSet = new DataSet();
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                SqlCommand cmd = new SqlCommand("SELECT EmployeeID, Soc_Sec_Num +'('+Last_Name+' '+First_Name+')' as Name FROM MasterEmployee WHERE IsdirectorOnly=0 and isemployeeDirector=1 and Isactive=1 and CompanyId=" + CompanyId, staticConnection);
                cmd.CommandType = CommandType.Text;
                SqlDataAdapter adapter = new SqlDataAdapter();
                adapter.SelectCommand = cmd;
                adapter.Fill(dataSet);
                adapter.Fill(dt);
                //EMPLOYEESSN.ItemsSource = dataSet.Tables[0].DefaultView;
                List<Employee_Name_SSN> emplist = new List<Employee_Name_SSN>();
                staticConnection.Close();
                foreach (DataRow row in dt.Rows)
                {
                    Employee_Name_SSN emp = new Employee_Name_SSN();
                    emp.Name = row["Name"].ToString();
                    emp.EmployeeId = (int)row["EmployeeId"];
                    emplist.Add(emp);
                }
                Empllist = emplist;
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                throw ex;
            }

            if (Empllist.Count > 0)
            {
                response.Message = "Data retrieved successfully!";
                response.Statuscode = 200;
                response.Status = true;
                response.Data = Empllist;
            }
            else
            {
                response.Message = "No active countries found.";
                response.Statuscode = 404;
                response.Status = false;
            }
            return response;
        }

