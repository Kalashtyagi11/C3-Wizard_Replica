        [HttpPost("SaveEmployeer")]
        public async Task<IActionResult> SaveEmployeer([FromBody] EmployeerVm employeerVm)
        {

          

            if (employeerVm.mode == 1)
            {
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                if (staticConnection.State == System.Data.ConnectionState.Closed) await staticConnection.OpenAsync();
                SqlCommand cmd = new SqlCommand("check_company_reg_no ", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add(new SqlParameter("@REG_NUMBER", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)employeerVm.RegNumber ?? (object)DBNull.Value));
                cmd.Parameters.Add(new SqlParameter("@Company_Name", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)employeerVm.CompanyName ?? (object)DBNull.Value));
                cmd.Parameters.Add(new SqlParameter("@OLD_REG_NUMBER", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)employeerVm.RegNumber ?? (object)DBNull.Value));
                cmd.Parameters.Add(new SqlParameter("@OLD_Company_Name", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)employeerVm.CompanyName ?? (object)DBNull.Value));
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                DataTable dt = new DataTable();
                sqlAdapter.Fill(dt);
                await staticConnection.CloseAsync();
                if (dt.Rows.Count > 0)
                {
                    response.Message = "Employer already registered";
                    response.Status = true;
                    response.Statuscode = 200;
                    return Ok(response);
                }
            }
            BLMasterCompany blemployer = new BLMasterCompany();

            if (!string.IsNullOrWhiteSpace(employeerVm.CompanyLogo))
            {
                try
                {
                    // Split if base64 has metadata prefix like "data:image/png;base64,..."
                    var base64Parts = employeerVm.CompanyLogo.Split(',');
                    string base64Data = base64Parts.Length > 1 ? base64Parts[1] : base64Parts[0];

                    byte[] imageBytes = Convert.FromBase64String(base64Data);

                    //string appPath = Directory.GetCurrentDirectory();
                    //string imageFolderPath = Path.Combine(appPath, "CompanyLogo");

                    //if (!Directory.Exists(imageFolderPath))
                    //    Directory.CreateDirectory(imageFolderPath);
                    // Use wwwroot/CompanyLogo path
                    string imageFolderPath = Path.Combine(_environment.WebRootPath, "CompanyLogo");

                    if (!Directory.Exists(imageFolderPath))
                        Directory.CreateDirectory(imageFolderPath);

                    // Generate a safe file name
                    string fileName = $"logo_{Guid.NewGuid():N}.png";  // or .jpg depending on your content-type
                    string fullImagePath = Path.Combine(imageFolderPath, fileName);

                    await System.IO.File.WriteAllBytesAsync(fullImagePath, imageBytes);

                    blemployer.CompanyLogo = fileName;
                }
                catch (FormatException)
                {

                    return StatusCode(500, new
                    {
                        Message = "Invalid base64 string format.",
                        Status = false,
                        Statuscode = 500
                    });
                }
                catch (Exception ex)
                {
                    var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                    LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                    return StatusCode(500, new
                    {
                        Message = "Error saving image: " + ex.Message,
                        Status = false,
                        Statuscode = 500
                    });
                }
            }
            else
            {
                blemployer.CompanyLogo = null;
            }

            //BLMasterCompany blemployer = new BLMasterCompany();
            //if (filepath != null && filepath != "")
            //{
            //  string imagepath = filepath;
            //  var imageFile = new System.IO.FileInfo(imagepath);
            //  if (imageFile.Exists)
            //  {
            //    var applicationPath = System.IO.Path.GetDirectoryName(System.Reflection.Assembly.GetExecutingAssembly().Location);

            //    var dir = new System.IO.DirectoryInfo(System.IO.Path.Combine(applicationPath, "UserImage"));
            //    if (!dir.Exists)
            //      dir.Create();
            //    // Copy file to your folder
            //    string name = System.IO.Path.GetFileName(filepath);
            //    // string destinationPath = GetDestinationPath(name, "UserImage");
            //    try
            //    {
            //      // File.Copy(filepath, destinationPath, true);
            //      // File.Copy(filepath, destinationPath, true);
            //      blemployer.CompanyLogo = name;
            //    }
            //    catch (Exception ex)
            //    {

            //      response.Message = "An error occurred.";
            //      response.Status = false;
            //      response.Statuscode = 500;
            //    }

            //  }

            //}
            //else
            //{
            //  blemployer.CompanyLogo = companylogo;
            //}
            //blemployer.Parent_Id = companyparentid != 0 ? Helper.CompanyId : 0;
