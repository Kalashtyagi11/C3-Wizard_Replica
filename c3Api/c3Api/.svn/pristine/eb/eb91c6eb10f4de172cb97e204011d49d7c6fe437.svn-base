        [AllowAnonymous]
        [HttpGet("GetAllCompanyData")]
        public async Task<ResponseModel> GetAllCompanyData(bool nW)
        {
            var response = new ResponseModel();

            try
            {

                if (nW == true)
                {
                    var mastercompanieslist = await _DbContext.MasterEmployees.Where(x => x.IsActive == true && x.IsdirectorOnly == nW).Select(x => x.CompanyId).Distinct()
                    .ToListAsync();

                    var allCompanies = await _DbContext.MasterCompanies.Where(x => x.IsActive == true).ToListAsync();

                    var filteredCompanies = new List<MasterCompany>();

                    foreach (var company in allCompanies)
                    {
                        if (mastercompanieslist.Any(id => id == company.CompanyId))
                        {
                            filteredCompanies.Add(company);
                        }
                    }


                    foreach (var item in filteredCompanies)
                    {
                        item.UserId = _DbContext.SECUsersProfiles?.FirstOrDefault(e => e.EmpId == item.CompanyId && e.REG_NUMBER == item.RegNumber && e.IsActive)?.UserId;

                        item.Usercount = _DbContext.Secusers.Where(e => e.EmpId == item.CompanyId.ToString()).Count();
                    }

                    if (filteredCompanies.Any())
                    {
                        response.Message = "Data retrieved successfully!";
                        response.Statuscode = 200;
                        response.Status = true;
                        response.Data = filteredCompanies;
                    }
                    else
                    {
                        response.Message = "No data found.";
                        response.Statuscode = 404;
                        response.Status = false;
                    }
                }
                else
                {
                    var allCompanies = await _DbContext.MasterCompanies.Where(x => x.IsActive == true).ToListAsync();
                    foreach (var item in allCompanies)
                    {
                        item.UserId = _DbContext.SECUsersProfiles?.FirstOrDefault(e => e.EmpId == item.CompanyId && e.REG_NUMBER == item.RegNumber && e.IsActive)?.UserId;
                        item.Usercount = _DbContext.Secusers.Where(e => e.EmpId == item.CompanyId.ToString()).Count();
                        item.EmployeeCount = _DbContext.MasterEmployees.Where(e => e.CompanyId == item.CompanyId && e.IsActive == true && e.IsdirectorOnly == false).Count();
                    }

                    //      var result = await _DbContext.Database
                    //  .SqlQuery<CompanySummary>($@"
                    //    SELECT 
                    //        c.company_id AS CompanyId,
                    //        c.Company_Name AS CompanyName,
                    //        COUNT(DISTINCT u.UserId) AS UserCount,
                    //        COUNT(DISTINCT e.EmployeeId) AS EmployeeCount
                    //    FROM mastercompany c
                    //    LEFT JOIN Secusers u ON TRY_CAST(u.EmpId AS INT) = c.company_id
                    //    LEFT JOIN MasterEmployee e 
                    //        ON e.CompanyId = c.company_id 
                    //        AND e.IsActive = 1 
                    //        AND e.IsdirectorOnly = 0
                    //    WHERE c.IsActive = 1
                    //    GROUP BY c.company_id, c.Company_Name
                    //    ORDER BY c.company_id
                    //").ToListAsync();



                    if (allCompanies.Any())
                    {
                        response.Message = "Data retrieved successfully!";
                        response.Statuscode = 200;
                        response.Status = true;
                        response.Data = allCompanies;
                    }
                    else
                    {
                        response.Message = "No data found.";
                        response.Statuscode = 404;
                        response.Status = false;
                    }
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                response.Message = $"An error occurred: {ex.Message}";
                response.Statuscode = 500;
                response.Status = false;
            }

            return response;
        }
        public class CompanySummary
        {
            public int CompanyId { get; set; }
            public string CompanyName { get; set; }
            public int UserCount { get; set; }
            public int EmployeeCount { get; set; }
        }
        [AllowAnonymous]
        [HttpGet("GetAllCompany")]
        public async Task<ResponseModel> GetAllCompany(bool nW, int pageNumber, int pageSize, string? empName)
        {
            var response = new ResponseModel();

            try
            {
                //if (pageNumber < 1) pageNumber = 1;
                //if (pageSize < 1) pageSize = 10;
                if (pageNumber < 0) pageNumber = 0;
                if (pageSize < 1) pageSize = 10;

                if (nW == true)
                {
                    var mastercompanieslist = await _DbContext.MasterEmployees.Where(x => x.IsActive == true && x.IsdirectorOnly == nW).Select(x => x.CompanyId).Distinct()
                    .ToListAsync();

                    var allCompanies = await _DbContext.MasterCompanies.Where(x => x.IsActive == true).ToListAsync();

                    var filteredCompanies = new List<MasterCompany>();

                    foreach (var company in allCompanies)
                    {
                        if (mastercompanieslist.Any(id => id == company.CompanyId))
                        {
                            filteredCompanies.Add(company);
                        }
                    }


                    foreach (var item in filteredCompanies)
                    {
                        item.Usercount = _DbContext.Secusers.Where(e => e.EmpId == item.CompanyId.ToString()).Count();
                    }

                    if (!string.IsNullOrEmpty(empName))
                    {
                        filteredCompanies = filteredCompanies.Where(e => e.CompanyName.ToLower() == empName.ToLower() || e.RegNumber == empName).ToList();






                    }

                    int totalRecords = filteredCompanies.Count;
                    int totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);

                    // Apply pagination
                    //var pagedCompanies = filteredCompanies
                    //    .Skip((pageNumber - 1) * pageSize)
                    //    .Take(pageSize)
                    //    .ToList();
                    var pagedCompanies = filteredCompanies
                          .Skip(pageNumber * pageSize)
                          .Take(pageSize)
                          .ToList();

                    if (pagedCompanies.Any())
                    {
                        response.Message = "Data retrieved successfully!";
                        response.Statuscode = 200;
                        response.Status = true;
                        response.Data = new
                        {
                            TotalRecords = totalRecords,
                            PageNumber = pageNumber,
                            PageSize = pageSize,
                            TotalPages = totalPages,
                            Records = pagedCompanies
                        };
                    }
                    else
                    {
                        response.Message = "No data found.";
                        response.Statuscode = 404;
                        response.Status = false;
                    }
                }
                else
                {
                    var allCompanies = await _DbContext.MasterCompanies.Where(x => x.IsActive == true).ToListAsync();
                    foreach (var item in allCompanies)
                    {
                        item.Usercount = _DbContext.Secusers.Where(e => e.EmpId == item.CompanyId.ToString()).Count();
                        item.EmployeeCount = _DbContext.MasterEmployees.Where(e => e.CompanyId == item.CompanyId && e.IsActive == true && e.IsdirectorOnly == false).Count();
                    }

                    if (!string.IsNullOrEmpty(empName))
                    {
                        allCompanies = allCompanies.Where(e => e.CompanyName.ToLower() == empName.ToLower() || e.RegNumber == empName).ToList();
                    }

                    int totalRecords = allCompanies.Count;
                    int totalPages = (int)Math.Ceiling((double)totalRecords / pageSize);


                    var pagedCompanies = allCompanies
                          .Skip(pageNumber * pageSize)
                          .Take(pageSize)
                          .ToList();

                    if (pagedCompanies.Any())
                    {
                        response.Message = "Data retrieved successfully!";
                        response.Statuscode = 200;
                        response.Status = true;
                        response.Data = new
                        {
                            TotalRecords = totalRecords,
                            PageNumber = pageNumber,
                            PageSize = pageSize,
                            TotalPages = totalPages,
                            Records = pagedCompanies
                        };
                    }
                    else
                    {
                        response.Message = "No data found.";
                        response.Statuscode = 404;
                        response.Status = false;
                    }
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                response.Message = $"An error occurred: {ex.Message}";
                response.Statuscode = 500;
                response.Status = false;
            }

            return response;
        }
        [HttpGet]
        [Route("ValidateRegistration")]
        [AllowAnonymous]
        public async Task<ActionResult> ValidateRegistration(string regNo, string email)
        {

            var data = _DbContext.SelfEmployees.Where(x => x.SocSecNum == regNo).FirstOrDefault();
            if (data != null)
            {

                return BadRequest(new ResponseModel
                {
                    Status = false,
                    Message = "This registration number is already in use!",
                    Statuscode = 400
                });
            }

            if (string.IsNullOrWhiteSpace(regNo))
            {
                return BadRequest(new ResponseModel
                {
                    Status = false,
                    Message = "Please enter registration number.",
                    Statuscode = 400
                });
            }

            if (regNo.Length != 6)
            {
                return BadRequest(new ResponseModel
                {
                    Status = false,
                    Message = "Registration number should be 6 digits.",
                    Statuscode = 400
                });
            }

            if (regNo.Contains(" "))
            {
                return BadRequest(new ResponseModel
                {
                    Status = false,
                    Message = "Please enter registration number without spaces.",
                    Statuscode = 400
                });
            }


            try
            {
                if (!int.TryParse(regNo, out int ssn))
                {
                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                        Message = "Invalid registration number format.",
                        Statuscode = 400
                    });
                }

                DataSet dataSet = new DataSet();
                string connectionString = C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString;

                using (SqlConnection con = new SqlConnection(connectionString))
                {
                    await con.OpenAsync();
                    using (SqlCommand cmd = new SqlCommand("SELECT * FROM MasterCompany WHERE IsActive = 1 AND REG_NUMBER = @RegNo", con))
                    {
                        cmd.Parameters.AddWithValue("@RegNo", ssn);
                        cmd.CommandType = CommandType.Text;

                        SqlDataAdapter adapter = new SqlDataAdapter(cmd);
                        adapter.Fill(dataSet);
                    }
                    await con.CloseAsync();
                }
                if (dataSet.Tables[0].Rows.Count > 0)
                {
                    if (C3WizardRepository.Repository.ConnectionInfom.HasConnection() && _configuration["IsBEMARegistrationEnabled"] == "1" &&
                        C3WizardRepository.Repository.ConnectionInfom.APIConnection(_configuration))
                    {
                        try
                        {
                            string serviceUri = _configuration["ServiceConfig:ServiceUriString"];
                            string apiUrl = $"{serviceUri}/Employer/getERMasterDetails/{regNo}";

                            using (HttpClient httpClient = new HttpClient())
                            {
                                httpClient.BaseAddress = new Uri(apiUrl);
                                httpClient.Timeout = TimeSpan.FromMinutes(2);
                                httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");

                                string authUser = _configuration["ServiceConfig:AuthUser"];
                                string authPass = _configuration["ServiceConfig:AuthPass"];
                                string authToken = Convert.ToBase64String(Encoding.UTF8.GetBytes($"{authUser}:{authPass}"));

                                httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + authToken);
                                HttpResponseMessage response = await httpClient.GetAsync(apiUrl);
                                if (response.StatusCode == HttpStatusCode.OK)
                                {
                                    string jsonResult = await response.Content.ReadAsStringAsync();
                                    var employerDetails = JsonConvert.DeserializeObject<GetEmployerDeailsModule>(jsonResult);

                                    if (employerDetails == null)
                                    {
                                        return NotFound(new ResponseModel
                                        {
                                            Status = false,
                                            Message = "This registration number is not registered SSB but is not valid.",
                                            Statuscode = 404
                                        });
                                    }
                                    else if (employerDetails.email != email)
                                    {
                                        return BadRequest(new ResponseModel
                                        {
                                            Status = true,
                                            Message = "User email InValid",
                                            Statuscode = 400,
                                            Data = ""
                                        });
                                    }
                                    else if (employerDetails.c3RegnStatusCode == "D")
                                    {
                                        return Ok(new ResponseModel
                                        {
                                            Status = true,
                                            Message = "This registration number is registered at S.S.B. Do you want to register this employer on the SSB server?",
                                            Statuscode = 200,
                                            Data = employerDetails
                                        });
                                    }
                                    else if (employerDetails.c3RegnStatusCode == "A")
                                    {
                                        return Ok(new ResponseModel
                                        {
                                            Status = true,
                                            Message = "This registration number is registered at S.S.B. Do you want to register this employer on the SSB server?",
                                            Statuscode = 200,
                                            Data = employerDetails
                                        });
                                    }
                                    else if (employerDetails.c3RegnStatusCode == "O")
                                    {
                                        return Ok(new ResponseModel
                                        {
                                            Status = true,
                                            Message = "Already registered with same payerId and EmailId",
                                            Statuscode = 200,
                                            Data = employerDetails
                                        });
                                    }

                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            return StatusCode(500, new ResponseModel
                            {
                                Status = false,
                                Message = "An error occurred while calling the external API: " + ex.Message,
                                Statuscode = 500
                            });
                        }
                    }

                    //if (_configuration["IsBEMARegistrationEnabled"] == "0")
                    //{
                    //    return Ok(new ResponseModel
                    //    {
                    //        Status = true,
                    //        Message = "",
                    //        Statuscode = 200
                    //    });
                    //}

                    return BadRequest(new ResponseModel
                    {
                        Status = true,
                        Message = "You are already registered with this registration number! Please log in with your credentials.",
                        Statuscode = 200
                    });
                }
                else
                {
                    if (C3WizardRepository.Repository.ConnectionInfom.HasConnection() && C3WizardRepository.Repository.ConnectionInfom.APIConnection(_configuration))
                    {
                        try
                        {
                            string serviceUri = _configuration["ServiceConfig:ServiceUriString"];
                            string apiUrl = $"{serviceUri}/Employer/getERMasterDetails/{regNo}";

                            using (HttpClient httpClient = new HttpClient())
                            {
                                httpClient.BaseAddress = new Uri(apiUrl);
                                httpClient.Timeout = TimeSpan.FromMinutes(2);
                                httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");

                                string authUser = _configuration["ServiceConfig:AuthUser"];
                                string authPass = _configuration["ServiceConfig:AuthPass"];
                                string authToken = Convert.ToBase64String(Encoding.UTF8.GetBytes($"{authUser}:{authPass}"));

                                httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + authToken);

                                HttpResponseMessage response = await httpClient.GetAsync(apiUrl);
                                if (response.StatusCode == HttpStatusCode.OK)
                                {
                                    string jsonResult = await response.Content.ReadAsStringAsync();
                                    var employerDetails = JsonConvert.DeserializeObject<GetEmployerDeailsModule>(jsonResult);

                                    //if (employerDetails == null)
                                    //{
                                    //  return NotFound(new ResponseModel
                                    //  {
                                    //    Status = false,
                                    //    Message = "This registration number is already registered locally but is not valid.",
                                    //    Statuscode = 404
                                    //  });
                                    //}
                                    if (employerDetails.email != email)
                                    {
                                        return BadRequest(new ResponseModel
                                        {
                                            Status = true,
                                            Message = "User email InValid",
                                            Statuscode = 400,
                                            Data = ""
                                        });
                                    }

                                    return Ok(new ResponseModel
                                    {
                                        Status = true,
                                        Message = "",
                                        Statuscode = 200,
                                        Data = employerDetails
                                    });

                                    /*if (employerDetails.c3RegnStatusCode == "D")
                                    {
                                        return Ok(new ResponseModel
                                        {
                                            Status = true,
                                            Message = "This registration number is registered at S.S.B. Do you want to register this employer on the SSB server?",
                                            Statuscode = 200,
                                            Data = employerDetails
                                        });
                                    }
                                    if (employerDetails.c3RegnStatusCode == "A")
                                    {
                                        return Ok(new ResponseModel
                                        {
                                            Status = true,
                                            Message = "This registration number is registered at S.S.B. Do you want to register this employer on the SSB server?",
                                            Statuscode = 200,
                                            Data = employerDetails
                                        });
                                    }
                                    if (employerDetails.c3RegnStatusCode == "O")
                                    {
                                        return BadRequest(new ResponseModel
                                        {
                                            Status = true,
                                            Message = "Already registered with same payerId and EmailId",
                                            Statuscode = 200,
                                            Data = employerDetails
                                        });
                                    }*/
                                }

                                else
                                {
                                    var customerJsonString = await response.Content.ReadAsStringAsync();
                                    var Emp_model = JsonConvert.DeserializeObject<Apistatus>(customerJsonString);
                                    return StatusCode(400, new ResponseModel
                                    {
                                        Status = false,
                                        //Message = Emp_model.message,
                                        Message = "Please enter valid registration number",
                                        Statuscode = Convert.ToInt32(Emp_model.status)
                                    });
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            return StatusCode(500, new ResponseModel
                            {
                                Status = false,
                                Message = "An error occurred while calling the external API: " + ex.Message,
                                Statuscode = 500
                            });
                        }
                    }

                    //if (_configuration["IsBEMARegistrationEnabled"] == "0")
                    //{
                    //    return Ok(new ResponseModel
                    //    {
                    //        Status = true,
                    //        Message = "",
                    //        Statuscode = 200
                    //    });
                    //}

                    return Ok(new ResponseModel
                    {
                        Status = true,
                        Message = "SSB Server not Running.",
                        Statuscode = 503
                    });
                }

                //A/
                //return Ok(new ResponseModel
                //{
                //  Status = true,
                //  Message = "success",
                //  Statuscode = 200
                //});

                var users = _DbContext.Secusers.Where(x => x.LoginId == regNo).FirstOrDefault();
                if (data != null)
                {

                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                        Message = "This registration number is already in use!",
                        Statuscode = 400
                    });
                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = "An unexpected error occurred: " + ex.Message,
                    Statuscode = 500
                });
            }
            //
        }
