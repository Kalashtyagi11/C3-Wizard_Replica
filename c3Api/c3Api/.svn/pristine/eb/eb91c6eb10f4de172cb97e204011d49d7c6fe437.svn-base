        /// <summary>
        /// This method retrieves LoadCategoryAll.
        /// </summary>
        /// <returns>A list of LoadCategoryAll.</returns>
        [HttpGet("LoadCategoryAll")]
        [AllowAnonymous]
        public async Task<ResponseModel> LoadCategoryAll()
        {

            List<c3WageCategory> wagecatlist = new List<c3WageCategory>();
            var response = new ResponseModel();
            try
            {
                DataSet CdataSet = new DataSet();

                SqlConnection con = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString);
                con.Open();
                SqlCommand cmd = new SqlCommand("SELECT CategoryID, Category + ' (Weekly Income : '+ cast(cast(WeeklyIncome as numeric(18,2)) as nvarchar(20))+', '+'Weekly Contribution : '+ cast(cast(WeeklyContribution as numeric(18,2)) as nvarchar(20))+' )' As WageCategory FROM WageCategories where IsLocked=" + 1, con);
                cmd.CommandType = CommandType.Text;
                SqlDataAdapter adapter = new SqlDataAdapter();
                adapter.SelectCommand = cmd;
                adapter.Fill(CdataSet);
                con.Close();
                // cmbIncomeCategory.ItemsSource = CdataSet.Tables[0].DefaultView;
                try
                {
                    foreach (DataRow row in CdataSet.Tables[0].Rows)
                    {
                        c3WageCategory wagecat = new c3WageCategory();
                        wagecat.CategoryID = Convert.IsDBNull(row["CategoryID"]) ? 0 : int.Parse(row["CategoryID"].ToString());
                        wagecat.CategoryDescription = Convert.IsDBNull(row["WageCategory"]) ? null : row["WageCategory"].ToString();
                        wagecatlist.Add(wagecat);
                    }

                    if (wagecatlist.Count > 0)
                    {
                        response.Message = "Data retrieved successfully!";
                        response.Statuscode = 200;
                        response.Status = true;
                        response.Data = wagecatlist;
                    }
                    else
                    {
                        response.Message = "No Data found.";
                        response.Statuscode = 404;
                        response.Status = false;
                    }
                }
                catch (Exception ex)
                {
                    var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                    LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                }
                return response;

            }
            catch (Exception ex)
            {

            }


            return response;
        }

        /// <summary>
        /// This method retrieves employer details by company ID.
        /// </summary>
        /// <param name="CompanyId">The ID of the company to retrieve.</param>
        /// <returns>A ResponseModel containing the employer details.</returns>
        [HttpGet("EmployersGetById")]
        public async Task<ResponseModel> EmployersGetById(int CompanyId)
        {
            var response = new ResponseModel();
            try
            {

                // Retrieve all companies
                var blempList_ALL = BLMasterCompany.MasterCompanyCollection().ToList();
                var selectedCompany = blempList_ALL.FirstOrDefault(t => t.CompanyId == CompanyId);

                var objQuestionAnswer = BLUserSecurityQuestionAnswer.SecurityQuestionAnswerCollection();
                objQuestionAnswer = objQuestionAnswer.Where(e => e.CompanyId == (selectedCompany.CompanyId ?? 0) && e.RegistrationNo == Convert.ToInt32(selectedCompany.RegNumber)).ToList();
                var data = _DbContext.Secusers.Where(e => e.EmpId == CompanyId.ToString()).FirstOrDefault();
                if (data == null)
                {
                    var userid = _DbContext.SECUsersProfiles.FirstOrDefault()?.UserId ?? 0;
                    data = _DbContext.Secusers.Where(e => e.UserId == userid).FirstOrDefault();
                }
                if (objQuestionAnswer == null|| objQuestionAnswer.Count==0)
                {
                   
                    objQuestionAnswer = BLUserSecurityQuestionAnswer.SecurityQuestionAnswerCollection().Where(e => e.CompanyId == (selectedCompany.Parent_Id ?? 0) ).ToList();

                }
                if (selectedCompany == null)
                {
                    response.Statuscode = 404;
                    response.Message = "Company not found.";
                    response.Data = null;
                    return response;
                }

                var bLMaster = new EmployeerVm
                {
                    FirstName = data.FirstName,
                    LastName = data.LastName,
                    LoginId = data.LoginId,
                    CompanyId = selectedCompany.CompanyId,
                    RegNumber = selectedCompany.RegNumber,
                    CompanyName = selectedCompany.CompanyName?.ToString(),
                    ContactPerson = selectedCompany.ContactPerson?.ToString(),
                    TradeName = selectedCompany.TradeName?.ToString(),
                    Landline = selectedCompany.Landline?.ToString(),
                    Mobile = selectedCompany.Mobile?.ToString(),
                    Address1 = selectedCompany.Address1?.ToString(),
                    Address2 = selectedCompany.Address2?.ToString(),
                    Zip = selectedCompany.Zip?.ToString(),
                    City = selectedCompany.City?.ToString(),
                    Email = selectedCompany.Email?.ToString(),
                    //com = selectedCompany.CompanyLogo?.ToString() ?? "",
                    IsLevyExempt = selectedCompany.IsLevyExempt ?? false,
                    ParentCompanyId = selectedCompany.Parent_Id ?? 0,
                    Country = selectedCompany.Country?.ToString(),
                    Question1 = objQuestionAnswer != null && objQuestionAnswer.Count > 0 ? objQuestionAnswer[0].Question1 ?? "" : "",
                    Answer1 = objQuestionAnswer != null && objQuestionAnswer.Count > 0 ? objQuestionAnswer[0].Answer1 ?? "" : "",
                    Question2 = objQuestionAnswer != null && objQuestionAnswer.Count > 0 ? objQuestionAnswer[0].Question2 ?? "" : "",
                    Answer2 = objQuestionAnswer != null && objQuestionAnswer.Count > 0 ? objQuestionAnswer[0].Answer2 ?? "" : "",

                    CompanyLogo = $"{Request.Scheme}://{Request.Host}/CompanyLogo/{selectedCompany.CompanyLogo}",
                    userId = objQuestionAnswer != null && objQuestionAnswer.Count > 0 ? objQuestionAnswer?[0]?.UserId ?? 0 : 0,
                };

                response.Statuscode = 200;
                response.Message = "Success";
                response.Data = bLMaster;
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                response.Statuscode = 500;
                response.Message = "An error occurred while retrieving the company details.";
                response.Data = ex.Message;
            }

            return response;
        }




        /// <summary>
        /// /This method is used to forget password 
        /// </summary>
        /// <param name="Email"></param>
        /// <returns></returns>
        [HttpPost("ForgotPassword")]
        [AllowAnonymous]
        public async Task<IActionResult> ForgetPassword([FromBody] ForgetpasswordVm forgetpassword)
        {

            ResponseModel response1 = new ResponseModel();
            try
            {
                BLSECUsers blemp = new BLSECUsers();
                List<BLSECUsers> bluserList_ALL = new List<BLSECUsers>();
                BLSECUsers bluser = new BLSECUsers();
                blemp.UserId = forgetpassword.UserId;
                bluserList_ALL = BLSECUsers.SECUsersCollection().ToList();
                bluser = bluserList_ALL.Any(t => t.LoginId == forgetpassword.userName) ? bluserList_ALL.FirstOrDefault(t => t.LoginId == forgetpassword.userName) : null;
                if (bluser != null)
                {
                    BLSECUsers buser = new BLSECUsers();
                    //buser.Password = HashPassword.EncodePasswordToBase64(forgetpassword.Password);
                    buser.Password = EncryptDecryptPassword.Encrypt(forgetpassword.Password);
                    buser.UserId = forgetpassword.UserId;
                    if (ConnectionInfom.HasConnection() && ConnectionInfom.APIConnection(_configuration))
                    {
                        ResetPasswordModel FPM = new ResetPasswordModel();
                        FPM.regNo = forgetpassword.regNo.ToString();
                        FPM.userName = forgetpassword.userName;
                        FPM.userOldPass = bluser.Password;
                        FPM.userNewPass = EncryptDecryptPassword.Encrypt(forgetpassword.Password);
                        //String surl = ConfigurationManager.AppSettings["ServiceUriString"];
                        string surl = _configuration["ServiceConfig:ServiceUriString"];
                        string sURL = surl + "/User/resetPassword/";

                        var myContent = JsonConvert.SerializeObject(FPM);
                        var buffer = System.Text.Encoding.UTF8.GetBytes(myContent);
                        var byteContent = new ByteArrayContent(buffer);
                        byteContent.Headers.ContentType = new MediaTypeHeaderValue("application/json");


                        HttpMessageHandler handler = new HttpClientHandler()
                        {
                        };

                        var httpClient = new HttpClient(handler)
                        {
                            BaseAddress = new Uri(sURL),
                            Timeout = new TimeSpan(0, 2, 0)
                        };
                        httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");

                        //var plainTextBytes = System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + _configuration["ServiceConfig:AuthPass"]);

                        var plainTextBytes = System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]);

                        string val = System.Convert.ToBase64String(plainTextBytes);
                        httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + val);

                        HttpResponseMessage response = httpClient.PostAsync(sURL, byteContent).Result;

                        if (response.StatusCode == HttpStatusCode.OK)
                        {
                            buser.UpdatePassword();
                            var customerJsonString = await response.Content.ReadAsStringAsync();

                            //response1.Message = customerJsonString;
                            response1.Message = "Password Updated Successfully!";
                            response1.Status = true;
                            response1.Statuscode = 200;
                            return Ok(response1);

                        }
                        else
                        {
                            var customerJsonString = await response.Content.ReadAsStringAsync();
                            var Emp_model = JsonConvert.DeserializeObject<Apistatus>(customerJsonString);
                            response1.Message = Emp_model.message;
                            return BadRequest(response1);

                        }
                    }
                    else
                    {
                        var res = _DbContext.Secusers.Where(e => e.UserId == forgetpassword.UserId && e.Password == EncryptDecryptPassword.Encrypt(forgetpassword.Password)).FirstOrDefault();
                        if (res == null)
                        {
                            buser.UpdatePassword();
                            response1.Message = "Password Updated Successfully!";
                            response1.Status = true;
                            response1.Statuscode = 200;
                            return Ok(response1);
                        }
                        else
                        {
                            return Conflict(new
                            {
                                message = "User password already exists"
                            });
                        }

                        //buser.UpdatePassword();
                        //response1.Message = "Password Updated Successfully!";
                        //response1.Status = true;
                        //response1.Statuscode = 200;
                        //return Ok(response1);

                    }

                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                throw ex;
            }
            return Ok(response1);
        }

        /// <summary>
        /// This method is used to verify otp forget password
        /// </summary>
        /// <param name="verifyOtp"></param>
        /// <returns></returns>
        /// 

        [HttpGet("QuestionAnswerForget")]
        [AllowAnonymous]
        public async Task<IActionResult> QuestionAnswerForget(int regNo, string userName)
        {
            try
            {
                ForgetpasswordVm result = new ForgetpasswordVm();
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                SqlCommand CurrentCompany = new SqlCommand("SELECT Question1,Question2,Answer1,Answer2,UserName,RegistrationNo  FROM SecurityQuestionAnswer where RegistrationNo=" + regNo + " and UserName='" + userName + "'", staticConnection);
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();

                SqlDataReader dr = CurrentCompany.ExecuteReader();
                string Question1 = "", Question2 = "", Answer1 = "", Answer2 = "", user = "";
                if (dr.HasRows)
                {
                    while (dr.Read())
                    {
                        result.Question1 = dr["Question1"].ToString();
                        result.Question2 = dr["Question2"].ToString();
                        result.Answer1 = dr["Answer1"].ToString();
                        result.Answer2 = dr["Answer2"].ToString();
                        result.userName = dr["UserName"].ToString();
                        result.regNo = dr["RegistrationNo"].ToString();
                    }
                }
                else
                {
                    return NotFound(new { status = false, msg = "Enter valid Registration no. and Username", data = "" });

                }
                staticConnection.Close();

                return Ok(new { status = true, msg = "Data Found", data = new { result } });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return NotFound(new { status = false, msg = "Data Not Found", data = "" });
            }
        }


