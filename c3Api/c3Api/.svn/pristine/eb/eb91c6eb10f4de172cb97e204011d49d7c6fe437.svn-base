                        {
                            var role = Convert.ToInt32(dataSet.Tables[0].Rows[0]["RoleId"]); //Role Admin,SSB not Check Live SSB Apis then Login
                            if (role == 1)
                            {
                                res = true;
                            }
                            else
                            {
                                response = parentuserid == 0 ? await LoginDetails(Convert.ToString(dataSet.Tables[0].Rows[0]["LoginId"]), Convert.ToString(dataSet.Tables[0].Rows[0]["Password"])) : await LoginDetails(parentloginuser, parentloginuserpassword);
                                res = (bool)response?.Status;
                                if ((bool)response.Status && IssilentlyReg)
                                {

                                    IssilentlyReg = false;
                                    return BadRequest(response);
                                }
                            }
                        }
                        if (res)
                        {
                            if (parentuserid > 0)
                            {

                                secuser.Parentuserid = parentuserid;
                                secuser.ParentUserLoginID = parentloginuser;
                                secuser.ParentUser_Password = parentloginuserpassword;

                            }
                            else
                            {
                                secuser.PUserLoginID = Convert.ToInt32(dataSet.Tables[0].Rows[0]["UserId"]);

                            }
                            string uploadsFolder = Path.Combine(_environment.ContentRootPath, "UserImage");
                            //Changes 09/07/2025
                            if (Convert.ToInt32(logindata.EmpId) > 0)
                            {
                                if (dataSet.Tables[0].Rows[0]["IsLevyExempt"] != DBNull.Value)
                                {
                                    secuser.IsLevyExempt = Convert.ToBoolean(dataSet.Tables[0].Rows[0]["IsLevyExempt"]);
                                }

                            }
                            else
                            {
                                secuser.IsLevyExempt = false;
                            }
                            secuser.UserId = Convert.ToInt32(dataSet.Tables[0].Rows[0]["UserId"]);
                            var userId = Convert.ToInt32(dataSet.Tables[0].Rows[0]["UserId"]);
                            var roleName = Convert.ToInt32(dataSet.Tables[0].Rows[0]["RoleId"]);

                            //string filePath = Path.Combine(Path.Combine(_environment.ContentRootPath, "wwwroot\\MenuList"), "MenuC3.xml");
                            // var Menu = await _DashBoardRepo.MenuList(roleName);
                            // secuser.MenuDetails = Menu;
                            secuser.RoleId = Convert.ToInt32(dataSet.Tables[0].Rows[0]["RoleId"]);
                            secuser.roleCategory = dataSet.Tables[0].Rows[0]["roleCategory"]?.ToString();
                            secuser.RoleName = Convert.ToString(dataSet.Tables[0].Rows[0]["Role"]);
                            
                            secuser.LoginUserID = Convert.ToInt32(dataSet.Tables[0].Rows[0]["UserId"]);
                            secuser.profileImage = $"{Request.Scheme}://{Request.Host}/UserImage/{(dataSet.Tables[0].Rows[0]["UserImage"].ToString())}";
                            //Changes 09/07/2025
                            if (Convert.ToInt32(logindata.EmpId) > 0)
                            {
                                secuser.companyLogo = $"{Request.Scheme}://{Request.Host}/CompanyLogo/{(dataSet.Tables[0].Rows[0]["CompanyLogo"].ToString())}";

                            }

                            secuser.User_Name = Convert.ToString(dataSet.Tables[0].Rows[0]["LoginId"]);
                            secuser.LoginUserEmail = Convert.ToString(dataSet.Tables[0].Rows[0]["EmailId"]);
                            string UserEmail = Convert.ToString(dataSet.Tables[0].Rows[0]["EmailId"]);
                            secuser.LoginUserName = Convert.ToString(dataSet.Tables[0].Rows[0]["LoginId"]) + " " + Convert.ToString(dataSet.Tables[0].Rows[0]["LastName"]);
                            bool IsSelf_emp = dataSet.Tables[0].Rows[0]["IsSelfEmployee"] != null || dataSet.Tables[0].Rows[0]["IsSelfEmployee"] != "" ? Convert.ToBoolean(dataSet.Tables[0].Rows[0]["IsSelfEmployee"]) : false;
                            secuser.IsSelfEmployed = IsSelf_emp;

                            var childcompdata = _DbContext.SECUsersProfiles.Where(e => e.IsActive && e.UserId == userId).OrderByDescending(e => e.ProfileId).Select(e => new { e.EmpId, e.REG_NUMBER }).FirstOrDefault();

                            secuser.REG_NUMBER = Convert.ToString(dataSet.Tables[0].Rows[0]["REG_NUMBER1"]);
                            secuser.REG_NUMBER = parentuserid > 0 ? childcompdata.REG_NUMBER : secuser.REG_NUMBER;
                            secuser.CompanyId =  IsSelf_emp ? (dataSet.Tables[0].Rows[0]["SelfEmpID"] != DBNull.Value ? Convert.ToInt32(dataSet.Tables[0].Rows[0]["SelfEmpID"]) : 0) : (dataSet.Tables[0].Rows[0]["EmpId"] != DBNull.Value ? Convert.ToInt32(dataSet.Tables[0].Rows[0]["EmpId"]) : 0);
                            secuser.CompanyId = parentuserid > 0 ? childcompdata.EmpId : secuser.CompanyId;
                            secuser.ParentId = IsSelf_emp ? (dataSet.Tables[0].Rows[0]["SelfEmpID"] != DBNull.Value ? (int?)Convert.ToInt32(dataSet.Tables[0].Rows[0]["SelfEmpID"]) : null) : (dataSet.Tables[0].Rows[0]["EmpId"] != DBNull.Value ? (int?)Convert.ToInt32(dataSet.Tables[0].Rows[0]["EmpId"]) : null);
                            string? LoginId = Convert.ToString(dataSet.Tables[0].Rows[0]["LoginId"]);
                            var token = _tokenHelper.GenerateToken(userId.ToString(), roleName.ToString(), UserEmail.ToString(), secuser.REG_NUMBER);
                            secuser.DeviceToken = token;
                            response.Data = secuser;
                            Login_Log(secuser.UserId, secuser.CompanyId, secuser.IsSelfEmployed, LoginId);
                            secuser.LogId = _DbContext.LoginLogs.Where(e => e.UserId == secuser.UserId).OrderByDescending(e => e.LogId).Select(e => e.LogId).FirstOrDefault();

                            if (_configuration["IsBEMARegistrationEnabled"] == "0" && logindata.userstts == null)
                            {
                                response.Message = "User account is not active";
                                response.Status = false;
                                response.Statuscode = 400;
                                return BadRequest(response);
                            }
                            if (!isApiConnect)
                            {
                                response.Message = "Login success. with Localy Only" + ConnectionInfom.APIConnectionError(_configuration);
                                response.Status = true;
                                response.Statuscode = 200;
                                return Ok(response);
                            }

                            if (!IsSelf_emp)
                            {
                                response.Message = "Login success.";
                                response.Status = true;
                                response.Statuscode = 200;
                                return Ok(response);
                            }
                            else
                            {
                                response.Message = "Login success.";
                                response.Status = true;
                                response.Statuscode = 200;
                                return Ok(response);

                            }
                        }
                    }
                    else
                    {
                        return BadRequest(response);
                    }
                }
                return BadRequest(response);
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                throw ex;
            }
        }

        [HttpPost("btnNext_Click")]
        [AllowAnonymous]
