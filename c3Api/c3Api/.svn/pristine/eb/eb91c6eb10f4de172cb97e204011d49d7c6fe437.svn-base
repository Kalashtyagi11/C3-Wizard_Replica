        string parentloginuserpassword = null;
        /// <summary>
        /// Login
        /// </summary>
        /// <param name="login"></param>
        /// <returns></returns>
        [HttpPost("Login")]
        [AllowAnonymous]
        public async Task<IActionResult> Login([FromBody] LoginDeails login)
        {
            try
            {
                ResponseModel response = new ResponseModel();
                SecuserResponse secuser = new SecuserResponse();
                DataSet dataSet = new DataSet();
                if ((login.userName.Length == 0) || (login.userPass.Length == 0))
                {
                    response.Message = "Please Enter Username and Password";
                    response.Status = false;
                    response.Statuscode = 422;
                    return BadRequest(response);
                }
                else
                {
                    string Loginid = login.userName;
                    string password = login.userPass;
                    var trimmedPassword = password?.Trim() ?? "";
                    var encryptedPassword = EncryptDecryptPassword.Encrypt(trimmedPassword);

                    var logindata = _DbContext.Secusers
                        .FirstOrDefault(x => x.LoginId == Loginid && x.Password == encryptedPassword);
                    if (logindata == null)
                    {
                        response.Message = "Invalid LoginId or Password";
                        response.Status = false;
                        response.Statuscode = 401;
                        return Unauthorized(response);
                    }

                    SqlConnection con = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString);
                    con.Open();

                    // SqlCommand cmd = new SqlCommand("SELECT * FROM SECUsers WHERE LoginId ='" + Loginid + "'  AND Password ='" + HashPassword.EncodePasswordToBase64(password) + "' and Isactive=1 and status=1", con);
                    SqlCommand cmd;
                    if (logindata.EmpId == 0.ToString())
                    {
                        //cmd = new SqlCommand(" SELECT ld.*,sr.Role,sr.roleCategory,mc.REG_NUMBER as REG_NUMBER,mc.IsLevyExempt,mc.CompanyLogo  FROM SECUsers ld INNER JOIN SECRole sr ON ld.RoleId = sr.RoleId left JOIN mastercompany mc ON (ld.EmpId = mc.Company_Id OR ld.SelfEmpID = mc.Company_Id) WHERE ld.LoginId = '" + Loginid + "' AND ld.Password = '" + EncryptDecryptPassword.Encrypt(password) + "' AND ld.IsActive = 1 AND ld.Status = 1", con);


                        cmd = new SqlCommand("SELECT ld.*, sr.Role, sr.roleCategory, mc.Soc_Sec_Num AS REG_NUMBER " +
                     "FROM SECUsers ld " +
                     "JOIN SECRole sr ON ld.RoleId = sr.RoleId " +
                     "JOIN SelfEmployee mc ON ld.SelfEmpID = mc.EmployeeID " +
                     "WHERE ld.LoginId = '" + Loginid + "' AND ld.Password = '" + EncryptDecryptPassword.Encrypt(password) + "' AND ld.IsActive = 1 AND ld.Status = 1", con);

                    }
                    else
                    {
                        cmd = new SqlCommand(" SELECT ld.*,sr.Role,sr.roleCategory,mc.REG_NUMBER as REG_NUMBER,mc.IsLevyExempt,mc.CompanyLogo  FROM SECUsers ld INNER JOIN SECRole sr ON ld.RoleId = sr.RoleId left JOIN mastercompany mc ON (ld.EmpId = mc.Company_Id OR ld.SelfEmpID = mc.Company_Id) WHERE ld.LoginId = '" + Loginid + "' AND ld.Password = '" + EncryptDecryptPassword.Encrypt(password) + "' AND ld.IsActive = 1 AND ld.Status = 1", con);
                    }

                    cmd.CommandType = CommandType.Text;
                    SqlDataAdapter adapter = new SqlDataAdapter();
                    adapter.SelectCommand = cmd;
                    adapter.Fill(dataSet);
                    con.Close();
                    if (dataSet != null && dataSet.Tables.Count > 0)
                    {
                        if (dataSet.Tables[0].Rows.Count > 1)
                        {
                            response.Message = "We found multiple Records Please contact Administrator";
                            response.Status = false;
                            response.Statuscode = 409;

                            return BadRequest(response);

                        }
                        if (dataSet.Tables[0].Rows.Count == 0)
                        {
                            {
                                // checkUserDetails();
                                if (ConnectionInfom.HasConnection() && _configuration["IsBEMARegistrationEnabled"] == "1" && ConnectionInfom.APIConnection(_configuration))
                                {
                                    //bool userExists = await LoginDetails(Loginid, HashPassword.EncodePasswordToBase64(password));
                                    response = await LoginDetails(Loginid, EncryptDecryptPassword.Encrypt(password));
                                    if ((bool)response.Status)
                                    {
                                        //response.Message = "User registered at server but not at local.  Please try to login with your login credentials from Existing User Login screen.";
                                        //response.Status = false;
                                        //response.Statuscode = 409;
                                        //return BadRequest(response);
                                        SqlCommand cmd1 = new SqlCommand(" SELECT ld.*,sr.Role,mc.REG_NUMBER as REG_NUMBER,mc.IsLevyExempt,mc.CompanyLogo  FROM SECUsers ld INNER JOIN SECRole sr ON ld.RoleId = sr.RoleId left JOIN mastercompany mc ON (ld.EmpId = mc.Company_Id OR ld.SelfEmpID = mc.Company_Id) WHERE ld.LoginId = '" + Loginid + "' AND ld.Password = '" + EncryptDecryptPassword.Encrypt(password) + "' AND ld.IsActive = 1 AND ld.Status = 1", con);
                                        cmd1.CommandType = CommandType.Text;
                                        SqlDataAdapter adapter1 = new SqlDataAdapter();
                                        adapter.SelectCommand = cmd1;
                                        adapter.Fill(dataSet);
                                        con.Close();
                                        if (dataSet != null && dataSet.Tables.Count > 0)
                                        {
                                            if (dataSet.Tables[0].Rows.Count > 1)
                                            {

                                                response.Message = "We found multiple Records Please contact Administrator";
                                                response.Status = false;
                                                response.Statuscode = 409;

                                                return BadRequest(response);

                                            }
                                            if (dataSet.Tables[0].Rows.Count == 0)
                                            {
                                                response.Message = "Invalid user name or password";
                                                response.Status = false;
                                                response.Statuscode = 400;
                                                return BadRequest(response);

                                            }
                                        }

                                        secuser.PUserLoginID = Convert.ToInt32(dataSet.Tables[0].Rows[0]["UserId"]);
                                        string uploadsFolder = Path.Combine(_environment.ContentRootPath, "UserImage");

                                        if (dataSet.Tables[0].Rows[0]["IsLevyExempt"] != DBNull.Value)
                                        {
                                            secuser.IsLevyExempt = Convert.ToBoolean(dataSet.Tables[0].Rows[0]["IsLevyExempt"]);
                                        }
                                        else
                                        {
                                            secuser.IsLevyExempt = false;
                                        }
                                        secuser.UserId = Convert.ToInt32(dataSet.Tables[0].Rows[0]["UserId"]);
                                        var userId = Convert.ToInt32(dataSet.Tables[0].Rows[0]["UserId"]);
                                        var roleName = Convert.ToInt32(dataSet.Tables[0].Rows[0]["RoleId"]);


                                        //string filePath = Path.Combine(Path.Combine(_environment.ContentRootPath, "wwwroot\\MenuList"), "MenuC3.xml");
                                        // var Menu = await _DashBoardRepo.MenuList(roleName);


                                        // secuser.MenuDetails = Menu;
                                        secuser.RoleId = Convert.ToInt32(dataSet.Tables[0].Rows[0]["RoleId"]);
                                        secuser.RoleName = Convert.ToString(dataSet.Tables[0].Rows[0]["Role"]);
                                        secuser.REG_NUMBER = Convert.ToString(dataSet.Tables[0].Rows[0]["REG_NUMBER1"]);
                                        secuser.LoginUserID = Convert.ToInt32(dataSet.Tables[0].Rows[0]["UserId"]);
                                        secuser.profileImage = $"{Request.Scheme}://{Request.Host}/UserImage/{(dataSet.Tables[0].Rows[0]["UserImage"].ToString())}";
                                        secuser.companyLogo = $"{Request.Scheme}://{Request.Host}/CompanyLogo/{(dataSet.Tables[0].Rows[0]["CompanyLogo"].ToString())}";
                                        secuser.User_Name = Convert.ToString(dataSet.Tables[0].Rows[0]["FirstName"]);
                                        secuser.LoginUserEmail = Convert.ToString(dataSet.Tables[0].Rows[0]["EmailId"]);
                                        string UserEmail = Convert.ToString(dataSet.Tables[0].Rows[0]["EmailId"]);
                                        secuser.LoginUserName = Convert.ToString(dataSet.Tables[0].Rows[0]["FirstName"]) + " " + Convert.ToString(dataSet.Tables[0].Rows[0]["LastName"]);
                                        bool IsSelf_emp = dataSet.Tables[0].Rows[0]["IsSelfEmployee"] != null || dataSet.Tables[0].Rows[0]["IsSelfEmployee"] != "" ? Convert.ToBoolean(dataSet.Tables[0].Rows[0]["IsSelfEmployee"]) : false;
                                        secuser.IsSelfEmployed = IsSelf_emp;
                                        secuser.CompanyId = IsSelf_emp ? Convert.ToInt32(dataSet.Tables[0].Rows[0]["SelfEmpID"]) : Convert.ToInt32(dataSet.Tables[0].Rows[0]["EmpId"]);
                                        secuser.ParentId = IsSelf_emp ? Convert.ToInt32(dataSet.Tables[0].Rows[0]["SelfEmpID"]) : Convert.ToInt32(dataSet.Tables[0].Rows[0]["EmpId"]);
                                        string? LoginId = Convert.ToString(dataSet.Tables[0].Rows[0]["LoginId"]);
                                        var token = _tokenHelper.GenerateToken(userId.ToString(), roleName.ToString(), UserEmail.ToString(), secuser.REG_NUMBER);
                                        secuser.DeviceToken = token;
                                        response.Data = secuser;
                                        Login_Log(secuser.UserId, secuser.CompanyId, secuser.IsSelfEmployed, LoginId);
                                        secuser.LogId = _DbContext.LoginLogs.Where(e => e.UserId == secuser.UserId).OrderByDescending(e => e.LogId).Select(e => e.LogId).FirstOrDefault();
                                        if (!IsSelf_emp)
                                        {
                                            response.Message = "Login success.";
                                            response.Status = true;
                                            response.Statuscode = 200;
                                            return Ok(response);
                                        }
                                        else
                                        {
                                            response.Message = "Login success.";
                                            response.Status = true;
                                            response.Statuscode = 200;
                                            return Ok(response);

                                        }
                                    }

                                    else
                                    {

                                        if (isnotverified && !(bool)response.Status)
                                        {
                                            response.Message = "User registered at server but not at local. Please try to login with your login credentials from Existing User Login screen.";
                                            response.Status = false;
                                            response.Statuscode = 409;
                                            return BadRequest(response);
                                        }
                                        else
                                        {
                                            response.Message = response.Message;
                                            response.Status = false;
                                            response.Statuscode = 401;
                                            return BadRequest(response);

                                        }
                                    }
                                }
                            }
                            response.Message = "Sorry! Invalid Username or Password.";
                            response.Status = false;
                            response.Statuscode = 401;
                            return BadRequest(response);

                        }
                    }
                    else
                    {
                        DataRow row = dataSet.Tables[0].Rows[0];
                        int roleId = Convert.ToInt32(row["RoleId"]);
                        if (ConnectionInfom.HasConnection() && _configuration["IsBEMARegistrationEnabled"] == "1" && ConnectionInfom.APIConnection(_configuration) && (roleId != 2 && roleId != 4 && roleId != 1))
                        {
                            response = await LoginDetails(Loginid, EncryptDecryptPassword.Encrypt(password));
                            if ((bool)response.Status)
                            {

                                response.Message = "User registered at server but not at local.  Please try to login with your login credentials from Existing User Login screen.";
                                response.Status = false;
                                response.Statuscode = 400;
                                return BadRequest(response);
                            }
                            else
                            {
                                if (isnotverified && !(bool)response.Status)
                                {
                                    response.Message = "User registered at server but not at local.Please try to login with your login credentials from Existing User Login screen.";
                                    response.Status = false;
                                    response.Statuscode = 400;
                                    return BadRequest(response);
                                }
                            }
                        }
                        response.Message = "Sorry! Invalid Username or Password.";
                        response.Status = false;
                        response.Statuscode = 401;
                        return BadRequest(response);

                    }
                    if (dataSet != null && dataSet.Tables.Count > 0 && dataSet.Tables[0].Rows.Count == 1)
                    {
                        bool res = true;

                        parentuserid = dataSet.Tables[0].Rows[0]["parentuserid"] != DBNull.Value ? Convert.ToInt32(dataSet.Tables[0].Rows[0]["parentuserid"]) : 0;
                        if (parentuserid > 0)
                        {
                            DataSet dataSetPCopany = new DataSet();

                            SqlConnection conCompany = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString);
                            conCompany.Open();
                            SqlCommand cmdpcompany = new SqlCommand("SELECT top 1 * FROM SECUsers WHERE UserId =" + parentuserid + " and Isactive=1 and status=1", con);
