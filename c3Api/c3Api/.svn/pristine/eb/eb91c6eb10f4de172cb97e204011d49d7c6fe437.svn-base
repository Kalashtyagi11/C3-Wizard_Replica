        private async Task<ResponseModel> LoginDetails(string Loginid, string password)
        {
            try
            {
                ResponseModel res = new ResponseModel();
                var log = new LoginDeails();
                log.userName = Loginid;
                log.userPass = password;
                string surl = _configuration["ServiceConfig:ServiceUriString"];
                string sURL = surl + "/User/loginUser";
                var myContent = JsonConvert.SerializeObject(log);
                var buffer = System.Text.Encoding.UTF8.GetBytes(myContent);
                var byteContent = new ByteArrayContent(buffer);
                byteContent.Headers.ContentType = new MediaTypeHeaderValue("application/json");
                HttpMessageHandler handler = new HttpClientHandler()
                {
                };
                var httpClient = new HttpClient(handler)
                {
                    BaseAddress = new Uri(sURL),
                    Timeout = new TimeSpan(0, 2, 0)
                };
                httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");

                //var plainTextBytes = System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + _configuration["ServiceConfig:AuthPass"]);
                var plainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : System.Text.Encoding.UTF8.GetBytes(log.userName + ":" + log.userPass);
                string val = System.Convert.ToBase64String(plainTextBytes);
                httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + val);

                HttpResponseMessage response = httpClient.PostAsync(sURL, byteContent).Result;
                if (response.StatusCode == HttpStatusCode.OK)
                {
                    var customerJsonString = await response.Content.ReadAsStringAsync();
                    var EMP_DetailsModel = JsonConvert.DeserializeObject<EmployerDeailsModule>(customerJsonString);
                    var Emp_model = JsonConvert.DeserializeObject<success>(customerJsonString);
                    //bool res1 = await Sendvarify_code(log.userName, log.userPass);
                    //if (res1)
                    //{
                    //  res.Message = "Verification code sent to registered email.";
                    //  res.Status = true;
                    //  return res;
                    //}
                    SqlConnection con = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString);

                    con.Open();
                    DataSet dataSet1 = new DataSet();
                    SqlCommand cmd1 = new SqlCommand(" SELECT ld.UserId  FROM SECUsers ld INNER JOIN SECRole sr ON ld.RoleId = sr.RoleId left JOIN mastercompany mc ON (ld.EmpId = mc.Company_Id OR ld.SelfEmpID = mc.Company_Id) WHERE ld.LoginId = '" + Loginid + "' AND ld.Password = '" + password + "' AND ld.IsActive = 1 AND ld.Status = 1", con);
                    cmd1.CommandType = CommandType.Text;
                    SqlDataAdapter adapter1 = new SqlDataAdapter();
                    adapter1.SelectCommand = cmd1;
                    adapter1.Fill(dataSet1);
                    con.Close();
                    if (dataSet1 != null && dataSet1.Tables.Count > 0)
                    {
                        if (dataSet1.Tables[0].Rows.Count == 0)
                        {
                            RegisterCompanyVm registerCompanyVm = new RegisterCompanyVm();
                            registerCompanyVm.RegistrationNo = Convert.ToInt32(EMP_DetailsModel.payerId);
                            registerCompanyVm.RegNumber = EMP_DetailsModel.payerId;
                            registerCompanyVm.SocSecNum = EMP_DetailsModel.payerId;
                            registerCompanyVm.FirstName = EMP_DetailsModel.firstName;
                            registerCompanyVm.LastName = EMP_DetailsModel.surName;
                            registerCompanyVm.LastName = EMP_DetailsModel.surName;
                            registerCompanyVm.CompanyName = EMP_DetailsModel.companyName;
                            registerCompanyVm.employmentType = EMP_DetailsModel.employerType;
                            registerCompanyVm.TradeName = EMP_DetailsModel.tradeName;
                            registerCompanyVm.Phone = EMP_DetailsModel.phone;
                            registerCompanyVm.ContactPerson = EMP_DetailsModel.contactName;
                            registerCompanyVm.Mobile = EMP_DetailsModel.mobile;
                            registerCompanyVm.BirthDate = EMP_DetailsModel.dateOfBirth != "" || EMP_DetailsModel.dateOfBirth != null ? DateTime.ParseExact(EMP_DetailsModel.dateOfBirth.ToString(), Helper.DateFormat, CultureInfo.InvariantCulture) : DateTime.Parse("01/01/1900");
                            registerCompanyVm.EmailId = EMP_DetailsModel.email;
                            registerCompanyVm.Address1 = EMP_DetailsModel.address1;
                            registerCompanyVm.Address2 = EMP_DetailsModel.address2;
                            registerCompanyVm.City = EMP_DetailsModel.city;
                            registerCompanyVm.Country = EMP_DetailsModel.country == null || EMP_DetailsModel.country == "" ? "1" : EMP_DetailsModel.country.Contains("Nevis") ? "2" : "1";
                            registerCompanyVm.Zip = EMP_DetailsModel.postalCode;
                            registerCompanyVm.UserName = EMP_DetailsModel.userName;
                            registerCompanyVm.Password = EncryptDecryptPassword.Decrypt(EMP_DetailsModel.passwordHash);
                            registerCompanyVm.Question1 = EMP_DetailsModel.question1;
                            registerCompanyVm.Question2 = EMP_DetailsModel.question2;
                            registerCompanyVm.Answer1 = EMP_DetailsModel.answer1;
                            registerCompanyVm.Answer2 = EMP_DetailsModel.answer2;
                            registerCompanyVm.LoginId = Loginid;
                            registerCompanyVm.UserStatus = EMP_DetailsModel.userStatus;

                            if (EMP_DetailsModel.employerType == "ER")
                            {
                                var companydata = await ValidateRegistration(registerCompanyVm.RegNumber, registerCompanyVm.EmailId);
                                if (companydata is OkObjectResult okResult)
                                {
                                    res = repoRegister.RegisterCompanylocal(registerCompanyVm);
                                }
                            }
                            if (EMP_DetailsModel.employerType == "SE")
                            {
                                var data = _DbContext.MasterCompanies.Where(x => x.RegNumber == registerCompanyVm.SocSecNum).FirstOrDefault();
                                if (data == null)
                                {
                                    int ssn = int.Parse(registerCompanyVm.SocSecNum);
                                    DataSet dataSet = new DataSet();
                                    con.Open();
                                    SqlCommand cmd = new SqlCommand("SELECT * FROM SelfEmployee WHERE Isactive=1 And Soc_Sec_Num=" + ssn, con);
                                    cmd.CommandType = CommandType.Text;
                                    SqlDataAdapter adapter = new SqlDataAdapter();
                                    adapter.SelectCommand = cmd;
                                    adapter.Fill(dataSet);
                                    con.Close();
                                    if (dataSet.Tables[0].Rows.Count == 0)
                                    {
                                        res = repoRegister.RegisterSelfEmployedlocal(registerCompanyVm);
                                    }
                                }

                            }

                        }
                    }

                    res.Status = true;
                    res.Message = Emp_model.message;
                    return res;

                }
                else
                {
                    var customerJsonString = await response.Content.ReadAsStringAsync();
                    var Emp_model = JsonConvert.DeserializeObject<Apistatus>(customerJsonString);

                    if (Emp_model.message != null)
                    {
                        if (parentuserid == 0)
                        {
                            if (Emp_model.message.Contains("User account is not active"))
                            {
                                isnotverified = true;
                                res.Status = false;
                                res.Message = Emp_model.message;
                                return res;
                            }
                            if (Emp_model.message.Contains("More than one user account found"))
                            {

                                string message = Emp_model.message;

                                res.Status = false;
                                res.Message = Emp_model.message;
                                return res;
                            }
                            if (Emp_model.message.Contains("Unauthorized"))
                            {

                                bool IsverifyandRegEmployerDetails = await verifyandRegEmployerDetails(Loginid, password);
                                if (IsverifyandRegEmployerDetails)
                                {
                                    IsverifyandRegEmployer = true;
                                    res.Status = true;
                                    res.Message = Emp_model.message;
                                    return res;
                                }
                                else
                                {

                                    res.Status = false;
                                    res.Message = Emp_model.message;
                                    return res;
                                }
                            }
                        }
                        if (parentuserid > 0)
                        {

                            string message = Emp_model.message.Contains("Unauthorized") ? "Your super admin is not an authorized user, Please contact S.S.B for any assistance." : "Your Super Admin\n" + Emp_model.message;

                            res.Status = false;
                            res.Message = message;
                            return res;
                        }
                    }
                    res.Status = false;
                    res.Message = Emp_model.message;
                    return res;
                }


            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                throw ex;
            }
        }
