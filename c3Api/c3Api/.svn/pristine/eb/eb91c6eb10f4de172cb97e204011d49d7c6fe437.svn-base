                }
            }
            else if (employeerVm.mode == 2)
            {
                try
                {

                    var data1 = _DbContext.Secusers.Where(x => x.EmpId == employeerVm.CompanyId.ToString() && x.UserId == employeerVm.userId).FirstOrDefault();
                    if (data1 != null)
                    {
