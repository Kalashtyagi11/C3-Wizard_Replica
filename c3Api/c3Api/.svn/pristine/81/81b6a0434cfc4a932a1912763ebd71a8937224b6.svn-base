        [HttpPost]
        [Route("SaveUser/UpdateUser")]
        public async Task<IActionResult> SaveUserandUpdateUser([FromForm] UserViewModel userViewModel)
        {
            HashPassword HashPassword = new HashPassword();

            if (userViewModel == null)
            {
                return BadRequest(new ResponseModel
                {
                    Status = false,
                    Message = "Invalid input.",
                    Data = null,
                    Statuscode = 400
                });
            }
            if (_environment == null)
            {
                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = "Server environment not initialized.",
                    Data = null,
                    Statuscode = 500
                });
            }
            string password = "Admin@123";
            string Imagename = null;


            var secuser = new BLSECUsers
            {
                FirstName = userViewModel.FirstName,
                MiddleName = userViewModel.MiddleName,
                LastName = userViewModel.LastName,
                LoginId = userViewModel.LoginId,
                //Password = EncryptDecryptPassword.PasswordAlgorithns.Encrypt(userViewModel.Password.Trim()),
                Password = string.IsNullOrWhiteSpace(userViewModel.Password) ? EncryptDecryptPassword.Encrypt(password) : EncryptDecryptPassword.Encrypt(userViewModel.Password.Trim()),
                //Password = HashPassword.EncodePasswordToBase64(password.Trim()),
                EmailId = userViewModel.EmailId,
                EmpId = 2+"",
                RoleId = userViewModel.UserRole,
                Status = true,
                IsLoggedIn = false,
                IsPPOC = false,

            };

            try
            {
                //if (userViewModel.ProfileImage != null && userViewModel.ProfileImage.Length > 0)
                //{
                //    string applicationPath = AppContext.BaseDirectory;  // Safer way to get the application's base path
                //    string userImageFolder = Path.Combine(applicationPath, "UserImage");

                //    if (!Directory.Exists(userImageFolder))
                //    {
                //        Directory.CreateDirectory(userImageFolder);
                //    }

                //    string fileName = Path.GetFileName(userViewModel.ProfileImage.FileName);
                //    string destinationPath = Path.Combine(userImageFolder, fileName);

                //    using (var fileStream = new FileStream(destinationPath, FileMode.Create))
                //    {
                //        await userViewModel.ProfileImage.CopyToAsync(fileStream);
                //    }

                //    secuser.ProfileImage = fileName;
                //}

                if (userViewModel.UserImage != null && userViewModel.UserImage.Length > 0)
                {
                    string uploadsFolder = Path.Combine(_environment.WebRootPath, "UserImage");
                    Directory.CreateDirectory(uploadsFolder);
                    Imagename = Guid.NewGuid().ToString() + Path.GetExtension(userViewModel.UserImage.FileName);
                    string filePath = Path.Combine(uploadsFolder, Imagename);
                    using (var fileStream = new FileStream(filePath, FileMode.Create))
                    {
                        userViewModel.UserImage.CopyTo(fileStream);
                    }
                    secuser.ProfileImage = Imagename;
                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = $"Error processing the profile image: {ex.Message}",
                    Data = null,
                    Statuscode = 500
                });
            }

            try
            {
                if (userViewModel.mode == 1)
                {

                    bool isUserExist = _context.Secusers.Any(x => x.LoginId == userViewModel.LoginId);

                    if (isUserExist)
                    {
                        return Conflict(new
                        {
                            message = "User Name already exists"
                        });
                    }

                    var res = _context.Secusers.Where(x => x.LoginId == userViewModel.LoginId).FirstOrDefault();
                    if (res == null)
                    {
                        var emaildata = _context.Secusers.Where(x => x.EmailId == userViewModel.EmailId).FirstOrDefault();
                        if (emaildata == null)
                        {
                            secuser.IsSelfEmployee = false;
                            secuser.InsertedBy = userViewModel.CompanyId;
                            secuser.InsertedOn = DateTime.UtcNow;
                            secuser.InsertedMachineInfo = userViewModel.MachineInfo;
                            secuser.IsActive = true;
                            secuser.parentuserid = userViewModel.ParentUserId;
                            secuser.IsPPOC = false;
                            secuser.SaveNew();

                            var dataToken = _context.Secusers.Where(x => x.LoginId == userViewModel.LoginId).FirstOrDefault();
                            dataToken.token = Guid.NewGuid().ToString("N").Substring(0, 8);
                            dataToken.userstts = "A";
                            _context.SaveChanges();
                            return Ok(new ResponseModel
                            {
                                Status = true,
                                Message = "User saved successfully.",
                                Data = secuser,
                                Statuscode = 200
                            });
                        }
                        else
                        {
                            return Conflict(new
                            {
                                message = "User email already exists"
                            });
                        }
                    }
                    {
                        return Conflict(new
                        {
                            message = "User name already exists"
                        });
                    }
                }
                else if (userViewModel.mode == 2)
                {
                    bool isUserExist = _context.Secusers.Any(x => x.LoginId == userViewModel.LoginId && x.UserId != userViewModel.UserId);

                    if (isUserExist)
                    {
                        return Conflict(new
                        {
                            message = "User Name already exists"
                        });
                    }

                    var res = _context.Secusers.Where(x => x.LoginId == userViewModel.LoginId && x.UserId == userViewModel.UserId).FirstOrDefault();
                    if (res != null)
                    {
                        if (res.EmailId != userViewModel.EmailId)
                        {
                            var emaildata = _context.Secusers.Where(x => x.EmailId == userViewModel.EmailId).FirstOrDefault();
                            if (emaildata != null)
                            {
                                return Conflict(new
                                {
                                    message = "User email already exists"
                                });

                            }

                            secuser.UserId = userViewModel.UserId;
                            secuser.parentuserid = userViewModel.ParentUserId;
                            secuser.IsPPOC = false;
                            secuser.IsActive = true;
                            secuser.LoginId = res.LoginId;
                            secuser.UpdatedBy = userViewModel.CompanyId;
                            secuser.UpdatedOn = DateTime.UtcNow;
                            secuser.UpdatedMachineInfo = userViewModel.MachineInfo;
                            secuser.Update();

                            //Userimage = string.IsNullOrEmpty(blList.ElementAt(0).ProfileImage) ? "" : blList.ElementAt(0).ProfileImage.ToString();
                            Userimage = secuser.ProfileImage;
                            string imageUrl1 = $"{Request.Scheme}://{Request.Host}/UserImage/{Userimage}";

                            secuser.ProfileImage = imageUrl1;
                            return Ok(new ResponseModel
                            {
                                Status = true,
                                Message = "User update successfully.",
                                Data = secuser,
                                Statuscode = 200
                            });
                        }
                        secuser.UserId = userViewModel.UserId;
                        secuser.parentuserid = userViewModel.ParentUserId;
                        secuser.IsPPOC = false;
                        secuser.IsActive = true;
                        secuser.LoginId = res.LoginId;
                        secuser.UpdatedBy = userViewModel.CompanyId;
                        secuser.UpdatedOn = DateTime.UtcNow;
                        secuser.UpdatedMachineInfo = userViewModel.MachineInfo;
                        secuser.Update();

                        //Userimage = string.IsNullOrEmpty(blList.ElementAt(0).ProfileImage) ? "" : blList.ElementAt(0).ProfileImage.ToString();
                        Userimage = secuser.ProfileImage;
                        string imageUrl = $"{Request.Scheme}://{Request.Host}/UserImage/{Userimage}";

                        secuser.ProfileImage = imageUrl;
                        return Ok(new ResponseModel
                        {
                            Status = true,
                            Message = "User update successfully.",
                            Data = secuser,
                            Statuscode = 200
                        });

                    }
                    {
                        return Conflict(new
                        {
                            message = "User data not exists"
                        });
                    }
                }
                else
                {
                    return BadRequest(new ResponseModel
                    {
                        Status = false,
                        Message = "Invalid mode.",
                        Data = null,
                        Statuscode = 400
                    });
                }

            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = $"Error saving user: {ex.Message}",
                    Data = null,
                    Statuscode = 500
                });
            }
        }
