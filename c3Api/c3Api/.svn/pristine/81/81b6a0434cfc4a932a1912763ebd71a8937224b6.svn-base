        private string ValidateLoginDetails(string NewPassword, string ConfirmPassword)
        {
            StringBuilder errorMessage = new StringBuilder();

            if (string.IsNullOrEmpty(NewPassword?.Trim()))
            {
                errorMessage.AppendLine("New Password is required.");
            }
            else if (!Regex.IsMatch(NewPassword.Trim(), @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\da-zA-Z]).{8,40}$"))
            {
                //errorMessage.AppendLine("New Password must be between 8 and 40 characters long, contain at least one number, one uppercase letter, and one special character.");
                errorMessage.AppendLine("New Password must be 8-40 characters, with at least one uppercase letter, number, and special character.");
            }
            if (string.IsNullOrEmpty(ConfirmPassword?.Trim()))
            {
                errorMessage.AppendLine("Confirm Password is required.");
            }
            //else if (!Regex.IsMatch(ConfirmPassword.Trim(), @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^\da-zA-Z]).{8,40}$"))
            //{
            //    errorMessage.AppendLine("Confirm Password must be between 8 and 40 characters long, contain at least one number, one uppercase letter, and one special character.");
            //}
            if (NewPassword != ConfirmPassword)
            {
                errorMessage.AppendLine("Confirm Password must be the same as New Password.");
            }
            return errorMessage.ToString().Trim();
        }
        [AllowAnonymous]
        [HttpGet]
        [Route("ResetSendMail")]
        public async Task<IActionResult> ResetSendMail(int UserId)
        {
            ResponseModel response = new ResponseModel();
            var data = _context.Secusers.FirstOrDefault(e => e.UserId == UserId);

            try
            {
                if (data != null)
                {
                    var data1 = _context.MasterCompanies.Where(e => e.CompanyId == Convert.ToInt32(data.EmpId)).FirstOrDefault();

                    var data2 = _context.SelfEmployees.Where(e => e.EmployeeId == Convert.ToInt32(data.SelfEmpId)).FirstOrDefault();



                    var smtpClient = new SmtpClient(_configuration["EmailSettings:SmtpServer"])
                    {
                        Port = int.Parse(_configuration["EmailSettings:Port"]),
                        Credentials = new NetworkCredential(
                                                            _configuration["EmailSettings:SenderEmail"],
                                                            _configuration["EmailSettings:SenderPassword"]
                                                             ),
                        EnableSsl = true
                    };
                    var engine = new RazorLightEngineBuilder()
                      .UseFileSystemProject(Path.Combine(Directory.GetCurrentDirectory(), "wwwroot/Email"))
                      .UseMemoryCachingProvider()
                      .Build();
                    engine.Options.EnableDebugMode = true;
                    //string ResetPasswordUrl = $"{Request.Scheme}://{Request.Host}/ResetPassword";
                    string ResetPasswordUrl = _configuration["weburl"];
                    string encryptedUserId = encryptDecrypt.Encrypt(data.UserId.ToString());
                    //Registred  User  Send Email
                    string subject = "Welcome To C3 Wizard Reset Your Password!";
                    var model = new
                    {
                        Name = data.FirstName + " " + data.LastName,
                        EmailId = data.EmailId,
                        Id = data.UserId,
                        Country = !string.IsNullOrEmpty(data1?.Country) ? data1.Country : data2?.Country,
                        ResetPasswordUrl = $"{ResetPasswordUrl}?id={encryptedUserId}"
                    };
                    string htmlContentCustomer = await engine.CompileRenderAsync("WelcomeCustomerResetMail.cshtml", model);
                    var mail = new MailMessage
                    {
                        From = new MailAddress(_configuration["EmailSettings:SenderEmail"]),
                        Subject = subject,
                        Body = htmlContentCustomer,
                        IsBodyHtml = true
                    };
                    mail.To.Add(data.EmailId);
                    await smtpClient.SendMailAsync(mail);
                    response.Status = true;
                    response.Message = "Password reset email sent to registered email address";
                    response.Statuscode = 200;
                    response.Data = data.UserId;
                    return Ok(response);
                }
                else
                {
                    response.Status = false;
                    response.Message = "Data not Found";
                    response.Statuscode = 404;
                    return BadRequest(response);
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(405, ex.Message);
            }
            return Ok(response);
        }
        [AllowAnonymous]
        [HttpPost]
        [Route("ResetPassword")]
        public async Task<IActionResult> ResetPassword(ResetPasswordViewModel resetPasswordViewModel)
        {
            ResponseModel responsed = new ResponseModel();
            HashPassword HashPassword = new HashPassword();
            string validationMessage = ValidateLoginDetails(resetPasswordViewModel.NewPassword, resetPasswordViewModel.ConfirmPassword);

            if (string.IsNullOrEmpty(validationMessage))
            {
                resetPasswordViewModel.UserId = resetPasswordViewModel.UserId == 0 ? Convert.ToInt32(encryptDecrypt.Decrypt(resetPasswordViewModel.EnUserId)) : resetPasswordViewModel.UserId;

                var res = _context.Secusers.Where(e => e.UserId == resetPasswordViewModel.UserId )?.FirstOrDefault();//&& e.Password == EncryptDecryptPassword.Encrypt(resetPasswordViewModel.NewPassword)

                if (res != null)
                {
                    //Mouse.OverrideCursor = System.Windows.Input.Cursors.Wait;
                    SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                    //Check the user for which password need to reset
                    SqlCommand CurrentCompany = new SqlCommand("SELECT Password,RoleId FROM SecUsers WHERE UserId =" + resetPasswordViewModel.UserId, staticConnection);
                    if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();

                    SqlDataReader dr = CurrentCompany.ExecuteReader();
                    string targetUserPassword = "";
                    string targetUserRoleId = "";
                    while (dr.Read())
                    {
                        targetUserPassword = dr["Password"].ToString();
                        targetUserRoleId = dr["RoleId"].ToString();
                    }
                    staticConnection.Close();

                    //Check the loggedin user
                    SqlCommand LoggedInUserDetails = new SqlCommand("SELECT Password,RoleId FROM SecUsers WHERE UserId =" + resetPasswordViewModel.Id, staticConnection);
                    if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();

                    SqlDataReader drLoggedInUser = LoggedInUserDetails.ExecuteReader();
                    string LoggedInUserPassword = "";
                    string LoggedInUserRole = "";
                    while (drLoggedInUser.Read())
                    {
                        LoggedInUserPassword = drLoggedInUser["Password"].ToString();
                        LoggedInUserRole = drLoggedInUser["RoleId"].ToString();
                    }
                    staticConnection.Close();

