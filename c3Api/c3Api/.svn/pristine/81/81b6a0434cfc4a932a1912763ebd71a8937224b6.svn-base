        [HttpGet]
        [Route("GetUserAuditTrail")]
        public async Task<IActionResult> GetUserAuditTrail(int CompanyId, int RoleId)
        {
            try
            {
                List<BLSECUsers> userlist = new List<BLSECUsers>();
                BLMasterEmployee blemp = new BLMasterEmployee();
                userlist = BLSECUsers.SECUsersCollection_grid(CompanyId).ToList();
                List<C3Header> listDVOC3Header = new List<C3Header>();
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                SqlCommand cmd = new SqlCommand("get_C3Genrated_data", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                DataTable dt = new DataTable();
                sqlAdapter.Fill(dt);
                staticConnection.Close();
                if (dt.Rows.Count > 0)
                {
                    foreach (DataRow row in dt.Rows)
                    {
                        bool locked = Convert.IsDBNull(row["IsUnLocked"]) ? false : bool.Parse(row["IsUnLocked"].ToString());
                        bool isimportedbema = Convert.IsDBNull(row["IsImportFromBEMA"]) ? false : bool.Parse(row["IsImportFromBEMA"].ToString());
                        if (!locked && !isimportedbema)
                        {
                            C3Header Obj = new C3Header();
                            Obj.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : MonthName(row["PERIODD_MONTH"].ToString());
                            Obj.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString();
                            Obj.period_Month = Obj.period_Month + " " + Obj.Period_year;
                            //Obj.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
                            Obj.TOTAL_WAGES = row["TOTAL_WAGES"] == DBNull.Value ? 0.00m : Convert.ToDecimal(row["TOTAL_WAGES"]);
                            //Obj.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_SSCONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString())));
                            Obj.TOTALSSCONTRIBUTIONS = row["TOTAL_SSCONTRIBUTIONS"] == DBNull.Value ? 0.00m : Convert.ToDecimal(row["TOTAL_SSCONTRIBUTIONS"]);
                            //Obj.TOTALLEVYEEEMPLOYEE = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString())));
                            Obj.TOTALLEVYEEEMPLOYEE = row["TOTAL_LEVYEEEMPLOYEE"] == DBNull.Value ? 0.00m : Convert.ToDecimal(row["TOTAL_LEVYEEEMPLOYEE"]);
                            //Obj.TOTALSERVAYANCE = Convert.IsDBNull(row["TOTAL_SERVAYANCE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SERVAYANCE"].ToString())));
                            Obj.TOTALSERVAYANCE = row["TOTAL_SERVAYANCE"] == DBNull.Value ? 0.00m : Convert.ToDecimal(row["TOTAL_SERVAYANCE"]);
                            Obj.C3_SubmittedBy = Convert.IsDBNull(row["C3_SubmittedBy"]) ? 0 : int.Parse(row["C3_SubmittedBy"].ToString());
                            Obj.C3_SubmittedByName = Obj.C3_SubmittedBy > 0 ? userlist.Any(x => x.UserId == Obj.C3_SubmittedBy) ? userlist.FirstOrDefault(x => x.UserId == Obj.C3_SubmittedBy).FirstName : null : null;
                            Obj.C3_SubmittedDate = Convert.IsDBNull(row["C3_SubmittedDate"]) ? null : ((DateTime)row["C3_SubmittedDate"]).ToString("dd-MM-yyyy");
                            Obj.C3_SubmittedDate = Obj.C3_SubmittedDate == "01-01-1900" ? null : Obj.C3_SubmittedDate;
                            Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : ((DateTime)row["Insert_Datetimeinfo"]).ToString("dd-MM-yyyy");
                            Obj.Insert_Datetimeinfo = Obj.Insert_Datetimeinfo == "01-01-1900" ? null : Obj.Insert_Datetimeinfo;
                            Obj.Inserted_By = Convert.IsDBNull(row["Inserted_By"]) ? 0 : int.Parse(row["Inserted_By"].ToString());
                            Obj.Inserted_ByName = Obj.Inserted_By > 0 ? userlist.Any(x => x.UserId == Obj.Inserted_By) ? userlist.FirstOrDefault(x => x.UserId == Obj.Inserted_By).FirstName : null : null;
                            Obj.Modified_On = Convert.IsDBNull(row["Modified_On"]) ? null : ((DateTime)row["Modified_On"]).ToString("dd-MM-yyyy");
                            Obj.Modified_On = Obj.Modified_On == "01-01-1900" ? null : Obj.Modified_On;
                            Obj.Modified_By = Convert.IsDBNull(row["Modified_By"]) ? 0 : int.Parse(row["Modified_By"].ToString());
                            Obj.Modified_ByName = Obj.Modified_By > 0 ? userlist.Any(x => x.UserId == Obj.Modified_By) ? userlist.FirstOrDefault(x => x.UserId == Obj.Modified_By).FirstName : null : null;
                            Obj.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                            Obj.Is_submitted = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                            Obj.IssubmittedShow = (bool)Obj.Is_submitted ? "C3 Submitted" : "C3 Not Submitted";
                            Obj.Issubmittedcolor = (bool)Obj.Is_submitted ? "Black" : "Red";

                            Obj.IssubmittedShowimg = (bool)Obj.Is_submitted ? "/img/RightSine.png" : "/img/close.png";
                            Obj.C3submittedShow = (bool)Obj.Is_submitted ? "Resubmit C3" : "Submit C3";
                            Obj.C3submittedShowimg = (bool)Obj.Is_submitted ? "/Images/restore.png" : "/Images/finalyze20x20.png";
                            var user = Obj.C3_SubmittedBy > 0 ? userlist.Any(x => x.UserId == Obj.C3_SubmittedBy) ? userlist.FirstOrDefault(x => x.UserId == Obj.C3_SubmittedBy) : null : null;

                            listDVOC3Header.Add(Obj);

                        }
                    }

                }
                var list1 = listDVOC3Header.Select(e => new C3HeaderUserManagementVM
                {
                    period = e.period_Month,
                    totalWages = e.TOTAL_WAGES,
                    socialSecurity = e.TOTALSSCONTRIBUTIONS,
                    levy = e.TOTALLEVYEEEMPLOYEE,
                    serverance = e.TOTALSERVAYANCE,
                    schedule = e.Schedule_NO,
                    insertedOn = e.Insert_Datetimeinfo,
                    insertedBy = e.Inserted_ByName,
                    lastModifiedOn = e.Modified_On,
                    lastModifiedBy = e.Modified_ByName,
                    lastSubmittedOn = e.C3_SubmittedDate,
                    lastSubmittedBy = e.C3_SubmittedByName
                }).ToList();

                //return Ok(list1);
                //return Ok(listDVOC3Header);
                //C3EmpUserAuditTrail.ItemsSource = listDVOC3Header;
                //C3EmpUserAuditTrail.SelectedIndex = -1;

                List<C3Header> Director_listDVOC3Header = new List<C3Header>();
                SqlConnection Director_staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection;
                if (Director_staticConnection.State == System.Data.ConnectionState.Closed) Director_staticConnection.Open();
                SqlCommand Director_cmd = new SqlCommand("Get_Director_C3_Genrated_data", staticConnection);
                Director_cmd.CommandType = CommandType.StoredProcedure;
                Director_cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                SqlDataAdapter Director_sqlAdapter = new SqlDataAdapter(Director_cmd);
                DataTable Director_dt = new DataTable();
                Director_sqlAdapter.Fill(Director_dt);
                Director_staticConnection.Close();
                if (Director_dt.Rows.Count > 0)
                {
                    foreach (DataRow row in Director_dt.Rows)
                    {
                        bool locked = Convert.IsDBNull(row["IsUnLocked"]) ? false : bool.Parse(row["IsUnLocked"].ToString());
                        bool isimportedbema = Convert.IsDBNull(row["IsImportFromBEMA"]) ? false : bool.Parse(row["IsImportFromBEMA"].ToString());
                        if (!locked && !isimportedbema)
                        {
                            C3Header Director_Obj = new C3Header();
                            Director_Obj.HeaderID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                            Director_Obj.RegNo = Convert.IsDBNull(row["RegNo"]) ? null : row["RegNo"].ToString();
                            Director_Obj.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : MonthName(row["PERIODD_MONTH"].ToString());
                            Director_Obj.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString();
                            Director_Obj.period_Month = Director_Obj.period_Month + " " + Director_Obj.Period_year;
                            //Director_Obj.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
                            Director_Obj.TOTAL_WAGES = row["TOTAL_WAGES"] == DBNull.Value ? 0.00m : Convert.ToDecimal(row["TOTAL_WAGES"]);
                            //Director_Obj.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_SSCONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString())));
                            Director_Obj.TOTALSSCONTRIBUTIONS = row["TOTAL_SSCONTRIBUTIONS"] == DBNull.Value ? 0.00m : Convert.ToDecimal(row["TOTAL_SSCONTRIBUTIONS"]);
                            //Director_Obj.TOTALLEVYEEEMPLOYEE = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString())));
                            Director_Obj.TOTALLEVYEEEMPLOYEE = row["TOTAL_LEVYEEEMPLOYEE"] == DBNull.Value ? 0.00m : Convert.ToDecimal(row["TOTAL_LEVYEEEMPLOYEE"]);
                            Director_Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString(Helper.DisplayDateFormat);
                            Director_Obj.Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
                            Director_Obj.Is_submitted = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());
                            Director_Obj.C3_IsFinalized = Convert.IsDBNull(row["C3_IsFinalized"]) ? false : bool.Parse(row["C3_IsFinalized"].ToString());
                            Director_Obj.C3_SubmittedBy = Convert.IsDBNull(row["C3_SubmittedBy"]) ? 0 : int.Parse(row["C3_SubmittedBy"].ToString());
                            Director_Obj.C3_SubmittedByName = Director_Obj.C3_SubmittedBy > 0 ? userlist.Any(x => x.UserId == Director_Obj.C3_SubmittedBy) ? userlist.FirstOrDefault(x => x.UserId == Director_Obj.C3_SubmittedBy).FirstName : null : null;
                            Director_Obj.C3_SubmittedDate = Convert.IsDBNull(row["C3_SubmittedDate"]) ? null : ((DateTime)row["C3_SubmittedDate"]).ToString("dd-MM-yyyy");
                            Director_Obj.C3_SubmittedDate = Director_Obj.C3_SubmittedDate == "01-01-1900" ? null : Director_Obj.C3_SubmittedDate;
                            Director_Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : ((DateTime)row["Insert_Datetimeinfo"]).ToString("dd-MM-yyyy");
                            Director_Obj.Insert_Datetimeinfo = Director_Obj.Insert_Datetimeinfo == "01-01-1900" ? null : Director_Obj.Insert_Datetimeinfo;
                            Director_Obj.Inserted_By = Convert.IsDBNull(row["Inserted_By"]) ? 0 : int.Parse(row["Inserted_By"].ToString());
                            Director_Obj.Inserted_ByName = Director_Obj.Inserted_By > 0 ? userlist.Any(x => x.UserId == Director_Obj.Inserted_By) ? userlist.FirstOrDefault(x => x.UserId == Director_Obj.Inserted_By).FirstName : null : null;
                            Director_Obj.Modified_On = Convert.IsDBNull(row["Modified_On"]) ? null : ((DateTime)row["Modified_On"]).ToString("dd-MM-yyyy");
                            Director_Obj.Modified_On = Director_Obj.Modified_On == "01-01-1900" ? null : Director_Obj.Modified_On;
                            Director_Obj.Modified_By = Convert.IsDBNull(row["Modified_By"]) ? 0 : int.Parse(row["Modified_By"].ToString());
                            Director_Obj.Modified_ByName = Director_Obj.Modified_By > 0 ? userlist.Any(x => x.UserId == Director_Obj.Modified_By) ? userlist.FirstOrDefault(x => x.UserId == Director_Obj.Modified_By).FirstName : null : null;
                            Director_Obj.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                            Director_Obj.IssubmittedShow = (bool)Director_Obj.Is_submitted ? "C3 Submitted" : "C3 not Submitted";
                            Director_Obj.Issubmittedcolor = (bool)Director_Obj.Is_submitted ? "Black" : "Red";
                            Director_Obj.IssubmittedShowimg = (bool)Director_Obj.Is_submitted ? "/img/RightSine.png" : "/img/close.png";
                            Director_Obj.C3submittedShow = (bool)Director_Obj.Is_submitted ? "Resubmit C3" : "Submit C3";
                            Director_Obj.C3submittedShowimg = (bool)Director_Obj.Is_submitted ? "/Images/restore.png" : "/Images/finalyze20x20.png";

                            Director_listDVOC3Header.Add(Director_Obj);
                        }
                    }

                    //Director_dashboard_list.ItemsSource = Director_listDVOC3Header;
                    // Director_dashboard_list.SelectedIndex = -1;
                    //return Ok(Director_listDVOC3Header);

                    //return Ok(list2);

                }
                var list2 = Director_listDVOC3Header.Select(e => new C3HeaderUserManagement2listVM
                {
                    period = e.period_Month,
                    totalWages = e.TOTAL_WAGES,
                    levy = e.TOTALLEVYEEEMPLOYEE,
                    dateOfSubmission = e.C3_SubmittedDate,
                    schedule = e.Schedule_NO,
                    insertedOn = e.Insert_Datetimeinfo,
                    insertedBy = e.Inserted_ByName,
                    lastModifiedOn = e.Modified_On,
                    lastModifiedBy = e.Modified_ByName,
                    lastSubmittedOn = e.C3_SubmittedDate,
                    lastSubmittedBy = e.C3_SubmittedByName
                }).ToList();
                var response = new
                {
                    RegularEmployeesSubmittedc3 = list1,
                    NonWorkingDirectorSubmittedc3 = list2
                };
                if ((list1.Count != 0 || list2.Count != 0) && (RoleId == 1 || RoleId == 2))
                {
                    return Ok(response);
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, ex.Message);

            }
            return Ok("Null");
        }



