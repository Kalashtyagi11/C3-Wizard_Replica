        [HttpPost("SaveAboutUs")]
        public async Task<IActionResult> SaveAboutUs([FromBody] AboutUs request)
        {
            if (request == null)
            {
                return BadRequest("Invalid request");
            }

            try
            {
                var formattedDescription = request.Description.Replace("\\n", Environment.NewLine);
                var aboutUs = new AboutUs
                {
                    Id = request.Id,
                    Description = formattedDescription
                };

                _context.AboutUs.Add(aboutUs);
                await _context.SaveChangesAsync();

                return Ok(new ResponseModel
                {
                    Status = true,
                    Message = "Data saved successfully.",
                    Data = aboutUs,
                    Statuscode = 200
                });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, $"Internal server error: {ex.Message}");
            }
        }
        public static int MondaysInMonth(int CmbMonth, int CmbYear)
        {
            int weeks = 0;
            int daysThisMonth = DateTime.DaysInMonth(CmbYear, CmbMonth);
            DateTime beginingOfThisMonth = new DateTime(CmbYear, CmbMonth, 1);
            for (int i = 0; i < daysThisMonth; i++)
                if (beginingOfThisMonth.AddDays(i).DayOfWeek == DayOfWeek.Monday)
                    weeks++;
            return weeks;
        }
        [HttpGet("ImportLastC3")]
        public async Task<IActionResult> ImportLastC3(string email, string password, string companyid, int userid)
        {
            if (!ConnectionInfom.HasConnection() || !ConnectionInfom.APIConnection(_configuration))
            {
                return BadRequest(new { message = "Check your internet connection OR the server may not be responding. Please try again later or contact support." });
            }

            try
            {
                string regn = regno(companyid);
                string baseUrl = _configuration["ServiceConfig:ServiceUriString"];
                string requestUrl = $"{baseUrl}/C3/{regn}/C3Submitted/ER/1,NW";

                using (var httpClient = new HttpClient { Timeout = TimeSpan.FromMinutes(2) })
                {
                    httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                    string credentials = Convert.ToBase64String(_configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : Encoding.UTF8.GetBytes($"{email}:{password}"));
                    httpClient.DefaultRequestHeaders.Add("Authorization", $"Basic {credentials}");

                    HttpResponseMessage response = await httpClient.GetAsync(requestUrl);

                    if (!response.IsSuccessStatusCode)
                    {
                        string errorResponse = await response.Content.ReadAsStringAsync();
                        return StatusCode((int)response.StatusCode, new { message = "Unauthorized fetching data from C3", details = errorResponse });
                    }

                    string jsonString = await response.Content.ReadAsStringAsync();
                    var C3HeaderModel = System.Text.Json.JsonSerializer.Deserialize<c3Header>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                    if (C3HeaderModel == null || C3HeaderModel.payerType != "ER")
                    {
                        return NotFound(new { message = "No valid data found." });
                    }

                    int payMonth = DateTime.ParseExact(C3HeaderModel.period, Helper.DateFormat, CultureInfo.InvariantCulture).Month;
                    int payYear = DateTime.ParseExact(C3HeaderModel.period, Helper.DateFormat, CultureInfo.InvariantCulture).Year;

                    using (SqlConnection conn = C3WizardLayerConn_BaseData.StaticSqlConnection)
                    {
                        await conn.OpenAsync();
                        using (SqlCommand cmd = new SqlCommand("check_Director_C3Created", conn))
                        {
                            cmd.CommandType = CommandType.StoredProcedure;
                            cmd.Parameters.AddWithValue("@Month", payMonth - 1);
                            cmd.Parameters.AddWithValue("@Year", payYear);
                            cmd.Parameters.AddWithValue("@CompanyId", companyid);

                            using (SqlDataAdapter adapter = new SqlDataAdapter(cmd))
                            {
                                DataTable dt = new DataTable();
                                adapter.Fill(dt);

                                if (dt.Rows.Count > 0)
                                {
                                    return Ok(new { message = "C3 data already exists for this period." });
                                }
                            }
                        }
                        await conn.CloseAsync();
                        // Fetching Employee Submission Data
                        string empUrl = $"{baseUrl}/C3/{C3HeaderModel.payerId}/C3Submitted/{payMonth},{payYear},{C3HeaderModel.sequenceNo},{C3HeaderModel.payerType}";

                        using (var empClient = new HttpClient { Timeout = TimeSpan.FromMinutes(2) })
                        {
                            empClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                            empClient.DefaultRequestHeaders.Add("Authorization", $"Basic {credentials}");

                            HttpResponseMessage empResponse = await empClient.GetAsync(empUrl);

                            if (!empResponse.IsSuccessStatusCode)
                            {
                                string empErrorResponse = await empResponse.Content.ReadAsStringAsync();
                                return StatusCode((int)empResponse.StatusCode, new { message = "Error fetching employee submission data", details = empErrorResponse });
                            }

                            string empJsonString = await empResponse.Content.ReadAsStringAsync();
                            var submitC3Model = System.Text.Json.JsonSerializer.Deserialize<submitC3string>(empJsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                            if (submitC3Model == null || submitC3Model.c3Header == null)
                            {
                                return NotFound(new { message = "No employee data found." });
                            }

                            int isLocked = submitC3Model.c3Header.receivedBy != "c3svc" && submitC3Model.c3Header.c3Status == "VAC" ? 1 : 0;
                            decimal totalWages = submitC3Model.nonWorkingDirectorWages?.Sum(w => decimal.Parse(w.wages)) ?? 0;

                            using (SqlCommand insertCmd = new SqlCommand("INSERT INTO PROCESS_C3Header (RegNo, PERIODD_MONTH, PERIOD_YEAR, TOTAL_WAGES, EmployerID, Insert_Datetimeinfo, Is_Locked, UserName) VALUES (@RegNo, @Month, @Year, @Wages, @EmployerID, @InsertDate, @IsLocked, @UserName); SELECT SCOPE_IDENTITY();", conn))
                            {
                                insertCmd.Parameters.AddWithValue("@RegNo", C3HeaderModel.payerId);
                                insertCmd.Parameters.AddWithValue("@Month", payMonth - 1);
                                insertCmd.Parameters.AddWithValue("@Year", payYear);
                                insertCmd.Parameters.AddWithValue("@Wages", totalWages);
                                insertCmd.Parameters.AddWithValue("@EmployerID", companyid);
                                insertCmd.Parameters.AddWithValue("@InsertDate", DateTime.UtcNow);
                                insertCmd.Parameters.AddWithValue("@IsLocked", isLocked);
                                insertCmd.Parameters.AddWithValue("@UserName", submitC3Model.c3Header.submittedByName ?? "Unknown");

                                int C3HeaderId = Convert.ToInt32(await insertCmd.ExecuteScalarAsync());

                                if (C3HeaderId > 0 && submitC3Model.nonWorkingDirectorWages != null)
                                {
                                    foreach (var wage in submitC3Model.nonWorkingDirectorWages)
                                    {
                                        using (SqlCommand insertWagesCmd = new SqlCommand("INSERT INTO Process_Contributions (C3HEADERID, SSN, PERIODD_MONTH, PERIOD_YEAR, WAGES) VALUES (@HeaderId, @SSN, @Month, @Year, @Wages)", conn))
                                        {
                                            insertWagesCmd.Parameters.AddWithValue("@HeaderId", C3HeaderId);
                                            insertWagesCmd.Parameters.AddWithValue("@SSN", wage.ssn);
                                            insertWagesCmd.Parameters.AddWithValue("@Month", payMonth - 1);
                                            insertWagesCmd.Parameters.AddWithValue("@Year", payYear);
                                            insertWagesCmd.Parameters.AddWithValue("@Wages", decimal.Parse(wage.wages));

                                            await insertWagesCmd.ExecuteNonQueryAsync();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                return Ok(new { message = "Data imported successfully" });
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new { message = "An error occurred while processing the request", error = ex.Message });
            }
        }
        private string regno(string companyid)
        {
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            SqlCommand CurrentCompany = new SqlCommand("SELECT mc.Company_Id, mc.REG_NUMBER, mc.Address1, mc.Address2, mc.City, mc.State, mc.ZIP, mc.CompanyLogo, mc.IsLevyExempt, C.Name FROM MasterCompany mc, Country c WHERE mc.Isactive = 1 And mc.Company_Id = " + companyid + " And mc.Country=c.ConId", staticConnection);
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            //  string value = CurrentCompanyId.ExecuteScalar().ToString();
            SqlDataReader dr = CurrentCompany.ExecuteReader();
            string companyid_str = "", RegNo = "", Address = "", CompanyLogo = "";
            while (dr.Read())
            {
                companyid_str = dr["Company_Id"].ToString();
                RegNo = dr["REG_NUMBER"].ToString();
                Address = dr["Address1"].ToString() + " " + dr["City"].ToString() + " " + dr["State"].ToString() + " " + dr["Name"].ToString() + " " + dr["ZIP"].ToString();
                CompanyLogo = dr["CompanyLogo"].ToString();
                //Application.Current.Properties["IsLevyExempt"] = dr["IsLevyExempt"];
                // bool ise = Helper.IsLevyExempt;
            }
            staticConnection.Close();

            return RegNo;
        }
