        [HttpGet]
        [Route("GetAllRoles")]
        public async Task<IActionResult> GetAllRoles()
        {
            try
            {
                var allRoles = new List<AllRoles>();

                // Get roleCategory enum list


                using (SqlConnection connection = new SqlConnection(_configuration.GetConnectionString("DefaultConnection")))
                {
                    using (SqlCommand cmd = new SqlCommand("select * from SECRole", connection))
                    {
                        await connection.OpenAsync();
                        using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                        {
                            while (await reader.ReadAsync())
                            {
                                allRoles.Add(new AllRoles
                                {
                                    RoleId = Convert.ToInt32(reader["RoleId"]),
                                    RoleName = reader["Role"] as string,
                                    Description = reader["Description"] as string,
                                    roleCategory = reader["roleCategory"] as string
                                });
                            }
                        }
                        await connection.CloseAsync();
                    }
                }

                if (allRoles != null && allRoles.Any())
                {

                    var roleCategoryList = Enum.GetValues(typeof(roleCategory))
                         .Cast<roleCategory>()
                         .Select(e => new
                         {
                             Id = e.ToString(),
                             Name = e.ToString(),
                             RoleName = allRoles.Where(x => x.roleCategory == e.ToString()).ToList()
                         }).ToList();

                    return Ok(new ResponseModel
                    {
                        Status = true,
                        Message = "Data retrieved successfully.",
                        Data = new
                        {
                            //RolesFromDb = allRoles,
                            RoleCategories = roleCategoryList
                        },
                        Statuscode = 200

                    });
                }
                else
                {
                    return NotFound(new ResponseModel
                    {
                        Status = false,
                        Message = "No data found.",
                        Data = null,
                        Statuscode = 404
                    });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = $"Internal server error: {ex.Message}",
                    Data = null,
                    Statuscode = 500
                });
            }
        }

        [HttpGet("GetLoggedExceptionsReport")]
        public async Task<IActionResult> GetLoggedExceptionsReport(int pageNumber, int pageSize, DateTime? fromDate, DateTime? toDate)
        {
            try
            {

                var (pagedData, totalRecords, totalPages) = await _c3.GetLoggedExceptionsReportData(pageNumber, pageSize, fromDate, toDate);
                if (pagedData != null && pagedData.Count != 0)
                {
                    return Ok(new
                    {
                        status = true,
                        message = "Data fetched successfully.",
                        totalRecords = totalRecords,
                        currentPage = pageNumber,
                        pageSize = pageSize,
                        totalPages = totalPages,
                        data = pagedData

                    });
                }
                else
                {
                    return BadRequest(new
                    {
                        status = false,
                        msg = "data not found",
                        data = "[]"
                    });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, ex.Message);
            }
        }
