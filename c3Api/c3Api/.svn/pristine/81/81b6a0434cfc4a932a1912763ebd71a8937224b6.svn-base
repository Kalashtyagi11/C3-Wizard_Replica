                //    .ToList();

                //var dateRanges = _context.DeductionsTaxTableDetails
                //  .Join(_context.DeductionsTaxTableHeaders,
                //      detail => detail.TaxHeaderID,
                //      header => header.TaxTabHid,
                //      (detail, header) => new
                //      {
                //        header.TaxTabHid,
                //        header.startDate,
                //        header.endDate
                //      })
                //  .Where(x => x.startDate != null && x.endDate != null)
                //  .Select(x => new
                //  {
                //    value = x.TaxTabHid,
                //    key = $"{x.startDate:dd-MMM-yyyy} - {x.endDate:dd-MMM-yyyy}"
                //  })
                //  .Distinct();


                // var dateRanges = _context.DeductionsTaxTableHeaders
                //.Where(x => x.startDate != null && x.endDate != null)
                //.Select(x => new
                //{
                //  showToYear=_context.DeductionsTaxTableDetails.Any(e=>e.TaxHeaderID==x.TaxTabHid),
                //  value = x.TaxTabHid,
                //  key = $"{x.startDate:dd-MMM-yyyy} - {x.endDate:dd-MMM-yyyy}"
                //})
                //.Distinct();
                var dateRanges = (from header in _context.DeductionsTaxTableHeaders
                                  where header.startDate != null && header.endDate != null
                                  join detail in _context.DeductionsTaxTableDetails
                                      on header.TaxTabHid equals detail.TaxHeaderID into g
                                  select new
                                  {
                                      showToYear = g.Any(),
                                      value = header.TaxTabHid,
                                      key = $"{header.startDate:dd-MMM-yyyy} - {header.endDate:dd-MMM-yyyy}"
                                  })
                           .Distinct()
                           .ToList();


                return dateRanges.OrderBy(e => e.value).ToArray();
            }
            catch (Exception ex)
            {
                return new string[0];
            }
        }
        [HttpGet("GetEmployeesDropDown")]
        public async Task<IActionResult> GetEmployees(int companyid)
        {
            try
            {
                var employees = new List<EmployeeDto>();

                using var connection = new SqlConnection(_configuration.GetConnectionString("DefaultConnection"));
                await connection.OpenAsync();

                string query = @"
            SELECT EmployeeID, Soc_Sec_Num + '(' + Last_Name + ' ' + First_Name + ')' as Name
            FROM MasterEmployee 
            WHERE IsdirectorOnly = 0 AND Isactive = 1 AND CompanyId = @CompanyId";

                using var command = new SqlCommand(query, connection);
                command.Parameters.AddWithValue("@CompanyId", companyid);

                using var reader = await command.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    employees.Add(new EmployeeDto
                    {
                        EmployeeId = reader.GetInt32(0),
                        Name = reader.GetString(1)
                    });
                }
                await connection.CloseAsync();
                return Ok(employees);
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, $"Internal Server Error: {ex.Message}");
            }
        }
