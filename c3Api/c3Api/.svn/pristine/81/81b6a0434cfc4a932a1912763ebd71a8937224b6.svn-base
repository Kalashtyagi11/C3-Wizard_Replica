                //    Helper.mWriteToLog(string.Concat("Inner Message Stack: ", ex.InnerException.StackTrace));
                //}
                //C3WizardMessageBox.Show("C3 Wizard", "Error saving new record: system has detected a data exception.");
            }

            if (filepath != null && secuser.UserId == edituser.userId)
            {
                filepath = null;
                try
                {
                    return Ok(secuser);
                    //if (Imagename != null && Imagename != "")
                    //{
                    //    var applicationPath = System.IO.Path.GetDirectoryName(System.Reflection.Assembly.GetExecutingAssembly().Location);
                    //    var uri = new Uri(applicationPath + "/UserImage/" + Imagename);
