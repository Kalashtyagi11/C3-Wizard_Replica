        [HttpPost("SaveRole")]
        public async Task<ResponseModel> SaveRole([FromBody] SaveroleVm saveroleVm)
        {
            var response = new ResponseModel();

            try
            {
                var secrole = new Secrole
                {
                    Role = saveroleVm.RoleName,
                    Description = saveroleVm.descreption,
                    roleCategory = saveroleVm.RoleCategory,
                    InsertedBy = saveroleVm.CreatedBy,
                    InsertedOn = DateTime.Now,
                    IsActive = true
                };

                _context.Secroles.Add(secrole);
                await _context.SaveChangesAsync();

                response.Status = true;
                response.Statuscode = 200;
                response.Message = "Role saved successfully.";
                response.Data = secrole;
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                response.Status = false;
                response.Statuscode = 500;
                response.Message = $"Error saving role: {ex.Message}";
            }

            return response;
        }
        [HttpPost("UpdateRole")]
        public async Task<IActionResult> UpdateRole([FromBody] SaveroleVm saveroleVm)
        {
            var response = new ResponseModel();

            try
            {
                var data = await _context.Secroles.Where(x => x.RoleId == saveroleVm.RoleId).FirstOrDefaultAsync();
                if (data != null)
                {
                    data.Description = saveroleVm.descreption;
                    data.Role = saveroleVm.RoleName;
                    data.roleCategory = saveroleVm.RoleCategory;
                    _context.Secroles.Update(data);
                    await _context.SaveChangesAsync();

                    return Ok(new ResponseModel
                    {
                        Status = true,
                        Message = "Data Updated successfully.",
                        Data = data,
                        Statuscode = 200
                    });

                }
                else
                {
                    return NotFound(new ResponseModel
                    {
                        Status = false,
                        Message = "No data found.",
                        Data = null,
                        Statuscode = 404

                    });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = $"Internal server error: {ex.Message}",
                    Data = null,
                    Statuscode = 500
                });

            }
        }

