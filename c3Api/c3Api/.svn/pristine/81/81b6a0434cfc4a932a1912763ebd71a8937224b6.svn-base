        [AllowAnonymous]
        [HttpGet]
        [Route("LoggedInHistory")]
        public async Task<IActionResult> LoggedInHistory(int companyId, bool isSelfEmployed, int RoleId, int pageNumber, int pageSize, DateTime? fromDate, DateTime? toDate)
        {
            try
            {
                // Validate page number and page size
                //if (pageNumber < 1) pageNumber = 1;
                //if (pageSize < 1) pageSize = 10;
                if (pageNumber < 0) pageNumber = 0;
                if (pageSize < 1) pageSize = 10;

                // Fetch total records count
                //int totalRecords = BLLoginLog.LoginCollection(companyId, isSelfEmployed).Count();

                // Apply pagination using Skip() and Take()
                //List<BLLoginLog> loginList = BLLoginLog.LoginCollection(companyId, isSelfEmployed)
                //    .Skip((pageNumber - 1) * pageSize)
                //    .Take(pageSize)
                //    .ToList();
                List<BLLoginLog> loginList = BLLoginLog.LoginCollection(companyId, isSelfEmployed).ToList();

                if (fromDate != null)
                {
                    loginList = loginList.Where(e => (!fromDate.HasValue || e.LoginTime >= fromDate.Value)).ToList();
                }

                if (toDate != null)
                {
                    toDate = Convert.ToDateTime(toDate).AddDays(1);
                    loginList = loginList.Where(e => !toDate.HasValue || e.LoginTime <= toDate.Value).ToList();
                }
                //var filteredList = loginList.Where(e => (!fromDate.HasValue || e.LoginTime >= fromDate.Value) &&(!toDate.HasValue || e.LoginTime <= toDate.Value));


                //if (FromDate != null)
                //{
                //    AllRecords = AllRecords.Where(a => a.CreatedOn > FromDate).OrderBy(a => a.EventType).OrderByDescending(a => a.CreatedOn);
                //}
                //if (ToDate != null)
                //{
                //    ToDate = Convert.ToDateTime(ToDate).AddDays(1);
                //    AllRecords = AllRecords.Where(a => a.CreatedOn < ToDate).OrderBy(a => a.EventType).OrderByDescending(a => a.CreatedOn);
                //}

                //.Skip(pageNumber * pageSize).Take(pageSize);
                var totalRecords = loginList.Count();
                var newList = loginList.Skip(pageNumber * pageSize).Take(pageSize);
                if (loginList.Any())
                {
                    return Ok(new ResponseModel
                    {
                        Status = true,
                        Message = "Login logs retrieved successfully.",
                        Data = new
                        {
                            TotalRecords = totalRecords,
                            PageNumber = pageNumber,
                            PageSize = pageSize,
                            TotalPages = (int)Math.Ceiling((double)totalRecords / pageSize),
                            Records = newList
                        },
                        Statuscode = 200
                    });
                }
                else
                {
                    return NotFound(new ResponseModel
                    {
                        Status = false,
                        Message = "No login logs found.",
                        Data = null,
                        Statuscode = 404
                    });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);


                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = $"Internal server error: {ex.Message}",
                    Data = null,
                    Statuscode = 500
                });
            }
        }


        [HttpPost]
        [Route("Logout")]
        [AllowAnonymous]
        public async Task<IActionResult> Logout(int logId)
        {
            try
            {
                var loginLog = await _context.LoginLogs.FindAsync(logId);
                if (loginLog == null)
                {
                    return NotFound(new ResponseModel
                    {
                        Status = false,
                        Message = "Log entry not found.",
                        Data = null,
                        Statuscode = 404
                    });
                }

                // Update LogoutTime
                loginLog.LogoutTime = DateTime.Now;
                await _context.SaveChangesAsync();

                return Ok(new ResponseModel
                {
                    Status = true,
                    Message = "User logged out successfully.",
                    Data = loginLog,
                    Statuscode = 200
                });
            }

            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = $"Internal server error: {ex.Message}",
                    Data = null,
                    Statuscode = 500
                });
            }
        }

        [HttpGet]
        [Route("GetContactList")]
        public async Task<IActionResult> GetContactList(int userId, int companyId)
        {
            try
            {
                var contactUsList = new List<ContactUsListDetails>();

                using (SqlConnection connection = new SqlConnection(_configuration.GetConnectionString("DefaultConnection")))
                {
                    using (SqlCommand cmd = new SqlCommand("Get_ContactUs_List", connection))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.Parameters.AddWithValue("@UserId", userId == 0 ? DBNull.Value : (object)userId);
                        cmd.Parameters.AddWithValue("@CompanyId", companyId == 0 ? DBNull.Value : (object)companyId);

                        await connection.OpenAsync();
                        using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                        {
                            while (await reader.ReadAsync())
                            {
                                contactUsList.Add(new ContactUsListDetails
                                {
                                    CUsId = reader["CUsId"] as int? ?? 0,
                                    UserId = reader["UserId"] as int? ?? 0,
                                    CompanyId = reader["CompanyId"] as int? ?? 0,
                                    RegistrationNo = reader["RegistrationNo"] as string,
                                    EmailId = reader["Emailid"] as string,
                                    Description = reader["Description"] as string,
                                    Year = reader["InsertDate"] == DBNull.Value ? 0 : ((DateTime)reader["InsertDate"]).Year,
                                    InsertDate = reader["InsertDate"] == DBNull.Value
                                        ? null
                                        : ((DateTime)reader["InsertDate"]).ToString("MM/dd/yyyy")
                                });
                            }
                        }
                        await connection.CloseAsync();
                    }
                }
                if (contactUsList != null && contactUsList.Any()) // Check if data exists
                {
                    return Ok(new ResponseModel
                    {
                        Status = true,
                        Message = "Login logs retrieved successfully.",
                        Data = contactUsList,
                        Statuscode = 200
                    });
                }
                else
                {
                    return NotFound(new ResponseModel
                    {
                        Status = false,
                        Message = "No data found.",
                        Data = null,
                        Statuscode = 404
                    });
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, new ResponseModel
                {
                    Status = false,
                    Message = $"Internal server error: {ex.Message}",
                    Data = null,
                    Statuscode = 500
                });
            }
        }
