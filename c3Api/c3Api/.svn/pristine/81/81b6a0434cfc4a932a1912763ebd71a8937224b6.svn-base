        [HttpPost("EditUserProfile")]
        public async Task<IActionResult> EditUserProfile([FromForm] UserImagePost edituser)
        {
            var user = await _context.Secusers.FindAsync(edituser.userId);
            var selfuser = await _context.SelfEmployees.FirstOrDefaultAsync(x => x.EmployeeId == Convert.ToInt32(user.SelfEmpId));
            if (user == null)
            {
                return NotFound("User not found.");
            }
            if (selfuser != null)
            {
                selfuser.FirstName = edituser.firstName;
                selfuser.LastName = edituser.lastName;
                selfuser.Email = edituser.emailId;
                _context.SelfEmployees.Update(selfuser);
                await _context.SaveChangesAsync();
            }
            BLSECUsers secuser = new BLSECUsers();
            secuser.FirstName = edituser.firstName;
            //secuser.MiddleName = edituser.middleName;
            secuser.LastName = edituser.lastName;
            secuser.EmailId = edituser.emailId;
            secuser.RoleId = user.RoleId;
            secuser.Status = user.Status;
            // secuser.EmpId = Helper.UserID.ToString();

            try
            {

                if (edituser.profileImage != null && edituser.profileImage.Length > 0)
                {
                    string uploadsFolder = Path.Combine(_environment.WebRootPath, "UserImage");
                    Directory.CreateDirectory(uploadsFolder);
                    Imagename = Guid.NewGuid().ToString() + Path.GetExtension(edituser.profileImage.FileName);
                    string filePath = Path.Combine(uploadsFolder, Imagename);
                    using (var fileStream = new FileStream(filePath, FileMode.Create))
                    {
                        edituser.profileImage.CopyTo(fileStream);
                    }
                    secuser.ProfileImage = Imagename;
                }
                else
                {
                    secuser.ProfileImage = user.UserImage;
                }
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, ex.Message);
                //Login login = new Login();
                //login.Error_Log(ex.Message);

            }

            secuser.IsLoggedIn = false;
            try
            {
                var res = _context.Secusers.Where(x => x.UserId == edituser.userId).FirstOrDefault();
                if (res != null)
                {
                    if (res.EmailId != edituser.emailId)
                    {
                        var emaildata = _context.Secusers.Where(x => x.EmailId == edituser.emailId).FirstOrDefault();
                        if (emaildata != null)
                        {
                            return Conflict(new
                            {
                                message = "User email already exists"
                            });

                        }
                        secuser.IsActive = true;
                        secuser.UserId = edituser.userId;
                        secuser.parentuserid = edituser.parentUserId;
                        secuser.IsPPOC = edituser.isPPOC;
                        //secuser.UpdatedBy = Helper.CompanyId;
                        secuser.UpdatedOn = DateTime.Now;
                        secuser.UpdatedMachineInfo = Helper.MachineInfo;
                        secuser.Update();

                        List<BLSECUsers> blList1 = new List<BLSECUsers>();
                        blList_ALL = BLSECUsers.SECUsersCollection().ToList();
                        blList1 = blList_ALL.Where(t => t.UserId == secuser.UserId).ToList();

                        Userimage = string.IsNullOrEmpty(blList1.ElementAt(0).ProfileImage) ? "" : blList1.ElementAt(0).ProfileImage.ToString();
                        string imageUrl1 = $"{Request.Scheme}://{Request.Host}/UserImage/{Userimage}";

                        secuser.ProfileImage = imageUrl1;
                        return Ok(new { Message = "Data Update successfully", Data = secuser });
                    }
                    secuser.IsActive = true;
                    secuser.UserId = edituser.userId;
                    secuser.parentuserid = edituser.parentUserId;
                    secuser.IsPPOC = edituser.isPPOC;
                    //secuser.UpdatedBy = Helper.CompanyId;
                    secuser.UpdatedOn = DateTime.Now;
                    secuser.UpdatedMachineInfo = Helper.MachineInfo;
                    secuser.Update();

                    List<BLSECUsers> blList = new List<BLSECUsers>();
                    blList_ALL = BLSECUsers.SECUsersCollection().ToList();
                    blList = blList_ALL.Where(t => t.UserId == secuser.UserId).ToList();

                    Userimage = string.IsNullOrEmpty(blList.ElementAt(0).ProfileImage) ? "" : blList.ElementAt(0).ProfileImage.ToString();
                    string imageUrl = $"{Request.Scheme}://{Request.Host}/UserImage/{Userimage}";

                    secuser.ProfileImage = imageUrl;
                    return Ok(new { Message = "Data Update successfully", Data = secuser });
                }
                else
                {
                    return Conflict(new
                    {
                        message = "User data not exists"
                    });
                }
                //Application.Current.Properties["TextChanged"] = 0;
                // C3WizardMessageBox.Show("C3 Wizard", "User updated successfully.");
            }
            catch (Exception ex)
            {
                var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

                return StatusCode(500, ex.Message);
                //Login login = new Login();
                //login.Error_Log(ex.Message);
                //Helper.mWriteToLog(string.Format("Exception Message at " + System.Reflection.MethodBase.GetCurrentMethod().Name + " Method: {0}", ex.Message));
                //Helper.mWriteToLog(string.Concat("Stack Trace: ", ex.StackTrace));
