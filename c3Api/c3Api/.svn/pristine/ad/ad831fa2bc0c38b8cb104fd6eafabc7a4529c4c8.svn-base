@model dynamic

<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="x-apple-disable-message-reformatting">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Yrsa:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Cabin+Condensed&family=Encode+Sans+Condensed:wght@400;500;600&display=swap" rel="stylesheet">
    <title></title>
    <style>

        body {
            font-family: 'Roboto Condensed', sans-serif !important;
            font-weight: 400 !important;
            font-size: 17px;
            line-height: 1.3;
            color: rgba(0,0,0,.4);
        }
    </style>
</head>
<body style="">

    <center style="width: 100%;">
        <div style="display: none; font-size: 1px;max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all; font-family: sans-serif;">
        </div>
        <div style="max-width: 700px; margin: 0 auto;" class="email-container">
            <!-- BEGIN BODY -->
            <!-- BEGIN BODY -->
            <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: auto;   ;
margin: auto;border: 4px solid #eff3f4;margin-top: 2px !important;">
                <tr>
                    <td valign="top" style="padding: .2em 1em;background-color: #eff3f4;">
                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                            <tbody>
                            </tbody>
                        </table>
                    </td>
                </tr>



                <tr>
                    <td valign="top" style="padding: 1em 1.3em 1rem;">
                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                            <tbody>
                                <tr>
                                    <td width="100%" class="logo" style="text-align: center;">
                                        <img src="https://design.mishainfotech.com/design/amit/c3-wizard6/assets/images/logo-w.png" style="width: 80px;">

                                    </td>


                                </tr>
                                <tr>
                                    <td width="100%" style="color: #262626;">
                                        <h2 style="color: #2a5d84;">Welcome to the Upgraded C3 Wizard Web Portal!</h2>

                                        <p>Dear <strong>@Model.Name</strong>,</p>

                                        <p>Thank you for your continued patronage of the <strong>Social Security Board - C3 Wizard</strong> Web Portal.</p>

                                        <p>We’re excited to inform you that the C3 Wizard has been <strong>upgraded from a Windows application to a modern web portal</strong>, The new portal includes enhanced features, such as the ability to make <strong>online payment for outstanding C3 contributions</strong>.</p>

                                        <p style="margin-bottom: 0px;">
                                            You can access the portal here:
                                            <a href="https://c3wizardweb.digitalnoticeboard.biz" target="_blank" style="color: #2a5d84;">c3wizardweb.digitalnoticeboard.biz</a>
                                        </p>




                                <tr>
                                    <td class="bg_white" style="padding: 0em 0em .2em;color: #262626;">



                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: auto;text-align:left;border-collapse: collapse;width: 100%">


                                            <tbody>
                                                <tr>
                                                    <td colspan="4">
                                                        <h3 style="margin-bottom: 10px;">Your Login Information:</h3>
                                                        <div class="row mb-3" style="    display: -ms-flexbox;display: flex;-ms-flex-wrap: wrap;flex-wrap: wrap;margin-right: 0px;margin-left: 0px;margin-bottom: 15px;">
                                                            <div class="col-md-4" style="    -ms-flex: 0 0 35%;flex: 0 0 35%;max-width: 35%;width: 35%;margin-right: 25px;">
                                                                <div class="border-bottom2" style="    border-bottom: 1px dotted #a6a6a6;text-overflow: ellipsis;text-overflow: ellipsis;white-space: nowrap;overflow: hidden;padding: 5px 0px;font-weight: 400;border-radius: 0px;bottom: 0px;">
                                                                    Username:
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6" style="    -ms-flex: 0 0 55%;flex: 0 0 55%;max-width: 55%;width: 55%;">
                                                                <div class="border-dotted" style=" border-bottom: 1px dotted #a6a6a6;padding: 6px 0px;font-weight: 600;">
                                                                            @Model.LoginId
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row mb-3" style="    display: -ms-flexbox;display: flex;-ms-flex-wrap: wrap;flex-wrap: wrap;margin-right: 0px;margin-left: 0px;margin-bottom: 15px;">
                                                            <div class="col-md-4" style="    -ms-flex: 0 0 35%;flex: 0 0 35%;max-width: 35%;width: 35%;margin-right: 25px;">
                                                                <div class="border-bottom2" style="    border-bottom: 1px dotted #a6a6a6;text-overflow: ellipsis;text-overflow: ellipsis;white-space: nowrap;overflow: hidden;padding: 5px 0px;font-weight: 400;border-radius: 0px;bottom: 0px;">
                                                                    Password:
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6" style="    -ms-flex: 0 0 55%;flex: 0 0 55%;max-width: 55%;width: 55%;">
                                                                <div class="border-dotted" style=" border-bottom: 1px dotted #a6a6a6;padding: 6px 0px;font-weight: 600;">
                                                                            @Model.Password
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <ul style="padding-left: 0px;margin-bottom: 10px;">
                                                            <li style="list-style: none;">
                                                                <em>(Please change your password immediately after your first login.)</em>
                                                            </li>
                                                        </ul>

                                                        <p>If you experience any issues logging in, feel free to contact us:</p>
                                                        <p>
                                                            📧 <a href="mailto:pubinfo@socialsecurity.kn" style="color: #2a5d84;">pubinfo@socialsecurity.kn</a>&nbsp; &nbsp;&nbsp;
                                                            📞  +1 869-465-2535
                                                        </p>
                                                        <br />
                                                        If you experience any difficulties, please email us at eservices@socialsecurity.kn or call us at (869)465-2535

                                                        <br />
                                                        <br />
                                                        <b>Sincerely</b>,
                                                        <br />
                                                        <br />
                                                        Administrator (C3 Remittances)
                                                        <br />

                                                        St. Christopher & Nevis Social Security Board



                                                    </td>
                                                </tr>


                                            </tbody>
                                        </table><br>



                                    </td>
                                </tr>








                    </td>


                </tr>
                </tbody>
            </table>
            </td>
            </tr>


            <tr>
                <td valign="top" style="padding: 0em 1em .4rem;background-color: #eff3f4;">
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                        <tbody>
                            <tr>
                                <td align="left" width="70%">
                                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                                    </table>
                                </td>


                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>

            <!-- end:tr -->
            <!-- 1 Column Text + Button : END -->
            </table>
        </div>
    </center>
</body>
</html>






