    modelBuilder.Entity<AuditLog>(entity =>
    {
      //entity.HasNoKey();
      entity.HasKey(e => e.Id).HasName("PK_AuditLog");
      entity.Property(e => e.Action).HasMaxLength(50);
      entity.Property(e => e.ColumnName).HasMaxLength(50);
      entity.Property(e => e.Controller).HasMaxLength(50);
      entity.Property(e => e.CreatedOn).HasColumnType("smalldatetime");
      entity.Property(e => e.EventType).HasMaxLength(10);
      entity.Property(e => e.Id).ValueGeneratedOnAdd();
      entity.Property(e => e.Ipaddress).HasColumnName("IPAddress");
      entity.Property(e => e.ModifiedOn).HasColumnType("smalldatetime");
      entity.Property(e => e.TableName).HasMaxLength(100);
    });

    modelBuilder.Entity<UserCardDetail>(entity =>
    {
      entity.ToTable("UserCardDetail");

      entity.HasKey(e => e.Id);

      entity.Property(e => e.CardNumber)
            .IsRequired()
            .HasMaxLength(50);
      entity.Property(e => e.UserId)
            .IsRequired()
            .HasMaxLength(50);

      entity.Property(e => e.CardMonthExpiry)
            .IsRequired()
            .HasMaxLength(10);

      entity.Property(e => e.CardHolderName)
            .IsRequired()
            .HasMaxLength(100);

      entity.Property(e => e.CVV)
            .IsRequired()
            .HasMaxLength(10);

      entity.Property(e => e.IsActive);
            

      entity.Property(e => e.InsertedOn)
            .HasDefaultValueSql("GETDATE()");
    });

