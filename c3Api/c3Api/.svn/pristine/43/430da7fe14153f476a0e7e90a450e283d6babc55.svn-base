  partial void OnModelCreatingPartial(ModelBuilder modelBuilder);


  List<string> tablesNames = null;
  public override int SaveChanges()
  {
    using var transaction = Database.BeginTransaction();
    try
    {

      AddAuditLogs();
      foreach (var item in tablesNames.Distinct())
      {
        Database.ExecuteSqlRaw("DISABLE TRIGGER ALL ON " + item);
      }

      var result = base.SaveChanges();

      foreach (var item in tablesNames.Distinct())
      {
        Database.ExecuteSqlRaw("ENABLE TRIGGER ALL ON " + item);
      }

      transaction.Commit();
      tablesNames = null;
      return result;
    }
    catch (Exception ex)
    {
      transaction.Rollback();
      throw;
    }
  }


  public override async Task<int> SaveChangesAsync(CancellationToken cancellationToken = default)
  {
    int result = 0;

    using var transaction = await Database.BeginTransactionAsync();

    try
    {
      await AddAuditLogs();

      foreach (var item in tablesNames.Distinct())
      {
        await Database.ExecuteSqlRawAsync("DISABLE TRIGGER ALL ON " + item);
      }


      result = await base.SaveChangesAsync(cancellationToken);

      foreach (var item in tablesNames.Distinct())
      {
        await Database.ExecuteSqlRawAsync("ENABLE TRIGGER ALL ON " + item);
      }


      await transaction.CommitAsync();
      tablesNames = null;
    }
    catch
    {
      await transaction.RollbackAsync();
      throw;
    }

    return result;
  }

  private async Task AddAuditLogs()
  {
    // List of properties you want to ignore (from BaseEntity)
    var baseEntityProps = new[]
    {
       "Id", "OldSystemId", "CreatedBy", "CreatedOn",
       "ModifiedBy", "ModifiedOn", "SourceData"
       };

    // List of table names to exclude from audit logging
    var excludedTables = new[] { "LoginLog" };

    tablesNames = new List<string>();
    var http = _httpContextAccessor.HttpContext;
    var url = http?.Request.Path + http?.Request.QueryString;
    var ipAddress = http?.Connection.RemoteIpAddress?.ToString();

    var entries = ChangeTracker.Entries()
        .Where(e => e.State == EntityState.Modified || e.State == EntityState.Deleted);

    foreach (var entry in entries)
    {
      var entityType = Model.FindEntityType(entry.Entity.GetType());
      var tableName = entityType?.GetTableName() ?? entry.Entity.GetType().Name;

      // Skip excluded tables
      if (excludedTables.Contains(tableName, StringComparer.OrdinalIgnoreCase))
        continue;

      var primaryKey = entry.Properties.FirstOrDefault(p => p.Metadata.IsPrimaryKey());
      var recordId = Convert.ToInt32(primaryKey?.CurrentValue ?? 0);

      tablesNames.Add(tableName);

      foreach (var prop in entry.Properties)
      {
        var propName = prop.Metadata.Name;

        // Skip base entity properties
        if (baseEntityProps.Contains(propName))
          continue;

        // Only log modified properties in case of modification
        if (entry.State == EntityState.Modified)
        {
          if (!prop.IsModified || Equals(prop.OriginalValue, prop.CurrentValue))
            continue;
        }

        if (entry.State == EntityState.Deleted && prop.OriginalValue == null)
          continue;

        var audit = new AuditLog
        {
          TableName = tableName,
          EventType = entry.State.ToString(),
          CreatedOn = DateTime.Now,
          CreatedBy = Convert.ToInt32(CurrentUserId ?? "0"),
          ModifiedBy = Convert.ToInt32(CurrentUserId ?? "0"),
          ModifiedOn = DateTime.Now,
          IsActive = true,
          SourceData = 1,
          Url = url,
          Ipaddress = ipAddress,
          ColumnName = propName,
          RecordId = recordId
        };

        if (entry.State == EntityState.Modified)
        {
          audit.OldValue = Convert.ToString(prop.OriginalValue);
          audit.NewValue = Convert.ToString(prop.CurrentValue);
        }
        else if (entry.State == EntityState.Deleted)
        {
          audit.OldValue = Convert.ToString(prop.OriginalValue);
        }

        AuditLogs.Add(audit);
      }
    }
  }
}

