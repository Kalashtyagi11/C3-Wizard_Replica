                month = (Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : "" + (int.Parse(row["PERIODD_MONTH"].ToString())));
                year = (Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString());
                self_Obj.HeaderID = Convert.IsDBNull(row["SEC3ID"]) ? 0 : int.Parse(row["SEC3ID"].ToString());
                self_Obj.RegNo = Convert.IsDBNull(row["SSN"]) ? null : row["SSN"].ToString();
