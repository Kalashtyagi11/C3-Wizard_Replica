    /// <summary>
    /// This Methods is used to Submit_C3_Click
    /// </summary>
    /// <param name=""></param>
    /// <returns></returns>
    [HttpPost("Submit_C3_Click")]
    [AllowAnonymous]
    public async Task<IActionResult> Submit_C3_Click(int SSNofEmp, int Headerid, string period_Month, string Period_year, int CompanyId, string UserLoginID, string User_Password, int UserID)
    {
      ResponseModel response = new ResponseModel();

      var IsBEMA_APIs_Integration = _configuration["IsBEMA_APIs_Integration"];
      if (IsBEMA_APIs_Integration == "1")
      {
        if (ConnectionInfom.HasConnection() && ConnectionInfom.APIConnection(_configuration))
        {

          int HeaderID = Headerid;
          string monthname = period_Month;
          int month = MonthNumber(monthname);
          string year = Period_year;


          response = await SubmitselfC3_Click(SSNofEmp, (int)HeaderID, CompanyId, UserLoginID, User_Password, UserID);
          if (response.Status == true)
          {
            return Ok(response);
          }
          else if (response.Statuscode == 401)
          {
            return Unauthorized(response);
          }
          else
          {
            return BadRequest(response);
          }
        }
        else
        {

          int? HeaderID = Headerid;
          string monthname = period_Month;
          int month = MonthNumber(monthname);
          string year = Period_year;
          var exportmodel = await Export_button_Click(year, month, HeaderID);

          return File(exportmodel.bytnew, "application/octet-stream", exportmodel.filsename);

        }
      }
      else
      {
        bool isc3submitted = _context.ProcessSelfEmployedC3s.Any(x => x.Sec3id == Headerid && (bool)x.IsSubmitted == true);
        if (!isc3submitted)
        {
          SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
          SqlCommand updateC3Header = new SqlCommand("Update PROCESS_Self_EmployedC3 set Is_submitted =1 , C3_SubmittedDate='" + DateTime.Now.ToString(Helper.SQLDateFormat) + "', C3_SubmittedBy=" + UserID + " where SEC3ID=" + Headerid, staticConnection);
          if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
          int uprow = updateC3Header.ExecuteNonQuery();
          staticConnection.Close();
          response.Status = true;
          response.Statuscode = 200;
          response.Message = "C3 submitted successfully.";
          return Ok(response);
        }
        else
        {
          response.Status = false;
          response.Statuscode = 400;
          response.Message = "C3 already submitted in SSB.";
          return BadRequest(response);
        }
      }


    }












