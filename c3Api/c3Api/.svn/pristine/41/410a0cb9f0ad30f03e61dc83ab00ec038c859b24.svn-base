    private async Task<ResponseModel> SubmitselfC3_Click(int SSNofEmp, int HeaderId, int CompanyId, string UserLoginID, string User_Password, int UserID, int SEC3ID = 0)
    {
      ResponseModel responseModel = new ResponseModel();
