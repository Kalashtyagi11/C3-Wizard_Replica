    [HttpGet("C3_Setting_Delete_Click")]
    public async Task<ResponseModel> C3_Setting_Delete_Click(int SESId, DateTime? Start_Date, DateTime? End_Date, string? IsLocked)
    {
      ResponseModel response = new ResponseModel();
      int? SES_Id = SESId;
      //string St_Date = Start_Date.ToString();
      //string En_Date = End_Date.ToString();
      DateTime St_Date = Convert.ToDateTime(Start_Date);
      DateTime En_Date = Convert.ToDateTime(End_Date);
      try
      {
        if (_repoSelf.isC3Finilize(St_Date, En_Date))
        {

          //if (C3WizardMessageBox.Show("C3 Wizard", "Do you want to delete this self employed settings details?", MessageBoxButton.YesNo, MessageBoxImage.Warning) == MessageBoxResult.No)

          //if (selfEmployed.UserMessage)
          //{
          //    response.Status = false;
          //    response.Message = "User has decided not to delete the settings.";
          //    return response;
          //}
          //else
          //{
          //string DateFormat = "dd-MM-yyyy HH:mm:ss";
          if (IsLocked != "True")
          {

            DateTime? item_st_Date = St_Date == null ? (DateTime?)null : St_Date;

            DateTime? item_en_Date = En_Date == null ? (DateTime?)null : En_Date;
            //DateTime? item_st_Date = string.IsNullOrEmpty(St_Date) ? null: (DateTime?)DateTime.ParseExact(St_Date, Helper.SQLDateFormat, System.Globalization.CultureInfo.InvariantCulture);
            //DateTime? item_en_Date = string.IsNullOrEmpty(En_Date)? null: (DateTime?)DateTime.ParseExact(En_Date, Helper.SQLDateFormat, System.Globalization.CultureInfo.InvariantCulture);

            SqlCommand cmd = null;
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            cmd = new SqlCommand("DeleteSelfSettingDetails", staticConnection);
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add(new SqlParameter("@SESId", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)SESId ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@From_date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)item_st_Date ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@To_date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)item_en_Date ?? (object)DBNull.Value));
            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);

            DataTable dt = new DataTable();
            sqlAdapter.Fill(dt);

            response.Status = true;
            response.Statuscode = 200;
            response.Message = "Data Deleted Successfully!";
            return response;
            //Get_Master_Self_Employed_Settings();
          }
          // }
        }
        else
        {

          response.Status = false;
          response.Statuscode = 409;
          response.Message = "C3 Wizard,Self Employed Settings already used \n You can not delete this self employed settings";
          return response;

        }
      }
      catch (Exception ex)
      {
        var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
        LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
        response.Status = false;
        response.Statuscode = 500;
        response.Message = ex.Message;
        return response;

      }


      return responseModel;

    }





    string SSNofEmp;
    string pendingempc3 = "";
    bool directorc = true;
    string dsmonth = null, dsyear = null;
    decimal Director_total_con = 0;
    decimal unpaidSelf = 0;
    /// <summary>
    /// This Methods is used to load_dashboard
    /// </summary>
    /// <param name=""></param>
    /// <returns></returns>
    [HttpGet("load_dashboard")]
    [AllowAnonymous]
    public async Task<IActionResult> load_dashboard(int CompanyId, int? MonthF, int? MonthTO, string? Year, string? endYear)
    {
      int? StartMonths = null;
      int? endMonths = null;

      // 1. FromMonth >= and ToMonth is null
      if (MonthF != null && MonthF > 0 && (MonthTO == null || MonthTO <= 0))
      {
        StartMonths = MonthF;
        endMonths = null; // No upper bound
      }
      // 2. FromMonth >= and ToMonth <=
      else if (MonthF != null && MonthF > 0 && MonthTO != null && MonthTO > 0)
      {
        StartMonths = MonthF;
        endMonths = MonthTO;
      }
      // 3. FromMonth is null and ToMonth <=
      else if ((MonthF == null || MonthF <= 0) && MonthTO != null && MonthTO > 0)
      {
        StartMonths = null;
        endMonths = MonthTO;
      }
      // 4. FromMonth is null and ToMonth is null
      else if ((MonthF == null || MonthF <= 0) && (MonthTO == null || MonthTO <= 0))
      {
        StartMonths = null;
        endMonths = null;
      }
      int? StartYear = null;
      int? EndYear = null;

      // --- Year Logic ---
      if (Year != null && Convert.ToInt32(Year) > 0 && (endYear == null || Convert.ToInt32(endYear) <= 0))
      {
        StartYear = Convert.ToInt32(Year);
        EndYear = null;
      }
      else if (Year != null && Convert.ToInt32(Year) > 0 && endYear != null && Convert.ToInt32(endYear) > 0)
      {
        StartYear = Convert.ToInt32(Year);
        EndYear = Convert.ToInt32(endYear);
      }
      else if ((Year == null || Convert.ToInt32(Year) <= 0) && endYear != null && Convert.ToInt32(endYear) > 0)
      {
        StartYear = null;
        EndYear = Convert.ToInt32(endYear);
      }
      else if ((Year == null || Convert.ToInt32(Year) <= 0) && (endYear == null || Convert.ToInt32(endYear) <= 0))
      {
        StartYear = null;
        EndYear = null;
      }

      SelfDashboardVm selfDashboard = new SelfDashboardVm();
      ResponseModel response = new ResponseModel();

      List<BLSelfEmployed> emplist = BLSelfEmployed.SelfEmployedCollection().ToList();
      emplist = emplist.Where(x => x.EmployeeID == CompanyId).ToList();
      SSNofEmp = emplist.Count > 0 ? emplist.FirstOrDefault().SocSecNum : null;

      dashboarddata da = new dashboarddata();

      DateTime NowDate = DateTime.Now;
      int curmonth = NowDate.AddMonths(-1).Month;
      int curyear = NowDate.AddMonths(-1).Year;
      DateTime startDate = new DateTime(curyear, curmonth, 1);
      DateTime endDate = startDate.AddMonths(2).AddDays(-6);
      bool IsLastmonthEMPC3Submitted = false;
      SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
      if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
      List<C3Header> Director_listDVOC3Header = new List<C3Header>();
      SqlConnection Director_staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection;
      SqlCommand Director_cmd = new SqlCommand("Get_PROCESS_Self_Employed_C3_Genrated_data", staticConnection);
      Director_cmd.CommandType = CommandType.StoredProcedure;
      Director_cmd.Parameters.Add(new SqlParameter("@SSN", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)SSNofEmp ?? (object)DBNull.Value));
      SqlDataAdapter Director_sqlAdapter = new SqlDataAdapter(Director_cmd);
      DataTable Director_dt = new DataTable();
      Director_sqlAdapter.Fill(Director_dt);
      staticConnection.Close();
      if (Director_dt.Rows.Count > 0)
      {
        int D3count = 0;
        int Pendingc3count = 0;
        foreach (DataRow row in Director_dt.Rows)
        {
          bool issubmited = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());
          D3count++;
          string period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? null : _repoSelf.MonthName(row["PERIODD_MONTH"].ToString());
          string Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? null : row["PERIOD_YEAR"].ToString();
          if (!issubmited)
          {
            Pendingc3count++;
            pendingempc3 = pendingempc3 + " " + period_Month + " " + Period_year + ",";
          }



          if (issubmited && period_Month == _repoSelf.MonthName((startDate.Month).ToString()) && Period_year == startDate.Year.ToString())
          {
            IsLastmonthEMPC3Submitted = true;
          }

          if (D3count <= 12)
          {

            bool isfinalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
            if (true)
            {
              C3Header Director_Obj = new C3Header();
              Director_Obj.HeaderID = Convert.IsDBNull(row["SEC3ID"]) ? 0 : int.Parse(row["SEC3ID"].ToString());
              Director_Obj.RegNo = Convert.IsDBNull(row["SSN"]) ? null : row["SSN"].ToString();
              Director_Obj.p_Month = Convert.ToInt32(row["PERIODD_MONTH"].ToString());
              Director_Obj.period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == string.Empty ? null : _repoSelf.MonthName(row["PERIODD_MONTH"].ToString());
              Director_Obj.Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == string.Empty ? null : row["PERIOD_YEAR"].ToString();
              Director_Obj.p_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? 0 : int.Parse(row["PERIODD_MONTH"].ToString());
              Director_Obj.TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString())));
              Director_Obj.TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_CONTRIBUTIONS"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_CONTRIBUTIONS"].ToString())));
              Director_Obj.TOTALSSPENALTY = Convert.IsDBNull(row["TOTAL_Fine"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["TOTAL_Fine"].ToString());
              Director_Obj.Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"]) ? null : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString(Helper.DisplayDateFormat);
              Director_Obj.Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString());
              Director_Obj.Is_submitted = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString());
              Director_Obj.C3_IsFinalized = Convert.IsDBNull(row["C3_IsFinalized"]) ? false : bool.Parse(row["C3_IsFinalized"].ToString());
              Director_Obj.C3_IsFinalized = !Director_Obj.C3_IsFinalized;
              Director_Obj.IssubmittedShow = (bool)Director_Obj.Is_submitted ? "C3 Submitted" : "C3 Not Submitted";
              Director_Obj.Issubmittedcolor = (bool)Director_Obj.Is_submitted ? "Black" : "Red";
              Director_Obj.IssubmittedShowimg = (bool)Director_Obj.Is_submitted ? "/img/RightSine.png" : "/img/close.png";
              Director_Obj.C3submittedShow = (bool)Director_Obj.Is_submitted ? "Resubmit C3" : "Submit C3";
              Director_Obj.C3submittedShowimg = (bool)Director_Obj.Is_submitted ? "/Images/restore.png" : "/Images/finalyze20x20.png";
              //Director_Obj.IsPaid = _context.OnlinePayments.Any(e => e.C3HeaderId == Director_Obj.HeaderID && e.PaymentStatus == "AUTHORIZED");
              // Director_Obj.IsPaid = _context.OnlinePayments.Any(e => e.C3HeaderId == Director_Obj.HeaderID && (e.PaymentStatus == "AUTHORIZED" || e.PaymentStatus == "Offline Payment"));

              var Paymentdetails = _context.OnlinePayments.Where(e => e.C3HeaderId == Director_Obj.HeaderID && e.IsActive && e.TransactionFor == "Self").OrderByDescending(f => f.Id).Select(r => new { r.PaymentStatus });
              Director_Obj.IsPaid = Paymentdetails.Any(e => e.PaymentStatus == "AUTHORIZED" || e.PaymentStatus == "Offline Payment");
              Director_Obj.IsPaidStatus = Paymentdetails?.FirstOrDefault()?.PaymentStatus;
                            Director_Obj.Notes = Convert.IsDBNull(row["Notes"]) ? null : row["Notes"].ToString();
                            Director_Obj.IsImportFromBEMA = bool.Parse(row["IsImportFromBEMA"].ToString());
              Director_listDVOC3Header.Add(Director_Obj);
              // if (directorc || (dsmonth == Director_Obj.period_Month && dsyear == Director_Obj.Period_year))
              if (Director_Obj.IsPaid)
              {
                selfDashboard.SelfEmployeeContributionText = _repoSelf.MonthName(row["PERIODD_MONTH"].ToString()) + " Self Employed Contribution";


                Director_total_con += Director_Obj.TOTALSSCONTRIBUTIONS + Director_Obj.TOTALLEVYEEEMPLOYEE + Director_Obj.TOTALSSPENALTY;
                directorc = false;
                dsmonth = dsmonth == null ? Director_Obj.period_Month : dsmonth;
                dsyear = dsyear == null ? Director_Obj.Period_year : dsyear;
              }
              else if (Director_Obj.IsImportFromBEMA)
              {

              }
              else
              {
                unpaidSelf += Director_Obj.TOTALSSCONTRIBUTIONS + Director_Obj.TOTALLEVYEEEMPLOYEE + Director_Obj.TOTALSSPENALTY;
              }
            }
          }
        }
        selfDashboard.Director_total_con = "$" + Director_total_con;
        selfDashboard.unpaidSelf = "$" + unpaidSelf;
        selfDashboard.paidMonths = string.Join(" ,", string.Join(" ,", Director_listDVOC3Header.Where(e => e.IsPaid && e.IsImportFromBEMA == false).Select(e => e.period_Month).Distinct()));
        selfDashboard.unpaidMonths = string.Join(" ,", string.Join(" ,", Director_listDVOC3Header.Where(e => !e.IsPaid && e.IsImportFromBEMA == false).Select(e => e.period_Month).Distinct()));

        var data = Director_listDVOC3Header.Select(e => new dashboarddata
        {
          year = e.Period_year,
          month = e.period_Month,
          monthNo = e.p_Month,
          TotalWages = e.TOTAL_WAGES,
          Countribution = e.TOTALSSCONTRIBUTIONS,
          CreationDate = e.Insert_Datetimeinfo,
          HeaderId = e.HeaderID,
          Ssnemp = e.RegNo,
          TOTALSSPENALTY = e.TOTALSSPENALTY,
          Is_submitted = e.Is_submitted,
          ispaid = e.IsPaid,
          IsImportFromBEMA = e.IsImportFromBEMA,
          payAmt = e.TOTALSSCONTRIBUTIONS + e.TOTALSSPENALTY,
          payReason = e.IsPaidStatus,
          Notes=e.Notes
        });

        DateTime? startDate0 = null;
        DateTime? endDate0 = null;

        if (StartYear != null)
        {
          if (StartMonths != null)
            startDate0 = new DateTime(StartYear.Value, StartMonths.Value, 1);
          else
            startDate0 = new DateTime(StartYear.Value, 1, 1); // Defaults to Jan if month missing
        }

        // Rule: Determine End Date (show until this point)
        if (EndYear != null)
        {
          if (endMonths != null)
            endDate0 = new DateTime(EndYear.Value, endMonths.Value, DateTime.DaysInMonth(EndYear.Value, endMonths.Value));
          else
            endDate0 = new DateTime(EndYear.Value, 12, 31); // Defaults to Dec if month missing
        }

        // --- DVOC3Header Filtering ---
        if (data != null)
        {
          data = data.AsEnumerable();

          if (startDate0 != null || endDate0 != null)
          {
            data = data.Where(p =>
            {
              int year = Convert.ToInt32(p.year);
              int month = Convert.ToInt32(p.monthNo);
              DateTime periodDate = new DateTime(year, month, 1);

              return (!startDate0.HasValue || periodDate >= startDate0.Value) &&
     (!endDate0.HasValue || periodDate <= endDate0.Value);
            }).ToList();
          }
        }

        selfDashboard.Dashboardddata = data.ToList();

        //if (selfDashboard != null)
        //{
        //    response.Message = "Data Retrieved Successfully!";
        //    response.Status = true;
        //    response.Statuscode = 200;
        //    response.Data = selfDashboard;
        //}
        //else
        //{
        //    response.Message = "Data Not Found";
        //    response.Status = false;
        //    response.Statuscode = 404;
        //    response.Data = null;
        //}
        selfDashboard.Pendingc3Text = Pendingc3count + " Self Employed Remittance(s) not submitted to SSB";

        return Ok(new ResponseModel { Status = true, Message = "data found", Data = selfDashboard });




      }
      else
      {


        response.Message = 0 + " Self Employed Remittance(s) not submitted to SSB  ";
        response.Statuscode = 404;
        response.Status = false;


      }
      //if (!Helper.IsPendingc3MessageNeedtoshow)
      if (!selfDashboard.IsPendingc3MessageNeedtoshow)
      {

        //Application.Current.Properties["IsPendingc3MessageNeedtoshow"] = true;
        string message = pendingempc3 != "" ? pendingempc3 + " C3 remittance(s) pending \n" : "";
        if (!IsLastmonthEMPC3Submitted)
        {
          if (endDate <= DateTime.Now)
          {
            message = !IsLastmonthEMPC3Submitted ? _repoSelf.MonthName((startDate.Month).ToString()) + " " + startDate.Year.ToString() + " C3 remittance(s) pending" : "";

          }
        }
        message = message != "" ? message + "\nPlease verify and submit." : "";
        if (message != "")
        {
          // C3WizardMessageBox.Show("C3 Wizard", message);
          response.Message = 0 + "C3 Wizard, message ";
          // response.Statuscode = 404;
          //response.Status = false;

        }

      }

      return Ok(response);


    }


