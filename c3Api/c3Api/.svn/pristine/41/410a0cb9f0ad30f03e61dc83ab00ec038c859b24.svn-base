                C3Header self_Obj = new C3Header();
                C3HEADERID = Convert.IsDBNull(row["SEC3ID"]) ? 0 : int.Parse(row["SEC3ID"].ToString());
                Objbulk.c3Status = "PEN";
                Objbulk.numberEmployed = 0;
                sequenceNo = 1;
                sequenceNo = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
