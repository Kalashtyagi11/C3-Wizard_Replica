    /// <summary>
    /// SelfEmployee
    /// </summary>
    /// <param name="selfEmployeeid"></param>
    /// <returns></returns>
    [HttpGet("SelfEmployeeGet")]
    public async Task<ResponseModel> SelfEmployeeGet(int selfEmployeeid)
    {
      GetSelfEmployeeVM getSelfEmployee = new GetSelfEmployeeVM();

      ResponseModel response = new ResponseModel();
      //LoadCountry();
      //LoadCategory();
      SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
      List<BLSelfEmployed> blempList = new List<BLSelfEmployed>();
      //blemp.EmployeeID = param;
      var blempList_ALL = BLSelfEmployed.SelfEmployedCollection().ToList();
      blempList = blempList_ALL.Where(t => t.EmployeeID == selfEmployeeid).ToList();
      if (blempList.Count == 1)
      {
        getSelfEmployee.SocSecNum = string.IsNullOrEmpty(blempList.ElementAt(0).SocSecNum) ? "" : blempList.ElementAt(0).SocSecNum.ToString();
        getSelfEmployee.Tin = string.IsNullOrEmpty(blempList.ElementAt(0).Tin) ? "" : blempList.ElementAt(0).Tin.ToString();
        getSelfEmployee.LastName = string.IsNullOrEmpty(blempList.ElementAt(0).LastName) ? "" : blempList.ElementAt(0).LastName.ToString();
        getSelfEmployee.FirstName = string.IsNullOrEmpty(blempList.ElementAt(0).FirstName) ? "" : blempList.ElementAt(0).FirstName.ToString();
        getSelfEmployee.MiddleName = string.IsNullOrEmpty(blempList.ElementAt(0).MiddleName) ? "" : blempList.ElementAt(0).MiddleName.ToString();
        getSelfEmployee.Address1 = string.IsNullOrEmpty(blempList.ElementAt(0).Address1) ? "" : blempList.ElementAt(0).Address1.ToString();
        getSelfEmployee.Address2 = string.IsNullOrEmpty(blempList.ElementAt(0).Address2) ? "" : blempList.ElementAt(0).Address2.ToString();
        getSelfEmployee.City = string.IsNullOrEmpty(blempList.ElementAt(0).City) ? "" : blempList.ElementAt(0).City.ToString();
        //statename = string.IsNullOrEmpty(blempList.ElementAt(0).State) ? "" : blempList.ElementAt(0).State.ToString();
        getSelfEmployee.Zip = string.IsNullOrEmpty(blempList.ElementAt(0).Zip) ? "" : blempList.ElementAt(0).Zip.ToString();
        try
        {
          getSelfEmployee.Country = blempList.ElementAt(0).Country != null ? int.Parse(blempList.ElementAt(0).Country.ToString()) : -1;
        }
        catch (Exception ex)
        {
          var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
          LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
          throw ex;
        }
        getSelfEmployee.Email = string.IsNullOrEmpty(blempList.ElementAt(0).Email) ? "" : blempList.ElementAt(0).Email.ToString();
        getSelfEmployee.Phone = string.IsNullOrEmpty(blempList.ElementAt(0).Phone) ? "" : blempList.ElementAt(0).Phone.ToString();
        getSelfEmployee.Mobile = string.IsNullOrEmpty(blempList.ElementAt(0).Mobile) ? "" : blempList.ElementAt(0).Mobile.ToString();
        getSelfEmployee.EmployeeId = blempList.ElementAt(0).EmployeeID ?? 0;

        try
        {
          getSelfEmployee.BirthDate = blempList.ElementAt(0).BirthDate;

        }
        catch (Exception ex)
        {
          var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
          LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
          throw ex;
        }

        try
        {
          string gender = string.IsNullOrEmpty(blempList.ElementAt(0).Gender) ? "" : blempList.ElementAt(0).Gender;
          if (gender == "M") { getSelfEmployee.rblgender = true; }
          if (gender == "F") { getSelfEmployee.rblgender = false; }
        }
        catch (Exception ex)
        {
          var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
          LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
          throw ex;
        }

        try
        {
          getSelfEmployee.MaritalStat = blempList.ElementAt(0).MaritalStat != null ? blempList.ElementAt(0).MaritalStat.ToString() == "S" ? "Single" : (blempList.ElementAt(0).MaritalStat.ToString() == "M" ? "Married" : "") : "";
        }
        catch (Exception ex)
        {
          var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
          LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
          throw ex;
        }
        getSelfEmployee.Occupation = blempList.ElementAt(0).occupation;
        getSelfEmployee.Category_Type = int.Parse(blempList.ElementAt(0).Category_Type.ToString());
        //try
        //{
        //    cmbIncomeCategory.IsEnabled = blempList.ElementAt(0).IswageCategoryfromAPI != null ? !(bool)blempList.ElementAt(0).IswageCategoryfromAPI : false;
        //}
        //catch (Exception ex)
        //{

        //}

        SqlCommand CurrentCompany = new SqlCommand("SELECT UserId ,CompanyId ,UserName,RegistrationNo,CompanyName,Question1,Question2,Answer1,Answer2  FROM SecurityQuestionAnswer where CompanyId =  " + blempList.ElementAt(0).EmployeeID + " And RegistrationNo =" + Convert.ToInt32(blempList.ElementAt(0).SocSecNum), staticConnection);
        if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();

        SqlDataReader dr = CurrentCompany.ExecuteReader();
        string Question1 = "", Question2 = "", Answer1 = "", Answer2 = "";
        while (dr.Read())
        {
          Question1 = dr["Question1"].ToString();
          Question2 = dr["Question2"].ToString();
          Answer1 = dr["Answer1"].ToString();
          Answer2 = dr["Answer2"].ToString();
        }
        staticConnection.Close();

        getSelfEmployee.Question1 = Question1;
        getSelfEmployee.Question2 = Question2;
        getSelfEmployee.Answer1 = Answer1;
        getSelfEmployee.Answer2 = Answer2;
        var data = _context.Secusers.Where(e => e.SelfEmpId == selfEmployeeid.ToString()).FirstOrDefault();
        getSelfEmployee.LoginId = data.LoginId;

        response.Data = getSelfEmployee;
        response.Status = true;
        response.Statuscode = 200;
        response.Message = "Data Retrived successfully!";


      }
      return response;
    }

    /// <summary>
    /// This Methods is used to add Save_Employee
    /// </summary>
    /// <param name=""></param>
    /// <returns></returns>
    [HttpPost("Update_SelfEmployee")]
    public async Task<IActionResult> Update_SelfEmployee([FromBody] GetSelfEmployeeVM employeeVM)
    {
      try
      {
        var selfuser = await _context.Secusers.FirstOrDefaultAsync(x => x.SelfEmpId == employeeVM.EmployeeId.ToString());

        if (selfuser != null)
        {
          if (selfuser.EmailId != employeeVM.Email)
          {
            //var emaildata = _context.Secusers.Where(x => x.EmailId == employeeVM.Email).FirstOrDefault();
            //if (emaildata != null)
            //{
            //  return Conflict(new
            //  {
            //    message = "User email already exists"
            //  });

            //}
            selfuser.FirstName = employeeVM.FirstName;
            selfuser.LastName = employeeVM.LastName;
            selfuser.EmailId = employeeVM.Email;
            _context.Secusers.Update(selfuser);
            await _context.SaveChangesAsync();
          }
          selfuser.FirstName = employeeVM.FirstName;
          selfuser.LastName = employeeVM.LastName;
          selfuser.EmailId = employeeVM.Email;
          _context.Secusers.Update(selfuser);
          await _context.SaveChangesAsync();
        }
        else
        {
          return Conflict(new
          {
            message = "User data not exists"
          });

        }
        var selfQues = await _context.SecurityQuestionAnswers.Where(x => x.RegistrationNo == Convert.ToInt32(employeeVM.SocSecNum)).FirstOrDefaultAsync();
        if (selfQues != null)
        {
          selfQues.Question1 = employeeVM.Question1;
          selfQues.Question2 = employeeVM.Question2;
          selfQues.Answer1 = employeeVM.Answer1;
          selfQues.Answer2 = employeeVM.Answer2;
          _context.SecurityQuestionAnswers.Update(selfQues);
          await _context.SaveChangesAsync();

        }

        bool companyexist = false;
        int ssn = Convert.ToInt32(employeeVM.SocSecNum);
        StringBuilder message = new StringBuilder();
        List<BLSelfEmployed> employeelist = new List<BLSelfEmployed>();
        BLSelfEmployed bme;
        BLSelfEmployed blemployee = new BLSelfEmployed();
        string gender = null;
        if (employeeVM.rblgender == true)
        {
          gender = "Male";
        }
        else
        {
          gender = "Female";
        }
        blemployee.SocSecNum = employeeVM.SocSecNum.ToString();
        blemployee.Tin = employeeVM.Tin;
        blemployee.Category_Type = Convert.ToInt32(employeeVM.Category_Type);
        blemployee.FirstName = employeeVM.FirstName;
        blemployee.MiddleName = employeeVM.MiddleName;
        blemployee.LastName = employeeVM.LastName;
        blemployee.Phone = employeeVM.Phone;
        blemployee.Mobile = employeeVM.Mobile;
        blemployee.Address1 = employeeVM.Address1;
        blemployee.Address2 = employeeVM.Address2;
        blemployee.Country = employeeVM.Country.ToString();
        blemployee.City = employeeVM.City;
        blemployee.Zip = employeeVM.Zip;
        blemployee.IsActive = true;
        blemployee.IsdirectorOnly = false;
        blemployee.IsemployeeDirector = false;
        blemployee.BirthDate = employeeVM.BirthDate;
        blemployee.Gender = gender;
        blemployee.Email = employeeVM.Email;


        try
        {
          if (employeeVM.MaritalStat != null)
          {
            blemployee.MaritalStat = employeeVM.MaritalStat == "Single" ? "S" : (employeeVM.MaritalStat == "Married" ? "M" : "");

          }
        }
        catch (Exception ex)
        {
          var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
          LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
          throw ex;
        }
        blemployee.occupation = employeeVM.Occupation;
        try
        {
          blemployee.EmployeeID = employeeVM.EmployeeId;
          blemployee.UpdatedBy = employeeVM.HelperCompanyId;
          blemployee.UpdatedOn = DateTime.Now;


          if (ConnectionInfom.HasConnection() && ConnectionInfom.APIConnection(_configuration) && _configuration["IsBEMARegistrationEnabled"] == "1")
                    {
            bool res = await _repoSelf.Reg_save_at_saever(employeeVM);
            if (res)
            {
              blemployee.Update();
              responseModel.Message = "Self Employee data Successfully Updated!";
              responseModel.Statuscode = 200;
              responseModel.Status = true;


            }
          }
          else
          {
            var selfuser1 = await _context.SelfEmployees.FirstOrDefaultAsync(x => x.EmployeeId == employeeVM.EmployeeId);
            if (selfuser1 != null)
            {
              if (selfuser1.Email != employeeVM.Email)
              {
                var emaildata1 = _context.SelfEmployees.Where(x => x.Email == employeeVM.Email).FirstOrDefault();
                if (emaildata1 != null)
                {
                  return Conflict(new
                  {
                    message = "User email already exists"
                  });

                }
                blemployee.Update();
                responseModel.Message = "Self Employee data Successfully Updated!";
                responseModel.Statuscode = 200;
                responseModel.Status = true;
              }
              blemployee.Update();
              responseModel.Message = "Self Employee data Successfully Updated!";
              responseModel.Statuscode = 200;
              responseModel.Status = true;
            }
            else
            {
              return Conflict(new
              {
                message = "User data not exists"
              });

            }
          }
        }
        catch (Exception ex)
        {
          var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
          LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
          throw ex;
        }

      }
      catch (Exception ex)
      {
        var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
        LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
        throw ex;
      }
      return Ok(responseModel);
    }



    /// <summary>
    /// This Methods is used to GetMasterSelfEmployedSettings
    /// </summary>
    /// <param name=""></param>
    /// <returns></returns>
    [HttpGet("GetMasterSettingsimportdata")]
    public async Task<ResponseModel> GetMasterSettingsimportdata()
    {
      var defaultdta = new ImportDefaultSelfVm();
      SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
      if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
      SqlCommand cmd = new SqlCommand("Get_Master_Self_Employed_Settings", staticConnection);
      cmd.CommandType = CommandType.StoredProcedure;
      SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
      DataSet ds = new DataSet();
      sqlAdapter.Fill(ds);

      DataTable dtMRS = new DataTable();
      dtMRS = ds.Tables[0];
      staticConnection.Close();

      if (dtMRS.Rows.Count > 0)
      {
        foreach (DataRow row in dtMRS.Rows)
        {
          string islocked = Convert.IsDBNull(row["IsLocked"]) ? "False" : row["IsLocked"].ToString();
          if (islocked == "True")
          {
            int SESid = Convert.IsDBNull(row["SESId"]) ? 0 : int.Parse(row["SESId"].ToString());

            defaultdta = Get_Wages_Catagory_Self_Employed_Settings(SESid);

          }
        }
      }
      if (defaultdta != null)
      {
        responseModel.Statuscode = 200;
        responseModel.Data = defaultdta;
        responseModel.Status = true;
        responseModel.Message = "Default data retrieved successfully!";
      }
      else
      {
        responseModel.Statuscode = 404;
        responseModel.Data = null;
        responseModel.Status = false;
        responseModel.Message = "Data not found!";
      }
      return responseModel;
    }
    private ImportDefaultSelfVm Get_Wages_Catagory_Self_Employed_Settings(int? settingid)
    {

      int Wcid = (int)settingid;
      SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
      if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
      SqlCommand cmd = new SqlCommand("Get_Wages_Catagory_List", staticConnection);
      cmd.CommandType = CommandType.StoredProcedure;
      SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
      DataSet ds = new DataSet();
      sqlAdapter.Fill(ds);

      ImportDefaultSelfVm importDefault = new ImportDefaultSelfVm();
      DataTable dtMRS = new DataTable();
      dtMRS = ds.Tables[0];
      staticConnection.Close();
      if (dtMRS.Rows.Count > 0)
      {
        foreach (DataRow row in dtMRS.Rows)
        {

          int W_Settingid = Convert.IsDBNull(row["SESId"]) ? 0 : int.Parse(row["SESId"].ToString());

          if (W_Settingid == Wcid)
          {
            string W_Category = Convert.IsDBNull(row["Category"]) ? null : row["Category"].ToString();
            switch (W_Category)
            {
              case "A":
                importDefault.A = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.AWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              case "B":
                importDefault.B = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.BWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              case "C":
                importDefault.C = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.CWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              case "D":
                importDefault.D = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.DWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              case "E":
                importDefault.E = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.EWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              case "F":
                importDefault.F = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.FWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;

              case "G":
                importDefault.G = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.GWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              case "H":
                importDefault.H = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.HWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              case "I":
                importDefault.I = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.IWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              case "J":
                importDefault.J = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.JWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              case "K":
                importDefault.K = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.KWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              case "L":
                importDefault.L = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.LWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              case "M":
                importDefault.M = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.MWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              //case "Special":
              //    importDefault.Special = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
              //    importDefault.SpecialWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
              //    break;
              case "S":
                importDefault.S = Convert.IsDBNull(row["WeeklyIncome"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyIncome"].ToString()))).ToString();
                importDefault.SWC = Convert.IsDBNull(row["WeeklyContribution"]) ? "0.00" : decimal.Parse(String.Format("{0:0.00}", float.Parse(row["WeeklyContribution"].ToString()))).ToString();
                break;
              default:

                break;
            }

          }
        }
      }

      return importDefault;
    }


    /// <summary>
    /// This Methods is used to GetMasterSelfEmployedSettings
    /// </summary>
    /// <param name=""></param>
    /// <returns></returns>
    [HttpPost("SaveEmployeeSettings")]
    public async Task<ResponseModel> SaveEmployeeSettings(ImportDefaultSelfSaveVm importDefaultSelf)
    {
      try
      {
        int Wcid = Convert.ToInt32(importDefaultSelf.Wcid);
        if (importDefaultSelf.FromYear != null && (importDefaultSelf.fromMonth != null))
        {
          //if (GeneralValidateDetails())
          //{

          bool datavalidate = true;
          string fyear = importDefaultSelf.FromYear != null ? importDefaultSelf.FromYear.ToString() : null;
          int? fmonthno = importDefaultSelf.fromMonth;

          string fMonthtype = fmonthno.HasValue ? CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(fmonthno.Value) : "Invalid Month";
          string fMvalue = fMonthtype;
          string fmonthval = fmonthno <= 9 ? "0" + fmonthno.ToString() : fmonthno.ToString();
          int? tmonthno = importDefaultSelf.ToMonth;
          DateTime? newFrom_date = DateTime.ParseExact(("01/" + fmonthval + "/" + fyear), Helper.DateFormat, CultureInfo.InvariantCulture);
          DateTime? newTo_date = null;
          int daysfMonth = 0;
          if (importDefaultSelf.ToYear != null)
          {

            string tyear = importDefaultSelf.ToYear != null ? importDefaultSelf.ToYear.ToString() : null;
            int? tMvalue = importDefaultSelf.ToMonth;
            string tMonthtype = tMvalue.HasValue ? CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(tMvalue.Value) : "Invalid Month";

            string tmonthval = tmonthno <= 9 ? "0" + tmonthno.ToString() : tmonthno.ToString();
            daysfMonth = DateTime.DaysInMonth(int.Parse(tyear), Convert.ToInt32(tmonthno));
            newTo_date = DateTime.ParseExact((daysfMonth + "/" + tmonthval + "/" + tyear), Helper.DateFormat, CultureInfo.InvariantCulture);
            datavalidate = newTo_date > newFrom_date ? true : false;
          }

          if (datavalidate)
          {

            if (_repoSelf.validateC3settingExists(newFrom_date, newTo_date, importDefaultSelf, Wcid))
            {

              if (importDefaultSelf.param == 0)
              {

                _repoSelf.General_Save_button_Click(Wcid, newFrom_date, newTo_date, importDefaultSelf);
                _repoSelf.SettodateC3setting(newFrom_date, newTo_date, importDefaultSelf);

                responseModel.Statuscode = 200;
                responseModel.Status = true;
                responseModel.Message = "C3Wizard,Saved Successfully!";


              }
              else
              {
                if (true)
                {
                  // if (C3WizardMessageBox.Show("C3 Wizard", "Any changes made will affect the calculations of your self employed contribution statements. \n Are you sure you want to save these changes?", MessageBoxButton.YesNo, MessageBoxImage.Warning) == MessageBoxResult.No == false)
                  //if (Convert.ToBoolean(importDefaultSelf.UserMessage))
                  //{
                  _repoSelf.General_Save_button_Click(Wcid, newFrom_date, newTo_date, importDefaultSelf);

                  responseModel.Statuscode = 200;
                  responseModel.Status = true;
                  responseModel.Message = "C3Wizard,Updated Successfully!";

                  //}
                }
              }


            }
            else
            {

              responseModel.Message = "C3 Wizard,Record already exist for these dates!";
              responseModel.Status = true;
              responseModel.Statuscode = 409;

            }
          }
          else
          {
            responseModel.Message = "C3Wizard,To date must be greater than from date!";
            responseModel.Status = true;
            responseModel.Statuscode = 400;

          }
          // }
        }
        else
        {
          responseModel.Message = "C3 Wizard,Please select from month and from year.!";
          responseModel.Status = true;
          responseModel.Statuscode = 400;

        }
      }
      catch (Exception ex)
      {
        var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
        LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
        throw ex;
      }
      return responseModel;

    }



    /// <summary>
    /// This Methods is used to GetMasterSelfEmployedSettings
    /// </summary>
    /// <param name=""></param>
    /// <returns></returns>
    [HttpGet("Get_Master_Self_Employed_Settings")]
    public async Task<ResponseModel> Get_Master_Self_Employed_Settings()
    {

      List<Self_Employed_Setting_Details> Self_Employed_settings = new List<Self_Employed_Setting_Details>();
      SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
      SqlCommand cmd = new SqlCommand("Get_Master_Self_Employed_Settings", staticConnection);
      cmd.CommandType = CommandType.StoredProcedure;
      SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
      DataSet ds = new DataSet();
      sqlAdapter.Fill(ds);

      DataTable dtMRS = new DataTable();
      dtMRS = ds.Tables[0];
      if (dtMRS.Rows.Count > 0)
      {
        foreach (DataRow row in dtMRS.Rows)
        {
          Self_Employed_Setting_Details CSD = new Self_Employed_Setting_Details();
          CSD.SESId = Convert.IsDBNull(row["SESId"]) ? 0 : int.Parse(row["SESId"].ToString());
          CSD.Name = Convert.IsDBNull(row["Name"]) ? null : row["Name"].ToString();
          CSD.year = Convert.IsDBNull(row["Form_date"]) ? null : (DateTime.Parse(row["Form_date"].ToString()).Year).ToString();
          CSD.st_Date = Convert.IsDBNull(row["Form_date"]) ? null : DateTime.Parse(row["Form_date"].ToString()).ToString(Helper.DisplayDateFormat);
          CSD.en_Date = Convert.IsDBNull(row["To_date"]) ? null : DateTime.Parse(row["To_date"].ToString()).ToString(Helper.DisplayDateFormat) == "01-01-1900" ? null : DateTime.Parse(row["To_date"].ToString()).ToString(Helper.DisplayDateFormat);
          CSD.islocked = Convert.IsDBNull(row["IsLocked"]) ? "False" : bool.Parse(row["IsLocked"].ToString()).ToString();
          CSD.Candelete = CSD.islocked == "True" ? false : true;
          CSD.Canedit = CSD.islocked == "True" ? false : true;

          Self_Employed_settings.Add(CSD);
        }
      }
      if (Self_Employed_settings.Count > 0)
      {
        responseModel.Message = "Data fetched successfully!";
        responseModel.Status = true;
        responseModel.Data = Self_Employed_settings;
        responseModel.Statuscode = 200;
      }
      else
      {
        responseModel.Message = "Data not found!";
        responseModel.Status = false;
        responseModel.Data = null;
        responseModel.Statuscode = 404;
      }


      return responseModel;
    }

