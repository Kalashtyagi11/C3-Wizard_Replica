            String Newsurl = _configuration["ServiceConfig:ServiceUriString"];

            string NewsURL = Newsurl + "/C3/c3BulkSubmit/" + payerId + "/C3Submitted/" + month + "," + year + "," + schedule_no + ",SE/EE";
            var myContent = JsonConvert.SerializeObject(submitC3);
            var buffer = System.Text.Encoding.UTF8.GetBytes(myContent);
            var byteContent = new ByteArrayContent(buffer);
            byteContent.Headers.ContentType = new MediaTypeHeaderValue("application/json");
            HttpMessageHandler handler = new HttpClientHandler()
            {
            };

            var httpClient = new HttpClient(handler)
            {
              BaseAddress = new Uri(NewsURL),
              Timeout = new TimeSpan(0, 2, 0)
            };
            httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
            //This is the key section you were missing
            HashPassword hash = new HashPassword();
            //var plainTextBytes = System.Text.Encoding.UTF8.GetBytes(Helper.ParentUserLoginID + ":" + Helper.ParentUser_Password);
            string pass = EncryptDecryptPassword.Encrypt(User_Password);
            var plainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : System.Text.Encoding.UTF8.GetBytes(UserLoginID + ":" + pass); ;
            string val = System.Convert.ToBase64String(plainTextBytes);
            httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + val);

            HttpResponseMessage response = httpClient.PostAsync(NewsURL, byteContent).Result;
            if (response.StatusCode == HttpStatusCode.OK)
            {
              if (staticConnection.State == ConnectionState.Open)
              {
                staticConnection.Close();
              }
              SqlCommand updateC3Header = new SqlCommand("Update PROCESS_Self_EmployedC3 set Is_submitted=1 ,Schedule_NO=" + schedule_no + ", C3_SubmittedDate='" + DateTime.Now.ToString(Helper.SQLDateFormat) + "', C3_SubmittedBy=" + UserID + " where SEC3ID=" + HeaderId + " and PERIODD_MONTH=" + (int.Parse(month)) + " and PERIOD_YEAR=" + year, staticConnection);
              //SqlCommand updateC3Header = new SqlCommand("Update PROCESS_Self_EmployedC3 set  =1 , C3_SubmittedDate='" + DateTime.Now.ToString(Helper.SQLDateFormat) + "', C3_SubmittedBy=" + UserID + " where SEC3ID=" + HeaderId + " and PERIODD_MONTH=" + (int.Parse(month) - 1) + " and PERIOD_YEAR=" + year, staticConnection);
              if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
              int uprow = updateC3Header.ExecuteNonQuery();
              staticConnection.Close();
              var customerJsonString = await response.Content.ReadAsStringAsync();
              responseModel = new ResponseModel();
              responseModel.Status = true;
              responseModel.Statuscode = 200;
              responseModel.Message = $"{customerJsonString}";
              return responseModel;

            }
            else
            {
              var customerJsonString = await response.Content.ReadAsStringAsync();
              var Emp_model = JsonConvert.DeserializeObject<Apistatus>(customerJsonString);

              responseModel.Status = false;
              responseModel.Statuscode = Convert.ToInt32(Emp_model.status);
              responseModel.Message = $"{Emp_model.message}";
              return responseModel;

            }
          }
        }
        else
        {
          responseModel.Status = false;
          responseModel.Statuscode = 503;
          responseModel.Message = "Check your internet connection OR May server not responding.\n please try after sometime or contact S.S.B for any assistance.";
          return responseModel;

        }
      }
      catch (Exception ex)
      {
        var (controller, action) = ExceptionMiddleware.GetActionInfo(this);
        LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
        responseModel.Status = false;
        responseModel.Statuscode = 500;
        responseModel.Message = $"Exception occurred: {ex.Message}";
      }
      return responseModel;
    }
    private int MonthNumber(string M_Name)
    {
      int Month = 0;
      switch (M_Name)
      {
        case "January":
          Month = 0;
          break;
        case "February":
          Month = 1;
          break;
        case "March":
          Month = 2;
          break;
        case "April":
          Month = 3;
          break;
        case "May":
          Month = 4;
          break;
        case "June":
          Month = 5;
          break;
        case "July":
          Month = 6;
          break;
        case "August":
          Month = 7;
          break;
        case "September":
          Month = 8;
          break;
        case "October":
          Month = 9;
          break;
        case "November":
          Month = 10;
          break;
        case "December":
          Month = 11;
          break;
        default:
          Month = 0;
          break;
      }
      return Month;
    }
