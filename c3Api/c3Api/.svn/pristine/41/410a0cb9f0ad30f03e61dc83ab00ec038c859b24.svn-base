                ipobjbulk.wagesPaid4 = mondaysinmonth != 5 ? Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString()))) : decimal.Parse(String.Format("{0:0.00}", 0.00));//Convert.IsDBNull(row["WAGES4"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES4"].ToString());
                ipobjbulk.wagesPaid5 = mondaysinmonth == 5 ? Convert.IsDBNull(row["TOTAL_WAGES"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_WAGES"].ToString()))) : decimal.Parse(String.Format("{0:0.00}", 0.00));//Convert.IsDBNull(row["WAGES5"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(row["WAGES5"].ToString());
                ipobjbulk.wagesPaid6 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                ipobjbulk.wagesPaid7 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                ipobjbulk.startDate = null;// row["Date_Joining"].ToString() != "" ? ((DateTime)row["Date_Joining"]).ToString(Helper.DateFormat) : null;
                ipobjbulk.endDate = null;//row["Date_terminated"].ToString() != "" ? ((DateTime)row["Date_terminated"]).ToString(Helper.DateFormat) : null;
                ipobjbulk.wageType = null;// row["PayFreq"].ToString();
                objlistbulk.Add(ipobjbulk);

              }

            }
            submitC3bulk submitC3 = new submitC3bulk();
            submitC3.c3Header = Objbulk;
            submitC3.ipWages = objlistbulk;

            string value = year;
            int schedule_no = c3.GetMaxScheduleNoSelf(Convert.ToInt32(month), Convert.ToInt32(value), SSNofEmp);
            if (HeaderId == 0)
            {
              #region CheckC3Createdofselectedmonth
              //SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
