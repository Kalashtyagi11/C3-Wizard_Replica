      {
        if (ConnectionInfom.HasConnection() && ConnectionInfom.APIConnection(_configuration))
        {

          SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
          if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
          List<C3Header> self_listDVOC3Header = new List<C3Header>();
          SqlConnection self_staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection;
          SqlCommand self_cmd = new SqlCommand("Get_PROCESS_Self_Employed_C3_Genrated_dataNew", staticConnection);

          self_cmd.CommandType = CommandType.StoredProcedure;
          self_cmd.Parameters.Add(new SqlParameter("@SSN", SqlDbType.Int, 50, ParameterDirection.Input, false, 10, 0, "", DataRowVersion.Proposed, (object)SSNofEmp ?? (object)DBNull.Value));
          self_cmd.Parameters.Add(new SqlParameter("@SEC3ID", SqlDbType.Int, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)HeaderId ?? (object)DBNull.Value));
          SqlDataAdapter self_sqlAdapter = new SqlDataAdapter(self_cmd);
