@model dynamic

<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Yrsa:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cabin+Condensed&family=Encode+Sans+Condensed:wght@400;500;600&display=swap" rel="stylesheet">
  <title></title>

  <style>
    body {
      font-family: 'Roboto Condensed', sans-serif !important;
      font-weight: 400 !important;
      font-size: 17px;
      line-height: 1.3;
      color: rgba(0,0,0,.4);
    }
  </style>
</head>

<body>
  <center style="width: 100%;">
    <div style="max-width: 700px; margin: 0 auto;" class="email-container">

      <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: auto; border: 4px solid #eff3f4; margin-top: 2px;">
        <tr>
          <td valign="top" style="padding: .2em 1em; background-color: #eff3f4;"></td>
        </tr>

        <tr>
          <td valign="top" style="padding: 1em 1.3em 1rem;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">

              <tr>
                <td width="100%" class="logo" style="text-align: center;">
                  <img src="https://design.mishainfotech.com/design/amit/c3-wizard6/assets/images/logo-w.png" style="width: 80px;">
                </td>
              </tr>

              <tr>
                <td width="100%" style="color: #262626;">
                  <h2 style="color: #2a5d84;">C3 Remittances — Account Information</h2>

                  <p>Dear <strong>@Model.Name</strong>,</p>

                  <p>
                    Thank you for registering to use our C3 Remittances Platform. This service allows you to easily complete and submit your C3 remittances online.
                    If you did not create this account with the St. Christopher &amp; Nevis Social Security Board, please contact us immediately.
                  </p>

                  <p style="margin-bottom: 0px;">
                    You can access the portal here:
                    <a href="https://c3.ssbeservices.net" target="_blank" style="color: #2a5d84;">c3.ssbeservices.net</a>
                  </p>

                  <br />
                </td>
              </tr>

              <!-- Login Details Section -->
              <tr>
                <td class="bg_white" style="padding: 0em 0em .2em; color: #262626;">
                  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="border-collapse: collapse;">

                    <tr>
                      <td colspan="4">
                        <h3 style="margin-bottom: 10px;">Your Login Information:</h3>

                        <div class="row mb-3" style="display: flex; flex-wrap: wrap; margin-bottom: 15px;">
                          <div style="flex: 0 0 35%; max-width: 35%; margin-right: 25px;">
                            <div style="border-bottom: 1px dotted #a6a6a6; padding: 5px 0; font-weight: 400;">
                              Username:
                            </div>
                          </div>
                          <div style="flex: 0 0 55%; max-width: 55%;">
                            <div style="border-bottom: 1px dotted #a6a6a6; padding: 6px 0; font-weight: 600;">
                              @Model.LoginId
                            </div>
                          </div>
                        </div>

                        <div class="row mb-3" style="display: flex; flex-wrap: wrap; margin-bottom: 15px;">
                          <div style="flex: 0 0 35%; max-width: 35%; margin-right: 25px;">
                            <div style="border-bottom: 1px dotted #a6a6a6; padding: 5px 0; font-weight: 400;">
                              Password:
                            </div>
                          </div>
                          <div style="flex: 0 0 55%; max-width: 55%;">
                            <div style="border-bottom: 1px dotted #a6a6a6; padding: 6px 0; font-weight: 600;">
                              @Model.Password
                            </div>
                          </div>
                        </div>

                        <ul style="padding-left: 0; margin-bottom: 10px;">
                          <li style="list-style: none;">
                            <em>(Please change your password immediately after your first login.)</em>
                          </li>
                        </ul>

                        <br />

                        If you experience any difficulties, please email us at
                        <strong>eservices@socialsecurity.kn</strong> or call <strong>(869) 465-2535</strong>.

                        <br /><br />

                        <b>Sincerely,</b><br /><br />
                        Administrator (C3 Remittances)<br />
                        St. Christopher &amp; Nevis Social Security Board
                      </td>
                    </tr>

                  </table>
                  <br>
                </td>
              </tr>

            </table>
          </td>
        </tr>

        <tr>
          <td valign="top" style="padding: 0em 1em .4rem; background-color: #eff3f4;"></td>
        </tr>

      </table>
    </div>
  </center>
</body>
</html>
