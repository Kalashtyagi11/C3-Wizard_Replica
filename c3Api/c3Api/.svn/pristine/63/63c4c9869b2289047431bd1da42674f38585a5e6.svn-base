        public string OtherHpayType(DateTime startdate, string empid, int year, int monthno, int CompanyId)
        {
            string OthHpayType = null;
            try
            {
                int days_This_Month = DateTime.DaysInMonth(year, monthno);
                int day_of_month = startdate.Day;
                int add_day = (days_This_Month - day_of_month) >= 7 ? 6 : days_This_Month - day_of_month;
                string enddate = (startdate.AddDays(days_This_Month - 1)).ToString(Helper.SQLDateFormat);
                bool IsWithoutLeave = false;

                DataSet dataSetHPD = new DataSet();
                DataTable dtHPD = new DataTable();
                SqlConnection staticConnectionHPD = C3WizardLayerConn_BaseData.StaticSqlConnection;
                staticConnectionHPD.Open();
                SqlCommand cmdHPD = new SqlCommand("select otherHpaydes , sum(isnull(amount,0)) AS amount from MasterHolidayPayDetails where IsWithoutLeave=0 AND MasterHolidayPayDetails.company_ID =" + CompanyId +
                                                    " and MasterHolidayPayDetails.employeeID ='" + empid + "' and MasterHolidayPayDetails.start_Date >= '" + startdate.ToString(Helper.SQLDateFormat) + "' and MasterHolidayPayDetails.end_Date <= '" + enddate + "' group by otherHpaydes", staticConnectionHPD);
                cmdHPD.CommandType = CommandType.Text;
                SqlDataAdapter adapterHPD = new SqlDataAdapter();
                adapterHPD.SelectCommand = cmdHPD;
                adapterHPD.Fill(dataSetHPD);
                dtHPD = dataSetHPD.Tables[0];
                if (dtHPD.Rows.Count > 0)
                {
                    foreach (DataRow rowHPD in dtHPD.Rows)
                    {
                        OthHpayType = (Convert.IsDBNull(rowHPD["otherHpaydes"]) ? OthHpayType : OthHpayType + " " + rowHPD["otherHpaydes"].ToString() + " " + decimal.Parse(String.Format("{0:0.00}", decimal.Parse(rowHPD["amount"].ToString()))));
                    }

                }
                staticConnectionHPD.Close();
                return OthHpayType;
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                //Login login = new Login();
                //login.Error_Log(ex.Message);
                return OthHpayType;
            }

        }
