                    cmdemp.Parameters.Add(new SqlParameter("@PERIOD_YEAR", SqlDbType.VarChar, 9, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)year.ToString() ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@PayFreq", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.PayFreq ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WAGES1", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WAGES1 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WAGES2", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WAGES2 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WAGES3", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WAGES3 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WAGES4", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WAGES4 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WAGES5", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WAGES5 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@HPay", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.HPAY ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@BONUS", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.BONUS ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@Wages", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.wage_Amt ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WEEK1", SqlDbType.Bit, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WEEK1 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WEEK2", SqlDbType.Bit, 9, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WEEK2 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WEEK3", SqlDbType.Bit, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WEEK3 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WEEK4", SqlDbType.Bit, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WEEK4 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@WEEK5", SqlDbType.Bit, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.WEEK5 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@Levyee", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(emp.LEVYEE) ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@SocialSecurity", SqlDbType.Decimal, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(emp.SocialSecurity) ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@SocialSecurity_ER", SqlDbType.Decimal, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(emp.SS_Employer > (SocERPay_Limit + EIBlimit) ? (SocERPay_Limit + EIBlimit) : emp.SS_Employer) ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@SocialSecurity_EE", SqlDbType.Decimal, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(emp.SS_Employee > SocEEPay_Limit ? SocEEPay_Limit : emp.SS_Employee) ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@SERVAYANCE_EE", SqlDbType.Decimal, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(servayance_ee) ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@SERVAYANCE_ER", SqlDbType.Decimal, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(servayance_er) ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@LEVY_ER", SqlDbType.Decimal, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(levy_er) ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@Date_joining", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.Date_Joining != "" && emp.Date_Joining != null ? "01-01-1900" : null ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@Date_terminated", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.Date_terminated != "" && emp.Date_terminated != null ? "01-01-1900" : null ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@Remarks", SqlDbType.VarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.Remarks ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@SSND", SqlDbType.VarChar, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.SSND ?? (object)DBNull.Value));

                    //insert week holiday amount 
                    cmdemp.Parameters.Add(new SqlParameter("@HPay_Week1", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.HPay_Week1 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@HPay_Week2", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.HPay_Week2 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@HPay_Week3", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.HPay_Week3 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@HPay_Week4", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.HPay_Week4 ?? (object)DBNull.Value));
                    cmdemp.Parameters.Add(new SqlParameter("@HPay_Week5", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp.HPay_Week5 ?? (object)DBNull.Value));
                    SqlDataAdapter sqlAdapterEmp = new SqlDataAdapter(cmdemp);
                    DataTable dtemp = new DataTable();
                    sqlAdapterEmp.Fill(dtemp);
                }
                foreach (var row in Emp__list)
                {
                    row.C3HEADERID = C3HEADERID;
                    Emp_Cheader_Id_list.Add(row);
                }
                Emp__list = Emp_Cheader_Id_list;
                Emp_Cheader_Id_list = null;
                // C3WizardMessageBox.Show("C3 Wizard", "Saved Successfully");
                Finalize_C3();
                return savestatus = 1;
                // Application.Current.Properties["TextChanged"] = 0;
            }
            if (Result.isNilReturn)
            {
                Finalize_C3();
                return savestatus = 1;
            }
            return 0;
        }
