                    response1.Data = "";
                    response1.Status = false;
                    response1.Statuscode = 409;
                    response1.Message = "Record already exist for these dates!";
                    return response1;
                }
            }
            //else
            //{

            //bool tdate = emplistinfo.FirstOrDefault().Terminated != null ? true : false;
            //if (tdate)
            //{
            //    if (emplistinfo.FirstOrDefault().Terminated <= holidayPay_Date)
