            SaveNContinueRequest Result = new SaveNContinueRequest();
            List<C3Contributions> emplist = new List<C3Contributions>();
            if (obj_list.Count > 0)
            {
                TEmp = obj_list.Count;
                foreach (var empl in obj_list)
                {
                    C3Contributions obj = new C3Contributions();
                    obj.SSN = empl.SSN;
                    obj.IsLevyExempt = empl.IsLevyExempt;
                    obj.C3HEADERID = empl.C3HEADERID;
                    obj.EmployeeName = empl.EmployeeName;
                    obj.WEEK1 = empl.WEEK1;
                    obj.WEEK2 = empl.WEEK2;
                    obj.WEEK3 = empl.WEEK3;
                    obj.WEEK4 = empl.WEEK4;
                    obj.WEEK5 = empl.WEEK5;
                    obj.WAGES1 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES1, 2)));
                    obj.WAGES2 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES2, 2)));
                    obj.WAGES3 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES3, 2)));
                    obj.WAGES4 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES4, 2)));
                    obj.WAGES5 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.WAGES5, 2)));

                    obj.tempWAGES1 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.tempWAGES1, 2)));
                    obj.tempWAGES2 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.tempWAGES2, 2)));
                    obj.tempWAGES3 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.tempWAGES3, 2)));
                    obj.tempWAGES4 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.tempWAGES4, 2)));
                    obj.tempWAGES5 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.tempWAGES5, 2)));

                    obj.HPAY = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.HPAY, 2)));
                    obj.IsHPAY = empl.Remarks.Contains("h/p") ? "\u221A" : "X";
                    obj.BONUS = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.BONUS, 2)));
                    obj.wage_Amt = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.wage_Amt, 2)));
                    obj.PayFreq = empl.PayFreq;
                    obj.ISSelectedWEEK1 = obj.WEEK1 == true ? "X" : "";
                    obj.ISSelectedWEEK2 = obj.WEEK2 == true ? "X" : "";
                    obj.ISSelectedWEEK3 = obj.WEEK3 == true ? "X" : "";
                    obj.ISSelectedWEEK4 = obj.WEEK4 == true ? "X" : "";
                    obj.ISSelectedWEEK5 = obj.WEEK5 == true ? "X" : "";
                    obj.TotalWadeges = Math.Round((decimal)empl.TotalWadeges, 2) + obj.BONUS + obj.wage_Amt;
                    obj.LEVYEE = decimal.Parse(String.Format("{0:0.00}", empl.LEVYEE));
                    obj.Levy_Penalty = decimal.Parse(String.Format("{0:0.00}", empl.Levy_Penalty));
                    obj.SocialSecurity = decimal.Parse(String.Format("{0:0.00}", empl.SocialSecurity));
                    obj.SS_Fines = decimal.Parse(String.Format("{0:0.00}", empl.SS_Fines));
                    obj.SS_Employee = decimal.Parse(String.Format("{0:0.00}", empl.SS_Employee));
                    obj.SS_Employer = decimal.Parse(String.Format("{0:0.00}", empl.SS_Employer));
                    obj.SERVAYANCE = decimal.Parse(String.Format("{0:0.00}", empl.SERVAYANCE));
                    obj.SERVAYANCE_PENALTY = decimal.Parse(String.Format("{0:0.00}", empl.SERVAYANCE_PENALTY));
                    obj.T_C_Date = empl.T_C_Date;
                    obj.Date_Joining = empl.T_C_Date == "T" ? empl.Date_terminated : empl.T_C_Date == "C" ? empl.Date_Joining : null;
                    obj.Date_terminated = empl.Date_terminated;
                    obj.Remarks = empl.Remarks;
                    obj.IsemployeeDirector = empl.IsemployeeDirector;
                    obj.BirthDate = empl.BirthDate;
                    obj.Department = empl.Department;
                    //add holiday week wise
                    obj.HPay_Week1 = empl.HPay_Week1;
                    obj.HPay_Week2 = empl.HPay_Week2;
                    obj.HPay_Week3 = empl.HPay_Week3;
                    obj.HPay_Week4 = empl.HPay_Week4;
                    obj.HPay_Week5 = empl.HPay_Week5;
                    obj.EmpSalary = empl.EmpSalary;
                    obj.IsWeekfifth = empl.IsWeekfifth;

                    emplist.Add(obj);


                    //TSocSec = TSocSec + empl.SocialSecurity;   //atul-> empl withount round kre hue SocialSecurity count kr raha hai isliye header table me amount diff hai contibution me round off ke baad value bhejta hai tb contribution ka sum badal jata hai
                    TSocSec = TSocSec + obj.SocialSecurity;
                    TSocSecSP = TSocSecSP + empl.SS_Fines;
                    TLevy = TLevy + empl.LEVYEE;
                    TLevyP = TLevyP + empl.Levy_Penalty;
                    TSer = TSer + empl.SERVAYANCE;
                    TSerP = TSerP + empl.SERVAYANCE_PENALTY;
                    Twadges = Twadges + empl.TotalWadeges + empl.wage_Amt;
                    Bonus = Bonus + empl.BONUS;
                    S_Employee += empl.SS_Employee;
                    S_EmployeR += empl.SS_Employer;
                }
            }

            var sss = emplist.Sum(e => e.SocialSecurity);
            //code added by amit parodiya on 17 march 2022

            Result.AllEmployeeList_List = emplist;

            List<C3Contributions> Tempemplist = new List<C3Contributions>();
            Tempemplist = emplist;
            foreach (var obj in Tempemplist)
            {
                if (obj.PayFreq == "W")//weekely
                {
                    if ((obj.tempWAGES1 + (decimal)obj.HPay_Week1) != obj.WAGES1)
                        obj.WAGES1 = (decimal)obj.WAGES1 + (decimal)obj.HPay_Week1;
                    else
                        obj.WAGES1 = obj.WAGES1;

                    if ((obj.tempWAGES2 + (decimal)obj.HPay_Week2) != obj.WAGES2)
                        obj.WAGES2 = (decimal)obj.WAGES2 + (decimal)obj.HPay_Week2;
                    else
                        obj.WAGES2 = obj.WAGES2;

                    if ((obj.tempWAGES3 + (decimal)obj.HPay_Week3) != obj.WAGES3)
                        obj.WAGES3 = (decimal)obj.WAGES3 + (decimal)obj.HPay_Week3;
                    else
                        obj.WAGES3 = obj.WAGES3;

                    if (obj.IsWeekfifth)
                    {
                        if ((obj.tempWAGES4 + (decimal)obj.HPay_Week4) != obj.WAGES4)
                            obj.WAGES4 = (decimal)obj.WAGES4 + (decimal)obj.HPay_Week4;
                        else
                            obj.WAGES4 = obj.WAGES4;
                    }
                    else
                    {
                        if ((obj.tempWAGES4 + (decimal)obj.HPay_Week4) + (decimal)obj.HPay_Week5 != obj.WAGES4)
                            obj.WAGES4 = (decimal)obj.WAGES4 + (decimal)obj.HPay_Week4 + (decimal)obj.HPay_Week5;
                        else
                            obj.WAGES4 = obj.WAGES4;
                    }
                    if (obj.IsWeekfifth)
                    {
                        if ((obj.tempWAGES5 + (decimal)obj.HPay_Week5) != obj.WAGES5)
                            obj.WAGES5 = (decimal)obj.WAGES5 + (decimal)obj.HPay_Week5;
                        else
                            obj.WAGES5 = obj.WAGES5;
                    }
                    else
                    {
                        //wages5 will be as it is
                    }
                }

                if (obj.PayFreq == "E2W")//every two week
                {
                    if ((obj.tempWAGES1 + (decimal)obj.HPay_Week1 + (decimal)obj.HPay_Week2) != obj.WAGES1)
                        obj.WAGES1 = (decimal)obj.WAGES1 + (decimal)obj.HPay_Week1 + (decimal)obj.HPay_Week2;
                    else
                        obj.WAGES1 = obj.WAGES1;

                    //wages2 will be as it is

                    if (obj.IsWeekfifth)
                    {
                        if ((obj.tempWAGES3 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4) != obj.WAGES3)
                            obj.WAGES3 = (decimal)obj.WAGES3 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4;
                        else
                            obj.WAGES3 = obj.WAGES3;
                    }
                    else
                    {
                        if ((obj.tempWAGES3 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4 + (decimal)obj.HPay_Week5) != obj.WAGES3)
                            obj.WAGES3 = (decimal)obj.WAGES3 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4 + (decimal)obj.HPay_Week5;
                        else
                            obj.WAGES3 = obj.WAGES3;
                    }

                    //wages 4 will be as it is

                    if (obj.IsWeekfifth)
                    {
                        if ((obj.tempWAGES5 + (decimal)obj.HPay_Week5) != obj.WAGES5)
                            obj.WAGES5 = (decimal)obj.WAGES5 + (decimal)obj.HPay_Week5;
                        else
                            obj.WAGES5 = obj.WAGES5;
                    }
                }

                if (obj.PayFreq == "M")//monthly
                {
                    //wages1,2 and 3 will be as it is

                    if (obj.IsWeekfifth)
                    {
                        //wages4 will be as it is
                    }
                    else
                    {
                        if ((obj.tempWAGES4 + (decimal)obj.HPay_Week1 + (decimal)obj.HPay_Week2 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4 + (decimal)obj.HPay_Week5) != obj.WAGES4)
                            obj.WAGES4 = (decimal)obj.WAGES4 + (decimal)obj.HPay_Week1 + (decimal)obj.HPay_Week2 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4 + (decimal)obj.HPay_Week5;
                        else
                            obj.WAGES4 = obj.WAGES4;
                    }
                    if (obj.IsWeekfifth)
                    {
                        if ((obj.tempWAGES5 + (decimal)obj.HPay_Week1 + (decimal)obj.HPay_Week2 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4 + (decimal)obj.HPay_Week5) != obj.WAGES5)
                            obj.WAGES5 = (decimal)obj.WAGES5 + (decimal)obj.HPay_Week1 + (decimal)obj.HPay_Week2 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4 + (decimal)obj.HPay_Week5;
                        else
                            obj.WAGES5 = obj.WAGES5;
                    }
                    else
                    {
                        //wages 5 will be as it is
                    }
                }

                if (obj.PayFreq == "2M")//twice in a month
                {
                    //wages 1 will be as it is

                    if ((obj.tempWAGES2 + (decimal)obj.HPay_Week1 + (decimal)obj.HPay_Week2) != obj.WAGES2)
                        obj.WAGES2 = (decimal)obj.WAGES2 + (decimal)obj.HPay_Week1 + (decimal)obj.HPay_Week2;
                    else
                        obj.WAGES2 = obj.WAGES2;

                    //wages 3 will be as it is

                    if (obj.IsWeekfifth)
                    {
                        if ((obj.tempWAGES4 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4) != obj.WAGES4)
                            obj.WAGES4 = (decimal)obj.WAGES4 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4;
                        else
                            obj.WAGES4 = obj.WAGES4;
                    }
                    else
                    {
                        if ((obj.tempWAGES4 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4 + (decimal)obj.HPay_Week5) != obj.WAGES4)
                            obj.WAGES4 = (decimal)obj.WAGES4 + (decimal)obj.HPay_Week3 + (decimal)obj.HPay_Week4 + (decimal)obj.HPay_Week5;
                        else
                            obj.WAGES4 = obj.WAGES4;
                    }
                    if (obj.IsWeekfifth)
                    {
                        if ((obj.tempWAGES5 + (decimal)obj.HPay_Week5) != obj.WAGES5)
                            obj.WAGES5 = (decimal)obj.WAGES5 + (decimal)obj.HPay_Week5;
                        else
                            obj.WAGES5 = obj.WAGES5;
                    }
                    else
                    {
                        //wages 5 will be as it is
                    }
                }

            }


            Result.H_Id = Convert.ToInt32(H_Id);
            Result.Is_Preview = ispreview;
            Result.schedule_no = schedule_no;
            Result.MonthName = MonthName;
            Result.Monthno = month;
            Result.Year = year.ToString();
            Result.Text_SSTotal = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TSocSec + TSocSecSP), 2).ToString()))).ToString();
            Result.TextTotalWages = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(Twadges + Bonus), 2).ToString()))).ToString();
            Result.TextTotalWagesNLevy = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevy), 2).ToString()))).ToString();
            //Result.TLevyEmployer = Helper.IsLevyExempt ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : month == 11 && exemptedEmployerLevybonus ? decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)((Twadges * (decimal?)employerlevyRate / 100)), 2))) : decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)(((Twadges + Bonus) * (decimal?)employerlevyRate / 100)), 2)));
            decimal? TLevyEmployer = Result.isNilReturn ? 0 : IsLevyExempt ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : month == 11 && bonusSetting.exemptedEmployerLevybonus ? decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)((Twadges * (decimal?)employerlevyRate / 100)), 2))) : decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)(((Twadges + Bonus) * (decimal?)employerlevyRate / 100)), 2)));
            Result.TextEmployerLevy = Result.isNilReturn ? "0" : IsLevyExempt ? "0.00" : month == 11 && bonusSetting.exemptedEmployerLevybonus ? decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)((Twadges * (decimal?)employerlevyRate / 100)), 2).ToString()))).ToString() : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(((Twadges + Bonus) * (decimal?)employerlevyRate / 100)), 2).ToString()))).ToString();
            Result.TextLevyPenalty = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevyP), 2).ToString()))).ToString();
            Result.TextServayance = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TSer), 2).ToString()))).ToString();
            Result.TextPEPenalty = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TSerP), 2).ToString()))).ToString();
            Result.TextTotalAccountantGeneral = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)((TLevy + TLevyP + TLevyEmployer + TSer + TSerP)), 2).ToString()))).ToString();
            Result.TextSSContribution = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TSocSec), 2).ToString()))).ToString();
            Result.TextSSPenalty = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TSocSecSP), 2).ToString()))).ToString();
            Result.TexttotalSS = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)((TSocSec + TSocSecSP)), 2).ToString()))).ToString();
            Result.Txt_GrandTotal = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)((TLevy + TLevyP + TLevyEmployer + TSer + TSerP + TSocSec + TSocSecSP)), 2).ToString()))).ToString();
            Result.TextAccountantGeneral = Result.isNilReturn ? "0" : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevy + TLevyP + TLevyEmployer + TSer + TSerP), 2)).ToString())).ToString();






            Result.isNilReturn = isNilreturn;


            if (issave)
            {
                if (!ispreview)
                {
                    Save_IN_Continue(Result, month.ToString(), year.ToString(), 1, month, "", 0, "User_Name", null, null);   //Userid,  username,  MachineInfo);
                }
                //ButtonFinalize.Visibility = Visibility.Visible;
                //ButtonSave.Visibility = Visibility.Hidden;
                //ButtonPrint.IsEnabled = C3H_Id > 0 ? true : is_preview ? false : true;
                //ButtonExport.IsEnabled = C3H_Id > 0 ? true : is_preview ? false : true;
            }
            else
            {
                //ButtonPrint.IsEnabled = C3H_Id > 0 ? true : is_preview ? false : true;
                //ButtonExport.IsEnabled = C3H_Id > 0 ? true : is_preview ? false : true;
                //ButtonFinalize.Visibility = isrecordEdit ? Visibility.Hidden : Visibility.Visible;
                //ButtonSave.Visibility = isrecordEdit ? Visibility.Visible : Visibility.Hidden;
            }
            return Result;
        }





        public int SaveC3Record(List<C3Contributions> obj_list, List<C3Contributions> Not_Selected_list, int month, string Month_Name, string year, int? H_Id, int schedule_no, bool issave, bool isrecordEdit, float employerlevyRate, decimal SeveranceRate, decimal EIB_Limit, decimal Soc_EE_Pay_Limit, decimal Soc_ER_Pay_Limit, int[] yearlist, string TextChanged, int CompanyId, bool ListHavingItems, string User_Name, int UserID, DecemberBonusSetting bonusSetting, bool IsLevyExempt, string OrderName, string OrderKey, bool isNilReturn)
