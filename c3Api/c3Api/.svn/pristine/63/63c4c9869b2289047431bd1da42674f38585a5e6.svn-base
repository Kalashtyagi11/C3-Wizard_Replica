        public async Task<ResponseModel> ParseC3File(string filePath, int companyId, int userId)
        {
            var lines = File.ReadAllLines(filePath);
            var c3Data = new C3FileData();

            foreach (var line in lines)
            {
                var parts = line.Split(',');

                if (parts[0] == "HDR")
                {

                    //if (parts.Length!=10)
                    //{
                    //    return new ResponseModel { Status = false, Message = "HDR Length not Matched" };
                    //}

                    var date = DateTime.ParseExact(parts[2], new[] { "d/M/yyyy", "dd/MM/yyyy" }, CultureInfo.InvariantCulture, DateTimeStyles.None);

                    c3Data.Header = new ProcessC3header
                    {
                        RegNo = parts[1],
                        PerioddMonth = date.Month.ToString(),
                        PeriodYear = date.Year.ToString(),
                        //VERSION = parts[3],
                        //COMPANY = parts[4]
                    };
                }
                else if (parts[0] == "FTR")
                {
                    //if (parts.Length != 10)
                    //{
                    //    return new ResponseModel { Status = false, Message = "FTR Length not Matched" };
                    //}


                    c3Data.Footer = new ProcessC3header
                    {

                        TotalWages = Convert.ToDouble(parts[3]),
                        TotalSscontributions = Convert.ToDouble(parts[4]),
                        //TTLLV = Convert.ToDecimal(parts[5]),
                        TotalServayance = Convert.ToDouble(parts[6]),
                        // NUMRECS = Convert.ToInt32(parts[7]),
                        InsertDatetimeinfo = DateTime.Now,
                        EmployerId = 0,
                        InsertedBy = 0,
                    };
                }
                else
                {
                    //if (parts.Length != 10)
                    //{
                    //    return new ResponseModel { Status = false, Message = "Details Length not Matched" };
                    //}


                    var emp = new C3Contributions
                    {
                        //LINE = parts[0],
                        BirthDate = "",
                        emp_add_remove = true,
                        EmployeeId = -1,
                        IsemployeeDirector = false,
                        EmpSalary = -1,
                        SSN = parts[1],
                        EmployeeName = parts[2] + " " + parts[3],
                        period_Month = c3Data.Header.PerioddMonth,
                        Period_year = c3Data.Header.PeriodYear,
                        PayFreq = parts[7], //== "1" ? "W" : parts[7] == "2" ? "E2W" : parts[7] == "3" ? "M" : parts[7] == "4" ? "2M" : "",
                        Date_Joining = string.IsNullOrEmpty(parts[5]) ? null : DateTime.ParseExact(parts[5], "yyyy-MM-dd", CultureInfo.InvariantCulture).ToString(),
                        Date_terminated = string.IsNullOrEmpty(parts[6]) ? null : DateTime.ParseExact(parts[6], "yyyy-MM-dd", CultureInfo.InvariantCulture).ToString(),
                        WEEK1 = parts[8] == "1" ? true : false,
                        WEEK2 = parts[9] == "1" ? true : false,
                        WEEK3 = parts[10] == "1" ? true : false,
                        WEEK4 = parts[11] == "1" ? true : false,
                        WEEK5 = parts[12] == "1" ? true : false,
                        HPAY = Convert.ToDecimal(parts[13]),
                        BONUS = Convert.ToDecimal(parts[14]),
                        WAGES1 = Convert.ToDecimal(parts[15]),
                        WAGES2 = Convert.ToDecimal(parts[16]),
                        WAGES3 = Convert.ToDecimal(parts[17]),
                        WAGES4 = Convert.ToDecimal(parts[18]),
                        WAGES5 = Convert.ToDecimal(parts[19]),
                        tempWAGES1 = Convert.ToDecimal(parts[15]),
                        tempWAGES2 = Convert.ToDecimal(parts[16]),
                        tempWAGES3 = Convert.ToDecimal(parts[17]),
                        tempWAGES4 = Convert.ToDecimal(parts[18]),
                        tempWAGES5 = Convert.ToDecimal(parts[19]),
                        wage_Amt = 0,

                    };

                    c3Data.Employees.Add(emp);
                }
            }
            var userpass = _DbContext.Secusers.FirstOrDefault(e => e.UserId == userId);

            var chklocalemp = c3Data.Employees.Where(e => !_DbContext.MasterEmployees.Any(m => m.SocSecNum == e.SSN && m.CompanyId == companyId)).ToList();
            await empAddthroughFile(chklocalemp, userId, companyId, userpass);
            var chklocalempAfterApicall = _DbContext.MasterEmployees.Where(e => e.CompanyId == companyId && c3Data.Employees.Select(m => m.SSN).ToList().Contains(e.SocSecNum)).ToList();

            if (chklocalempAfterApicall.Count == c3Data.Employees.Count)
            {
                foreach (var item in c3Data.Employees)
                {
                    var fillmissingdata = chklocalempAfterApicall.FirstOrDefault(e => e.SocSecNum == item.SSN);

                    item.BirthDate = fillmissingdata.BirthDate?.ToString("yyyy-MM-dd");
                    item.EmployeeId = fillmissingdata.EmployeeId;
                    item.PayFreq = fillmissingdata.PayPeriod;
                    item.EmpSalary = _DbContext.MasterEmployeeIncomes.FirstOrDefault(e => e.EmployeeId == fillmissingdata.EmployeeId).IncRate;
                }
                var postReq = new SaveNContinueRequest();
                postReq.CompanyId = companyId;
                postReq.Monthno = Convert.ToInt32(c3Data.Header.PerioddMonth);
                postReq.MonthName = c3Data.Header.PerioddMonth;
                postReq.Year = c3Data.Header.PeriodYear;
                postReq.IsLevyExempt = false;
                postReq.IsRecordEdit = false;
                postReq.ListHavingItems = true;
                postReq.User_Name = userpass.LoginId;
                postReq.UserID = userId;
                postReq.CmbPayPeriod = JsonConvert.DeserializeObject<List<PayPeriods>>("[{ \"Key\":\"W - Weekly\",\"Value\":\"W\"}, { \"Key\":\"M - Monthly\",\"Value\":\"M\"}, { \"Key\":\"E2W - Every Two Weeks\",\"Value\":\"E2W\"}, { \"Key\":\"2M - Twice Monthly\",\"Value\":\"2M\"}]");
                postReq.AllEmployeeList_List = c3Data.Employees;
                postReq.isNilReturn = false;
                postReq.Is_Preview = false;
                postReq.IsSave = true;


                return new ResponseModel() { Status = true, Data = postReq };

            }
            else
            {
                var notFoundEmp = c3Data.Employees.Where(e => !chklocalempAfterApicall.Any(m => m.SocSecNum == e.SSN)).ToList();
                return new ResponseModel() { Status = false, Message = "this SSN Employee NOt Found", Data = notFoundEmp.Select(e => new { SSN = e.SSN, EmployeeName = e.EmployeeName }) };
            }

        }



        public async Task empAddthroughFile(List<C3Contributions> data, int userId, int companyid, Secuser userpass)
        {

            if (ConnectionInfom.HasConnection() && ConnectionInfom.APIConnection(_configuration))
            {
                try
                {

                    string Newsurl = _configuration["ServiceConfig:ServiceUriString"];
                    string NewsURL = Newsurl + "/Employee/getMultipleIpDetails";
                    var myContent = JsonConvert.SerializeObject(new
                    {
                        employees = data.Select(e =>
                        {
                            var parts = (e.EmployeeName ?? "").Split(' ', 2);
                            return new
                            {
                                fName = parts.Length > 0 ? parts[0] : "",
                                lName = parts.Length > 1 ? parts[1] : "",
                                ssn = e.SSN
                            };
                        })
                    });
                    var buffer = System.Text.Encoding.UTF8.GetBytes(myContent);
                    var byteContent = new ByteArrayContent(buffer);
                    byteContent.Headers.ContentType = new MediaTypeHeaderValue("application/json");


                    HttpMessageHandler handler = new HttpClientHandler()
                    {
                    };

                    var httpClient = new System.Net.Http.HttpClient(handler)
                    {
                        BaseAddress = new Uri(NewsURL),
                        Timeout = new TimeSpan(0, 2, 0)
                    };
                    httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");

                    var plainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : System.Text.Encoding.UTF8.GetBytes(userpass.LoginId + ":" + userpass.Password);

                    string val = System.Convert.ToBase64String(plainTextBytes);
                    httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + val);

                    HttpResponseMessage response = httpClient.PostAsync(NewsURL, byteContent).Result;
                    if (response.StatusCode == HttpStatusCode.OK)
                    {
                        var customerJsonString = await response.Content.ReadAsStringAsync();
                        var EmpList_model = JsonConvert.DeserializeObject<List<Employeedetails>>(customerJsonString);
                        if (EmpList_model != null)
                        {
                            foreach (var item in EmpList_model)
                            {
                                var salary = data.Where(e => e.SSN == item.socSecNum).Select(e =>
                                             e.WAGES1 != 0 ? e.WAGES1 :
                                             e.WAGES2 != 0 ? e.WAGES2 :
                                             e.WAGES3 != 0 ? e.WAGES3 :
                                             e.WAGES4 != 0 ? e.WAGES4 :
                                             e.WAGES5).FirstOrDefault();
                                item.payPeriod = data.FirstOrDefault(e => e.SSN == item.socSecNum).PayFreq;

                                var saveEmpdata = ProcessEmployee(item, companyid, salary);

                            }


                        }
                    }



                }
                catch (Exception ex)
                {

                }

            }
        }

        public async Task<List<EmployeeData>> GetEmployeeAndDirectorDataAsync(bool employeeType, int empId)
        {
            var employees = new List<EmployeeData>();
            string connectionString = _configuration.GetConnectionString("DefaultConnection");

            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                using (SqlCommand cmd = new SqlCommand("GetEmployeeAndDirectorData", conn))
                {
                    cmd.CommandType = CommandType.StoredProcedure;
                    cmd.Parameters.AddWithValue("@EmployeeType", employeeType);
                    cmd.Parameters.AddWithValue("@empId", empId);

                    await conn.OpenAsync();
                    using (SqlDataReader reader = await cmd.ExecuteReaderAsync())
                    {
                        while (await reader.ReadAsync())
                        {
                            var emp = new EmployeeData
                            {
                                Empl_Code = reader["Empl_Code"]?.ToString(),
                                Soc_Sec_Num = reader["Soc_Sec_Num"]?.ToString(),
                                First_Name = reader["First_Name"]?.ToString(),
                                Middle_Name = reader["Middle_Name"]?.ToString(),
                                Last_Name = reader["Last_Name"]?.ToString(),
                                Type_Code = reader["Type_Code"]?.ToString(),
                                BirthDate = reader["BirthDate"] != DBNull.Value ? Convert.ToDateTime(reader["BirthDate"]) : (DateTime?)null,
                                Gender = reader["Gender"]?.ToString(),
                                Address1 = reader["Address1"]?.ToString(),
                                Address2 = reader["Address2"]?.ToString(),
                                City = reader["City"]?.ToString(),
                                State = reader["State"]?.ToString(),
                                Country = reader["Country"]?.ToString(),
                                Zip = reader["Zip"]?.ToString(),
                                Phone = reader["Phone"]?.ToString(),
                                Mobile = reader["Mobile"]?.ToString(),
                                Email = reader["Email"]?.ToString(),
                                Appint_Date = reader["Appint_Date"] != DBNull.Value ? Convert.ToDateTime(reader["Appint_Date"]) : (DateTime?)null,
                                Last_Pay_Date = reader["Last_Pay_Date"] != DBNull.Value ? Convert.ToDateTime(reader["Last_Pay_Date"]) : (DateTime?)null,
                                Wages_Pay_Date = reader["Wages_Pay_Date"] != DBNull.Value ? Convert.ToDateTime(reader["Wages_Pay_Date"]) : (DateTime?)null,
                                Terminated = reader["Terminated"] != DBNull.Value ? Convert.ToDateTime(reader["Terminated"]) : (DateTime?)null,
                                Empl_Status = reader["Empl_Status"]?.ToString(),
                                Pay_Period = reader["Pay_Period"]?.ToString(),
                                Marital_Stat = reader["Marital_Stat"]?.ToString(),
                                Hold_Pymnt = reader["Hold_Pymnt"] != DBNull.Value ? Convert.ToBoolean(reader["Hold_Pymnt"]) : (bool?)null,
                                Last_Inc_Date = reader["Last_Inc_Date"] != DBNull.Value ? Convert.ToDateTime(reader["Last_Inc_Date"]) : (DateTime?)null,
                                Occupation = reader["Occupation"]?.ToString()
                            };

                            employees.Add(emp);
                        }
                    }
                }
            }

            return employees;
        }



        public async Task<byte[]> GeneratePdfUsingWkhtmltopdf(string htmlContent)
        {

            string directoryPath = Path.Combine(Directory.GetCurrentDirectory(), "lib", "wkhtmltopdf");
            if (!Directory.Exists(directoryPath))
            {
                Directory.CreateDirectory(directoryPath);
            }
            var wkhtmlPath = Path.Combine(Directory.GetCurrentDirectory(), "lib", "wkhtmltopdf", "bin", "wkhtmltopdf.exe");

            var psi = new ProcessStartInfo
            {
                FileName = wkhtmlPath,
                Arguments = "--quiet - -",
                RedirectStandardInput = true,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };

            using var process = new Process { StartInfo = psi };
            process.Start();

            // Write HTML content to stdin
            await process.StandardInput.WriteAsync(htmlContent);
            process.StandardInput.Close();

            // Read the generated PDF from stdout
            using var ms = new MemoryStream();
            await process.StandardOutput.BaseStream.CopyToAsync(ms);

            string errors = await process.StandardError.ReadToEndAsync();
            process.WaitForExit();

            if (process.ExitCode != 0)
            {
                throw new Exception("wkhtmltopdf failed: " + errors);
            }

            return ms.ToArray();
        }



        public async Task<ResponseModel> deleteC3(int c3headerid,int userid)
        {
            var header = _DbContext.ProcessC3headers.FirstOrDefault(e => e.C3headerid == c3headerid);
            var headerDetails = _DbContext.ProcessContributions.Where(e => e.C3headerid == c3headerid);
            if (header!=null)
            {
                try
                {
                    if (!C3WizardRepository.Repository.ConnectionInfom.APIConnection(_configuration) ||
                        !C3WizardRepository.Repository.ConnectionInfom.HasConnection())
                    {
                        return new ResponseModel
                        {
                            Status = false,
                            Message = "Check your internet connection or server availability.",
                            Statuscode = 400
                        };
                    }

                    var user = _DbContext.Secusers.FirstOrDefault(e => e.UserId == userid);
                    string baseUrl = _configuration["ServiceConfig:ServiceUriString"];
                    //string deletePath = $"/C3/deleteC3All/{header.RegNo}/{header.PerioddMonth},{header.PeriodYear},{header.ScheduleNo},ER,EE";
                    string deletePath = $"/C3/deleteC3All/{header.RegNo}/{header.PerioddMonth}/{header.PeriodYear}/{header.ScheduleNo}/ER,EE";

                    using (var client = new HttpClient { BaseAddress = new Uri(baseUrl), Timeout = TimeSpan.FromMinutes(2) })
                    {
                        var authBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1"
                            ? Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"])
                            : Encoding.UTF8.GetBytes($"{user.LoginId}:{user.Password}");

                        string authHeader = Convert.ToBase64String(authBytes);
                        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Basic", authHeader);

                      
                        HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Delete, deletePath);

                        var result = await client.SendAsync(request);
                        var responseString = await result.Content.ReadAsStringAsync();

                        if (!result.IsSuccessStatusCode)
                        {
                            return new ResponseModel
                            {
                                Status = false,
                                Message = $"External deletion failed: {result.ReasonPhrase} ({responseString})",
                                Statuscode = 400
                            };
                        }

                        _DbContext.ProcessC3headers.Remove(header);
                        _DbContext.ProcessContributions.RemoveRange(headerDetails);
                        await _DbContext.SaveChangesAsync();


                        return new ResponseModel
                        {
                            Status = true,
                            Message = responseString,
                            Statuscode = 200
                        };
                    }

                }
                catch (Exception ex)
                {
                    var context = ExceptionMiddleware1.GetActionInfo();
                    LoggingHelper.LogError(context.Controller, context.Action, ex.Message, ex.StackTrace);
                    return new ResponseModel
                    {
                        Status = false,
                        Message = "An error occurred during deletion.",
                        Statuscode = 500
                    };
                }
            }
            else
            {
                return new ResponseModel
                {
                    Status = false,
                    Message = "data Not Found",
                    Statuscode = 400
                };
            }

        }

    }


}







