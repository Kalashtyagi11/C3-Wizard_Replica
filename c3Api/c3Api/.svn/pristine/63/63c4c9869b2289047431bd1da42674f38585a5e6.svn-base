            cmd.Parameters.Add(new SqlParameter("@UserName", SqlDbType.NVarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(string)username ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@IsImportFromBEMA", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)false ?? (object)DBNull.Value));
            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
            DataTable dt = new DataTable();
            sqlAdapter.Fill(dt);

            if (dt.Rows.Count > 0 && !Result.isNilReturn)
            {
                int C3HEADERID = (int)dt.Rows[0].ItemArray[0];
                C3H_Id = C3HEADERID;
                foreach (var emp in Emp_Deduction_list)
                {
                    decimal? levy_er = decimal.Parse(String.Format("{0:0.00}", (Twadges + Bonus) > 0 ? (((emp.TotalWadeges + emp.wage_Amt + emp.BONUS) * TLevyEmployer) / (Twadges + Bonus)) : 0.00M));

                    decimal? servayance_er = decimal.Parse(String.Format("{0:0.00}", ((emp.TotalWadeges + emp.wage_Amt + emp.BONUS) * Severance_Rate)));
                    decimal? servayance_ee = decimal.Parse(String.Format("{0:0.00}", (emp.SERVAYANCE > EIBlimit ? EIBlimit : emp.SERVAYANCE)));

                    SqlCommand cmdemp = new SqlCommand("Process_Contributions_Insert_One", staticConnection);
                    cmdemp.CommandType = CommandType.StoredProcedure;
                    cmdemp.Parameters.Add(new SqlParameter("@C3HEADERID", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)C3HEADERID ?? (object)DBNull.Value));
