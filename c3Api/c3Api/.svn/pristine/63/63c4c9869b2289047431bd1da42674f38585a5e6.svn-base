        public decimal? SSEmployer(int age, decimal? amount, bool Is_Emp_D, int Min_Age, int Max_Age, float Soc_ER_Rate, decimal? Soc_ER_Pay_Limit)
        {
            //return Is_Emp_D ? 0 : (age < Min_Age || age >= Max_Age ? 0 : (amount * (decimal)(Soc_ER_Rate) > (decimal)(Soc_ER_Pay_Limit) ? (decimal)(Soc_ER_Pay_Limit) : amount * (decimal)(Soc_ER_Rate)));
            return (age < Min_Age || age >= Max_Age ? 0 : (amount * (decimal)(Soc_ER_Rate) > (decimal)(Soc_ER_Pay_Limit) ? (decimal)(Soc_ER_Pay_Limit) : amount * (decimal)(Soc_ER_Rate)));

        }
        public int EmpAge(DateTime todate, string dob)
        {
            int age = 0;
            string dobyyyymmdd = DateTime.Parse(dob).ToString("yyyyMMdd");
            age = (int.Parse(todate.ToString("yyyyMMdd")) - int.Parse((dobyyyymmdd).ToString())) / 10000;
            if (age == Min_Age - 1)
            {
                int yearno = (int)((DateTime.Parse(dob)).AddYears(16)).Year;
                int monthno = (int)DateTime.Parse(dob).Month;
                if (monthno == todate.Month && yearno == todate.Year)
                {
                    int dayofweek = (int)DateTime.Parse(dob).DayOfWeek;
                    if (dayofweek == 1)
                    {
                        age++;
                    }
                }
            }
            if (age == Max_Age - 1)
            {
                int year_no = (int)((DateTime.Parse(dob)).AddYears(61)).Year;
                int month_no = (int)DateTime.Parse(dob).Month;

                if (month_no == todate.Month && year_no == todate.Year)
                {
                    int dayofweek = (int)DateTime.Parse(dob).DayOfWeek;
                    if (dayofweek == 1)
                    {
                        age++;
                    }
                }
            }
            return age;
        }
        public int EmpAge(DateTime todate, string dob, int week_no)
        {
            try
            {
                int age = 0;
                string dobyyyymmdd = DateTime.ParseExact(dob, Helper.SQLDateFormat, CultureInfo.InvariantCulture).ToString("yyyyMMdd");
                age = (int.Parse((todate).ToString("yyyyMMdd")) - int.Parse((dobyyyymmdd).ToString())) / 10000;
                if (age == Min_Age - 1)
                {
                    int yearno = (int)((DateTime.Parse(dob)).AddYears(16)).Year;
                    int monthno = (int)DateTime.Parse(dob).Month;
                    if (monthno == todate.Month && yearno == todate.Year)
                    {
                        int dayd = (int)((DateTime.Parse(dob)).AddYears(16)).DayOfYear;
                        int dayt = todate.AddDays(6).DayOfYear;

                        if (dayt >= dayd)
                        {
                            age++;
                        }
                    }
                }
                if (age == Max_Age)
                {
                    int year_no = (int)((DateTime.Parse(dob)).AddYears(62)).Year;
                    int month_no = (int)DateTime.Parse(dob).Month;

                    if (month_no == todate.Month && year_no == todate.Year)
                    {
                        int dayofweek = (int)DateTime.Parse(dob).DayOfWeek;
                        if (dayofweek == 1)
                        {
                            age++;
                        }
                    }
                    else
                    {
                        age++;
                    }
                }
                return age;
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                //Login login = new Login();
                //login.Error_Log(ex.Message);
                return 0;
            }

        }

