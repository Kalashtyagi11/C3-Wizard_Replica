        public string getemployeename(string ssn, int CompanyId)
        {
            try
            {
                string Employeename = "";
                DataTable dt = new DataTable();

                //string SqlQuerystring = ConfigurationSettings.AppSettings.Get("AppConnection");
                SqlConnection con = new SqlConnection(C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString);
                con.Open();
                SqlCommand cmd = new SqlCommand("SELECT EmployeeID, Soc_Sec_Num +' ('+Last_Name+' '+First_Name+')' as Name FROM MasterEmployee WHERE IsdirectorOnly=0 and Isactive=1 and Soc_Sec_Num='" + ssn + "'  and CompanyId=" + CompanyId, con);
                cmd.CommandType = CommandType.Text;
                SqlDataAdapter adapter = new SqlDataAdapter();
                adapter.SelectCommand = cmd;
                adapter.Fill(dt);

                foreach (DataRow row in dt.Rows)
                {
                    Employeename = row["Name"].ToString();
                }
                con.Close();
                return Employeename;
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return "";
            }

        }

        bool IsWeekfifth = false;
        public List<C3Contributions> LoadEmployee(int CompanyId, int monthno, string Year, List<PayPeriod> CmbPayPeriod)
        {
            List<C3Contributions> C3_Created_SSN_list = new List<C3Contributions>();
            List<C3Contributions> AllEmployeeList_List = new List<C3Contributions>();

            try
            {
                //Application.Current.Properties["TextChanged"] = 0;
                List<C3Contributions> listforview = new List<C3Contributions>();
                ListHavingItems = false;

                //ComboBoxItem typeItem = (ComboBoxItem)CmbYear.SelectedItem;
                //string value = typeItem.Content.ToString();
                string value = Year;
                int daysin_month = DateTime.DaysInMonth(int.Parse(value), monthno);
                string monthval = monthno <= 9 ? "0" + monthno.ToString() : monthno.ToString();
                DateTime Today_date = DateTime.ParseExact(("01/" + monthval + "/" + value), Helper.DateFormat, CultureInfo.InvariantCulture);
                DateTime? Todaydate = DateTime.ParseExact(("01/" + monthval + "/" + value), Helper.DateFormat, CultureInfo.InvariantCulture);
                int count = -1;

                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                List<C3Contributions> W_employee_list = new List<C3Contributions>();
                List<C3Contributions> M_employee_list = new List<C3Contributions>();
                List<C3Contributions> E_2_W_employee_list = new List<C3Contributions>();
                List<C3Contributions> Tw_Memployee_list = new List<C3Contributions>();
                //added by amit parodiya
                List<C3Contributions> AllEmployee_List = new List<C3Contributions>();

                List<BLMasterEmployee> emplist = BLMasterEmployee.MasterEmployeeCollection_grid(CompanyId).ToList();

                DateTime? end_date = Todaydate != null ? (DateTime?)((DateTime)Todaydate).AddDays(daysin_month - 1) : null;
                emplist = emplist.Where(x => (x.Terminated == null || x.Terminated >= Todaydate) && (x.AppintDate == null || x.AppintDate <= end_date)).ToList();

                //  Get_PayPeriod_List(emplist);

                List<BLMasterEmployee> Weekelyemplist = new List<BLMasterEmployee>();
                List<BLMasterEmployee> E_2_Weekelyemplist = new List<BLMasterEmployee>();
                List<BLMasterEmployee> Monthlyemplist = new List<BLMasterEmployee>();
                List<BLMasterEmployee> Twice_Montly_emplist = new List<BLMasterEmployee>();
                foreach (var empl in emplist)
                {
                    C3Contributions blemp = new C3Contributions();
                    blemp.PayFreq = empl.PayPeriod == "B" ? "E2W" : empl.PayPeriod == "S" ? "2M" : empl.PayPeriod;
                    listforview.Add(blemp);
                }
                List<Holiday_Pay_Dates1> holidaypadates = new List<Holiday_Pay_Dates1>();
                int daysThisMonth = DateTime.DaysInMonth(int.Parse(value), monthno);
                holidaypadates = Holiday_Pay_Dates1((DateTime)Todaydate, daysThisMonth);
                // Get_PayPeriod_List(listforview);
                foreach (var item in CmbPayPeriod)
                {
                    if (item.Value == "W")
                    {
                        Weekelyemplist = emplist.Where(x => x.PayPeriod == "W").ToList();
                    }
                    else if (item.Value == "M")
                    {
                        Monthlyemplist = emplist.Where(x => x.PayPeriod == "M").ToList();
                    }
                    else if (item.Value == "B")
                    {
                        E_2_Weekelyemplist = emplist.Where(x => x.PayPeriod == "B").ToList();
                    }
                    else if (item.Value == "S")
                    {
                        Twice_Montly_emplist = emplist.Where(x => x.PayPeriod == "S").ToList();
                    }
                }

                foreach (var empl in Weekelyemplist)
                {
                    C3Contributions blemp = new C3Contributions();
                    count++;
                    decimal total_hpay = 0;
                    decimal total_Otherpay = 0;
                    decimal total_OtherDirWagespay = 0;
                    blemp.SSN = empl.SocSecNum;
                    blemp.C3HEADERID = C3_Created_SSN_list.Any(x => x.SSN == empl.SocSecNum) ? C3_Created_SSN_list.FirstOrDefault(x => x.SSN == empl.SocSecNum).C3HEADERID : 0;
                    blemp.EmployeeId = empl.EmployeeID;
                    blemp.EmployeeName = empl.FirstName;
                    blemp.Department = empl.Department;
                    blemp.PayPeriod = empl.PayPeriodforlist;
                    blemp.Date_Joining = empl.AppintDate != null ? ((DateTime)empl.AppintDate).ToString(Helper.DateFormat) : null;
                    blemp.Date_terminated = empl.Terminated != null ? ((DateTime)empl.Terminated).ToString(Helper.DateFormat) : null;
                    blemp.WEEK1 = empl.Terminated == null ? true : (DateTime)empl.Terminated > holidaypadates[0].holidayPay_Date ? true : false;
                    blemp.WEEK2 = empl.Terminated == null ? true : (DateTime)empl.Terminated > holidaypadates[1].holidayPay_Date ? true : false;
                    blemp.WEEK3 = empl.Terminated == null ? true : (DateTime)empl.Terminated > holidaypadates[2].holidayPay_Date ? true : false;
                    blemp.WEEK4 = empl.Terminated == null ? true : (DateTime)empl.Terminated > holidaypadates[3].holidayPay_Date ? true : false;
                    blemp.WEEK5 = IsWeekfifth ? empl.Terminated == null ? IsWeekfifth : (DateTime)empl.Terminated > holidaypadates[4].holidayPay_Date ? IsWeekfifth : false : false;
                    DateTime? h_pay_Start_date = null, h_pay_End_date = null;

                    decimal w1_hpay = 0, w2_hpay = 0, w3_hpay = 0, w4_hpay = 0, w5_hpay = 0;
                    if (empl.Terminated == null ? true : (DateTime)empl.Terminated > holidaypadates[0].holidayPay_Date ? true : false)
                    {
                        w1_hpay = LoadHpay(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId);
                        h_pay_Start_date = w1_hpay > 0 ? Today_date : h_pay_Start_date;
                        h_pay_End_date = w1_hpay > 0 ? holidaypadates[0].holidayPay_Date : h_pay_End_date;
                        blemp.HPay_Week1 = w1_hpay;
                    }
                    else
                    {
                        blemp.HPay_Week1 = 0;
                    }

                    if (empl.Terminated == null ? true : (DateTime)empl.Terminated > holidaypadates[0].holidayPay_Date ? true : false)
                    {
                        w2_hpay = LoadHpay(holidaypadates[1].holidayPay_Date, blemp.SSN, int.Parse(value), monthno, CompanyId);
                        h_pay_Start_date = w2_hpay > 0 ? h_pay_Start_date == null ? holidaypadates[1].holidayPay_Date : h_pay_Start_date : h_pay_Start_date;
                        h_pay_End_date = w2_hpay > 0 ? holidaypadates[1].holidayPay_Date : h_pay_End_date;
                        blemp.HPay_Week2 = w2_hpay;
                    }
                    else
                    {
                        blemp.HPay_Week2 = 0;
                    }

                    if (empl.Terminated == null ? true : (DateTime)empl.Terminated > holidaypadates[0].holidayPay_Date ? true : false)
                    {
                        w3_hpay = LoadHpay(holidaypadates[2].holidayPay_Date, blemp.SSN, int.Parse(value), monthno, CompanyId);
                        h_pay_Start_date = w3_hpay > 0 ? h_pay_Start_date == null ? holidaypadates[2].holidayPay_Date : h_pay_Start_date : h_pay_Start_date;
                        h_pay_End_date = w3_hpay > 0 ? holidaypadates[2].holidayPay_Date : h_pay_End_date;
                        blemp.HPay_Week3 = w3_hpay;
                    }
                    else
                    {
                        blemp.HPay_Week3 = 0;
                    }

                    if (empl.Terminated == null ? true : (DateTime)empl.Terminated > holidaypadates[0].holidayPay_Date ? true : false)
                    {
                        w4_hpay = LoadHpay(holidaypadates[3].holidayPay_Date, blemp.SSN, int.Parse(value), monthno, CompanyId);
                        h_pay_Start_date = w4_hpay > 0 ? h_pay_Start_date == null ? holidaypadates[3].holidayPay_Date : h_pay_Start_date : h_pay_Start_date;
                        h_pay_End_date = w4_hpay > 0 ? holidaypadates[3].holidayPay_Date : h_pay_End_date;
                        blemp.HPay_Week4 = w4_hpay;
                    }
                    else
                    {
                        blemp.HPay_Week4 = 0;
                    }

                    if (empl.Terminated == null ? true : (DateTime)empl.Terminated > holidaypadates[0].holidayPay_Date ? true : false)
                    {
                        w5_hpay = IsWeekfifth ? LoadHpay(holidaypadates[4].holidayPay_Date, blemp.SSN, int.Parse(value), monthno, CompanyId) : 0;
                        h_pay_Start_date = IsWeekfifth ? w5_hpay > 0 ? h_pay_Start_date == null ? holidaypadates[4].holidayPay_Date : h_pay_Start_date : h_pay_Start_date : h_pay_Start_date;
                        h_pay_End_date = IsWeekfifth ? w5_hpay > 0 ? holidaypadates[4].holidayPay_Date : h_pay_End_date : h_pay_End_date;
                        blemp.HPay_Week5 = w5_hpay;
                    }
                    else
                    {
                        blemp.HPay_Week5 = 0;
                    }

                    total_hpay = w1_hpay + w2_hpay + w3_hpay + w4_hpay + w5_hpay;
                    bool IsWithleaveHpay = IsOtherHpay(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId);

                    string OtHpayType = total_hpay > 0 ? OtherHpayType(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId) : string.Empty;
                    total_Otherpay = total_hpay > 0 ? Otherpay(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    total_OtherDirWagespay = total_hpay > 0 ? OtherDirWagespay(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.WAGES1 = empl.Terminated == null ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w1_hpay))) : (DateTime)empl.Terminated > holidaypadates[0].holidayPay_Date ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w1_hpay))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.WAGES2 = empl.Terminated == null ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w2_hpay))) : (DateTime)empl.Terminated > holidaypadates[1].holidayPay_Date ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w2_hpay))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.WAGES3 = empl.Terminated == null ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w3_hpay))) : (DateTime)empl.Terminated > holidaypadates[2].holidayPay_Date ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w3_hpay))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.WAGES4 = empl.Terminated == null ? IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w4_hpay))) : decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w4_hpay + w5_hpay))) : (DateTime)empl.Terminated > holidaypadates[3].holidayPay_Date ? IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w4_hpay))) : decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w4_hpay + w5_hpay))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.WAGES5 = empl.Terminated == null ? IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w5_hpay))) : decimal.Parse(String.Format("{0:0.00}", 0.00)) : IsWeekfifth ? (DateTime)empl.Terminated > holidaypadates[4].holidayPay_Date ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w5_hpay))) : decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    //code added by amit parodiya
                    blemp.tempWAGES1 = empl.Terminated == null ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : (DateTime)empl.Terminated > holidaypadates[0].holidayPay_Date ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.tempWAGES2 = empl.Terminated == null ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : (DateTime)empl.Terminated > holidaypadates[1].holidayPay_Date ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.tempWAGES3 = empl.Terminated == null ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : (DateTime)empl.Terminated > holidaypadates[2].holidayPay_Date ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.tempWAGES4 = empl.Terminated == null ? IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : (DateTime)empl.Terminated > holidaypadates[3].holidayPay_Date ? IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.tempWAGES5 = empl.Terminated == null ? IsWeekfifth ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", 0.00)) : IsWeekfifth ? (DateTime)empl.Terminated > holidaypadates[4].holidayPay_Date ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", 0.00));

                    blemp.BONUS = decimal.Parse(String.Format("{0:0.00}", LoadBonus(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId)));
