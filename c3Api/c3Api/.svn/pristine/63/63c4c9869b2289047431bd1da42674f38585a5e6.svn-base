        public bool isC3Finilize(DateTime? sdate, DateTime? edate)
        {

            string CreatedC3For = null;
            bool ret_uren = true;
            int Start_y, end_y, start_m, end_m;
            Start_y = DateTime.ParseExact(((DateTime)sdate).ToString(Helper.DisplayDateFormat), Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Year;
            end_y = edate == null ? 0 : DateTime.ParseExact(((DateTime)edate).ToString(Helper.DisplayDateFormat), Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Year;
            start_m = DateTime.ParseExact(((DateTime)sdate).ToString(Helper.DisplayDateFormat), Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Month;
            end_m = edate == null ? 0 : DateTime.ParseExact(((DateTime)edate).ToString(Helper.DisplayDateFormat), Helper.DisplayDateFormat, System.Globalization.CultureInfo.InvariantCulture).Month;
            try
            {
                List<C3Header> listDVOC3Header = new List<C3Header>();
                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                SqlCommand cmd = new SqlCommand("get_C3Genrated_dataSettings", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                DataTable dt = new DataTable();
                sqlAdapter.Fill(dt);
                staticConnection.Close();
                if (dt.Rows.Count > 0)
                {
                    foreach (DataRow row in dt.Rows)
                    {

                        C3Header Obj = new C3Header();
                        Obj.HeaderID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString());
                        Obj.p_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == "" ? -1 : int.Parse(row["PERIODD_MONTH"].ToString()) + 1;
                        Obj.P_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == "" ? -1 : int.Parse(row["PERIOD_YEAR"].ToString());
                        Obj.Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString());
                        listDVOC3Header.Add(Obj);

                    }
                    bool exists = listDVOC3Header.Any(x => x.P_year >= Start_y && x.p_Month >= start_m);
                    if (exists)
                    {
                        ret_uren = false;
                        //C3WizardMessageBox.Show("C3 Wizard", "C3 settings already used \n You can not change this C3 settings details ");

                    }
                }
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                throw ex;
            }
            return ret_uren;
        }

        public ViewModelMaster_Setting_Rates_Rates Get_Master_Setting_Rates_Rates(DateTime? fromdate, DateTime? todate)
        {
            ViewModelMaster_Setting_Rates_Rates Master_Setting_Rate = new ViewModelMaster_Setting_Rates_Rates();
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            SqlCommand cmd = new SqlCommand("Get_Master_C3_Setting_Rates", staticConnection);
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add(new SqlParameter("@From_date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)fromdate ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@To_date", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)todate ?? (object)DBNull.Value));
            SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
            DataSet ds = new DataSet();
            sqlAdapter.Fill(ds);
            DataTable dtMOC = new DataTable();
            dtMOC = ds.Tables[0];
            if (dtMOC.Rows.Count > 0)
            {
                foreach (DataRow row in dtMOC.Rows)
                {
                    string Obl_code = Convert.IsDBNull(row["Obl_code"]) ? null : row["Obl_code"].ToString();
                    if (Obl_code == "SOC_ER")
                    {
                        Master_Setting_Rate.Soc_ER_Rate = Convert.IsDBNull(row["dflt_rate"]) ? 0 : float.Parse(row["dflt_rate"].ToString());
                        Master_Setting_Rate.Soc_ER_Pay_Limit = Convert.IsDBNull(row["dflt_pay_limit"]) ? 0 : decimal.Parse(row["dflt_pay_limit"].ToString());

                    }
                }
            }
            DataTable dtMDC = new DataTable();
            dtMDC = ds.Tables[1];
            if (dtMDC.Rows.Count > 0)
            {
                foreach (DataRow row in dtMDC.Rows)
                {
                    string Obl_code = Convert.IsDBNull(row["ded_code"]) ? null : row["ded_code"].ToString();
                    if (Obl_code == "SOC_EE")
                    {
                        Master_Setting_Rate.Soc_EE_Rate = Convert.IsDBNull(row["dflt_rate"]) ? 0 : float.Parse(row["dflt_rate"].ToString());
                        Master_Setting_Rate.Soc_EE_Pay_Limit = Convert.IsDBNull(row["dflt_pay_limit"]) ? 0 : decimal.Parse(row["dflt_pay_limit"].ToString());
                    }
                }
            }
            DataTable dtMRS = new DataTable();
            dtMRS = ds.Tables[2];
            if (dtMRS.Rows.Count > 0)
            {
                foreach (DataRow row in dtMRS.Rows)
                {
                    Master_Setting_Rate.Bonus_Levy_EE_Rate = Convert.IsDBNull(row["Bonus_Levy_EE_Rate"]) ? 0 : float.Parse(row["Bonus_Levy_EE_Rate"].ToString());
                    Master_Setting_Rate.SeveranceRate = Convert.IsDBNull(row["SeveranceRate"]) ? 0 : float.Parse(row["SeveranceRate"].ToString());
                    Master_Setting_Rate.Fine_Rate = Convert.IsDBNull(row["Fine_Rate"]) ? 0 : float.Parse(row["Fine_Rate"].ToString());
                    Master_Setting_Rate.Additional_Fine_Rate = Convert.IsDBNull(row["Additional_Fine_Rate"]) ? 0 : float.Parse(row["Additional_Fine_Rate"].ToString());
                    Master_Setting_Rate.Penalty_Rate = Convert.IsDBNull(row["Penalty_Rate"]) ? 0 : float.Parse(row["Penalty_Rate"].ToString());
                    Master_Setting_Rate.Additional_Penalty_Rate = Convert.IsDBNull(row["SeveranceRate"]) ? 0 : float.Parse(row["SeveranceRate"].ToString());
                    Master_Setting_Rate.Min_Age = Convert.IsDBNull(row["Min_Age"]) ? 0 : int.Parse(row["Min_Age"].ToString());
                    Master_Setting_Rate.Max_Age = Convert.IsDBNull(row["Max_Age"]) ? 0 : int.Parse(row["Max_Age"].ToString());
                    Master_Setting_Rate.Employer_Levy_Rate = Convert.IsDBNull(row["EmployerLevy"]) ? 0 : float.Parse(row["EmployerLevy"].ToString());
                }
            }
            DataTable dtMOCEIB = new DataTable();
            dtMOCEIB = ds.Tables[3];
            if (dtMOCEIB.Rows.Count > 0)
            {
                foreach (DataRow row in dtMOCEIB.Rows)
                {
                    string Obl_code = Convert.IsDBNull(row["Obl_code"]) ? null : row["Obl_code"].ToString();
                    if (Obl_code == "EIB")
                    {
                        Master_Setting_Rate.EIB_Rate = Convert.IsDBNull(row["dflt_rate"]) ? 0 : float.Parse(row["dflt_rate"].ToString());
                        Master_Setting_Rate.EIB_Pay_Limit = Convert.IsDBNull(row["dflt_pay_limit"]) ? 0 : decimal.Parse(row["dflt_pay_limit"].ToString());

                    }
                }
            }

            return Master_Setting_Rate;
        }



        public List<Employee_Name_SSN> Employeelist(int companyId)
        {
            List<Employee_Name_SSN> emplList = new List<Employee_Name_SSN>();

            try
            {
                // Retrieve the connection string
                string connString = C3WizardLayerConn_BaseData.StaticSqlConnection.ConnectionString;

                // Open the SQL connection using a using block for proper disposal
                using (SqlConnection con = new SqlConnection(connString))
                {
                    con.Open();

                    // SQL query with ISNULL to handle potential nulls in concatenation
                    string query = @"
                SELECT 
                    EmployeeID, 
                    ISNULL(Soc_Sec_Num, '') + '(' + ISNULL(Last_Name, '') + ' ' + ISNULL(First_Name, '') + ')' AS Name 
                FROM 
                    MasterEmployee 
                WHERE 
                    IsdirectorOnly = 0 AND Isactive = 1 AND CompanyId = @CompanyId";

                    // Create and configure the command
                    using (SqlCommand cmd = new SqlCommand(query, con))
                    {
                        cmd.CommandType = CommandType.Text;
                        cmd.Parameters.AddWithValue("@CompanyId", companyId);

                        // Use a SqlDataReader for efficient data retrieval
                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                Employee_Name_SSN emp = new Employee_Name_SSN
                                {
                                    EmployeeId = reader.GetInt32(reader.GetOrdinal("EmployeeID")),
                                    Name = reader.GetString(reader.GetOrdinal("Name"))
                                };

                                emplList.Add(emp);
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

            }
            return emplList;
        }

        public int MondaysInMonth(int CmbMonth, int CmbYear)
        {
            int weeks = 0;
            int daysThisMonth = DateTime.DaysInMonth(CmbYear, CmbMonth);
            DateTime beginingOfThisMonth = new DateTime(CmbYear, CmbMonth, 1);
            for (int i = 0; i < daysThisMonth; i++)
                if (beginingOfThisMonth.AddDays(i).DayOfWeek == DayOfWeek.Monday)
                    weeks++;
            return weeks;
        }

        public async Task<(bool IsSuccess, string ErrorMessage)> AllEmployeeExistsAsync(int? headerId, bool submit, int companyId)
        {
            bool res = true;
            string ssnNotFound = "";
            int ssnCount = 0;
            int selectedEmpCount = 0;

            // Get the master employee list for the company.
            List<BLMasterEmployee> employeeList = BLMasterEmployee.MasterEmployeeCollection_grid(companyId).ToList();

            // Use your static connection string.
            string connectionString = C3WizardLayerConn_BaseData.StaticConnectionString;

            using (SqlConnection staticConnection = new SqlConnection(connectionString))
            {
                await staticConnection.OpenAsync();
                using (SqlCommand cmdEmp = new SqlCommand("get_C3Genrated_Employee_data", staticConnection))
                {
                    cmdEmp.CommandType = CommandType.StoredProcedure;
                    cmdEmp.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int) { Value = headerId ?? (object)DBNull.Value });
                    cmdEmp.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int) { Value = companyId });

                    using (SqlDataAdapter adapter = new SqlDataAdapter(cmdEmp))
                    {
                        DataTable dtEmp = new DataTable();
                        adapter.Fill(dtEmp);

                        if (dtEmp.Rows.Count > 0)
                        {
                            foreach (DataRow row in dtEmp.Rows)
                            {
                                // Count the number of records having a valid header id.
                                if (int.Parse(row["C3HEADERID"].ToString()) > 0)
                                {
                                    selectedEmpCount++;
                                }

                                string ssn = row["SSN"].ToString();
                                // Check if the SSN exists in the master employee list.
                                if (!employeeList.Any(x => x.SocSecNum == ssn))
                                {
                                    res = false;
                                    ssnNotFound += string.IsNullOrEmpty(ssnNotFound) ? ssn : "," + ssn;
                                    ssnCount++;
                                    if (ssnCount > 10)
                                    {
                                        ssnNotFound += "\n";
                                        ssnCount = 0;
                                    }
                                }
                            }

                            if (submit)
                            {
                                if (!string.IsNullOrEmpty(ssnNotFound))
                                {
                                    return (false, "This C3 cannot be submitted because the following employee SSNs were not found:\n" + ssnNotFound);
                                }
                                else if (selectedEmpCount == 0)
                                {
                                    return (false, "Employee contributions do not exist in this C3.");
                                }
                            }
                            else // For editing
                            {
                                if (!string.IsNullOrEmpty(ssnNotFound))
                                {
                                    return (false, "This C3 cannot be edited because the following employee SSNs were not found:\n" + ssnNotFound);
                                }
                            }
                        }
                        else
                        {
                            return (false, "Employee contributions do not exist in this C3.");
                        }
                    }
                }
            }

            return (true, string.Empty);
        }


