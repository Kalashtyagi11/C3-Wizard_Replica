            {
                BLMasterEmployeeIncomes empInc = new BLMasterEmployeeIncomes();
                empInc.EmployeeID = obj.EmployeeID;
                empInc.EmplCode = null;
                empInc.IncCode = "Fixed";
                empInc.LineNo = null;
                empInc.IncRate = salary;
                empInc.IncNumber = null;
                empInc.IncHours = 1;
                empInc.AcctNo = null;
                empInc.Department = null;
                empInc.IncQtd1 = null;
                empInc.IncQtd2 = null;
                empInc.IncQtd3 = null;
                empInc.IncQtd4 = null;
                empInc.IncYtd = 1;
                empInc.LoIncAmt = null;
                empInc.HiIncAmt = null;
                empInc.SaveNew();
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                //Login login = new Login();
                //login.Error_Log(ex.Message);
                //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
            }
        }
        public ResponseModel ProcessEmployee(Employeedetails emp, int companyId, decimal? salary = null)
        {
            try
            {
                if (emp == null)
                {
                    return new ResponseModel
                    {
                        Status = false,
                        Message = "Invalid employee data",
                        Statuscode = 400
                    };
                }

                var blemployee = new BLMasterEmployee
                {
                    CompanyId = companyId,
                    SocSecNum = emp.socSecNum?.Trim() ?? string.Empty,
                    TypeCode = "1",
                    FirstName = emp.firstName?.Trim() ?? string.Empty,
                    LastName = emp.surName?.Trim() ?? string.Empty,
                    IsActive = true,
                    IsdirectorOnly = string.Equals(emp.isdirectorOnly, "true", StringComparison.OrdinalIgnoreCase),
                    IsemployeeDirector = string.Equals(emp.isemployeeDirector, "true", StringComparison.OrdinalIgnoreCase),
                    BirthDate = DateTime.TryParseExact(emp.birthDate, Helper.DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime birthDate)
                                ? birthDate
                                : new DateTime(1900, 1, 1),
                    Gender = emp.gender,
                    MaritalStat = emp.maritalStatus,
                    Address1 = emp.streetAddress,
                    Address2 = emp.streetName,
                    City = emp.cityTownName,
                    Country = emp.countryCode,
                    State = emp.stateRegion,
                    Mobile = emp.mobile,
                    Phone = emp.phone,
                    IsLevyExempt = false,
                    PayPeriod = emp.payPeriod?.Trim() switch
                    {
                        "1" => "W",
                        "2" => "E2W",
                        "3" => "M",
                        "4" => "2M",
                        _ => ""
                    },
                    InsertedBy = companyId,
                    InsertedOn = DateTime.Now,
                    InsertedMachineInfo = Helper.MachineInfo
                };

                blemployee.SaveNew();

                decimal monthlySalary = salary == null ? Helper.Findsalary(emp) : salary ?? 0;
                save_MasterEmployeeIncomesImportData(blemployee, monthlySalary);

                return new ResponseModel
                {
                    Status = true,
                    Message = "Employee processed successfully",
                    Statuscode = 200
                };
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return new ResponseModel
                {
                    Status = false,
                    Message = $"Error processing employee {emp?.socSecNum}: {ex.Message}",
                    Statuscode = 500
                };
            }
        }

        public async Task<ResponseModel> DeleteC3LocalAndSSB(submitC3bulk deletec3, int headerid, int payerId, int year, int month, int scheduleno, int userId, int companyId)
        {
            var response = new ResponseModel();
            try
            {
                if (!C3WizardRepository.Repository.ConnectionInfom.APIConnection(_configuration) ||
                    !C3WizardRepository.Repository.ConnectionInfom.HasConnection())
                {
                    return new ResponseModel
                    {
                        Status = false,
                        Message = "Check your internet connection or server availability.",
                        Statuscode = 400
                    };
                }

                UserVM user = GetUserDetails(companyId, userId);
                string baseUrl = _configuration["ServiceConfig:ServiceUriString"];
                string deletePath = $"/C3/deleteC3/{payerId}/C3Submitted/{month},{year},{scheduleno},ER,EE";

                var deleteData = new submitC3bulk
                {
                    c3Header = new c3Headerbulk { numberEmployed = 1 },
                    ipWages = deletec3.ipWages
                };

                string json = JsonConvert.SerializeObject(deleteData);
                using (var client = new HttpClient { BaseAddress = new Uri(baseUrl), Timeout = TimeSpan.FromMinutes(2) })
                {
                    var authBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : Encoding.UTF8.GetBytes($"{user.ParentUserLoginID}:{user.ParentUser_Password}");

                    string authHeader = Convert.ToBase64String(authBytes);
                    client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Basic", authHeader);

                    var content = new StringContent(json, Encoding.UTF8, "application/json");
                    HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Delete, deletePath)
                    {
                        Content = content
                    };

                    var result = await client.SendAsync(request);

                    if (!result.IsSuccessStatusCode)
                    {
                        return new ResponseModel
                        {
                            Status = false,
                            Message = $"External deletion failed: {result.ReasonPhrase}",
                            Statuscode = (int)result.StatusCode
                        };
                    }
                }

                return new ResponseModel
                {
                    Status = true,
                    Message = "Deleted successfully",
                    Statuscode = 200
                };
            }
            catch (Exception ex)
            {
                var context = ExceptionMiddleware1.GetActionInfo();
                LoggingHelper.LogError(context.Controller, context.Action, ex.Message, ex.StackTrace);
                return new ResponseModel
                {
                    Status = false,
                    Message = "An error occurred during deletion.",
                    Statuscode = 500
                };
            }
        }

        public async Task<ResponseModel> GetEmpDetailsFromAPIAsync(int ssnn, EmployeeL employeeDetails)
        {
            var result = new ResponseModel();
            var employeeList = new EmployeeEditVM();
            string connectionString = C3WizardLayerConn_BaseData.StaticConnectionString;

            UserVM user = GetUserDetails(employeeDetails.companyId, employeeDetails.userId);

            try
            {
                string birthday = null;
                if (employeeDetails.BirthDate != null)
                {
                    DateTime Birthd = Convert.ToDateTime(employeeDetails.BirthDate);//DateTime.Parse(EmPloyeeDetaisl.BirthDate.Trim());
                    birthday = Birthd.ToString(Helper.DisplayDateFormat);
                }

                string baseUrl = _configuration["ServiceConfig:ServiceUriString"];
                string url = $"{baseUrl}/Employee/getIpDetailsByQuery/{ssnn},{birthday},{Uri.EscapeDataString(employeeDetails.FirstName.Trim())},{Uri.EscapeDataString(employeeDetails.MiddleName.Trim())},{Uri.EscapeDataString(employeeDetails.LastName.Trim())}";

                using var handler = new HttpClientHandler();
                using var httpClient = new HttpClient(handler) { Timeout = TimeSpan.FromMinutes(2) };

                httpClient.DefaultRequestHeaders.Add("ContentType", "application/json");
                var plainTextBytes = _configuration["EnableBEMAAuthInsteadOfLocal"] == "1" ? System.Text.Encoding.UTF8.GetBytes(_configuration["ServiceConfig:AuthUser"] + ":" + _configuration["ServiceConfig:AuthPass"]) : System.Text.Encoding.UTF8.GetBytes(user.ParentUserLoginID + ":" + user.ParentUser_Password);

                string val = System.Convert.ToBase64String(plainTextBytes);
                httpClient.DefaultRequestHeaders.Add("Authorization", "Basic " + val);

                HttpResponseMessage response = await httpClient.GetAsync(url);

                if (response.StatusCode == HttpStatusCode.OK)
                {
                    string responseData = await response.Content.ReadAsStringAsync();
                    var employees = JsonConvert.DeserializeObject<List<Employeedetails>>(responseData);

                    if (employees?.Count > 0)
                    {
                        if (!string.IsNullOrEmpty(ssnn.ToString()) && employees.Count > 1)
                        {
                            employees = employees.Where(x => x.socSecNum == employeeDetails.ssnn.ToString()).ToList();
                        }

                        if (employees.Count == 1)
                        {
                            var emp = employees[0];

                            employeeList.LastName = emp.surName;
                            employeeList.FirstName = emp.firstName;
                            employeeList.Address1 = emp.streetAddress;
                            employeeList.Address2 = emp.streetName;
                            employeeList.City = emp.cityTownName;
                            employeeList.Country = emp.postalCode;
                            employeeList.EmplCode = emp.countryCode;
                            employeeList.Email = emp.email;
                            employeeList.Phone = emp.phone;
                            employeeList.Mobile = emp.mobile;
                            employeeList.Occupation = emp.occupation;
                            employeeList.incRate = Helper.Findsalary(emp).ToString();

                            if (!string.IsNullOrEmpty(emp.gender))
                            {
                                //employeeList.rbmale = emp.gender == "M";
                                //employeeList.rbmale = emp.gender == "F";
                                string gender = emp.gender;
                                if (gender == "M") { employeeList.rbmale = true; }
                                if (gender == "F") { employeeList.rbmale = true; }
                            }

                            employeeList.MaritalStat = emp.maritalStatus switch
                            {
                                "S" => "Single",
                                "M" => "Married",
                                _ => ""
                            };

                            employeeList.payPeriod = emp.payPeriod switch
                            {
                                "1" => "Weekly",
                                "2" => "Every Two Weeks",
                                "3" => "Monthly",
                                "4" => "Twice Monthly",
                                _ => ""
                            };

                            result.Message = "Data fetched successfully";
                            result.Statuscode = 200;
                            result.Status = true;
                            result.Data = employeeList;
                            return result;
                        }

                        result.Message = "Multiple records found";
                        result.Statuscode = 200;
                        result.Status = true;
                        result.Data = employeeList;
                        return result;
                    }
                }
                else
                {
                    string errorResponse = await response.Content.ReadAsStringAsync();
                    var apiStatus = JsonConvert.DeserializeObject<Apistatus>(errorResponse);
                    result.Message = apiStatus?.message ?? "API error";
                    result.Statuscode = 400;
                    result.Status = false;
                }
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                result.Message = ex.Message;
                result.Statuscode = 500;
                result.Status = false;
            }

            return result;
        }

        public async Task<ResponseModel> Updateemployeewages(DateTime? holidayPay_Date, decimal? wagesAmount, int? holidaypayId, int CompanyId, string SocSecNum)
        {
            ResponseModel response1 = new ResponseModel();
            string emp = SocSecNum;
            int employeeid = int.Parse(emp.Substring(0, 6));
            string ssno = emp.Substring(0, 6);
            int HPid;
