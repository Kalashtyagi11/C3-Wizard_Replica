                        obj.ISSelectedWEEK3 = obj.WEEK3 == true ? "\u221A" : null;
                        obj.ISSelectedWEEK4 = obj.WEEK4 == true ? "\u221A" : null;
                        obj.ISSelectedWEEK5 = obj.WEEK5 == true ? "\u221A" : null;
                        obj.TotalWadeges = Math.Round((decimal)empl.TotalWadeges, 2) + obj.BONUS + obj.wage_Amt;
                        obj.LEVYEE = decimal.Parse(String.Format("{0:0.00}", empl.LEVYEE));
                        obj.Levy_Penalty = decimal.Parse(String.Format("{0:0.00}", empl.Levy_Penalty));
                        obj.SocialSecurity = decimal.Parse(String.Format("{0:0.00}", empl.SocialSecurity));
                        obj.SS_Fines = decimal.Parse(String.Format("{0:0.00}", empl.SS_Fines));
                        obj.SS_Employee = decimal.Parse(String.Format("{0:0.00}", empl.SS_Employee));
                        obj.SS_Employer = decimal.Parse(String.Format("{0:0.00}", empl.SS_Employer));
                        obj.SERVAYANCE = decimal.Parse(String.Format("{0:0.00}", empl.SERVAYANCE));
                        obj.SERVAYANCE_PENALTY = decimal.Parse(String.Format("{0:0.00}", empl.SERVAYANCE_PENALTY));
                        obj.T_C_Date = empl.T_C_Date;
                        obj.Date_Joining = empl.T_C_Date == "T" ? empl.Date_terminated : empl.T_C_Date == "C" ? empl.Date_Joining : null;
                        obj.Remarks = empl.Remarks;
                        obj.IsemployeeDirector = empl.IsemployeeDirector;
                        obj.BirthDate = empl.BirthDate;

                        obj.HPay_Week1 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.HPay_Week1, 2)));
                        obj.HPay_Week2 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.HPay_Week2, 2)));
                        obj.HPay_Week3 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.HPay_Week3, 2)));
                        obj.HPay_Week4 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.HPay_Week4, 2)));
                        obj.HPay_Week5 = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.HPay_Week5, 2)));

                        emplist.Add(obj);
                        TSocSec = TSocSec + empl.SocialSecurity;
                        TSocSecSP = TSocSecSP + empl.SS_Fines;
                        TLevy = TLevy + empl.LEVYEE;
                        TLevyP = TLevyP + empl.Levy_Penalty;
                        TSer = TSer + empl.SERVAYANCE;
                        TSerP = TSerP + empl.SERVAYANCE_PENALTY;
                        Twadges = Twadges + empl.TotalWadeges + empl.wage_Amt;
                        Bonus = Bonus + empl.BONUS;
                        S_Employee += empl.SS_Employee;
                        S_EmployeR += empl.SS_Employer;
                    }
                }
                emplistnew.AllEmployeeList_List = emplist;

                //AddC3RecordWages.ItemsSource = emplist;
                //AddC3RecordWages.SelectedIndex = -1;
                //LabelEmployeeCountValue.Content = TEmp;
                emplistnew.schedule_no = schedule_no;
                //var Text_SSTotal = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TSocSec + TSocSecSP), 2).ToString()))).ToString();
                var Text_SSTotal = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TSocSec), 2).ToString()))).ToString();
                emplistnew.TextTotalWages = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(Twadges + Bonus), 2).ToString()))).ToString();
                emplistnew.TextTotalWagesNLevy = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevy), 2).ToString()))).ToString();
                TLevyEmployer = IsLevyExempt ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : bonusSetting.exemptedEmployerLevybonus ? decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)((Twadges * (decimal?)employerlevyRate / 100)), 2))) : decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)(((Twadges + Bonus) * (decimal?)employerlevyRate / 100)), 2)));
                emplistnew.TextEmployerLevy = false ? "0.00" : month == 11 && bonusSetting.exemptedEmployerLevybonus ? decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)((Twadges * (decimal?)employerlevyRate / 100)), 2).ToString()))).ToString() : decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(((Twadges + Bonus) * (decimal?)employerlevyRate / 100)), 2).ToString()))).ToString();
                emplistnew.TextLevyPenalty = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevyP), 2).ToString()))).ToString();
                emplistnew.TextServayance = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TSer), 2).ToString()))).ToString();
                emplistnew.TextPEPenalty = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TSerP), 2).ToString()))).ToString();
                emplistnew.TextTotalAccountantGeneral = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)((TLevy + TLevyP + TLevyEmployer + TSer + TSerP)), 2).ToString()))).ToString();
                emplistnew.TextSSContribution = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TSocSec), 2).ToString()))).ToString();
                emplistnew.TextSSPenalty = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TSocSecSP), 2).ToString()))).ToString();
                emplistnew.TexttotalSS = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)((TSocSec + TSocSecSP)), 2).ToString()))).ToString();
                emplistnew.Txt_GrandTotal = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)((TLevy + TLevyP + TLevyEmployer + TSer + TSerP + TSocSec + TSocSecSP)), 2).ToString()))).ToString();
                emplistnew.TextAccountantGeneral = decimal.Parse(String.Format("{0:0.00}", (Math.Round((decimal)(TLevy + TLevyP + TLevyEmployer + TSer + TSerP), 2)).ToString())).ToString();
                emplistnew.isNilReturn = isNilReturn;

                //ButtonPrint.IsEnabled = H_Id > 0 ? false : false;
                //ButtonExport.IsEnabled = H_Id > 0 ? false : false;
                if (issave)
                {
                    UserVM CompanyDetails = GetCompanyDetails(CompanyId);
                    //emplistnew.CmbPayPeriod = CmbPayPeriod;
                    emplistnew.OrderName = OrderName;
                    emplistnew.OrderKey = OrderKey;
                    emplistnew.company_reg_no = CompanyDetails.company_reg_no;
                    emplistnew.company_name = CompanyDetails.company_name;
                    emplistnew.company_address = CompanyDetails.company_address;
                    emplistnew.trade_name = CompanyDetails.trade_name;

                    savestatus = Save_IN_Continue(emplistnew, Month_Name, year, CompanyId, month, Text_SSTotal, UserID, User_Name, OrderName, OrderKey);   //Userid,  username,  MachineInfo);
                                                                                                                                                           //if (savestatus == 1)
                                                                                                                                                           //{
                                                                                                                                                           //  Finalize_C3();
                                                                                                                                                           //}
                    Edit_C3();
                    //Mouse.OverrideCursor = System.Windows.Input.Cursors.Arrow;
                    return savestatus == 1 ? 1 : 0;



                    //ButtonFinalize.Visibility = Visibility.Visible;
                    //ButtonSave.Visibility = Visibility.Hidden;
                }
                else
                {
                    return 0;
                    //ButtonFinalize.Visibility = isrecordEdit ? Visibility.Hidden : Visibility.Visible;
                    //ButtonSave.Visibility = isrecordEdit ? Visibility.Visible : Visibility.Hidden;
                }
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                return 0;
            }

        }
