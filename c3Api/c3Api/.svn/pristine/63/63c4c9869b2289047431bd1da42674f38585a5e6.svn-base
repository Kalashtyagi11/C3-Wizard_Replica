            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            SqlCommand cmd = C3H_Id > 0 ? new SqlCommand("C3Header_Update", staticConnection) : new SqlCommand("C3Header_Insert_One", staticConnection);
            cmd.CommandType = CommandType.StoredProcedure;
            if (C3H_Id > 0)
            {
                cmd.Parameters.Add(new SqlParameter("@HeaderId", SqlDbType.Int, 12, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)C3H_Id ?? (object)DBNull.Value));
