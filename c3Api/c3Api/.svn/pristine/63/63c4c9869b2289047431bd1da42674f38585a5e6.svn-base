                    Th_pay_End_date = w2_hpay > 0 ? holidaypadates[1].holidayPay_Date : Th_pay_End_date;
                    blemp.HPay_Week2 = w2_hpay;

                    decimal w3_hpay = LoadHpay(holidaypadates[2].holidayPay_Date, blemp.SSN, int.Parse(value), monthno, CompanyId);
                    Th_pay_Start_date = w3_hpay > 0 ? Th_pay_Start_date == null ? holidaypadates[2].holidayPay_Date : Th_pay_Start_date : Th_pay_Start_date;
                    Th_pay_End_date = w3_hpay > 0 ? holidaypadates[2].holidayPay_Date : Th_pay_End_date;
                    blemp.HPay_Week3 = w3_hpay;

                    decimal w4_hpay = LoadHpay(holidaypadates[3].holidayPay_Date, blemp.SSN, int.Parse(value), monthno, CompanyId);
                    Th_pay_Start_date = w4_hpay > 0 ? Th_pay_Start_date == null ? holidaypadates[3].holidayPay_Date : Th_pay_Start_date : Th_pay_Start_date;
                    Th_pay_End_date = w4_hpay > 0 ? holidaypadates[3].holidayPay_Date : Th_pay_End_date;
                    blemp.HPay_Week4 = w4_hpay;

                    decimal w5_hpay = IsWeekfifth ? LoadHpay(holidaypadates[4].holidayPay_Date, blemp.SSN, int.Parse(value), monthno, CompanyId) : 0;
                    Th_pay_Start_date = IsWeekfifth ? w5_hpay > 0 ? Th_pay_Start_date == null ? holidaypadates[4].holidayPay_Date : Th_pay_Start_date : Th_pay_Start_date : Th_pay_Start_date;
                    Th_pay_End_date = IsWeekfifth ? w5_hpay > 0 ? holidaypadates[4].holidayPay_Date : Th_pay_End_date : Th_pay_End_date;
                    blemp.HPay_Week5 = w5_hpay;

                    Ttotal_hpay = w1_hpay + w2_hpay + w3_hpay + w4_hpay + w5_hpay;
                    bool IsWithleaveHpay = IsOtherHpay(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId);

                    string OtHpayType = Ttotal_hpay > 0 ? OtherHpayType(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId) : string.Empty;
                    Ttotal_Otherpay = Ttotal_hpay > 0 ? Otherpay(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    Ttotal_OtherDirWagespay = Ttotal_hpay > 0 ? OtherDirWagespay(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.WAGES1 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.WAGES2 = /*IsWithleaveHpay*/false ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w1_hpay + w2_hpay)));
                    blemp.WAGES3 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.WAGES4 = /*IsWithleaveHpay*/false ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg + w3_hpay + w4_hpay + w5_hpay)));
                    blemp.WAGES5 = decimal.Parse(String.Format("{0:0.00}", 0.00));

                    //code added by amit parodiya
                    blemp.tempWAGES1 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.tempWAGES2 = false ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg)));
                    blemp.tempWAGES3 = decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.tempWAGES4 = false ? decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg))) : decimal.Parse(String.Format("{0:0.00}", (empl.Wadeg)));
                    blemp.tempWAGES5 = decimal.Parse(String.Format("{0:0.00}", 0.00));

                    blemp.BONUS = decimal.Parse(String.Format("{0:0.00}", LoadBonus(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId)));
                    blemp.HPAY = decimal.Parse(String.Format("{0:0.00}", Ttotal_hpay));
                    blemp.OtherPAY = decimal.Parse(String.Format("{0:0.00}", Ttotal_Otherpay));
                    blemp.DirectorWagesPAY = decimal.Parse(String.Format("{0:0.00}", Ttotal_OtherDirWagespay));
                    blemp.EmpSalary = decimal.Parse(String.Format("{0:0.00}", empl.Wadeg));
                    blemp.IsemployeeDirector = (bool)empl.IsemployeeDirector;
                    blemp.wage_Amt = blemp.IsemployeeDirector ? decimal.Parse(String.Format("{0:0.00}", LoadWages(Today_date, blemp.SSN, int.Parse(value), monthno, CompanyId))) : decimal.Parse(String.Format("{0:0.00}", 0.00));
                    blemp.TotalWadeges = decimal.Parse(String.Format("{0:0.00}", 0.00));
                    string hpremarks = Ttotal_hpay - (Ttotal_Otherpay + Ttotal_OtherDirWagespay) > 0 ? "h/p " + (Ttotal_hpay - (Ttotal_Otherpay + Ttotal_OtherDirWagespay)) + " (" + ((DateTime)Th_pay_Start_date).ToString(Helper.DateFormat) + "-" + ((DateTime)Th_pay_End_date).ToString(Helper.DateFormat) + ") " : string.Empty;
                    string otherremark = (Ttotal_Otherpay + Ttotal_OtherDirWagespay) > 0 ? "Other " + OtHpayType : string.Empty;
                    blemp.Remarks = Ttotal_hpay > 0 ? (Ttotal_hpay - (Ttotal_Otherpay + Ttotal_OtherDirWagespay)) > 0 ? hpremarks + " " + otherremark : otherremark : string.Empty;

                    blemp.IsHPAY = blemp.Remarks.Contains("h/p") ? "#FF288B01" : "#D3D3D3";
                    blemp.Remarks += blemp.wage_Amt > 0 ? "Dir Wages  " + blemp.wage_Amt : string.Empty;
                    blemp.Remarks += blemp.BONUS > 0 ? " Bonus  " + blemp.BONUS : string.Empty;
                    blemp.DirRemarks = blemp.wage_Amt > 0 ? "Dir Wages  " + blemp.wage_Amt : string.Empty;

                    blemp.IsWeekfifth = IsWeekfifth;
                    blemp.emp_add_remove = true;
                    blemp.IsRemarkDisable = blemp.Remarks == string.Empty ? true : false;
                    blemp.IsLevyExempt = empl.IsLevyExempt == null ? false : (bool)empl.IsLevyExempt;
                    blemp.BirthDate = ((DateTime)empl.BirthDate).ToString(Helper.SQLDateFormat);
                    blemp.PayFreq = empl.PayPeriod == "B" ? "E2W" : empl.PayPeriod == "S" ? "2M" : empl.PayPeriod;
                    blemp.CONTID = count;
                    Tw_Memployee_list.Add(blemp);

                    AllEmployee_List.Add(blemp);
                }

                AllEmployeeList_List = AllEmployee_List.OrderBy(x => x.Department).OrderBy(x => x.EmployeeName).ToList();

            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);

            }
            return AllEmployeeList_List;
        }





