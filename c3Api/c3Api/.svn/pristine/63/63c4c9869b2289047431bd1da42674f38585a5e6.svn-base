            cmd.Parameters.Add(new SqlParameter("@PERIODD_MONTH", SqlDbType.VarChar, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)month.ToString() ?? (object)DBNull.Value));
            cmd.Parameters.Add(new SqlParameter("@PERIOD_YEAR", SqlDbType.VarChar, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)value ?? (object)DBNull.Value));
