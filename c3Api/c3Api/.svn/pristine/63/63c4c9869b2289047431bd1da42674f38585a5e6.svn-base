            cmd.Parameters.Add(new SqlParameter("@TOTAL_LEVYEEPENALTY", SqlDbType.Decimal, 18, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)Result.TextLevyPenalty ?? (object)DBNull.Value));
