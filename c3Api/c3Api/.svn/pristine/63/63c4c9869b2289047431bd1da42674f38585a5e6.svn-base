                    Month = "September";
                    break;
                case "10":
                    Month = "October";
                    break;
                case "11":
                    Month = "November";
                    break;
                case "12":
                    Month = "December";
                    break;
                default:
                    Month = string.Empty;
                    break;
            }
            return Month;
        }
        public int holidayPayId(DateTime startdate, string empid, int year, int monthno, int CompanyId)
        {
            try
            {
                int days_This_Month = DateTime.DaysInMonth(year, monthno);
                int day_of_month = startdate.Day;
                int add_day = (days_This_Month - day_of_month) >= 7 ? 6 : days_This_Month - day_of_month;
                string enddate = startdate.AddDays(add_day).ToString(Helper.SQLDateFormat);

                int holidayPayId = 0;

                using (SqlConnection staticConnectionHPD = C3WizardLayerConn_BaseData.StaticSqlConnection)
                {
                    staticConnectionHPD.Open();

                    string query = @"
                SELECT TOP (1) hp.holidayPayId  
                FROM HolidayPayDates hp
                INNER JOIN MasterHolidayPayDetails mp ON hp.holidayPayId = mp.holidayPayId
                WHERE mp.company_ID = @CompanyId 
                  AND mp.otherHpaydes IS NULL
                  AND mp.employeeID = @EmpId 
                  AND hp.holidayPay_Date >= @StartDate 
                  AND hp.holidayPay_Date <= @EndDate";

                    using (SqlCommand cmdHPD = new SqlCommand(query, staticConnectionHPD))
                    {
                        cmdHPD.CommandType = CommandType.Text;
                        cmdHPD.Parameters.AddWithValue("@CompanyId", CompanyId);
                        cmdHPD.Parameters.AddWithValue("@EmpId", empid);
                        cmdHPD.Parameters.AddWithValue("@StartDate", startdate.ToString(Helper.SQLDateFormat));
                        cmdHPD.Parameters.AddWithValue("@EndDate", enddate);

                        object result = cmdHPD.ExecuteScalar();
                        if (result != null && int.TryParse(result.ToString(), out int resultId))
                        {
                            holidayPayId = resultId;
                        }
                    }
                }
                return holidayPayId;
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                // Optionally log the error here.
                return 0;
            }
        }
        public string regno(int CompanyId)
        {
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            //SqlCommand CurrentCompany = new SqlCommand("SELECT mc.Company_Id, mc.REG_NUMBER, mc.Address1, mc.Address2, mc.City, mc.State, mc.ZIP, mc.CompanyLogo, mc.IsLevyExempt, C.Name FROM MasterCompany mc, Country c WHERE mc.Isactive = 1 And mc.Company_Id = " + CompanyId + " And mc.Country=c.ConId", staticConnection);
            SqlCommand CurrentCompany = new SqlCommand(@"SELECT 
    mc.Company_Id, 
    mc.REG_NUMBER, 
    mc.Address1, 
    mc.Address2, 
    mc.City, 
    mc.State, 
    mc.ZIP, 
    mc.CompanyLogo, 
    mc.IsLevyExempt, 
    c.Name 
FROM 
    MasterCompany mc
LEFT JOIN 
    Country c ON mc.Country = c.ConId
WHERE 
    mc.IsActive = 1 
    AND mc.Company_Id = " + CompanyId, staticConnection);

            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            //  string value = CurrentCompanyId.ExecuteScalar().ToString();
            SqlDataReader dr = CurrentCompany.ExecuteReader();
            string companyid = "", RegNo = "", Address = "", CompanyLogo = "";
            while (dr.Read())
            {
                companyid = dr["Company_Id"].ToString();
                RegNo = dr["REG_NUMBER"].ToString();
                Address = dr["Address1"].ToString() + " " + dr["City"].ToString() + " " + dr["State"].ToString() + " " + dr["Name"].ToString() + " " + dr["ZIP"].ToString();
                CompanyLogo = dr["CompanyLogo"].ToString();
                //Application.Current.Properties["IsLevyExempt"] = dr["IsLevyExempt"];
                bool ise = true; //Helper.IsLevyExempt;
            }
            staticConnection.Close();

            return RegNo;
        }

        public UserVM GetUserDetails(int companyId, int userId)
        {
            UserVM user = new UserVM();
            string connectionString = C3WizardLayerConn_BaseData.StaticConnectionString; // Ensure you use a proper connection string

            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                string query = @"SELECT U.FirstName, U.LastName, U.EmailId,U.Password, U.parentuserid ,U.LoginId
                         FROM SECUsers U 
                         WHERE U.IsActive = 1 AND U.UserId = @UserId";

                using (SqlCommand command = new SqlCommand(query, connection))
                {
                    command.Parameters.AddWithValue("@UserId", userId);

                    connection.Open();
                    using (SqlDataReader dr = command.ExecuteReader())
                    {
                        if (dr.Read())
                        {
                            string firstName = dr["FirstName"].ToString();
                            string lastName = dr["LastName"].ToString();
                            user.LoginUserEmail = dr["EmailId"].ToString();
                            user.LoginUserName = $"{firstName} {lastName}";
                            user.User_Name = $"{firstName} {lastName}";
                            user.ParentUser_Password = dr["Password"].ToString();
                            //user.ParentUserLoginID = dr["parentuserid"].ToString();
                            user.ParentUserLoginID = dr["LoginId"].ToString();
                        }
                    }
                }
            }
            return user;
        }
        public UserVM GetCompanyDetails(int companyId)
        {
            UserVM user = new UserVM();
            string connectionString = C3WizardLayerConn_BaseData.StaticConnectionString; // Ensure you use a proper connection string

            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                string query = @"SELECT M.Company_Name as company_name,        
                            M.Trade_Name as trade_name,          
                            M.Address1+(case when isnull(M.Address2,'')!='' then ' '+M.Address2 else '' end)+','+M.City as company_address,          
                            M.REG_NUMBER as company_reg_no
                            FROM MasterCompany M WHERE M.IsActive = 1 AND M.Company_Id = @companyId";

                using (SqlCommand command = new SqlCommand(query, connection))
                {
                    command.Parameters.AddWithValue("@companyId", companyId);

                    connection.Open();
                    using (SqlDataReader dr = command.ExecuteReader())
                    {
                        if (dr.Read())
                        {
                            user.company_name = dr["company_name"].ToString();
                            user.trade_name = dr["trade_name"].ToString();
                            user.company_address = dr["company_address"].ToString();
                            user.company_reg_no = dr["company_reg_no"].ToString();

                        }
                    }
                }
            }
            return user;
        }
        public int GetIncomeId(int? incomeId)
        {
            int resultIncomeId = 0; // Store the result in a separate variable
            string connectionString = C3WizardLayerConn_BaseData.StaticConnectionString; // Ensure proper connection string

            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                string query = @"SELECT m.EmpIncomeID FROM MasterEmployeeIncomes M WHERE m.Employee_ID = @IncomeId";

                using (SqlCommand command = new SqlCommand(query, connection))
                {
                    command.Parameters.AddWithValue("@IncomeId", incomeId); // Ensure parameter name matches the query

                    connection.Open();
                    using (SqlDataReader dr = command.ExecuteReader())
                    {
                        if (dr.Read())
                        {
                            resultIncomeId = Convert.ToInt32(dr["EmpIncomeID"]); // Corrected column name
                        }
                    }
                }
            }
            return resultIncomeId;
        }
        public int GetMaxScheduleNo(int month, int year, int companyId)
        {
            int maxScheduleNo = 1;
            string query = @"SELECT ISNULL(MAX(Schedule_NO), 0) + 1 FROM PROCESS_C3Header WHERE PERIODD_MONTH = @Month AND PERIOD_YEAR = @Year 
          AND EmployerID = @CompanyId AND Is_submitted = 1";

            using (SqlConnection connection = new SqlConnection(C3WizardLayerConn_BaseData.StaticConnectionString))
            {
                using (SqlCommand command = new SqlCommand(query, connection))
                {
                    command.Parameters.Add("@Month", SqlDbType.Int).Value = month;
                    command.Parameters.Add("@Year", SqlDbType.Int).Value = year;
                    command.Parameters.Add("@CompanyId", SqlDbType.Int).Value = companyId;

                    try
                    {
                        connection.Open();
                        var result = command.ExecuteScalar();

                        // Use TryParse to safely convert result
                        if (result != null && int.TryParse(result.ToString(), out int parsedValue))
                        {
                            maxScheduleNo = parsedValue;
                        }
                    }
                    catch (Exception ex)
                    {
                        string controller = "UnknownController";
                        string action = "UnknownAction";
                        var context = ExceptionMiddleware1.GetActionInfo();
                        controller = context.Controller;
                        action = context.Action;
                        LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                        // Log exception if necessary
                    }
                }
            }
            return maxScheduleNo;
        }
