                List<C3Contributions> emplist = new List<C3Contributions>();
                SaveNContinueRequest emplistnew = new SaveNContinueRequest();
                if (obj_list.Count > 0)
                {
                    TEmp = obj_list.Count;
                    foreach (var empl in obj_list)
                    {
                        C3Contributions obj = new C3Contributions();
