        public SaveNContinueRequest UpdateC3RecordDesign(bool isNilreturn, List<C3Contributions> obj_list, List<C3Contributions> Not_Selected_list, int month, int year, int? H_Id, int schedule_no, bool issave, bool isrecordEdit, float employerlevyRate, bool ispreview, decimal SeveranceRate, decimal EIB_Limit, decimal Soc_EE_Pay_Limit, decimal Soc_ER_Pay_Limit, int[] yearlist, int TextChanged, string MonthName, DecemberBonusSetting bonusSetting, bool IsLevyExempt)
