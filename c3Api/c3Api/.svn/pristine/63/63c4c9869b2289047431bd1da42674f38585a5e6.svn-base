        public async Task<holidpd_listDataVm> LoadHolidayPayEmployee(string emplSsn, int? emplid, int monthno, string CmbYear, int CompanyId)
        {
            try
            {

                string value = CmbYear;
                string Mvalue = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(monthno);
                string monthval = monthno <= 9 ? "0" + monthno.ToString() : monthno.ToString();
                DateTime Today_date = DateTime.ParseExact(("01/" + monthval + "/" + value), Helper.DateFormat, CultureInfo.InvariantCulture);
                List<Holiday_Pay_Details> userlist = new List<Holiday_Pay_Details>();

                SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
                SqlCommand cmd = new SqlCommand("Holiday_Pay_Employee_Select_All", staticConnection);
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                DataTable dt = new DataTable();
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                sqlAdapter.Fill(dt);
                if (dt.Rows.Count > 0)
                {
                    for (int i = 0; i < dt.Rows.Count; i++)
                    {
                        Holiday_Pay_Details hpd = new Holiday_Pay_Details();
                        hpd.holidayPayId = (int)dt.Rows[i].ItemArray[0];
                        hpd.employeeID = (int)dt.Rows[i].ItemArray[1];
                        hpd.company_ID = (int)dt.Rows[i].ItemArray[2];
                        hpd.Amount = Math.Round((decimal)dt.Rows[i].ItemArray[3], 2);
                        hpd.start_Date = dt.Rows[i].ItemArray[4] == DBNull.Value || dt.Rows[i].ItemArray[4] == null ? (DateTime?)null : DateTime.ParseExact((string)dt.Rows[i].ItemArray[4], Helper.DisplayDateFormat, CultureInfo.InvariantCulture);
                        hpd.end_Date = dt.Rows[i].ItemArray[5] == DBNull.Value || dt.Rows[i].ItemArray[5] == null ? (DateTime?)null : DateTime.ParseExact((string)dt.Rows[i].ItemArray[5], Helper.DisplayDateFormat, CultureInfo.InvariantCulture);
                        hpd.st_Date = dt.Rows[i].ItemArray[4]?.ToString();
                        hpd.en_Date = dt.Rows[i].ItemArray[5]?.ToString();
                        hpd.PayNoOfTimes = (int)dt.Rows[i].ItemArray[6];
                        hpd.PayStatus = dt.Rows[i].ItemArray[7] != null ? true : false;
                        hpd.employeename = (string)dt.Rows[i].ItemArray[8];
                        hpd.IsWithoutLeave = dt.Rows[i].ItemArray[10].ToString() == "True" ? "Holiday Pay With Leave" : dt.Rows[i].ItemArray[11].ToString();
                        hpd.isHpay = (bool)dt.Rows[i].ItemArray[10];
                        userlist.Add(hpd);
                    }

                }

                userlist = userlist.Where(x => x.employeeID == emplid).ToList();
                // int yvalue = int.Parse(typeItem.Content.ToString());
                int yvalue = int.Parse(value);
                List<Employee_holidpd_list1> Employee_holidpd_list1 = new List<Employee_holidpd_list1>();
                List<Employee_holidpd_list1> employee_holidpd_Dates_list = new List<Employee_holidpd_list1>();
                List<Holiday_Pay_Dates1> holidpd = new List<Holiday_Pay_Dates1>();
                foreach (var InfoHpd in userlist)
                {

                    int smonthno = int.Parse(InfoHpd.st_Date.Substring(3, 2));
                    int emonthno = int.Parse(InfoHpd.en_Date.Substring(3, 2));
                    int syearno = int.Parse(InfoHpd.en_Date.Substring(6, 4));
                    if (smonthno - 1 <= (monthno - 1) && emonthno - 1 >= (monthno - 1) && syearno == yvalue)
                    {
                        Employee_holidpd_list1 hpdContri = new Employee_holidpd_list1();
                        hpdContri.holidayPayId = InfoHpd.holidayPayId;
                        hpdContri.employeeID = InfoHpd.employeeID;
                        hpdContri.company_ID = InfoHpd.company_ID;
                        hpdContri.Amount = InfoHpd.Amount;
                        hpdContri.start_Date = InfoHpd.start_Date;
                        hpdContri.end_Date = InfoHpd.end_Date;
                        hpdContri.st_Date = InfoHpd.st_Date;
                        hpdContri.en_Date = InfoHpd.en_Date;
                        hpdContri.PayNoOfTimes = InfoHpd.PayNoOfTimes;
                        hpdContri.PayStatus = InfoHpd.PayStatus;
                        hpdContri.employeename = InfoHpd.employeename;
                        hpdContri.IsWithoutLeave = InfoHpd.IsWithoutLeave;
                        hpdContri.isHpay = InfoHpd.isHpay;
