                cmd.Parameters.Add(new SqlParameter("@EmployeeDetails", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)emp ?? (object)DBNull.Value));
                cmd.Parameters.Add(new SqlParameter("@holidayPayId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)holidaypayId ?? (object)DBNull.Value));
                cmd.Parameters.Add(new SqlParameter("@updateon", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)DateTime.Now ?? (object)DBNull.Value));
                cmd.Parameters.Add(new SqlParameter("@IsWithoutLeave", SqlDbType.Bit, 1, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)false ?? (object)DBNull.Value));
                cmd.Parameters.Add(new SqlParameter("@PERIODD_MONTH", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)monthno ?? (object)DBNull.Value));
                cmd.Parameters.Add(new SqlParameter("@PERIOD_YEAR", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)value ?? (object)DBNull.Value));
                cmd.Parameters.Add(new SqlParameter("@otherHpaydes", SqlDbType.NVarChar, 500, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)OtHpayTvalue ?? (object)DBNull.Value));
                SqlDataAdapter sqlAdapter = new SqlDataAdapter(cmd);
                DataTable dt = new DataTable();
                sqlAdapter.Fill(dt);
                if (dt.Rows.Count > 0)
                {
                    HPid = Convert.ToInt32(holidaypayId);
                    for (int i = 0; i < days_list.Count; i++)
                    {
                        SqlCommand cmddates = new SqlCommand("Holiday_Pay_Dates_Insert_One", staticConnection);
                        cmddates.CommandType = CommandType.StoredProcedure;
                        cmddates.Parameters.Add(new SqlParameter("@HolidayPayId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)HPid ?? (object)DBNull.Value));
                        cmddates.Parameters.Add(new SqlParameter("@EmployeeId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)employeeid ?? (object)DBNull.Value));
                        cmddates.Parameters.Add(new SqlParameter("@CompanyId", SqlDbType.Int, 6, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)CompanyId ?? (object)DBNull.Value));
                        cmddates.Parameters.Add(new SqlParameter("@Amount", SqlDbType.Decimal, 9, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(Math.Round((Convert.ToDecimal(wagesAmount)), 2)) ?? (object)DBNull.Value));
                        cmddates.Parameters.Add(new SqlParameter("@HolidayPayDate", SqlDbType.DateTime, 50, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)(DateTime)days_list[i].holidayPay_Date ?? (object)DBNull.Value));
                        SqlDataAdapter sqlAdapterDates = new SqlDataAdapter(cmddates);
                        DataTable dtdates = new DataTable();
                        sqlAdapterDates.Fill(dtdates);
                    }
                    response1.Status = true;

                    return response1;
