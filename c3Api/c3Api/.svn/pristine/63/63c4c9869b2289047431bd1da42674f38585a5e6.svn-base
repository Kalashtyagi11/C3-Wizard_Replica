        public async Task<(List<CustomErrorLog> pagedData, int totalRecords, int totalPages)> GetLoggedExceptionsReportData(
    int pageNumber,
    int pageSize,
    DateTime? fromDate,
    DateTime? toDate)
        {
            var query = _DbContext.CustomErrorLogs
                .Where(x => x.IsActive == true);

            if (fromDate.HasValue && toDate.HasValue)
            {
                var startDate = fromDate.Value.Date;
                var endDate = toDate.Value.Date.AddDays(1).AddTicks(-1);
                query = query.Where(x => x.LogDate >= startDate && x.LogDate <= endDate);
            }

            int totalRecords = await query.CountAsync();
            int totalPages = (pageSize == 0) ? 1 : (int)Math.Ceiling((double)totalRecords / pageSize);

            query = query.OrderByDescending(x => x.LogDate);

            List<CustomErrorLog> pagedData;

            if (pageSize == 0)
            {
                pagedData = await query
                    .Select(x => new CustomErrorLog
                    {
                        Id = x.Id,
                        ControllerName = x.ControllerName,
                        MethodName = x.MethodName,
                        ErrorMessage = x.ErrorMessage,
                        LogDate = x.LogDate,
                    })
                    .ToListAsync();
            }
            else
            {
                pagedData = await query
                    .Skip(pageNumber * pageSize)
                    .Take(pageSize)
                    .Select(x => new CustomErrorLog
                    {
                        Id = x.Id,
                        ControllerName = x.ControllerName,
                        MethodName = x.MethodName,
                        ErrorMessage = x.ErrorMessage,
                        LogDate = x.LogDate,
                    })
                    .ToListAsync();
            }

            return (pagedData, totalRecords, totalPages);
        }



