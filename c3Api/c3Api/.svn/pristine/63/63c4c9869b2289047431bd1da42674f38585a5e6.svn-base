                        obj.BONUS = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.BONUS, 2)));
                        obj.wage_Amt = decimal.Parse(String.Format("{0:0.00}", Math.Round((decimal)empl.wage_Amt, 2)));
