            cmd.Parameters.Add(new SqlParameter("@Schedule_NO", SqlDbType.Int, 10, ParameterDirection.Input, false, 0, 0, "", DataRowVersion.Proposed, (object)Result.schedule_no ?? (object)DBNull.Value));
