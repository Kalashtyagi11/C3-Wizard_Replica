            //        response1.Message = "You can't Pay Holiday/Other pay to this employee because this employee is terminated on dated " + ((DateTime)emplistinfo.FirstOrDefault().Terminated).ToString(Helper.DisplayDateFormat) + " !";
            //        return response1;
            //    }
            //}
            //bool cdate = emplistinfo.FirstOrDefault().AppintDate != null ? true : false;
            //if (cdate)
            //{
            //    if (emplistinfo.FirstOrDefault().AppintDate >= holidayPay_Date)
