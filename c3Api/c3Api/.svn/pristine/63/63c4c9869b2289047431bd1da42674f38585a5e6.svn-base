        public DecemberBonusSetting DecemberBonusSetting(string fyear, int Monthno)
        {
            DecemberBonusSetting bonusSetting = new DecemberBonusSetting();
            DataSet dataSet = new DataSet();
            DataTable dt = new DataTable();
            SqlConnection staticConnection = C3WizardLayerConn_BaseData.StaticSqlConnection; C3WizardLayerConn_BaseData.SetAuditSessionContextAsync(staticConnection);
            if (staticConnection.State == System.Data.ConnectionState.Closed) staticConnection.Open();
            SqlCommand cmdHPD = new SqlCommand("select * from DECEMBER_BONUS_EXEMPTED_CONTRIBUTION where Year='" + fyear + "' And MonthNo = " + Monthno + " ", staticConnection);
            cmdHPD.CommandType = CommandType.Text;
            SqlDataAdapter adapterHPD = new SqlDataAdapter();
            adapterHPD.SelectCommand = cmdHPD;
            adapterHPD.Fill(dataSet);
            dt = dataSet.Tables[0];
            if (dt.Rows.Count > 0)
            {
                foreach (DataRow row in dt.Rows)
                {
                    bonusSetting.exemptedLevybonus = Convert.IsDBNull(row[1]) ? false : bool.Parse(row[1].ToString());
                    bonusSetting.exemptedEmployerLevybonus = Convert.IsDBNull(row[2]) ? false : bool.Parse(row[2].ToString());
                    bonusSetting.exemptedSeverancebonus = Convert.IsDBNull(row[3]) ? false : bool.Parse(row[3].ToString());
                    bonusSetting.exemptedsocialsecuritybonus = Convert.IsDBNull(row[4]) ? false : bool.Parse(row[4].ToString());
                }
            }
            staticConnection.Close();
            return bonusSetting;
        }


