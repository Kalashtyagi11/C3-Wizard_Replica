        public BLMasterEmployeeIncomes save_MasterEmployeeIncomes(BLMasterEmployee obj, decimal? IncRate, int? mode)
        {
            BLMasterEmployeeIncomes empInc = new BLMasterEmployeeIncomes();
            try
            {

                empInc.EmpIncomeID = GetIncomeId(obj.EmployeeID);
                empInc.EmployeeID = obj.EmployeeID;
                empInc.EmplCode = null;

                empInc.IncCode = "Fixed";
                empInc.LineNo = null;
                empInc.IncRate = IncRate;
                empInc.WageAmt = 0;
                empInc.IncNumber = null;

                empInc.IncHours = 1;
                empInc.AcctNo = null;
                empInc.Department = null;
                empInc.IncQtd1 = null;
                empInc.IncQtd2 = null;
                empInc.IncQtd3 = null;
                empInc.IncQtd4 = null;
                empInc.IncYtd = 1;
                empInc.LoIncAmt = null;
                empInc.HiIncAmt = null;
                if (mode == 1)
                {
                    empInc.SaveNew();
                }
                else
                {
                    empInc.Update();
                }

            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                throw ex;

            }
            return empInc;

        }
        public async Task<IEnumerable<C3HeaderVM>> GetC3ReportsAlldata(int companyId)
        {
            try
            {
                var listDVOC3Header = new List<C3HeaderVM>();
                var listC3Header = new List<C3HeaderVM>();

                using (var connection = new SqlConnection(_configuration.GetConnectionString("DefaultConnection")))
                {
                    var command = new SqlCommand("[get_C3Genrated_data]", connection)
                    {
                        CommandType = CommandType.StoredProcedure
                    };
                    command.Parameters.AddWithValue("@CompanyId", companyId);

                    await connection.OpenAsync();

                    using (SqlDataAdapter sqlAdapter = new SqlDataAdapter(command))
                    {
                        DataTable dt = new DataTable();
                        sqlAdapter.Fill(dt);

                        if (dt.Rows.Count > 0)
                        {
                            foreach (DataRow row in dt.Rows)
                            {
                                var Obj = new C3HeaderVM
                                {
                                    HeaderID = Convert.IsDBNull(row["C3HEADERID"]) ? 0 : int.Parse(row["C3HEADERID"].ToString()),
                                    RegNo = Convert.IsDBNull(row["RegNo"]) ? null : row["RegNo"].ToString(),
                                    period_Month = Convert.IsDBNull(row["PERIODD_MONTH"]) || row["PERIODD_MONTH"].ToString() == string.Empty
                                        ? null
                                        : MonthName(row["PERIODD_MONTH"].ToString()),
                                    Period_year = Convert.IsDBNull(row["PERIOD_YEAR"]) || row["PERIOD_YEAR"].ToString() == string.Empty
                                        ? null
                                        : row["PERIOD_YEAR"].ToString(),
                                    TOTAL_WAGES = Convert.IsDBNull(row["TOTAL_WAGES"]) ? 0.00m : decimal.Parse(row["TOTAL_WAGES"].ToString()),
                                    TOTALSSCONTRIBUTIONS = Convert.IsDBNull(row["TOTAL_SSCONTRIBUTIONS"]) ? 0.00m : decimal.Parse(row["TOTAL_SSCONTRIBUTIONS"].ToString()),
                                    TOTALSSPENALTY = Convert.IsDBNull(row["TOTAL_SSPENALTY"]) ? 0.00m : decimal.Parse(row["TOTAL_SSPENALTY"].ToString()),
                                    TOTALLEVYEEEMPLOYEE = CalculateLevyEmployee(row),
                                    TOTALLEVYEEEMPLOYER = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYER"]) ? 0.00m : decimal.Parse(row["TOTAL_LEVYEEEMPLOYER"].ToString()),
                                    TOTALLEVYEEPENALTY = Convert.IsDBNull(row["TOTAL_LEVYEEPENALTY"]) ? 0.00m : decimal.Parse(row["TOTAL_LEVYEEPENALTY"].ToString()),
                                    Insert_Datetimeinfo = Convert.IsDBNull(row["Insert_Datetimeinfo"])
                                        ? null
                                        : DateTime.Parse(row["Insert_Datetimeinfo"].ToString()).ToString("dd-MM-yyyy"),
                                    Is_Fianalize = Convert.IsDBNull(row["Is_Fianalize"]) ? false : bool.Parse(row["Is_Fianalize"].ToString()),
                                    Is_submitted = Convert.IsDBNull(row["Is_submitted"]) ? false : bool.Parse(row["Is_submitted"].ToString()),
                                    Schedule_NO = Convert.IsDBNull(row["Schedule_NO"]) ? 0 : int.Parse(row["Schedule_NO"].ToString()),
                                    TOTALSERVAYANCE = Convert.IsDBNull(row["TOTAL_SERVAYANCE"]) ? 0m : Convert.ToDecimal(row["TOTAL_SERVAYANCE"]),
                                    TOTALPEPENALTY = Convert.IsDBNull(row["TOTAL_PEPENALTY"]) ? decimal.Parse(String.Format("{0:0.00}", 0.00)) : decimal.Parse(String.Format("{0:0.00}", decimal.Parse(row["TOTAL_PEPENALTY"].ToString()))),
                                    isNilReturn = Convert.IsDBNull(row["isNilReturn"]) ? false : bool.Parse(row["isNilReturn"].ToString()),
                                };

                                listDVOC3Header.Add(Obj);
                            }

                            foreach (var row in listDVOC3Header)
                            {
                                bool is_f = listDVOC3Header.Any(x => x.Is_Fianalize && x.period_Month == row.period_Month && x.Period_year == row.Period_year);

                                if (!row.Is_submitted)
                                {
                                    var Obj = new C3HeaderVM
                                    {
                                        HeaderID = row.HeaderID,
                                        RegNo = row.RegNo,
                                        period_Month = row.period_Month,
                                        Period_year = row.Period_year,
                                        TOTAL_WAGES = row.TOTAL_WAGES,
                                        TOTALSSCONTRIBUTIONS = row.TOTALSSCONTRIBUTIONS,
                                        TOTALLEVYEEEMPLOYEE = row.TOTALLEVYEEEMPLOYEE,
                                        TOTALLEVYEEEMPLOYER = row.TOTALLEVYEEEMPLOYER,
                                        Insert_Datetimeinfo = row.Insert_Datetimeinfo,
                                        Is_Fianalize = is_f ? false : true,
                                        Is_submitted = row.Is_submitted,
                                        Schedule_NO = row.Schedule_NO,
                                        TOTALSERVAYANCE = row.TOTALSERVAYANCE,
                                        TOTALPEPENALTY = row.TOTALPEPENALTY,
                                        TOTALSSPENALTY = row.TOTALSSPENALTY,
                                        TOTALLEVYEEPENALTY = row.TOTALLEVYEEPENALTY,
                                        TotalSSBpenanlity = row.TOTALPEPENALTY + row.TOTALSSPENALTY + row.TOTALLEVYEEPENALTY,
                                        isNilReturn = row.isNilReturn
                                    };

                                    listC3Header.Add(Obj);
                                }
                            }
                        }
                    }
                }
                return listC3Header;
            }
            catch (Exception ex)
            {
                string controller = "UnknownController";
                string action = "UnknownAction";
                var context = ExceptionMiddleware1.GetActionInfo();
                controller = context.Controller;
                action = context.Action;
                LoggingHelper.LogError(controller, action, ex.Message, ex.StackTrace);
                // Log exception (optional)
                return new List<C3HeaderVM>();
            }
        }

        private decimal CalculateLevyEmployee(DataRow row)
        {
            decimal levyEmployee = Convert.IsDBNull(row["TOTAL_LEVYEEEMPLOYEE"]) ? 0.00m : decimal.Parse(row["TOTAL_LEVYEEEMPLOYEE"].ToString());
            //decimal levyPenalty = Convert.IsDBNull(row["TOTAL_LEVYEEPENALTY"]) ? 0.00m : decimal.Parse(row["TOTAL_LEVYEEPENALTY"].ToString());
            return levyEmployee; //+ levyPenalty;
        }

        private string MonthName(string monthNumber)
        {
            int month = int.Parse(monthNumber);
            return new DateTime(1, month, 1).ToString("MMMM");
        }
