            {
                cmd = new SqlCommand("UPDATE Master_Rate_Setting SET Bonus_Levy_EE_Rate=" + Convert.ToDecimal(settings.EmployeeLevyCountrybutionbonus) / 100 +
                                                ", SeveranceRate = " + Convert.ToDecimal(settings.SeveranceCountributionRate) / 100 + ", Fine_Rate=" + Convert.ToDecimal(settings.MineFineRate) / 100 +
                                                ", Additional_Fine_Rate=" + Convert.ToDecimal(settings.AdditionalFineRate) / 100 + ", Penalty_Rate=" + Convert.ToDecimal(settings.MinPenaltyRate) / 100 +
                                                 ", Additional_Penalty_Rate=" + Convert.ToDecimal(settings.AdditionalPenaltyRate) / 100 +
                                                ", Min_Age=" + Convert.ToDecimal(settings.MinAge) + ", Max_Age=" + Convert.ToDecimal(settings.MaxAge) + ", EmployerLevy = " + Convert.ToDecimal(settings.EmployerLevyrate)
                                                + ", FromDate = '" + fromdate + "', ToDate = '" + todate + "' Where MRSId=" + mrsid, staticConnection);
            }
            else
            {
                string query = "insert into Master_Rate_Setting (Bonus_Levy_EE_Rate,SeveranceRate,Fine_Rate, Additional_Fine_Rate, Penalty_Rate, Additional_Penalty_Rate, Min_Age, Max_Age, EmployerLevy, FromDate,ToDate) values(" +
                                        Convert.ToDecimal(settings.EmployeeLevyCountrybutionbonus) / 100 + "," + Convert.ToDecimal(settings.SeveranceCountributionRate) / 100 + "," + Convert.ToDecimal(settings.MineFineRate) / 100 +
                                           "," + Convert.ToDecimal(settings.AdditionalFineRate) / 100 + "," + Convert.ToDecimal(settings.MinPenaltyRate) / 100 +
                                           "," + Convert.ToDecimal(settings.AdditionalPenaltyRate) / 100 + "," + Convert.ToDecimal(settings.MinAge) + "," + Convert.ToDecimal(settings.MaxAge) + "," + Convert.ToDecimal(settings.EmployerLevyrate) + ",'" + fromdate + "','" + todate + "')";
                cmd = new SqlCommand(query, staticConnection);
            }
            cmd.ExecuteNonQuery();

            staticConnection.Close();


        }

