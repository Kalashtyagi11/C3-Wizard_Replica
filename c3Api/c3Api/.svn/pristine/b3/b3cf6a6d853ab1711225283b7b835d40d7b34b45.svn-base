@using C3WizardHelper.ViewModels
@model TransactionReceipt

<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <link href="https://fonts.googleapis.com/css2?family=Yrsa:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cabin+Condensed&family=Encode+Sans+Condensed:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Roboto Condensed', sans-serif !important;
      font-weight: 400 !important;
      font-size: 17px;
      line-height: 1.3;
      /*      color: rgba(0, 0, 0, .4); */
    }

    /*  body {
            font-family: Arial, sans-serif;
            margin: 20px;
            } */

    .container {
      max-width: 700px;
      margin: auto;
      border: 1px solid #ccc;
      padding: 20px;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 65px;
    }

      .header img {
        width: 80px;
        height: auto;
        margin-right: 55px;
      }

    .header-text {
      text-align: center;
    }

      .header-text h3 {
        margin: 0;
        font-size: 18px;
        font-weight: bold;
      }

      .header-text h2 {
        margin: 5px 0 0 0;
        font-size: 22px;
        font-weight: bold;
      }

    .receipt-number {
      font-weight: bold;
      border: 1px solid #000;
      display: inline-block;
      padding: 5px 10px;
      margin-bottom: 10px;
    }

      .receipt-number span {
        color: blue;
        text-decoration: underline;
      }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }

      table td {
        border: 1px solid #ccc;
        padding: 10px;
      }

    .status {
      color: green;
      font-weight: bold;
    }

    .amount {
      color: #007bff;
      font-weight: bold;
    }

    .disclaimer {
      border: 1px solid #ccc;
      padding: 15px;
      background: #f9f9f9;
    }

      .disclaimer b {
        display: block;
        margin-bottom: 5px;
      }

    .footer {
      width: 100%;
      margin-top: 20px;
      font-size: 14px;
      overflow: hidden;
    }

      .footer .left, .footer .right {
        width: 48%;
        float: left;
      }

      .footer .right {
        float: right;
      }
  </style>
</head>
<body>

  <div class="container">
    <div class="header">
      <img src="" alt="Logo" />
      <div class="header-text">
        <h3>St. Christopher and Nevis Social Security Board</h3>
        <br />

      </div>
    </div>
    <h2 style="text-align: center;">RECEIPT</h2>
    <div class="footer">
      <div class="left">
        <strong>Head Office</strong><br><br>
        Robert Llewellyn Bradshaw Building<br />
        P.O. Box 79, Bay Road, Basseterre, St. Kitts<br />
        PHONE: +1 (869) 465-2535<br />
        EMAIL: pubinfo@socialsecurity.kn
      </div>
      <div class="right" style="border-left:1px solid #000;padding-left: 15px;">
       <strong>Branch Office</strong><br><br>
        {Pinney's} Commercial Site<br />
        P.O. Box 667 Nevis<br />
        PHONE: +1 (869) 469-5245<br />
        EMAIL: nevis@socialsecurity.kn
      </div>
    </div>
    <br />

    <div class="receipt-number">
      RECEIPT# <span>@Model.receiptNumber</span>
    </div>


    <table>

      <tr>
        <td><b>Reg No.</b></td>
        <td>@Model.regNo</td>
      </tr>
      <tr>
        <td><b>Customer Name</b></td>
        <td>@Model.Name</td>
      </tr>
      <tr>
        <td><b>Transaction ID</b></td>
        <td>@Model.Id</td>
      </tr>

            @foreach (var header in Model.PaymentHeaderdetails)
            {
                <tr>
                    <td><b>@header.paymentCode</b></td>
                    <td>$@header.paymentAmount.ToString("F2")</td>
                </tr>
            }


      <tr>
        <td><b>Amount</b></td>
        <td class="amount">$@Model.Amount</td>
      </tr>
      <tr>
        <td><b>Status</b></td>
        @* <td class="status">@Model.PaymentStatus</td> *@
        <td class="status" style="color:@(Model.PaymentStatus == "AUTHORIZED" ? "green" : "red")">@Model.PaymentStatus</td>
      </tr>
      <tr>
        <td><b>Transaction Date</b></td>
        <td>@Model.date</td>
      </tr>
    </table>

    <div class="disclaimer">
      <b>RECEIPT DISCLAIMER:</b>
      Your Payment has been posted to your account and will be applied to any past due social security contributions, levy, severance, fines and penalties or against the current period liabilities.
    </div>



  </div>

</body>
</html>
